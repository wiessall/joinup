        "drupal/pathauto": "~1.8",
        "drupal/pipeline": "^1.0",
        "drupal/poll": "^1.6",
        "drupal/publication_date": "^2.0",
        "drupal/rdf_entity": "^2.0",
        "drupal/rdf_meta_entity": "^1.0",
        "drupal/redirect": "^1.6",
        "drupal/schema_digital_document": "^1.0",
        "drupal/schema_metatag": "^3.0",
