    "conflict": {
        "drupal/drupal": "*",
        "symfony/http-foundation": "3.4.24"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3"
        },
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "ec-europa/toolkit-composer-plugin": true,
            "mglaman/composer-drupal-lenient": true,
            "mnsami/composer-custom-directory-installer": true,
            "oomphinc/composer-installers-extender": true,
            "openeuropa/composer-artifacts": true,
            "php-http/discovery": true,
            "phpro/grumphp-shim": true,
            "phpstan/extension-installer": true
        }
    },
    "autoload": {
        "classmap": [
            "web/modules/contrib/error_page/src/ErrorPageErrorHandler.php",
            "web/modules/custom/joinup_distribution/src/Entity/DistributionsParentInterface.php",
            "web/modules/custom/joinup_solution/src/Entity/SolutionContentTrait.php",
            "web/modules/custom/joinup_solution/src/Entity/SolutionContentInterface.php"
        ],
        "psr-4": {
            "Joinup\\": "src"
        }
    },
    "autoload-dev": {
        "classmap": [
            "web/core/tests/Drupal/FunctionalJavascriptTests/WebDriverCurlService.php",
            "web/modules/contrib/message_digest/src/Traits/MessageDigestContextTrait.php",
            "web/modules/contrib/message_digest/src/Traits/MessageDigestTrait.php",
            "web/modules/contrib/og_menu/src/Tests/Traits/OgMenuTrait.php",
            "web/modules/custom/joinup_rdf/src/Entity/RdfSyncEntityTrait.php",
            "scripts/composer/ComposerPatches.php"
        ],
        "files": [
            "src/Composer/load.environment.php"
        ],
        "psr-4": {
            "Drupal\\joinup\\": "tests/src",
            "Drupal\\Tests\\cas_mock_server\\": "web/modules/contrib/cas_mock_server/tests/src",
            "Drupal\\Tests\\honeypot\\": "web/modules/contrib/honeypot/tests/src",
            "Drupal\\Tests\\message_digest\\": "web/modules/contrib/message_digest/tests/src",
            "Drupal\\Tests\\oe_webtools\\": "web/modules/contrib/oe_webtools/tests"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "Joinup\\composer\\ComposerPatches::validate",
            "./scripts/composer/post_install"
        ],
        "post-update-cmd": [
            "Joinup\\composer\\ComposerPatches::validate",
            "./scripts/composer/post_update"
        ]
    },
    "extra": {
        "drupal-lenient": {
            "allowed-list": [
                "drupal/other_view_filter"
            ]
        },
        "installer-types": [
            "bower-asset",
            "npm-asset"
        ],
        "installer-paths": {
            "web/libraries/slick": [
                "npm-asset/slick-carousel"
            ],
            "web/libraries/colorbox": [
                "turbojettechnologies/colorbox"
            ],
            "web/libraries/tagify": [
                "npm-asset/yaireo--tagify"
            ],
            "drush/Commands/{$name}": [
                "type:drupal-drush"
            ],
            "drush/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "swagger-api/swagger-ui",
                "type:drupal-library",
                "type:bower-asset",
                "type:npm-asset"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ]
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            },
            "file-mapping": {
                "[web-root]/core/.deprecation-ignore.txt": {
                    "append": "resources/drupal-scaffold/.deprecation-ignore.txt.append",
                    "force-append": true
                },
                "[project-root]/.editorconfig": {
                    "append": "resources/drupal-scaffold/.editorconfig.append"
                },
                "[web-root]/.htaccess": {
                    "append": "resources/drupal-scaffold/.htaccess.append"
                },
                "[web-root]/robots.txt": {
                    "append": "resources/drupal-scaffold/robots.txt.append"
                },
                "[project-root]/.gitattributes": {
                    "append": "resources/drupal-scaffold/.gitattributes.append"
                },
                "[web-root]/.eslintignore": false,
                "[web-root]/.eslintrc.json": false
            }
        },
        "enable-patching": false,
        "composer-exit-on-patch-failure": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "patches": {
            "drupal/babel": {
                "TMGMT @see https://www.drupal.org/i/3554005": "resources/patch/php/drupal/babel/3554005.mr71-note706700.diff",
                "ContentEntity plugin can trigger exception if string translation is deleted @see https://drupal.org/i/3580045": "resources/patch/php/drupal/babel/3580045-mr79-commit0f379a78.diff",
                "Strengthen the creation of continuous job items @see https://www.drupal.org/i/3578471": "resources/patch/php/drupal/babel/3578471.mr76.commit333eff4d.diff"
            },
            "drupal/calendar_view": {
                "missing config schema @see https://www.drupal.org/i/3488649": "resources/patch/php/drupal/calendar_view/3488649.diff",
                "Weekly view doesn't show first week of new year @see https://www.drupal.org/i/3484325": "resources/patch/php/drupal/calendar_view/3484325.comment16152620.patch"
            },
            "drupal/config_inspector": {
                "Missing schema on nested elements @see https://www.drupal.org/i/3548299": "resources/patch/php/drupal/config_inspector/3548299.diff"
            },
            "drupal/core": {
                "Allow image style to be selected in text editor @see https://www.drupal.org/i/2061377": "resources/patch/php/drupal/core/2061377.mr10767-note521506.diff",
                "Allow making the file description a required field @see https://www.drupal.org/i/2320877": "resources/patch/php/drupal/core/2320877.mr5876-note502317.diff",
                "Delete should not be the default action on /admin/content @see https://www.drupal.org/i/2381293": "resources/patch/php/drupal/core/2381293.mr4583-commitd592670a0.diff",
                "Upcast named arguments/named parameters in views @see https://www.drupal.org/i/2528166": "resources/patch/php/drupal/core/2528166.mr14124-commitb55472cb.diff",
                "Enlarge file_usage entity ID length. @see https://www.drupal.org/node/2675600": "resources/patch/php/drupal/core/2675600.diff",
                "Allow plurals on bundle labels @see https://www.drupal.org/i/2765065": "resources/patch/php/drupal/core/2765065.mr4252-commit6031e764.diff",
                "Use comment access handler instead of hardcoding permissions @see https://www.drupal.org/i/2879087": "resources/patch/php/drupal/core/2879087_mr23_37499d5e-plus-2786587_mr11292_c99e8e10.diff",
                "Views with a different query plugin created via the UI do not have the correct query plugin ID in the view config @see https://www.drupal.org/i/2836237": "resources/patch/php/drupal/core/2836237.mr274-commit7e8d2533.diff",
                "Cache tags are not invalidated on revision delete @see https://www.drupal.org/i/2945928": "resources/patch/php/drupal/core/2945928.mr14146-commit78bff01c.diff",
                "Restrict images to this site\" restricts images that, by definition, *are* on this site @see https://www.drupal.org/i/2998318": "resources/patch/php/drupal/core/2998318.patch",
                "Layout builder doesn't support bundle computed field @see https://drupal.org/i/3034979": "resources/patch/php/drupal/core/layoutbuilder-bundlecomputedfieldsfix-3034979-21-11.x.patch",
                "Views Block Display skips preBlockBuild() call on ajax rebuild https://www.drupal.org/i/2605218": "resources/patch/php/drupal/core/2605218.mr4399-commitfd6208c3.diff",
                "PHP deprecation error in PhpMail::mail @see https://www.drupal.org/i/3418098": "resources/patch/php/drupal/core/3418098.diff",
                "Set the toolbar to position fixed on mobile (for group banner positioning and toolbar on mobile) @see https://www.drupal.org/i/2516938": "resources/patch/php/drupal/core/3809.diff",
                "This error occurs when we click on 'Insert Selected' button from the media library without selecting or uploading a media @see https://www.drupal.org/i/3303889": "resources/patch/php/drupal/core/3303889.mr9413-commitd500fff6.diff",
                "Allow contrib extensions to be installed by Drupal when core branch is 11.x @see https://www.drupal.org/i/3387322": "resources/patch/php/drupal/core/3387322.mr8615-note353552.diff",
                "JS errors from Drupal.dialog.resetSize when rapidly closing dialogs @see https://www.drupal.org/i/3472624": "resources/patch/php/drupal/core/3472624-4d97ff80.diff",
                "Can only intentionally re-render an entity with references 20 times @see https://www.drupal.org/i/2940605": "resources/patch/php/drupal/core/2940605-committed4d11c55d.diff",
                "Deprecated function: preg_match(): Passing null to parameter #2 ($subject) of type string is deprecated in Drupal\\Core\\Routing\\UrlGenerator->doGenerate() @see https://drupal.org/i/3338057": "resources/patch/php/drupal/core/3338057.mr6989-commit386ed857.diff",
                "Time-based custom caching is broken since configuration expects an integer @see https://www.drupal.org/i/3233105": "resources/patch/php/drupal/core/3233105.diff",
                "ImageItem generate sample value should take into account if the files exist @see https://www.drupal.org/i/3516691": "resources/patch/php/drupal/core/3516691.mr11729-commite2bfef56.diff",
                "File widget with multiple values may duplicate empty items @see https://www.drupal.org/i/3276280": "resources/patch/php/drupal/core/3276280.diff",
                "Odd behaviour with tabs on validation failure @see https://www.drupal.org/i/3508418": "resources/patch/php/drupal/core/3508418.diff",
                "Violation property path not properly tracked @see https://www.drupal.org/i/3229493": "resources/patch/php/drupal/core/3229493.patch",
                "Configs for untranslatable bundles @see https://www.drupal.org/i/3570351": "resources/patch/php/drupal/core/3570351.mr14561-commitd9636386.diff",
                "Fix for pagination inside Media library @see https://www.drupal.org/i/3567237": "resources/patch/php/drupal/core/3567237.mr14654-commit0edaf95a.diff",
                "REST views: Add pagination information and total count result @see https://www.drupal.org/i/2982729": "resources/patch/php/drupal/core/2982729-mr6558.commit290eabb1.diff",
                "Slow admin/config page load. @see https://www.drupal.org/i/3336621": "resources/patch/php/drupal/core/3336621.mr15137-commit7b9c8c6a.patch",
                "Fatal error when saving translation configuration @see https://www.drupal.org/i/3549469": "resources/patch/php/drupal/core/3549469.diff",
                "Translations of nodes with comment settings field set to non-translatable returns EntityUntranslatableFieldsConstraint @see https://www.drupal.org/i/3015675": "resources/patch/php/drupal/core/3015675-83bb966c.diff"
            },
            "drupal/default_content": {
                "Allow manual imports @see https://www.drupal.org/i/2640734": "resources/patch/php/drupal/default_content/2640734.diff"
            },
            "drupal/drupal-driver": {
                "Allow multi-property references. @see https://github.com/jhedstrom/DrupalDriver/pull/252": "resources/patch/php/drupal/drupal-driver/252.diff",
                "Populate link fields only with URI if value is a string @see https://github.com/jhedstrom/DrupalDriver/pull/267": "resources/patch/php/drupal/drupal-driver/267.diff",
                "Update Datetime field handler to support both date and datetime fields @see https://github.com/jhedstrom/DrupalDriver/pull/235": "resources/patch/php/drupal/drupal-driver/235.patch",
                "Do not process empty batches. @see https://github.com/jhedstrom/DrupalDriver/pull/284": "resources/patch/php/drupal/drupal-driver/284.diff"
            },
            "drupal/dynamic_entity_reference": {
                "Undefined array key on dependency removal @see https://www.drupal.org/i/3099176": "resources/patch/php/drupal/dynamic_entity_reference/3099176-3.x-16.diff"
            },
            "drupal/email_confirmer": {
                "Support for HTML mails @see https://www.drupal.org/i/3047124": "resources/patch/php/drupal/email_confirmer/3047124.mr3-note490206.diff"
            },
            "drupal/entity_form_field_label": {
                "Add possibility to alter field's description @see https://www.drupal.org/i/3420361": "resources/patch/php/drupal/entity_form_field_label/3420361.mr10-note563504.diff",
                "Illegal argument NULL @see https://www.drupal.org/i/3558750": "resources/patch/php/drupal/entity_form_field_label/3558750.diff"
            },
            "drupal/email_contact": {
                "Use AjaxHelperTrait::isAjax() to fix modal behavior for non-Ajax requests. @see https://www.drupal.org/i/3546736": "resources/patch/php/drupal/email_contact/3546736.diff"
            },
            "drupal/entity_legal": {
                "Custom agree validation error message and submit button label @see https://www.drupal.org/project/entity_legal/issues/3293017": "resources/patch/php/drupal/entity_legal/3293017.patch"
            },
            "drupal/entity_print": {
                "Restrict the dynamic fields in bundles @see https://www.drupal.org/i/3468563": "resources/patch/php/drupal/entity_print/3468563.mr66-note523124.diff"
