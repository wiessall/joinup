    "require-dev": {
        "ext-fileinfo": "*",
        "ext-iconv": "*",
        "ext-libxml": "*",
        "dantleech/gherkin-lint": "^0.2.3",
        "drupal/admin_toolbar": "^3.4",
        "drupal/cas_mock_server": "^2.0",
        "drupal/coder": "*",
        "drupal/composer_deploy": "^1.6",
        "drupal/config_inspector": "^2.1",
        "drupal/config_update": "^2.0",
        "drupal/devel": "^5.1",
        "drupal/drupal-extension": "^5.0",
        "drupal/filecache": "^1.1",
        "drupal/http_request_mock": "^1.1",
        "drupal/masquerade": "^2.0@RC",
        "drupal/stage_file_proxy": "^2.1.4",
        "drupal/upgrade_status": "^4.0",
        "drupaltest/behat-one-time-login": "^1.0",
        "ec-europa/toolkit": "^10.5",
        "enlightn/security-checker": "^1",
        "gitonomy/gitlib": "^1.4",
        "lovers-of-behat/table-extension": "^1.4",
        "lullabot/mink-selenium2-driver": "^1.7",
        "mikey179/vfsstream": "~1.6",
        "ml/json-ld": "^1.2",
        "nicwortel/behat-unused-step-definitions-extension": "^1.2",
        "palantirnet/drupal-rector": "^0.20.1",
        "pear/http_request2": "~2.4",
        "php-task-runner/composer": "dev-toolkit-runner",
        "php-task-runner/sparql": "dev-toolkit-runner",
        "phpro/grumphp-shim": "^2.6",
        "phpspec/prophecy-phpunit": "^2",
        "phpstan/extension-installer": "^1.3",
        "phpunit/phpunit": "^9.6",
        "symfony/phpunit-bridge": "^6.3",
        "vincentlanglet/twig-cs-fixer": "^2.10",
        "vlucas/phpdotenv": "~5",
        "weitzman/drupal-test-traits": "2.x-dev",
        "weitzman/logintrait": "^1.1"
    },
    "conflict": {
        "drupal/drupal": "*",
        "symfony/http-foundation": "3.4.24"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "cweagans/composer-patches": true,
            "composer/installers": true,
            "drupal/core-composer-scaffold": true,
            "openeuropa/composer-artifacts": true,
            "phpstan/extension-installer": true,
            "php-http/discovery": true,
            "ec-europa/toolkit-composer-plugin": true,
            "phpro/grumphp-shim": true
        }
    },
    "autoload": {
        "classmap": [
            "web/modules/contrib/error_page/src/ErrorPageErrorHandler.php",
            "web/modules/contrib/sparql_entity_storage/src/Driver/Database/sparql/ConnectionInterface.php",
            "web/modules/custom/joinup_sparql/src/Driver/Database/joinup_sparql/Connection.php",
            "web/modules/custom/joinup_distribution/src/Entity/DistributionsParentInterface.php"
        ],
        "psr-4": {
            "Joinup\\": "src"
        }
    },
    "autoload-dev": {
        "classmap": [
            "web/core/tests/Drupal/FunctionalJavascriptTests/WebDriverCurlService.php",
            "web/modules/contrib/message_digest/src/Traits/MessageDigestContextTrait.php",
            "web/modules/contrib/message_digest/src/Traits/MessageDigestTrait.php",
            "web/modules/contrib/og_menu/src/Tests/Traits/OgMenuTrait.php",
            "scripts/composer/ComposerPatches.php"
        ],
        "files": [
            "src/Composer/load.environment.php"
        ],
        "psr-4": {
            "Drupal\\joinup\\": "tests/src",
            "Drupal\\Tests\\cas_mock_server\\": "web/modules/contrib/cas_mock_server/tests/src",
            "Drupal\\Tests\\honeypot\\": "web/modules/contrib/honeypot/tests/src",
            "Drupal\\Tests\\message_digest\\": "web/modules/contrib/message_digest/tests/src",
            "Drupal\\Tests\\oe_webtools\\": "web/modules/contrib/oe_webtools/tests"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "Joinup\\composer\\ComposerPatches::validate",
            "./scripts/composer/post_install"
        ],
        "post-update-cmd": [
            "Joinup\\composer\\ComposerPatches::validate",
            "./scripts/composer/post_update"
        ]
    },
    "extra": {
        "installer-paths": {
            "drush/Commands/{$name}": ["type:drupal-drush"],
            "drush/contrib/{$name}": ["type:drupal-drush"],
            "web/core": ["type:drupal-core"],
            "web/libraries/{$name}": ["type:drupal-library"],
            "web/modules/contrib/{$name}": ["type:drupal-module"],
            "web/profiles/contrib/{$name}": ["type:drupal-profile"],
            "web/themes/contrib/{$name}": ["type:drupal-theme"]
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            },
            "file-mapping": {
                "[web-root]/core/.deprecation-ignore.txt": {
                    "append": "resources/drupal-scaffold/.deprecation-ignore.txt.append",
                    "force-append": true
                },
                "[project-root]/.editorconfig": {
                    "append": "resources/drupal-scaffold/.editorconfig.append"
                },
                "[web-root]/.htaccess": {
                    "append": "resources/drupal-scaffold/.htaccess.append"
                },
                "[web-root]/robots.txt": {
                    "append": "resources/drupal-scaffold/robots.txt.append"
                },
                "[project-root]/.gitattributes": {
                    "append": "resources/drupal-scaffold/.gitattributes.append"
                },
                "[web-root]/.eslintignore": false,
                "[web-root]/.eslintrc.json": false
            }
        },
        "enable-patching": false,
        "composer-exit-on-patch-failure": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "patches": {
            "drupal/addtocal": {
                "Uncaught TypeError: $(...).once is not a function @see https://www.drupal.org/project/addtocal/issues/3372354": "resources/patch/php/drupal/addtocal/3372354.patch"
            },
            "drupal/autologout": {
                "Warning: Undefined array key @see https://www.drupal.org/project/autologout/issues/3372010": "resources/patch/php/drupal/autologout/3372010.diff",
                "Users with no roles are logged out @see https://www.drupal.org/project/autologout/issues/3443711": "resources/patch/php/drupal/autologout/3443711.diff"
            },
            "drupal/cas_mock_server": {
                "Missing langcode in cas_mock_server.settings @see https://www.drupal.org/i/3463553": "resources/patch/php/drupal/cas_mock_server/3463553.diff"
            },
            "drupal/core": {
                "Allow image style to be selected in text editor @see https://www.drupal.org/node/2061377": "resources/patch/php/drupal/core/2061377-466-10.3.x.diff",
                "Allow making the file description a required field @see https://www.drupal.org/node/2320877": "resources/patch/php/drupal/core/2320877-10.3.x-115.diff",
                "Delete should not be the default action on /admin/content @see https://www.drupal.org/project/drupal/issues/2381293": "resources/patch/php/drupal/core/2381293-10.3.x-240.patch",
                "Upcast named arguments/named parameters in views @see https://www.drupal.org/project/drupal/issues/2528166": "resources/patch/php/drupal/core/2528166.patch",
                "Confirmation cancel links are incorrect if installed in a subdirectory @see https://www.drupal.org/project/drupal/issues/2582295": "resources/patch/php/drupal/core/2582295.patch",
                "Enlarge file_usage entity ID length. @see https://www.drupal.org/node/2675600": "resources/patch/php/drupal/core/2675600.diff",
                "Menu link plugins should provide a way for the link to be conditionally hidden @see https://www.drupal.org/i/2719609": "resources/patch/php/drupal/core/2719609.patch",
                "Allow plurals on bundle labels @see https://www.drupal.org/i/2765065": "resources/patch/php/drupal/core/2765065-10.3.x-155.diff",
                "Add thread depth configuration to comments. Includes patch for parent issue #2879087. @see https://www.drupal.org/i/2786587 @see https://www.drupal.org/i/2879087": "resources/patch/php/drupal/core/2879087.patch",
                "Set fixed depth for comment threads.": "resources/patch/php/drupal/core/2786587-thread-depth-fixed-limit.patch",
                "Views with a different query plugin created via the UI do not have the correct query plugin ID in the view config @see https://www.drupal.org/project/drupal/issues/2836237": "resources/patch/php/drupal/core/2836237.patch",
                "Cache tags are not invalidated on revision delete @see https://www.drupal.org/project/drupal/issues/2945928": "resources/patch/php/drupal/core/2945928.patch",
                "Have responsive image module ignore svg @see https://www.drupal.org/project/drupal/issues/2957924": "resources/patch/php/drupal/core/2957924.patch",
                "Restrict images to this site\" restricts images that, by definition, *are* on this site @see https://www.drupal.org/i/2998318": "resources/patch/php/drupal/core/2998318.patch",
                "Make it easier to trigger a tour @see https://www.drupal.org/project/drupal/issues/3012027": "resources/patch/php/drupal/core/3012027.patch",
                "Layout builder doesn't support bundle computed field @see https://drupal.org/i/3034979": "resources/patch/php/drupal/core/layoutbuilder-bundlecomputedfieldsfix-3034979-21-11.x.patch",
                "Cannot implement a custom user cancellation method @see https://www.drupal.org/project/drupal/issues/3135592": "resources/patch/php/drupal/core/3135592.patch",
                "If you don't set the \"version\" of a profile, the report/status displays an empty dash @see https://www.drupal.org/project/drupal/issues/3270892": "resources/patch/php/drupal/core/3270892.patch",
                "Views Block Display skips preBlockBuild() call on ajax rebuild https://www.drupal.org/i/2605218": "resources/patch/php/drupal/core/2605218-135.diff",
                "PHP deprecation error in PhpMail::mail @see https://www.drupal.org/project/drupal/issues/3418098": "resources/patch/php/drupal/core/3418098.diff",
                "Set the toolbar to position fixed on mobile (for group banner positioning and toolbar on mobile) @see https://www.drupal.org/project/drupal/issues/2516938": "resources/patch/php/drupal/core/3809.diff",
                "Media Library: Argument #1 ($array) must be of type array, null given in array_filter(). @see https://www.drupal.org/i/3340973": "resources/patch/php/drupal/core/3340973.diff",
                "Add validation constraint to type: plural_label; remove work-around from views.field.numeric:format_plural_string @see https://www.drupal.org/i/3409588": "resources/patch/php/drupal/core/3409588.diff",
                "MediaLibraryUiBuilder service does not properly allow additional contextual filter arguments @see https://www.drupal.org/i/3401726": "resources/patch/php/drupal/core/3401726.diff",
                "Added deprecation suppression": "resources/patch/php/drupal/core/3467293.diff",
                "Fix handling of unknown file extensions in FileMediaFormatterBase @see https://www.drupal.org/i/3466462": "resources/patch/php/drupal/core/3466462.diff"
            },
            "drupal/default_content": {
                "Allow manual imports @see https://www.drupal.org/i/2640734": "resources/patch/php/drupal/default_content/2640734.diff"
            },
            "drupal/drupal-driver": {
                "Allow multi-property references. @see https://github.com/jhedstrom/DrupalDriver/pull/252": "resources/patch/php/drupal/drupal-driver/252.diff"
            },
            "drupal/embed_block": {
                "Add support for Ckeditor 5. @see https://www.drupal.org/i/3316336": "resources/patch/php/drupal/embed_block/3316336.patch"
            },
            "drupal/email_confirmer": {
                "Support for HTML mails @see https://www.drupal.org/i/3047124": "resources/patch/php/drupal/email_confirmer/3047124.diff"
            },
            "drupal/entity_legal": {
                "Custom agree validation error message and submit button label @see https://www.drupal.org/project/entity_legal/issues/3293017": "resources/patch/php/drupal/entity_legal/3293017.patch"
            },
            "drupal/error_page": {
                "Creation of dynamic property deprecated in PHP 8.2 @see https://www.drupal.org/i/3376919": "resources/patch/php/drupal/error_page/3376919.patch"
            },
            "drupal/facets": {
                "Facets breaks all AJAX views that uses pagers even without facets @see https://www.drupal.org/i/3379445": "resources/patch/php/drupal/facets/3379445.patch",
                "Facet Summary for Facet Items with a set dependency. @see https://www.drupal.org/i/2873480": "resources/patch/php/drupal/facets/2873480.patch",
                "Add 0 option in 'Soft limit' and apply soft limit to facet root li tags and add. @see https://www.drupal.org/i/3208580 and https://www.drupal.org/i/3307082": "resources/patch/php/drupal/facets/3208580-and-3307082.patch",
                "Config validation error for facets_processor.* @see https://www.drupal.org/project/facets/issues/3459093": "resources/patch/php/drupal/facets/3459093.patch",
                "Fix FacetsHierarchy config schema issue @see https://www.drupal.org/project/facets/issues/3259836": "resources/patch/php/drupal/facets/3259836-8.patch"
            },
            "drupal/field_delimiter": {
                "Doesn't work in layout builder. @see https://www.drupal.org/i/3099580": "resources/patch/php/drupal/field_delimiter/3099580.patch",
                "str_replace(): Passing null to parameter #3 ($subject) of type array|string is deprecated in Drupal\\Component\\Utility\\Xss::filter(). @see https://www.drupal.org/i/3301169": "resources/patch/php/drupal/field_delimiter/3301169.patch"
            },
            "drupal/field_group": {
                "Deprecated way of sequence schema def @see https://www.drupal.org/project/field_group/issues/3409719": "resources/patch/php/drupal/field_group/3409719.diff",
                "Filtering and pagination error when adding existing media to nodes @see https://www.drupal.org/i/3412511": "resources/patch/php/drupal/field_group/3412511.patch"
            },
            "drupal/file_url": {
                "Handle deleted files @see https://www.drupal.org/project/file_url/issues/3326758": "resources/patch/php/drupal/file_url/3326758.diff",
                "No link template 'canonical' found @see https://www.drupal.org/project/file_url/issues/3346487": "resources/patch/php/drupal/file_url/3346487.diff",
                "Error thrown when local file does not exist upon deletion @see https://www.drupal.org/project/file_url/issues/3393473": "resources/patch/php/drupal/file_url/3393473.diff",
                "Do not assume that a file with the given target_id exists @see https://drupal.org/i/3440231": "resources/patch/php/drupal/file_url/3440231.diff",
                "PHP warnings from FileUrlWidget @see https://www.drupal.org/i/3450344": "resources/patch/php/drupal/file_url/3450344.diff",
                "URL not sumbitted (missing context in JS behavior detach) @see https://www.drupal.org/i/3450664": "resources/patch/php/drupal/file_url/3450664.diff"
            },
            "drupal/flag": {
                "TypeError: Argument 1 passed to FlagCount::count() must implement interface @see https://www.drupal.org/project/flag/issues/3168014": "resources/patch/php/drupal/flag/3168014.diff",
                "AJAX link broken if flaggable entity id is string @see https://www.drupal.org/project/flag/issues/3359007": "resources/patch/php/drupal/flag/3359007-47.patch",
                "Disclose flagging view mode in flag theming @see https://www.drupal.org/project/flag/issues/3049155": "resources/patch/php/drupal/flag/3049155-16.patch",
                "[Drupal 10.2] Deprecated sequence type schema definition @see https://www.drupal.org/i/3410265": "resources/patch/php/drupal/flag/3410265.diff",
                "[Drupal 10.2] Merge::key() with array is deprecated @see https://www.drupal.org/i/3410363": "resources/patch/php/drupal/flag/3410363.diff"
            },
            "drupal/honeypot": {
                "Behat integration. @see https://www.drupal.org/project/honeypot/issues/3059040": "resources/patch/php/drupal/honeypot/3059040.patch",
                "Provide ways to clean up old honeypot_time_restriction values @see https://www.drupal.org/project/honeypot/issues/2997609": "resources/patch/php/drupal/honeypot/2997609.patch"
            },
            "drupal/inline_entity_form": {
                "Autocomplete field doesn't allow to reference entities with long titles @see https://www.drupal.org/node/2895663": "resources/patch/php/drupal/inline_entity_form/2895663.patch",
                "Undefined array key \"delete\". @see https://www.drupal.org/i/3416328": "resources/patch/php/drupal/inline_entity_form/3416328.patch"
            },
            "drupal/linkit": {
                "Link shown after the autocomplete selection is the bare node/xxx link, not the alias @see https://www.drupal.org/node/2877535": "resources/patch/php/drupal/linkit/2877535.patch"
            },
            "drupal/layout_paragraphs": {
                "Allow to drag and drop nested paragraphs @see https://www.drupal.org/project/layout_paragraphs/issues/3401176": "resources/patch/php/drupal/layout_paragraphs/3401176.patch"
            },
            "drupal/message_notify": {
                "Allow 3rd-party to act before delivery @see https://www.drupal.org/project/message_notify/issues/3314370": "resources/patch/php/drupal/message_notify/3314370.diff"
            },
            "drupal/og": {
                "The annotations for \"edit-form\" and \"delete-form\" @see https://www.drupal.org/project/og/issues/3338830": "resources/patch/php/drupal/og/3338830.diff",
                "[Drupal 10.2] Using a translatable string as a category for field type is deprecated @see https://github.com/Gizra/og/pull/764": "resources/patch/php/drupal/og/pr764.diff"
            },
            "drupal/page_manager": {
                "[Drupal 10.2] Deprecated sequence type schema definition @see https://www.drupal.org/i/3410270": "resources/patch/php/drupal/page_manager/3410270.diff"
