        "drupal/search_api": "^1.27",
        "drupal/search_api_autocomplete": "^1.7",
        "drupal/search_api_solr": "^4.2.7",
        "drupal/search_api_spellcheck": "^4.0",
        "drupal/simple_block": "^1.3",
        "drupal/simple_sitemap": "^4.0",
        "drupal/sitewide_alert": "^2.1",
        "drupal/smart_trim": "^2.1",
        "drupal/social_media_links": "^2.7",
        "drupal/state_machine": "^1.0",
        "drupal/subpathauto": "^1.2",
        "drupal/svg_image": "^3.0",
        "drupal/swiftmailer": "^2.2",
        "drupal/theme_rule": "^1.0",
        "drupal/token": "~1.7",
