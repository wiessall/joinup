@@ -0,0 +1,172 @@
+<?php
+
+namespace Drupal\Tests\default_content\Functional;
+
+use Drupal\Core\Serialization\Yaml;
+use Drupal\node\Entity\NodeType;
+use Drupal\Tests\BrowserTestBase;
+use Drush\TestTraits\DrushTestTrait;
+
+/**
+ * Tests 'Default content' module Drush commands.
+ *
+ * @group default_content
+ */
+class DefaultContentDrushTest extends BrowserTestBase {
+
+  use DrushTestTrait;
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'default_content',
+    'file',
+    'node',
+    'taxonomy',
+  ];
+
+  /**
+   * {@inheritdoc}
+   */
+  protected $defaultTheme = 'stark';
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+    NodeType::create(['type' => 'page'])->save();
+  }
+
+  /**
+   * Tests the 'default-content:import' command.
+   *
+   * @see \Drupal\default_content\Commands\DefaultContentCommands::import()
+   */
+  public function testImport(): void {
+    // Check extension validation.
+    $this->drush('default-content:import', ['foo', 'bar'], [], NULL, NULL, 1);
+    $this->assertStringContainsString('Invalid modules or profile passed: foo, bar', $this->getErrorOutputRaw());
+
+    // Check 'nothing imported' message.
+    $this->drush('default-content:import', ['node']);
+    $this->assertStringContainsString('[warning] No content has been imported.', $this->getErrorOutputRaw());
+
+    // Check default content on module install.
+    $this->drush('pm:install', ['default_content_test_yaml']);
+    $this->assertLabels($this->getOriginalLabels());
+
+    // Alter the files by changing the entity labels.
+    $this->alterLabelsInFiles($this->getAlteredLabels());
+    // Add new content as file.
+    copy(__DIR__ . '/../../fixtures/testing_node.yml', __DIR__ . '/../../modules/default_content_test_yaml/content/node/testing_node.yml');
+
+    // Run the import with --no-update option.
+    $this->drush('default-content:import', ['default_content_test_yaml'], [
+      'no-update' => NULL,
+    ]);
+    $this->assertStringContainsString('1 entity imported from default_content_test_yaml', $this->getErrorOutputRaw());
+
+    // Check that entities were not updated.
+    $this->assertLabels($this->getOriginalLabels());
+    // Check that new entities were imported.
+    $this->assertSame('Additional node', \Drupal::service('entity.repository')->loadEntityByUuid('node', '7a8563a8-15c9-4f60-9ebc-630b9562672c')->label());
+
+    // Run again the import but allow updates.
+    $this->drush('default-content:import', ['default_content_test_yaml']);
+    $this->assertStringContainsString('6 entities imported from default_content_test_yaml', $this->getErrorOutputRaw());
+
+    // Check that entities were updated.
+    $this->assertLabels($this->getAlteredLabels());
+
+    // Restore the file system.
+    $this->alterLabelsInFiles($this->getOriginalLabels());
+    unlink(__DIR__ . '/../../modules/default_content_test_yaml/content/node/testing_node.yml');
+
+    // Check that not passing any module as arguments works.
+    $this->drush('default-content:import');
+    $this->assertStringContainsString('5 entities imported from default_content_test_yaml', $this->getErrorOutputRaw());
+  }
+
+  /**
+   * Asserts that a list of entities have expected labels.
+   *
+   * @param array $expected
+   *   An associative array where the keys are entity type IDs and values are
+   *   associative arrays keyed by entity UUIDs and having the expected labels
+   *   as values.
+   */
+  protected function assertLabels(array $expected): void {
+    $entity_type_manager = \Drupal::entityTypeManager();
+    /** @var \Drupal\Core\Entity\EntityRepositoryInterface $repository */
+    $repository = \Drupal::service('entity.repository');
+    foreach ($expected as $entity_type_id => $labels) {
+      // Need to get fresh copies of the entities.
+      $entity_type_manager->getStorage($entity_type_id)->resetCache();
+      foreach ($labels as $uuid => $expected_label) {
+        $this->assertSame($expected_label, $repository->loadEntityByUuid($entity_type_id, $uuid)->label());
+      }
+    }
+  }
+
+  /**
+   * Alters the default content files of default_content_test_yaml module.
+   *
+   * @param array $changes
+   *   A list of changes following the same structure as the return array of
+   *   self::getOriginalLabels().
+   */
+  protected function alterLabelsInFiles(array $changes): void {
+    $content_dir = __DIR__ . '/../../modules/default_content_test_yaml/content';
+    $definitions = \Drupal::entityTypeManager()->getDefinitions();
+    foreach ($changes as $entity_type_id => $labels) {
+      foreach ($labels as $uuid => $label) {
+        $file_path = "$content_dir/$entity_type_id/$uuid.yml";
+        $data = Yaml::decode(file_get_contents($file_path));
+        $label_key = $definitions[$entity_type_id]->getKey('label');
+        $data['default'][$label_key][0]['value'] = $label;
+        file_put_contents($file_path, Yaml::encode($data));
+      }
+    }
+  }
+
+  /**
+   * Returns the original labels of entities to be imported.
+   *
+   * @return string[][]
+   *   An associative array where the keys are entity type IDs and values are
+   *   associative arrays keyed by entity UUIDs and having the original labels
+   *   as values.
+   */
+  protected function getOriginalLabels(): array {
+    return [
+      'file' => [
+        '806afcf6-05bf-4178-92dd-ae9445285770' => 'test-file.txt',
+        '806afcf6-05bf-4178-92dd-ae9445285771' => 'test-file1.txt',
+      ],
+      'node' => [
+        '65c412a3-b83f-4efb-8a05-5a6ecea10ad4' => 'Imported node',
+        '78c412a3-b83f-4efb-8a05-5a6ecea10aee' => 'Imported node with owned by user that does not exist',
+      ],
+      'taxonomy_term' => [
+        '550f86ad-aa11-4047-953f-636d42889f85' => 'A tag',
+      ],
+    ];
+  }
+
+  /**
+   * Returns the altered entity labels.
+   *
+   * @return string[][]
+   *   Same as self::getOriginalLabels() but the labels are altered.
+   */
+  function getAlteredLabels(): array {
+    return array_map(function (array $labels): array {
+      return array_map(function (string $label): string {
+        return "ALTERED $label";
+      }, $labels);
+    }, $this->getOriginalLabels());
+  }
+
+}
