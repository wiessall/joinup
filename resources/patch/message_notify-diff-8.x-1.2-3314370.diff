+++ b/tests/modules/message_notify_test/src/MessageNotifyTestSubscriber.php
@@ -0,0 +1,62 @@
+<?php
+
+namespace Drupal\message_notify_test;
+
+use Drupal\message_notify\Event\MessageNotifyDeliveryEvent;
+use Drupal\user\UserInterface;
+use Symfony\Component\EventDispatcher\EventSubscriberInterface;
+
+/**
+ * Subscribes to Message Notify events.
+ */
+class MessageNotifyTestSubscriber implements EventSubscriberInterface {
+
+  /**
+   * {@inheritdoc}
+   */
+  public static function getSubscribedEvents(): array {
+    return [
+      MessageNotifyDeliveryEvent::class => 'onEmailDelivery',
+    ];
+  }
+
+  /**
+   * Listens to message delivery event.
+   *
+   * @param \Drupal\message_notify\Event\MessageNotifyDeliveryEvent $event
+   *   The event class instance.
+   */
+  public function onEmailDelivery(MessageNotifyDeliveryEvent $event): void {
+    $notifier = $event->getNotifier();
+    $message = $event->getMessage();
+    // Only act on 'email' notifier.
+    if ($notifier->getPluginId() === 'email') {
+      $arguments = $message->getArguments();
+      $config = $event->getNotifier()->getConfiguration();
+      /** @var \Drupal\user\UserInterface $account */
+      $account = user_load_by_mail($config['mail']);
+      // Add recipient arguments.
+      $arguments['@recipient:name'] = $account->getDisplayName();
+      $arguments['@recipient:balance'] = $this->complexCallbackExtractingTheUserBalance($account);
+      $message->setArguments($arguments);
+      // Set a custom 'from' address.
+      $config['from'] = 'quux@example.com';
+      $notifier->setConfiguration($config);
+    }
+  }
+
+  /**
+   * Returns the user balance.
+   *
+   * @param \Drupal\user\UserInterface $account
+   *   The user account.
+   *
+   * @return string
+   *   The balance.
+   */
+  protected function complexCallbackExtractingTheUserBalance(UserInterface $account): string {
+    // Complex logic here to get the value.
+    return '$35.5';
+  }
+
+}
