--- /dev/null
+++ b/src/Event/MessageNotifyDeliveryEvent.php
@@ -0,0 +1,65 @@
+<?php
+
+namespace Drupal\message_notify\Event;
+
+use Drupal\message\MessageInterface;
+use Drupal\message_notify\Plugin\Notifier\MessageNotifierInterface;
+use Symfony\Contracts\EventDispatcher\Event;
+
+/**
+ * Dispatched after the plugin configuration has been prepared.
+ *
+ * Subscribers are able to alter:
+ * - The message entity, including the message arguments.
+ * - The plugin configuration.
+ */
+class MessageNotifyDeliveryEvent extends Event {
+
+  /**
+   * The message entity.
+   *
+   * @var \Drupal\message\MessageInterface
+   */
+  protected $message;
+
+  /**
+   * The notifier plugin instance.
+   *
+   * @var array
+   */
+  protected $notifier;
+
+  /**
+   * Constructs a new event instance.
+   *
+   * @param \Drupal\message\MessageInterface $message
+   *   The message entity.
+   * @param \Drupal\message_notify\Plugin\Notifier\MessageNotifierInterface $notifier
+   *   The notifier plugin instance.
+   */
+  public function __construct(MessageInterface $message, MessageNotifierInterface $notifier) {
+    $this->message = $message;
+    $this->notifier = $notifier;
+  }
+
+  /**
+   * Returns the message entity.
+   *
+   * @return \Drupal\message\MessageInterface
+   *   The message entity.
+   */
+  public function getMessage(): MessageInterface {
+    return $this->message;
+  }
+
+  /**
+   * Returns the notifier plugin instance.
+   *
+   * @return \Drupal\message_notify\Plugin\Notifier\MessageNotifierInterface
+   *   The notifier plugin instance.
+   */
+  public function getNotifier(): MessageNotifierInterface {
+    return $this->notifier;
+  }
+
+}
