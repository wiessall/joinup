+    $text[1]['value'] = "Dear @recipient:name\nYour balance is now @recipient:balance";
+    $this->messageTemplate->set('text', $text)->save();
+    $message = Message::create([
+      'template' => 'message_notify_test',
+      'uid' => $author,
+    ])->setArguments(['@foo' => 'bar']);
+    $message->save();
+
+    $this->messageNotifier->send($message, ['mail' => 'joe@example.com']);
+    $mail = $this->getMails(['to' => 'joe@example.com'])[0];
+    $this->assertSame('Normal argument bar', $mail['subject']);
+    $this->assertStringContainsString('Dear Joe Doe', $mail['body']);
+    $this->assertStringContainsString('Your balance is now $35.5', $mail['body']);
+    $this->assertSame('quux@example.com', $mail['reply-to']);
+  }
+
 }
