+<?php
+
+declare(strict_types = 1);
+
+namespace Drupal\Tests\sparql_entity_storage\Unit;
+
+use Drupal\Core\Entity\EntityRepository;
+use Drupal\Core\Entity\EntityTypeManager;
+use Drupal\Tests\UnitTestCase;
+use Drupal\sparql_entity_storage\ParamConverter\SparqlEntityStorageConverter;
+use Symfony\Component\EventDispatcher\EventDispatcher;
+
+/**
+ * Test description.
+ *
+ * @group sparql_entity_storage
+ */
+final class ParameterConverterTest extends UnitTestCase {
+
+  /**
+   * Tests that invalid URIs is not queried.
+   *
+   * @dataProvider urisWithUnsupportedCharacters
+   */
+  public function testUrisWithUnsupportedCharacters(string $uri): void {
+    $entity_type_manager = $this->getMockBuilder(EntityTypeManager::class)
+      ->disableOriginalConstructor()
+      ->getMock();
+    $entity_repository = $this->getMockBuilder(EntityRepository::class)
+      ->disableOriginalConstructor()
+      ->getMock();
+    $event_dispatcher = $this->getMockBuilder(EventDispatcher::class)
+      ->disableOriginalConstructor()
+      ->getMock();
+
+    $sparqlEntityStorageConverter = new SparqlEntityStorageConverter($entity_type_manager, $entity_repository, $event_dispatcher);
+    $this->assertNull($sparqlEntityStorageConverter->convert($uri, 'dummy definition', 'dummy name', []));
+  }
+
+  /**
+   * Data provider for testUrisWithUnsupportedCharacters().
+   */
+  public static function urisWithUnsupportedCharacters(): array {
+    return [
+      ['http://example.com/some space'],
+      ['http://example.com/{curly-brackets}'],
+      ['http://example.com/<angle-brackets>'],
+      ['http://example.com/\\backslash'],
+      ['http://example.com/|pipe'],
+      ['http://example.com/`backtick`'],
+      ['http://example.com/^caret'],
+      ['http://example.com/"double-quote'],
+    ];
+  }
+
+}
