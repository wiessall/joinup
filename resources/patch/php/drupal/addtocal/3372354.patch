From c4deb0fef42f6389fbc61a9fe05beb9058cbb8cf Mon Sep 17 00:00:00 2001
From: Gautam Kumar <gautambca58@gmail.com>
Date: Wed, 25 Oct 2023 12:18:16 +0530
Subject: [PATCH] fixed Uncaught TypeError: .once is not a function

---
 addtocal-download.js | 6 +++---
 addtocal.info.yml    | 2 +-
 addtocal.js          | 4 ++--
 3 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/addtocal-download.js b/addtocal-download.js
index 99082fe..c19cea1 100644
--- a/addtocal-download.js
+++ b/addtocal-download.js
@@ -1,8 +1,8 @@
-(function ($, Drupal) {
+(function ($, Drupal, once) {
   Drupal.behaviors.addtocalDownload = {
     attach: function (context, settings) {
       // Trigger file download for any data links generated by addtocal.
-      $('.addtocal-link a', context).once('addtocal').click(function (event) {
+      $(once('addtocal','.addtocal-link a', context)).click(function (event) {
         var href = $(this).attr('href');
         if (/^data:/.test(href)) {
           var filename = 'addtocal';
@@ -168,4 +168,4 @@
     return true;
   } /* end download() */
 
-})(jQuery, Drupal);
+})(jQuery, Drupal, once);
diff --git a/addtocal.info.yml b/addtocal.info.yml
index 9468912..cdb277c 100644
--- a/addtocal.info.yml
+++ b/addtocal.info.yml
@@ -1,6 +1,6 @@
 name: 'Add to Cal'
 description: 'Drupal field formatter providing Add to Calendar links.'
-core_version_requirement: ^8 || ^9 || ^10
+core_version_requirement: ^9.2 || ^10
 type: module
 dependencies:
   - drupal:datetime
diff --git a/addtocal.js b/addtocal.js
index 391ce66..a44f212 100644
--- a/addtocal.js
+++ b/addtocal.js
@@ -1,4 +1,4 @@
-(function ($, Drupal) {
+(function ($, Drupal, once) {
   Drupal.behaviors.addtocal = {
     attach: function (context, settings) {
       // Hide and show the menu on click.
@@ -32,4 +32,4 @@
     }
   });
 
-})(jQuery, Drupal);
+})(jQuery, Drupal, once);
