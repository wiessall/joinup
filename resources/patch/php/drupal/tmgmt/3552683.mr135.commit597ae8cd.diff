+  /**
+   * Tests that a message longer than 255 characters is saved truncated.
+   */
+  public function testMessageTruncation(): void {
+    $job = $this->createJob();
+    $long_message = str_repeat('a', 500);
+    $message = tmgmt_message_create($long_message);
+    $message->tjid = $job->id();
+    $message->save();
+    $this->assertLessThanOrEqual(255, mb_strlen($message->message->value));
+  }
+
