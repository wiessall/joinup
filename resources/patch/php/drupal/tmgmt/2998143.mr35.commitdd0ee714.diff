 }
 
+/**
+ * Implements hook_entity_delete().
+ */
+function tmgmt_entity_delete(EntityInterface $entity): void {
+  if (!\Drupal::config('tmgmt.settings')->get('purge_stale')) {
+    return;
+  }
+
+  // Skip tmgmt's own entities: they are never translation sources, and deleting
+  // the job items and jobs below would otherwise re-enter this hook.
+  if ($entity->getEntityType()->getProvider() === 'tmgmt') {
+    return;
+  }
+
+  // Find the job items referencing the deleted entity.
+  $storage = \Drupal::entityTypeManager()->getStorage('tmgmt_job_item');
+  $job_item_ids = $storage->getQuery()
+    ->condition('item_type', $entity->getEntityTypeId())
+    ->condition('item_id', $entity->id())
+    ->accessCheck(FALSE)
+    ->execute();
+  if (!$job_item_ids) {
+    return;
+  }
+
+  $job_ids = [];
+  $job_items = $storage->loadMultiple($job_item_ids);
+  foreach ($job_items as $job_item) {
+    \assert($job_item instanceof JobItemInterface);
+    $job_ids[$job_item->getJobId()] = $job_item->getJobId();
+  }
+  $storage->delete($job_items);
+
+  // Continuous jobs are persistent containers that keep collecting items, so
+  // keep them even when empty.
+  foreach (Job::loadMultiple($job_ids) as $job) {
+    if (!$job->isContinuous() && empty($job->getItems())) {
+      $job->delete();
+    }
+  }
+}
