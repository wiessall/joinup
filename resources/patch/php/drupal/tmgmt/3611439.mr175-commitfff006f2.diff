+  /**
+   * Logs an ignored-change message if the source actually changed.
+   *
+   * Saves that do not affect the source (e.g. TMGMT accepting a translation)
+   * are not reported as ignored changes.
+   *
+   * @param \Drupal\tmgmt\JobItemInterface $job_item
+   *   The job item still active or in review.
+   * @param string $item_type
+   *   The source item type.
+   * @param string $item_id
+   *   The source item id.
+   */
+  protected function logIgnoredChange(JobItemInterface $job_item, string $item_type, string $item_id): void {
+    if (!$this->entityTypeManager->hasDefinition($item_type)) {
+      return;
+    }
+    $entity = $this->entityTypeManager->getStorage($item_type)->load($item_id);
+    if ($entity instanceof ContentEntityInterface && $entity->getUntranslated()->hasTranslationChanges()) {
+      $job_item->addMessage('Source was updated, changes were ignored as job item is still active.');
+    }
+  }
