    */
diff --git a/tests/src/Kernel/JobAddItemTest.php b/tests/src/Kernel/JobAddItemTest.php
new file mode 100644
index 0000000000000000000000000000000000000000..c1d4bf75890e2e8c46bef185c0ec0e66feabba3f
--- /dev/null
+++ b/tests/src/Kernel/JobAddItemTest.php
@@ -0,0 +1,109 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\tmgmt\Kernel;
+
+use Drupal\tmgmt\Entity\Job;
+use Drupal\tmgmt\TMGMTException;
+use Drupal\tmgmt\TMGMTNothingToTranslateException;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\Group;
+
+/**
+ * Tests adding job items to a job.
+ */
+#[CoversClass(Job::class)]
+#[Group('tmgmt')]
+class JobAddItemTest extends TMGMTKernelTestBase {
+
+  /**
+   * Makes the test source return data without any translatable text.
+   */
+  protected function setEmptySourceData(): void {
+    \Drupal::state()->set('tmgmt.test_source_data', [
+      'dummy' => [
+        'deep_nesting' => [
+          '#text' => '',
+          '#translate' => TRUE,
+        ],
+      ],
+    ]);
+  }
+
+  /**
+   * Returns the ids of the given entity type that are stored in the database.
+   */
+  protected function getStoredIds(string $entity_type_id): array {
+    return array_values(\Drupal::entityQuery($entity_type_id)->accessCheck(FALSE)->execute());
+  }
+
+  /**
+   * Tests that an item without translatable content is not created.
+   */
+  public function testNothingToTranslate(): void {
+    $job = $this->createJob();
+    $this->setEmptySourceData();
+
+    try {
+      $job->addItem('test_source', 'test', 1);
+      $this->fail('Adding an item without translatable content did not throw an exception.');
+    }
+    catch (TMGMTNothingToTranslateException $e) {
+      // The exception extends TMGMTException so that existing callers keep
+      // working.
+      $this->assertInstanceOf(TMGMTException::class, $e);
+      $this->assertEquals('Job item test_source:test:1 (Test) has no translatable content.', $e->getMessage());
+    }
+
+    $this->assertEquals([], $this->getStoredIds('tmgmt_job_item'));
+    $this->assertEquals([$job->id()], $this->getStoredIds('tmgmt_job'));
+  }
+
+  /**
+   * Tests that a new job is not stored if its first item has no content.
+   */
+  public function testNothingToTranslateOnNewJob(): void {
+    $job = tmgmt_job_create('en', 'de', 0);
+    $this->setEmptySourceData();
+
+    try {
+      $job->addItem('test_source', 'test', 1);
+      $this->fail('Adding an item without translatable content did not throw an exception.');
+    }
+    catch (TMGMTNothingToTranslateException) {
+      // The job was only saved to be able to reference it from the item.
+      $this->assertEquals([], $this->getStoredIds('tmgmt_job'));
+      $this->assertTrue($job->isNew());
+    }
+
+    // The same job object is still usable for an item that has content.
+    \Drupal::state()->delete('tmgmt.test_source_data');
+    $job_item = $job->addItem('test_source', 'test', 2);
+    $this->assertEquals([$job->id()], $this->getStoredIds('tmgmt_job'));
+    $this->assertEquals([$job_item->id()], $this->getStoredIds('tmgmt_job_item'));
+  }
+
+  /**
+   * Tests that the statistics of the saved item are correct.
+   */
+  public function testStatisticsOfAddedItem(): void {
+    \Drupal::state()->set('tmgmt.test_source_data', [
+      'dummy' => [
+        'deep_nesting' => [
+          '#text' => 'One two three four five',
+          '#translate' => TRUE,
+        ],
+      ],
+    ]);
+
+    $job_item = $this->createJob()->addItem('test_source', 'test', 1);
+
+    // Recalculating the statistics on save must not change them.
+    $this->assertEquals(5, $job_item->getWordCount());
+    $stored_item = \Drupal::entityTypeManager()->getStorage('tmgmt_job_item')->loadUnchanged($job_item->id());
+    $this->assertEquals(5, $stored_item->getWordCount());
+    $this->assertEquals(1, $stored_item->getCountPending());
+  }
+
+}
