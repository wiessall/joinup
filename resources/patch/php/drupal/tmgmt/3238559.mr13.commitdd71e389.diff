+  /**
+   * Tests that an item without translatable content is skipped.
+   */
+  public function testAddItemWithoutTranslatableContent(): void {
+    // The test source is not a continuous source, mock that decision only.
+    $source = $this->createMock(ContinuousSourceInterface::class);
+    $source->method('shouldCreateContinuousItem')->willReturn(TRUE);
+    $source_manager = $this->createMock(SourceManager::class);
+    $source_manager->method('createInstance')->willReturn($source);
+    $manager = new ContinuousManager(
+      \Drupal::entityTypeManager(),
+      $source_manager,
+      \Drupal::configFactory(),
+      \Drupal::service('plugin.manager.tmgmt.translator'),
+      \Drupal::service('event_dispatcher')
+    );
+
+    $job = $this->createJob('en', 'de', 0, ['job_type' => Job::TYPE_CONTINUOUS]);
+    $job->translator = $this->default_translator->id();
+    $job->save();
+
+    $this->assertInstanceOf(JobItemInterface::class, $manager->addItem($job, 'test_source', 'test', '1'));
+
+    // Nothing to translate is not an error, the item is simply not created.
+    \Drupal::state()->set('tmgmt.test_source_data', [
+      'dummy' => [
+        'deep_nesting' => [
+          '#text' => '',
+          '#translate' => TRUE,
+        ],
+      ],
+    ]);
+    $this->assertNull($manager->addItem($job, 'test_source', 'test', '2'));
+    $this->assertCount(1, \Drupal::entityQuery('tmgmt_job_item')->accessCheck(FALSE)->execute());
+  }
+
