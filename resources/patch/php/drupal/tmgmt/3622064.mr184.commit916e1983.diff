diff --git a/sources/content/src/ExtractedDataCache.php b/sources/content/src/ExtractedDataCache.php
new file mode 100644
index 0000000000000000000000000000000000000000..f92eec47009bf74ceb54e9376ad8aea4bc14911a
--- /dev/null
+++ b/sources/content/src/ExtractedDataCache.php
@@ -0,0 +1,183 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\tmgmt_content;
+
+use Drupal\Core\Entity\ContentEntityInterface;
+
+/**
+ * Keeps the translatable data extracted from a source within one request.
+ *
+ * @see \Drupal\tmgmt_content\Plugin\tmgmt\Source\ContentEntitySource::extractTranslatableData()
+ */
+class ExtractedDataCache {
+
+  /**
+   * The key of the source being read, or NULL if none was kept.
+   */
+  protected ?string $root = NULL;
+
+  /**
+   * The kept data, keyed by entity type, ID, revision and language.
+   *
+   * @var array[]
+   */
+  protected array $data = [];
+
+  /**
+   * The entities each entry was derived from, keyed as the data.
+   *
+   * @var string[][]
+   */
+  protected array $sources = [];
+
+  /**
+   * The entries each entity appears in, keyed by entity type and ID.
+   *
+   * @var string[][]
+   */
+  protected array $entries = [];
+
+  /**
+   * The extractions in progress, innermost last.
+   *
+   * @var array[]
+   */
+  protected array $stack = [];
+
+  /**
+   * Returns the data extracted from an entity, extracting it once.
+   *
+   * Only pass an entity as it is stored: unwritten changes are not keyed.
+   *
+   * @param \Drupal\Core\Entity\ContentEntityInterface $entity
+   *   The entity to extract from.
+   * @param callable $extract
+   *   Extracts the data from the entity, called only on a miss.
+   *
+   * @return array
+   *   The extracted data.
+   */
+  public function get(ContentEntityInterface $entity, callable $extract): array {
+    $key = $this->getKey($entity);
+
+    if (!$this->stack) {
+      // Only one source is kept at a time. An entity with nothing to key on
+      // is never the same source twice.
+      if ($key === NULL || $key !== $this->root) {
+        $this->data = [];
+        $this->sources = [];
+        $this->entries = [];
+      }
+      $this->root = $key;
+    }
+
+    if ($key !== NULL && isset($this->data[$key])) {
+      $this->report($this->sources[$key], TRUE);
+      return $this->data[$key];
+    }
+
+    $source = $entity->getEntityTypeId() . ':' . $entity->id();
+    $this->stack[] = [
+      'sources' => $key === NULL ? [] : [$source => $source],
+      'keep' => $key !== NULL,
+    ];
+
+    try {
+      $data = $extract($entity);
+    }
+    finally {
+      $frame = array_pop($this->stack);
+    }
+
+    $this->report($frame['sources'], $frame['keep']);
+
+    if ($frame['keep']) {
+      $this->data[$key] = $data;
+      $this->sources[$key] = $frame['sources'];
+      foreach ($frame['sources'] as $source) {
+        $this->entries[$source][$key] = $key;
+      }
+    }
+
+    return $data;
+  }
+
+  /**
+   * Discards every entry derived from an entity, before it is written.
+   *
+   * @param \Drupal\Core\Entity\ContentEntityInterface $entity
+   *   The entity that is about to change or go away.
+   */
+  public function invalidate(ContentEntityInterface $entity): void {
+    // A result read as the entity is now stops being true once it is written.
+    foreach (array_keys($this->stack) as $depth) {
+      $this->stack[$depth]['keep'] = FALSE;
+    }
+
+    if ($entity->id() === NULL) {
+      return;
+    }
+
+    $source = $entity->getEntityTypeId() . ':' . $entity->id();
+    foreach ($this->entries[$source] ?? [] as $key) {
+      $this->forget($key);
+    }
+  }
+
+  /**
+   * Drops one entry and the references to it.
+   *
+   * @param string $key
+   *   The key of the entry.
+   */
+  protected function forget(string $key): void {
+    foreach ($this->sources[$key] as $source) {
+      unset($this->entries[$source][$key]);
+      if (!$this->entries[$source]) {
+        unset($this->entries[$source]);
+      }
+    }
+
+    unset($this->data[$key], $this->sources[$key]);
+  }
+
+  /**
+   * Reports the entities an extraction read to the extractions enclosing it.
+   *
+   * @param string[] $sources
+   *   The entities that were read.
+   * @param bool $keep
+   *   Whether what was read can be named by a key.
+   */
+  protected function report(array $sources, bool $keep): void {
+    foreach (array_keys($this->stack) as $depth) {
+      $this->stack[$depth]['sources'] += $sources;
+      $this->stack[$depth]['keep'] = $this->stack[$depth]['keep'] && $keep;
+    }
+  }
+
+  /**
+   * Returns the key an entity's data is kept under.
+   *
+   * @param \Drupal\Core\Entity\ContentEntityInterface $entity
+   *   The entity.
+   *
+   * @return string|null
+   *   The key, or NULL for an entity with nothing stable to key on.
+   */
+  protected function getKey(ContentEntityInterface $entity): ?string {
+    if ($entity->isNew() || $entity->id() === NULL || $entity->isNewRevision()) {
+      return NULL;
+    }
+
+    return implode(':', [
+      $entity->getEntityTypeId(),
+      $entity->id(),
+      (string) ($entity->getEntityType()->isRevisionable() ? $entity->getRevisionId() : ''),
+      $entity->language()->getId(),
+    ]);
+  }
+
+}
