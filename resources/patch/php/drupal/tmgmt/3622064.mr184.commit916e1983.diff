diff --git a/sources/content/tests/src/Kernel/CountingExtractedDataCache.php b/sources/content/tests/src/Kernel/CountingExtractedDataCache.php
new file mode 100644
index 0000000000000000000000000000000000000000..6f63e605a882cacd673af24bee6ec5a81aca4027
--- /dev/null
+++ b/sources/content/tests/src/Kernel/CountingExtractedDataCache.php
@@ -0,0 +1,54 @@
+<?php
+
+namespace Drupal\Tests\tmgmt_content\Kernel;
+
+use Drupal\Core\Entity\ContentEntityInterface;
+use Drupal\tmgmt_content\ExtractedDataCache;
+
+/**
+ * An extracted data cache that counts the reads it did not avoid.
+ */
+class CountingExtractedDataCache extends ExtractedDataCache {
+
+  /**
+   * How often each entity was read, keyed by entity type and ID.
+   *
+   * @var int[]
+   */
+  protected array $reads = [];
+
+  /**
+   * {@inheritdoc}
+   */
+  public function get(ContentEntityInterface $entity, callable $extract): array {
+    $count = function (ContentEntityInterface $entity) use ($extract): array {
+      $key = $entity->getEntityTypeId() . ':' . $entity->id();
+      $this->reads[$key] = ($this->reads[$key] ?? 0) + 1;
+
+      return $extract($entity);
+    };
+
+    return parent::get($entity, $count);
+  }
+
+  /**
+   * Returns how often an entity was read.
+   *
+   * @param \Drupal\Core\Entity\ContentEntityInterface $entity
+   *   The entity.
+   *
+   * @return int
+   *   The number of reads.
+   */
+  public function reads(ContentEntityInterface $entity): int {
+    return $this->reads[$entity->getEntityTypeId() . ':' . $entity->id()] ?? 0;
+  }
+
+  /**
+   * Forgets the counts, keeping what is cached.
+   */
+  public function resetReads(): void {
+    $this->reads = [];
+  }
+
+}
diff --git a/sources/content/tests/src/Kernel/ExtractedDataCacheTest.php b/sources/content/tests/src/Kernel/ExtractedDataCacheTest.php
new file mode 100644
index 0000000000000000000000000000000000000000..ed641f792671283fb7cce847ef6b5abf09c1d902
--- /dev/null
+++ b/sources/content/tests/src/Kernel/ExtractedDataCacheTest.php
@@ -0,0 +1,344 @@
+<?php
+
+namespace Drupal\Tests\tmgmt_content\Kernel;
+
+use Drupal\Core\DependencyInjection\ContainerBuilder;
+use Drupal\Core\Entity\ContentEntityInterface;
+use Drupal\Core\Field\FieldStorageDefinitionInterface;
+use Drupal\field\Entity\FieldConfig;
+use Drupal\field\Entity\FieldStorageConfig;
+use Drupal\node\Entity\Node;
+use Drupal\node\Entity\NodeType;
+use Drupal\paragraphs\Entity\Paragraph;
+use Drupal\paragraphs\Entity\ParagraphsType;
+use Drupal\tmgmt\Entity\Job;
+
+/**
+ * Tests that the translatable data of a source is read once per request.
+ *
+ * @group tmgmt
+ */
+class ExtractedDataCacheTest extends ContentEntityTestBase {
+
+  /**
+   * Modules to enable.
+   *
+   * @var array
+   */
+  protected static $modules = [
+    'node',
+    'entity_reference_revisions',
+    'paragraphs',
+    'file',
+  ];
+
+  /**
+   * {@inheritdoc}
+   */
+  protected $entityTypeId = 'node';
+
+  /**
+   * {@inheritdoc}
+   */
+  public function register(ContainerBuilder $container) {
+    parent::register($container);
+
+    if ($container->hasDefinition('tmgmt_content.extracted_data_cache')) {
+      $container->getDefinition('tmgmt_content.extracted_data_cache')
+        ->setClass(CountingExtractedDataCache::class);
+    }
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function setUp(): void {
+    parent::setUp();
+
+    $this->installSchema('node', ['node_access']);
+    NodeType::create(['type' => 'article', 'name' => 'Article'])->save();
+
+    $this->installEntitySchema('paragraph');
+    \Drupal::moduleHandler()->loadInclude('paragraphs', 'install');
+    ParagraphsType::create(['label' => 'Text', 'id' => 'text'])->save();
+
+    FieldStorageConfig::create([
+      'field_name' => 'text',
+      'entity_type' => 'paragraph',
+      'type' => 'string',
+    ])->save();
+    FieldConfig::create([
+      'field_name' => 'text',
+      'entity_type' => 'paragraph',
+      'bundle' => 'text',
+      'translatable' => TRUE,
+    ])->save();
+
+    FieldStorageConfig::create([
+      'field_name' => 'paragraph_reference',
+      'entity_type' => 'node',
+      'type' => 'entity_reference_revisions',
+      'cardinality' => FieldStorageDefinitionInterface::CARDINALITY_UNLIMITED,
+      'settings' => ['target_type' => 'paragraph'],
+    ])->save();
+    FieldConfig::create([
+      'field_name' => 'paragraph_reference',
+      'entity_type' => 'node',
+      'bundle' => 'article',
+    ])->save();
+
+    $content_translation_manager = \Drupal::service('content_translation.manager');
+    $content_translation_manager->setEnabled('node', 'article', TRUE);
+    $content_translation_manager->setEnabled('paragraph', 'text', TRUE);
+  }
+
+  /**
+   * Tests that extracting the same source twice reads it once.
+   */
+  public function testRepeatedExtractionReadsOnce() {
+    [$node, $paragraph] = $this->createArticle();
+
+    $this->extract($node);
+    $this->assertSame(1, $this->reads($node));
+    $this->assertSame(1, $this->reads($paragraph), 'The paragraph is read as part of its parent.');
+
+    $this->extract($node);
+    $this->assertSame(1, $this->reads($node));
+    $this->assertSame(1, $this->reads($paragraph));
+  }
+
+  /**
+   * Tests that an entity embedded twice in one source is read once.
+   */
+  public function testAnEntityEmbeddedTwiceIsReadOnce() {
+    $paragraph = Paragraph::create(['type' => 'text', 'text' => 'Source paragraph']);
+    $paragraph->save();
+
+    $node = Node::create([
+      'langcode' => 'en',
+      'type' => 'article',
+      'title' => 'Source node',
+      'paragraph_reference' => [$paragraph, $paragraph],
+    ]);
+    $node->save();
+
+    $this->extract($node);
+    $this->assertSame(1, $this->reads($node));
+    $this->assertSame(1, $this->reads($paragraph), 'The second delta is the same entity.');
+  }
+
+  /**
+   * Tests that each language of a source is read on its own.
+   */
+  public function testEachLanguageIsReadOnItsOwn() {
+    [$node] = $this->createArticle();
+
+    $this->extract($node);
+    $this->extract($node->getTranslation('en'));
+    $this->assertSame(1, $this->reads($node));
+
+    $node->addTranslation('de', ['title' => 'Quelle'] + $node->toArray())->save();
+
+    $data = $this->extract($node->getTranslation('de'));
+    $this->extract($node->getTranslation('de'));
+    $this->assertSame(2, $this->reads($node), 'Another language is read on its own.');
+    $this->assertSame('Quelle', $data['title'][0]['value']['#text']);
+  }
+
+  /**
+   * Tests that saving a source discards what was kept for it.
+   */
+  public function testSavingTheSourceDiscardsIt() {
+    [$node] = $this->createArticle();
+
+    $this->extract($node);
+    $node->set('title', 'Changed title');
+    $node->save();
+
+    $data = $this->extract($node);
+    $this->assertSame(2, $this->reads($node));
+    $this->assertSame('Changed title', $data['title'][0]['value']['#text']);
+  }
+
+  /**
+   * Tests that saving an embedded entity discards the entries that read it.
+   */
+  public function testSavingAnEmbeddedEntityDiscardsItsParent() {
+    [$node, $paragraph] = $this->createArticle();
+
+    $this->extract($node);
+    $paragraph->set('text', 'Changed paragraph');
+    $paragraph->save();
+
+    $this->extract($node);
+    $this->assertSame(2, $this->reads($node), 'The parent is discarded along with the entity it embedded.');
+    $this->assertSame(2, $this->reads($paragraph));
+  }
+
+  /**
+   * Tests that saving an unrelated entity keeps what was read elsewhere.
+   */
+  public function testSavingAnUnrelatedEntityKeepsIt() {
+    [$first] = $this->createArticle();
+    [$second, $second_paragraph] = $this->createArticle();
+
+    $this->extract($first);
+
+    $second_paragraph->set('text', 'Changed paragraph')->save();
+
+    $this->extract($first);
+    $this->assertSame(1, $this->reads($first), 'A save elsewhere leaves the kept source alone.');
+
+    $this->extract($second);
+    $this->assertSame(1, $this->reads($second));
+  }
+
+  /**
+   * Tests that what was read while something was written is not kept.
+   */
+  public function testWhatIsReadWhileWritingIsNotKept() {
+    [$node, $paragraph] = $this->createArticle();
+    $cache = $this->cache();
+
+    $cache->get($node, function () use ($paragraph) {
+      $paragraph->save();
+
+      return [];
+    });
+    $cache->get($node, function () {
+      return [];
+    });
+
+    $this->assertSame(2, $this->reads($node));
+  }
+
+  /**
+   * Tests that only the source being read is kept.
+   */
+  public function testOnlyTheSourceBeingReadIsKept() {
+    [$first] = $this->createArticle();
+    [$second] = $this->createArticle();
+
+    $this->extract($first);
+    $this->extract($second);
+    $this->extract($first);
+
+    $this->assertSame(2, $this->reads($first), 'The previous source made way for the next.');
+    $this->assertSame(1, $this->reads($second));
+  }
+
+  /**
+   * Tests that a source with nothing to key on keeps nothing.
+   */
+  public function testAnUnsavedSourceKeepsNothing() {
+    $paragraph = Paragraph::create(['type' => 'text', 'text' => 'Source paragraph']);
+    $paragraph->save();
+
+    $node = Node::create([
+      'langcode' => 'en',
+      'type' => 'article',
+      'title' => 'Unsaved node',
+      'paragraph_reference' => $paragraph,
+    ]);
+
+    $this->extract($node);
+    $this->extract($node);
+
+    $this->assertSame(2, $this->reads($paragraph), 'What it embedded did not pile up.');
+  }
+
+  /**
+   * Tests that a save reads the source once, however many job items it has.
+   */
+  public function testSavingReadsTheSourceOnce() {
+    [$node] = $this->createArticle();
+
+    foreach (['de', 'cs'] as $target_langcode) {
+      $job = tmgmt_job_create('en', $target_langcode);
+      $job->translator = 'test_translator';
+      $job->save();
+      tmgmt_job_item_create('content', 'node', $node->id(), ['tjid' => $job->id()])->save();
+    }
+
+    $continuous = tmgmt_job_create('en', 'de', 0, [
+      'job_type' => Job::TYPE_CONTINUOUS,
+      'translator' => 'test_translator',
+      'continuous_settings' => [
+        'content' => ['node' => ['enabled' => 1, 'bundles' => ['article' => 1]]],
+      ],
+    ]);
+    $continuous->save();
+
+    $this->cache()->resetReads();
+    $node->set('title', 'Changed title');
+    $node->save();
+
+    $this->assertSame(1, $this->reads($node));
+  }
+
+  /**
+   * Creates an article referencing one paragraph.
+   *
+   * @return array
+   *   The node and the paragraph it references.
+   */
+  protected function createArticle() {
+    $paragraph = Paragraph::create([
+      'type' => 'text',
+      'text' => 'Source paragraph',
+    ]);
+    $paragraph->save();
+
+    $node = Node::create([
+      'langcode' => 'en',
+      'type' => 'article',
+      'title' => 'Source node',
+      'paragraph_reference' => $paragraph,
+    ]);
+    $node->save();
+
+    return [$node, $paragraph];
+  }
+
+  /**
+   * Extracts the translatable data of an entity.
+   *
+   * @param \Drupal\Core\Entity\ContentEntityInterface $entity
+   *   The entity to extract from.
+   *
+   * @return array
+   *   The extracted data.
+   */
+  protected function extract(ContentEntityInterface $entity) {
+    return \Drupal::service('plugin.manager.tmgmt.source')
+      ->createInstance('content')
+      ->extractTranslatableData($entity);
+  }
+
+  /**
+   * Returns how often an entity was read.
+   *
+   * @param \Drupal\Core\Entity\ContentEntityInterface $entity
+   *   The entity.
+   *
+   * @return int
+   *   The number of reads.
+   */
+  protected function reads(ContentEntityInterface $entity) {
+    return $this->cache()->reads($entity);
+  }
+
+  /**
+   * Returns the cache, counting the reads it did not avoid.
+   *
+   * @return \Drupal\Tests\tmgmt_content\Kernel\CountingExtractedDataCache
+   *   The cache.
+   */
+  protected function cache() {
+    $cache = $this->container->get('tmgmt_content.extracted_data_cache');
+    assert($cache instanceof CountingExtractedDataCache);
+
+    return $cache;
+  }
+
+}
