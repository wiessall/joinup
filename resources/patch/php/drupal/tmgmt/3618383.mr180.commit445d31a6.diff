+
+  /**
+   * Acquires the lock that guards this job item's source.
+   *
+   * Accepting a translation loads the source, applies the translated data and
+   * saves the source again. Translations of one source accepted at the same
+   * time, by editors in the review form or by cron, therefore erase each
+   * other. Two mechanisms guard against this:
+   * - Across processes, the lock backend: translations of one source are
+   *   accepted one at a time.
+   * - Within one process, static::$sourceLocks: saving the source fires
+   *   entity hooks that can accept another job item of the same source before
+   *   the save returns, for example through a continuous job with an
+   *   auto-accepting translator. Such a nested call shares the held lock
+   *   instead of acquiring it again, and only the outermost call releases it.
+   *   The array tracks the nesting depth, which no core lock backend does.
+   *
+   * @return bool
+   *   TRUE if the lock is held, FALSE if another process holds it and did not
+   *   release it within SOURCE_LOCK_WAIT seconds.
+   */
+  protected function acquireSourceLock(): bool {
+    $name = $this->getSourceLockName();
+
+    if (isset(static::$sourceLocks[$name])) {
+      static::$sourceLocks[$name]++;
+      return TRUE;
+    }
+
+    $lock = \Drupal::lock();
+    if (!$lock->acquire($name, static::SOURCE_LOCK_TIMEOUT)) {
+      $lock->wait($name, static::SOURCE_LOCK_WAIT);
+
+      if (!$lock->acquire($name, static::SOURCE_LOCK_TIMEOUT)) {
+        return FALSE;
+      }
+    }
+    static::$sourceLocks[$name] = 1;
     return TRUE;
   }
 
+  /**
+   * Releases the lock that guards this job item's source.
+   *
+   * A nested call only decrements the depth; the lock itself is released
+   * once the outermost call finishes.
+   */
+  protected function releaseSourceLock(): void {
+    $name = $this->getSourceLockName();
+
+    static::$sourceLocks[$name]--;
+    if (static::$sourceLocks[$name] === 0) {
+      unset(static::$sourceLocks[$name]);
+      \Drupal::lock()->release($name);
+    }
+  }
+
+  /**
+   * Returns the name of the lock that guards this job item's source.
+   *
+   * @return string
+   *   The lock name.
+   */
+  protected function getSourceLockName(): string {
+    return implode(':', ['tmgmt', $this->getPlugin(), $this->getItemType(), $this->getItemId()]);
+  }
+
