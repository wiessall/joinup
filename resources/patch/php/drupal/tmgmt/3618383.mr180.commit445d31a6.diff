+   * the lock is released in every other case.
+   */
+  protected const SOURCE_LOCK_TIMEOUT = 300;
+
+  /**
+   * How long to wait for the source lock, in seconds.
+   */
+  protected const SOURCE_LOCK_WAIT = 30;
+
+  /**
+   * Nesting depth of the source locks held by this process, keyed by name.
+   *
+   * @var int[]
+   */
+  protected static array $sourceLocks = [];
+
