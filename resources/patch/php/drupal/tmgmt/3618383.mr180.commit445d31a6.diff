+++ b/sources/content/tests/src/Kernel/ConcurrentAcceptTest.php
@@ -0,0 +1,213 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\tmgmt_content\Kernel;
+
+use Drupal\Core\Entity\ContentEntityInterface;
+use Drupal\Core\Lock\DatabaseLockBackend;
+use Drupal\Core\Lock\LockBackendInterface;
+use Drupal\entity_test\Entity\EntityTestMul;
+use Drupal\language\Entity\ConfigurableLanguage;
+use Drupal\tmgmt\Entity\Job;
+use Drupal\tmgmt\Entity\Translator;
+use Drupal\tmgmt\JobItemInterface;
+
+/**
+ * Tests accepting several translations of the same entity at the same time.
+ *
+ * @group tmgmt
+ */
+class ConcurrentAcceptTest extends ContentEntityTestBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  public function setUp(): void {
+    parent::setUp();
+    ConfigurableLanguage::createFromLangcode('es')->save();
+  }
+
+  /**
+   * Tests that accepting a translation does not discard one accepted meanwhile.
+   */
+  public function testAcceptDoesNotDiscardConcurrentTranslation(): void {
+    // Use the real lock backend, which kernel tests stub out with
+    // NullLockBackend, so the lock and its release are actually exercised.
+    $lock = new DatabaseLockBackend($this->container->get('database'));
+    $this->container->set('lock', $lock);
+
+    $entity = EntityTestMul::create(['langcode' => 'en', 'uid' => 1, 'name' => 'Llama']);
+    $entity->save();
+    $german = $this->createTranslatedJobItem($entity, 'de');
+    $spanish = $this->createTranslatedJobItem($entity, 'es');
+
+    // The copy held while accepting Spanish, read before German is accepted.
+    // It is cloned so that accepting German cannot alter it, the way a copy
+    // held by another process cannot be altered from here.
+    $stale = clone $this->loadStored($entity->id());
+
+    $this->assertTrue($german->acceptTranslation());
+
+    // Put that copy where a process that loaded the entity earlier finds it.
+    $this->container->get('entity.memory_cache')
+      ->set('values:' . $this->entityTypeId . ':' . $entity->id(), $stale);
+
+    // Prove that a plain load returns the stale copy, so accepting Spanish
+    // below really runs against it.
+    $cached = $this->container->get('entity_type.manager')
+      ->getStorage($this->entityTypeId)
+      ->load($entity->id());
+    $this->assertEquals(['en'], array_keys($cached->getTranslationLanguages()));
+
+    $this->assertTrue($spanish->acceptTranslation());
+
+    $this->assertEquals(['en', 'de', 'es'], array_keys($this->loadStored($entity->id())->getTranslationLanguages()));
+
+    // The lock was released, so the source can be accepted again.
+    $this->assertTrue($lock->lockMayBeAvailable('tmgmt:content:' . $this->entityTypeId . ':' . $entity->id()));
+  }
+
+  /**
+   * Tests that a translation is not accepted while its source is locked.
+   */
+  public function testAcceptIsRefusedWhileTheSourceIsLocked(): void {
+    $entity = EntityTestMul::create(['langcode' => 'en', 'uid' => 1, 'name' => 'Llama']);
+    $entity->save();
+    $job_item = $this->createTranslatedJobItem($entity, 'de');
+
+    $lock = $this->createMock(LockBackendInterface::class);
+    $lock->method('acquire')->willReturn(FALSE);
+    $lock->method('wait')->willReturn(TRUE);
+    $this->container->set('lock', $lock);
+
+    $this->assertFalse($job_item->acceptTranslation());
+
+    // The refusal is recorded on the job item, so it leaves a trace
+    // regardless of the caller.
+    $messages = $job_item->getMessages(['type' => 'error']);
+    $this->assertCount(1, $messages);
+    $this->assertSame('Another translation of the same source is currently being accepted. The translation is kept in review and can be accepted later.', (string) reset($messages)->getMessage());
+
+    // The translation is untouched and the item can be accepted later.
+    $this->assertTrue($job_item->isNeedsReview());
+    $this->assertEquals(['en'], array_keys($this->loadStored($entity->id())->getTranslationLanguages()));
+  }
+
+  /**
+   * Tests that accepting waits for the source lock to be released.
+   */
+  public function testAcceptWaitsForTheSourceLock(): void {
+    $entity = EntityTestMul::create(['langcode' => 'en', 'uid' => 1, 'name' => 'Llama']);
+    $entity->save();
+    $job_item = $this->createTranslatedJobItem($entity, 'de');
+
+    // The lock is held on the first attempt and freed while waiting.
+    $lock = $this->createMock(LockBackendInterface::class);
+    $lock->method('acquire')->willReturn(FALSE, TRUE);
+    $lock->method('wait')->willReturn(FALSE);
+    $this->container->set('lock', $lock);
+
+    $this->assertTrue($job_item->acceptTranslation());
+    $this->assertTrue($job_item->isAccepted());
+    $this->assertEquals(['en', 'de'], array_keys($this->loadStored($entity->id())->getTranslationLanguages()));
+  }
+
+  /**
+   * Tests that a nested job item is accepted under the held source lock.
+   */
+  public function testNestedAcceptSharesTheSourceLock(): void {
+    // The entity must exist before the continuous job, otherwise the insert
+    // hook would run the continuous chain already at creation time.
+    $entity = EntityTestMul::create(['langcode' => 'en', 'uid' => 1, 'name' => 'Llama']);
+    $entity->save();
+
+    // A continuous job with an auto-accepting translator: accepting another
+    // translation of the entity creates, submits and accepts an item for this
+    // job while that translation is still being accepted.
+    $translator = Translator::load('test_translator')->createDuplicate();
+    $translator->set('name', 'test_translator_auto');
+    $translator->set('auto_accept', TRUE);
+    $translator->save();
+    $continuous = tmgmt_job_create('en', 'es', 0, [
+      'job_type' => Job::TYPE_CONTINUOUS,
+      'translator' => 'test_translator_auto',
+      'continuous_settings' => [
+        'content' => [
+          $this->entityTypeId => [
+            'enabled' => 1,
+            'bundles' => [$this->entityTypeId => 1],
+          ],
+        ],
+      ],
+    ]);
+    $continuous->save();
+
+    $job_item = $this->createTranslatedJobItem($entity, 'de');
+
+    // A lock that grants a source only once, so the nested job item can only
+    // be accepted by sharing the lock that is already held.
+    $lock = $this->createMock(LockBackendInterface::class);
+    $granted = FALSE;
+    $lock->method('acquire')->willReturnCallback(function (string $name) use (&$granted): bool {
+      if (!str_starts_with($name, 'tmgmt:')) {
+        return TRUE;
+      }
+      $first = !$granted;
+      $granted = TRUE;
+      return $first;
+    });
+    $lock->method('wait')->willReturn(TRUE);
+    $this->container->set('lock', $lock);
+
+    $this->assertTrue($job_item->acceptTranslation());
+
+    // The nested job item was accepted within the call above rather than
+    // refused, and its translation was saved.
+    $continuous_items = $continuous->getItems();
+    $this->assertCount(1, $continuous_items);
+    $this->assertTrue(reset($continuous_items)->isAccepted());
+    $this->assertEquals(['en', 'de', 'es'], array_keys($this->loadStored($entity->id())->getTranslationLanguages()));
+  }
+
+  /**
+   * Creates a job item holding a translation, ready to be accepted.
+   *
+   * @param \Drupal\entity_test\Entity\EntityTestMul $entity
+   *   The entity to translate.
+   * @param string $target_langcode
+   *   The target language.
+   *
+   * @return \Drupal\tmgmt\JobItemInterface
+   *   The job item, in the review state.
+   */
+  protected function createTranslatedJobItem(EntityTestMul $entity, string $target_langcode): JobItemInterface {
+    $job = tmgmt_job_create('en', $target_langcode);
+    $job->translator = 'test_translator';
+    $job->save();
+    tmgmt_job_item_create('content', $this->entityTypeId, $entity->id(), ['tjid' => $job->id()])->save();
+    $job->requestTranslation();
+
+    $items = $job->getItems();
+    $item = reset($items);
+    $this->assertTrue($item->isNeedsReview());
+
+    return $item;
+  }
+
+  /**
+   * Loads the entity from storage, bypassing the caches.
+   *
+   * @param int|string $id
+   *   The entity ID.
+   *
+   * @return \Drupal\Core\Entity\ContentEntityInterface
+   *   The stored entity.
+   */
+  protected function loadStored(int|string $id): ContentEntityInterface {
+    return $this->container->get('entity_type.manager')
+      ->getStorage($this->entityTypeId)
+      ->loadUnchanged($id);
+  }
+
+}
