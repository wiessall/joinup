+
+/**
+ * Add default values of new keys in TMGMT setting.
+ */
+function tmgmt_update_8012(): void {
+  $config = \Drupal::configFactory()->getEditable('tmgmt.settings');
+  if ($config->isNew()) {
+    return;
+  }
+
+  if (is_null($config->getOriginal('purge_continuous', FALSE))) {
+    $config->set('purge_continuous', '_never');
+  }
+  if (is_null($config->getOriginal('purge_continuous_aborted', FALSE))) {
+    $config->set('purge_continuous_aborted', FALSE);
+  }
+  if (is_null($config->getOriginal('purge_continuous_limit', FALSE))) {
+    $config->set('purge_continuous_limit', 500);
+  }
+
+  $config->save();
+}
