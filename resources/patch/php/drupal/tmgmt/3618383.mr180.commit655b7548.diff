+
+    // @todo Call setOriginal() directly once tmgmt requires Drupal 11.2.
+    if (method_exists($entity, 'setOriginal')) {
+      $entity->setOriginal($original);
+    }
+    else {
+      $entity->original = $original;
+    }
+  }
