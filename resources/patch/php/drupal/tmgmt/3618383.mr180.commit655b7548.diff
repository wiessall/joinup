+
+  /**
+   * Acquires the lock that guards the source item of this job item.
+   *
+   * Accepting a translation loads the source item, applies the translated data
+   * and saves the source item again. Translations of one source item accepted
+   * at the same time, by editors in the review form or by cron, therefore
+   * erase each other. Two mechanisms guard against this:
+   * - Across processes, the lock backend: translations of one source item are
+   *   accepted one at a time.
+   * - Within one process, static::$sourceLocks: saving the source item fires
+   *   entity hooks that can accept another job item for the same source item
+   *   before the save returns, for example through a continuous job with an
+   *   auto-accepting translator. Such a nested call shares the held lock
+   *   instead of acquiring it again, and only the outermost call releases it.
+   *   The array tracks the nesting depth, which no core lock backend does.
+   *
+   * @return bool
+   *   TRUE if the lock is held, FALSE if it was still held elsewhere when
+   *   SOURCE_LOCK_WAIT ran out.
+   */
+  protected function acquireSourceLock(): bool {
+    $name = $this->getSourceLockName();
+
+    if (isset(static::$sourceLocks[$name])) {
+      static::$sourceLocks[$name]++;
+      return TRUE;
+    }
+
+    $lock = \Drupal::lock();
+    $time = \Drupal::time();
+    // A wait that ends early only means the lock was released: another waiter
+    // can take it first. Retry until the lock is held or the whole wait is
+    // used up, so that a lost race neither refuses nor waits forever.
+    $deadline = $time->getCurrentMicroTime() + static::SOURCE_LOCK_WAIT;
+    while (!$lock->acquire($name, static::SOURCE_LOCK_TIMEOUT)) {
+      $remaining = (int) ($deadline - $time->getCurrentMicroTime());
+      // Given a delay of zero, wait() falls back to its own 30 seconds.
+      if ($remaining < 1 || $lock->wait($name, $remaining)) {
+        return FALSE;
+      }
+    }
+    static::$sourceLocks[$name] = 1;
     return TRUE;
   }
 
+  /**
+   * Releases the lock that guards the source item of this job item.
+   *
+   * A nested call only decrements the depth; the lock itself is released
+   * once the outermost call finishes.
+   */
+  protected function releaseSourceLock(): void {
+    $name = $this->getSourceLockName();
+
+    static::$sourceLocks[$name]--;
+    if (static::$sourceLocks[$name] === 0) {
+      unset(static::$sourceLocks[$name]);
+      \Drupal::lock()->release($name);
+    }
+  }
+
+  /**
+   * Returns the name of the lock that guards this job item's source item.
+   *
+   * @return string
+   *   The lock name.
+   */
+  protected function getSourceLockName(): string {
+    return implode(':', ['tmgmt', $this->getPlugin(), $this->getItemType(), $this->getItemId()]);
+  }
