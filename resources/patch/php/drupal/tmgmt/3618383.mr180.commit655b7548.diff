+
+  /**
+   * How long to wait in total for the source item lock, in seconds.
+   *
+   * Enough for a normal accept, so that most collisions just wait their turn.
+   */
+  protected const SOURCE_LOCK_WAIT = 30;
+
+  /**
+   * Nesting depth of the source item locks held, keyed by lock name.
+   *
+   * @var int[]
+   */
+  protected static array $sourceLocks = [];
+
   /**
    * Holds the unserialized source data.
    *
@@ -932,17 +957,100 @@ class JobItem extends ContentEntityBase implements JobItemInterface {
       return FALSE;
     }
 
-    if (!$plugin->saveTranslation($this, $this->getJob()->getTargetLangcode())) {
-      $this->addMessage("Unknown error while saving translation for job item {$this->id()}");
+    // Hold the source item lock while saving: translations of one source item
+    // accepted at the same time overwrite each other.
