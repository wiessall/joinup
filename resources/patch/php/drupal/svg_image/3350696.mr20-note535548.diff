From 3c59d116d96d96fb19914cc2749c488a5df6a354 Mon Sep 17 00:00:00 2001
From: "micha.jakubowski" <micha.jakubowski@ffwagency.com>
Date: Thu, 13 Nov 2025 14:15:18 +0100
Subject: [PATCH 5/8] Add SvgFileValidationSubscriber

---
 .../SvgFileValidationSubscriber.php           | 81 +++++++++++++++++++
 svg_image.services.yml                        |  5 ++
 2 files changed, 86 insertions(+)
 create mode 100644 src/EventSubscriber/SvgFileValidationSubscriber.php
 create mode 100644 svg_image.services.yml

diff --git a/src/EventSubscriber/SvgFileValidationSubscriber.php b/src/EventSubscriber/SvgFileValidationSubscriber.php
new file mode 100644
index 0000000..c40bbf2
--- /dev/null
+++ b/src/EventSubscriber/SvgFileValidationSubscriber.php
@@ -0,0 +1,81 @@
+<?php
+
+namespace Drupal\svg_image\EventSubscriber;
+
+use Drupal\file\Validation\FileValidationEvent;
+use enshrined\svgSanitize\Sanitizer;
+use Symfony\Component\EventDispatcher\EventSubscriberInterface;
+use Symfony\Component\Validator\ConstraintViolation;
+
+/**
+ * Event subscriber for validating uploaded SVG files.
+ */
+final class SvgFileValidationSubscriber implements EventSubscriberInterface
+{
+
+    /**
+     * {@inheritdoc}
+     */
+    public static function getSubscribedEvents(): array
+    {
+        return [
+            FileValidationEvent::class => 'onFileValidate',
+        ];
+    }
+
+    /**
+     * Adds custom validation for SVG uploads.
+     *
+     * @param \Drupal\file\Validation\FileValidationEvent $event
+     *   The file validation event.
+     */
+    public function onFileValidate(FileValidationEvent $event): void
+    {
+        $file = $event->getFile();
+
+        if ($file->getMimeType() !== 'image/svg+xml') {
+            return;
+        }
+
+        $uri = $file->getFileUri();
+        if (!file_exists($uri)) {
+            $event->getViolations()->add(new ConstraintViolation(
+                t('The uploaded SVG file does not exist.'),
+                '',
+                [],
+                $file,
+                'file',
+                $uri
+            ));
+            return;
+        }
+
+        $svg_content = @file_get_contents($uri);
+        if ($svg_content === FALSE) {
+            $event->getViolations()->add(new ConstraintViolation(
+                t('Unable to read the uploaded SVG file.'),
+                '',
+                [],
+                $file,
+                'file',
+                $uri
+            ));
+            return;
+        }
+
+        $sanitizer = new Sanitizer();
+        $sanitizer->sanitize($svg_content);
+
+        if ($sanitizer->getXmlIssues()) {
+            $event->getViolations()->add(new ConstraintViolation(
+                t('Invalid or unsafe SVG file.'),
+                '',
+                [],
+                $file,
+                'file',
+                $uri
+            ));
+        }
+    }
+
+}
diff --git a/svg_image.services.yml b/svg_image.services.yml
new file mode 100644
index 0000000..2c4d0fd
--- /dev/null
+++ b/svg_image.services.yml
@@ -0,0 +1,5 @@
+services:
+  svg_image.svg_file_validation_subscriber:
+    class: Drupal\svg_image\EventSubscriber\SvgFileValidationSubscriber
+    tags:
+      - { name: event_subscriber }
-- 
