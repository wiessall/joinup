+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\svg_image\EventSubscriber;
+
+use Drupal\Core\StringTranslation\StringTranslationTrait;
+use Drupal\file\Validation\FileValidationEvent;
+use Symfony\Component\EventDispatcher\EventSubscriberInterface;
+use Symfony\Component\Validator\ConstraintViolation;
+use enshrined\svgSanitize\Sanitizer;
+
+/**
+ * Event subscriber for validating uploaded SVG files.
+ */
+final class SvgFileValidationSubscriber implements EventSubscriberInterface {
+
+  use StringTranslationTrait;
+
+  /**
+   * {@inheritdoc}
+   */
+  public static function getSubscribedEvents(): array {
+    return [
+      FileValidationEvent::class => 'onFileValidate',
+    ];
+  }
+
+  /**
+   * Adds custom validation for SVG uploads.
+   *
+   * @param \Drupal\file\Validation\FileValidationEvent $event
+   *   The file validation event.
+   */
+  public function onFileValidate(FileValidationEvent $event): void {
+    $file = $event->file;
+
+    if ($file->getMimeType() !== 'image/svg+xml') {
+      return;
+    }
+
+    $uri = $file->getFileUri();
+    if (!file_exists($uri)) {
+      $event->violations->add(new ConstraintViolation(
+            $this->t('The uploaded SVG file does not exist.'),
+            '',
+            [],
+            $file,
+            'file',
+            $uri
+        ));
+      return;
+    }
+
+    $svg_content = @file_get_contents($uri);
+    if ($svg_content === FALSE) {
+      $event->violations->add(new ConstraintViolation(
+            $this->t('Unable to read the uploaded SVG file.'),
+            '',
+            [],
+            $file,
+            'file',
+            $uri
+        ));
+      return;
+    }
+
+    $sanitizer = new Sanitizer();
+    $sanitizer->sanitize($svg_content);
+
+    if ($sanitizer->getXmlIssues()) {
+      $event->violations->add(new ConstraintViolation(
+            $this->t('Invalid or unsafe SVG file.'),
+            '',
+            [],
+            $file,
+            'file',
+            $uri
+        ));
+    }
+  }
+
+}
