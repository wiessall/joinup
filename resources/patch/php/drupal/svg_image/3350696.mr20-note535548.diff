+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\svg_image\Unit\EventSubscriber;
+
+use Drupal\Core\DependencyInjection\ContainerBuilder;
+use Drupal\Tests\UnitTestCase;
+use Drupal\file\FileInterface;
+use Drupal\file\Validation\FileValidationEvent;
+use Drupal\svg_image\EventSubscriber\SvgFileValidationSubscriber;
+use Symfony\Component\Validator\ConstraintViolationList;
+
+/**
+ * Test class for SvgFileValidationSubscriber.
+ *
+ * @group svg_image
+ */
+final class SvgFileValidationSubscriberTest extends UnitTestCase {
+
+  /**
+   * Creates a FileValidationEvent with a fresh violation list.
+   */
+  private function createEvent(FileInterface $file): FileValidationEvent {
+    return new FileValidationEvent($file, new ConstraintViolationList());
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+    $container = new ContainerBuilder();
+    $container->set('string_translation', $this->getStringTranslationStub());
+    \Drupal::setContainer($container);
+  }
+
+  /**
+   * Only svg files are validated.
+   */
+  public function testNonSvgIsIgnored(): void {
+    $subscriber = new SvgFileValidationSubscriber();
+
+    $file = $this->createMock(FileInterface::class);
+    $file->method('getMimeType')->willReturn('image/png');
+
+    $event = $this->createEvent($file);
+    $subscriber->onFileValidate($event);
+
+    $this->assertCount(0, $event->violations);
+  }
+
+  /**
+   * Violation for missing file.
+   */
+  public function testMissingFileAddsViolation(): void {
+    $subscriber = new SvgFileValidationSubscriber();
+
+    $file = $this->createMock(FileInterface::class);
+    $file->method('getMimeType')->willReturn('image/svg+xml');
+    $file->method('getFileUri')->willReturn('/path/does/not/exist.svg');
+
+    $event = $this->createEvent($file);
+    $subscriber->onFileValidate($event);
+
+    $this->assertCount(1, $event->violations);
+    $this->assertStringContainsString('does not exist', (string) $event->violations[0]->getMessage());
+  }
+
+  /**
+   * Violation for unreadable file.
+   */
+  public function testUnreadableFileAddsViolation(): void {
+    $subscriber = new SvgFileValidationSubscriber();
+
+    // Create unreadable temp file.
+    $tmp = tempnam(sys_get_temp_dir(), 'svg');
+    chmod($tmp, 0000);
+
+    $file = $this->createMock(FileInterface::class);
+    $file->method('getMimeType')->willReturn('image/svg+xml');
+    $file->method('getFileUri')->willReturn($tmp);
+
+    $event = $this->createEvent($file);
+    $subscriber->onFileValidate($event);
+
+    chmod($tmp, 0644);
+    unlink($tmp);
+
+    $this->assertCount(1, $event->violations);
+    $this->assertStringContainsString('Unable to read', (string) $event->violations[0]->getMessage());
+  }
+
+  /**
+   * No violations for valid svg file.
+   */
+  public function testValidSvgHasNoViolations(): void {
+    $subscriber = new SvgFileValidationSubscriber();
+
+    $tmp = tempnam(sys_get_temp_dir(), 'svg');
+    file_put_contents($tmp, '<svg xmlns="http://www.w3.org/2000/svg"></svg>');
+
+    $file = $this->createMock(FileInterface::class);
+    $file->method('getMimeType')->willReturn('image/svg+xml');
+    $file->method('getFileUri')->willReturn($tmp);
+
+    $event = $this->createEvent($file);
+    $subscriber->onFileValidate($event);
+
+    unlink($tmp);
+
+    // Sanitizer should not find issues in a simple valid SVG.
+    $this->assertCount(0, $event->violations);
+  }
+
+  /**
+   * Violation for invalid svg file.
+   */
+  public function testInvalidSvgAddsViolation(): void {
+    $subscriber = new SvgFileValidationSubscriber();
+
+    $tmp = tempnam(sys_get_temp_dir(), 'svg');
+    file_put_contents($tmp, '<svg><script>alert(1)</script></svg>');
+
+    $file = $this->createMock(FileInterface::class);
+    $file->method('getMimeType')->willReturn('image/svg+xml');
+    $file->method('getFileUri')->willReturn($tmp);
+
+    $event = $this->createEvent($file);
+    $subscriber->onFileValidate($event);
+
+    unlink($tmp);
+
+    $this->assertCount(1, $event->violations);
+    $this->assertStringContainsString('Invalid or unsafe SVG', (string) $event->violations[0]->getMessage());
+  }
+
+}
