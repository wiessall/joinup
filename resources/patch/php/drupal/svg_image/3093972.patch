From 766ad4ec1749894b09bfcd71d62cb8e5b59e0f0e Mon Sep 17 00:00:00 2001
From: Ilias Dimopoulos <idimopoulos@hotmail.com>
Date: Tue, 11 Apr 2023 23:44:00 +0300
Subject: [PATCH 2/2] Handle cases where the attribute is a string.

---
 svg_image.module | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/svg_image.module b/svg_image.module
index b749ae8..e565b49 100644
--- a/svg_image.module
+++ b/svg_image.module
@@ -68,6 +68,11 @@ function svg_image_preprocess_image_style(array &$variables) {
 
       if (svg_image_is_file_svg($imageFile)) {
         $variables['image']['#access'] = TRUE;
+        if (isset($variables['image']['#attributes']['class']) && !is_array($variables['image']['#attributes']['class'])) {
+          // That means that the classes are passed as a single imploded string.
+          // We need to convert it to an array.
+          $variables['image']['#attributes']['class'] = explode(' ', $variables['image']['#attributes']['class']);
+        }
         $variables['image']['#attributes']['class'][] = 'no-image-style';
       }
     }
-- 
GitLab

