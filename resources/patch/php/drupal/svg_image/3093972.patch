From b3030458a9b07feb12d84d3f9b712659f2dc0610 Mon Sep 17 00:00:00 2001
From: Alexandre Dias <alex.jm.dias@gmail.com>
Date: Tue, 11 Apr 2023 09:46:55 +0100
Subject: [PATCH 1/2] Upload a SVG from CKEditor (image inline)

---
 svg_image.module | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/svg_image.module b/svg_image.module
index 838030e..b749ae8 100644
--- a/svg_image.module
+++ b/svg_image.module
@@ -5,6 +5,7 @@
  * Contains main functions and hooks for svg_image module.
  */
 
+use Drupal\Core\Form\FormStateInterface;
 use Drupal\file\Entity\File;
 use Drupal\svg_image\Plugin\Field\FieldFormatter\SvgImageFormatter;
 use Drupal\svg_image\Plugin\Field\FieldFormatter\SvgImageUrlFormatter;
@@ -132,3 +133,16 @@ function svg_image_get_image_file_dimensions(File $file) {
 function svg_image_is_file_svg(File $file) {
   return $file->getMimeType() === 'image/svg+xml';
 }
+
+/**
+ * Implements hook_form_BASE_FORM_ID_alter().
+ *
+ * We are altering the editor_image_dialog form to allow svg images.
+ *
+ * @see Drupal\editor\Form\EditorImageDialog
+ */
+function svg_image_form_editor_image_dialog_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
+  if (isset($form['fid']['#upload_validators']['file_validate_extensions'][0])) {
+    $form['fid']['#upload_validators']['file_validate_extensions'][0] .= ' svg';
+  }
+}
-- 
