+/**
+ * Set the retry policy for all translator entities.
+ */
+function tmgmt_ec_etranslation_update_11001(): void {
+  $translators = \Drupal::service('entity_type.manager')
+    ->getStorage('tmgmt_translator')
+    ->loadByProperties(['plugin' => ETranslationTranslator::ID]);
+
+  foreach ($translators as $translator) {
+    $translator->setSetting('retrials_after_timeout', [
+      // We keep the current site behavior: by default, the retry mechanism is
+      // disabled.
+      'max_attempts' => 0,
+      'interval' => ETranslationTranslator::MIN_RETRY_INTERVAL,
+    ])->save();
+  }
+}
