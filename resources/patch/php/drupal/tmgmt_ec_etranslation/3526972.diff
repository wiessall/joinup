+  /**
+   * Attempts to acquire a lock up to a maximum number of tries.
+   *
+   * @param string $lockName
+   *   The name of the lock to acquire.
+   * @param int $maxTries
+   *   Maximum number of acquisition attempts.
+   * @param int $waitSeconds
+   *   Seconds to wait between attempts.
+   *
+   * @throws \RuntimeException
+   *   If the lock could not be acquired after the maximum number of tries.
+   */
+  protected function acquireLockOrFail(string $lockName, int $maxTries = 10, int $waitSeconds = 1): void {
+    $tries = 0;
+
+    while (!$this->lock->acquire($lockName)) {
+      if (++$tries >= $maxTries) {
+        throw new \RuntimeException(sprintf(
+          'Could not acquire lock "%s" after %d attempts.',
+          $lockName,
+          $maxTries
+        ));
+      }
+
+      $this->lock->wait($lockName, $waitSeconds);
+    }
   }
 
