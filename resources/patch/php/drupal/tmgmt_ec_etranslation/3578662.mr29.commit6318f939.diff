+<?php
+
+/**
+ * @file
+ * Hook implementations for TMGMT Translator for eTranslation module.
+ */
+
+declare(strict_types=1);
+
+use Drupal\Core\Hook\Attribute\LegacyHook;
+use Drupal\tmgmt_ec_etranslation\Hook\ETranslationHooks;
+
+/**
+ * Implements hook_cron().
+ */
+#[LegacyHook]
+function tmgmt_ec_etranslation_cron(): void {
+  \Drupal::service(ETranslationHooks::class)->cron();
+}
