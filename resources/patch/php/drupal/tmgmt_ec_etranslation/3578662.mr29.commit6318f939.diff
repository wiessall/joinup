diff --git a/tests/src/Kernel/TimeoutTest.php b/tests/src/Kernel/TimeoutTest.php
new file mode 100644
index 0000000000000000000000000000000000000000..01856407bc1ffd6a5b0e6e5a6417f1aa5df2b3ef
--- /dev/null
+++ b/tests/src/Kernel/TimeoutTest.php
@@ -0,0 +1,124 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\tmgmt_ec_etranslation\Kernel;
+
+use Drupal\field\Entity\FieldConfig;
+use Drupal\field\Entity\FieldStorageConfig;
+use Drupal\KernelTests\KernelTestBase;
+use Drupal\language\Entity\ConfigurableLanguage;
+use Drupal\node\Entity\Node;
+use Drupal\node\Entity\NodeType;
+use Drupal\tmgmt\Entity\JobItem;
+use Drupal\tmgmt\JobInterface;
+use Drupal\tmgmt\JobItemInterface;
+use Drupal\tmgmt_ec_etranslation\Hook\ETranslationHooks;
+use Drupal\tmgmt_ec_etranslation\Plugin\tmgmt\Translator\ETranslationTranslator;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\Group;
+use PHPUnit\Framework\Attributes\RunTestsInSeparateProcesses;
+
+/**
+ * Tets handling of stale job items.
+ */
+#[Group('tmgmt_ec_etranslation')]
+#[CoversClass(ETranslationHooks::class)]
+#[RunTestsInSeparateProcesses]
+class TimeoutTest extends KernelTestBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'content_translation',
+    'field',
+    'filter',
+    'language',
+    'node',
+    'options',
+    'system',
+    'text',
+    'tmgmt',
+    'tmgmt_content',
+    'tmgmt_ec_etranslation',
+    'user',
+  ];
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+
+    $this->installEntitySchema('user');
+    $this->installEntitySchema('node');
+    $this->installEntitySchema('tmgmt_job');
+    $this->installEntitySchema('tmgmt_job_item');
+    $this->installEntitySchema('tmgmt_message');
+
+    NodeType::create(['name' => 'Page', 'type' => 'page'])->save();
+    $this->container->get('content_translation.manager')->setEnabled('node', 'page', TRUE);
+    FieldStorageConfig::create([
+      'entity_type' => 'node',
+      'field_name' => 'body',
+      'type' => 'text_long',
+    ])->save();
+    FieldConfig::create([
+      'entity_type' => 'node',
+      'bundle' => 'page',
+      'field_name' => 'body',
+      'translatable' => TRUE,
+    ])->save();
+  }
+
+  /**
+   * @covers \Drupal\tmgmt_ec_etranslation\Hook\ETranslationHooks::cron
+   */
+  public function testTimeout(): void {
+    ConfigurableLanguage::createFromLangcode('de')->save();
+    $definition = $this->container->get('plugin.manager.tmgmt.translator')->getDefinition(ETranslationTranslator::ID);
+    tmgmt_translator_auto_create($definition);
+
+    $page = Node::create([
+      'type' => 'page',
+      'title' => $this->randomString(),
+      'body' => ['value' => $this->randomString(), 'format' => filter_fallback_format()],
+    ]);
+    $page->save();
+
+    $job = tmgmt_job_create('en', 'de', 0, [
+      'translator' => ETranslationTranslator::ID,
+      'job_type' => JobInterface::TYPE_CONTINUOUS,
+    ]);
+    $job->save();
+
+    $now = \Drupal::time()->getRequestTime();
+    $six_hours_and_1_second_ago = $now - 60 * 60 * 6 - 1;
+
+    $item = tmgmt_job_item_create('content', 'node', $page->id(), [
+      'tjid' => $job->id(),
+      'state' => JobItemInterface::STATE_ACTIVE,
+      // Set the last changed time to 6 hours and 1 second ago for the sake of
+      // testing.
+      'changed' => $six_hours_and_1_second_ago,
+    ]);
+    $item->save();
+    $this->assertSame($six_hours_and_1_second_ago, $item->getChangedTime());
+
+    // Run the cron job, but only the one that matters.
+    $this->container->get(ETranslationHooks::class)->cron();
+
+    // Reload the job item.
+    $item = JobItem::load($item->id());
+
+    // Check that the job item has been aborted.
+    $this->assertEquals(JobItemInterface::STATE_ABORTED, $item->getState());
+    // Check that the job item added a meaningful message.
+    $messages = $item->getMessages();
+    $message = reset($messages);
+    $this->assertEquals('Aborted. No translation received after 6 hours', $message->getMessage());
+    $this->assertSame('warning', $message->getType());
+  }
+
+}
