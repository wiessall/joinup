index 0000000000000000000000000000000000000000..a73aca2a08ca0d9f66eb79415e7bc9fbd37cc791
--- /dev/null
+++ b/src/Hook/ETranslationHooks.php
@@ -0,0 +1,61 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\tmgmt_ec_etranslation\Hook;
+
+use Drupal\Component\Datetime\TimeInterface;
+use Drupal\Core\Entity\EntityTypeManagerInterface;
+use Drupal\Core\Hook\Attribute\Hook;
+use Drupal\tmgmt\ContinuousManager;
+use Drupal\tmgmt\JobInterface;
+use Drupal\tmgmt\JobItemInterface;
+use Drupal\tmgmt_ec_etranslation\Plugin\tmgmt\Translator\ETranslationTranslator;
+use Symfony\Component\DependencyInjection\Attribute\Autowire;
+
+/**
+ * Module hook implementations.
+ */
+class ETranslationHooks {
+
+  public function __construct(
+    protected EntityTypeManagerInterface $entityTypeManager,
+    #[Autowire(service: 'tmgmt.continuous')]
+    protected readonly ContinuousManager $continuousManager,
+    protected readonly TimeInterface $time,
+  ) {}
+
+  /**
+   * Implements hook_cron().
+   */
+  #[Hook('cron')]
+  public function cron(): void {
+    $jobStorage = $this->entityTypeManager->getStorage('tmgmt_job');
+    $jobItemStorage = $this->entityTypeManager->getStorage('tmgmt_job_item');
+
+    $jobIds = $jobStorage->getQuery()->accessCheck(FALSE)
+      ->condition('translator', ETranslationTranslator::ID)
+      ->condition('job_type', JobInterface::TYPE_CONTINUOUS)
+      ->condition('state', JobInterface::STATE_CONTINUOUS)
+      ->execute();
+
+    // Mark as aborted the continuous job items sent to eTranslation service
+    // more than 6 hours ago.
+    foreach ($jobIds as $jobId) {
+      $jobItemIds = $jobItemStorage->getQuery()
+        ->accessCheck(FALSE)
+        ->condition('tjid', $jobId)
+        ->condition('state', JobItemInterface::STATE_ACTIVE)
+        ->condition('changed', $this->time->getRequestTime() - 21600, '<')
+        ->execute();
+      if ($jobItemIds) {
+        foreach ($jobItemStorage->loadMultiple($jobItemIds) as $jobItem) {
+          $jobItem->setState(JobItemInterface::STATE_ABORTED);
+          $jobItem->addMessage(message: "Aborted. No translation received after 6 hours", type: 'warning');
+          $jobItem->save();
+        }
+      }
+    }
+  }
+
+}
