     }
   }
 }
+
+/**
+ * Set the retry policy for all translator entities.
+ */
+function tmgmt_ec_etranslation_update_11001(array &$sandbox): void {
+  \Drupal::classResolver(ConfigEntityUpdater::class)->update(
+    $sandbox,
+    'tmgmt_translator',
+    function (TranslatorInterface $translator): bool {
+      $translator->setSetting('retrials_after_timeout', [
+        // We keep the current site behavior: no retry attempts.
+        'max_attempts' => 0,
+        'interval' => ETranslationTranslator::MIN_RETRY_INTERVAL,
+      ])->save();
+      return TRUE;
+    });
+}
