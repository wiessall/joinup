+  /**
+   * Prepare the text by wrapping non-translatable parts in [notranslate] tags.
+   *
+   * Site builders are able to configure regular expressions to match parts of
+   * the text that should not be translated. This method wraps the detected
+   * non-translatable parts in [notranslate] tags, which is the eTranslation API
+   * official method to exclude parts of text from translation.
+   *
+   * The method is aware that the incoming text might contain already wrapped
+   * non-translatable parts and will preserve them.
+   *
+   * @param string $text
+   *   The initial text.
+   * @param \Drupal\tmgmt\TranslatorInterface $translator
+   *   The translator entity.
+   *
+   * @return string
+   *   The resulting text.
+   *
+   * @see https://language-tools.ec.europa.eu/dev-corner/additional-resources/tips-and-tricks#notranslate
+   */
+  protected function preserveNonTranslatables(string $text, TranslatorInterface $translator): string {
+    if (!isset($this->nonTranslatable)) {
+      $this->nonTranslatable = $translator->getSetting('non_translatable_parts');
+      // Replace non-Unix line endings.
+      $this->nonTranslatable['patterns'] = str_replace("\r", "\n", $this->nonTranslatable['patterns']);
+      // Convert to array and remove empty lines.
+      $this->nonTranslatable['patterns'] = array_filter(
+        array_map('trim', explode("\n", $this->nonTranslatable['patterns']))
+      );
+      // Accept comments starting with #.
+      $this->nonTranslatable['patterns'] = array_filter(
+        $this->nonTranslatable['patterns'],
+        fn(string $pattern): bool => !str_starts_with($pattern, '#'),
+      );
+    }
+
+    foreach ($this->nonTranslatable['patterns'] as $regexp) {
+      // Match all non-translatable parts that already exist in text before
+      // we're processing. They could be there from the original text or from a
+      // previous regexp replacement.
+      preg_match_all('#\[notranslate](?:(?!\[/notranslate]).)*\[/notranslate]#s', $text, $matches, PREG_OFFSET_CAPTURE);
+
+      $translatable_parts = $non_translatable_parts = [];
+      $index = $offset = 0;
+
+      // Split the text into translatable and non-translatable parts. We'll
+      // assemble back the parts later.
+      foreach ($matches[0] as [$non_translatable, $position]) {
+        $translatable = substr($text, $offset, $position - $offset);
+        $translatable_parts[$index++] = $translatable;
+        $offset += strlen($translatable);
+
+        $non_translatable_parts[$index++] = $non_translatable;
+        $offset += strlen($non_translatable);
+      }
+      // Potential translatable part after the last non-translatable match or
+      // there are no non-translatable parts at all.
+      if ($offset < strlen($text)) {
+        $translatable_parts[$index] = substr($text, $offset);
+      }
+
+      $regexp = '/' . str_replace('/', '\/', $regexp) . '/';
+      foreach ($translatable_parts as &$translatable) {
+        if ($this->nonTranslatable['clean']) {
+          // According to eTranslation documentation, the presence of an opening
+          // [notranslate] tag without a matching closing [/notranslate] tag
+          // will make the translation fail. At this stage $translatable_parts
+          // might contain [notranslate] tags without a matching closing
+          // [/notranslate], or [/notranslate] closing tags without a matching
+          // opening [notranslate] tag. To avoid failing the translation, we
+          // remove them because, anyway, they are a result of a malformed use.
+          // @see https://language-tools.ec.europa.eu/dev-corner/additional-resources/tips-and-tricks#notranslate
+          $translatable = str_replace(['[notranslate]', '[/notranslate]'], '', $translatable);
+        }
+
+        // Wrap the non-translatable parts in [notranslate] tags.
+        $wrapped = preg_replace($regexp, '[notranslate]${0}[/notranslate]', $translatable);
+        // Ignore a malformed regexp.
+        if ($wrapped !== NULL) {
+          $translatable = $wrapped;
+        }
+      }
+
+      $parts = $translatable_parts + $non_translatable_parts;
+      ksort($parts);
+      $text = implode('', $parts);
+    }
+
+    return $text;
+  }
+
 }
