--- /dev/null
+++ b/tests/src/Functional/NonTranslatablePartsTest.php
@@ -0,0 +1,100 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\tmgmt_ec_etranslation\Functional;
+
+use Drupal\Tests\tmgmt\Functional\TMGMTTestBase;
+use Drupal\Tests\tmgmt\Functional\TmgmtEntityTestTrait;
+use Drupal\tmgmt\Entity\JobItem;
+use Drupal\tmgmt\Entity\Translator;
+use Drupal\tmgmt\JobInterface;
+use Drupal\tmgmt\TranslatorInterface;
+use Drupal\tmgmt_ec_etranslation\Controller\CallbackController;
+use Drupal\tmgmt_ec_etranslation\Plugin\tmgmt\Translator\ETranslationTranslator;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\Group;
+
+/**
+ * Integration test for the non-translatable text parts.
+ */
+#[Group('tmgmt_ec_etranslation')]
+#[CoversClass(ETranslationTranslator::class)]
+#[CoversClass(CallbackController::class)]
+class NonTranslatablePartsTest extends TMGMTTestBase {
+
+  use TmgmtEntityTestTrait;
+
+  /**
+   * The translator entity.
+   */
+  protected TranslatorInterface $translator;
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'http_request_mock',
+    'tmgmt_content',
+    'tmgmt_ec_etranslation',
+    'tmgmt_ec_etranslation_test',
+  ];
+
+  /**
+   * {@inheritdoc}
+   */
+  public function setUp(): void {
+    parent::setUp();
+
+    $this->addLanguage('de');
+    $this->createNodeType('page', 'Page', TRUE, FALSE);
+
+    $this->translator = (Translator::load(ETranslationTranslator::ID))
+      ->setSetting('username', $this->randomMachineName())
+      ->setSetting('password', $this->randomString())
+      ->setSetting('domain', 'SPD')
+      ->setSetting('use_queue', FALSE)
+      ->setSetting('non_translatable_parts', [
+        'patterns' => <<<PATTERN
+          # Drupal placeholders
+          [@!%][a-zA-Z0-9:_-]+
+          # Drupal tokens
+          \[[a-zA-Z0-9:_-]+\]
+          PATTERN,
+        'clean' => TRUE,
+      ]);
+    $this->translator->save();
+  }
+
+  /**
+   * Tests basic API methods of the plugin.
+   */
+  public function testNonTranslatableParts(): void {
+    $node = $this->createTranslatableNode('page')
+      ->set('title', 'Test page')
+      ->set('body', [
+        'value' => 'Hi [user:name], will you be attending the @event event on [date:custom:Y-m-d]?',
+        'format' => filter_default_format(),
+      ]);
+    $node->save();
+
+    $job = $this->createJob('en', 'de', 0, [
+      'label' => $this->randomString(),
+      'job_type' => JobInterface::TYPE_CONTINUOUS,
+      'translator' => $this->translator->id(),
+    ]);
+    $job->save();
+    $item = $job->addItem('content', 'node', $node->id());
+
+    // Perform translation.
+    $this->assertTrue($job->canRequestTranslation()->getSuccess());
+    $job->requestTranslation();
+
+    $this->assertEquals(2, $job->getCountTranslated());
+
+    $item = JobItem::load($item->id());
+    $translation = $item->getData(['body', 0, 'value', '#translation', '#text']);
+    $this->assertSame('Hallo [user:name], wirst du an der @event am [date:custom:Y-m-d] teilnehmen?', $translation);
+  }
+
+}
