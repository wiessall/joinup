@@ -0,0 +1,160 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\tmgmt_ec_etranslation\Unit;
+
+use Drupal\tmgmt\TranslatorInterface;
+use Drupal\tmgmt_ec_etranslation\Plugin\tmgmt\Translator\ETranslationTranslator;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\DataProvider;
+use PHPUnit\Framework\Attributes\Group;
+use PHPUnit\Framework\TestCase;
+
+/**
+ * Tests non-translatable text chunks.
+ */
+#[Group('tmgmt_ec_etranslation')]
+#[CoversClass(ETranslationTranslator::class)]
+class NonTranslatableStringsTest extends TestCase {
+
+  /**
+   * Tests non-translatable strings.
+   *
+   * @param string $patterns
+   *   A text blob containing one-per-line regular expressions.
+   * @param bool $clean
+   *   Whether to clean the text for malformed [notranslate] tags.
+   * @param string $text
+   *   The text to test.
+   * @param string $expected
+   *   The expected processed text.
+   *
+   * @legacy-covers ::prepareText
+   * @dataProvider nonTranslatableStringsProvider
+   */
+  #[DataProvider('nonTranslatableStringsProvider')]
+  public function testNonTranslatableStrings(string $patterns, bool $clean, string $text, string $expected): void {
+    $translator = $this->createMock(TranslatorInterface::class);
+    $translator
+      ->method('getSetting')
+      ->with('non_translatable_parts')
+      ->willReturn(['patterns' => $patterns, 'clean' => $clean]);
+
+    $method = new \ReflectionMethod(ETranslationTranslator::class, 'preserveNonTranslatables');
+    $actual = $method->invoke(new ETranslationTranslator([], ETranslationTranslator::ID, []), $text, $translator);
+    $this->assertSame($expected, $actual);
+  }
+
+  /**
+   * Provides test data for testNonTranslatableStrings().
+   *
+   * @return iterable
+   *   List of test cases.
+   */
+  public static function nonTranslatableStringsProvider(): iterable {
+    yield 'No filtering' => [
+      "\r\n \n\n   \t",
+      TRUE,
+      'Foo bar baz',
+      'Foo bar baz',
+    ];
+
+    yield 'Drupal placeholders' => [
+      <<<PATTERN
+        # This is a comment
+        [@!%][a-zA-Z0-9:_-]+
+        PATTERN,
+      TRUE,
+      <<<TEXT
+        @foo valid placeholder
+        !bar valid placeholder
+        %baz valid placeholder
+        §qux invalid placeholder
+        TEXT,
+      <<<EXPECTED
+        [notranslate]@foo[/notranslate] valid placeholder
+        [notranslate]!bar[/notranslate] valid placeholder
+        [notranslate]%baz[/notranslate] valid placeholder
+        §qux invalid placeholder
+        EXPECTED,
+    ];
+
+    yield 'Drupal placeholders with non-alphanumeric characters' => [
+      <<<PATTERN
+        # This is a comment
+        [@!%][a-zA-Z0-9:_-]+
+        PATTERN,
+      TRUE,
+      <<<TEXT
+        @foo123_abc:some-placeholder valid placeholder
+        !bar098_xyz:other-placeholder valid placeholder
+        %baz90x_123:more:complex:place-holder_1 valid placeholder
+        §qux111_some invalid placeholder
+        TEXT,
+      <<<EXPECTED
+        [notranslate]@foo123_abc:some-placeholder[/notranslate] valid placeholder
+        [notranslate]!bar098_xyz:other-placeholder[/notranslate] valid placeholder
+        [notranslate]%baz90x_123:more:complex:place-holder_1[/notranslate] valid placeholder
+        §qux111_some invalid placeholder
+        EXPECTED,
+    ];
+
+    yield 'Drupal placeholders and tokens with initial [notranslate] tags' => [
+      <<<PATTERN
+        # Drupal placeholders
+        [@!%][a-zA-Z0-9:_-]+
+        # Drupal tokens
+        \[[a-zA-Z0-9:_-]+\]
+        PATTERN,
+      TRUE,
+      <<<TEXT
+        [notranslate]@place:holder inside
+          non-translatable area 😍[/notranslate],
+        [notranslate][drupal:token] inside
+          non-translatable area[/notranslate],
+        and [notranslate]a 3rd !placeholder in non-translatable area[/notranslate]
+        missing opening tag: [/notranslate] but @qux will be wrapped 👏
+        missing closing tag: [notranslate] but @quux will be wrapped
+        TEXT,
+      <<<EXPECTED
+        [notranslate]@place:holder inside
+          non-translatable area 😍[/notranslate],
+        [notranslate][drupal:token] inside
+          non-translatable area[/notranslate],
+        and [notranslate]a 3rd !placeholder in non-translatable area[/notranslate]
+        missing opening tag:  but [notranslate]@qux[/notranslate] will be wrapped 👏
+        missing closing tag:  but [notranslate]@quux[/notranslate] will be wrapped
+        EXPECTED,
+    ];
+
+    yield 'Drupal placeholders and tokens with initial [notranslate] tags. Preserve malformed tags.' => [
+      <<<PATTERN
+        # Drupal placeholders
+        [@!%][a-zA-Z0-9:_-]+
+        # Drupal tokens
+        \[[a-zA-Z0-9:_-]+\]
+        PATTERN,
