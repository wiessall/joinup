+    $form_state->setValue($parents, $element['layout_paragraphs_storage_key']['#default_value']);
+
+    return $element;
+  }
+
+  public static function validate($element, FormStateInterface $form_state) {
+    if (empty($element['#is_stale'])) {
+      return;
+    }
+
+    $form_state->setError($element, t('The <em>@label</em> field has stale values, please amend the content.', [
+      '@label' => $element['#title'],
+    ]));
+  }
