From: drishu <aszilagyi@live.com>
Date: Tue, 3 Jun 2025 14:05:35 +0200
Subject: [PATCH 1/5] Test the back behaviour.

---
 .../FunctionalJavascript/BackButtonTest.php   | 59 +++++++++++++++++++
 1 file changed, 59 insertions(+)
 create mode 100644 tests/src/FunctionalJavascript/BackButtonTest.php

diff --git a/tests/src/FunctionalJavascript/BackButtonTest.php b/tests/src/FunctionalJavascript/BackButtonTest.php
new file mode 100644
index 00000000..38178c68
--- /dev/null
+++ b/tests/src/FunctionalJavascript/BackButtonTest.php
@@ -0,0 +1,59 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\layout_paragraphs\FunctionalJavascript;
+
+/**
+ * Tests that behaviour when the browser back button is used.
+ *
+ * @see https://www.drupal.org/project/layout_paragraphs/issues/3528058
+ * @group layout_paragraphs
+ */
+class BackButtonTest extends BuilderTestBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'layout_paragraphs',
+    'paragraphs',
+    'node',
+    'field',
+    'field_ui',
+    'block',
+    'paragraphs_test',
+    'layout_paragraphs_form_rendering_test',
+  ];
+
+  /**
+   * Tests the back button behavior in the Layout Paragraphs widget.
+   */
+  public function testBackButtonBehavior() {
+    $this->loginWithPermissions([
+      'create page content',
+      'edit own page content',
+    ]);
+
+    $this->drupalGet('node/add/page');
+    $page = $this->getSession()->getPage();
+
+    $this->addSectionComponent(0, '.lpb-btn--add');
+    // Make sure the "Test field" form element appears.
+    $this->assertSession()->pageTextContains('Test field');
+    // Save the node.
+    $this->submitForm([
+      'title[0][value]' => 'Node title',
+    ], 'Save');
+    // Make sure the node appears correctly.
+    $this->assertSession()->pageTextContains('Node title');
+    $this->assertSession()->pageTextContains('Test field');
+
+    // Go back.
+    $this->getSession()->back();
+    $this->getSession()->getPage()->pressButton('Save');
+echo $page->getHtml();
+    $this->assertSession()->pageTextContains('The Test field field has stale values, please amend the content.');
+  }
+
+}
-- 
