+  public static function afterBuildStorageKey(array $element, FormStateInterface $form_state) {
+    if (empty($element['#is_stale'])) {
+      return $element;
+    }
+
+    $element['layout_paragraphs_storage_key']['#value'] = $element['layout_paragraphs_storage_key']['#default_value'];
