From dc235b0a5ef1625f0f3b4762264f9133e259c11c Mon Sep 17 00:00:00 2001
From: Thomas Seidl <remus@gmx.net>
Date: Sun, 8 Jan 2023 22:13:05 +0100
Subject: [PATCH 2/2] Improve clarity of comment and call existing alter hooks.

---
 js/search_api_autocomplete.js | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/js/search_api_autocomplete.js b/js/search_api_autocomplete.js
index 54b0629..27d38e1 100644
--- a/js/search_api_autocomplete.js
+++ b/js/search_api_autocomplete.js
@@ -61,10 +61,14 @@
         '.ui-autocomplete-input[data-search-api-autocomplete-search]',
         context)).each(function () {
 
-        // Clear timeout autosubmit used in views_autosubmit.
-        if (Drupal.behaviors.ViewsAutoSubmit.alterTextInputTimeout) {
+        // In case the Views Autosubmit module is installed, clear the
+        // auto-submit timeout.
+        if (Drupal.behaviors.ViewsAutoSubmit
+            && Drupal.behaviors.ViewsAutoSubmit.alterTextInputTimeout) {
+          var old = Drupal.behaviors.ViewsAutoSubmit.alterTextInputTimeout;
           Drupal.behaviors.ViewsAutoSubmit.alterTextInputTimeout = function(timeoutID) {
-            return clearTimeout(timeoutID);
+            old(timeoutID);
+            clearTimeout(timeoutID);
           }
         }
 
-- 
