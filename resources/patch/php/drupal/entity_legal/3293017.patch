diff --git a/entity_legal.install b/entity_legal.install
index 4320f17..9ca52c0 100644
--- a/entity_legal.install
+++ b/entity_legal.install
@@ -153,3 +153,25 @@ function entity_legal_update_9001(array &$sandbox = NULL) {
     '@total' => $sandbox['total'],
   ]);
 }
+
+/**
+ * Add acceptance_error_message and submit_label fields.
+ */
+function entity_legal_update_9002(): void {
+  $definitions = [
+    'acceptance_error_message' => BaseFieldDefinition::create('text_long')
+      ->setLabel(t('Acceptance error message'))
+      ->setDescription(t('Error message to be show when the form is submitted without being accepted. If empty, the standard error message is used.'))
+      ->setTranslatable(TRUE)
+      ->setRequired(FALSE),
+    'submit_label' => BaseFieldDefinition::create('string')
+      ->setLabel(t('Submit label'))
+      ->setDescription(t('Submit button label. If empty, "Submit" is used.'))
+      ->setTranslatable(TRUE)
+      ->setRequired(FALSE),
+  ];
+  $manager = \Drupal::entityDefinitionUpdateManager();
+  foreach ($definitions as $field_name => $definition) {
+    $manager->installFieldStorageDefinition($field_name, 'entity_legal_document_version', 'entity_legal', $definition);
+  }
+}
