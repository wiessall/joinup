+      ->setDescription(t('Error message to be show when the form is submitted without being accepted. If empty, the standard error message is used.'))
+      ->setTranslatable(TRUE)
+      ->setRequired(FALSE);
+
+    $fields['submit_label'] = BaseFieldDefinition::create('string')
+      ->setLabel(t('Submit label'))
+      ->setDescription(t('Submit button label. If empty, "Submit" is used.'))
+      ->setTranslatable(TRUE)
+      ->setRequired(FALSE);
+
