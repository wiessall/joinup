+  /**
+   * Tests custom validation error message and custom submit button label.
+   */
+  public function testCustomStrings(): void {
+    FilterFormat::create(['format' => 'test', 'name' => $this->randomString()])
+      ->setFilterConfig('filter_html',[
+        'status' => TRUE,
+        'settings' => [
+          'allowed_html' => '<a href>'
+        ],
+      ])->save();
+
+    $document = $this->createDocument(TRUE, TRUE, [
+      'existing_users' => [
+        'require_method' => 'redirect',
+      ],
+    ]);
+    $version = $this->createDocumentVersion($document, TRUE, [
+      'acceptance_error_message' => [
+        'value' => 'You cannot login without accepting <a href="[entity_legal_document:url]">[entity_legal_document:label] (version [entity_legal_document_version:label])</a>',
+        'format' => 'test',
+      ],
+      'submit_label' => 'Proceed!',
+    ]);
+    $this->drupalLogin($this->drupalCreateUser([
+      $document->getPermissionView(),
+      $document->getPermissionExistingUser(),
+    ]));
+
+    $assert = $this->assertSession();
+    $assert->buttonNotExists('Submit');
+    $assert->buttonExists('Proceed!');
+
+    $this->getSession()->getPage()->pressButton('Proceed!');
+    $assert->statusMessageContains("You cannot login without accepting {$document->label()} (version {$version->label()})");
+    $assert->responseContains('You cannot login without accepting <a href="' . $document->toUrl('canonical')->setAbsolute()->toString() . '">' . $document->label() . ' (version ' . $version->label() . ')</a>');
+  }
+
 }
