+<?php
+
+/**
+ * @file
+ * Provides Views integration for RDF Sync module.
+ */
+
+declare(strict_types=1);
+
+use Drupal\Core\Entity\EntityTypeManagerInterface;
+use Drupal\rdf_sync\RdfSyncMapperInterface;
+
+/**
+ * Implements hook_views_data().
+ */
+function rdf_sync_views_data(): array {
+  $data = [];
+
+  $data['rdf_sync_uri']['table']['group'] = t('RDF Sync');
+  $data['rdf_sync_uri']['table']['base'] = [
+    'title' => t('RDF URI mapping'),
+    'help' => t('Contains the mapping between entities and their RDF URIs.'),
+    'field' => 'uri',
+  ];
+
+  $data['rdf_sync_uri']['entity_type'] = [
+    'title' => t('Entity type'),
+    'help' => t('The entity type ID.'),
+    'field' => [
+      'id' => 'standard',
+    ],
+    'filter' => [
+      'id' => 'string',
+    ],
+    'sort' => [
+      'id' => 'standard',
+    ],
+    'argument' => [
+      'id' => 'string',
+    ],
+  ];
+
+  $data['rdf_sync_uri']['entity_id'] = [
+    'title' => t('Entity ID'),
+    'help' => t('The entity ID.'),
+    'field' => [
+      'id' => 'standard',
+    ],
+    'filter' => [
+      'id' => 'string',
+    ],
+    'sort' => [
+      'id' => 'standard',
+    ],
+    'argument' => [
+      'id' => 'string',
+    ],
+  ];
+
+  $data['rdf_sync_uri']['bundle'] = [
+    'title' => t('Bundle'),
+    'help' => t('The bundle of the entity.'),
+    'field' => [
+      'id' => 'standard',
+    ],
+    'filter' => [
+      'id' => 'string',
+    ],
+    'sort' => [
+      'id' => 'standard',
+    ],
+    'argument' => [
+      'id' => 'string',
+    ],
+  ];
+
+  $data['rdf_sync_uri']['uri'] = [
+    'title' => t('RDF URI'),
+    'help' => t('The RDF URI of the entity.'),
+    'field' => [
+      'id' => 'standard',
+    ],
+    'filter' => [
+      'id' => 'string',
+    ],
+    'sort' => [
+      'id' => 'standard',
+    ],
+    'argument' => [
+      'id' => 'string',
+    ],
+  ];
+
+  return $data;
+}
+
+/**
+ * Implements hook_views_data_alter().
+ */
+function rdf_sync_views_data_alter(array &$data): void {
+  $entityTypeManager = \Drupal::service('entity_type.manager');
+  \assert($entityTypeManager instanceof EntityTypeManagerInterface);
+
+  $rdfSyncMapper = \Drupal::service('rdf_sync.mapper');
+  \assert($rdfSyncMapper instanceof RdfSyncMapperInterface);
+
+  foreach ($entityTypeManager->getDefinitions() as $entityTypeId => $entityType) {
+    if (!$rdfSyncMapper->entityTypeHasMappings($entityTypeId)) {
+      continue;
+    }
+
+    $baseTable = $entityType->getDataTable() ?: $entityType->getBaseTable();
+    if (!$baseTable || !isset($data[$baseTable])) {
+      continue;
+    }
+
+    $data[$baseTable]['rdf_sync_uri'] = [
+      'title' => t('RDF URI'),
+      'help' => t('The RDF URI associated with this @entity_type.', [
+        '@entity_type' => $entityType->getLabel(),
+      ]),
+      'relationship' => [
+        'base' => 'rdf_sync_uri',
+        'base field' => 'entity_id',
+        'relationship field' => $entityType->getKey('id'),
+        'id' => 'standard',
+        'label' => t('RDF URI'),
+        'extra' => [
+          [
+            'field' => 'entity_type',
+            'value' => $entityTypeId,
+          ],
+        ],
+      ],
+    ];
+  }
+}
