+  /**
+   * Tests that duplicating an entity generates a fresh URI.
+   *
+   * @covers \Drupal\rdf_sync\RdfSyncUriFieldItemList::__clone
+   */
+  public function testUriFieldDuplicate(): void {
+    $term = Term::create(['vid' => 'category', 'name' => $this->randomString()]);
+    $term->save();
+
+    $originalUri = $term->get('uri')->value;
+    $this->assertNotEmpty($originalUri);
+
+    $duplicate = $term->createDuplicate();
+    $duplicate->save();
+
+    // Post-save state: the duplicate's URI should differ from the original's.
+    $duplicateUri = $duplicate->get('uri')->value;
+    $this->assertNotEmpty($duplicateUri);
+    $this->assertNotSame($originalUri, $duplicateUri);
+
+    // The duplicate URI should be based on the duplicate's own UUID.
+    $expectedDuplicateUri = $GLOBALS['base_url'] . '/taxonomy-term/category/' . $duplicate->uuid();
+    $this->assertSame($expectedDuplicateUri, $duplicateUri);
+  }
+
