+/**
+ * Implements hook_entity_duplicate().
+ */
+function rdf_sync_entity_duplicate(EntityInterface $duplicate, EntityInterface $entity): void {
+  $mapper = \Drupal::getContainer()->get('rdf_sync.mapper');
+  if ($duplicate instanceof ContentEntityInterface && $mapper->isMappedEntity($duplicate)) {
+    $fieldName = $mapper->getRdfUriFieldName(entity: $duplicate);
+    $duplicate->get($fieldName)->setValue(NULL);
+  }
+}
