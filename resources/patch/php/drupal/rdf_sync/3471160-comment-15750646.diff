+  /**
+   * Returns a list entities given a list of URIs.
+   *
+   * @param string[] $uris
+   *   List of URIs
+   *
+   * @return \Drupal\Core\Entity\ContentEntityInterface[]
+   *   Associative array of entities keyed by their ID.
+   */
+  public function getEntitiesByUris(array $uris): array {
+    $rows = $this->database->select('rdf_sync_uri')
+      ->fields('rdf_sync_uri', ['uri', 'entity_type', 'entity_id'])
+      ->condition('uri', [$uris], 'IN')
+      ->execute()
+      ->fetchAllAssoc('uri', \PDO::FETCH_NUM);
+
+    $byEntityTypeId = $byUri = $return = [];
+
+    foreach ($rows as $uri => [$entityTypeId, $entityId]) {
+      $byEntityTypeId[$entityTypeId][] = $entityId;
+      $byUri[$uri][$entityTypeId][] = $entityId;
+    }
+
+    foreach ($byEntityTypeId as $entityTypeId => $entityIds) {
+      $storage = $this->entityTypeManager->getStorage($entityTypeId);
+      $byEntityTypeId[$entityTypeId] = $storage->loadMultiple($entityIds);
+    }
+
+    // Preserve the original URIs order.
+    foreach ($byUri as $uri => $types) {
+      foreach ($types as $entityTypeId => $entityIds) {
+        foreach ($entityIds as $entityId) {
+          $return[$entityId] = $byEntityTypeId[$entityTypeId][$entityId];
+        }
+      }
+    }
+
+    return $return;
+  }
+
