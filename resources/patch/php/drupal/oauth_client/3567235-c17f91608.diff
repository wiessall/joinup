diff --git a/oauth_client.install b/oauth_client.install
new file mode 100644
index 0000000000000000000000000000000000000000..1786f65e644ff23749427fe6478dd9a9863d808a
--- /dev/null
+++ b/oauth_client.install
@@ -0,0 +1,31 @@
+<?php
+
+/**
+ * @file
+ * Install, update and uninstall functions for the OAuth Client module.
+ */
+
+declare(strict_types=1);
+
+/**
+ * Migrate notification settings from global config to request types.
+ */
+function oauth_client_update_10001(): void {
+  $configFactory = \Drupal::configFactory();
+  $entityTypeManager = \Drupal::entityTypeManager();
+
+  $globalSettings = $configFactory->get('oauth_client.settings');
+  $globalNotifications = $globalSettings->get('notifications');
+
+  if (empty($globalNotifications)) {
+    return;
+  }
+
+  $requestTypeStorage = $entityTypeManager->getStorage('oauth_client_request_type');
+  $requestTypes = $requestTypeStorage->loadMultiple();
+
+  foreach ($requestTypes as $requestType) {
+    $requestType->set('notifications', $globalNotifications);
+    $requestType->save();
+  }
+}
