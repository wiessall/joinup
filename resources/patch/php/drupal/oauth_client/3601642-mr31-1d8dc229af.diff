@@ -427,4 +431,102 @@ class OauthClientRequest extends ContentEntityBase implements OauthClientRequest
     return $fields;
   }
 
+  /**
+   * {@inheritdoc}
+   */
+  public function postSave(EntityStorageInterface $storage, $update = TRUE): void {
+    parent::postSave($storage, $update);
+    // Don't do anything if entity was saved by a synchronization operation.
+    if ($this->isSyncing()) {
+      return;
+    }
+
+    $this->ensureClientIfActive($update);
+
+    $notificationEvent = $this->getNotificationEvent($update);
+    if (is_null($notificationEvent)) {
+      return;
+    }
+
+    \Drupal::service('event_dispatcher')->dispatch($notificationEvent);
+  }
+
+  /**
+   * Ensures that an active request has a client.
+   *
+   * @param bool $update
+   *   Whether the current entity was updated. FALSE if it was a new entity.
+   */
+  protected function ensureClientIfActive(bool $update): void {
+    // Return early if the request already have a client.
+    if ($this->getClient()) {
+      return;
+    }
+
+    // Only active requests must have a client.
+    if ($this->getStatus() !== OauthClientRequestStatus::Active) {
+      return;
+    }
+
+    $original = DeprecationHelper::backwardsCompatibleCall(
+      \Drupal::VERSION,
+      '11.2.0',
+      // @phpstan-ignore-next-line
+      fn() => $this->getOriginal(),
+      fn() => $this->original,
+    );
+
+    // Check if the status changed from pending or rejected to active.
+    $previousStatuses = [
+      OauthClientRequestStatus::Pending,
+      OauthClientRequestStatus::Rejected,
+    ];
+    $isPendingOrRejected = in_array($original?->getStatus(), $previousStatuses, TRUE);
+
+    if (!$update || $isPendingOrRejected) {
+      $consumer = \Drupal::service(OauthClientConsumerService::class)->createConsumerFromRequest($this);
+      $this->setClient($consumer)->save();
+    }
+  }
+
+  /**
+   * Creates a notification event based on the current state of the entity.
+   *
+   * @param bool $update
+   *   Whether the entity was updated. FALSE if the request was created just
+   *   now.
+   *
+   * @return object|null
+   *   An object representing the event, or NULL if there is dispatching an
+   *   event is not needed.
+   */
+  protected function getNotificationEvent(bool $update): ?object {
+    $original = DeprecationHelper::backwardsCompatibleCall(
+      \Drupal::VERSION,
+      '11.2.0',
+      // @phpstan-ignore-next-line
+      fn() => $this->getOriginal(),
+      fn() => $this->original,
+    );
+    $previousStatus = $original?->getStatus();
+    $newStatus = $this->getStatus();
+
+    $notificationType = match ([$previousStatus, $newStatus]) {
+      // Pattern: from, to.
+      [OauthClientRequestStatus::Pending, OauthClientRequestStatus::Active] => NotificationType::Approve,
+      [OauthClientRequestStatus::Pending, OauthClientRequestStatus::Rejected] => NotificationType::Reject,
+      default => NULL,
+    };
+
+    // In case of a new request, we want to dispatch the request notification
+    // type's event if the target status is not "Active".
+    if (!$update && $newStatus !== OauthClientRequestStatus::Active) {
+      $notificationType = NotificationType::Request;
+    }
+
+    return $notificationType instanceof NotificationType
+      ? new NotificationEvent($this, $notificationType)
+      : NULL;
+  }
+
 }
