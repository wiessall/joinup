new file mode 100644
index 0000000000000000000000000000000000000000..440ab61486cc68d322a371f63c1a5a4b797c87d5
--- /dev/null
+++ b/tests/src/Traits/OauthClientTestTrait.php
@@ -0,0 +1,31 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\oauth_client\Traits;
+
+use Drupal\user\UserInterface;
+
+/**
+ * Trait of common methods used in OAuth Client tests.
+ */
+trait OauthClientTestTrait {
+
+  /**
+   * Fetches a user object by account name.
+   *
+   * @param string $name
+   *   String with the account's user name.
+   *
+   * @return \Drupal\user\UserInterface|false
+   *   A fully-loaded $user object upon successful user load or FALSE if user
+   *   cannot be loaded.
+   */
+  protected function userLoadByName(string $name): ?UserInterface {
+    $user = current(\Drupal::entityTypeManager()->getStorage('user')
+      ->loadByProperties(['name' => $name]));
+    assert(!$user || $user instanceof UserInterface);
+    return $user ?: NULL;
+  }
+
+}
