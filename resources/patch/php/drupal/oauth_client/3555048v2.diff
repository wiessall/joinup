+<?php
+
+/**
+ * @file
+ * Post update functions for OAuth Client.
+ */
+
+use Drupal\Core\Config\FileStorage;
+use Drupal\filter\Entity\FilterFormat;
+
+/**
+ * Install the OAuth Client Minimal filter format.
+ */
+function oauth_client_post_update_8001(): string {
+  if (FilterFormat::load('oauth_client_minimal')) {
+    return t('OAuth Client Minimal filter format already exists.');
+  }
+
+  $config_path = \Drupal::service('extension.list.module')->getPath('oauth_client') . '/config/install';
+  $source = new FileStorage($config_path);
+  $config_data = $source->read('filter.format.oauth_client_minimal');
+
+  if ($config_data) {
+    $format = FilterFormat::create($config_data);
+    $format->save();
+    return t('OAuth Client Minimal filter format has been installed.');
+  }
+
+  return t('Could not load OAuth Client Minimal filter format configuration.');
+}
