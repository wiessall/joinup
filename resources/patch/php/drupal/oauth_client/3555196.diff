+    // Test forbidden transitions.
+    $this->assertTransitionViolation($request, OauthClientRequestStatus::Active, OauthClientRequestStatus::Pending);
+    $this->assertTransitionViolation($request, OauthClientRequestStatus::Active, OauthClientRequestStatus::Rejected);
+    $this->assertTransitionViolation($request, OauthClientRequestStatus::Rejected, OauthClientRequestStatus::Pending);
+  }
+
+  /**
+   * Asserts that an invalid status transition triggers a validation violation.
+   *
+   * @param \Drupal\oauth_client\Entity\OauthClientRequest $request
+   *   The OAuth client request entity.
+   * @param \Drupal\oauth_client\Entity\OauthClientRequestStatus $from
+   *   The starting status.
+   * @param \Drupal\oauth_client\Entity\OauthClientRequestStatus $to
+   *   The desired status.
+   */
+  protected function assertTransitionViolation(OauthClientRequest &$request, OauthClientRequestStatus $from, OauthClientRequestStatus $to): void {
+    $request->setStatus($from);
+    $request->save();
+    $request->setStatus($to);
+    $violations = $request->validate();
+    $this->assertCount(1, $violations);
+
+    /** @var \Drupal\Core\StringTranslation\TranslatableMarkup $message */
+    $message = $violations->get(0)->getMessage();
+    $expected = sprintf(
+      'The transition from status "%s" to "%s" is not allowed.',
+      $from->value,
+      $to->value,
+    );
+    $this->assertSame($expected, $message->render());
   }
 
 }
