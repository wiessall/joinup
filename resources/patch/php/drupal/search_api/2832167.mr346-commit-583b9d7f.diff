+  /**
+   * Determines whether to narrow the "updated" translations down.
+   *
+   * @param \Drupal\Core\Entity\ContentEntityInterface $entity
+   *   The updated entity.
+   * @param \Drupal\search_api\IndexInterface $index
+   *   The index being checked.
+   * @param string $datasource_id
+   *   The ID of the entity's "entity:<type>" datasource on that index.
+   *
+   * @return bool
+   *   TRUE if getAffectedTranslations() should be used to narrow the
+   *   "updated" bucket down for this index.
+   */
+  protected function shouldLimitToAffectedTranslations(ContentEntityInterface $entity, IndexInterface $index, string $datasource_id): bool {
+    if (!$entity->getEntityType()->isTranslatable()) {
+      return FALSE;
+    }
+
+    try {
+      $datasource_config = $index->getDatasource($datasource_id)->getConfiguration();
+    }
+    catch (SearchApiException) {
+      return FALSE;
+    }
+    if (empty($datasource_config['track_changes_only_affected_translations'])) {
+      return FALSE;
+    }
+
+    // Untranslatable fields are indexed into every translation's item, but
+    // for this setting they only mark the default translation as affected,
+    // so an affected default translation is ambiguous.
+    return !$entity->isDefaultTranslationAffectedOnly() || !$entity->getUntranslated()->hasTranslationChanges();
+  }
+
+  /**
+   * Narrows a set of updated item IDs down to the ones actually changed.
+   *
+   * @param \Drupal\Core\Entity\ContentEntityInterface $entity
+   *   The updated entity, already containing the new field values.
+   * @param string[] $updated_ids
+   *   The item IDs to narrow down (the "updated" bucket).
+   * @param string[] $inserted_ids
+   *   The item IDs for translations newly inserted in the same pass.
+   *
+   * @return string[]
+   *   The item IDs that should actually be queued for re-indexing.
+   */
+  protected function getAffectedTranslations(ContentEntityInterface $entity, array $updated_ids, array $inserted_ids = []): array {
+    $affected_ids = [];
+    foreach ($updated_ids as $id) {
+      $langcode = substr($id, strrpos($id, ':') + 1);
+      if ($entity->getTranslation($langcode)->hasTranslationChanges()) {
+        $affected_ids[] = $id;
+      }
+    }
+    // If a translation was just inserted, trust an empty result; otherwise
+    // fall back to the full set, since detection may have missed something.
+    return $affected_ids ?: ($inserted_ids ? [] : $updated_ids);
+  }
+
