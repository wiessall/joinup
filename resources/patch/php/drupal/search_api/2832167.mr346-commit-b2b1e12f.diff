+    $this->index->removeProcessor('content_access');
+    $datasource = $this->index->getDatasource('entity:node');
+    $datasource->setConfiguration(['track_changes_only_affected_translations' => TRUE] + $datasource->getConfiguration());
+    $this->index->save();
+    $this->triggerPostRequestIndexing();
+
+    $entity = Node::load($entity->id());
+    $entity->removeTranslation('l1');
+    $entity->save();
+
+    $this->assertEqualsCanonicalizing(
+      ['entity:node/1:en'],
+      $this->index->getTrackerInstance()->getRemainingItems()
+    );
+  }
+
+  /**
+   * Tests that a no-op save (no field changes) re-indexes no translation.
+   *
+   * @covers ::trackEntityChange
+   * @covers ::getAffectedTranslations
+   */
+  public function testNoOpSaveReindexesNoTranslation(): void {
+    ConfigurableLanguage::create([
+      'id' => 'l2',
+      'label' => 'language - 2',
+      'weight' => 2,
+    ])->save();
+    $this->container->get('language_manager')->reset();
+
+    $entity = Node::create([
+      'nid' => 1,
+      'type' => 'node',
+      'langcode' => 'en',
+      'title' => 'English title',
+    ]);
+    $entity->addTranslation('l1')->setTitle('Language 1 title');
+    $entity->addTranslation('l2')->setTitle('Language 2 title');
+    $entity->save();
+
+    // Enable the setting, then index everything it marked for re-indexing.
+    // The "Content access" processor always tracks the active translation, in
+    // search_api_node_access_records_alter(), so remove it to not interfere.
+    $this->index->removeProcessor('content_access');
+    $datasource = $this->index->getDatasource('entity:node');
+    $datasource->setConfiguration(['track_changes_only_affected_translations' => TRUE] + $datasource->getConfiguration());
+    $this->index->save();
+    $this->triggerPostRequestIndexing();
+
+    $entity = Node::load($entity->id());
+    // Re-save the "l1" translation without changing any field. Since no
+    // change is detected on any translation, none of them is re-indexed.
+    $entity->getTranslation('l1')->save();
+
+    $this->assertEquals([], $this->index->getTrackerInstance()->getRemainingItems());
+  }
+
+  /**
+   * Tests that changing an untranslatable field re-indexes all translations.
+   *
+   * The value of an untranslatable field is shared by every translation, so a
+   * change to it must mark all of them as affected. (None of the node base
+   * fields that can be changed here is untranslatable, so the test adds its
+   * own.)
+   *
+   * @covers ::trackEntityChange
+   * @covers ::getAffectedTranslations
+   */
+  public function testUntranslatableFieldChangeReindexesAllTranslations(): void {
+    ConfigurableLanguage::create([
+      'id' => 'l2',
+      'label' => 'language - 2',
+      'weight' => 2,
+    ])->save();
+    $this->container->get('language_manager')->reset();
+
+    NodeType::create(['type' => 'node', 'name' => 'Node'])->save();
+    FieldStorageConfig::create([
+      'field_name' => 'field_shared',
+      'entity_type' => 'node',
+      'type' => 'string',
+    ])->save();
+    FieldConfig::create([
+      'field_name' => 'field_shared',
+      'entity_type' => 'node',
+      'bundle' => 'node',
+      'translatable' => FALSE,
+    ])->save();
+
+    $entity = Node::create([
+      'nid' => 1,
+      'type' => 'node',
+      'langcode' => 'en',
+      'title' => 'English title',
+      'field_shared' => 'Shared value',
+    ]);
+    $entity->addTranslation('l1')->setTitle('Language 1 title');
+    $entity->addTranslation('l2')->setTitle('Language 2 title');
+    $entity->save();
+
+    // Enable the setting, then index everything it marked for re-indexing.
+    // The "Content access" processor always tracks the active translation, in
+    // search_api_node_access_records_alter(), so remove it to not interfere.
+    $this->index->removeProcessor('content_access');
+    $datasource = $this->index->getDatasource('entity:node');
+    $datasource->setConfiguration(['track_changes_only_affected_translations' => TRUE] + $datasource->getConfiguration());
+    $this->index->save();
+    $this->triggerPostRequestIndexing();
+
+    $entity = Node::load($entity->id());
+    // The field is not translatable, so changing it affects all translations.
+    $entity->set('field_shared', 'Updated shared value')->save();
+
+    $this->assertEquals(
+      ['entity:node/1:en', 'entity:node/1:l1', 'entity:node/1:l2'],
+      $this->index->getTrackerInstance()->getRemainingItems()
+    );
+  }
+
