@@ -0,0 +1,24 @@
+<?php
+
+/**
+ * @file
+ * Provides multi-step language fallbacks for tests.
+ */
+
+/**
+ * Implements hook_language_fallback_candidates_alter().
+ */
+function search_api_test_language_fallback_chain_language_fallback_candidates_alter(array &$candidates, array $context) {
+  // Each language gets its own chain, so that inserting or deleting a single
+  // translation can change the fallback of several languages, to different
+  // translations.
+  $chains = [
+    'fr' => ['de', 'es'],
+    'de' => ['it'],
+  ];
+  $attempted_langcode = $context['langcode'];
+  $candidates = [$attempted_langcode => $attempted_langcode];
+  foreach ($chains[$attempted_langcode] ?? [] as $fallback_langcode) {
+    $candidates[$fallback_langcode] = $fallback_langcode;
+  }
+}
diff --git a/tests/src/Kernel/Datasource/LanguageWithFallbackTrackingTest.php b/tests/src/Kernel/Datasource/LanguageWithFallbackTrackingTest.php
new file mode 100644
index 0000000000000000000000000000000000000000..08db82451da6d5047b3766f1e7fa4dcddbb59eed
--- /dev/null
+++ b/tests/src/Kernel/Datasource/LanguageWithFallbackTrackingTest.php
@@ -0,0 +1,197 @@
+<?php
+
+namespace Drupal\Tests\search_api\Kernel\Datasource;
+
+use Drupal\language\Entity\ConfigurableLanguage;
+use Drupal\node\Entity\Node;
+use Drupal\node\Entity\NodeType;
+use Drupal\search_api\Item\Field;
+use Drupal\search_api\Utility\Utility;
+use Drupal\Tests\search_api\Kernel\PostRequestIndexingTrait;
+use Drupal\Tests\search_api\Kernel\Processor\ProcessorTestBase;
+use PHPUnit\Framework\Attributes\RunTestsInSeparateProcesses;
+
+/**
+ * Tests tracking of language fallbacks when re-indexing is narrowed down.
+ *
+ * With the "Only re-index translations affected by the change" datasource
+ * setting enabled, a translation whose own fields didn't change is not
+ * re-indexed. That is incorrect for translations that start or stop serving as
+ * the language fallback for some other language.
+ *
+ * @group search_api
+ *
+ * @coversDefaultClass \Drupal\search_api\Plugin\search_api\datasource\ContentEntityTrackingManager
+ *
+ * @see \Drupal\search_api\Plugin\search_api\processor\LanguageWithFallback
+ */
+#[RunTestsInSeparateProcesses]
+class LanguageWithFallbackTrackingTest extends ProcessorTestBase {
+
+  use PostRequestIndexingTrait;
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'language',
+    'search_api_test_language_fallback_chain',
+    'language_fallback_fix',
+  ];
+
+  /**
+   * The test node.
+   *
+   * @var \Drupal\node\NodeInterface
+   */
+  protected $node;
+
+  /**
+   * The field values to create the test node and its translations with.
+   *
+   * @var array
+   */
+  protected array $nodeValues = [
+    'title' => 'Test',
+    'type' => 'article',
+  ];
+
+  /**
+   * {@inheritdoc}
+   */
+  public function setUp($processor = NULL): void {
+    parent::setUp('language_with_fallback');
+
+    // search_api_test_language_fallback_chain.module sets up the fallbacks
+    // "fr => de => es" and "de => it", and no fallbacks at all for any other
+    // language. "en" is left as the site default language, and "es" is used as
+    // the node's original language, so false fallbacks to either are visible.
+    foreach (['de', 'fr', 'es', 'it'] as $langcode) {
+      ConfigurableLanguage::createFromLangcode($langcode)->enable()->save();
+    }
+
+    NodeType::create([
+      'type' => 'article',
+    ])->save();
+
+    $lwf_field = new Field($this->index, 'language_with_fallback');
+    $lwf_field->setType('string');
+    $lwf_field->setPropertyPath('language_with_fallback');
+    $lwf_field->setLabel('Language (with fallback)');
+    $this->index->addField($lwf_field);
+
+    // Only re-index the translations affected by a change – the whole point of
+    // this test is which translations count as "affected".
+    $datasource = $this->index->getDatasource('entity:node');
+    $datasource->setConfiguration(
+      ['track_changes_only_affected_translations' => TRUE] + $datasource->getConfiguration()
+    );
+
+    $this->index->setOption('index_directly', TRUE);
+    $this->index->save();
+  }
+
+  /**
+   * Tests that inserting and deleting a translation tracks all fallbacks.
+   *
+   * @covers ::getAffectedTranslations
+   * @covers ::getChangedFallbackItemIds
+   */
+  public function testChangedFallbackSourcesAreTracked(): void {
+    $node = Node::create($this->nodeValues + ['langcode' => 'es']);
+    $node->addTranslation('it', $this->nodeValues);
+    $node->save();
+    $this->node = $node;
+    $this->triggerPostRequestIndexing();
+
+    // "fr" falls back to "de", which doesn't exist yet, and then to "es";
+    // "de" falls back to "it".
+    $expected = [
+      $this->getItemIdForLanguage('es') => ['es', 'fr'],
+      $this->getItemIdForLanguage('it') => ['de', 'it'],
+    ];
+    $this->assertEquals($expected, $this->getLanguageWithFallbackValues());
+    $this->assertEquals([], $this->getRemainingItems());
+
+    $node->addTranslation('de', $this->nodeValues);
+    $node->save();
+
+    $expected = [
+      // Newly inserted.
+      $this->getItemIdForLanguage('de'),
+      // Stopped being the fallback for "fr".
+      $this->getItemIdForLanguage('es'),
+      // Stopped being the fallback for "de".
+      $this->getItemIdForLanguage('it'),
+    ];
+    $this->assertEquals($expected, $this->getRemainingItems(), 'Inserting a translation tracks all changed fallback sources.');
+    $this->triggerPostRequestIndexing();
+
+    // "fr" now falls back to the new "de" translation instead.
+    $expected = [
+      $this->getItemIdForLanguage('es') => ['es'],
+      $this->getItemIdForLanguage('it') => ['it'],
+      $this->getItemIdForLanguage('de') => ['de', 'fr'],
+    ];
+    $this->assertEquals($expected, $this->getLanguageWithFallbackValues());
+
+    $node->removeTranslation('de');
+    $node->save();
+
+    $expected = [
+      // Became the fallback for "fr" again.
+      $this->getItemIdForLanguage('es'),
+      // Became the fallback for "de" again.
+      $this->getItemIdForLanguage('it'),
+    ];
+    $this->assertEquals($expected, $this->getRemainingItems(), 'Deleting a translation tracks all changed fallback sources.');
+  }
+
+  /**
+   * Retrieves the items currently queued for (re-)indexing.
+   *
+   * @return string[]
+   *   The item IDs, sorted.
+   */
+  protected function getRemainingItems(): array {
+    $item_ids = $this->index->getTrackerInstance()->getRemainingItems();
+    sort($item_ids);
+    return $item_ids;
+  }
+
+  /**
+   * Retrieves the indexed values.
+   *
+   * @return array
+   *   The "language_with_fallback" field values for all indexed items, keyed by
+   *   item ID.
+   */
+  protected function getLanguageWithFallbackValues(): array {
+    $query = $this->index->query();
+    // We don't need a query condition as we have only one node anyway.
+    $results = $query->execute();
+    $values = [];
+    /** @var \Drupal\search_api\Item\ItemInterface $result */
+    foreach ($results as $result) {
+      $field_values = $result->getField('language_with_fallback')->getValues();
+      sort($field_values);
+      $values[$result->getId()] = $field_values;
+    }
+    return $values;
+  }
+
+  /**
+   * Retrieves the test node's item ID for the given language.
+   *
+   * @param string $langcode
+   *   The language's code.
+   *
+   * @return string
+   *   The Search API item ID for the test node in the given language.
+   */
+  protected function getItemIdForLanguage(string $langcode): string {
+    $nid = $this->node->id();
+    return Utility::createCombinedId('entity:node', "$nid:$langcode");
+  }
+
+}
