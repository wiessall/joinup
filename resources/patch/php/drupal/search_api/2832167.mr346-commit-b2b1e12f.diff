+  protected function shouldLimitToAffectedTranslations(ContentEntityInterface $entity, IndexInterface $index, string $datasource_id): bool {
+    if (!$entity->getEntityType()->isTranslatable()) {
+      return FALSE;
+    }
+
+    try {
+      $datasource_config = $index->getDatasource($datasource_id)->getConfiguration();
+    }
+    catch (SearchApiException) {
+      return FALSE;
+    }
+    return !empty($datasource_config['track_changes_only_affected_translations']);
