+  /**
+   * Narrows a set of updated item IDs down to the ones actually changed.
+   *
+   * @param \Drupal\Core\Entity\ContentEntityInterface $entity
+   *   The updated entity, already containing the new field values.
+   * @param string[] $updated_ids
+   *   The item IDs to narrow down (the "updated" bucket).
+   * @param string[] $inserted_langcodes
+   *   The langcodes of the translations inserted in the same pass.
+   * @param string[] $deleted_langcodes
+   *   The langcodes of the translations deleted in the same pass.
+   *
+   * @return string[]
+   *   The item IDs that should actually be queued for re-indexing.
+   */
+  protected function getAffectedTranslations(ContentEntityInterface $entity, array $updated_ids, array $inserted_langcodes = [], array $deleted_langcodes = []): array {
+    $original = DeprecationHelper::backwardsCompatibleCall(
+      \Drupal::VERSION,
+      '11.2',
+      fn () => $entity->getOriginal(),
+      fn () => $entity->original ?? NULL,
+    );
+    if (!$original) {
+      // No "original" entity to compare against; re-index everything.
+      return $updated_ids;
+    }
+
+    $affected_ids = [];
+    $default_affected = FALSE;
+    $default_langcode = $entity->getUntranslated()->language()->getId();
+    foreach ($updated_ids as $id) {
+      $langcode = substr($id, strrpos($id, ':') + 1);
+      if ($entity->getTranslation($langcode)->hasTranslationChanges()) {
+        $affected_ids[] = $id;
+        $default_affected = $default_affected || $langcode === $default_langcode;
+      }
+    }
+    // With this bundle setting on, a shared-field change only marks the
+    // default translation as affected, which is ambiguous: widen to be
+    // safe.
+    if ($default_affected && $entity->isDefaultTranslationAffectedOnly()) {
+      return $updated_ids;
+    }
+    if ($inserted_langcodes || $deleted_langcodes) {
+      // A translation is also affected by starting or stopping to be the
+      // fallback for another language.
+      $fallback_ids = $this->getChangedFallbackItemIds($original, $entity);
+      $affected_ids = array_merge($affected_ids, array_intersect($fallback_ids, $updated_ids));
+    }
+    return array_values(array_unique($affected_ids));
+  }
+
+  /**
+   * Retrieves the item IDs whose language fallbacks changed during a save.
+   *
+   * @param \Drupal\Core\Entity\ContentEntityInterface $original
+   *   The entity in the state it was in before the save.
+   * @param \Drupal\Core\Entity\ContentEntityInterface $entity
+   *   The entity in the state it is in after the save.
+   *
+   * @return string[]
+   *   The item IDs of all translations that stopped or started being the
+   *   fallback for at least one language.
+   *
+   * @see \Drupal\search_api\Plugin\search_api\processor\LanguageWithFallback
+   */
+  protected function getChangedFallbackItemIds(ContentEntityInterface $original, ContentEntityInterface $entity): array {
+    $item_ids = [];
+    foreach (array_keys($this->languageManager->getLanguages()) as $langcode) {
+      // A language with its own translation always resolves to that one.
+      if ($original->hasTranslation($langcode) && $entity->hasTranslation($langcode)) {
+        continue;
+      }
+      $before = $this->resolveFallbackItemId($original, $langcode);
+      $after = $this->resolveFallbackItemId($entity, $langcode);
+      if ($before !== $after) {
+        $item_ids[] = $before;
+        $item_ids[] = $after;
+      }
+    }
+    return array_unique(array_filter($item_ids));
+  }
+
+  /**
+   * Determines the item ID of the translation a language falls back to.
+   *
+   * @param \Drupal\Core\Entity\ContentEntityInterface $entity
+   *   The entity, in the state in which the fallback should be resolved.
+   * @param string $langcode
+   *   The language to resolve the fallback for.
+   *
+   * @return string|null
+   *   The item ID of the translation the given language falls back to, or NULL
+   *   if it doesn't have a fallback.
+   *
+   * @see \Drupal\search_api\Plugin\search_api\processor\LanguageWithFallback::getReverseLanguageFallbacks()
+   */
+  protected function resolveFallbackItemId(ContentEntityInterface $entity, string $langcode): ?string {
+    $translation = $this->entityRepository->getTranslationFromContext($entity, $langcode, [
+      'fallback_to_passed_entity' => FALSE,
+      'operation' => 'entity_upcast',
+    ]);
+    return $translation
+      ? static::formatItemId($entity->getEntityTypeId(), $entity->id(), $translation->language()->getId())
+      : NULL;
+  }
