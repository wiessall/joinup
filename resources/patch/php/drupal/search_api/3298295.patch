From 62b6b03d09d49100885ee8d1d6032ad496e2e820 Mon Sep 17 00:00:00 2001
From: "claudiu.cristea" <claudiucristea@56348.no-reply.drupal.org>
Date: Tue, 19 Jul 2022 08:25:07 +0000
Subject: [PATCH] The search_api_list:{index} cache tag is not added to the
 view display

---
 src/Plugin/views/cache/SearchApiTagCache.php | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/src/Plugin/views/cache/SearchApiTagCache.php b/src/Plugin/views/cache/SearchApiTagCache.php
index 9527c82a1..f1de81cd0 100644
--- a/src/Plugin/views/cache/SearchApiTagCache.php
+++ b/src/Plugin/views/cache/SearchApiTagCache.php
@@ -3,6 +3,7 @@
 namespace Drupal\search_api\Plugin\views\cache;
 
 use Drupal\Core\Cache\Cache;
+use Drupal\Core\Cache\CacheableDependencyInterface;
 use Drupal\Core\Entity\EntityInterface;
 use Drupal\Core\Entity\EntityTypeManagerInterface;
 use Drupal\views\Plugin\views\cache\Tag;
@@ -27,7 +28,7 @@ use Symfony\Component\DependencyInjection\ContainerInterface;
  *   help = @Translation("Cache results until the associated cache tags are invalidated. Useful for small sites that use the database search backend. <strong>Caution:</strong> Can lead to stale results and might harm performance for complex search pages.")
  * )
  */
-class SearchApiTagCache extends Tag {
+class SearchApiTagCache extends Tag implements CacheableDependencyInterface {
 
   use SearchApiCachePluginTrait;
 
@@ -115,4 +116,11 @@ class SearchApiTagCache extends Tag {
     return $tags;
   }
 
+  /**
+   * {@inheritdoc}
+   */
+  public function getCacheContexts(): array {
+    return [];
+  }
+
 }
