+  /**
+   * Determines whether to narrow the "updated" translations down.
+   *
+   * @param \Drupal\Core\Entity\ContentEntityInterface $entity
+   *   The updated entity.
+   * @param \Drupal\search_api\IndexInterface $index
+   *   The index being checked.
+   * @param string $datasource_id
+   *   The ID of the entity's "entity:<type>" datasource on that index.
+   *
+   * @return bool
+   *   TRUE if getAffectedTranslations() should be used to narrow the
+   *   "updated" bucket down for this index.
+   */
+  protected function shouldLimitToAffectedTranslations(ContentEntityInterface $entity, IndexInterface $index, string $datasource_id): bool {
+    if (!$entity->getEntityType()->isTranslatable()) {
+      return FALSE;
+    }
+
+    try {
+      $datasource_config = $index->getDatasource($datasource_id)->getConfiguration();
+    }
+    catch (SearchApiException) {
+      return FALSE;
+    }
+    return !empty($datasource_config['track_changes_only_affected_translations']);
+  }
+
+  /**
+   * Narrows a set of updated item IDs down to the ones actually changed.
+   *
+   * @param \Drupal\Core\Entity\ContentEntityInterface $entity
+   *   The updated entity, already containing the new field values.
+   * @param string[] $updated_ids
+   *   The item IDs to narrow down (the "updated" bucket).
+   * @param string[] $inserted_langcodes
+   *   The langcodes of the translations inserted in the same pass.
+   * @param string[] $deleted_langcodes
+   *   The langcodes of the translations deleted in the same pass.
+   *
+   * @return string[]
+   *   The item IDs that should actually be queued for re-indexing.
+   */
+  protected function getAffectedTranslations(ContentEntityInterface $entity, array $updated_ids, array $inserted_langcodes = [], array $deleted_langcodes = []): array {
+    $original = DeprecationHelper::backwardsCompatibleCall(
+      \Drupal::VERSION,
+      '11.2',
+      fn () => $entity->getOriginal(),
+      fn () => $entity->original ?? NULL,
+    );
+    if (!$original) {
+      // No "original" entity to compare against; re-index everything.
+      return $updated_ids;
+    }
+
+    $affected_ids = [];
+    $default_affected = FALSE;
+    $default_langcode = $entity->getUntranslated()->language()->getId();
+    foreach ($updated_ids as $id) {
+      $langcode = substr($id, strrpos($id, ':') + 1);
+      if ($entity->getTranslation($langcode)->hasTranslationChanges()) {
+        $affected_ids[] = $id;
+        $default_affected = $default_affected || $langcode === $default_langcode;
+      }
+    }
+    // With this bundle setting on, a shared-field change only marks the
+    // default translation as affected, which is ambiguous: widen to be
+    // safe.
+    if ($default_affected && $entity->isDefaultTranslationAffectedOnly()) {
+      return $updated_ids;
+    }
+    $fallback_ids = array_merge(
+      $this->getFallbackItemIds($original, $inserted_langcodes),
+      $this->getFallbackItemIds($entity, $deleted_langcodes),
+    );
+    $affected_ids = array_unique(array_merge($affected_ids, array_intersect($fallback_ids, $updated_ids)));
+    // If a translation was just inserted or deleted, trust an empty result;
+    // otherwise fall back to the full set, since detection may have missed
+    // something.
+    if (!$affected_ids && !$inserted_langcodes && !$deleted_langcodes) {
+      return $updated_ids;
+    }
+    return array_values($affected_ids);
+  }
+
+  /**
+   * Retrieves the item IDs of the fallback translations for some languages.
+   *
+   * @param \Drupal\Core\Entity\ContentEntityInterface $entity
+   *   The entity, in the state in which the fallbacks should be resolved.
+   * @param string[] $langcodes
+   *   The langcodes to resolve the fallback translations for.
+   *
+   * @return string[]
+   *   The item IDs of the fallback translations.
+   *
+   * @see \Drupal\search_api\Plugin\search_api\processor\LanguageWithFallback
+   */
+  protected function getFallbackItemIds(ContentEntityInterface $entity, array $langcodes): array {
+    $item_ids = [];
+    foreach ($langcodes as $langcode) {
+      if ($entity->hasTranslation($langcode)) {
+        continue;
+      }
+      $candidates = $this->languageManager->getFallbackCandidates([
+        'data' => $entity,
+        'operation' => 'entity_upcast',
+        'langcode' => $langcode,
+      ]);
+      $candidates[$entity->getUntranslated()->language()->getId()] = LanguageInterface::LANGCODE_DEFAULT;
+      foreach ($candidates as $candidate) {
+        if ($entity->hasTranslation($candidate)) {
+          $fallback_langcode = $entity->getTranslation($candidate)->language()->getId();
+          $item_ids[] = static::formatItemId($entity->getEntityTypeId(), $entity->id(), $fallback_langcode);
+          break;
+        }
+      }
+    }
+    return $item_ids;
+  }
