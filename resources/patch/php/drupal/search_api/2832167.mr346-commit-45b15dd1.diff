+  /**
+   * Tests that only changed translations are re-indexed, if enabled.
+   *
+   * @covers ::trackEntityChange
+   * @covers ::getAffectedTranslations
+   */
+  public function testOnlyAffectedTranslationsAreReIndexed(): void {
+    $entity = Node::create([
+      'nid' => 1,
+      'type' => 'node',
+      'langcode' => 'en',
+      'title' => 'English title',
+    ]);
+    $entity->addTranslation('l1')->setTitle('Language 1 title');
+    $entity->save();
+    // All translations should be indexed.
+    $this->assertEquals(
+      ['entity:node/1:en', 'entity:node/1:l1'],
+      $this->index->getTrackerInstance()->getRemainingItems()
+    );
+
+    // Enable the setting, then index everything it marked for re-indexing.
+    $datasource = $this->index->getDatasource('entity:node');
+    $datasource->setConfiguration(['track_changes_only_affected_translations' => TRUE] + $datasource->getConfiguration());
+    $this->index->save();
+    $this->triggerPostRequestIndexing();
+
+    $entity = Node::load($entity->id());
+    // Only the "l1" translation changed, so only its item should be tracked.
+    $entity->getTranslation('l1')->setTitle('Updated language 1 title')->save();
+
+    $this->assertEquals(
+      ['entity:node/1:l1'],
+      $this->index->getTrackerInstance()->getRemainingItems()
+    );
+  }
+
+  /**
+   * Tests that inserting a translation re-indexes its fallback source.
+   *
+   * "l1" used to fall back to "en", which is part of the data indexed for
+   * "en", but it never fell back to "l0".
+   *
+   * @covers ::trackEntityChange
+   * @covers ::getAffectedTranslations
+   * @covers ::getFallbackItemIds
+   */
+  public function testInsertedTranslationAffectsItsFallbackSource(): void {
+    $entity = Node::create([
+      'nid' => 1,
+      'type' => 'node',
+      'langcode' => 'en',
+      'title' => 'English title',
+    ]);
+    $entity->addTranslation('l0')->setTitle('Language 0 title');
+    $entity->save();
+
+    // Enable the setting, then index everything it marked for re-indexing.
+    $datasource = $this->index->getDatasource('entity:node');
+    $datasource->setConfiguration(['track_changes_only_affected_translations' => TRUE] + $datasource->getConfiguration());
+    $this->index->save();
+    $this->triggerPostRequestIndexing();
+
+    $entity = Node::load($entity->id());
+    $entity->addTranslation('l1')->setTitle('Language 1 title')->save();
+
+    $this->assertEqualsCanonicalizing(
+      ['entity:node/1:en', 'entity:node/1:l1'],
+      $this->index->getTrackerInstance()->getRemainingItems()
+    );
+  }
+
+  /**
+   * Tests that deleting a translation re-indexes its new fallback source.
