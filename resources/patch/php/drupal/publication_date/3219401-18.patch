+<?php
+
+/**
+ * @file
+ * Hooks provided by the Publication date module.
+ */
+
+/**
+ * Allow to change the list of entity types having the Publication date field.
+ *
+ * @param array $entity_types
+ *   The list of entity types having the Publication date field.
+ *
+ * @ingroup publication_date_api
+ */
+function hook_publication_date_entity_types_alter(array &$entity_types): void {
+  $entity_types[] = 'taxonomy_term';
+}
