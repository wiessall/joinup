--- /dev/null
+++ b/src/PublicationDateEnabledTypes.php
@@ -0,0 +1,60 @@
+<?php
+
+namespace Drupal\publication_date;
+
+use Drupal\Core\Extension\ModuleHandlerInterface;
+
+/**
+ * The class for the service to list entity types with publication date.
+ */
+class PublicationDateEnabledTypes {
+
+  /**
+   * The list of enabled entity types.
+   */
+  protected array $entityTypes = ['node'];
+
+  /**
+   * The module handler.
+   *
+   * @var \Drupal\Core\Extension\ModuleHandlerInterface
+   */
+  protected ModuleHandlerInterface $moduleHandler;
+
+  /**
+   * Constructs a SearchLinks object.
+   *
+   * @param \Drupal\Core\Extension\ModuleHandlerInterface $module_handler
+   *   The module handler.
+   */
+  public function __construct(ModuleHandlerInterface $module_handler) {
+    $this->moduleHandler = $module_handler;
+  }
+
+  /**
+   * Read the enabled types from the configuration.
+   *
+   * @return array
+   *   The enabled entity types.
+   */
+  public function getEnabled(): array {
+    // Invoke hook_publication_date_entity_types_alter() to allow to change the list of
+    // entity types having the Publication date field.
+    $this->moduleHandler->alter('publication_date_entity_types', $this->entityTypes);
+    return $this->entityTypes;
+  }
+
+  /**
+   * Determine if the supplied type is enabled.
+   *
+   * @param string $type
+   *   The entity type ID.
+   *
+   * @return bool
+   *   Whether the entity type is enabled.
+   */
+  public function isEnabled(string $type): bool {
+    return in_array($type, $this->getEnabled());
+  }
+
+}
