@@ -0,0 +1,66 @@
+import DrupalFileRepository from './drupalfilerepository';
+import { Command } from 'ckeditor5/src/core';
+import { findOptimalInsertionRange } from 'ckeditor5/src/widget';
+
+class FileUploadCommand extends Command {
+  /**
+   * @inheritDoc
+   */
+  refresh() {
+    this.isEnabled = true;
+  }
+
+  /**
+   * Executes the command.
+   *
+   * @fires execute
+   * @param {Object} options Options for the executed command.
+   * @param {File|Array.<File>} options.file The file or an array of files to upload.
+   */
+  execute( options ) {
+    const editor = this.editor;
+    const model = editor.model;
+
+    const fileRepository = editor.plugins.get(DrupalFileRepository);
+
+    model.change( writer => {
+      const filesToUpload = options.file;
+      for ( const file of filesToUpload ) {
+        this.uploadFile(writer, model, fileRepository, file);
+      }
+    });
+  }
+
+  /**
+   * 	Handles uploading single file.
+   *
+   *	@param {module:engine/model/writer~writer} writer
+   *	@param {module:engine/model/model~Model} model
+   *	@param {File} file
+   */
+  uploadFile( writer, model, fileRepository, file ) {
+    const loader = fileRepository.createLoader(file);
+
+    // Do not throw when upload adapter is not set. FileRepository will log an error anyway.
+    if ( !loader ) {
+      return;
+    }
+
+    this.insertFileLink( writer, model, {linkHref: "", uploadId: loader.id }, file );
+  }
+
+  insertFileLink(writer, model, attributes = {}, file ) {
+    const selection = model.document.selection;
+    const insertAtSelection = findOptimalInsertionRange( selection, model );
+
+    const linkedText = writer.createText(file.name, attributes);
+    model.insertContent(linkedText, insertAtSelection);
+
+    if ( linkedText.parent ) {
+      writer.setSelection( linkedText, 'on' );
+    }
+  }
+
+}
+
+export default FileUploadCommand;
