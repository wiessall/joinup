+import { Plugin } from 'ckeditor5/src/core';
+import DrupalFileUploadEditing from './drupalfileuploadediting';
+import DrupalFileRepository from './drupalfilerepository';
+
+/**
+ * Integrates the CKEditor file upload with Drupal.
+ *
+ * @see DrupalImageUpload.
+ * @private
+ */
+class DrupalFileUpload extends Plugin {
+  /**
+   * @inheritdoc
+   */
+  static get requires() {
+    return [DrupalFileRepository, DrupalFileUploadEditing];
+  }
+
+  /**
+   * @inheritdoc
+   */
+  static get pluginName() {
+    return 'DrupalFileUpload';
+  }
+}
+
+export default DrupalFileUpload;
