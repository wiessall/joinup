+import { Plugin } from 'ckeditor5/src/core';
+import { ClickObserver } from 'ckeditor5/src/engine';
+import { ContextualBalloon, clickOutsideHandler } from 'ckeditor5/src/ui';
+import Drupaluploadactionview from './drupaluploadactionview';
+
+const VISUAL_SELECTION_MARKER_NAME = 'drupal-file-ui';
+
+export default class DrupalEditorFileUploadActionUi extends Plugin {
+  /**
+   * @inheritDoc
+   */
+  static get pluginName() {
+    return 'DrupalEditorFileUploadActionUi';
+  }
+
+  init() {
+    const editor = this.editor;
+    this.linkUI = editor.plugins.get('LinkUI');
+
+    editor.editing.view.addObserver( ClickObserver );
+
+    /**
+     * The actions view displayed inside of the balloon.
+     *
+     * @member {module:link/ui/linkuploadActionView~LinkuploadActionView}
+     */
+    this.uploadActionView = null;
+
+    /**
+     * The contextual balloon plugin instance.
+     *
+     * @private
+     * @member {module:ui/panel/balloon/contextualballoon~ContextualBalloon}
+     */
+    this._balloon = editor.plugins.get( ContextualBalloon );
+
+    // Render the form so its #element is available for clickOutsideHandler.
+    this._createViews();
+
+    this._enableBalloonActivators();
+  }
+
+  _createViews() {
+    this.uploadActionView = this._createUploadActionView();
+  }
+
+  _createUploadActionView() {
+    const editor = this.editor;
+    const uploadActionView = new Drupaluploadactionview( editor.locale, editor );
+    const linkCommand = editor.commands.get( 'link' );
+
+    uploadActionView.bind( 'href' ).to( linkCommand, 'value' );
+    uploadActionView.editButtonView.bind( 'isEnabled' ).to( linkCommand );
+
+    // Execute unlink command after clicking on the "Edit" button.
+    this.listenTo( uploadActionView, 'edit', () => {
+      this._addFormView();
+    } );
+
+    // Close the panel on esc key press when the **actions have focus**.
+    uploadActionView.keystrokes.set( 'Esc', ( data, cancel ) => {
+      this._hideUI();
+      cancel();
+    } );
+
+    return uploadActionView;
+  }
+
+  _hideUI() {
+    if ( !this._areActionsInPanel ) {
+      return;
+    }
+
+    const editor = this.editor;
+
+    this.stopListening( editor.ui, 'update' );
+    this.stopListening( this._balloon, 'change:visibleView' );
+
+    // Make sure the focus always gets back to the editable _before_ removing the focused form view.
+    // Doing otherwise causes issues in some browsers. See https://github.com/ckeditor/ckeditor5-link/issues/193.
+    editor.editing.view.focus();
+
+    // Then remove the actions view because it's beneath the form.
+    this._balloon.remove( this.uploadActionView );
+  }
+
+  /**
+   * Adds the {@link #uploadActionView} to the {@link #_balloon}.
+   *
+   * @protected
+   */
+  addUploadActionView() {
+    if ( this._areActionsInPanel ) {
+      return;
+    }
+
+    this._balloon.add( {
+      view: this.uploadActionView,
+      position: this._getBalloonPositionData()
+    } );
+  }
+
+  /**
+   * Returns `true` when {@link #uploadActionView} is in the {@link #_balloon}.
+   *
+   * @readonly
+   * @protected
+   * @type {Boolean}
+   */
+  get _areActionsInPanel() {
+    return this._balloon.hasView( this.uploadActionView );
+  }
+
+  /**
+   * Shows the correct UI type. It is either {@link #formView} or {@link #uploadActionView}.
+   *
+   * @param {Boolean} forceVisible
+   * @private
+   */
+  _showUI( forceVisible = false ) {
+    this.addUploadActionView();
+
+    // Be sure panel with link is visible.
+    if ( forceVisible ) {
+      this._balloon.showStack( 'main' );
+    }
+  }
+
+  /**
+   * Attaches actions that control whether the balloon panel containing the
+   * {@link #formView} should be displayed.
+   *
+   * @private
+   */
+  _enableBalloonActivators() {
+    const editor = this.editor;
+    const viewDocument = editor.editing.view.document;
+
+    // Handle click on view document and show panel when selection is placed inside the link element.
+    // Keep panel open until selection will be inside the same link element.
+    this.listenTo( viewDocument, 'click', (evt, data) => {
+      const parentLink = this.linkUI._getSelectedLinkElement();
+
+      if ( parentLink && parentLink.hasAttribute('data-entity-source') ) {
+        // Then show panel but keep focus inside editor editable.
+        this._showUI();
+
+        // Prevent browser navigation when clicking a file link.
+        data.preventDefault();
+
+        // Block the `LinkUI` plugin when a file was clicked.
+        evt.stop();
+      }
+    }, { priority: 'high' });
+
+    // Close on click outside of balloon panel element.
+    clickOutsideHandler({
+      emitter: this.uploadActionView,
+      activator: () => this._areActionsInPanel,
+      contextElements: [this._balloon.view.element],
+      callback: () => this._hideUI(),
+    });
+  }
+
+  /**
+   * Returns positioning options for the {@link #_balloon}. They control the way the balloon is attached
+   * to the target element or selection.
+   *
+   * If the selection is collapsed and inside a link element, the panel will be attached to the
+   * entire link element. Otherwise, it will be attached to the selection.
+   *
+   * @private
+   * @returns {module:utils/dom/position~Options}
+   */
+  _getBalloonPositionData() {
+    const view = this.editor.editing.view;
+    const model = this.editor.model;
+    const viewDocument = view.document;
+    let target = null;
+
+    if ( model.markers.has( VISUAL_SELECTION_MARKER_NAME ) ) {
+      // There are cases when we highlight selection using a marker (#7705, #4721).
+      const markerViewElements = Array.from( this.editor.editing.mapper.markerNameToElements( VISUAL_SELECTION_MARKER_NAME ) );
+      const newRange = view.createRange(
+        view.createPositionBefore( markerViewElements[ 0 ] ),
+        view.createPositionAfter( markerViewElements[ markerViewElements.length - 1 ] )
+      );
+
+      target = view.domConverter.viewRangeToDom( newRange );
+    } else {
+      // Make sure the target is calculated on demand at the last moment because a cached DOM range
+      // (which is very fragile) can desynchronize with the state of the editing view if there was
+      // any rendering done in the meantime. This can happen, for instance, when an inline widget
+      // gets unlinked.
+      target = () => {
+        const targetLink = this.linkUI._getSelectedLinkElement();
+
+        return targetLink ?
+          // When selection is inside link element, then attach panel to this element.
+          view.domConverter.mapViewToDom( targetLink ) :
+          // Otherwise attach panel to the selection.
+          view.domConverter.viewRangeToDom( viewDocument.selection.getFirstRange() );
+      };
+    }
+
+    return { target };
+  }
+
+}
