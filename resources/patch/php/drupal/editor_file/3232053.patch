+// @todo adapt this copy-pasted code for files.
+
+import { Plugin } from 'ckeditor5/src/core';
+
+/**
+ * Adds Drupal-specific attributes to the CKEditor 5 file element.
+ *
+ * @private
+ */
+export default class DrupalFileUploadEditing extends Plugin {
+  /**
+   * @inheritdoc
+   */
+  init() {
+    const { editor } = this;
+    // @todo Implement FileUploadEditing by copying CKE5 ImageUploadEditing.
+    const fileUploadEditing = editor.plugins.get('FileUploadEditing');
+    fileUploadEditing.on('uploadComplete', (evt, { data, fileElement }) => {
+      editor.model.change((writer) => {
+        writer.setAttribute('dataEntityUuid', data.response.uuid, fileElement);
+        writer.setAttribute(
+          'dataEntityType',
+          data.response.entity_type,
+          fileElement,
+        );
+      });
+    });
+  }
+
+  /**
+   * @inheritdoc
+   */
+  static get pluginName() {
+    return 'DrupalFileUploadEditing';
+  }
+}
