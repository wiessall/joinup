+import { Plugin } from 'ckeditor5/src/core';
+import { logWarning } from 'ckeditor5/src/utils';
+import DrupalFileUploadAdapter from './drupalfileuploadadapter';
+import DrupalFileRepository from './drupalfilerepository';
+
+class DrupalFileAdapterPlugin extends Plugin {
+  /**
+   * @inheritdoc
+   */
+  static get requires() {
+    return [DrupalFileRepository];
+  }
+
+  /**
+   * @inheritdoc
+   */
+  static get pluginName() {
+    return 'EditorFileDrupalFileRepository';
+  }
+
+  /**
+   * @inheritdoc
+   */
+  init() {
+    const options = this.editor.config.get('drupalFileUpload');
+    console.log(options)
+    if (!options) {
+      return;
+    }
+
+    if (!options.uploadUrl) {
+      logWarning('simple-upload-adapter-missing-uploadurl');
+
+      return;
+    }
+
+    this.editor.plugins.get(DrupalFileRepository).createUploadAdapter = (loader) => {
+      return new DrupalFileUploadAdapter(loader, options);
+    };
+  }
+}
+
+export default DrupalFileAdapterPlugin;
