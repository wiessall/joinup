diff --git a/editor_file.ckeditor5.yml b/editor_file.ckeditor5.yml
new file mode 100644
index 0000000..fe150c5
--- /dev/null
+++ b/editor_file.ckeditor5.yml
@@ -0,0 +1,40 @@
+editor_file_file:
+  ckeditor5:
+    plugins:
+      - drupalFile.DrupalFile
+      - drupalFile.DrupalInsertFile
+  drupal:
+    label: File
+    class: \Drupal\editor_file\Plugin\CKEditor5Plugin\File
+    library: editor_file/demobox
+    # @todo Used? If so, rename it.
+    admin_library: editor_file/admin.demobox
+    elements:
+      # @todo
+      # Note that it necessary for elements to separately provide both the tag
+      # (f.e. `<h2>`) and the attribute being added to the tag
+      # (f.e. `<h2 class="simple-box-title">`).
+      - <h2>
+      - <h2 class="simple-box-title">
+      - <div>
+      - <div class="simple-box-description">
+      - <section>
+      - <section class="simple-box">
+    toolbar_items:
+      drupalInsertFile:
+        label: File
+    conditions:
+      toolbarItem: drupalInsertFile
+
+editor_file_fileUpload:
+  ckeditor5:
+    plugins:
+      - image.ImageUpload
+      - drupalFile.DrupalFileUpload
+  drupal:
+    label: File Upload
+    elements:
+      # @todo
+      - <img data-entity-uuid data-entity-type>
+    conditions:
+      plugins: [editor_file_file]
