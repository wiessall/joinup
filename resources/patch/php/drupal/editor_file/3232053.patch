+/**
+ * Provides the CKEditor 4 to 5 upgrade for drupalInsertFile CKEditor plugins.
+ *
+ * @CKEditor4To5Upgrade(
+ *   id = "editor_file_upgrade",
+ *   cke4_buttons = {
+ *     "DrupalFile"
+ *   },
+ *   cke4_plugin_settings = {},
+ *   cke5_plugin_elements_subset_configuration = {}
