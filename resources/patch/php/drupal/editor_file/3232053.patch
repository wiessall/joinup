-    $max_filesize = min(Bytes::toNumber($file_upload['max_size']), Environment::getUploadMaxSize());
-
-    $validators = [
-      'file_validate_extensions' => !empty($file_upload['extensions']) ? [$file_upload['extensions']] : ['txt'],
