@@ -0,0 +1,54 @@
+import { Plugin, icons } from 'ckeditor5/src/core';
+import { ButtonView } from 'ckeditor5/src/ui';
+
+export default class DrupalEditorFileUploadActionUi extends Plugin {
+  /**
+   * @inheritDoc
+   */
+  static get pluginName() {
+    return 'DrupalEditorFileUploadActionUi';
+  }
+
+  init() {
+    const editor = this.editor;
+    const linkUI = editor.plugins.get('LinkUI');
+
+    this.actionsView = linkUI.actionsView;
+
+    this.button = this._createButton();
+
+    this.actionsView.once( 'render', () => {
+      // Render button's tamplate.
+      this.button.render();
+
+      // Register the button under the link form view, it will handle its destruction.
+      this.actionsView.registerChild( this.button );
+      // Inject the element into DOM.
+      this.actionsView.editButtonView.element.replaceWith(this.button.element)
+    });
+  }
+
+  _createButton() {
+    const editor = this.editor;
+    const button = new ButtonView( this.locale );
+
+    button.set( {
+      label: Drupal.t('Edit File'),
+      icon: icons.pencil,
+      tooltip: true,
+    });
+
+    button.on( 'execute', () => {
+      Drupal.ckeditor5.openDialog(
+        Drupal.url('editor_file/dialog/file/basic_html'),
+        ({attributes}) => {
+          editor.execute('insertFileToEditor', attributes);
+        },
+        {},
+      )
+    });
+
+    return button;
+  }
+
+}
