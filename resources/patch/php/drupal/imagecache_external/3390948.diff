+/**
+ * Sanitizes the content passed by reference.
+ *
+ * @param string $content
+ *   The potential SVG content passed by reference.
+ * @param string $content_type
+ *   The content mime type.
+ *
+ * @return bool
+ *   TRUE if not an SVG file or the sanitization succeeded. FALSE if it's an SVG
+ *   file but sanitization failed or there's no sanitization support.
+ */
+function imagecache_sanitize_svg(string &$content, string $content_type): bool {
+  if ($content_type !== 'image/svg+xml') {
+    // Not SVG. Doesn't need sanitization.
+    return TRUE;
+  }
+
+  if (!class_exists(Sanitizer::class)) {
+    // No sanitizer support.
+    return FALSE;
+  }
+
+  $sanitizer = new Sanitizer();
+  $content = $sanitizer->sanitize($content);
+  // If sanitizer returns FALSE this is not a valid SVG format.
+  return $content !== FALSE;
+}
