diff --git a/tests/src/Functional/ImagecacheExternalTest.php b/tests/src/Functional/ImagecacheExternalTest.php
index 6249813..68353fb 100644
--- a/tests/src/Functional/ImagecacheExternalTest.php
+++ b/tests/src/Functional/ImagecacheExternalTest.php
@@ -248,6 +248,88 @@ class ImagecacheExternalTest extends BrowserTestBase {
     self::assertFileExists($filename);
   }
 
+  /**
+   * Tests fallback image configuration combinations.
+   *
+   * @param string $managed_file_fallback_url
+   *   The URI of the managed file fallback image, if any. Leave empty to not
+   *   set this config.
+   * @param string $unmanaged_image_fallback_url
+   *   The URL of the non-managed file fallback image, if any. Leave empty to
+   *   not set this config.
+   * @param string|false $expected
+   *   The expected fallback image URL.
+   *
+   * @dataProvider providerTestFallbackImage
+   */
+  public function testFallbackImage(
+    string $managed_file_fallback_url,
+    string $unmanaged_image_fallback_url,
+    string|false $expected
+  ): void {
+    $config = \Drupal::configFactory()->getEditable('imagecache_external.settings');
+    // Create a managed file and set it as a fallback if needed.
+    if ($managed_file_fallback_url) {
+      file_put_contents(
+        $managed_file_fallback_url,
+        file_get_contents(DRUPAL_ROOT . '/core/tests/fixtures/files/image-1.png')
+      );
+      $managed_file = \Drupal::entityTypeManager()->getStorage('file')
+        ->create([
+          'uid' => 1,
+          'filename' => basename($managed_file_fallback_url),
+          'uri' => $managed_file_fallback_url,
+          'filemime' => 'image/png',
+          'filesize' => filesize($managed_file_fallback_url),
+          'status' => 1,
+        ]);
+      $managed_file->save();
+
+      $config->set('imagecache_fallback_image', $managed_file->id());
+    }
+    // Set the unmanaged file URL fallback, if any.
+    if ($unmanaged_image_fallback_url) {
+      $config->set('imagecache_fallback_image_url', $unmanaged_image_fallback_url);
+    }
+    $config->save();
+
+    $this->assertEquals(
+      $expected,
+      imagecache_external_generate_path(\Drupal::request()->getSchemeAndHttpHost() . '/very/fuzzy.png')
+    );
+  }
+
+  /**
+   * Data provider for ::testFallbackImage.
+   *
+   * @return array[]
+   *   The test cases.
+   */
+  public function providerTestFallbackImage(): array {
+    return [
+      'No fallback set' => [
+        "Managed file fallback's URI" => '',
+        'URI of unmanaged file fallback' => '',
+        'Expected generate url result' => FALSE,
+      ],
+      'Both fallback type set, managed file setting must win' => [
+        "Managed file fallback's URI" => 'public://foo.bar',
+        'URI of unmanaged file fallback' => DRUPAL_ROOT . '/core/tests/fixtures/files/image-1.png',
+        'Expected generate url result' => 'public://foo.bar',
+      ],
+      'Only unmanaged fallback is set' => [
+        "Managed file fallback's URI" => '',
+        'URI of unmanaged file fallback' => 'core/tests/fixtures/files/image-1.png',
+        'Expected generate url result' => 'core/tests/fixtures/files/image-1.png',
+      ],
+      'Only managed file fallback is set' => [
+        "Managed file fallback's URI" => 'public://foo.bar',
+        'URI of unmanaged file fallback' => '',
+        'Expected generate url result' => 'public://foo.bar',
+      ],
+    ];
+  }
+
   /**
