diff --git a/src/ImagecacheExternal.php b/src/ImagecacheExternal.php
new file mode 100644
index 0000000..49b6060
--- /dev/null
+++ b/src/ImagecacheExternal.php
@@ -0,0 +1,84 @@
+<?php
+
+declare(strict_types = 1);
+
+namespace Drupal\imagecache_external;
+
+use Drupal\Core\State\StateInterface;
+
+/**
+ * Constants and basic routines of Imagecache External.
+ */
+final class ImagecacheExternal {
+
+  /**
+   * State API key to store unavailable URLs.
+   *
+   * @const string
+   */
+  const MISSING_RESOURCES_KEY = 'imagecache_external.missing';
+
+  /**
+   * The state service.
+   */
+  protected static StateInterface $state;
+
+  /**
+   * Registers a URL as unavailable.
+   *
+   * @param string $url
+   *   The URL which failed to download.
+   */
+  public static function registerUnavailableUrl(string $url): void {
+    self::state()->set(
+      self::MISSING_RESOURCES_KEY,
+      self::getUnavailableUrls() + [$url => TRUE]
+    );
+  }
+
+  /**
+   * Determines whether a URL was registered as being unavailable.
+   *
+   * @param string $url
+   *   The URL to check.
+   */
+  public static function isUnavailableUrl(string $url): bool {
+    return isset(self::getUnavailableUrls()[$url]);
+  }
+
+  /**
+   * Resets the unavailable URL storage.
+   */
+  public static function resetUnavailableUrls(): void {
+    self::state()->delete(self::MISSING_RESOURCES_KEY);
+  }
+
+  /**
+   * Returns the URLs which were registered as being unavailable.
+   *
+   * Keys are the URLs, values are always boolean "TRUE". This is a
+   * micro-optimization for static::isUnavailableUrl, because using isset() is
+   * faster than array_search().
+   *
+   * @return true[]
+   *   Array of "TRUE"s keyed by the registered URLs.
+   */
+  protected static function getUnavailableUrls(): array {
+    return self::state()->get(self::MISSING_RESOURCES_KEY, []);
+  }
+
+  /**
+   * Returns the state service.
+   *
+   * @returns \Drupal\Core\State\StateInterface
+   *   The state service.
+   */
+  protected static function state(): StateInterface {
+    if (!isset(self::$state)) {
+      return self::$state = \Drupal::state();
+    }
+
+    return self::$state;
+  }
+
+}
