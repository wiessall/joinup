diff --git a/tests/src/Kernel/TrackNonDownloadableUrlsTest.php b/tests/src/Kernel/TrackNonDownloadableUrlsTest.php
new file mode 100644
index 0000000..397b74c
--- /dev/null
+++ b/tests/src/Kernel/TrackNonDownloadableUrlsTest.php
@@ -0,0 +1,129 @@
+<?php
+
+declare(strict_types = 1);
+
+namespace Drupal\Tests\imagecache_external\Kernel;
+
+use Drupal\Component\Utility\Random;
+use Drupal\imagecache_external\ImagecacheExternal;
+use Drupal\KernelTests\KernelTestBase;
+use GuzzleHttp\ClientInterface;
+use GuzzleHttp\Psr7\Response;
+
+/**
+ * Tests image download attempts.
+ *
+ * @group imagecache_external
+ */
+class TrackNonDownloadableUrlsTest extends KernelTestBase {
+
+  /**
+   * An image URL to be used during tests.
+   *
+   * @const string
+   */
+  const TEST_IMAGE_URL = 'https://example.com/image.png';
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'imagecache_external',
+  ];
+
+  /**
+   * {@inheritdoc}
+   */
+  public function setUp(): void {
+    parent::setUp();
+
+    $this->config('imagecache_external.settings')
+      ->set('imagecache_directory', 'externals')
+      ->set('imagecache_subdirectories', FALSE)
+      ->set('imagecache_external_management', 'unmanaged')
+      ->set('imagecache_external_allowed_mimetypes', ['image/png'])
+      ->save();
+  }
+
+  /**
+   * Tests that non-downloadable URLs are fetched only once.
+   */
+  public function testNonDownloadableUrls(): void {
+    $this->setupHttpResponseMock(static::TEST_IMAGE_URL, 403, 1);
+
+    // The url must be registered as being non-downloadable.
+    $this->assertFalse(imagecache_external_generate_path(static::TEST_IMAGE_URL));
+    $this->assertTrue(ImagecacheExternal::isUnavailableUrl(static::TEST_IMAGE_URL));
+
+    // Second download attempt must be prevented.
+    $this->assertFalse(imagecache_external_generate_path(static::TEST_IMAGE_URL));
+
+    // Resetting the unavailable URLs storage must allow another attempt.
+    $this->setupHttpResponseMock(static::TEST_IMAGE_URL, 403, 1);
+    ImagecacheExternal::resetUnavailableUrls();
+    $this->assertFalse(imagecache_external_generate_path(static::TEST_IMAGE_URL));
+    // But the next download attempt must still be prevented.
+    $this->assertFalse(imagecache_external_generate_path(static::TEST_IMAGE_URL));
+  }
+
+  /**
+   * Downloadable URLs work as expected, so they are fetched only once.
+   */
+  public function testValidUrl(): void {
+    $this->setupHttpResponseMock(static::TEST_IMAGE_URL, 200, 1);
+
+    $this->assertEquals(
+      'public://externals/d67540393d81c9e621cb2deed9d80816.png',
+      imagecache_external_generate_path(static::TEST_IMAGE_URL)
+    );
+
+    // Calling generate path one more time shouldn't trigger another request.
+    imagecache_external_generate_path(static::TEST_IMAGE_URL);
+  }
+
+  /**
+   * Overrides container's HTTP client to mock the response of the test file.
+   *
+   * @param string $url
+   *   The URL which GET response should be mocked. If 200 response should be
+   *   returned then this must be an image URL with extension supported by the
+   *   GD toolkit.
+   * @param int $mock_response_status_code
+   *   The response code to return. Choosing 200 response status code will
+   *   return a real (random) image stream.
+   * @param int|null $expected_call_number
+   *   Expected number of the client's request method call.
+   */
+  protected function setupHttpResponseMock(
+    string $url,
+    int $mock_response_status_code,
+    int|null $expected_call_number = NULL
+  ): void {
+    $content_type_header = 'text/html; charset=utf-8';
+    $response_body = NULL;
+
+    if ($mock_response_status_code === 200) {
+      $filename = basename(parse_url($url, PHP_URL_PATH));
+      $extension = explode('.', $filename)[1];
+      $response_body = $mock_response_status_code === 200
+        ? file_get_contents((new Random())->image("temporary://test-$filename", '1x1', '1x1'))
+        : NULL;
+      $content_type_header = "image/$extension";
+    }
+
+    $invocation_rule = is_int($expected_call_number)
+      ? $this->exactly($expected_call_number)
+      : $this->any();
+    $http_client = $this->createMock(ClientInterface::class);
+    $http_client->expects($invocation_rule)->method('request')
+      ->with('get', $url)
+      ->willReturn(new Response(
+        $mock_response_status_code,
+        ['Content-Type' => $content_type_header],
+        $response_body
+      ));
+
+    $this->container->set('http_client', $http_client);
+  }
+
+}
