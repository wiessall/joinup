diff --git a/tests/src/Functional/SettingsFormTest.php b/tests/src/Functional/SettingsFormTest.php
new file mode 100644
index 0000000..01fbfb5
--- /dev/null
+++ b/tests/src/Functional/SettingsFormTest.php
@@ -0,0 +1,95 @@
+<?php
+
+declare(strict_types = 1);
+
+namespace Drupal\Tests\imagecache_external\Functional;
+
+use Drupal\Core\Url;
+use Drupal\Tests\BrowserTestBase;
+
+/**
+ * Tests Imagecache External's settings form.
+ *
+ * @group imagecache_external
+ */
+class SettingsFormTest extends BrowserTestBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'imagecache_external',
+  ];
+
+  /**
+   * {@inheritdoc}
+   */
+  protected $defaultTheme = 'stark';
+
+  /**
+   * Tests access to Imagecache External's settings form.
+   */
+  public function testConfigFormAccess(): void {
+    $config_form_url = Url::fromRoute('imagecache_external.admin_settings');
+    // Anonymous cannot access.
+    $this->drupalGet($config_form_url);
+    $this->assertSession()->statusCodeEquals(403);
+
+    // ...Nor logged-in user account.
+    $this->drupalLogin($this->createUser());
+    $this->drupalGet($config_form_url);
+    $this->assertSession()->statusCodeEquals(403);
+
+    // But admin must have access.
+    $this->drupalLogin($this->createUser(['administer imagecache external']));
+    $this->drupalGet($config_form_url);
+    $this->assertSession()->statusCodeEquals(200);
+    $this->submitForm([], 'Save configuration');
+    $this->assertSession()->statusCodeEquals(200);
+  }
+
+  /**
+   * Tests Imagecache External's settings form.
+   */
+  public function testHttpClientConfig(): void {
+    $this->drupalLogin($this->createUser(['administer imagecache external']));
+    $this->drupalGet(Url::fromRoute('imagecache_external.admin_settings'));
+    $this->assertSession()->statusCodeEquals(200);
+
+    $config_factory = \Drupal::configFactory();
+    $original_config_array = $config_factory->getEditable('imagecache_external.settings')->getRawData();
+    $this->assertArrayNotHasKey('http_client_config', $original_config_array);
+
+    // If we don't set timeout override for the HTTP client, the corresponding
+    // configuration key shouldn't be created. This ensures backward
+    // compatibility.
+    $this->submitForm([], 'Save configuration');
+    $this->assertSession()->statusCodeEquals(200);
+    $this->assertEquals(
+      $original_config_array,
+      $config_factory->getEditable('imagecache_external.settings')->getRawData()
+    );
+
+    // Let's set a minimal timeout, e.g. 4 second.
+    $this->submitForm([
+      'http_client_config[timeout]' => '4',
+    ], 'Save configuration');
+
+    // Config must store this as integer, under keys http_client_config.timeout.
+    $this->assertSame(
+      $original_config_array + ['http_client_config' => ['timeout' => 4]],
+      $config_factory->getEditable('imagecache_external.settings')->getRawData()
+    );
+
+    // If user deletes the timeout configuration, the config shouldn't contain
+    // the http_client_config key anymore.
+    $this->submitForm([
+      'http_client_config[timeout]' => '',
+    ], 'Save configuration');
+    $this->assertSession()->statusCodeEquals(200);
+    $reverted_config = $config_factory->getEditable('imagecache_external.settings')->getRawData();
+    $this->assertArrayNotHasKey('http_client_config', $reverted_config);
+    $this->assertSame($original_config_array, $reverted_config);
+  }
+
+}
