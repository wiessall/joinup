index 0000000000000000000000000000000000000000..fcd7ae79efedd9dd88ed4e340c6488d0bf3ef75f
--- /dev/null
+++ b/src/EmailConfirmerMessageFactory.php
@@ -0,0 +1,136 @@
+<?php
+
+namespace Drupal\email_confirmer;
+
+use Drupal\Core\Entity\EntityStorageInterface;
+use Drupal\Component\Plugin\Exception\InvalidPluginDefinitionException;
+use Drupal\Component\Plugin\Exception\PluginNotFoundException;
+use Drupal\Core\Entity\EntityTypeManagerInterface;
+
+/**
+ * Responsible for creating EmailConfirmerMessage objects.
+ *
+ * @package Drupal\email_confirmer
+ */
+class EmailConfirmerMessageFactory {
+
+  /**
+   * The entity type manager.
+   *
+   * @var EntityTypeManagerInterface
+   */
+  protected $entityTypeManager;
+
+  /**
+   * Construct an EmailConfirmerMessageFactory.
+   *
+   * @param EntityTypeManagerInterface $entity_type_manager
+   *   The entity type manager.
+   */
+  public function __construct(EntityTypeManagerInterface $entity_type_manager) {
+    $this->entityTypeManager = $entity_type_manager;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function createConfirmerMessageFromDataArray(array $messageData) {
+    if (isset($messageData['to_mail'], $messageData['from_mail'], $messageData['subject'], $messageData['body'])) {
+      $toMail = $messageData['to_mail'];
+      $fromMail = $messageData['from_mail'];
+      $subject = $messageData['subject'];
+      $body = $messageData['body'];
+
+      if (isset($messageData['is_html'])) {
+        $isHtml = $messageData['is_html'];
+      }
+      else {
+        $isHtml = NULL;
+      }
+
+      if (isset($messageData['cc_mail'])) {
+        $ccMails = $messageData['cc_mail'];
+      }
+      else {
+        $ccMails = NULL;
+      }
+
+      if (isset($messageData['bcc_mail'])) {
+        $bccMails = $messageData['bcc_mail'];
+      }
+      else {
+        $bccMails = NULL;
+      }
+
+      if (isset($messageData['from_name'])) {
+        $fromName = $messageData['from_name'];
+      }
+      else {
+        $fromName = NULL;
+      }
+
+      if (isset($messageData['theme_name'])) {
+        $themeName = $messageData['theme_name'];
+      }
+      else {
+        $themeName = NULL;
+      }
+
+      return $this->createConfirmerMessage($toMail, $fromMail, $subject, $body, $isHtml, $ccMails, $bccMails, $fromName, $themeName);
+    }
+    else {
+      // TODO: Log required key missing error.
+      return FALSE;
+    }
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function createConfirmerMessage($toMail, $fromMail, $subject, $body, $isHtml = NULL, $ccMails = NULL, $bccMails = NULL, $fromName = NULL, $themeName = NULL) {
+    $data = [
+      'to_mail' => $toMail,
+      'from_mail' => $fromMail,
+      'subject' => $subject,
+      'body' => $body,
+    ];
+
+    if ($isHtml !== NULL) {
+      $data['is_html'] = $isHtml;
+    }
+
+    if ($ccMails !== NULL) {
+      $data['cc_mail'] = $ccMails;
+    }
+
+    if ($bccMails !== NULL) {
+      $data['bcc_mail'] = $bccMails;
+    }
+
+    if ($fromName !== NULL) {
+      $data['from_name'] = $fromName;
+    }
+
+    if ($themeName !== NULL) {
+      $data['theme_name'] = $themeName;
+    }
+
+    $message = $this->entityTypeManager->getStorage('email_confirmer_message')->create($data);
+
+    return $message;
+  }
+
+  /**
+   * Returns the email confirmer message entity type manager.
+   *
+   * @return EntityStorageInterface
+   *   The email confirmer message entity type manager.
+   *
+   * @throws InvalidPluginDefinitionException
+   * @throws PluginNotFoundException
+   */
+  public function getEntityTypeManager() {
+    return $this->entityTypeManager->getStorage('email_confirmer_message');
+}
+
+}
