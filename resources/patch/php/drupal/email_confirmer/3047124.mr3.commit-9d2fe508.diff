+<?php
+
+namespace Drupal\email_confirmer\Entity;
+
+use Drupal\Component\Render\MarkupInterface;
+use Drupal\Core\Entity\ContentEntityBase;
+use Drupal\Core\Entity\EntityTypeInterface;
+use Drupal\Core\Field\BaseFieldDefinition;
+use Drupal\Core\Render\Markup;
+use Drupal\email_confirmer\Utility\OperatingSystemInformation;
+use Drupal\Component\Utility\Mail;
+use Symfony\Component\Mime\Address;
+use Symfony\Component\Mime\Header\MailboxHeader;
+
+// TODO: Create interface for class.
+/**
+ * Defines the email confirmation entity class.
+ *
+ * @ContentEntityType(
+ *   id = "email_confirmer_message",
+ *   label = @Translation("Email message"),
+ *   label_singular = @Translation("Email message"),
+ *   label_plural = @Translation("Email messages"),
+ *   label_count = @PluralTranslation(
+ *     singular = "@count email message",
+ *     plural = "@count email messages",
+ *   ),
+ *   base_table = "email_confirmer_message",
+ *   entity_keys = {
+ *     "id" = "msgid",
+ *     "uuid" = "uuid",
+ *     "label" = "to_mail",
+ *     "langcode" = "langcode",
+ *   },
+ *   admin_permission = "administer email confirmations",
+ * )
+ */
+class EmailConfirmerMessage extends ContentEntityBase {
+
+  /**
+   * The body value as markup.
+   *
+   * @var MarkupInterface
+   */
+  protected $markupBody;
+
+  /**
+   * {@inheritdoc}
+   */
+  public function label() {
+    return $this->get('to_mail')->value;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public static function baseFieldDefinitions(EntityTypeInterface $entity_type) {
+    /** @var BaseFieldDefinition[] $fields */
+    $fields = parent::baseFieldDefinitions($entity_type);
+
+    $fields['msgid'] = BaseFieldDefinition::create('integer')
+      ->setLabel(t('Email message ID'))
+      ->setDescription(t('The ID of the email message.'))
+      ->setReadOnly(TRUE);
+
+    $fields['to_mail'] = BaseFieldDefinition::create('email')
+      ->setLabel(t('Email'))
+      ->setDescription(t('The recipient email address of this message.'))
+      ->setRequired(TRUE)
+      ->setSetting('max_length', 255)
+      ->setDisplayOptions('view', [
+        'type' => 'string',
+        'weight' => 0,
+      ]);
+
+    $fields['cc_mail'] = BaseFieldDefinition::create('string_long')
+      ->setLabel(t('CC emails'))
+      ->setDescription(t('The cc recipient email addresses of this message.'))
+      ->setDisplayOptions('view', [
+        'type' => 'string',
+        'weight' => 0,
+      ]);
+
+    $fields['bcc_mail'] = BaseFieldDefinition::create('string_long')
+      ->setLabel(t('BCC emails'))
+      ->setDescription(t('The bcc recipient email addresses of this message.'))
+      ->setDisplayOptions('view', [
+        'type' => 'string',
+        'weight' => 0,
+      ]);
+
+    $fields['from_mail'] = BaseFieldDefinition::create('email')
+      ->setLabel(t('From email'))
+      ->setDescription(t('The sender email address of this message.'))
+      ->setRequired(TRUE)
+      ->setSetting('max_length', 255)
+      ->setDisplayOptions('view', [
+        'type' => 'string',
+        'weight' => 0,
+      ]);
+
+    $fields['from_name'] = BaseFieldDefinition::create('string')
+      ->setLabel(t('From name'))
+      ->setSetting('max_length', 255)
+      ->setDisplayOptions('view', [
+        'type' => 'string',
+        'weight' => 0,
+      ]);
+
+    $fields['subject'] = BaseFieldDefinition::create('string')
+      ->setLabel(t('Subject'))
+      ->setRequired(TRUE)
+      ->setSetting('max_length', 255)
+      ->setDisplayOptions('view', [
+        'type' => 'string',
+        'weight' => 0,
+      ]);
+
+    $fields['body'] = BaseFieldDefinition::create('string_long')
+      ->setLabel(t('Body'))
+      ->setRequired(TRUE)
+      ->setDisplayOptions('view', [
+        'type' => 'string',
+        'weight' => 0,
+      ]);
+
+    $fields['is_html'] = BaseFieldDefinition::create('boolean')
+      ->setLabel(t('Is HTML mail'))
+      ->setDescription(t('A boolean indicating whether the email is HTML or plain text.'))
+      ->setDefaultValue(FALSE)
+      ->setDisplayOptions('view', [
+        'type' => 'string',
+        'weight' => 0,
+      ]);
+
+    $fields['theme_name'] = BaseFieldDefinition::create('string')
+      ->setLabel(t('The theme to use for the email.'))
+      ->setSetting('max_length', 255)
+      ->setDisplayOptions('view', [
+        'type' => 'string',
+        'weight' => 0,
+      ]);
+
+    return $fields;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function getToMail() {
+    $toMailAddress = $this->get('to_mail')->getString();
+
+    /* Use "User <user@example.com>" format if the webserver is using Windows.
+    @see https://www.php.net/manual/en/function.mail.php Notes.
+    The Windows implementation of mail()
+    differs in many ways from the Unix implementation.
+    First, it doesn't use a local binary for composing messages
+    but only operates on direct sockets which means a MTA is needed
+    listening on a network socket
+    (which can either on the localhost or a remote machine).
+    Second, the custom headers like
+    From:, Cc:, Bcc: and Date: are not interpreted
+    by the MTA in the first place, but are parsed by PHP.
+    As such, the to parameter should not be an
+    address in the form of "Something <someone@example.com>".
+    The mail command may not parse this properly while talking with the MTA.
+     */
+    if (OperatingSystemInformation::isServerWindows()) {
+      $toMail = $toMailAddress;
+    }
+    else {
+      $mailbox = new MailboxHeader('From', new Address($toMailAddress));
+      $toMail = $mailbox->getBodyAsString();
+    }
+
+    return $toMail;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function setToMail($email) {
+    $this->get('to_mail')->setValue($email);
+
+    return $this;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function getCcMail() {
+    if ($this->hasCcMail()) {
+      return $this->get('cc_mail')->getString();
+    }
+    else {
+      return NULL;
+    }
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function setCcMail($email) {
+    $this->get('cc_mail')->setValue($email);
+
+    return $this;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function hasCcMail() {
+    $value = $this->get('cc_mail');
+
+    if ($value->isEmpty()) {
+      return FALSE;
+    }
+    else {
+      return TRUE;
+    }
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function getBccMail() {
+    if ($this->hasBccMail()) {
+      return $this->get('bcc_mail')->getString();
+    }
+    else {
+      return NULL;
+    }
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function setBccMail($email) {
+    $this->get('bcc_mail')->setValue($email);
+
+    return $this;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function hasBccMail() {
+    $value = $this->get('bcc_mail');
+
+    if ($value->isEmpty()) {
+      return FALSE;
+    }
+    else {
+      return TRUE;
+    }
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function getFromMail() {
+    if ($this->hasFromMail()) {
+      return $this->get('from_mail')->getString();
+    }
+    else {
+      return NULL;
+    }
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function setFromMail($email) {
+    $this->get('from_mail')->setValue($email);
+
+    return $this;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function hasFromMail() {
+    $value = $this->get('from_mail');
+
+    if ($value->isEmpty()) {
+      return FALSE;
+    }
+    else {
+      return TRUE;
+    }
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function getFromName() {
+    return $this->get('from_name')->getString();
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function setFromName($name) {
+    $this->get('from_name')->setValue($name);
+
+    return $this;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function hasFromName() {
+    $value = $this->get('from_name');
+
+    if ($value->isEmpty()) {
+      return FALSE;
+    }
+    else {
+      return TRUE;
+    }
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function getSubject() {
+    return $this->get('subject')->getString();
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function setSubject($subject) {
+    $this->get('subject')->setValue($subject);
+
+    return $this;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function getBody() {
+    return $this->get('body')->getString();
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function getRawBody() {
+    if ($this->markupBody instanceof MarkupInterface) {
+      return $this->markupBody;
+    }
+    else {
+      return $this->getBody();
+    }
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function setBody($body) {
+    $this->get('body')->setValue($body);
+
+    if ($body instanceof MarkupInterface) {
+      $this->markupBody = $body;
+    }
+
+    return $this;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function isHtml() {
+    return $this->get('is_html')->value;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function setIsHtml($isHtml) {
+    $this->get('is_html')->setValue($isHtml);
+
+    return $this;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function getThemeName() {
+    if ($this->hasThemeName()) {
+      $themeName = $this->get('theme_name')->getString();
+    }
+    else {
+      $themeName = NULL;
+    }
+
+    return $themeName;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function setThemeName($themeName) {
+    $this->get('theme_name')->setValue($themeName);
+
+    return $this;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function hasThemeName() {
+    $value = $this->get('theme_name');
+
+    if ($value->isEmpty()) {
+      return FALSE;
+    }
+    else {
+      return TRUE;
+    }
+  }
+
+  /**
+   * Creates a message compatible with \Drupal\Core\Mail\MailManagerInterface.
+   */
+  public function toMessageArray() {
+    $message = [
+      'to_mail' => $this->getToMail(),
+      'from_mail' => $this->getFromMail(),
+      'from_name' => $this->getFromName(),
+      'cc_mail' => $this->getCcMail(),
+      'bcc_mail' => $this->getBccMail(),
+      'subject' => $this->getSubject(),
+      /* Get the raw body, in case it is a Markup object. Because the body field can only contain strings. */
+      'body' => $this->getRawBody(),
+    ];
+
+    return $message;
+  }
+
+}
