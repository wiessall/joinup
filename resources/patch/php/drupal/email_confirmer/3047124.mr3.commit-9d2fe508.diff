+   if ($this->hasMessage()) {
+      $referencedEntities = $this->get('msgid')->referencedEntities();
+      if (isset($referencedEntities[0])) {
+        $message = $referencedEntities[0];
+      }
+      else {
+        $message = NULL;
+      }
+
+      return $message;
+    }
+    else {
+      return NULL;
+    }
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function hasMessage() {
+    $value = $this->get('msgid');
+
+    if ($value->isEmpty()) {
+      return FALSE;
+    }
+    else {
+      return TRUE;
+    }
+  }
+
+  /**
+   * Returns the config factory service.
+   *
+   * Currently, dependency injection for entities is not supported.
+   *
+   * @return ConfigFactoryInterface
+   *   The config factory service.
+   */
+  protected function getConfigFactory() {
+    if (!$this->configFactory instanceof ConfigFactoryInterface) {
+      $this->configFactory = \Drupal::configFactory();
+    }
+
+    return $this->configFactory;
+  }
+
+  /**
+  * Returns the module configuration.
+  *
+  * @return ImmutableConfig
+  *   The module configuration.
+  */
+ protected function getModuleConfig() {
+    return $this->getConfigFactory()->get('email_confirmer.settings');
+  }
+
 }
