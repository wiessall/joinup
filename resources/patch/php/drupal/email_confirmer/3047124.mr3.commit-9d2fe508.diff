+      'view',
+      [
+        'type' => 'string',
+        'weight' => 0,
+      ]
+    );
+    $field_storage_definitions['bcc_mail'] = BaseFieldDefinition::create(
+      'string_long'
+    )->setLabel(t('BCC emails'))->setDescription(
+      t('The bcc recipient email addresses of this message.')
+    )->setDisplayOptions(
+      'view',
+      [
+        'type' => 'string',
+        'weight' => 0,
+      ]
+    );
+    $field_storage_definitions['from_mail'] = BaseFieldDefinition::create('email')
+      ->setLabel(t('From email'))
+      ->setDescription(t('The sender email address of this message.'))
+      ->setSetting('max_length', 255)
+      ->setDisplayOptions(
+        'view',
+        [
+          'type' => 'string',
+          'weight' => 0,
+        ]
+      );
+    $field_storage_definitions['from_name'] = BaseFieldDefinition::create(
+      'string'
+    )->setLabel(t('From name'))->setSetting('max_length', 255)->setDisplayOptions(
+      'view',
+      [
+        'type' => 'string',
+        'weight' => 0,
+      ]
+    );
+    $field_storage_definitions['reply_to_mail'] = BaseFieldDefinition::create(
+      'email'
+    )->setLabel(t('Reply-To email'))->setDescription(
+      t('The reply-to email address of this message.')
+    )->setSetting('max_length', 255)->setDisplayOptions(
+      'view',
+      [
+        'type' => 'string',
+        'weight' => 0,
+      ]
+    );
+    $field_storage_definitions['subject'] = BaseFieldDefinition::create('string')
+      ->setLabel(t('Subject'))
+      ->setSetting('max_length', 255)
+      ->setDisplayOptions(
+        'view',
+        [
+          'type' => 'string',
+          'weight' => 0,
+        ]
+      );
+    $field_storage_definitions['body'] = BaseFieldDefinition::create(
+      'string_long'
+    )->setLabel(t('Body'))->setRequired(TRUE)->setDisplayOptions(
+      'view',
+      [
+        'type' => 'string',
+        'weight' => 0,
+      ]
+    );
+    $update_manager->installFieldableEntityType(
+      new ContentEntityType(
+        [
+          'id' => 'email_confirmer_message',
+          'label' => new TranslatableMarkup(
+            'Email message'
+          ),
+          'label_singular' => new TranslatableMarkup('Email message'),
+          'label_plural' => new TranslatableMarkup('Email messages'),
+          'label_count' => [
+            'singular' => '@count email message',
+            'plural' => '@count email messages',
+          ],
+          'base_table' => 'email_confirmer_message',
+          'entity_keys' => [
+            'id' => 'msgid',
+            'langcode' => 'langcode',
+          ],
+          'admin_permission' => 'administer email confirmations',
+        ]
+      ),
+      $field_storage_definitions
+    );
+  }
+
+  // update existing confirmation entity with reference to message
+  $entity_type = $update_manager->getEntityType('email_confirmer_confirmation');
+  $field_storage_definitions = $last_installed_schema_repository->getLastInstalledFieldStorageDefinitions('email_confirmer_confirmation');
+  $field_storage_definitions['msgid'] = BaseFieldDefinition::create('entity_reference')
+    ->setName('msgid')
+    ->setTargetEntityTypeId('email_confirmer_confirmation')
+    ->setLabel(t('Email message ID'))
+    ->setDescription(t('The email message to use for the confirmation mail.'))
+    ->setSetting('target_type', 'email_confirmer_message')
+    ->setSetting('handler', 'default')
+    ->setDisplayOptions('view', [
+      'type' => 'hidden',
+      'weight' => 0,
+    ]);
+  $update_manager->updateFieldableEntityType($entity_type, $field_storage_definitions);
+}
