diff --git a/src/Mail/EmailConfirmerMailer.php b/src/Mail/EmailConfirmerMailer.php
new file mode 100644
index 0000000000000000000000000000000000000000..dc46df5a47086edfa5c58351c25ad3d0c15e25ac
--- /dev/null
+++ b/src/Mail/EmailConfirmerMailer.php
@@ -0,0 +1,150 @@
+<?php
+
+namespace Drupal\email_confirmer\Mail;
+
+use Drupal\Component\Utility\Mail;
+use Drupal\Core\Config\ConfigFactoryInterface;
+use Drupal\Core\Language\LanguageManagerInterface;
+use Drupal\Core\Mail\MailManagerInterface;
+use Drupal\email_confirmer\EmailConfirmationInterface;
+use Drupal\email_confirmer\Entity\EmailConfirmerMessage;
+use Drupal\Core\Render\Markup;
+use Drupal\email_confirmer\Theme\EmailConfirmerThemeManager;
+use Symfony\Component\Mime\Address;
+use Symfony\Component\Mime\Header\MailboxHeader;
+
+/**
+ * Class EmailConfirmerMailer.
+ *
+ * @package Drupal\email_confirmer\Mail
+ */
+class EmailConfirmerMailer {
+
+  /**
+   * The language manager.
+   *
+   * @var LanguageManagerInterface
+   */
+  protected $languageManager;
+
+  /**
+   * The theme manager.
+   *
+   * @var EmailConfirmerThemeManager
+   */
+  protected $themeManager;
+
+  /**
+   * The mail manager.
+   *
+   * @var MailManagerInterface
+   */
+  protected $mailManager;
+
+  /**
+   * The config factory.
+   *
+   * @var ConfigFactoryInterface
+   */
+  protected $configFactory;
+
+  /**
+   * EmailConfirmerMailer constructor.
+   *
+   * @param LanguageManagerInterface $language_manager
+   *   The language manager.
+   * @param EmailConfirmerThemeManager $theme_manager
+   *   The theme manager.
+   * @param MailManagerInterface $mail_manager
+   *   The mail manager.
+   * @param ConfigFactoryInterface $config_factory
+   *   The config factory.
+   */
+  public function __construct(LanguageManagerInterface $language_manager, EmailConfirmerThemeManager $theme_manager, MailManagerInterface $mail_manager, ConfigFactoryInterface $config_factory) {
+    $this->languageManager = $language_manager;
+    $this->themeManager = $theme_manager;
+    $this->mailManager = $mail_manager;
+    $this->configFactory = $config_factory;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function sendMail(EmailConfirmerMessage $emailConfirmerMessage, EmailConfirmationInterface $emailConfirmation = NULL, $key = 'confirmation_request') {
+    if ($emailConfirmerMessage->hasFromName()) {
+      // Remove less than (<) and greater (>) than from name.
+      // TODO: Figure out the proper way to encode special characters.
+      $emailConfirmerMessage->setFromName(preg_replace('/[<>]/', '', $emailConfirmerMessage->getFromName()));
+
+      if ($emailConfirmerMessage->hasFromName()) {
+        $toMail = new MailboxHeader('From', new Address($emailConfirmerMessage->getFromMail(), $emailConfirmerMessage->getFromName()));
+        $emailConfirmerMessage->setFromName($toMail->getBodyAsString());
+      }
+    }
+    else {
+      $emailConfirmerMessage->setFromName($emailConfirmerMessage->getFromMail());
+    }
+
+    $currentLangcode = $this->languageManager->getCurrentLanguage()->getId();
+
+    // Render body using email confirmer email message (wrapper) template.
+    $emailConfirmerMessage->setBody(is_string($emailConfirmerMessage->getBody()) ? Markup::create($emailConfirmerMessage->getBody()) : $emailConfirmerMessage->getBody());
+    $build = [
+      '#theme' => 'email_confirmer_email_message_' . (($emailConfirmerMessage->isHtml()) ? 'html' : 'text'),
+      '#to_mail' => $emailConfirmerMessage->getToMail(),
+      '#from_mail' => $emailConfirmerMessage->getFromMail(),
+      '#from_name' => $emailConfirmerMessage->getFromName(),
+      '#cc_mail' => $emailConfirmerMessage->getCcMail(),
+      '#bcc_mail' => $emailConfirmerMessage->getBccMail(),
+      '#subject' => $emailConfirmerMessage->getSubject(),
+      '#body' => $emailConfirmerMessage->getBody(),
+    ];
+
+    $emailConfirmerMessage->setBody(trim((string) $this->themeManager->renderPlain($build, $emailConfirmerMessage->getThemeName())));
+
+    if ($emailConfirmerMessage->isHtml()) {
+      switch ($this->getMailSystemFormatter()) {
+        case 'swiftmailer':
+          // SwiftMailer requires that the body be valid Markup.
+          $emailConfirmerMessage->setBody(Markup::create($emailConfirmerMessage->getBody()));
+          break;
+      }
+    }
+
+    $emailMessageArray = $emailConfirmerMessage->toMessageArray();
+    if ($emailConfirmation instanceof EmailConfirmationInterface) {
+      // Provide the confirmation object for custom modules. If it is passed.
+      $emailMessageArray['context'][$key] = $emailConfirmation;
+    }
+
+    // Send message.
+    $result = $this->mailManager->mail('email_confirmer', $key, $emailConfirmerMessage->getToMail(), $currentLangcode, $emailMessageArray, $emailConfirmerMessage->getFromMail());
+
+    return $result['send'];
+  }
+
+  /**
+   * Get the Mail System's formatter module name.
+   *
+   * @return string
+   *   The Mail System's formatter module name.
+   */
+  protected function getMailSystemFormatter() {
+    $mailsystemConfig = $this->configFactory->get('mailsystem.settings');
+    // Get the default formatter.
+    $mailsystemFormatter = $mailsystemConfig->get('defaults.formatter');
+
+    return $mailsystemFormatter;
+  }
+
+  /**
+   * Returns the default mail of the site.
+   *
+   * @return string
+   *   The default email address.
+   */
+  public function getSiteDefaultMail() {
+    return $this->configFactory->get('system.site')->get('mail');
+  }
+
+}
