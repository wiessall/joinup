@@ -0,0 +1,37 @@
+<?php
+
+namespace Drupal\email_confirmer\Utility;
+
+/**
+ * Class OperatingSystemInformation.
+ */
+class OperatingSystemInformation {
+
+  /**
+   * Returns the operating system name.
+   *
+   * @return string
+   *   The OS name.
+   */
+  public static function getServerOperatingSystem() {
+    $operatingSystem = mb_substr(PHP_OS, 0, 3);
+
+    return $operatingSystem;
+  }
+
+  /**
+   * Checks if the webserver is running on Windows.
+   *
+   * @return bool
+   *   TRUE if server is running on Windows.
+   */
+  public static function isServerWindows() {
+    if (self::getServerOperatingSystem() === 'WIN') {
+      return TRUE;
+    }
+    else {
+      return FALSE;
+    }
+  }
+
+}
