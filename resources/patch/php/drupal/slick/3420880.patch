+      type: string
+      label: Thumbnail caption
+    thumbnail_effect:
+      type: string
+      label: Dots thumbnail effect
+    thumbnail_position:
+      type: string
+      label: Thumbnail position
+    override:
+      type: boolean
+      label: Override main optionset
+    preserve_keys:
+      type: boolean
+      label: Preserve keys
+    visible_items:
+      type: integer
+      label: Visible items
+    link:
+      type: string
+      label: Link
+    view_mode:
+      type: string
+      label: View mode
+    cache:
+      type: integer
+      label: Cache
+    preload:
+      type: boolean
+      label: Preload
+    use_theme_field:
+      type: boolean
+      label: Use theme field
+    skin_arrows:
+      type: string
+      label: Skin arrows
+    skin_dots:
+      type: string
+      label: Skin dots
 
 # Slick fieldable entity or Views settings.
 slick_extended:
