Subject: [PATCH] Slick image schema.

---
 config/schema/slick.schema.yml | 97 ++++++++++++++++++++++++++++++++++
 1 file changed, 97 insertions(+)

diff --git a/config/schema/slick.schema.yml b/config/schema/slick.schema.yml
index 8771436..9299202 100644
--- a/config/schema/slick.schema.yml
+++ b/config/schema/slick.schema.yml
@@ -277,6 +277,103 @@ slick_base:
 slick_image:
   type: slick_base
   label: 'Slick image display format settings'
+  mapping:
+    layout:
+      type: string
+      label: Layout
+    background:
+      type: boolean
+      label: Background
+    box_caption:
+      type: string
+      label: 'Lightbox caption'
+    box_caption_custom:
+      type: string
+      label: Lightbox custom caption
+    box_media_style:
+      type: string
+      label: Lightbox media style
+    loading:
+      type: string
+      label: Loading priority
+    responsive_image_style:
+      type: string
+      label: Responsive image style
+    box_style:
+      type: string
+      label: 'Lightbox (Responsive) image style'
+    image_style:
+      type: string
+      label: Image style
+    media_switch:
+      type: string
+      label: 'Media switcher'
+    ratio:
+      type: string
+      label: Aspect ratio
+    thumbnail_style:
+      type: string
+      label: Thumbnail style
+    grid:
+      type: string
+      label: Grid large
+    grid_medium:
+      type: string
+      label: Grid medium
+    grid_small:
+      type: string
