diff --git a/src/ProviderPluginBase.php b/src/ProviderPluginBase.php
index c3c4b0d..d138487 100644
--- a/src/ProviderPluginBase.php
+++ b/src/ProviderPluginBase.php
@@ -2,6 +2,7 @@
 
 namespace Drupal\video_embed_field;
 
+use Drupal\Component\Serialization\Json;
 use Drupal\Core\File\FileSystemInterface;
 use Drupal\Core\Plugin\ContainerFactoryPluginInterface;
 use Drupal\Core\Plugin\PluginBase;
@@ -103,6 +104,42 @@ abstract class ProviderPluginBase extends PluginBase implements ProviderPluginIn
     return $this->input;
   }
 
+  /**
+   * Download JSON data from the site (e.g., oEmbed data).
+   *
+   * @param string $url
+   *   The URL to fetch the data from.
+   *
+   * @return array|null
+   *   The JSON data as an object or NULL if the JSON could not be decoded.
+   */
+  protected function downloadJsonData($url): ?array {
+    $cid = 'video_embed_field:' . md5($url);
+    if ($cache = \Drupal::cache()->get($cid)) {
+      return $cache->data;
+    }
+
+    $method = 'GET';
+    try {
+      $response = $this->httpClient->request($method, $url);
+      $code = $response->getStatusCode();
+      if ($code == 200) {
+        $body = $response->getBody()->getContents();
+        $data = Json::decode($body);
+
+        // Check if the JSON was valid.
+        if (json_last_error() === JSON_ERROR_NONE) {
+          \Drupal::cache()->set($cid, $data);
+          return $data;
+        }
+      }
+    }
+    catch (\Exception $e) {
+      \Drupal::logger('video_embed_field')->warning('There was an error downloading metadata. Message: @message.', ['@message' => $e->getMessage()]);
+    }
+    return NULL;
+  }
+
   /**
    * {@inheritdoc}
    */
