diff --git a/tests/src/FunctionalJavascript/TourTriggerTest.php b/tests/src/FunctionalJavascript/TourTriggerTest.php
new file mode 100644
index 0000000..ce99dcb
--- /dev/null
+++ b/tests/src/FunctionalJavascript/TourTriggerTest.php
@@ -0,0 +1,110 @@
+<?php
+
+namespace Drupal\Tests\tour\FunctionalJavascript;
+
+use Drupal\FunctionalJavascriptTests\WebDriverTestBase;
+
+/**
+ * Tests tour triggering functionality.
+ *
+ * @group tour
+ */
+class TourTriggerTest extends WebDriverTestBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'toolbar',
+    'tour_test',
+  ];
+
+  /**
+   * {@inheritdoc}
+   */
+  protected $defaultTheme = 'stark';
+
+  /**
+   * Tests tour triggering functionality.
+   */
+  public function testTourTrigger() {
+    $this->drupalLogin($this->createUser([
+      'access toolbar',
+      'access tour',
+    ]));
+    $this->drupalGet('/tour-test-4');
+    $page = $this->getSession()->getPage();
+
+    // Clicking on toolbar tour button starts the tour.
+    $page->pressButton('Tour');
+    $this->assertTourStarted();
+    $this->assertSame('true', $page->findButton('Tour')->getAttribute('aria-pressed'));
+    // Pressing once again, stops the tour.
+    $page->pressButton('Tour');
+    $this->assertTourStopped();
+    $this->assertSame('false', $page->findButton('Tour')->getAttribute('aria-pressed'));
+
+    // Pressing a button with the 'js-tour-start-button' class starts the tour.
+    $page->pressButton('Trigger 1');
+    $this->assertTourStarted();
+    $this->assertSame('true', $page->findButton('Trigger 1')->getAttribute('aria-pressed'));
+    // Pressing once again, stops the tour.
+    $page->pressButton('Trigger 1');
+    $this->assertTourStopped();
+    $this->assertSame('false', $page->findButton('Trigger 1')->getAttribute('aria-pressed'));
+
+    // Clicking an element having 'js-tour-start-button' class starts the tour.
+    $h3 = $page->findById('trigger2');
+    $h3->click();
+    $this->assertFalse($h3->hasAttribute('aria-pressed'));
+    $this->assertTourStarted();
+    // Pressing once again, stops the tour.
+    $h3->click();
+    $this->assertTourStopped();
+    $this->assertFalse($h3->hasAttribute('aria-pressed'));
+
+    // Uninstall toolbar module to test that tour triggering is fully decoupled.
+    \Drupal::service('module_installer')->uninstall(['toolbar']);
+    $this->getSession()->reload();
+    $this->assertSession()->buttonNotExists('Tour');
+
+    // Trigger again the tour from a button having 'js-tour-start-button' class.
+    $page->pressButton('Trigger 1');
+    $this->assertTourStarted();
+    $this->assertSame('true', $page->findButton('Trigger 1')->getAttribute('aria-pressed'));
+    // Pressing once again, stops the tour.
+    $page->pressButton('Trigger 1');
+    $this->assertTourStopped();
+    $this->assertSame('false', $page->findButton('Trigger 1')->getAttribute('aria-pressed'));
+  }
+
+  /**
+   * Asserts that the tour has been successfully started.
+   */
+  protected function assertTourStarted() {
+    $assert_session = $this->assertSession();
+
+    $assert_session->pageTextContains('The first tip');
+    $assert_session->pageTextContains('Lorem ipsum dolor sit amet, sed do ut et dolore magna.');
+    $assert_session->pageTextContains('1 of 2');
+    $assert_session->linkExists('Next');
+    $assert_session->linkExists('×');
+
+    // Advance to the next tip.
+    $this->getSession()->getPage()->clickLink('Next');
+
+    $assert_session->pageTextContains('The 2nd tip');
+    $assert_session->pageTextContains('Eta shared');
+    $assert_session->pageTextContains('2 of 2');
+    $assert_session->linkExists('End tour');
+    $assert_session->linkExists('×');
+  }
+
+  /**
+   * Asserts that the tour has is stopped.
+   */
+  protected function assertTourStopped() {
+    $this->assertSession()->linkNotExists('×');
+  }
+
+}
