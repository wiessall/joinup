@@ -0,0 +1,146 @@
+<?php
+
+namespace Drupal\Tests\inline_entity_form\FunctionalJavascript;
+
+use Drupal\Core\Entity\Entity\EntityFormDisplay;
+use PHPUnit\Framework\Attributes\Group;
+
+/**
+ * Tests that optional IEF simple widget fields handle submissions correctly.
+ *
+ * @see https://www.drupal.org/project/inline_entity_form/issues/3099844
+ */
+#[Group('inline_entity_form')]
+class OptionalSimpleWidgetTest extends InlineEntityFormTestBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'inline_entity_form_test',
+  ];
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+
+    $this->user = $this->createUser([
+      'create ief_simple_single content',
+      'create ief_test_custom content',
+      'edit any ief_simple_single content',
+      'edit own ief_test_custom content',
+      'view own unpublished content',
+    ]);
+    $this->drupalLogin($this->user);
+  }
+
+  /**
+   * Makes the 'single' field optional and uses the 'inline' form mode.
+   */
+  protected function setupOptionalSimpleIef(): void {
+    $field_config = $this->fieldConfigStorage->load('node.ief_simple_single.single');
+    $field_config->setRequired(FALSE);
+    $field_config->save();
+
+    $form_display = EntityFormDisplay::load('node.ief_simple_single.default');
+    $component = $form_display->getComponent('single');
+    $component['settings']['form_mode'] = 'inline';
+    $form_display->setComponent('single', $component);
+    $form_display->save();
+  }
+
+  /**
+   * Tests that child required fields remain marked as required.
+   */
+  public function testOptionalIefChildFieldsAreRequired() {
+    $assert_session = $this->assertSession();
+    $this->setupOptionalSimpleIef();
+
+    $this->drupalGet('node/add/ief_simple_single');
+
+    $host_title = $assert_session->elementExists('css', '#edit-title-0-value');
+    $this->assertTrue($host_title->hasAttribute('required'));
+
+    $ief_title = $assert_session->elementExists('css', '#edit-single-0-inline-entity-form-title-0-value');
+    $this->assertTrue($ief_title->hasAttribute('required'));
+  }
+
+  /**
+   * Tests that an optional IEF field with filled values saves the child entity.
+   */
+  public function testOptionalIefFilledSubmission() {
+    $assert_session = $this->assertSession();
+    $page = $this->getSession()->getPage();
+    $this->setupOptionalSimpleIef();
+
+    $this->drupalGet('node/add/ief_simple_single');
+
+    $title_field_xpath = $this->getXpathForNthInputByLabelText('Title', 1);
+    $nested_title_field_xpath = $this->getXpathForNthInputByLabelText('Title', 2);
+    $positive_int_field_xpath = $this->getXpathForNthInputByLabelText('Positive int', 1);
+
+    $host_title = 'Host with filled IEF';
+    $child_title = 'Child entity';
+    $assert_session->elementExists('xpath', $title_field_xpath)->setValue($host_title);
+    $assert_session->elementExists('xpath', $nested_title_field_xpath)->setValue($child_title);
+    $assert_session->elementExists('xpath', $positive_int_field_xpath)->setValue('5');
+    $page->pressButton('Save');
+    $this->assertNotEmpty($assert_session->waitForElement('css', 'div[data-drupal-messages]'));
+
+    $assert_session->pageTextContains("$host_title has been created.");
+
+    $host_node = $this->drupalGetNodeByTitle($host_title);
+    $this->assertNotNull($host_node);
+    $this->assertFalse($host_node->get('single')->isEmpty());
+
+    $child_node = $host_node->get('single')->entity;
+    $this->assertNotNull($child_node);
+    $this->assertEquals($child_title, $child_node->label());
+    $this->assertEquals('5', $child_node->get('positive_int')->value);
+  }
+
+  /**
+   * Tests that partial fill still enforces required fields.
+   */
+  public function testOptionalIefPartialFillShowsError() {
+    $assert_session = $this->assertSession();
+    $page = $this->getSession()->getPage();
+    $this->setupOptionalSimpleIef();
+
+    $this->drupalGet('node/add/ief_simple_single');
+
+    $title_field_xpath = $this->getXpathForNthInputByLabelText('Title', 1);
+    $positive_int_field_xpath = $this->getXpathForNthInputByLabelText('Positive int', 1);
+
+    $host_title = 'Host with partial IEF';
+    $assert_session->elementExists('xpath', $title_field_xpath)->setValue($host_title);
+    $assert_session->elementExists('xpath', $positive_int_field_xpath)->setValue('5');
+    $page->pressButton('Save');
+
+    $this->assertNoNodeByTitle($host_title);
+  }
+
+  /**
+   * Tests that a required IEF simple widget still requires entity creation.
+   */
+  public function testRequiredIefStillValidates() {
+    $assert_session = $this->assertSession();
+    $page = $this->getSession()->getPage();
+
+    $field_config = $this->fieldConfigStorage->load('node.ief_simple_single.single');
+    $this->assertTrue($field_config->isRequired());
+
+    $this->drupalGet('node/add/ief_simple_single');
+
+    $title_field_xpath = $this->getXpathForNthInputByLabelText('Title', 1);
+
+    $host_title = 'Host with required empty IEF';
+    $assert_session->elementExists('xpath', $title_field_xpath)->setValue($host_title);
+    $page->pressButton('Save');
+
+    $this->assertNoNodeByTitle($host_title);
+  }
+
+}
