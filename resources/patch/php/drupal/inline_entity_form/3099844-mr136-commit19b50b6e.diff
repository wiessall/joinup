+ * @see https://www.drupal.org/project/inline_entity_form/issues/3099844
+ */
+#[Group('inline_entity_form')]
+#[RunTestsInSeparateProcesses]
+class IsEmptyEntityNoLabelTest extends KernelTestBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'system',
+    'user',
+    'inline_entity_form',
+    'inline_entity_form_test',
+  ];
+
+  /**
+   * The inline form handler under test.
+   *
+   * @var \Drupal\inline_entity_form\Form\EntityInlineForm
+   */
+  protected $inlineFormHandler;
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+
+    $this->installEntitySchema('entity_test_no_label');
+
+    // Create a form display that shows the 'name' base field.
+    $form_display = EntityFormDisplay::create([
+      'targetEntityType' => 'entity_test_no_label',
+      'bundle' => 'entity_test_no_label',
+      'mode' => 'default',
+      'status' => TRUE,
+    ]);
+    $form_display->setComponent('name', [
+      'type' => 'string_textfield',
+      'weight' => 0,
+    ]);
+    $form_display->save();
+
+    $entity_type = $this->container->get('entity_type.manager')
+      ->getDefinition('entity_test_no_label');
+    $this->inlineFormHandler = EntityInlineForm::createInstance(
+      $this->container,
+      $entity_type
+    );
+  }
+
+  /**
+   * Tests that an entity without a label key checks all displayed fields.
+   */
+  public function testEmptyEntityWithoutLabelKey() {
+    $entity_type = $this->container->get('entity_type.manager')
+      ->getDefinition('entity_test_no_label');
+
+    $this->assertFalse($entity_type->getKey('label'));
+
+    $storage = $this->container->get('entity_type.manager')
+      ->getStorage('entity_test_no_label');
+
+    $empty_entity = $storage->create();
+    $this->assertTrue($this->inlineFormHandler->isEmptyEntity($empty_entity, 'default'));
+
+    $filled_entity = $storage->create(['name' => 'Test value']);
+    $this->assertFalse($this->inlineFormHandler->isEmptyEntity($filled_entity, 'default'));
+  }
+
+  /**
+   * Tests that a non-displayed field does not affect emptiness.
+   */
+  public function testNonDisplayedFieldIgnored() {
+    $storage = $this->container->get('entity_type.manager')
+      ->getStorage('entity_test_no_label');
+
+    $form_display = EntityFormDisplay::load('entity_test_no_label.entity_test_no_label.default');
+    $form_display->removeComponent('name');
+    $form_display->save();
+
+    $entity = $storage->create(['name' => 'Test value']);
+    $this->assertTrue($this->inlineFormHandler->isEmptyEntity($entity, 'default'));
+  }
+
+}
