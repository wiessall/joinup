+  protected function clearIefErrors(array $entity_form, FormStateInterface $form_state) {
+    $errors = $form_state->getErrors();
+    $prefix = implode('][', $entity_form['#parents']);
+    $non_ief_errors = array_filter(
+      $errors,
+      static fn(string $name): bool =>
+        $name !== $prefix && !str_starts_with($name, $prefix . ']['),
+      ARRAY_FILTER_USE_KEY,
+    );
+
+    if ($non_ief_errors === $errors) {
+      return;
+    }
+
+    // Suspend limit_validation_errors during the swap so that
+    // setErrorByName() does not discard errors in AJAX requests.
+    $limit = $form_state->getLimitValidationErrors();
+    $form_state->setLimitValidationErrors(NULL);
+    $form_state->clearErrors();
+    foreach ($non_ief_errors as $name => $error) {
+      $form_state->setErrorByName($name, $error);
+    }
+    $form_state->setLimitValidationErrors($limit);
+  }
+
