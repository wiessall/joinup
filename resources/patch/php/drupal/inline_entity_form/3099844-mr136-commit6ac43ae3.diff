+  public function isEmptyEntity(EntityInterface $entity, $form_mode) {
+    $form_display = $this->getFormDisplay($entity, $form_mode);
+    $label_key = $entity->getEntityType()->getKey('label');
+
+    foreach ($entity as $name => $items) {
+      $widget = $form_display->getRenderer($name);
+      if (!$widget) {
+        continue;
+      }
+
+      $field = $entity->get($name);
+      $definition = $field->getFieldDefinition();
+
+      if (!$definition instanceof FieldConfigInterface && $label_key && $name !== $label_key) {
+        continue;
+      }
+
+      if ($definition->getType() === 'boolean') {
+        if (!empty($field->value)) {
+          return FALSE;
+        }
+        continue;
+      }
+
+      if ($field->isEmpty()) {
+        continue;
+      }
+
+      if ($widget instanceof InlineEntityFormBase) {
+        $nested = $field->first()->entity;
+        if ($nested && !$this->isEmptyEntity($nested, $widget->getSetting('form_mode'))) {
+          return FALSE;
+        }
+        continue;
+      }
+
+      return FALSE;
+    }
+
