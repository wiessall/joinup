diff --git a/tests/src/FunctionalJavascript/OptionalIefRequiredFieldsTest.php b/tests/src/FunctionalJavascript/OptionalIefRequiredFieldsTest.php
new file mode 100644
index 0000000000000000000000000000000000000000..af1efea5f3c839b1bc452715312591780ebbf627
--- /dev/null
+++ b/tests/src/FunctionalJavascript/OptionalIefRequiredFieldsTest.php
@@ -0,0 +1,184 @@
+<?php
+
+namespace Drupal\Tests\inline_entity_form\FunctionalJavascript;
+
+use Drupal\Core\Entity\Entity\EntityFormDisplay;
+use PHPUnit\Framework\Attributes\Group;
+use PHPUnit\Framework\Attributes\RunTestsInSeparateProcesses;
+
+/**
+ * Tests that optional IEF fields with required target entity fields work.
+ *
+ * @see https://www.drupal.org/project/inline_entity_form/issues/3099844
+ */
+#[Group('inline_entity_form')]
+#[RunTestsInSeparateProcesses]
+class OptionalIefRequiredFieldsTest extends InlineEntityFormTestBase {
+
+  /**
+   * Modules to enable.
+   *
+   * @var array
+   */
+  protected static $modules = [
+    'inline_entity_form_test',
+  ];
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+
+    $this->user = $this->createUser([
+      'create ief_simple_single content',
+      'create ief_test_custom content',
+      'edit any ief_simple_single content',
+      'edit own ief_test_custom content',
+      'create ief_test_complex content',
+      'edit any ief_test_complex content',
+      'view own unpublished content',
+    ]);
+    $this->drupalLogin($this->user);
+  }
+
+  /**
+   * Makes the 'single' field optional and uses the 'inline' form mode.
+   */
+  protected function setupOptionalSimpleIef(): void {
+    $field_config = $this->fieldConfigStorage->load('node.ief_simple_single.single');
+    $field_config->setRequired(FALSE);
+    $field_config->save();
+
+    $form_display = EntityFormDisplay::load('node.ief_simple_single.default');
+    $component = $form_display->getComponent('single');
+    $component['settings']['form_mode'] = 'inline';
+    $form_display->setComponent('single', $component);
+    $form_display->save();
+  }
+
+  /**
+   * Tests simple widget: optional IEF submitted empty saves successfully.
+   */
+  public function testOptionalSimpleIefEmptySubmission() {
+    $assert_session = $this->assertSession();
+    $page = $this->getSession()->getPage();
+    $this->setupOptionalSimpleIef();
+
+    $this->drupalGet('node/add/ief_simple_single');
+
+    $title_field_xpath = $this->getXpathForNthInputByLabelText('Title', 1);
+
+    $host_title = 'Host node with empty optional IEF';
+    $assert_session->elementExists('xpath', $title_field_xpath)->setValue($host_title);
+    $page->pressButton('Save');
+
+    $assert_session->pageTextContains("$host_title has been created.");
+    $assert_session->pageTextNotContains('field is required');
+
+    $host_node = $this->drupalGetNodeByTitle($host_title);
+    $this->assertNotNull($host_node);
+    $this->assertTrue($host_node->get('single')->isEmpty());
+  }
+
+  /**
+   * Tests simple widget: optional IEF with filled fields saves entity.
+   */
+  public function testOptionalSimpleIefFilledSubmission() {
+    $assert_session = $this->assertSession();
+    $page = $this->getSession()->getPage();
+    $this->setupOptionalSimpleIef();
+
+    $this->drupalGet('node/add/ief_simple_single');
+
+    $title_field_xpath = $this->getXpathForNthInputByLabelText('Title', 1);
+    $nested_title_field_xpath = $this->getXpathForNthInputByLabelText('Title', 2);
+    $positive_int_field_xpath = $this->getXpathForNthInputByLabelText('Positive int', 1);
+
+    $host_title = 'Host with filled IEF';
+    $child_title = 'Child entity';
+    $assert_session->elementExists('xpath', $title_field_xpath)->setValue($host_title);
+    $assert_session->elementExists('xpath', $nested_title_field_xpath)->setValue($child_title);
+    $assert_session->elementExists('xpath', $positive_int_field_xpath)->setValue('5');
+    $page->pressButton('Save');
+
+    $assert_session->pageTextContains("$host_title has been created.");
+
+    $host_node = $this->drupalGetNodeByTitle($host_title);
+    $this->assertNotNull($host_node);
+    $this->assertFalse($host_node->get('single')->isEmpty());
+
+    $child_node = $host_node->get('single')->entity;
+    $this->assertNotNull($child_node);
+    $this->assertEquals($child_title, $child_node->label());
+    $this->assertEquals('5', $child_node->get('positive_int')->value);
+  }
+
+  /**
+   * Tests complex widget: optional IEF with no entities added saves.
+   */
+  public function testOptionalComplexIefNoEntitiesAdded() {
+    $assert_session = $this->assertSession();
+    $page = $this->getSession()->getPage();
+
+    $field_config = $this->fieldConfigStorage->load('node.ief_test_complex.multi');
+    $field_config->setRequired(FALSE);
+    $field_config->save();
+
+    $this->drupalGet('node/add/ief_test_complex');
+
+    $title_field_xpath = $this->getXpathForNthInputByLabelText('Title', 1);
+    $host_title = 'Complex host no IEF entities';
+    $assert_session->elementExists('xpath', $title_field_xpath)->setValue($host_title);
+    $page->pressButton('Save');
+
+    $assert_session->pageTextContains("$host_title has been created.");
+
+    $host_node = $this->drupalGetNodeByTitle($host_title);
+    $this->assertNotNull($host_node);
+    $this->assertTrue($host_node->get('multi')->isEmpty());
+  }
+
+  /**
+   * Tests partial fill: non-empty entity still validates required fields.
+   */
+  public function testOptionalSimpleIefPartialFillShowsError() {
+    $assert_session = $this->assertSession();
+    $page = $this->getSession()->getPage();
+    $this->setupOptionalSimpleIef();
+
+    $this->drupalGet('node/add/ief_simple_single');
+
+    $title_field_xpath = $this->getXpathForNthInputByLabelText('Title', 1);
+    $positive_int_field_xpath = $this->getXpathForNthInputByLabelText('Positive int', 1);
+
+    $host_title = 'Host with partial IEF';
+    $assert_session->elementExists('xpath', $title_field_xpath)->setValue($host_title);
+    $assert_session->elementExists('xpath', $positive_int_field_xpath)->setValue('5');
+    $page->pressButton('Save');
+
+    $assert_session->addressEquals('node/add/ief_simple_single');
+    $assert_session->pageTextNotContains('has been created.');
+    $this->assertNoNodeByTitle($host_title);
+  }
+
+  /**
+   * Tests that IEF child fields have no required attribute when optional.
+   */
+  public function testOptionalIefFieldsNotRequired() {
+    $assert_session = $this->assertSession();
+    $this->setupOptionalSimpleIef();
+
+    $this->drupalGet('node/add/ief_simple_single');
+
+    $host_title_element = $assert_session->elementExists('css', '#edit-title-0-value');
+    $this->assertTrue($host_title_element->hasAttribute('required'));
+
+    $ief_title = $assert_session->elementExists('css', '#edit-single-0-inline-entity-form-title-0-value');
+    $this->assertFalse($ief_title->hasAttribute('required'));
+
+    $ief_int = $assert_session->elementExists('css', '#edit-single-0-inline-entity-form-positive-int-0-value');
+    $this->assertFalse($ief_int->hasAttribute('required'));
+  }
+
+}
