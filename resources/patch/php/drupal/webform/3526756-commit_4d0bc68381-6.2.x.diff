 namespace Drupal\webform\Element;
 
+use Drupal\Component\Serialization\Exception\InvalidDataTypeException;
 use Drupal\Core\Form\FormStateInterface;
 use Drupal\Core\Render\Element\FormElement;
 use Drupal\Core\Serialization\Yaml;
@@ -177,7 +178,20 @@ class WebformElementAttributes extends FormElement {
     }
 
     if (!empty($values['attributes'])) {
-      $attributes += Yaml::decode($values['attributes']);
+      $decoded = [];
+      // The YAML string might be invalid, or the decoded value can be just a
+      // string. But here, it is enough to suppress the exception thrown by the
+      // YAML decoder, because the "webform_codemirror" form element will
+      // perform the validation if it is configured so.
+      try {
+        $decoded = Yaml::decode($values['attributes']);
+      }
+      catch (InvalidDataTypeException) {
+      }
+
+      if (is_array($decoded)) {
+        $attributes += $decoded;
+      }
     }
 
     $form_state->setValueForElement($element['class'], NULL);
