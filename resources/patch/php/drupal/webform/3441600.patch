From 17de1914e1eac6f0c81b4284615ef7ef4cef309d Mon Sep 17 00:00:00 2001
From: huzooka <huzooka@281301.no-reply.drupal.org>
Date: Wed, 17 Apr 2024 18:27:05 +0200
Subject: [PATCH] Issue #3441600: Webform might create invalid link renderable
 arrays on submission list

---
 src/Plugin/WebformElement/Url.php         | 5 ++++-
 src/Plugin/WebformElement/WebformLink.php | 5 ++++-
 2 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/src/Plugin/WebformElement/Url.php b/src/Plugin/WebformElement/Url.php
index 4ba81f756..3aa94a7dd 100644
--- a/src/Plugin/WebformElement/Url.php
+++ b/src/Plugin/WebformElement/Url.php
@@ -2,6 +2,7 @@
 
 namespace Drupal\webform\Plugin\WebformElement;
 
+use Drupal\Core\Url as CoreUrl;
 use Drupal\webform\WebformSubmissionInterface;
 use Symfony\Component\DependencyInjection\ContainerInterface;
 
@@ -62,7 +63,9 @@ class Url extends TextBase {
         return [
           '#type' => 'link',
           '#title' => $value,
-          '#url' => $this->pathValidator->getUrlIfValid($value),
+          // Url might be invalid if webform submission wasn't validated, e.g. if
+          // it was saved as a draft.
+          '#url' => $this->pathValidator->getUrlIfValid($value) ?: new CoreUrl('<nolink>'),
         ];
 
       default:
diff --git a/src/Plugin/WebformElement/WebformLink.php b/src/Plugin/WebformElement/WebformLink.php
index 7a43f9fbe..b3929c5e7 100644
--- a/src/Plugin/WebformElement/WebformLink.php
+++ b/src/Plugin/WebformElement/WebformLink.php
@@ -3,6 +3,7 @@
 namespace Drupal\webform\Plugin\WebformElement;
 
 use Drupal\Component\Render\FormattableMarkup;
+use Drupal\Core\Url;
 use Drupal\webform\WebformSubmissionInterface;
 use Symfony\Component\DependencyInjection\ContainerInterface;
 
@@ -61,7 +62,9 @@ class WebformLink extends WebformCompositeBase {
       'link' => [
         '#type' => 'link',
         '#title' => $value['title'] ?: $value['url'],
-        '#url' => $this->pathValidator->getUrlIfValid($value['url']),
+        // Url might be invalid if webform submission wasn't validated, e.g. if
+        // it was saved as a draft.
+        '#url' => $this->pathValidator->getUrlIfValid($value['url']) ?: new Url('<nolink>'),
       ],
     ];
   }
