+  /**
+   * Test error message if the attributes YAML string is invalid.
+   *
+   * @param string $main_property
+   *   Name of the main property which has a YAML attributes input.
+   * @param string $element_title
+   *   Human label of the main property.
+   *
+   * @dataProvider providerTestInvalidYaml
+   */
+  public function testInvalidElementAttributesValidation(
+    string $main_property,
+    string $element_title,
+  ): void {
+    $moduleInstaller = \Drupal::service('module_installer');
+    $moduleInstaller->install(['webform_ui']);
+    $adminAccount = $this->createUser(['administer webform']);
+    $this->drupalLogin($adminAccount);
+    $this->drupalGet('admin/structure/webform/manage/contact/element/message/edit');
+    $this->assertSession()->statusCodeEquals(200);
+
+    $this->assertSession()->pageTextContains("$element_title custom attributes (YAML)");
+
+    $this->submitForm(
+      [
+        "properties[$main_property][attributes]" => 'invalid: YAML: string',
+      ],
+      'Save',
+    );
+
+    // We shouldn't get any exception, but instead we should see the actual
+    // validation error message.
+    $this->assertSession()->statusCodeEquals(200);
+    $this->assertSession()->elementTextContains('css', '[role="alert"]', 'Error message');
+    /* @see \Drupal\webform\Element\WebformElementAttributes::processWebformElementAttributes() */
+    $this->assertSession()->pageTextContains("$element_title custom attributes (YAML) is not valid.");
+  }
+
+  /**
+   * Data provider for ::testInvalidElementAttributesValidation().
+   *
+   * @return array[]
+   *   The test cases.
+   */
+  public static function providerTestInvalidYaml(): array {
+    return [
+      'attributes' => ['attributes', 'Element'],
+      'wrapper_attributes' => ['wrapper_attributes', 'Wrapper'],
+    ];
+  }
+
 }
