@@ -0,0 +1,72 @@
+<?php
+
+/**
+ * @file
+ * Post update function for Meta Entity.
+ */
+
+declare(strict_types=1);
+
+use Drupal\Core\Entity\TranslatableInterface;
+use Drupal\Core\Site\Settings;
+
+/**
+ * Updates meta entities to make them match their target entity language.
+ */
+function meta_entity_post_update_8002(array &$sandbox) {
+  $metaEntityStorage = \Drupal::entityTypeManager()->getStorage('meta_entity');
+  $metaEntityType = \Drupal::entityTypeManager()->getDefinition('meta_entity');
+  $db = \Drupal::database();
+  if (!isset($sandbox['to_be_processed'])) {
+    $sandbox['to_be_processed'] = $metaEntityStorage->getQuery()->accessCheck(FALSE)->execute();
+    natsort($sandbox['to_be_processed']);
+    $sandbox['count_total'] = count($sandbox['to_be_processed']);
+    $sandbox['count_processed'] = 0;
+    $sandbox['last_percentage'] = 0;
+    $sandbox['entity_tables'] = array_filter([
+      $metaEntityStorage->getBaseTable(),
+      $metaEntityStorage->getDataTable(),
+      $metaEntityStorage->getRevisionTable(),
+      $metaEntityStorage->getRevisionDataTable(),
+    ]);
+    $sandbox['field_tables'] = array_diff(
+      $metaEntityStorage->getTableMapping()->getTableNames(),
+      $sandbox['entity_tables'],
+    );
+  }
+
+  $idsToProcess = array_splice($sandbox['to_be_processed'], 0, Settings::get('entity_update_batch_size') ?? 50);
+  $updatesPerLangcode = [];
+
+  foreach ($metaEntityStorage->loadMultiple($idsToProcess) as $metaEntity) {
+    $target = $metaEntity->get('target')->entity;
+    if (!$target instanceof TranslatableInterface) {
+      continue;
+    }
+    $updatesPerLangcode[$target->language()->getId()][] = $metaEntity->id();
+  }
+
+  foreach ($updatesPerLangcode as $langcode => $metaIds) {
+    foreach ($sandbox['entity_tables'] as $table) {
+      $db->update($table)
+        ->fields(['langcode' => $langcode])
+        ->condition('id', $metaIds, 'IN')
+        ->execute();
+    }
+
+    foreach ($sandbox['field_tables'] as $table) {
+      $db->update($table)
+        ->fields(['langcode' => $langcode])
+        ->condition('entity_id', $metaIds, 'IN')
+        ->execute();
+    }
+  }
+  $sandbox['count_processed'] += count($idsToProcess);
+  $sandbox['#finished'] = $sandbox['count_processed'] / $sandbox['count_total'];
+  $percentage = floor($sandbox['#finished'] * 100);
+
+  if ($percentage && $sandbox['last_percentage'] <> $percentage) {
+    $sandbox['last_percentage'] = $percentage;
+    return sprintf('Meta entity language code update progress: %s%%', $percentage);
+  }
+}
