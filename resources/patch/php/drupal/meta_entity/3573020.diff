index 0000000000000000000000000000000000000000..a87dfbb995e0d4189f9520fb8a17e9a07c293830
--- /dev/null
+++ b/tests/src/Functional/Update/TranslatableMetaEntityUpdateTest.php
@@ -0,0 +1,85 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\meta_entity\Functional\Update;
+
+use Drupal\Core\Database\Database;
+use Drupal\FunctionalTests\Update\UpdatePathTestBase;
+use Drupal\meta_entity\Entity\MetaEntity;
+
+/**
+ * Tests definition update to make Meta entities translatable.
+ */
+class TranslatableMetaEntityUpdateTest extends UpdatePathTestBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setDatabaseDumpFiles(): void {
+    $fixtureDir = dirname(__FILE__, 4) . '/fixtures/translatable-update/';
+
+    $this->databaseDumpFiles[] = DRUPAL_ROOT . '/core/modules/system/tests/fixtures/update/drupal-10.3.0.filled.standard.php.gz';
+    $this->databaseDumpFiles[] = $fixtureDir . 'cache_meta_entity.repository.php';
+    $this->databaseDumpFiles[] = $fixtureDir . 'config.php';
+    $this->databaseDumpFiles[] = $fixtureDir . 'key_value.php';
+    $this->databaseDumpFiles[] = $fixtureDir . 'meta_entity.php';
+    $this->databaseDumpFiles[] = $fixtureDir . 'meta_entity__field_special_number.php';
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function doInstall(): void {
+    parent::doInstall();
+
+    // In core.extension config, meta_entity and dynamic_entity_reference should
+    // be marked as installed.
+    $connection = Database::getConnection();
+    $coreExtensionRaw = $connection->select('config', 'c')
+      ->condition('collection', '')
+      ->condition('name', 'core.extension')
+      ->fields('c', ['data'])
+      ->execute()
+      ->fetchField();
+    $coreExtension = unserialize($coreExtensionRaw, ['allowed_classes' => FALSE]);
+    $coreExtension['module'] += [
+      'dynamic_entity_reference' => 0,
+      'meta_entity' => 0,
+    ];
+    $connection->update('config')
+      ->condition('collection', '')
+      ->condition('name', 'core.extension')
+      ->fields(['data' => serialize($coreExtension)])
+      ->execute();
+  }
+
+  /**
+   * Check whether entity field definitions are up-to-date.
+   *
+   * This is done automatically by UpdatePathTestTrait since
+   * static::checkEntityFieldDefinitionUpdates is TRUE.
+   * UpdatePathTestTrait::runUpdates() makes sure that updates are fine and it
+   * also verifies that the entity schema is intact.
+   */
+  public function testUpdatedSite(): void {
+    $this->runUpdates();
+
+    $this->assertEquals(
+      [
+        'id' => [['value' => 1]],
+        'uuid' => [['value' => 'be8510bb-b55e-4e41-9da8-4daf7cc7aeab']],
+        'langcode' => [['value' => 'en']],
+        'type' => [['target_id' => 'example']],
+        'label' => [['value' => 'Test title content item (Example)']],
+        'target' => [['target_id' => '8', 'target_type' => 'node']],
+        'created' => [['value' => 1770846377]],
+        'changed' => [['value' => 1770846377]],
+        'default_langcode' => [['value' => 1]],
+        'field_special_number' => [['value' => 3]],
+      ],
+      MetaEntity::load(1)->toArray(),
+    );
+  }
+
+}
