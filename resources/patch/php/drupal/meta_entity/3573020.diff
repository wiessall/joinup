+/**
+ * Install new base fields for meta entities to make them translatable.
+ */
+function meta_entity_update_8002(): void {
+  $entityDefinitionUpdateManager = \Drupal::service('entity.definition_update_manager');
+  assert($entityDefinitionUpdateManager instanceof EntityDefinitionUpdateManagerInterface);
+  $metaFieldStorageDefinitions = \Drupal::service('entity_field.manager')->getFieldStorageDefinitions('meta_entity');
+
+  $defaultLangcodeDefinition = $metaFieldStorageDefinitions['default_langcode'];
+  assert($defaultLangcodeDefinition instanceof BaseFieldDefinition);
+  $defaultLangcodeDefinition->setInitialValue(TRUE);
+  $entityDefinitionUpdateManager->installFieldStorageDefinition('default_langcode', 'meta_entity', 'meta_entity', $defaultLangcodeDefinition);
+
+  $langcodeDefinition = $metaFieldStorageDefinitions['langcode'];
+  assert($langcodeDefinition instanceof BaseFieldDefinition);
+  // By default, set language code to undefined since this is how field config
+  // values are stored.
+  $langcodeDefinition->setInitialValue(LanguageInterface::LANGCODE_NOT_SPECIFIED);
+  $entityDefinitionUpdateManager->installFieldStorageDefinition('langcode', 'meta_entity', 'meta_entity', $langcodeDefinition);
+}
+
+/**
+ * Updates storage schema of meta entities.
+ */
+function meta_entity_update_8003(array &$sandbox) {
+  if (!isset($sandbox['last_percentage'])) {
+    $sandbox['last_percentage'] = 0;
+  }
+
+  $entityDefinitionUpdateManager = \Drupal::service('entity.definition_update_manager');
+  assert($entityDefinitionUpdateManager instanceof EntityDefinitionUpdateManagerInterface);
+  $entityTypeManager = \Drupal::entityTypeManager();
+  $metaFieldStorageDefinitions = \Drupal::service('entity_field.manager')->getFieldStorageDefinitions('meta_entity');
+
+  $entityDefinitionUpdateManager->updateFieldableEntityType($entityTypeManager->getDefinition('meta_entity'), $metaFieldStorageDefinitions, $sandbox);
+
+  $percentage = floor($sandbox['#finished'] * 100);
+  if ($percentage && $sandbox['last_percentage'] <> $percentage) {
+    $sandbox['last_percentage'] = $percentage;
+    return t('Meta entity schema conversion progress: @percentage%', ['@percentage' => $percentage]);
+  }
+}
+
+/**
+ * Update Views' view displays to match meta entity listings to the new schema.
+ */
+function meta_entity_update_8004(): void {
+  if (!\Drupal::moduleHandler()->moduleExists('views')) {
+    return;
+  }
+  $componentTypes = [
+    'plugin.manager.views.field' => 'fields',
+    'plugin.manager.views.sort' => 'sorts',
+    'plugin.manager.views.filter' => 'filters',
+    'plugin.manager.views.argument' => 'arguments',
+    'plugin.manager.views.relationship' => 'relationships',
+  ];
+  foreach (Views::getAllViews() as $view) {
+    $displays = $view->get('display');
+    $baseIsMetaEntity = $view->get('base_table') === 'meta_entity';
+    $saveIsNeeded = $baseIsMetaEntity;
+    if ($baseIsMetaEntity) {
+      $view->set('base_table', 'meta_entity_field_data');
+    }
+    foreach ($displays as $displayId => $displayData) {
+      $displayOptions = $displayData['display_options'];
+      foreach ($componentTypes as $componentHandlerId => $componentType) {
+        if (!array_key_exists($componentType, $displayOptions)) {
+          continue;
+        }
+        $componentManager = \Drupal::service($componentHandlerId);
+        \assert($componentManager instanceof ViewsHandlerManager);
+
+        foreach ($displayOptions[$componentType] as $component => $componentData) {
+          if (!array_key_exists('table', $componentData) || $componentData['table'] !== 'meta_entity') {
+            continue;
+          }
+
+          $originalHandler = $componentManager->getHandler($componentData);
+          if (!$originalHandler->broken()) {
+            continue;
+          }
+
+          $componentData['table'] = 'meta_entity_field_data';
+          $newHandler = $componentManager->getHandler($componentData);
+          if ($newHandler->broken()) {
+            // We cannot fix this config.
+            continue;
+          }
+          $displays[$displayId]['display_options'][$componentType][$component] = $componentData;
+          $saveIsNeeded = TRUE;
+        }
+      }
+    }
+    if ($saveIsNeeded) {
+      $view->set('display', $displays)->save();
+    }
+  }
+}
