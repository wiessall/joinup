diff --git a/tests/src/Kernel/LinkcheckerPageEntityFieldsTest.php b/tests/src/Kernel/LinkcheckerPageEntityFieldsTest.php
new file mode 100644
index 0000000000000000000000000000000000000000..d6f820f4aa48b609623ede85f5aba8a7db130acc
--- /dev/null
+++ b/tests/src/Kernel/LinkcheckerPageEntityFieldsTest.php
@@ -0,0 +1,298 @@
+<?php
+
+namespace Drupal\Tests\linkchecker\Kernel;
+
+use Drupal\Core\Entity\EntityInterface;
+use Drupal\Core\Render\RenderContext;
+use Drupal\KernelTests\KernelTestBase;
+use Drupal\language\Entity\ConfigurableLanguage;
+use Drupal\linkchecker\Entity\LinkCheckerLink;
+use Drupal\linkchecker\Plugin\views\field\LinkcheckerLinkPageEntityLabel;
+use Drupal\linkchecker\Plugin\views\field\LinkcheckerLinkPageEntityLink;
+use Drupal\node\Entity\NodeType;
+use Drupal\paragraphs\Entity\Paragraph;
+use Drupal\paragraphs\Entity\ParagraphsType;
+use Drupal\Tests\node\Traits\NodeCreationTrait;
+use Drupal\user\RoleInterface;
+use Drupal\views\Entity\View;
+use Drupal\views\Views;
+use PHPUnit\Framework\Attributes\CoversClass;
+use PHPUnit\Framework\Attributes\Group;
+use PHPUnit\Framework\Attributes\RunTestsInSeparateProcesses;
+
+/**
+ * Tests the "Page entity label" and "Page entity link" Views fields.
+ *
+ * Both fields must resolve the root parent entity, even when the link lives
+ * inside one or more nested paragraphs.
+ *
+ * @group linkchecker
+ */
+#[Group('linkchecker')]
+#[CoversClass(LinkcheckerLinkPageEntityLabel::class)]
+#[CoversClass(LinkcheckerLinkPageEntityLink::class)]
+#[RunTestsInSeparateProcesses]
+class LinkcheckerPageEntityFieldsTest extends KernelTestBase {
+
+  use NodeCreationTrait;
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'system',
+    'user',
+    'field',
+    'filter',
+    'text',
+    'node',
+    'views',
+    'file',
+    'entity_reference_revisions',
+    'paragraphs',
+    'linkchecker',
+    'language',
+    'content_translation',
+  ];
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+    $this->installEntitySchema('user');
+    $this->installEntitySchema('node');
+    $this->installEntitySchema('paragraph');
+    $this->installEntitySchema('linkcheckerlink');
+    $this->installConfig(['user', 'field', 'node', 'filter', 'paragraphs', 'linkchecker']);
+    $this->installSchema('linkchecker', 'linkchecker_index');
+    $this->installSchema('node', 'node_access');
+
+    // The "Page entity link" field checks view access on the canonical node
+    // URL before rendering it.
+    user_role_grant_permissions(RoleInterface::ANONYMOUS_ID, ['access content']);
+
+    NodeType::create(['type' => 'page', 'name' => 'Page'])->save();
+    ParagraphsType::create(['id' => 'test', 'label' => 'Test'])->save();
+    $this->createFieldsView();
+  }
+
+  /**
+   * A link on a node reports the node label and links to the node.
+   */
+  public function testNode() {
+    $node = $this->createNode(['type' => 'page', 'title' => 'Root page']);
+
+    $this->assertFieldsForLinkOn($node, $node);
+  }
+
+  /**
+   * A link on a paragraph reports its parent node label and links to it.
+   */
+  public function testParagraph() {
+    $node = $this->createNode(['type' => 'page', 'title' => 'Root page']);
+    $paragraph = $this->paragraphIn($node);
+
+    $this->assertFieldsForLinkOn($paragraph, $node);
+  }
+
+  /**
+   * A link on a nested paragraph reports the root node label.
+   */
+  public function testNestedParagraph() {
+    $node = $this->createNode(['type' => 'page', 'title' => 'Root page']);
+    $nested = $this->paragraphIn($this->paragraphIn($node));
+
+    $this->assertFieldsForLinkOn($nested, $node);
+  }
+
+  /**
+   * A link recorded against an existing translation resolves to it.
+   */
+  public function testNodeTranslation() {
+    $this->enableNodeTranslation();
+    $node = $this->createNode(['type' => 'page', 'title' => 'Root page']);
+    $node->addTranslation('es', ['title' => 'Spanish root page'])->save();
+
+    $this->assertFieldsForLinkOn($node, $node->getTranslation('es'), 'es');
+  }
+
+  /**
+   * A link recorded against a missing translation falls back to the default.
+   */
+  public function testNodeTranslationFallback() {
+    $this->enableNodeTranslation();
+    $node = $this->createNode(['type' => 'page', 'title' => 'Root page']);
+
+    $this->assertFieldsForLinkOn($node, $node, 'es');
+  }
+
+  /**
+   * A link on a translated paragraph resolves to the node's translation.
+   */
+  public function testTranslatedParagraph() {
+    $this->enableNodeTranslation();
+    $node = $this->createNode(['type' => 'page', 'title' => 'Root page']);
+    $node->addTranslation('es', ['title' => 'Spanish root page'])->save();
+    $paragraph = $this->paragraphIn($node, 'es');
+
+    $this->assertFieldsForLinkOn(
+      $paragraph->getTranslation('es'),
+      $node->getTranslation('es'),
+      'es'
+    );
+  }
+
+  /**
+   * A link on an untranslated paragraph falls back to the node's default.
+   */
+  public function testUntranslatedParagraphInTranslatedNode() {
+    $this->enableNodeTranslation();
+    $node = $this->createNode(['type' => 'page', 'title' => 'Root page']);
+    $node->addTranslation('es', ['title' => 'Spanish root page'])->save();
+    $paragraph = $this->paragraphIn($node);
+
+    // The paragraph has no 'es' translation, so Paragraph::getParentEntity()
+    // resolves the node using the paragraph's default (en) langcode.
+    $this->assertFieldsForLinkOn($paragraph, $node, 'es');
+  }
+
+  /**
+   * A link on a nested translated paragraph resolves to the node's translation.
+   */
+  public function testTranslatedNestedParagraph() {
+    $this->enableNodeTranslation();
+    $node = $this->createNode(['type' => 'page', 'title' => 'Root page']);
+    $node->addTranslation('es', ['title' => 'Spanish root page'])->save();
+    $nested = $this->paragraphIn($this->paragraphIn($node, 'es'), 'es');
+
+    $this->assertFieldsForLinkOn(
+      $nested->getTranslation('es'),
+      $node->getTranslation('es'),
+      'es'
+    );
+  }
+
+  /**
+   * Enables content translation for the 'page' node bundle.
+   */
+  protected function enableNodeTranslation(): void {
+    ConfigurableLanguage::createFromLangcode('es')->save();
+    $this->container->get('content_translation.manager')->setEnabled('node', 'page', TRUE);
+  }
+
+  /**
+   * Creates a paragraph nested inside the given parent entity.
+   *
+   * @param \Drupal\Core\Entity\EntityInterface $parent
+   *   The parent entity.
+   * @param string|null $langcode
+   *   If given, an additional translation is added in this langcode.
+   */
+  protected function paragraphIn(EntityInterface $parent, ?string $langcode = NULL): Paragraph {
+    $paragraph = Paragraph::create(['type' => 'test']);
+    $paragraph->setParentEntity($parent, 'field_paragraphs');
+    if ($langcode !== NULL) {
+      $paragraph->addTranslation($langcode);
+    }
+    $paragraph->save();
+
+    return $paragraph;
+  }
+
+  /**
+   * Asserts both fields resolve to the given root entity for a link on it.
+   *
+   * @param \Drupal\Core\Entity\EntityInterface $entity
+   *   The entity the link was found on (a node or a paragraph).
+   * @param \Drupal\Core\Entity\EntityInterface $expectedRoot
+   *   The entity both fields are expected to resolve to.
+   * @param string $langcode
+   *   The langcode to record on the link's "entity_langcode" field.
+   */
+  protected function assertFieldsForLinkOn(EntityInterface $entity, EntityInterface $expectedRoot, string $langcode = 'en'): void {
+    $rendered = $this->renderFieldsForLinkOn($entity, $langcode);
+
+    $this->assertSame($expectedRoot->label(), $rendered['label'], 'The "Page entity label" field reports the root entity label.');
+    $this->assertStringContainsString(
+      $expectedRoot->toUrl()->toString(),
+      $rendered['link'],
+      'The "Page entity link" field links to the root entity.'
+    );
+  }
+
+  /**
+   * Renders both Page entity fields for a link pointing at the given entity.
+   *
+   * @param \Drupal\Core\Entity\EntityInterface $entity
+   *   The entity the link was found on.
+   * @param string $langcode
+   *   The langcode to record on the link's "entity_langcode" field.
+   *
+   * @return array
+   *   An associative array with a 'label' and a 'link' key, holding the
+   *   rendered output of each field.
+   */
+  protected function renderFieldsForLinkOn(EntityInterface $entity, string $langcode = 'en'): array {
+    LinkCheckerLink::create([
+      'url' => 'https://example.com/broken',
+      'parent_entity_type_id' => $entity->getEntityTypeId(),
+      'parent_entity_id' => $entity->id(),
+      'entity_field' => 'field_link',
+      'entity_langcode' => $langcode,
+    ])->save();
+
+    $view = Views::getView('test_page_entity_fields');
+    $view->execute();
+    $row = $view->result[0];
+
+    $renderer = $this->container->get('renderer');
+    $rendered = [];
+    foreach ([
+      'linkcheckerlink_page_entity_label' => 'label',
+      'linkcheckerlink_page_entity_link' => 'link',
+    ] as $field_id => $key) {
+      $build = $renderer->executeInRenderContext(new RenderContext(), function () use ($view, $row, $field_id) {
+        return $view->field[$field_id]->render($row);
+      });
+      $rendered[$key] = is_array($build) ? (string) $renderer->renderInIsolation($build) : (string) $build;
+    }
+
+    return $rendered;
+  }
+
+  /**
+   * Creates the view used to render the fields under test.
+   */
+  protected function createFieldsView() {
+    View::create([
+      'id' => 'test_page_entity_fields',
+      'base_table' => 'linkchecker_link',
+      'base_field' => 'lid',
+      'display' => [
+        'default' => [
+          'display_plugin' => 'default',
+          'id' => 'default',
+          'display_options' => [
+            'fields' => [
+              'linkcheckerlink_page_entity_label' => [
+                'id' => 'linkcheckerlink_page_entity_label',
+                'table' => 'linkchecker_link',
+                'field' => 'linkcheckerlink_page_entity_label',
+                'plugin_id' => 'linkcheckerlink_page_entity_label',
+              ],
+              'linkcheckerlink_page_entity_link' => [
+                'id' => 'linkcheckerlink_page_entity_link',
+                'table' => 'linkchecker_link',
+                'field' => 'linkcheckerlink_page_entity_link',
+                'plugin_id' => 'linkcheckerlink_page_entity_link',
+                'output_url_as_text' => TRUE,
+              ],
+            ],
+          ],
+        ],
+      ],
+    ])->save();
+  }
+
+}
