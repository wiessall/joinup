+  /**
+   * Tests how translations are parsed and extracted.
+   *
+   * @dataProvider providerTestTranslationExtraction
+   */
+  public function testTranslationExtraction(
+    array $linkCheckerConfig,
+    string $translationBody,
+    bool $saveTranslationSeparately,
+    array $expectedLinks,
+  ): void {
+    \Drupal::service(ModuleInstallerInterface::class)->install(['language']);
+    ConfigurableLanguage::createFromLangcode('hu')->save();
+    $config = $this->config('linkchecker.settings');
+    foreach ($linkCheckerConfig as $name => $value) {
+      $config->set($name, $value);
+    }
+    $config->save();
+    NodeType::create(['name' => 'Links', 'type' => 'links'])->save();
+    $this->createBodyField('node', 'links');
+    FieldConfig::load('node.links.body')
+      ->setThirdPartySetting('linkchecker', 'scan', TRUE)
+      ->setThirdPartySetting('linkchecker', 'extractor', 'html_link_extractor')
+      ->save();
+
+    $this->assertEmpty(LinkCheckerLink::loadMultiple());
+
+    $contentStorage = \Drupal::entityTypeManager()->getStorage('node');
+    $content = $contentStorage->create([
+      'title' => 'Test content',
+      'type' => 'links',
+      'body' => 'Some text, without any link.',
+    ]);
+    if ($saveTranslationSeparately) {
+      $content->save();
+      $content = $contentStorage->loadUnchanged($content->id());
+    }
+    $translation = $content->addTranslation('hu', [
+      'body' => $translationBody,
+    ] + $content->toArray());
+    if ($saveTranslationSeparately) {
+      $translation->save();
+    }
+    else {
+      $content->save();
+    }
+
+    $links = array_map(
+      fn (LinkCheckerLinkInterface $link) => $link->getUrl(),
+      LinkCheckerLink::loadMultiple(),
+    );
+    natsort($links);
+    $this->assertEquals($expectedLinks, array_values($links));
+  }
+
