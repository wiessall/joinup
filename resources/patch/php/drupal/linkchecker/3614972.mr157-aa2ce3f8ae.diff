+/**
+ * Add default setting for checking all entity translations.
+ */
+function linkchecker_post_update_add_default_check_translations_setting(): void {
+  $config = \Drupal::configFactory()->getEditable('linkchecker.settings');
+  if ($config->get('check_translations') !== NULL) {
+    return;
+  }
+
+  $config->set('check_translations', TRUE)->save();
+}
