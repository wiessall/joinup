+<?php
+
+namespace Drupal\Tests\linkchecker\Kernel;
+
+use Drupal\Core\Entity\EntityInterface;
+use Drupal\Core\Render\RenderContext;
+use Drupal\KernelTests\KernelTestBase;
+use Drupal\linkchecker\Entity\LinkCheckerLink;
+use Drupal\node\Entity\NodeType;
+use Drupal\paragraphs\Entity\Paragraph;
+use Drupal\paragraphs\Entity\ParagraphsType;
+use Drupal\Tests\node\Traits\NodeCreationTrait;
+use Drupal\views\Entity\View;
+use Drupal\views\Views;
+
+/**
+ * Tests the "Page entity label" Views field.
+ *
+ * The field must report the label of the root parent entity, even when the link
+ * lives inside one or more nested paragraphs (issue #3135654).
+ *
+ * @coversDefaultClass \Drupal\linkchecker\Plugin\views\field\LinkcheckerLinkPageEntityLabel
+ *
+ * @group linkchecker
+ */
+class LinkcheckerPageEntityLabelTest extends KernelTestBase {
+
+  use NodeCreationTrait;
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'system',
+    'user',
+    'field',
+    'filter',
+    'text',
+    'node',
+    'views',
+    'file',
+    'entity_reference_revisions',
+    'paragraphs',
+    'linkchecker',
+  ];
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+
+    // The {sequences} table was removed in Drupal 10.2.
+    if (version_compare(\Drupal::VERSION, '10.2', '<')) {
+      $this->installSchema('system', ['sequences']);
+    }
+    $this->installEntitySchema('user');
+    $this->installEntitySchema('node');
+    $this->installEntitySchema('paragraph');
+    $this->installEntitySchema('linkcheckerlink');
+    $this->installConfig(['field', 'node', 'filter', 'paragraphs', 'linkchecker']);
+    $this->installSchema('linkchecker', 'linkchecker_index');
+
+    NodeType::create(['type' => 'page', 'name' => 'Page'])->save();
+    ParagraphsType::create(['id' => 'test', 'label' => 'Test'])->save();
+    $this->createLabelView();
+  }
+
+  /**
+   * A link on a node reports the node label.
+   */
+  public function testNode() {
+    $node = $this->createNode(['type' => 'page', 'title' => 'Root page']);
+
+    $this->assertSame('Root page', $this->labelForLinkOn($node));
+  }
+
+  /**
+   * A link on a paragraph reports its parent node label.
+   */
+  public function testParagraph() {
+    $node = $this->createNode(['type' => 'page', 'title' => 'Root page']);
+    $paragraph = $this->paragraphIn($node);
+
+    $this->assertSame('Root page', $this->labelForLinkOn($paragraph));
+  }
+
+  /**
+   * A link on a nested paragraph reports the root node label (#3135654).
+   */
+  public function testNestedParagraph() {
+    $node = $this->createNode(['type' => 'page', 'title' => 'Root page']);
+    $nested = $this->paragraphIn($this->paragraphIn($node));
+
+    $this->assertSame('Root page', $this->labelForLinkOn($nested));
+  }
+
+  /**
+   * Creates a paragraph nested inside the given parent entity.
+   */
+  protected function paragraphIn(EntityInterface $parent): Paragraph {
+    $paragraph = Paragraph::create(['type' => 'test']);
+    $paragraph->setParentEntity($parent, 'field_paragraphs');
+    $paragraph->save();
+
+    return $paragraph;
+  }
+
+  /**
+   * Renders the "Page entity label" field for a link pointing at the entity.
+   */
+  protected function labelForLinkOn(EntityInterface $entity): string {
+    LinkCheckerLink::create([
+      'url' => 'https://example.com/broken',
+      'parent_entity_type_id' => $entity->getEntityTypeId(),
+      'parent_entity_id' => $entity->id(),
+      'entity_field' => 'field_link',
+      'entity_langcode' => 'en',
+    ])->save();
+
+    $view = Views::getView('test_page_entity_label');
+    $view->execute();
+    $field = $view->field['linkcheckerlink_page_entity_label'];
+    $row = $view->result[0];
+
+    return (string) $this->container->get('renderer')
+      ->executeInRenderContext(new RenderContext(), function () use ($field, $row) {
+        return $field->render($row);
+      });
+  }
+
+  /**
+   * Creates the view used to render the field under test.
+   */
+  protected function createLabelView() {
+    View::create([
+      'id' => 'test_page_entity_label',
+      'base_table' => 'linkchecker_link',
+      'base_field' => 'lid',
+      'display' => [
+        'default' => [
+          'display_plugin' => 'default',
+          'id' => 'default',
+          'display_options' => [
+            'fields' => [
+              'linkcheckerlink_page_entity_label' => [
+                'id' => 'linkcheckerlink_page_entity_label',
+                'table' => 'linkchecker_link',
+                'field' => 'linkcheckerlink_page_entity_label',
+                'plugin_id' => 'linkcheckerlink_page_entity_label',
+              ],
+            ],
+          ],
+        ],
+      ],
+    ])->save();
+  }
+
+}
