+  /**
+   * Tests that validation only applies to fields visible in the form display.
+   */
+  public function testEntityFormRequiredFieldValidation() {
+    $this->drupalCreateContentType(['type' => 'test_bundle', 'name' => 'Test Bundle']);
+
+    FieldStorageConfig::create([
+      'field_name' => 'field_required_text',
+      'entity_type' => 'node',
+      'type' => 'string',
+    ])->save();
+
+    FieldConfig::create([
+      'field_name' => 'field_required_text',
+      'entity_type' => 'node',
+      'bundle' => 'test_bundle',
+      'label' => 'Required text',
+      'required' => TRUE,
+    ])->save();
+
+    EntityFormMode::create([
+      'id' => 'node.entity_browser',
+      'label' => 'Entity Browser',
+      'targetEntityType' => 'node',
+    ])->save();
+
+    EntityFormDisplay::create([
+      'targetEntityType' => 'node',
+      'bundle' => 'test_bundle',
+      'mode' => 'entity_browser',
+      'status' => TRUE,
+    ])
+      ->setComponent('title', ['type' => 'string_textfield', 'weight' => 1])
+      ->setComponent('field_required_text', ['type' => 'string_textfield', 'weight' => 2])
+      ->save();
+
+    $account = $this->drupalCreateUser([
+      'access entity_browser_test_entity_form entity browser pages',
+      'create test_bundle content',
+      'access content',
+    ]);
+    $this->drupalLogin($account);
+
+    /** @var \Drupal\entity_browser\EntityBrowserInterface $browser */
+    $browser = $this->container->get('entity_type.manager')
+      ->getStorage('entity_browser')
+      ->load('entity_browser_test_entity_form');
+
+    $browser->setWidgetSelector('tabs');
+    $widget = $browser->getWidget('9c6ee4c0-4642-4203-b4bd-ec0bad068ad3');
+    $config = $widget->getConfiguration();
+    $config['settings']['entity_type'] = 'node';
+    $config['settings']['bundle'] = 'test_bundle';
+    $config['settings']['form_mode'] = 'entity_browser';
+    $widget->setConfiguration($config);
+    $browser->save();
+
+    $this->drupalGet('entity-browser/iframe/entity_browser_test_entity_form');
+
+    $this->getSession()->getPage()->fillField('inline_entity_form[title][0][value]', 'Test node');
+    $this->assertSession()->buttonExists('Save entity')->press();
+    $this->assertSession()->waitForButton('Save entity');
+
+    $this->assertSession()->pageTextContains('Required text');
+    $this->assertSession()->pageTextNotContains('website encountered an unexpected error');
+    $this->assertSession()->pageTextNotContains('SQLSTATE');
+
+    $nodes = $this->container->get('entity_type.manager')
+      ->getStorage('node')
+      ->loadByProperties(['type' => 'test_bundle']);
+    $this->assertEmpty($nodes, 'The entity was not saved because a displayed required field is empty.');
+
+    EntityFormDisplay::load('node.test_bundle.entity_browser')
+      ->removeComponent('field_required_text')
+      ->save();
+
+    $this->drupalGet('entity-browser/iframe/entity_browser_test_entity_form');
+
+    $this->getSession()->getPage()->fillField('inline_entity_form[title][0][value]', 'Test node hidden');
+    $this->assertSession()->buttonExists('Save entity')->press();
+    $this->assertSession()->waitForButton('Save entity');
+
+    $this->assertSession()->pageTextNotContains('website encountered an unexpected error');
+    $this->assertSession()->pageTextNotContains('SQLSTATE');
+
+    $nodes = $this->container->get('entity_type.manager')
+      ->getStorage('node')
+      ->loadByProperties(['type' => 'test_bundle']);
+    $this->assertCount(1, $nodes, 'The entity was saved because hidden required fields are not validated.');
+  }
