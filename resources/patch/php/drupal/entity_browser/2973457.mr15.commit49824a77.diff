+    $field_storage->save();
+
+    $field = FieldConfig::create([
+      'field_name' => 'field_lycanthrope',
+      'entity_type' => 'node',
+      'bundle' => 'article',
+      'label' => 'Loup Garou',
+      'settings' => [],
+    ]);
+    $field->save();
+
+    $this->drupalGet('/admin/structure/types/manage/article/form-display');
+    // Drag to enabled.
