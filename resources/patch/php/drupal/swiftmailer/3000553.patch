diff --git a/tests/src/Functional/SwiftMailerDrushTest.php b/tests/src/Functional/SwiftMailerDrushTest.php
new file mode 100644
index 0000000..d1c83ad
--- /dev/null
+++ b/tests/src/Functional/SwiftMailerDrushTest.php
@@ -0,0 +1,89 @@
+<?php
+
+namespace Drupal\Tests\swiftmailer\Functional;
+
+use Drupal\Core\Site\Settings;
+use Drupal\swiftmailer_test\SwiftMailerDrupalStateLogger;
+use Drupal\Tests\BrowserTestBase;
+use Drush\TestTraits\DrushTestTrait;
+
+/**
+ * Tests Swift Mailer Drush integration.
+ *
+ * @group swiftmailer
+ *
+ * @coversDefaultClass \Drupal\swiftmailer\Commands\SwiftMailerCommands
+ */
+class SwiftMailerDrushTest extends BrowserTestBase {
+
+  use DrushTestTrait;
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'swiftmailer',
+    'swiftmailer_test',
+  ];
+
+  /**
+   * {@inheritdoc}
+   */
+  protected $defaultTheme = 'stark';
+
+  /**
+   * Tests the 'swiftmailer:send-spool' command.
+   *
+   * @covers ::sendSpool
+   */
+  public function testSendSpool() {
+    $logger = new SwiftMailerDrupalStateLogger();
+
+    /** @var \Drupal\Core\Mail\MailManagerInterface $mailer */
+    $mailer = \Drupal::service('plugin.manager.mail');
+    /** @var \Drupal\Core\File\FileSystemInterface $file_system */
+    $file_system = \Drupal::service('file_system');
+
+    $spool_dir = Settings::get('file_temp_path') . '/swiftmailer/spool';
+    $file_system->mkdir($spool_dir, NULL, TRUE);
+    $this->assertDirectoryExists($spool_dir);
+
+    $this->config('mailsystem.settings')
+      ->set('modules.swiftmailer_test.none.formatter', 'swiftmailer')
+      ->set('modules.swiftmailer_test.none.sender', 'swiftmailer')
+      ->save();
+    $this->config('swiftmailer.transport')
+      ->set('transport', 'spool')
+      ->set('spool_directory', $spool_dir)
+      ->save();
+
+    // Spool the email. Use 'swiftmailer_test' as module in order to add the
+    // SwiftMailerDrupalStateLogger listener.
+    // @see swiftmailer_test_swiftmailer_alter()
+    // @see \Drupal\swiftmailer_test\SwiftMailerDrupalStateLogger
+    $mailer->mail('swiftmailer_test', 'drush', 'test@example.com', \Drupal::languageManager()->getDefaultLanguage()->getId());
+
+    // Check that the message has been spooled.
+    $spooled_messages = $file_system->scanDirectory($spool_dir, '/\.message$/');
+    $this->assertCount(1, $spooled_messages);
+    /** @var \Swift_Message $message */
+    $message = unserialize(file_get_contents(key($spooled_messages)));
+    $this->assertSame(['test@example.com' => NULL], $message->getTo());
+
+    // Send spooled emails using Drush.
+    $this->drush('swiftmailer:send-spool', ['null'], ['yes' => NULL]);
+
+    // Check that the spooled emails were sent and the directory was emptied.
+    $spooled_messages = $file_system->scanDirectory($spool_dir, '/\.message$/');
+    $this->assertEmpty($spooled_messages);
+
+    // Check that two events were logged: beforeSendPerformed and sendPerformed.
+    $logged_events = $logger->dump();
+    $this->assertCount(2, $logged_events);
+    $this->assertSame('beforeSendPerformed', $logged_events[0]['method']);
+    $this->assertSame(['test@example.com' => NULL], $logged_events[0]['to']);
+    $this->assertSame('sendPerformed', $logged_events[1]['method']);
+    $this->assertSame(['test@example.com' => NULL], $logged_events[1]['to']);
+  }
+
+}
-- 
