index 0000000..76e4a58
--- /dev/null
+++ b/src/Commands/SwiftMailerCommands.php
@@ -0,0 +1,63 @@
+<?php
+
+namespace Drupal\swiftmailer\Commands;
+
+use Drupal\swiftmailer\TransportFactoryInterface;
+use Drush\Commands\DrushCommands;
+
+/**
+ * Provides Drush integration.
+ */
+class SwiftMailerCommands extends DrushCommands {
+
+  /**
+   * A list of transport systems that can deliver mails from the spool.
+   *
+   * @var string[]
+   */
+  protected static $validtransports = [
+    SWIFTMAILER_TRANSPORT_SMTP,
+    SWIFTMAILER_TRANSPORT_SENDMAIL,
+    SWIFTMAILER_TRANSPORT_NULL,
+  ];
+
+  /**
+   * The transport factory service.
+   *
+   * @var \Drupal\swiftmailer\TransportFactoryInterface
+   */
+  protected $transportFactory;
+
+  /**
+   * Instantiates a new SwiftmailerCommands object.
+   *
+   * @param \Drupal\swiftmailer\TransportFactoryInterface $transport_factory
+   *   The transport factory service.
+   */
+  public function __construct(TransportFactoryInterface $transport_factory) {
+    parent::__construct();
+    $this->transportFactory = $transport_factory;
+  }
+
+  /**
+   * Sends out the spooled emails.
+   *
+   * @param string $transport
+   *   The transport method to use. Valid values: "smtp", "sendmail" and "null".
+   *
+   * @command swiftmailer:send-spool
+   *
+   * @usage drush swiftmailer:send-spool smtp
+   *   Send out spooled emails using the smtp transport type.
+   */
+  public function sendSpool(string $transport) {
+    if (!in_array($transport, self::$validtransports, TRUE)) {
+      throw new \InvalidArgumentException(dt('Invalid transport type. Valid types are %types.', ['%types' => implode(', ', self::$validtransports)]));
+    }
+
+    $spool_transport = $this->transportFactory->getTransport(SWIFTMAILER_TRANSPORT_SPOOL);
+    $swift_transport = $this->transportFactory->getTransport($transport);
+    $spool_transport->getSpool()->flushQueue($swift_transport);
+  }
+
+}
