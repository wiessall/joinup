diff --git a/tests/src/Traits/PrivateMessageTestTrait.php b/tests/src/Traits/PrivateMessageTestTrait.php
new file mode 100644
index 0000000000000000000000000000000000000000..c50d58469340bbb78f5975614b9fc3f91a87eea6
--- /dev/null
+++ b/tests/src/Traits/PrivateMessageTestTrait.php
@@ -0,0 +1,64 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\private_message\Traits;
+
+use Drupal\Tests\user\Traits\UserCreationTrait;
+use Drupal\field\Entity\FieldConfig;
+use Drupal\field\Entity\FieldStorageConfig;
+
+/**
+ * Reusable test code.
+ */
+trait PrivateMessageTestTrait {
+
+  use UserCreationTrait;
+
+  /**
+   * Testing users.
+   *
+   * @var array<string, \Drupal\user\UserInterface>
+   */
+  protected array $users = [];
+
+  /**
+   * Creates testing users.
+   *
+   * @param int $amount
+   *   (optional) Amount of users to be created. Defaults to 2.
+   */
+  protected function createTestingUsers(int $amount = 2): void {
+    $keys = array_map(fn(int $i): string => chr($i + 96), range(1, $amount));
+
+    foreach ($keys as $key) {
+      $values = FieldConfig::loadByName(
+        'user',
+        'user',
+        'full_name'
+      ) ? ['full_name' => $this->randomString()] : [];
+
+      $this->users[$key] = $this->createUser([
+        'use private messaging system',
+        'access user profiles',
+      ], NULL, FALSE, $values);
+    }
+  }
+
+  /**
+   * Adds a full_name field to the user entity.
+   */
+  protected function attachFullNameField(): void {
+    FieldStorageConfig::create([
+      'entity_type' => 'user',
+      'type' => 'string',
+      'field_name' => 'full_name',
+    ])->save();
+    FieldConfig::create([
+      'entity_type' => 'user',
+      'bundle' => 'user',
+      'field_name' => 'full_name',
+    ])->save();
+  }
+
+}
