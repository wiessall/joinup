From 83580827c5f8f9788b5979ba34ceb6308103d32a Mon Sep 17 00:00:00 2001
From: Pieter Frenssen <pieter@frenssen.be>
Date: Wed, 13 Jan 2021 14:42:05 +0200
Subject: [PATCH 1/5] 2997609: Allow to clean up stale database records through
 the UI.

---
 honeypot.install                             |  24 ++++
 honeypot.routing.yml                         |   7 ++
 src/ExpiredRecordsDeleter.php                | 112 +++++++++++++++++++
 src/Form/DeleteExpiredRecordsConfirmForm.php |  69 ++++++++++++
 4 files changed, 212 insertions(+)
 create mode 100644 src/ExpiredRecordsDeleter.php
 create mode 100644 src/Form/DeleteExpiredRecordsConfirmForm.php

diff --git a/honeypot.install b/honeypot.install
index 33ed67a..702b404 100644
--- a/honeypot.install
+++ b/honeypot.install
@@ -6,6 +6,30 @@
  */
 
 use Drupal\Core\Url;
+use Drupal\honeypot\ExpiredRecordsDeleter;
+
+/**
+ * Implements hook_requirements().
+ */
+function honeypot_requirements($phase) {
+  $requirements = [];
+  if ($phase === 'runtime') {
+    $expired_items_count = ExpiredRecordsDeleter::getExpiredRecordCount();
+    if ($expired_items_count) {
+      $requirements['honeypot_expired_entries'] = [
+        'title' => t('Honeypot'),
+        'value' => t(':count expired records found', [
+          ':count' => $expired_items_count,
+        ]),
+        'severity' => REQUIREMENT_WARNING,
+        'description' => t('The database contains expired records from the Honeypot module. They can be safely removed. Note that this process can take a long time to complete if there are many records. <a href=":rebuild">Remove expired records</a>', [
+          ':rebuild' => Url::fromRoute('honeypot.delete_expired_records_confirm')->toString(),
+        ]),
+      ];
+    }
+  }
+  return $requirements;
+}
 
 /**
  * Implements hook_schema().
