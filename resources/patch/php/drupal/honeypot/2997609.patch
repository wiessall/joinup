From 72be9b475579c7c1cbb9b31c2124090dc1ff2d00 Mon Sep 17 00:00:00 2001
From: Pieter Frenssen <pieter@frenssen.be>
Date: Wed, 13 Jan 2021 15:34:05 +0200
Subject: [PATCH 2/5] 2997609: Add a drush command to clean up expired records.

---
 drush.services.yml                |  5 +++++
 src/Commands/HoneypotCommands.php | 26 ++++++++++++++++++++++++++
 2 files changed, 31 insertions(+)
 create mode 100644 drush.services.yml
 create mode 100644 src/Commands/HoneypotCommands.php

diff --git a/drush.services.yml b/drush.services.yml
new file mode 100644
index 0000000..aa59563
--- /dev/null
+++ b/drush.services.yml
@@ -0,0 +1,5 @@
+services:
+  honeypot.commands:
+    class: \Drupal\honeypot\Commands\HoneypotCommands
+    tags:
+      - { name: drush.command }
diff --git a/src/Commands/HoneypotCommands.php b/src/Commands/HoneypotCommands.php
new file mode 100644
index 0000000..8fe4f02
--- /dev/null
+++ b/src/Commands/HoneypotCommands.php
@@ -0,0 +1,26 @@
+<?php
+
+declare(strict_types = 1);
+
+namespace Drupal\honeypot\Commands;
+
+use Drupal\honeypot\ExpiredRecordsDeleter;
+use Drush\Commands\DrushCommands;
+
+/**
+ * Drush commands to manage the CAS mock server.
+ */
+class HoneypotCommands extends DrushCommands {
+
+  /**
+   * Deletes expired database records.
+   *
+   * @command honeypot:delete-expired-records
+   */
+  public function deleteExpiredRecords(): int {
+    ExpiredRecordsDeleter::delete();
+    drush_backend_batch_process();
+    return 0;
+  }
+
+}
-- 
