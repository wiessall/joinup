index 06c4963..a9c0c14 100644
--- a/honeypot.routing.yml
+++ b/honeypot.routing.yml
@@ -5,3 +5,10 @@ honeypot.config:
     _title: 'Honeypot configuration'
   requirements:
     _permission: 'administer honeypot'
+honeypot.delete_expired_records_confirm:
+  path: '/admin/reports/status/honeypot/delete-expired-records'
+  defaults:
+    _form: '\Drupal\honeypot\Form\DeleteExpiredRecordsConfirmForm'
+  requirements:
+    _permission: 'access administration pages'
+    _custom_access: '\Drupal\honeypot\Form\DeleteExpiredRecordsConfirmForm::access'
diff --git a/src/ExpiredRecordsDeleter.php b/src/ExpiredRecordsDeleter.php
new file mode 100644
index 0000000..1ebc1df
--- /dev/null
+++ b/src/ExpiredRecordsDeleter.php
@@ -0,0 +1,112 @@
+<?php
+
+declare(strict_types = 1);
+
+namespace Drupal\honeypot;
+
+use Drupal\Core\Batch\Percentage;
+
+/**
+ * Batch process for deleting expired database records.
+ *
+ * This can be used to clean up stale time restriction entries which were given
+ * an invalid expire time.
+ *
+ * @see https://www.drupal.org/project/honeypot/issues/2931611
+ */
+class ExpiredRecordsDeleter {
+
+  /**
+   * The number of records to delete in a single batch operation.
+   */
+  const BATCH_SIZE = 50000;
+
+  /**
+   * Starts a batch operation that will delete all expired database records.
+   */
+  public static function delete() {
+    $batch_definition = [
+      'operations' => [[[__CLASS__, 'process'], []]],
+      'finished' => [__CLASS__, 'finish'],
+    ];
+    batch_set($batch_definition);
+  }
+
+  /**
+   * Processes a batch delete operation.
+   *
+   * @param array|\ArrayAccess $context
+   *   The context of the current batch operation.
+   */
+  public static function process(&$context) {
+    $database = \Drupal::database();
+    $expired_record_count = static::getExpiredRecordCount();
+
+    // Initialize the sandbox and results counter on first run.
+    if (!isset($context['sandbox']['total'])) {
+      $context['sandbox']['total'] = $expired_record_count;
+    }
+    if (!isset($context['results']['deleted'])) {
+      $context['results']['deleted'] = 0;
+    }
+
+    // Exit the batch process if there are no expired records.
+    if (!$expired_record_count) {
+      $context['finished'] = 1;
+      $context['message'] = t('No deletable honeypot_time_restriction entries found.');
+    }
+    else {
+      $query = $database->select('key_value_expire', 'kve');
+      $query->fields('kve', ['name']);
+      $query->condition('collection', 'honeypot_time_restriction');
+      $query->condition('expire', 2147483647);
+      $query->range(0, self::BATCH_SIZE);
+      $result = $query->execute();
+
+      $deleted_count = $database->delete('key_value_expire')
+        ->condition('collection', 'honeypot_time_restriction')
+        ->condition('name', $result->fetchCol(), 'IN')
+        ->execute();
+
+      $context['results']['deleted'] += $deleted_count;
+      $context['finished'] = $context['results']['deleted'] / $context['sandbox']['total'];
+      $context['message'] = t('Deleted @deleted of @total records (@percentage% complete)', [
+        '@deleted' => $context['results']['deleted'],
+        '@total' => $context['sandbox']['total'],
+        '@percentage' => Percentage::format($context['sandbox']['total'], $context['results']['deleted']),
+      ]);
+    }
+  }
+
+  /**
+   * Reports status after finishing the batch deletion process.
+   */
+  public static function finish($success, $results, $operations) {
+    if ($success) {
+      $message = t('Successfully deleted @count expired records.', [
+        '@count' => $results['deleted'],
+      ]);
+      \Drupal::messenger()->addStatus($message);
+    }
+    else {
+      \Drupal::messenger()->addError(t('An error occurred while deleting expired database records.'));
+    }
+  }
+
+  /**
+   * Returns the number of expired records that are present in the database.
+   *
+   * @return int
+   *   The record count.
+   */
+  public static function getExpiredRecordCount(): int {
+    return (int) \Drupal::database()
+      ->select('key_value_expire', 'kve')
+      ->condition('collection', 'honeypot_time_restriction')
+      ->condition('expire', 2147483647)
+      ->countQuery()
+      ->execute()
+      ->fetchField(0);
+  }
+
+}
diff --git a/src/Form/DeleteExpiredRecordsConfirmForm.php b/src/Form/DeleteExpiredRecordsConfirmForm.php
new file mode 100644
index 0000000..908532b
--- /dev/null
+++ b/src/Form/DeleteExpiredRecordsConfirmForm.php
@@ -0,0 +1,69 @@
+<?php
+
+namespace Drupal\honeypot\Form;
+
+use Drupal\Core\Access\AccessResult;
+use Drupal\Core\Form\ConfirmFormBase;
+use Drupal\Core\Form\FormStateInterface;
+use Drupal\Core\Url;
+use Drupal\honeypot\ExpiredRecordsDeleter;
+
+/**
+ * Asks confirmation before starting the removal of expired database records.
+ */
+class DeleteExpiredRecordsConfirmForm extends ConfirmFormBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  public function getFormId() {
+    return 'honeypot_delete_expired_records_confirm';
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function getQuestion() {
+    return t('Are you sure you want to remove all expired database records?');
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function getCancelUrl() {
+    return new Url('system.status');
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function getConfirmText() {
+    return t('Remove expired records');
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function getDescription() {
+    return t('This will safely remove all expired database records from the Honeypot module. This may be a lengthy process.');
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function submitForm(array &$form, FormStateInterface $form_state) {
+    ExpiredRecordsDeleter::delete();
+    $form_state->setRedirectUrl($this->getCancelUrl());
+  }
+
+  /**
+   * Denies access to the form if there are no expired database records.
+   *
+   * @return \Drupal\Core\Access\AccessResultInterface
+   *   The access result object.
+   */
+  public function access() {
+    return AccessResult::allowedIf(ExpiredRecordsDeleter::getExpiredRecordCount() > 0);
+  }
+
+}
-- 
