diff --git a/src/PermissionCollection.php b/src/PermissionCollection.php
new file mode 100644
index 0000000000000000000000000000000000000000..be48a29348e67412686c94d3bc51041876ffc398
--- /dev/null
+++ b/src/PermissionCollection.php
@@ -0,0 +1,212 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\og;
+
+/**
+ * Holds a set of OG permissions while they are being compiled.
+ *
+ * In addition to the by-name storage, a secondary index keyed by the
+ * (entity type, bundle, operation, ownership) identity of group content
+ * operation permissions lets them be looked up and de-duplicated without
+ * scanning the whole set. This is an implementation detail of PermissionEvent.
+ *
+ * @internal
+ *
+ * @implements \IteratorAggregate<string, \Drupal\og\PermissionInterface>
+ */
+class PermissionCollection implements \IteratorAggregate {
+
+  /**
+   * The permissions, keyed by permission name.
+   *
+   * @var array<string, \Drupal\og\PermissionInterface>
+   */
+  private array $permissions = [];
+
+  /**
+   * Group content operation permission names, keyed by their identity.
+   *
+   * @var array<string, string>
+   */
+  private array $operationIndex = [];
+
+  /**
+   * Adds a permission, replacing any existing one with the same identity.
+   *
+   * @throws \InvalidArgumentException
+   *   Thrown when a required property is missing.
+   */
+  public function add(PermissionInterface $permission): void {
+    $this->validate($permission);
+
+    $name = $permission->getName();
+    if (isset($this->permissions[$name])) {
+      $this->unindex($this->permissions[$name]);
+    }
+    if ($permission instanceof GroupContentOperationPermission) {
+      $this->index($permission);
+    }
+    $this->permissions[$name] = $permission;
+  }
+
+  /**
+   * Returns the permission with the given name.
+   *
+   * @throws \InvalidArgumentException
+   *   Thrown when no permission with the given name exists.
+   */
+  public function get(string $name): PermissionInterface {
+    if (!isset($this->permissions[$name])) {
+      throw new \InvalidArgumentException("The '$name' permission does not exist.");
+    }
+    return $this->permissions[$name];
+  }
+
+  /**
+   * Returns whether a permission with the given name exists.
+   */
+  public function has(string $name): bool {
+    return isset($this->permissions[$name]);
+  }
+
+  /**
+   * Removes the permission with the given name, if it exists.
+   */
+  public function remove(string $name): void {
+    if (isset($this->permissions[$name])) {
+      $this->unindex($this->permissions[$name]);
+      unset($this->permissions[$name]);
+    }
+  }
+
+  /**
+   * Returns all permissions, keyed by permission name.
+   *
+   * @return array<string, \Drupal\og\PermissionInterface>
+   *   The permissions, keyed by permission name.
+   */
+  public function all(): array {
+    return $this->permissions;
+  }
+
+  /**
+   * Returns a group content operation permission by its identity.
+   *
+   * @throws \InvalidArgumentException
+   *   Thrown when no matching permission exists.
+   */
+  public function getByOperation(string $entity_type_id, string $bundle_id, string $operation, bool $owner = FALSE): GroupContentOperationPermission {
+    $permission = $this->findByOperation($entity_type_id, $bundle_id, $operation, $owner);
+    if ($permission === NULL) {
+      throw new \InvalidArgumentException('The permission with the given properties does not exist.');
+    }
+    return $permission;
+  }
+
+  /**
+   * Returns whether a group content operation permission exists.
+   */
+  public function hasOperation(string $entity_type_id, string $bundle_id, string $operation, bool $owner = FALSE): bool {
+    return $this->findByOperation($entity_type_id, $bundle_id, $operation, $owner) !== NULL;
+  }
+
+  /**
+   * Removes a group content operation permission by its identity.
+   *
+   * @throws \InvalidArgumentException
+   *   Thrown when no matching permission exists.
+   */
+  public function removeByOperation(string $entity_type_id, string $bundle_id, string $operation, bool $owner = FALSE): void {
+    $this->remove($this->getByOperation($entity_type_id, $bundle_id, $operation, $owner)->getName());
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function getIterator(): \Traversable {
+    return new \ArrayIterator($this->permissions);
+  }
+
+  /**
+   * Returns the operation permission with the given identity, or NULL.
+   */
+  private function findByOperation(string $entity_type_id, string $bundle_id, string $operation, bool $owner): ?GroupContentOperationPermission {
+    $key = $this->operationKey($entity_type_id, $bundle_id, $operation, $owner);
+    if (!isset($this->operationIndex[$key])) {
+      return NULL;
+    }
+
+    $permission = $this->permissions[$this->operationIndex[$key]];
+    \assert($permission instanceof GroupContentOperationPermission);
+    return $permission;
+  }
+
+  /**
+   * Validates that a permission carries the properties required to store it.
+   *
+   * @throws \InvalidArgumentException
+   *   Thrown when a required property is missing.
+   */
+  private function validate(PermissionInterface $permission): void {
+    if (empty($permission->getName())) {
+      throw new \InvalidArgumentException('Permission name is required.');
+    }
+
+    if (empty($permission->getTitle())) {
+      throw new \InvalidArgumentException('The permission title is required.');
+    }
+
+    if ($permission instanceof GroupContentOperationPermission) {
+      if (empty($permission->getEntityType())) {
+        throw new \InvalidArgumentException('The entity type ID is required.');
+      }
+
+      if (empty($permission->getBundle())) {
+        throw new \InvalidArgumentException('The bundle ID is required.');
+      }
+
+      if (empty($permission->getOperation())) {
+        throw new \InvalidArgumentException('The operation is required.');
+      }
+    }
+  }
+
+  /**
+   * Indexes an operation permission, dropping any with the same identity.
+   */
+  private function index(GroupContentOperationPermission $permission): void {
+    $key = $this->operationKeyFor($permission);
+
+    if (isset($this->operationIndex[$key])) {
+      unset($this->permissions[$this->operationIndex[$key]]);
+    }
+
+    $this->operationIndex[$key] = $permission->getName();
+  }
+
+  /**
+   * Removes a permission from the operation index, if it is indexed.
+   */
+  private function unindex(PermissionInterface $permission): void {
+    if ($permission instanceof GroupContentOperationPermission) {
+      unset($this->operationIndex[$this->operationKeyFor($permission)]);
+    }
+  }
+
+  /**
+   * Builds the operation index key for a permission.
+   */
+  private function operationKeyFor(GroupContentOperationPermission $permission): string {
+    return $this->operationKey($permission->getEntityType(), $permission->getBundle(), $permission->getOperation(), $permission->getOwner());
+  }
+
+  /**
+   * Builds an operation index key from the identifying properties.
+   */
+  private function operationKey(string $entity_type_id, string $bundle_id, string $operation, bool $owner): string {
+    return implode(':', [$entity_type_id, $bundle_id, $operation, $owner ? '1' : '0']);
+  }
+
+}
