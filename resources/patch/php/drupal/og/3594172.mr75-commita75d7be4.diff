+  /**
+   * Tests that deleting a permission also clears the operation lookup.
+   *
+   * @covers ::deletePermission
+   * @covers ::hasGroupContentOperationPermission
+   */
+  public function testDeleteClearsGroupContentOperationLookup(): void {
+    $event = new PermissionEvent($this->randomMachineName(), $this->randomMachineName(), []);
+    $permission = new GroupContentOperationPermission([
+      'name' => 'edit any article',
+      'title' => $this->t('Edit any article'),
+      'entity type' => 'node',
+      'bundle' => 'article',
+      'operation' => 'update',
+      'owner' => FALSE,
+    ]);
+
+    $event->setPermission($permission);
+    $this->assertTrue($event->hasGroupContentOperationPermission('node', 'article', 'update', FALSE));
+
+    $event->deletePermission('edit any article');
+    $this->assertFalse($event->hasGroupContentOperationPermission('node', 'article', 'update', FALSE));
+  }
+
   /**
    * Data provider to test permissions.
    *
