+  /**
+   * Check if a path alias is valid.
+   *
+   * @param \Drupal\path_alias\PathAliasInterface $path_alias
+   *   THe path alias to validate.
+   * @return bool
+   *   TRUE if the path alias is valid, FALSE otherwise.
+   */
+  private function isPathAliasValid(PathAliasInterface $path_alias): bool {
+      $path_alias_constraint_violations = $path_alias->validate();
+
+      if ($path_alias_constraint_violations->count() <= 0) {
+          return TRUE;
+      }
+
+      foreach ($path_alias_constraint_violations as $violation) {
+          $this->messenger->addError($violation);
+      }
+
+      return FALSE;
+  }
+
