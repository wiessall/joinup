+    /**
+     * Check if path changes need to be notified to the current user.
+     *
+     * @param string|NULL $op
+     *   (optional) The operation being performed.
+     * @return bool
+     *   TRUE for notify path changes, FALSE otherwise.
+     */
+  private function notifyPathChanges(string $op = NULL): bool {
+      if (!isset($this->isVerbose)) {
+          $config = $this->configFactory->get('pathauto.settings');
+          $this->isVerbose = $config->get('verbose') && $this->account->hasPermission('notify of path changes');
