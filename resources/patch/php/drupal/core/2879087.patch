+  /**
+   * {@inheritdoc}
+   */
+  protected function buildCreateAccessCid(?string $entity_bundle, array $context): string {
+    $cid = parent::buildCreateAccessCid($entity_bundle, $context);
+    $cid .= ':' . (isset($context['commented_entity']) ? $context['commented_entity']->id() : '0');
