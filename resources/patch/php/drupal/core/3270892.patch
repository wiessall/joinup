From e45919af6e9c48a276589331dd5e99cafa7bd013 Mon Sep 17 00:00:00 2001
From: "Pucci, Murilo henrique [GTSBR NON-J&J]" <mpucci@its.jnj.com>
Date: Fri, 15 Apr 2022 13:35:53 -0300
Subject: [PATCH 2/9] Change the system.install to show the profile version
 only when it has been set

---
 core/modules/system/system.install            |  9 +++--
 ...g_install_profile_missing_version.info.yml |  4 ++
 .../Installer/InstallerMissingVersionTest.php | 40 +++++++++++++++++++
 3 files changed, 50 insertions(+), 3 deletions(-)
 create mode 100644 core/profiles/testing_install_profile_missing_version/testing_install_profile_missing_version.info.yml
 create mode 100644 core/tests/Drupal/FunctionalTests/Installer/InstallerMissingVersionTest.php

diff --git a/core/modules/system/system.install b/core/modules/system/system.install
index 85e6047281fe..f634faa7234a 100644
--- a/core/modules/system/system.install
+++ b/core/modules/system/system.install
@@ -56,13 +56,16 @@ function system_requirements($phase) {
     $profile = \Drupal::installProfile();
     if ($profile != 'standard') {
       $info = $module_extension_list->getExtensionInfo($profile);
+
+      // Create the version placeholder if a version is set.
+      $version_placeholder = $info['version'] ? ['%version' => $info['version']] : [];
+      $profile_version = !empty($version_placeholder) ? '(%profile-%version)' : '(%profile)';
       $requirements['install_profile'] = [
         'title' => t('Installation profile'),
-        'value' => t('%profile_name (%profile-%version)', [
+        'value' => t('%profile_name ' . $profile_version, [
           '%profile_name' => $info['name'],
           '%profile' => $profile,
-          '%version' => $info['version'] ?? \Drupal::VERSION,
-        ]),
+        ] + $version_placeholder),
         'severity' => REQUIREMENT_INFO,
         'weight' => -9,
       ];
diff --git a/core/profiles/testing_install_profile_missing_version/testing_install_profile_missing_version.info.yml b/core/profiles/testing_install_profile_missing_version/testing_install_profile_missing_version.info.yml
new file mode 100644
index 000000000000..6ada1259f121
--- /dev/null
+++ b/core/profiles/testing_install_profile_missing_version/testing_install_profile_missing_version.info.yml
@@ -0,0 +1,4 @@
+name: 'Testing install missing version'
+type: profile
+description: 'Minimal profile for testing install profiles without version key.'
+hidden: true
diff --git a/core/tests/Drupal/FunctionalTests/Installer/InstallerMissingVersionTest.php b/core/tests/Drupal/FunctionalTests/Installer/InstallerMissingVersionTest.php
new file mode 100644
index 000000000000..35187b133b01
--- /dev/null
+++ b/core/tests/Drupal/FunctionalTests/Installer/InstallerMissingVersionTest.php
@@ -0,0 +1,40 @@
+<?php
+
+namespace Drupal\FunctionalTests\Installer;
+
+use Drupal\Tests\BrowserTestBase;
+
+/**
+ * Tests installing a profile without version.
+ *
+ * @group Installer
+ */
+class InstallerMissingVersionTest extends BrowserTestBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  protected $defaultTheme = 'stark';
+
+  /**
+   * {@inheritdoc}
+   */
+  protected $profile = 'testing_install_profile_missing_version';
+
+  /**
+   * Tests the report status page after install a module without version.
+   */
+  public function testProfileOnStatusPage() {
+    $user = $this->drupalCreateUser([
+      'administer site configuration',
+      'access site reports',
+    ]);
+    $this->drupalLogin($user);
+    $this->drupalGet('admin/reports/status');
+
+    // Verify that the PHP version is shown on the page.
+    $this->assertSession()->pageTextContains('Testing install missing version (testing_install_profile_missing_version)');
+
+  }
+
+}
-- 
