+    $cid = parent::buildCreateAccessCid($context, $entity_bundle);
+    // Vary the static access cache depending on the commented/host entity.
+    $cid .= ':' . (isset($context['commented_entity']) ? $context['commented_entity']->id() : '0');
+    return $cid;
+  }
+
 }
