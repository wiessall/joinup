+++ b/core/config/schema/core.data_types.schema.yml
@@ -84,6 +84,16 @@ required_label:
 plural_label:
   type: label
   label: 'Plural variants'
+  constraints:
+    Regex:
+      # Normally, labels cannot contain invisible control characters. In this
+      # particular case, an invisible character (ASCII 3, 0x03) is used to
+      # encode translation information, so carve out an exception for that
+      # only.
+      # @see \Drupal\views\Plugin\views\field\NumericField
+      pattern: '/([^\PC\x03])/u'
+      match: false
+      message: 'Labels are not allowed to span multiple lines or contain control characters.'
 
 # Internal Drupal path
 path:
