From 647fabdf7b2e2ae5c50984cb573c25b77c5e10c0 Mon Sep 17 00:00:00 2001
From: Ilias Dimopoulos <idimopoulos@hotmail.com>
Date: Tue, 11 Apr 2023 21:34:07 +0300
Subject: [PATCH] Reroll patch for 9.5.x

---
 core/modules/filter/filter.module                        | 9 +++++++++
 .../tests/src/Functional/FilterHtmlImageSecureTest.php   | 4 ++++
 2 files changed, 13 insertions(+)

diff --git a/core/modules/filter/filter.module b/core/modules/filter/filter.module
index 4fcaca58d9b1..e2e3969394ba 100644
--- a/core/modules/filter/filter.module
+++ b/core/modules/filter/filter.module
@@ -801,6 +801,15 @@ function _filter_html_image_secure_process($text) {
         // The image has the right path. Erroneous images are dealt with below.
         continue;
       }
+      elseif (@pathinfo($local_image_path, PATHINFO_EXTENSION) == 'svg') {
+        // It's an SVG. Make sure it appears to be valid.
+        if ($xml = @simplexml_load_file($local_image_path)) {
+          if (strtolower($xml->getName()) == 'svg') {
+            // Appears to be valid. Erroneous images are dealt with below.
+            continue;
+          }
+        }
+      }
     }
     // Allow modules and themes to replace an invalid image with an error
     // indicator. See filter_filter_secure_image_alter().
diff --git a/core/modules/filter/tests/src/Functional/FilterHtmlImageSecureTest.php b/core/modules/filter/tests/src/Functional/FilterHtmlImageSecureTest.php
index 3aa0428cfe21..20474dab7148 100644
--- a/core/modules/filter/tests/src/Functional/FilterHtmlImageSecureTest.php
+++ b/core/modules/filter/tests/src/Functional/FilterHtmlImageSecureTest.php
@@ -90,6 +90,7 @@ public function testImageSource() {
     $csrf_path = $public_files_path . '/' . implode('/', array_fill(0, substr_count($public_files_path, '/') + 1, '..'));
 
     $druplicon = 'core/misc/druplicon.png';
+    $svg_image = 'core/misc/logo/drupal-logo.svg';
     $red_x_image = base_path() . 'core/misc/icons/e32700/error.svg';
 
     // Put a test image in the files directory.
@@ -111,6 +112,9 @@ public function testImageSource() {
     $images = [
       $http_base_url . '/' . $druplicon => base_path() . $druplicon,
       $https_base_url . '/' . $druplicon => base_path() . $druplicon,
+      // Test an SVG image.
+      $http_base_url . '/' . $svg_image => base_path() . $svg_image,
+      $https_base_url . '/' . $svg_image => base_path() . $svg_image,
       // Test a URL that includes a port.
       preg_replace($host_pattern, 'http://' . $host . ':', $http_base_url . '/' . $druplicon) => base_path() . $druplicon,
       preg_replace($host_pattern, 'http://' . $host . ':80', $http_base_url . '/' . $druplicon) => base_path() . $druplicon,
-- 
