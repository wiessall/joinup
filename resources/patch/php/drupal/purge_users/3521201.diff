+/**
+ * Filter users based on their notification status.
+ *
+ * @param string $op
+ *   The operation type: 'purge_users' or 'notification_users'.
+ * @param array $param
+ *   Parameters containing notification settings.
+ * @param array $users
+ *   Array of user IDs to check.
+ *
+ * @return array
+ *   Filtered array of user IDs.
+ */
+function _purge_users_notification_check(string $op, array $param, array $users): array {
+  if (empty($users) || empty($param['send_email_user_before_notification'])) {
+    return $users;
+  }
+
+  $db = \Drupal::database();
+
+  // Calculate the expiration timestamp.
+  $expiration_timestamp = 0;
+  if (!empty($param['notification_interval'])) {
+    $expiration_timestamp = strtotime('-' . $param['notification_interval']);
+  }
+
+  // Find UIDs that have notifications and are not expired.
+  $query = $db->select('purge_users_notifications', 'pun')
+    ->fields('pun', ['uid'])
+    ->condition('pun.uid', $users, 'IN')
+    ->condition('pun.type', 'notification_users');
+
+  if ($op === 'purge_users') {
+    $query->condition('pun.timestamp', $expiration_timestamp, '<');
+  }
+
+  $notified_uids = $query->execute()->fetchCol();
+
+  return ($op === 'purge_users') ? array_intersect($users, $notified_uids) : array_diff($users, $notified_uids);
+}
