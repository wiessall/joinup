+/**
+ * Add new serial field to track_usage table.
+ */
+function track_usage_update_8001(): void {
+  $schema = \Drupal::database()->schema();
+
+  // Drop primary key first.
+  $schema->dropPrimaryKey(RecorderInterface::TABLE);
+
+  $schema->addField(RecorderInterface::TABLE, 'tid', [
+    'description' => 'Unique identifier for the record',
+    'type' => 'serial',
+    'size' => 'big',
+    'not null' => TRUE,
+    'unsigned' => TRUE,
+  ], ['primary key' => ['tid']]);
+
+  // The legacy primary key defines the uniqueness.
+  $schema->addUniqueKey(RecorderInterface::TABLE, 'track', [
+    'config',
+    'source_type',
+    'source_id_int',
+    'source_id_string',
+    'source_langcode',
+    'source_revision',
+    'target_type',
+    'target_id_int',
+    'target_id_string',
+  ]);
+}
+
+/**
+ * Create a new {track_usage_paths} table.
+ */
+function track_usage_update_8002(): void {
+  \Drupal::database()->schema()->createTable(RecorderInterface::TABLE_PATHS, [
+    'description' => 'Stores paths to target entities',
+    'fields' => [
+      'tid' => [
+        'description' => 'Unique identifier for the tracking record',
+        'type' => 'serial',
+        'not null' => TRUE,
+        'unsigned' => TRUE,
+      ],
+      'path' => [
+        'description' => 'The path identifier. One entity can have multiple references to the same target entity',
+        'type' => 'int',
+        'size' => 'tiny',
+        'not null' => TRUE,
+        'unsigned' => TRUE,
+      ],
+      'delta' => [
+        'description' => 'The sequence of a traversable item inside a path',
+        'type' => 'int',
+        'size' => 'tiny',
+        'not null' => TRUE,
+        'unsigned' => TRUE,
+        'default' => 0,
+      ],
+      'type' => [
+        'description' => 'The type of the traversable entity',
+        'type' => 'varchar_ascii',
+        'length' => EntityTypeInterface::ID_MAX_LENGTH,
+        'not null' => TRUE,
+      ],
+      'id' => [
+        'description' => 'The ID if the traversable entity',
+        'type' => 'varchar_ascii',
+        'length' => 255,
+        'not null' => TRUE,
+      ],
+      'revision' => [
+        'description' => 'The revision of the traversable entity',
+        'type' => 'int',
+        'unsigned' => TRUE,
+        'not null' => TRUE,
+        'default' => 0,
+      ],
+    ],
+    'primary key' => [
+      'tid',
+      'path',
+      'delta',
+    ],
+    // A traversable entity cannot occur more than one time in the same path.
+    'unique keys' => [
+      'entity_in_path' => [
+        'tid',
+        'path',
+        'delta',
+        'type',
+        'id',
+      ],
+    ],
+    'indexes' => [
+      'traversable' => ['type', 'id', 'revision'],
+    ],
+    'foreign keys' => [
+      'track_usage' => [
+        'table' => RecorderInterface::TABLE,
+        'columns' => [
+          'tid' => 'tid',
+        ],
+      ],
+    ],
+  ]);
+}
