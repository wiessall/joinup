+/**
+ * Migrate paths into the {track_usage_paths} table.
+ */
+function track_usage_update_8003(array &$sandbox): string {
+  $db = \Drupal::database();
+
+  if (!isset($sandbox['data'])) {
+    // Get all records with non-empty meta-data.
+    $sandbox['data'] = $db->select(RecorderInterface::TABLE)
+      ->fields(RecorderInterface::TABLE, ['tid', 'meta'])
+      ->isNotNull('meta')
+      ->condition('meta', '', '!=')
+      ->execute()
+      ->fetchAll();
+
+    $sandbox['progress'] = 0;
+    $sandbox['count'] = count($sandbox['data']);
+  }
+
+  $data = array_splice($sandbox['data'], 0, 200);
+
+  $insert = $db->insert(RecorderInterface::TABLE_PATHS)
+    ->fields(['tid', 'path', 'delta', 'type', 'id', 'revision']);
+
+  foreach ($data as $record) {
+    $sandbox['progress']++;
+
+    if (!($meta = json_decode($record->meta, TRUE)) || !isset($meta['paths']) && !is_array($meta['paths'])) {
+      // Doesn't contain valid JSON or no `paths` array exists.
+      continue;
+    }
+
+    foreach ($meta['paths'] as $path => $keys) {
+      foreach ($keys as $delta => $key) {
+        [$type, $id, $revision] = explode(':', $key, 3);
+        $insert->values([
+          'tid' => $record->tid,
+          'path' => $path,
+          'delta' => $delta,
+          'type' => $type,
+          'id' => $id,
+          'revision' => $revision,
+        ]);
+      }
+    }
+  }
+
+  if ($insert->count()) {
+    $insert->execute();
+  }
+
+  $sandbox['#finished'] = empty($sandbox['data']);
+
+  return "Processed {$sandbox['progress']} out of {$sandbox['count']} usages";
+}
