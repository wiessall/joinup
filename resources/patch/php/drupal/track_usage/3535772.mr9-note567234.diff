+  /**
+   * Explodes an entity key into a triplet array.
+   *
+   * This method is needed because there are entity types where the ID is a
+   * string and the ID might contain one or many colons (:). In such cases
+   * `explode(':', $key, 3)` will not give the correct results.
+   *
+   * @param string $key
+   *   An entity key same as the one returned by self::getKey().
+   *
+   * @return array{string, string, int}
+   *   A triplet:
+   *   0: The entity type ID.
+   *   1: The entity ID.
+   *   2: The revision ID.
+   */
+  public function destructKey(string $key): array {
+    $parts = explode(':', $key);
+    assert(count($parts) >= 3);
+
+    $entityTypeId = array_shift($parts);
+    $revisionId = intval(array_pop($parts));
+
+    return [$entityTypeId, implode(':', $parts), $revisionId];
+  }
+
