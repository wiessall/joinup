+   /**
+   * Duplicates files on paragraph duplication.
+   */
+  private function duplicateFiles($field) {
+    // Get the FileRepository service.
+    $file_repository = \Drupal::service('file.repository');
+    foreach ($field->getIterator() as $fileItem) {
+      $fileEntity = $fileItem->entity;
+
+      // Skip if the file entity doesn't exist.
+      if (!$fileEntity) {
+        continue;
+      }
+
+      $destination_dir = $fileItem->getUploadLocation();
+      // Copy the file.
+      $copiedEntity = $file_repository->copy($fileEntity, $destination_dir);
+      $fileItem->entity = $copiedEntity;
+    }
+  }
+
