+  /**
+   * Tests that a CAS user can save their profile via a one-time login link.
+   */
+  public function testCasUserCanSaveProfileViaOneTimeLoginLink(): void {
+    $admin = $this->drupalCreateUser([
+      'administer account settings',
+      'administer users',
+    ]);
+    $cas_user = $this->drupalCreateUser([], 'cas_one_time_login_user');
+    $this->container->get('cas.user_manager')->setCasUsernameForAccount($cas_user, 'cas_one_time_login_user');
+
+    $this->drupalLogin($admin);
+    $this->drupalGet('/admin/config/people/cas');
+    $this->submitForm([
+      'user_accounts[restrict_password_management]' => TRUE,
+      'user_accounts[prevent_normal_login]' => FALSE,
+    ], 'Save configuration');
+    $this->drupalLogout();
+
+    $timestamp = \Drupal::time()->getRequestTime();
+    $reset_url = Url::fromRoute('user.reset', [
+      'uid' => $cas_user->id(),
+      'timestamp' => $timestamp,
+      'hash' => user_pass_rehash($cas_user, $timestamp),
+    ])->setAbsolute()->toString();
+
+    $this->drupalGet($reset_url);
+    $this->submitForm([], 'Log in');
+    $this->submitForm([], 'Save');
+    $this->assertSession()->pageTextNotContains('Password field is required.');
+    $this->assertSession()->pageTextContains('The changes have been saved.');
+  }
