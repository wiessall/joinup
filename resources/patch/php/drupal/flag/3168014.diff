diff --git a/modules/flag_count/templates/flag-count-text.html.twig b/modules/flag_count/templates/flag-count-text.html.twig
new file mode 100644
index 0000000000000000000000000000000000000000..fc6468215737a46c606245dad1e915c3d3fa81a4
--- /dev/null
+++ b/modules/flag_count/templates/flag-count-text.html.twig
@@ -0,0 +1,21 @@
+{#
+/**
+ * @file
+ * Flag count text template
+ *
+ * Available variables:
+ * - flag: The flag object.
+ * - flaggable: The flaggable entity.
+ */
+#}
+{% apply spaceless %}
+  {# Set the remaining Flag CSS classes. #}
+  {% set classes = [
+    'flag',
+    'flag-' ~ flag.id()|clean_class,
+  ] %}
+
+  {% set count = flagcount(flag, flaggable) %}
+
+  <div class="{{ classes|join(' ') }}">{{ flag.label() }}: <span>{{ count }}</span></div>
+{% endapply %}
