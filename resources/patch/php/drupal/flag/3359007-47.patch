From: Adrian Lorenc <adrian.lorenc@gmail.com>
Date: Tue, 9 May 2023 08:25:29 +0200
Subject: [PATCH 1/2] Use exactly the same code to generate js class.

---
 src/Controller/ActionLinkController.php | 2 +-
 templates/flag.html.twig                | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/Controller/ActionLinkController.php b/src/Controller/ActionLinkController.php
index d510ed1..651dd33 100644
--- a/src/Controller/ActionLinkController.php
+++ b/src/Controller/ActionLinkController.php
@@ -146,7 +146,7 @@ class ActionLinkController implements ContainerInjectionInterface {
     $link = $link_type->getAsFlagLink($flag, $entity);
 
     // Generate a CSS selector to use in a JQuery Replace command.
-    $selector = '.js-flag-' . Html::cleanCssIdentifier($flag->id()) . '-' . $entity->id();
+    $selector = '.' . Html::getClass('js-flag-' . $flag->id() . '-' . $entity->id());
 
     // Create a new JQuery Replace command to update the link display.
     $replace = new ReplaceCommand($selector, $this->renderer->renderPlain($link));
diff --git a/templates/flag.html.twig b/templates/flag.html.twig
index ea1fdc9..5fc06a8 100644
--- a/templates/flag.html.twig
+++ b/templates/flag.html.twig
@@ -30,7 +30,7 @@
   set classes = [
     'flag',
     'flag-' ~ flag.id()|clean_class,
-    'js-flag-' ~ flag.id()|clean_class ~ '-' ~ flaggable.id(),
+    ('js-flag-' ~ flag.id() ~ '-' ~ flaggable.id())|clean_class,
     action_class
   ]
 %}
