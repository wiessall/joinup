--- a/src/FlagType/FlagTypeBase.php
+++ b/src/FlagType/FlagTypeBase.php
@@ -164,6 +164,11 @@ abstract class FlagTypeBase extends PluginBase implements FlagTypePluginInterfac
           '%flag_title' => $flag->label(),
         ]),
       ],
+      'view ' . $flag->id() => [
+        'title' => $this->t('View %flag_title', [
+          '%flag_title' => $flag->label(),
+        ]),
+      ],
     ];
   }
 
