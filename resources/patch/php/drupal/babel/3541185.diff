diff --git a/js/popstate-handler.js b/js/popstate-handler.js
new file mode 100644
index 0000000000000000000000000000000000000000..49356b9b8d659f59236740b6d64e45fac32fa1d5
--- /dev/null
+++ b/js/popstate-handler.js
@@ -0,0 +1,27 @@
+(function () {
+  let blockPopstateEvent = document.readyState !== 'complete';
+
+  if (window.addEventListener) {
+    window.addEventListener(
+      'load',
+      () => {
+        setTimeout(() => {
+          blockPopstateEvent = false;
+        }, 0);
+      },
+      false,
+    );
+
+    window.addEventListener(
+      'popstate',
+      (evt) => {
+        if (blockPopstateEvent) {
+          return;
+        }
+
+        window.location.reload();
+      },
+      false,
+    );
+  }
+})();
diff --git a/js/push-parameters.js b/js/push-parameters.js
new file mode 100644
index 0000000000000000000000000000000000000000..6aae1041258db95b41ba276447d08bf428be9dfd
--- /dev/null
+++ b/js/push-parameters.js
@@ -0,0 +1,54 @@
+(function (Drupal) {
+  /**
+   * Build query string from parameters object.
+   */
+  function buildQueryString(params) {
+    return Object.entries(params)
+      .filter(([key, value]) => value !== '' && value != null)
+      .map(
+        ([key, value]) =>
+          `${encodeURIComponent(key)}=${encodeURIComponent(value)}`,
+      )
+      .join('&');
+  }
+
+  /**
+   * Check if a modal is currently open using Drupal's built-in methods.
+   */
+  function isModalOpen() {
+    return !!(
+      document.querySelector('.ui-dialog-content') ||
+      document.querySelector('.ui-dialog') ||
+      document.querySelector('[role="dialog"]') ||
+      document.querySelector('[aria-modal="true"]')
+    );
+  }
+
+  /**
+   * AJAX command handler for pushParameters.
+   *
+   * This is a reusable command that can be used by any module
+   * to update URL parameters via AJAX without page reload.
+   */
+  Drupal.AjaxCommands.prototype.pushParameters = function (
+    ajax,
+    response,
+    status,
+  ) {
+    if (!window.history || !response.parameters) {
+      return;
+    }
+
+    // Skip URL updates if we're in a modal context
+    if (isModalOpen()) {
+      return;
+    }
+
+    const queryString = buildQueryString(response.parameters);
+    const url = `${window.location.pathname}${
+      queryString ? `?${queryString}` : ''
+    }`;
+
+    window.history.pushState(response.parameters, document.title, url);
+  };
+})(Drupal);
diff --git a/src/Ajax/PushParametersCommand.php b/src/Ajax/PushParametersCommand.php
new file mode 100644
index 0000000000000000000000000000000000000000..37d800cf6b1401ab41a1f696d3cb74b1030870fd
--- /dev/null
+++ b/src/Ajax/PushParametersCommand.php
@@ -0,0 +1,34 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\babel\Ajax;
+
+use Drupal\Core\Ajax\CommandInterface;
+
+/**
+ * AJAX command for updating browser URL parameters.
+ */
+class PushParametersCommand implements CommandInterface {
+
+  /**
+   * Constructs a PushParametersCommand object.
+   *
+   * @param array $parameters
+   *   Key-value pairs of parameters to include in URL.
+   */
+  public function __construct(
+    protected array $parameters = [],
+  ) {}
+
+  /**
+   * {@inheritdoc}
+   */
+  public function render(): array {
+    return [
+      'command' => 'pushParameters',
+      'parameters' => $this->parameters,
+    ];
+  }
+
+}
