+  /**
+   * Tests that a purged, already-translated string is not re-created.
+   *
+   * @legacy-covers \Drupal\babel_tmgmt\Hook\BabelTmgmtHooks::cron
+   * @legacy-covers \Drupal\babel_tmgmt\BabelTmgmtIntegration::createContinuousJobItemForJob
+   */
+  public function testPurgedTranslatedStringIsNotRecreated(): void {
+    $translatorManager = $this->container->get('plugin.manager.tmgmt.translator');
+    $repository = $this->container->get(BabelStringsRepositoryInterface::class);
+    $collectorFactory = $this->container->get(StringsCollectorFactory::class);
+    $localeStorage = $this->container->get('locale.storage');
+    $jobItemStorage = $this->container->get('entity_type.manager')->getStorage('tmgmt_job_item');
+
+    ConfigurableLanguage::createFromLangcode('it')->save();
+    tmgmt_translator_auto_create($translatorManager->getDefinition('local'));
+    $job = tmgmt_job_create('en', 'it', 0, [
+      'label' => 'Testing continuous job',
+      'translator' => 'local',
+      'job_type' => JobInterface::TYPE_CONTINUOUS,
+      'state' => JobInterface::STATE_CONTINUOUS,
+    ]);
+    $job->save();
+
+    $testingHash = (new Source('Test', ''))->getHash();
+    $filter = [
+      'plugin' => 'babel',
+      'item_type' => 'default',
+      'item_id' => $testingHash,
+    ];
+
+    $this->populateAndConsumeQueue();
+    $this->assertNotEmpty($job->getItems($filter));
+
+    // Translate the string and refresh Babel's cache so it reflects the change.
+    $localeStorage->createTranslation([
+      'lid' => $localeStorage->findString(['source' => 'Test'])->lid,
+      'language' => 'it',
+      'translation' => 'Prova',
+    ])->save();
+    $collectorFactory->invalidateHashes([$testingHash], 'it');
+    $collectorFactory->destruct();
+
+    $this->assertArrayNotHasKey($testingHash, $repository->getStrings(
+      langcode: 'it',
+      translationStatus: FALSE,
+      sourceStatus: TRUE,
+      lockStatus: FALSE,
+    ));
+
+    // Simulate TMGMT job item purge removing the completed job item.
+    $jobItemStorage->delete($job->getItems($filter));
+    $this->assertEmpty($job->getItems($filter));
+
+    // Cron must not re-create the item for the now-translated string.
+    $this->populateAndConsumeQueue();
+    $this->assertEmpty($job->getItems($filter));
+
+    // Nor must the service: the queue is drained over several cron runs.
+    $service = $this->container->get(BabelTmgmtIntegration::class);
+    $this->assertNull($service->createContinuousJobItemForJob($job, $testingHash));
+    $this->assertEmpty($job->getItems($filter));
+  }
+
+  /**
+   * Tests that job items representing work in progress are not replaced.
+   *
+   * @legacy-covers \Drupal\babel_tmgmt\BabelTmgmtIntegration::createContinuousJobItemForJob
+   */
+  public function testInProgressJobItemsAreNotReplaced(): void {
+    $translatorManager = $this->container->get('plugin.manager.tmgmt.translator');
+
+    ConfigurableLanguage::createFromLangcode('it')->save();
+    tmgmt_translator_auto_create($translatorManager->getDefinition('local'));
+    $job = tmgmt_job_create('en', 'it', 0, [
+      'label' => 'Testing continuous job',
+      'translator' => 'local',
+      'job_type' => JobInterface::TYPE_CONTINUOUS,
+      'state' => JobInterface::STATE_CONTINUOUS,
+    ]);
+    $job->save();
+
+    $testingHash = (new Source('Test', ''))->getHash();
+    $filter = [
+      'plugin' => 'babel',
+      'item_type' => 'default',
+      'item_id' => $testingHash,
+    ];
+
+    $this->populateAndConsumeQueue();
+    $jobItems = $job->getItems($filter);
+    $this->assertCount(1, $jobItems);
+    $jobItem = reset($jobItems);
+
+    // A request out at the provider or a translation waiting to be reviewed
+    // survives any number of cron runs.
+    foreach ([JobItemInterface::STATE_ACTIVE, JobItemInterface::STATE_REVIEW] as $state) {
+      $jobItem->setState($state);
+      $this->populateAndConsumeQueue();
+      $jobItems = $job->getItems($filter);
+      $this->assertCount(1, $jobItems);
+      $this->assertSame($jobItem->id(), reset($jobItems)->id());
+      $this->assertSame($state, (int) reset($jobItems)->getState());
+    }
+
+    // An aborted request no longer blocks a new one, but it is left in place
+    // for the site's purge policy to deal with.
+    $jobItem->setState(JobItemInterface::STATE_ABORTED);
+    $this->populateAndConsumeQueue();
+    $jobItems = $job->getItems($filter);
+    $this->assertCount(2, $jobItems);
+    $this->assertSame(JobItemInterface::STATE_ABORTED, (int) $jobItems[$jobItem->id()]->getState());
+    unset($jobItems[$jobItem->id()]);
+    $freshJobItem = reset($jobItems);
+    $this->assertNotSame(JobItemInterface::STATE_ABORTED, (int) $freshJobItem->getState());
+
+    // The same goes for an accepted request.
+    $freshJobItem->setState(JobItemInterface::STATE_ACCEPTED);
+    $this->populateAndConsumeQueue();
+    $jobItems = $job->getItems($filter);
+    $this->assertCount(3, $jobItems);
+    $this->assertSame(JobItemInterface::STATE_ACCEPTED, (int) $jobItems[$freshJobItem->id()]->getState());
+    unset($jobItems[$jobItem->id()], $jobItems[$freshJobItem->id()]);
+    $this->assertNotSame(JobItemInterface::STATE_ACCEPTED, (int) reset($jobItems)->getState());
+  }
+
