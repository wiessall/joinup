+    $assertSession->waitForField('File to import')
+      ?->attachFile($this->container->get('file_system')->realpath($tmpfilePath));
+
+    $this->assertNotEmpty($assertSession->waitForButton('Remove'));
+    $this->getSession()->getPage()->findButton('Import')->click();
+
+    $assertSession->statusMessageContainsAfterWait(
+      sprintf('%s items imported to the %s translation from the %s Spreadsheet file.',
+        $countTranslationsImported,
+        \Drupal::languageManager()->getLanguage(static::LANGCODE)->getName(),
+        basename($tmpfilePath),
+      )
+    );
+  }
+
+  /**
+   * Prepare CSV from source array.
+   *
+   * @param array $sources
+   *   The sources data for the file. Each item
+   *   should be a string to translate or an array
+   *   with string to translate, the translated
+   *   string and notes.
+   *
+   * @return array
+   *   Each row of the array will be a new line
+   *   in the CSV file.
+   */
+  protected function getCsvFromSources(array $sources): array {
+    $csv = ['"Source string (do not edit)","Translated string","Context (do not edit)","Plural variant (do not edit)","URL","ID (do not edit)"'];
+    foreach ($sources as $source) {
+      if (is_array($source)) {
+        $source_string = implode(PoItem::DELIMITER, array_keys($source));
+        foreach ($source as $key => $values) {
+          $csv[] = '"' . $key . '","' . $values[0] . '","","' . $values[1] . '","","' . (new Source($source_string, ''))->getHash() . '"';
+        }
+      }
+      else {
+        $csv[] = '"' . $source . '","","","","","' . (new Source($source, ''))->getHash() . '"';
+      }
+    }
+
+    return $csv;
+  }
