diff --git a/babel.install b/babel.install
index 5fc183db30d92d065f346eb2e0a8a5601d2819bb..081ef9154488e50da7234f616a5289a6de5e1227 100644
--- a/babel.install
+++ b/babel.install
@@ -9,6 +9,8 @@ declare(strict_types=1);
 
 use Drupal\babel\BabelBatchProcessor;
 use Drupal\babel\BabelConfigHelper;
+use Drupal\babel\BabelStorageInterface;
+use Drupal\babel\Model\Source;
 use Drupal\Core\Batch\BatchBuilder;
 
 /**
@@ -94,3 +96,41 @@ function babel_install(): void {
   }
   batch_set($batch->toArray());
 }
+
+/**
+ * Restore Locale IDs after #3545152.
+ */
+function babel_update_8001(): void {
+  $db = \Drupal::database();
+  $storage = \Drupal::service(BabelStorageInterface::class);
+
+  // Pay respect to current statuses.
+  $query = $db->select('babel_source_instance', 'bsi')
+    ->distinct()
+    ->fields('bs', ['hash', 'status'])
+    ->orderBy('bs.status');
+  $query->innerJoin('babel_source', 'bs', 'bsi.hash = bs.hash');
+  $status = $query->execute()->fetchAllKeyed();
+
+  // Remove all 'locale' source string instances.
+  $storage->delete('locale');
+
+  $rows = \Drupal::database()->select('locales_source', 'ls')
+    ->fields('ls', ['lid', 'source', 'context'])
+    ->execute()
+    ->fetchAll(\PDO::FETCH_NUM);
+
+  $sources = [];
+  foreach ($rows as [$lid, $source, $string_context]) {
+    $source = new Source(string: $source, context: $string_context);
+
+    // Preserve existing status.
+    if (isset($status[$source->getHash()])) {
+      $source->setStatus((bool) $status[$source->getHash()]);
+    }
+
+    $sources[$lid] = $source;
+  }
+
+  $storage->update('locale', $sources);
+}
