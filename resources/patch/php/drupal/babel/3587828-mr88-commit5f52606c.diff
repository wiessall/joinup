+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\babel_og_menu_link\Hook;
+
+use Drupal\Core\Hook\Attribute\Hook;
+use Drupal\babel\BabelStorageInterface;
+use Drupal\babel\Plugin\Babel\TranslationTypePluginManager;
+use Drupal\babel_og_menu_link\BabelOgMenuLinkManager;
+use Drupal\menu_link_content\MenuLinkContentInterface;
+use Drupal\og_menu\OgMenuInterface;
+
+/**
+ * Babel Organic Group menu link content CRUD operations hooks.
+ */
+class BabelOgMenuLinkContentHook {
+
+  public function __construct(
+    protected readonly TranslationTypePluginManager $translationTypePluginManager,
+    protected readonly BabelOgMenuLinkManager $ogLinkManager,
+    protected readonly BabelStorageInterface $babelStorage,
+  ) {}
+
+  /**
+   * Implements hook_ENTITY_TYPE_insert() for menu_link_content entity type.
+   */
+  #[Hook('menu_link_content_insert')]
+  public function insertMenuLinkContent(MenuLinkContentInterface $link): void {
+    $this->ogLinkManager->updateSourcesForLink($link);
+  }
+
+  /**
+   * Implements hook_ENTITY_HOOK_presave() for menu_link_content entity type.
+   */
+  #[Hook('menu_link_content_presave')]
+  public function presaveMenuLinkContent(MenuLinkContentInterface $link): void {
+    $this->ogLinkManager->handleTranslatablePropertyChange($link);
+  }
+
+  /**
+   * Implements hook_ENTITY_HOOK_update() for menu_link_content entity type.
+   */
+  #[Hook('menu_link_content_update')]
+  public function updateMenuLinkContent(MenuLinkContentInterface $link): void {
+    $this->ogLinkManager->updateSourcesForLink($link);
+  }
+
+  /**
+   * Implements hook_ENTITY_TYPE_delete() for menu_link_content entity type.
+   */
+  #[Hook('menu_link_content_delete')]
+  public function deleteMenuLinkContent(MenuLinkContentInterface $link): void {
+    if (!$link->isDefaultTranslation()) {
+      return;
+    }
+    $ogMenuType = $this->ogLinkManager->getOgMenuIdFromLink($link);
+    if (!$ogMenuType) {
+      return;
+    }
+    $this->babelStorage->delete('babel_og_menu_link', "$ogMenuType:{$link->id()}:");
+  }
+
+  /**
+   * Implements hook_ENTITY_TYPE_delete() for an OG menu entity type.
+   *
+   * This config entity is the bundle entity type of ogmenu instance content
+   * entities.
+   */
+  #[Hook('ogmenu_delete')]
+  public function deleteOgMenuType(OgMenuInterface $ogMenuType): void {
+    $this->babelStorage->delete('babel_og_menu_link', "{$ogMenuType->id()}:");
+  }
+
+}
diff --git a/modules/babel_og_menu_link/src/Plugin/Babel/TranslationType/BabelOgMenuLink.php b/modules/babel_og_menu_link/src/Plugin/Babel/TranslationType/BabelOgMenuLink.php
new file mode 100644
index 0000000000000000000000000000000000000000..8ab74d576a6d29d96f94c6e40ed9a04e78fa6e14
--- /dev/null
+++ b/modules/babel_og_menu_link/src/Plugin/Babel/TranslationType/BabelOgMenuLink.php
@@ -0,0 +1,429 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\babel_og_menu_link\Plugin\Babel\TranslationType;
+
+use Drupal\Component\Datetime\TimeInterface;
+use Drupal\Component\Plugin\PluginBase;
+use Drupal\Core\Database\Connection;
+use Drupal\Core\DependencyInjection\DependencySerializationTrait;
+use Drupal\Core\Entity\ContentEntityStorageInterface;
+use Drupal\Core\Entity\EntityTypeManagerInterface;
+use Drupal\Core\Entity\Sql\SqlEntityStorageInterface;
+use Drupal\Core\Form\FormStateInterface;
+use Drupal\Core\Logger\LoggerChannelInterface;
+use Drupal\Core\Plugin\PluginFormInterface;
+use Drupal\Core\Session\AccountProxyInterface;
+use Drupal\Core\StringTranslation\TranslatableMarkup;
+use Drupal\babel\BabelStorageInterface;
+use Drupal\babel\Model\Source;
+use Drupal\babel\Model\StringTranslation;
+use Drupal\babel\Model\Translation;
+use Drupal\babel\Plugin\Babel\TranslationType;
+use Drupal\babel\Plugin\Babel\TranslationTypePluginBase;
+use Drupal\babel\StringsCollectorFactory;
+use Drupal\babel_og_menu_link\BabelOgMenuLinkManager;
+use Drupal\content_translation\ContentTranslationManagerInterface;
+use Drupal\menu_link_content\MenuLinkContentInterface;
+use Drupal\mysql\Driver\Database\mysql\Connection as MysqlConnection;
+use Drupal\og_menu\OgMenuInterface;
+use Drupal\pgsql\Driver\Database\pgsql\Connection as PostgresqlConnection;
+use Drupal\sqlite\Driver\Database\sqlite\Connection as SqliteConnection;
+use Drupal\user\UserInterface;
+use Symfony\Component\DependencyInjection\ContainerInterface;
+
+/**
+ * Translation type plugin for menu links of Organic Group menus.
+ */
+#[TranslationType(
+  id: 'babel_og_menu_link',
+  label: new TranslatableMarkup('Organic Group menu links'),
+  status: TRUE,
+)]
+class BabelOgMenuLink extends TranslationTypePluginBase implements PluginFormInterface {
+
+  use DependencySerializationTrait;
+
+  public function __construct(
+    array $configuration,
+    string $pluginId,
+    array $pluginDefinition,
+    BabelStorageInterface $babelStorage,
+    StringsCollectorFactory $collectorFactory,
+    protected readonly EntityTypeManagerInterface $entityTypeManager,
+    protected readonly BabelOgMenuLinkManager $ogLinkManager,
+    protected readonly AccountProxyInterface $currentUser,
+    protected readonly TimeInterface $time,
+    protected readonly LoggerChannelInterface $logger,
+    protected readonly Connection $database,
+    protected readonly ?ContentTranslationManagerInterface $contentTranslationManager,
+  ) {
+    parent::__construct($configuration, $pluginId, $pluginDefinition, $babelStorage, $collectorFactory);
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public static function create(ContainerInterface $container, array $configuration, $plugin_id, $plugin_definition): self {
+    return new static(
+      $configuration,
+      $plugin_id,
+      $plugin_definition,
+      $container->get(BabelStorageInterface::class),
+      $container->get(StringsCollectorFactory::class),
+      $container->get('entity_type.manager'),
+      $container->get(BabelOgMenuLinkManager::class),
+      $container->get('current_user'),
+      $container->get('datetime.time'),
+      $container->get('logger.channel.babel'),
+      $container->get('database'),
+      $container->get('content_translation.manager', ContainerInterface::NULL_ON_INVALID_REFERENCE),
+    );
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function defaultConfiguration(): array {
+    return [
+      'og_menu' => [],
+    ];
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function getStrings(string $langcode, array $ids = []): array {
+    $storage = $this->getMenuLinkStorage();
+    if ($storage instanceof SqlEntityStorageInterface) {
+      return $this->getStringsSql($langcode, $ids);
+    }
+
+    foreach ($this->getStringsFromDatabase($ids)->execute() as $row) {
+      [, $lid, $fieldName, $delta] = explode(PluginBase::DERIVATIVE_SEPARATOR, $row->id);
+      $lids[$lid][] = [
+        'fieldName' => $fieldName,
+        'delta' => $delta,
+        'babelId' => $row->id,
+        'status' => (bool) $row->status,
+      ];
+    }
+    if (!$lids) {
+      return [];
+    }
+
+    $strings = [];
+    foreach ($storage->loadMultiple(array_keys($lids)) as $lid => $link) {
+      assert($link instanceof MenuLinkContentInterface);
+      $hasTranslation = $link->hasTranslation($langcode);
+      if ($hasTranslation) {
+        $translated = $link->getTranslation($langcode);
+      }
+
+      foreach ($lids[$lid] as $sourceData) {
+        [
+          'fieldName' => $fieldName,
+          'delta' => $delta,
+          'babelId' => $id,
+          'status' => $status,
+        ] = $sourceData;
+        $source = $link->get($fieldName)?->get($delta)->getString();
+
+        if (!$source) {
+          continue;
+        }
+
+        $translatedString = $hasTranslation
+          ? $translated?->get($fieldName)?->get($delta)?->getString()
+          : NULL;
+        $translation = $translatedString ? new Translation(
+          language: $langcode,
+          string: $translatedString,
+        ) : NULL;
+        $strings[$id] = new StringTranslation(
+          source: new Source(string: $source, context: '', status: $status),
+          translation: $translation,
+        );
+      }
+    }
+
+    return $strings;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function updateTranslation(StringTranslation $string, string $id, string $langcode, string $translation): void {
+    if (!$this->contentTranslationManager) {
+      return;
+    }
+    parent::updateTranslation($string, $id, $langcode, $translation);
+
+    [, $lid, $fieldName, $delta] = explode(':', $id);
+    $storage = $this->getMenuLinkStorage();
+    $link = $storage->load($lid);
+    if (!$link instanceof MenuLinkContentInterface) {
+      return;
+    }
+    if (!$this->contentTranslationManager->isEnabled($link->getEntityTypeId(), $link->bundle())) {
+      return;
+    }
+
+    $translatableFields = $this->getTranslatableFields();
+
+    $translated = $link->hasTranslation($langcode)
+      ? $link->getTranslation($langcode)
+      : $link->addTranslation($langcode, $link->toArray());
+    $metadata = $this->contentTranslationManager->getTranslationMetadata($translated);
+
+    if ($translated->isNewTranslation()) {
+      // Update the translation creation time and source.
+      $metadata->setCreatedTime($this->time->getRequestTime());
+      $metadata->setSource($link->getUntranslated()->language()->getId());
+    }
+
+    $user = $this->entityTypeManager->getStorage('user')->load($this->currentUser->id());
+    \assert($user instanceof UserInterface);
+    $metadata->setAuthor($user);
+    $metadata->setChangedTime($this->time->getRequestTime());
+
+    $translated->get($fieldName)->set($delta, $translation ?: $link->get($fieldName)->getValue()[$delta]);
+
+    // Translation must validate to be saved.
+    $violations = $translated->validate();
+    if (!$violations->count()) {
+      $source = array_intersect_key($link->toArray(), $translatableFields);
+      $trans = array_intersect_key($translated->toArray(), $translatableFields);
+      if ($source !== $trans) {
+        $translated->save();
+        return;
+      }
+    }
+    else {
+      $message = $translated->isNewTranslation()
+        ? "New translation wasn't saved."
+        : "Translation was deleted.";
+      $this->logger->warning(
+        $message . ' The automatically created translation of @label @type_label_singular does not validate after @property value was changed to "@value".',
+        [
+          '@label' => $link->getLabel(),
+          '@type_label_singular' => $link->getEntityType()->getSingularLabel(),
+          '@property' => $fieldName,
+          '@value' => $translation,
+        ],
+      );
+    }
+
+    if (!$translated->isNewTranslation()) {
+      $link->removeTranslation($langcode);
+      $link->save();
+    }
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function buildConfigurationForm(array $form, FormStateInterface $form_state): array {
+    $form['og_menu'] = [
+      '#type' => 'checkboxes',
+      '#title' => $this->t('Limit to specific Organic Group menus'),
+      '#options' => array_map(
+        fn (OgMenuInterface $ogMenuType): string => $ogMenuType->label(),
+        $this->entityTypeManager->getStorage('ogmenu')->loadMultiple(),
+      ),
+      '#default_value' => $this->getConfiguration()['og_menu'],
+    ];
+
+    return $form;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function validateConfigurationForm(array &$form, FormStateInterface $form_state): void {}
+
+  /**
+   * {@inheritdoc}
+   */
+  public function submitConfigurationForm(array &$form, FormStateInterface $form_state): void {
+    $configuration['og_menu'] = array_keys(array_filter($form_state->getValues()['og_menu']));
+    $this->setConfiguration($configuration);
+  }
+
+  /**
+   * Returns the specified (or all) strings of the plugin with one SQL query.
+   *
+   * @param string $langcode
+   *   The language code of the translations to include.
+   * @param array $ids
+   *   The string identifiers to filter for. All strings are returned if this
+   *   parameter is an empty array.
+   *
+   * @return array<string, \Drupal\babel\Model\StringTranslation>
+   *   List of strings keyed by the source ID.
+   */
+  protected function getStringsSql(string $langcode, array $ids): array {
+    $translatableFields = $this->getTranslatableFields();
+    $query = $this->database->select('babel_source_instance', 'bsi')
+      ->fields('bsi', ['id'])
+      ->condition('bsi.plugin', $this->getPluginId());
+    if ($ids) {
+      $query->condition('bsi.id', $ids, 'IN');
+    }
+    $query->innerJoin('babel_source', 'bs', 'bsi.hash = bs.hash');
+    $query->addField('bs', 'status');
+    $query->leftJoin('babel_source_lock', 'bl', 'bsi.hash = bl.hash AND bl.langcode = :langcode', [':langcode' => $langcode]);
+    $query->addField('bl', 'langcode', 'locked');
+    $query->innerJoin(
+      'menu_link_content_data', 'md', $this->getMenuLinkDataJoinConditions('md', 'bsi'));
+    $query->fields('md', $translatableFields);
+    $query->leftJoin('menu_link_content_data', 'mdt', 'mdt.id = md.id AND mdt.langcode = :langcode', [':langcode' => $langcode]);
+    foreach ($translatableFields as $field) {
+      $query->addField('mdt', $field, "{$field}_trans");
+    }
+
+    $strings = [];
+    foreach ($query->execute()->fetchAll() as $record) {
+      [, , $property] = explode(PluginBase::DERIVATIVE_SEPARATOR, $record->id);
+      $transProperty = "{$property}_trans";
+      $translation = is_string($record->$transProperty)
+        ? new Translation($langcode, $record->$transProperty)
+        : NULL;
+      $strings[$record->id] = new StringTranslation(
+        source: new Source(string: $record->$property, context: '', status: (bool) $record->status),
+        translation: $translation,
+        locked: (bool) $record->locked,
+      );
+    }
+    return $strings;
+  }
+
+  /**
+   * Returns the menu_link_content storage.
+   *
+   * @return \Drupal\Core\Entity\ContentEntityStorageInterface
+   *   The current storage object of menu_link_content entities.
+   */
+  protected function getMenuLinkStorage(): ContentEntityStorageInterface {
+    static $storage;
+    if (!$storage instanceof ContentEntityStorageInterface) {
+      $storage = $this->entityTypeManager->getStorage('menu_link_content');
+      assert($storage instanceof ContentEntityStorageInterface);
+    }
+    return $storage;
+  }
+
+  /**
+   * Returns the list of the translatable fields.
+   *
+   * @return array<string, string>
+   *   The list of the translatable fields, keys and values both.
+   */
+  protected function getTranslatableFields(): array {
+    static $translatableFields;
+    if (!isset($translatableFields)) {
+      $link = $this->getMenuLinkStorage()->createWithSampleValues('menu_link_content');
+      $translatableFieldsUnfiltered = $link->getTranslatableFields(FALSE);
+      // Ignore language property and fields which are provided by
+      // content_translation.
+      $translatableFields = array_diff_key(
+        $translatableFieldsUnfiltered,
+        array_combine(
+          BabelOgMenuLinkManager::EXCLUDED_FIELDS,
+          BabelOgMenuLinkManager::EXCLUDED_FIELDS,
+        )
+      );
+
+      return $translatableFields = array_combine(
+        array_keys($translatableFields),
+        array_keys($translatableFields),
+      );
+    }
+
+    return $translatableFields;
+  }
+
+  /**
+   * Returns the join conditions between babel_source_instance and menu data.
+   *
+   * This method acts as a wrapper around "doGetMenuLinkDataJoinCondition".
+   * If this triggered a type error, it means Menu Link Content entities are
+   * using a SQL backend which is not yet supported. In this case you probably
+   * want to decorate this service, and develop the missing join condition which
+   * allows to connect records in "babel_source_instance" to the records in
+   * "menu_link_content_data". In the decorator, you can override this method,
+   * and you can also support the other SQL backends by calling
+   * ::doGetMenuLinkDataJoinCondition.
+   * We, Babel developers, are waiting for your patch!
+   *
+   * @param string $mdAlias
+   *   The alias to use for the "menu_link_content_data" table.
+   * @param string $bsiAlias
+   *   The alias to use for the "babel_source_instance" table.
+   *
+   * @return string
+   *   The join conditions between "babel_source_instance" and
+   *   "menu_link_content_data" tables.
+   */
+  protected function getMenuLinkDataJoinConditions(string $mdAlias, string $bsiAlias): string {
+    // If you made it this far it means you hit a type error. You're using a
+    // DB backend which is not supported by default by Drupal core. You probably
+    // want to decorate this service, and develop the missing join condition
+    // which allows to connect records in "babel_source_instance" to the records
+    // in "menu_link_content_data".
+    // We, Babel developers, are waiting for your patch!
+    return implode(' AND ', [
+      $this->doGetMenuLinkDataJoinCondition($mdAlias, $bsiAlias),
+      "$mdAlias.default_langcode = 1",
+    ]);
+  }
+
+  /**
+   * Returns the join conditions between babel_source_instance and menu data.
+   *
+   * @param string $mdAlias
+   *   The alias to use for the "menu_link_content_data" table.
+   * @param string $bsiAlias
+   *   The alias to use for the "babel_source_instance" table.
+   *
+   * @return string
+   *   The join conditions between "babel_source_instance" and
+   *    "menu_link_content_data" tables.
+   *
+   * @throws \Exception
+   *    When the current SQL database backend is not supported.
+   */
+  protected function doGetMenuLinkDataJoinCondition(string $mdAlias, string $bsiAlias): string {
+    if ($this->database instanceof MysqlConnection) {
+      return sprintf(
+        "CONCAT('-', %s.id) = REPLACE(SUBSTRING(SUBSTRING_INDEX(%s.id, ':', 2),CHAR_LENGTH(SUBSTRING_INDEX(%s.id,':',1))+1),':','-')",
+        $mdAlias,
+        $bsiAlias,
+        $bsiAlias,
+      );
+    }
+
+    if ($this->database instanceof PostgresqlConnection) {
+      return sprintf(
+        "%s.id = CAST(SPLIT_PART(%s.id, ':', 2) as int)",
+        $mdAlias,
+        $bsiAlias,
+      );
+    }
+
+    if ($this->database instanceof SqliteConnection) {
+      return sprintf(
+        "%s.id = SUBSTR(SUBSTR(%s.id, INSTR(%s.id, ':')+1), 0, INSTR(SUBSTR(%s.id, INSTR(%s.id, ':')+1), ':'))",
+        $mdAlias,
+        $bsiAlias,
+        $bsiAlias,
+        $bsiAlias,
+        $bsiAlias,
+      );
+    }
+
+    throw new \Exception('Current SQL storage backend of menu link content entities is not supported.');
+  }
+
+}
diff --git a/modules/babel_og_menu_link/tests/src/Functional/BabelOgMenuLinkTranslationTest.php b/modules/babel_og_menu_link/tests/src/Functional/BabelOgMenuLinkTranslationTest.php
new file mode 100644
index 0000000000000000000000000000000000000000..e26166da2d3be9a6ff690254cef328c2d14629e1
--- /dev/null
+++ b/modules/babel_og_menu_link/tests/src/Functional/BabelOgMenuLinkTranslationTest.php
@@ -0,0 +1,161 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\babel_og_menu_link\Functional;
+
+use Drupal\babel\Model\StringTranslation;
+use Drupal\babel\Model\Translation;
+use Drupal\babel\Plugin\Babel\TranslationTypePluginManager;
+use Drupal\babel_og_menu_link\Plugin\Babel\TranslationType\BabelOgMenuLink;
+use Drupal\content_translation\ContentTranslationManagerInterface;
+use Drupal\language\Entity\ConfigurableLanguage;
+use Drupal\menu_link_content\MenuLinkContentInterface;
+use Drupal\Tests\babel\Traits\ModuleInstallHelperTrait;
+use Drupal\Tests\babel\Traits\TranslationAssertionTrait;
+use Drupal\Tests\babel_og_menu_link\Traits\OgMenuLinkTestSetupTrait;
+use Drupal\Tests\BrowserTestBase;
+use Drupal\Tests\content_translation\Traits\ContentTranslationTestTrait;
+use Drupal\user\UserInterface;
+use PHPUnit\Framework\Attributes\Group;
+use PHPUnit\Framework\Attributes\RunTestsInSeparateProcesses;
+
+/**
+ * Test OG Menu Link translation functionality.
+ *
+ * @group babel
+ * @group babel_og_menu_link
+ */
+#[Group('babel')]
+#[Group('babel_og_menu_link')]
+#[RunTestsInSeparateProcesses]
+class BabelOgMenuLinkTranslationTest extends BrowserTestBase {
+
+  use ContentTranslationTestTrait;
+  use OgMenuLinkTestSetupTrait;
+  use ModuleInstallHelperTrait;
+  use TranslationAssertionTrait;
+
+  /**
+   * {@inheritdoc}
+   */
+  protected $defaultTheme = 'stark';
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'babel_og_menu_link',
+    'entity_test',
+    'og_menu',
+    'user',
+    'content_translation',
+  ];
+
+  /**
+   * The user account being able to use Babel UI.
+   *
+   * @var \Drupal\user\UserInterface
+   */
+  protected UserInterface $translator;
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+
+    $this->setupOgMenuLinkTest();
+
+    $this->enableContentTranslation('menu_link_content', 'menu_link_content');
+
+    $this->config('babel.settings')
+      ->set(
+        'translation_type.plugin.babel_og_menu_link.og_menu',
+        [$this->ogMenuId],
+      )
+      ->save();
+
+    $this->runInstallBatchOperations();
+
+    $this->translator = $this->createUser(['translate interface']);
+    $this->translator->save();
+
+    ConfigurableLanguage::createFromLangcode('is')->save();
+  }
+
+  /**
+   * Tests how OG Menu Link translations work with Babel.
+   */
+  public function testSourceAndTranslationUpdate(): void {
+    $menuLinkStorage = \Drupal::entityTypeManager()->getStorage('menu_link_content');
+    $menuLinkContent = $menuLinkStorage->create([
+      'title' => 'Babel OG Menu Link',
+      'description' => 'This is the description of the test OG Menu Link',
+      'link' => ['uri' => 'route:<front>'],
+      'menu_name' => "ogmenu-{$this->ogMenuInstance->id()}",
+    ]);
+    $this->assertInstanceOf(MenuLinkContentInterface::class, $menuLinkContent);
+    $menuLinkContent->save();
+    // Create another menu link.
+    $otherLink = $menuLinkStorage->create([
+      'title' => 'Other',
+      'link' => ['uri' => 'route:<front>'],
+      'menu_name' => "ogmenu-{$this->ogMenuInstance->id()}",
+    ]);
+    $otherLink->save();
+
+    // There must be one babel_og_menu_link source discovered.
+    $plugin = $this->container->get(TranslationTypePluginManager::class)->createInstance('babel_og_menu_link');
+    $this->assertInstanceOf(BabelOgMenuLink::class, $plugin);
+    $strings = $plugin->getStrings('is');
+    $titleStringKey = "{$this->ogMenuId}:{$menuLinkContent->id()}:title:0";
+    $this->assertArrayHasKey($titleStringKey, $strings);
+
+    $assertSession = $this->assertSession();
+    $this->drupalLogin($this->translator);
+    $this->drupalGet('/admin/config/regional/babel/is');
+    $assertSession->statusCodeEquals(200);
+
+    $this->submitForm([
+      'edit-search' => 'Babel OG Menu Link',
+    ], 'Filter');
+    $assertSession->pageTextContains('One item matches the criteria');
+    // Let's find the save button of the row containing the link's source text.
+    $this->translateSourceStringTo('Babel OG Menu Link', '[IS] Babel OG Menu Link');
+
+    // Translation is saved.
+    $menuLinkContent = $menuLinkStorage->loadUnchanged($menuLinkContent->id());
+    $this->assertTrue($menuLinkContent->hasTranslation('is'));
+    $this->assertSame($menuLinkContent->getTranslation('is')->label(), '[IS] Babel OG Menu Link');
+
+    $string = current($plugin->getStrings('is', [$titleStringKey])) ?: NULL;
+    $this->assertInstanceOf(StringTranslation::class, $string);
+    $this->assertInstanceOf(Translation::class, $string->getTranslation());
+
+    // If the label is changed the translation of the menu link must be flagged
+    // as outdated.
+    $menuLinkContent->set('title', 'New Babel OG Menu Link label')->save();
+    $menuLinkContent = $menuLinkStorage->loadUnchanged($menuLinkContent->id());
+    // All translation must be marked as outdated.
+    $this->assertTrue($menuLinkContent->hasTranslation('is'));
+    $contentTranslationManager = \Drupal::service('content_translation.manager');
+    $this->assertInstanceOf(ContentTranslationManagerInterface::class, $contentTranslationManager);
+    $this->assertTrue($contentTranslationManager->getTranslationMetadata($menuLinkContent->getTranslation('is'))->isOutDated());
+
+    // If the link is deleted the source must be cleared from Babel.
+    $menuLinkContent->delete();
+    $strings = $plugin->getStrings('is');
+    $this->assertArrayNotHasKey($titleStringKey, $strings);
+    // But the source of the other menu link must be present.
+    $otherKey = "{$this->ogMenuId}:{$otherLink->id()}:title:0";
+    $this->assertArrayHasKey($otherKey, $strings);
+
+    // If the Og menu Link instance is deleted, the leftover source (along with
+    // the other menu link) must be removed.
+    $this->ogMenuInstance->delete();
+    $strings = $plugin->getStrings('is');
+    $this->assertArrayNotHasKey($otherKey, $strings);
+  }
+
+}
diff --git a/modules/babel_og_menu_link/tests/src/Kernel/BabelOgMenuLinkInstallUninstallTest.php b/modules/babel_og_menu_link/tests/src/Kernel/BabelOgMenuLinkInstallUninstallTest.php
new file mode 100644
index 0000000000000000000000000000000000000000..6358e6687e52a5e53a59a6dbdd2c7d6d2d115531
--- /dev/null
+++ b/modules/babel_og_menu_link/tests/src/Kernel/BabelOgMenuLinkInstallUninstallTest.php
@@ -0,0 +1,152 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\babel_og_menu_link\Kernel;
+
+use Drupal\babel\Plugin\Babel\TranslationTypePluginManager;
+use Drupal\babel_og_menu_link\Plugin\Babel\TranslationType\BabelOgMenuLink;
+use Drupal\Core\Extension\ModuleInstallerInterface;
+use Drupal\KernelTests\KernelTestBase;
+use Drupal\language\Entity\ConfigurableLanguage;
+use Drupal\menu_link_content\Entity\MenuLinkContent;
+use Drupal\Tests\babel\Traits\ModuleInstallHelperTrait;
+use Drupal\Tests\babel_og_menu_link\Traits\OgMenuLinkTestSetupTrait;
+use Drupal\Tests\content_translation\Traits\ContentTranslationTestTrait;
+use PHPUnit\Framework\Attributes\Group;
+use PHPUnit\Framework\Attributes\RunTestsInSeparateProcesses;
+
+/**
+ * Tests translation related functions of OG Menu links.
+ *
+ * @group babel
+ * @group babel_og_menu_link
+ */
+#[Group('babel')]
+#[Group('babel_og_menu_link')]
+#[RunTestsInSeparateProcesses]
+class BabelOgMenuLinkInstallUninstallTest extends KernelTestBase {
+
+  use ContentTranslationTestTrait;
+  use ModuleInstallHelperTrait;
+  use OgMenuLinkTestSetupTrait;
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'babel',
+    'babel_og_menu_link',
+    'content_translation',
+    'entity_test',
+    'field',
+    'language',
+    'link',
+    'locale',
+    'menu_link_content',
+    'og',
+    'og_menu',
+    'options',
+    'system',
+    'user',
+  ];
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+
+    $this->installConfig(['language']);
+    $this->installConfig(['og']);
+    $this->installEntitySchema('entity_test');
+    $this->installEntitySchema('menu_link_content');
+    $this->installEntitySchema('og_membership');
+    $this->installEntitySchema('ogmenu');
+    $this->installEntitySchema('ogmenu_instance');
+    $this->installEntitySchema('user');
+    $this->installSchema('system', 'sequences');
+    $this->installSchema('user', 'users_data');
+    $this->installSchema('babel', [
+      'babel_source_instance',
+      'babel_source',
+      'babel_source_lock',
+    ]);
+
+    $this->setupOgMenuLinkTest();
+
+    $this->runInstallBatchOperations();
+
+    $this->enableContentTranslation('menu_link_content', 'menu_link_content');
+
+    // Create some menu link in the OG Menu Instance.
+    foreach (range(1, 3) as $i) {
+      MenuLinkContent::create([
+        'title' => "Link $i",
+        'description' => "Link description $i",
+        'link' => ['uri' => 'route:<front>'],
+        'menu_name' => "ogmenu-{$this->ogMenuInstance->id()}",
+      ])->save();
+    }
+
+    ConfigurableLanguage::createFromLangcode('is')->save();
+
+    $this->container->get('kernel')->rebuildContainer();
+  }
+
+  /**
+   * Tests how Babel OG Menu Link is (un)installed with Config Manager.
+   *
+   * When a module is installed by a config sync process, the module is
+   * installed first, then comes the configuration synchronization process, and
+   * last, the created batch processes are executed.
+   *
+   * This test mimics this operation without the need for a dedicated
+   * configuration export.
+   */
+  public function testInstallUninstall(): void {
+    // Babel OG Menu Link module is already installed, next step is changing the
+    // configuration.
+    $this->config('babel.settings')
+      ->set(
+        'translation_type.plugin.babel_og_menu_link.og_menu',
+        [$this->ogMenuId],
+      )
+      ->save();
+
+    // The batch set because of the config change is executed.
+    $this->runInstallBatchOperations();
+
+    // There must be three babel_og_menu_link source discovered.
+    $plugin = $this->container->get(TranslationTypePluginManager::class)->createInstance('babel_og_menu_link');
+    $this->assertInstanceOf(BabelOgMenuLink::class, $plugin);
+    $strings = $plugin->getStrings('is');
+    $this->assertCount(6, $plugin->getStrings('is'));
+
+    // Update the translation of the first link's description.
+    $plugin->updateTranslation(
+      $strings['test_og_menu:1:description:0'],
+      'test_og_menu:1:description:0',
+      'is',
+      '[IS] Link description 1',
+    );
+
+    // Translation must be saved.
+    $this->assertTrue(MenuLinkContent::load(1)->hasTranslation('is'));
+
+    // After uninstall, no source instance is expected.
+    $moduleInstaller = $this->container->get('module_installer');
+    $this->assertInstanceOf(ModuleInstallerInterface::class, $moduleInstaller);
+    $this->assertTrue($moduleInstaller->uninstall(['babel_og_menu_link']));
+
+    // This only can be done in a kernel test: plugin is loaded and is still
+    // available in this PHP process, we can check how many OG links left in the
+    // Babel tables.
+    $this->assertCount(0, $plugin->getStrings('is'));
+
+    // Menu link must still have its Icelandic translation.
+    \Drupal::entityTypeManager()->getStorage('menu_link_content')->resetCache([1]);
+    $this->assertTrue(MenuLinkContent::load(1)->hasTranslation('is'));
+  }
+
+}
diff --git a/modules/babel_og_menu_link/tests/src/Traits/OgMenuLinkTestSetupTrait.php b/modules/babel_og_menu_link/tests/src/Traits/OgMenuLinkTestSetupTrait.php
new file mode 100644
index 0000000000000000000000000000000000000000..37828f4a5a0b760a03e58adab1434dc1e4b972de
--- /dev/null
+++ b/modules/babel_og_menu_link/tests/src/Traits/OgMenuLinkTestSetupTrait.php
@@ -0,0 +1,123 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\babel_og_menu_link\Traits;
+
+use Drupal\entity_test\Entity\EntityTest;
+use Drupal\og\Entity\OgMembership;
+use Drupal\og\Og;
+use Drupal\og\OgGroupAudienceHelperInterface;
+use Drupal\og\OgMembershipInterface;
+use Drupal\og_menu\Entity\OgMenu;
+use Drupal\og_menu\Entity\OgMenuInstance;
+use Drupal\user\Entity\Role;
+use Drupal\user\Entity\User;
+
+/**
+ * Trait for setting up an OG Menu test environment.
+ */
+trait OgMenuLinkTestSetupTrait {
+
+  /**
+   * ID of the OG Menu entity created in the ::setupOgMenuLinkTest method.
+   *
+   * @var string
+   */
+  protected string $ogMenuId = 'test_og_menu';
+
+  /**
+   * A test OG Menu instance.
+   *
+   * @var \Drupal\og_menu\Entity\OgMenuInstance
+   */
+  protected OgMenuInstance $ogMenuInstance;
+
+  /**
+   * Creates an OG Menu link test environment with OG group, users, OG menu.
+   */
+  protected function setupOgMenuLinkTest(): void {
+    if (!User::load(1)) {
+      \Drupal::moduleHandler()->loadInclude('user', 'install');
+      user_install();
+    }
+
+    // Create an 'OG administrator' user who has the global
+    // 'administer organic groups' permission.
+    // This user should be able to access everything related to any group.
+    $ogAdminRole = Role::create(['id' => 'og_admin', 'label' => 'og_admin']);
+    $ogAdminRole->grantPermission('administer organic groups')->save();
+    $ogAdmin = User::create([
+      'name' => $this->randomString(),
+      'roles' => [$ogAdminRole->id()],
+    ]);
+    $ogAdmin->save();
+
+    // Create an 'OG Menu administrator' user who will get the global
+    // permissions to manage any OG menu.
+    $ogMenuAdminRole = Role::create([
+      'id' => 'og_menu_admin',
+      'label' => 'og_menu_admin',
+    ]);
+    $ogMenuAdminRole
+      ->grantPermission('administer og menu')
+      ->save();
+
+    $ogMenuAdmin = User::create([
+      'name' => $this->randomString(),
+      'roles' => [$ogMenuAdminRole->id()],
+    ]);
+    $ogMenuAdmin->save();
+
+    // Create a 'group administrator' user who is a normal authenticated user
+    // but has the administrator role within a particular group. By default this
+    // user should be able to access everything related to their own group.
+    $groupAdmin = User::create(['name' => $this->randomString()]);
+    $groupAdmin->save();
+
+    // Create a 'group member' user who is a normal authenticated user and a
+    // member of a particular group. This user should only be able to access
+    // operations for which permission has been explicitly granted.
+    $groupMember = User::create(['name' => $this->randomString()]);
+    $groupMember->save();
+
+    // Create an 'authenticated' user who does not have any special permissions.
+    $user = User::create(['name' => $this->randomString()]);
+    $user->save();
+
+    Og::groupTypeManager()->addGroup('entity_test', 'entity_test_group_type');
+
+    // Create a group and associate with the group administrator. This user will
+    // be subscribed to the group and inherit the administrator role
+    // automatically.
+    $group = EntityTest::create([
+      'type' => 'entity_test_group_type',
+      'name' => $this->randomString(),
+      'user_id' => $groupAdmin->id(),
+    ]);
+    $group->save();
+
+    // Subscribe the group member to the group.
+    $membership = OgMembership::create(['type' => OgMembershipInterface::TYPE_DEFAULT]);
+    $membership
+      ->setOwner($groupMember)
+      ->setGroup($group)
+      ->save();
+
+    // Add an OG Menu.
+    $ogMenu = OgMenu::create([
+      'label' => $this->randomString(),
+      'id' => $this->ogMenuId,
+    ]);
+    $ogMenu->save();
+
+    // Add an OG Menu Instance.
+    $this->ogMenuInstance = OgMenuInstance::create([
+      'id' => $this->randomMachineName(),
+      'type' => $this->ogMenuId,
+      OgGroupAudienceHelperInterface::DEFAULT_FIELD => $group->id(),
+    ]);
+    $this->ogMenuInstance->save();
+  }
+
+}
