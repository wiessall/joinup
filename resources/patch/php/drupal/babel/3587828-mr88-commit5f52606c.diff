+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\babel_og_menu_link\EventSubscriber;
+
+use Drupal\Core\Config\ConfigCrudEvent;
+use Drupal\Core\Config\ConfigEvents;
+use Drupal\babel_og_menu_link\BabelOgMenuLinkManager;
+use Symfony\Component\EventDispatcher\EventSubscriberInterface;
+
+/**
+ * Event subscriber for acting on configuration events.
+ */
+class ConfigSubscriber implements EventSubscriberInterface {
+
+  public function __construct(
+    protected readonly BabelOgMenuLinkManager $ogLinkManager,
+  ) {}
+
+  /**
+   * Reacts to Babel's config changes.
+   *
+   * @param \Drupal\Core\Config\ConfigCrudEvent $event
+   *   The configuration event.
+   */
+  public function onConfigChange(ConfigCrudEvent $event): void {
+    $config = $event->getConfig();
+    if ($config->getName() !== 'babel.settings') {
+      return;
+    }
+    if (!$event->isChanged('translation_type.plugin.babel_og_menu_link')) {
+      return;
+    }
+    $original = $config->getOriginal()['translation_type']['plugin']['babel_og_menu_link']['og_menu'] ?? [];
+    $current = $config->get()['translation_type']['plugin']['babel_og_menu_link']['og_menu'] ?? [];
+    $added = array_diff($current, $original);
+    $removed = array_diff($original, $current);
+    if ($added) {
+      $this->ogLinkManager->batchAddSources($added);
+    }
+    if ($removed) {
+      $this->ogLinkManager->deleteSources($removed);
+    }
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public static function getSubscribedEvents(): array {
+    $events[ConfigEvents::SAVE][] = ['onConfigChange'];
+    $events[ConfigEvents::DELETE][] = ['onConfigChange'];
+    return $events;
+  }
+
+}
