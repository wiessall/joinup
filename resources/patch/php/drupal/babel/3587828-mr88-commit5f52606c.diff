diff --git a/modules/babel_og_menu_link/src/BabelOgMenuLinkManager.php b/modules/babel_og_menu_link/src/BabelOgMenuLinkManager.php
new file mode 100644
index 0000000000000000000000000000000000000000..779d5da81344c8e985bd47dba4de66a638ae9500
--- /dev/null
+++ b/modules/babel_og_menu_link/src/BabelOgMenuLinkManager.php
@@ -0,0 +1,396 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\babel_og_menu_link;
+
+use Drupal\Component\Plugin\PluginBase;
+use Drupal\Component\Utility\DeprecationHelper;
+use Drupal\content_translation\ContentTranslationManagerInterface;
+use Drupal\Core\Batch\BatchBuilder;
+use Drupal\Core\Config\ConfigFactoryInterface;
+use Drupal\Core\Entity\EntityTypeManagerInterface;
+use Drupal\Core\Language\Language;
+use Drupal\Core\Language\LanguageManagerInterface;
+use Drupal\babel\BabelStorageInterface;
+use Drupal\babel\Model\Source;
+use Drupal\babel\StringsCollectorFactory;
+use Drupal\menu_link_content\MenuLinkContentInterface;
+
+/**
+ * Babel translation manager for Organic Group menu links.
+ */
+final class BabelOgMenuLinkManager {
+
+  /**
+   * List of the menu link entity properties which aren't translated.
+   *
+   * @const string[]
+   */
+  public const EXCLUDED_FIELDS = [
+    'changed',
+    'created',
+    'langcode',
+    'content_translation_changed',
+    'content_translation_created',
+    'content_translation_outdated',
+    'content_translation_source',
+    'content_translation_status',
+    'content_translation_uid',
+    'default_langcode',
+    'revision_translation_affected',
+  ];
+
+  /**
+   * The content translation manager, if available.
+   *
+   * @var \Drupal\content_translation\ContentTranslationManagerInterface|null
+   */
+  protected ?ContentTranslationManagerInterface $contentTranslationManager = NULL;
+
+  /**
+   * Static cache of System menu names per OG menu ID.
+   *
+   * @var string[][]
+   */
+  protected array $menuNamesPerOgMenuId;
+
+  public function __construct(
+    protected readonly EntityTypeManagerInterface $entityTypeManager,
+    protected readonly BabelStorageInterface $babelStorage,
+    protected readonly LanguageManagerInterface $languageManager,
+    protected readonly StringsCollectorFactory $collectorFactory,
+    protected readonly ConfigFactoryInterface $configFactory,
+  ) {}
+
+  /**
+   * Sets the content translation manager.
+   *
+   * @param \Drupal\content_translation\ContentTranslationManagerInterface $contentTranslationManager
+   *   The content translation manager.
+   */
+  public function setContentTranslationManager(ContentTranslationManagerInterface $contentTranslationManager): void {
+    $this->contentTranslationManager = $contentTranslationManager;
+  }
+
+  /**
+   * Updates the source objects of the given menu link entity.
+   *
+   * @param \Drupal\menu_link_content\MenuLinkContentInterface $link
+   *   The menu link content entity to process.
+   */
+  public function updateSourcesForLink(MenuLinkContentInterface $link): void {
+    if (!$this->isLinkAllowed($link)) {
+      return;
+    }
+
+    $ogMenuType = $this->getOgMenuIdFromLink($link);
+
+    // Invalidate the cache if a translation was changed.
+    if (!$link->isDefaultTranslation()) {
+      $query = $this->babelStorage->getBaseQuery(
+        pluginId: 'babel_og_menu_link',
+        fields: ['hash']
+      );
+      $hashes = $query
+        ->condition('id', $query->escapeLike("$ogMenuType:{$link->id()}:") . '%', 'LIKE')
+        ->execute()
+        ->fetchCol();
+      $this->collectorFactory->invalidateHashes($hashes, $link->language()->getId());
+      return;
+    }
+
+    $this->babelStorage->delete('babel_og_menu_link', "$ogMenuType:{$link->id()}:");
+    $this->babelStorage->update('babel_og_menu_link', $this->getSourcesForLink($link));
+  }
+
+  /**
+   * Performs the necessary operations if a translatable link prop was changed.
+   *
+   * Right now this means the deletion of translations.
+   *
+   * @param \Drupal\menu_link_content\MenuLinkContentInterface $link
+   *   The link which was changed.
+   */
+  public function handleTranslatablePropertyChange(MenuLinkContentInterface $link): void {
+    if (!$this->isLinkAllowed($link)) {
+      return;
+    }
+    if (!$this->contentTranslationManager instanceof ContentTranslationManagerInterface) {
+      return;
+    }
+    if ($link->isNew() || $link->isNewTranslation()) {
+      return;
+    }
+    if (!$link->isDefaultTranslation()) {
+      return;
+    }
+    $translationLanguageCodes = array_keys($link->getTranslationLanguages(FALSE));
+    if (!$translationLanguageCodes) {
+      return;
+    }
+
+    $translatableFieldsUnfiltered = $link->getTranslatableFields(FALSE);
+    // Ignore language property and fields which are provided by
+    // content_translation.
+    $translatableFields = array_diff_key(
+      $translatableFieldsUnfiltered,
+      array_combine(static::EXCLUDED_FIELDS, static::EXCLUDED_FIELDS)
+    );
+    $originalLink = DeprecationHelper::backwardsCompatibleCall(
+      \Drupal::VERSION,
+      '11.2.0',
+      fn() => $link->getOriginal(),
+      fn() => $link->original,
+    );
+    $originalTranslatableValues = array_intersect_key($originalLink->toArray(), $translatableFields);
+    $newTranslatableValues = array_intersect_key($link->toArray(), $translatableFields);
+    $changedProperties = array_filter(
+      array_keys(array_merge($originalTranslatableValues, $newTranslatableValues)),
+      function (string $prop) use ($originalTranslatableValues, $newTranslatableValues): bool {
+        $original = $originalTranslatableValues[$prop] ?? NULL;
+        $new = $newTranslatableValues[$prop] ?? NULL;
+        return $original !== $new;
+      }
+    );
+    if (!$changedProperties) {
+      return;
+    }
+    foreach ($translationLanguageCodes as $langcode) {
+      $this->contentTranslationManager->getTranslationMetadata($link->getTranslation($langcode))->setOutdated(TRUE);
+    }
+  }
+
+  /**
+   * Instantiates source objects from the properties of the given menu link.
+   *
+   * @param \Drupal\menu_link_content\MenuLinkContentInterface $link
+   *   The menu link content entity to process.
+   *
+   * @return list<\Drupal\babel\Model\Source>
+   *   List of source objects.
+   */
+  public function getSourcesForLink(MenuLinkContentInterface $link): array {
+    $sources = [];
+    $ogMenuId = $this->getOgMenuIdFromLink($link);
+    if (!$ogMenuId) {
+      return $sources;
+    }
+
+    if (!$this->isOgMenuIdAllowed($ogMenuId)) {
+      return $sources;
+    }
+
+    foreach ($link->getTranslatableFields(FALSE) as $field) {
+      if (in_array($field->getName(), static::EXCLUDED_FIELDS, TRUE)) {
+        continue;
+      }
+
+      foreach ($field as $delta => $item) {
+        $id = implode(PluginBase::DERIVATIVE_SEPARATOR, [
+          $ogMenuId,
+          $link->id(),
+          $field->getName(),
+          $delta,
+        ]);
+        $sources[$id] = new Source(string: (string) $item->value, context: '');
+      }
+    }
+
+    return $sources;
+  }
+
+  /**
+   * Deletes the OG menu link sources matching the OG menu link IDs.
+   *
+   * @param array $ogMenuIds
+   *   ID of the Organic Group menus which menu link entities must be processed.
+   *   All Babel OG menu link sources are removed if omitted or empty.
+   */
+  public function deleteSources(array $ogMenuIds = []): void {
+    if (empty($ogMenuIds)) {
+      $this->babelStorage->delete('babel_og_menu_link');
+      return;
+    }
+    foreach ($ogMenuIds as $ogMenuId) {
+      $this->babelStorage->delete('babel_og_menu_link', startsWith: "$ogMenuId:");
+    }
+  }
+
+  /**
+   * Creates a batch process to process preexisting OG menu links.
+   *
+   * @param array $ogMenuIds
+   *   ID of the Organic Group menus which menu link entities must be processed.
+   */
+  public function batchAddSources(array $ogMenuIds = []): void {
+    $menuLinkIdQuery = $this->entityTypeManager->getStorage('menu_link_content')
+      ->getQuery()
+      ->accessCheck(FALSE);
+
+    $menuIds = $this->getOgMenuNames($ogMenuIds);
+    if (!$menuIds) {
+      return;
+    }
+    $menuLinkIdQuery->condition('menu_name', $menuIds, 'IN');
+
+    $menuLinkIds = $menuLinkIdQuery->execute();
+    if (!$menuLinkIds) {
+      return;
+    }
+    $total = count($menuLinkIds);
+
+    $batch = new BatchBuilder();
+    foreach (array_chunk($menuLinkIds, 10) as $chunk) {
+      $batch->addOperation([BabelOgMenuLinkManager::class, 'processMenuLinks'], [$chunk, $total]);
+    }
+
+    $batchArray = $batch->toArray();
+    batch_set($batchArray);
+  }
+
+  /**
+   * Returns a list of allowed OG menu names.
+   *
+   * @return string[][]
+   *   A list of allowed OG menu names.
+   */
+  protected function getOgMenuNames(array $ogMenuIds = [], bool $limitToConfigured = TRUE): array {
+    if (!isset($this->menuNamesPerOgMenuId)) {
+      $ogMenuNames = array_values($this->entityTypeManager->getStorage('ogmenu')->getQuery()->accessCheck(FALSE)->execute());
+
+      // Limit menus to the configured menu names.
+      if ($limitToConfigured) {
+        $ogMenuNames = array_intersect($this->getEnabledOgMenuIds(), $ogMenuNames);
+      }
+
+      if (empty($ogMenuNames)) {
+        return $this->menuNamesPerOgMenuId = [];
+      }
+
+      foreach ($ogMenuNames as $menuName) {
+        $ogMenuInstanceIds = $this->entityTypeManager->getStorage('ogmenu_instance')->getQuery()->accessCheck(FALSE)->condition('type', $menuName)->execute();
+        $this->menuNamesPerOgMenuId[$menuName] = array_map(
+          fn (string|int $ogMenuInstanceId): string => "ogmenu-$ogMenuInstanceId",
+          $ogMenuInstanceIds,
+        );
+      }
+    }
+
+    if ($ogMenuIds) {
+      return array_unique(array_merge(...array_values(array_intersect_key(
+        $this->menuNamesPerOgMenuId,
+        array_combine($ogMenuIds, $ogMenuIds),
+      ))));
+    }
+
+    return array_unique(array_merge(...array_values($this->menuNamesPerOgMenuId)));
+  }
+
+  /**
+   * Check whether the passed link is handled by the OG menu link plugin.
+   *
+   * @param \Drupal\menu_link_content\MenuLinkContentInterface $link
+   *   The menu link content entity.
+   *
+   * @return bool
+   *   Whether the passed link is handled by Babel.
+   */
+  public function isLinkAllowed(MenuLinkContentInterface $link): bool {
+    // Link must be the default translation and the default language must be
+    // English.
+    if (
+      !$link->isDefaultTranslation() ||
+      $link->language()->getId() !== Language::$defaultValues['id']
+    ) {
+      return FALSE;
+    }
+    $menuName = $link->getMenuName();
+    if (!preg_match('/^ogmenu-(\d+)$/', $menuName, $matches)) {
+      return FALSE;
+    }
+    $ogmenuInstanceId = end($matches);
+
+    return in_array(
+      $this->entityTypeManager->getStorage('ogmenu_instance')->load($ogmenuInstanceId)?->bundle(),
+      $this->getEnabledOgMenuIds(),
+      TRUE
+    );
+  }
+
+  /**
+   * Batch callback to process menu link content entities.
+   *
+   * @param array<string|int> $lids
+   *   ID of menu link content entities.
+   * @param int $total
+   *   Total number of items to process. Only used to construct the interactive
+   *   message.
+   * @param array $context
+   *   The batch context.
+   */
+  public static function processMenuLinks(array $lids, int $total, array &$context): void {
+    $context['results']['progress'] ??= 0;
+    $context['results']['last_message_time'] ??= 0;
+    $linkStorage = \Drupal::entityTypeManager()->getStorage('menu_link_content');
+    $linkSourceManager = \Drupal::service(BabelOgMenuLinkManager::class);
+
+    $sources = [];
+    foreach ($linkStorage->loadMultiple($lids) as $link) {
+      assert($link instanceof MenuLinkContentInterface);
+      $sources = array_merge($sources, $linkSourceManager->getSourcesForLink($link));
+    }
+    \Drupal::service(BabelStorageInterface::class)->update('babel_og_menu_link', $sources);
+
+    $context['results']['progress'] += count($lids);
+    // On CLI, report progress only once per second.
+    $now = \Drupal::time()->getCurrentTime();
+    if (PHP_SAPI !== 'cli' || $context['results']['last_message_time'] <> $now || $context['results']['progress'] === $total) {
+      $context['message'] = t('Babel OG menu links module processed @progress out of @total OG menu links', [
+        '@progress' => $context['results']['progress'],
+        '@total' => $total,
+      ]);
+      $context['results']['last_message_time'] = $now;
+    }
+  }
+
+  /**
+   * Returns the IDs of the actually configured OG menus.
+   *
+   * @return string[]
+   *   The IDs of the actually configured OG menus.
+   */
+  protected function getEnabledOgMenuIds(): array {
+    $babelSettings = $this->configFactory->get('babel.settings');
+    return $babelSettings->get('translation_type.plugin.babel_og_menu_link.og_menu') ?? [];
+  }
+
+  /**
+   * Returns the OG menu ID of a menu link.
+   *
+   * @return string|null
+   *   The OG menu ID of a menu link, or NULL if the menu link doesn't belong to
+   *   an Organic Group menu.
+   */
+  public function getOgMenuIdFromLink(MenuLinkContentInterface $link): ?string {
+    $menuName = $link->getMenuName();
+    if (!preg_match('/^ogmenu-(\d+)$/', $menuName, $matches)) {
+      return NULL;
+    }
+    $ogmenuId = $matches[1];
+
+    return $this->entityTypeManager->getStorage('ogmenu_instance')->load($ogmenuId)?->bundle();
+  }
+
+  /**
+   * Determines if the given OG menu ID is on the allowed list.
+   */
+  protected function isOgMenuIdAllowed(string $ogMenuId): bool {
+    return in_array(
+      $ogMenuId,
+      $this->getEnabledOgMenuIds(),
+      TRUE
+    );
+  }
+
+}
