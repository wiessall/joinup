@@ -0,0 +1,27 @@
+<?php
+
+/**
+ * @file
+ * Uninstall functions of Babel OG Menu Link.
+ */
+
+declare(strict_types=1);
+
+use Drupal\babel_og_menu_link\BabelOgMenuLinkManager;
+
+/**
+ * Implements hook_uninstall().
+ */
+function babel_og_menu_link_uninstall($is_syncing): void {
+  // Delete sources.
+  \Drupal::service(BabelOgMenuLinkManager::class)->deleteSources();
+
+  // If not a sync, we have to remove our section from babel.settings.
+  if (!$is_syncing) {
+    // Remove the babel_og_menu_link settings from the editable config.
+    $config = \Drupal::configFactory()->getEditable('babel.settings');
+    $pluginSettings = $config->get('translation_type.plugin');
+    unset($pluginSettings['babel_og_menu_link']);
+    $config->set('translation_type.plugin', $pluginSettings)->save(TRUE);
+  }
+}
