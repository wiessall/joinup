+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\babel\Traits;
+
+/**
+ * Runs pending batch operations.
+ */
+trait BatchTrait {
+
+  /**
+   * Executes the pending batches.
+   */
+  protected function runPendingBatches(): void {
+    while ($batch = &batch_get()) {
+      $batch['progressive'] = FALSE;
+      batch_process();
+    }
+  }
+
+}
