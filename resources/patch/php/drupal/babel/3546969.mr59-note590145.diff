+<?php
+
+/**
+ * @file
+ * Hook implementations for Babel Content Entity module.
+ */
+
+declare(strict_types=1);
+
+use Drupal\babel_content_entity\Hook\BabelContentEntityHook;
+use Drupal\Core\Entity\EntityInterface;
+use Drupal\Core\Hook\Attribute\LegacyHook;
+
+/**
+ * Implements hook_entity_insert().
+ *
+ * @phpstan-ignore-next-line as Attribute class Drupal\Core\Hook\Attribute\LegacyHook does not exist.
+ */
+#[LegacyHook]
+function babel_content_entity_entity_insert(EntityInterface $entity): void {
+  \Drupal::service(BabelContentEntityHook::class)->onEntityInsert($entity);
+}
+
+/**
+ * Implements hook_entity_update().
+ *
+ * @phpstan-ignore-next-line as Attribute class Drupal\Core\Hook\Attribute\LegacyHook does not exist.
+ */
+#[LegacyHook]
+function babel_content_entity_entity_update(EntityInterface $entity): void {
+  \Drupal::service(BabelContentEntityHook::class)->onEntityUpdate($entity);
+}
+
+/**
+ * Implements hook_entity_delete().
+ *
+ * @phpstan-ignore-next-line as Attribute class Drupal\Core\Hook\Attribute\LegacyHook does not exist.
+ */
+#[LegacyHook]
+function babel_content_entity_entity_delete(EntityInterface $entity): void {
+  \Drupal::service(BabelContentEntityHook::class)->onEntityDelete($entity);
+}
+
+/**
+ * Implements hook_entity_bundle_delete().
+ *
+ * @phpstan-ignore-next-line as Attribute class Drupal\Core\Hook\Attribute\LegacyHook does not exist.
+ */
+#[LegacyHook]
+function babel_content_entity_entity_bundle_delete(string $entityTypeId, string $bundle): void {
+  \Drupal::service(BabelContentEntityHook::class)->onBundleDelete($entityTypeId, $bundle);
+}
