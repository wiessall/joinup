 function babel_menu_link_content_install(): void {
   \Drupal::service(BabelMenuLinkContentService::class)->batchAddSources();
 }
+
+/**
+ * Remove links from non-supported menus.
+ */
+function babel_menu_link_content_update_8002(): void {
+  // Until https://www.drupal.org/i/3542164 it was possible that menus which
+  // are provided by the System modules (system.menu.*) to leak their links into
+  // the Babel backend. We remove them from the backend.
+  // @see https://www.drupal.org/i/3542164
+  $allMenuNames = array_values(\Drupal::entityQuery('menu')->execute());
+
+  // Narrow the list by intersecting with the configured menu names.
+  $plugin = \Drupal::service(TranslationTypePluginManager::class)->createInstance('menu_link_content');
+  $configuredMenuNames = $plugin->getConfiguration()['menu'];
+  $allowedMenus = $configuredMenuNames ? array_intersect($configuredMenuNames, $allMenuNames) : $allMenuNames;
+
+  $babelStorage = \Drupal::service(BabelStorageInterface::class);
+  $ids = $babelStorage->getBaseQuery('menu_link_content')->execute()->fetchCol();
+
+  // Get a list of unsupported menu names from the current Babel backend.
+  $unsupportedMenuNames = array_reduce($ids, function (array $remove, string $id) use ($allowedMenus): array {
+    [$menuName] = explode(':', $id);
+    if (!in_array($menuName, $allowedMenus, TRUE)) {
+      $remove[$menuName] = $menuName;
+    }
+    return $remove;
+  }, []);
+
+  foreach ($unsupportedMenuNames as $menuName) {
+    $babelStorage->delete('menu_link_content', "$menuName:");
+  }
+
+}
