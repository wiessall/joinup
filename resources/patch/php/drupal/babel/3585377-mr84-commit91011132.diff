@@ -308,4 +317,28 @@ class ContentEntity extends TranslationTypePluginBase implements PluginFormInter
     return $bundles;
   }
 
+  /**
+   * Gets the main property string value given am entity's field and delta.
+   *
+   * @param \Drupal\Core\Entity\EntityInterface $entity
+   *   The entity.
+   * @param string $fieldName
+   *   The field name.
+   * @param int $delta
+   *   The delta.
+   *
+   * @return string|null
+   *   The string value.
+   */
+  protected function getMainPropertyValue(EntityInterface $entity, string $fieldName, int $delta): ?string {
+    /** @var \Drupal\Core\Field\FieldItemInterface $fieldItem */
+    $fieldItem = $entity?->get($fieldName)?->get($delta);
+    if (!$fieldItem) {
+      return NULL;
+    }
+    $mainProperty = $fieldItem::mainPropertyName();
+
+    return $fieldItem->get($mainProperty)->getString();
+  }
+
 }
