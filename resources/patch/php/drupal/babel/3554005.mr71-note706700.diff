diff --git a/modules/babel_tmgmt/src/BabelTmgmtIntegration.php b/modules/babel_tmgmt/src/BabelTmgmtIntegration.php
new file mode 100644
index 0000000000000000000000000000000000000000..5f42a263d6c496bd9a02ce3f99c2aa4c71a20935
--- /dev/null
+++ b/modules/babel_tmgmt/src/BabelTmgmtIntegration.php
@@ -0,0 +1,228 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\babel_tmgmt;
+
+use Drupal\babel\BabelStorageInterface;
+use Drupal\babel\BabelStringsRepositoryInterface;
+use Drupal\Core\Config\ConfigFactoryInterface;
+use Drupal\Core\Entity\ContentEntityStorageInterface;
+use Drupal\Core\Entity\EntityTypeManagerInterface;
+use Drupal\Core\Session\AccountInterface;
+use Drupal\tmgmt\ContinuousManager;
+use Drupal\tmgmt\JobInterface;
+use Drupal\tmgmt\JobItemInterface;
+use Drupal\tmgmt\TMGMTException;
+use Symfony\Component\DependencyInjection\Attribute\Autowire;
+
+/**
+ * TMGMT integration service.
+ */
+class BabelTmgmtIntegration {
+
+  /**
+   * Static cache of job item storage.
+   */
+  protected ContentEntityStorageInterface $jobItemStorage;
+
+  public function __construct(
+    protected readonly AccountInterface $currentUser,
+    protected readonly ConfigFactoryInterface $configFactory,
+    protected readonly EntityTypeManagerInterface $entityTypeManager,
+    protected readonly BabelStorageInterface $storage,
+    protected readonly BabelStringsRepositoryInterface $stringsRepository,
+    #[Autowire(service: 'tmgmt.continuous')]
+    protected readonly ContinuousManager $continuousManager,
+  ) {}
+
+  /**
+   * Creates continuous job items.
+   *
+   * @param string $hash
+   *   The source string hash.
+   *
+   * @return array<int|string, \Drupal\tmgmt\JobItemInterface>
+   *   A list of created continuous job items keyed by their ID.
+   */
+  public function createContinuousJobItems(string $hash): array {
+    $jobItems = [];
+
+    if (!$this->storage->hashExists($hash)) {
+      return $jobItems;
+    }
+
+    foreach ($this->continuousManager->getContinuousJobs('en') as $job) {
+      if ($jobItem = $this->createContinuousJobItemForJob($job, $hash)) {
+        $jobItems[$jobItem->id()] = $jobItem;
+      }
+    }
+
+    return $jobItems;
+  }
+
+  /**
+   * Creates an item for a continuous job and a source string hash.
+   *
+   * @param \Drupal\tmgmt\JobInterface $job
+   *   The continuous job.
+   * @param string $hash
+   *   The source string hash.
+   *
+   * @return \Drupal\tmgmt\JobItemInterface|null
+   *   The created job item or NULL if the job item could not be created.
+   */
+  public function createContinuousJobItemForJob(JobInterface $job, string $hash): ?JobItemInterface {
+    if (!$job->isContinuous()) {
+      throw new \InvalidArgumentException(__METHOD__ . '() handles only continuous jobs');
+    }
+
+    // Skip strings that are either disabled or locked for translation.
+    $translation = $this->stringsRepository->getStringTranslationByHash($job->getTargetLangcode(), $hash);
+    if (!$translation || !$translation->source->getStatus() || $translation->isLocked()) {
+      return NULL;
+    }
+
+    // Remove any existing job item for this hash.
+    $existingJobItems = $job->getItems([
+      'plugin' => 'babel',
+      'item_type' => 'default',
+      'item_id' => $hash,
+    ]);
+    if ($existingJobItems) {
+      $this->getJobItemStorage()->delete($existingJobItems);
+    }
+
+    try {
+      return $this->continuousManager->addItem($job, 'babel', 'default', $hash);
+    }
+    catch (TMGMTException) {
+      // Ignore this job if, for some reason, a job item cannot be created.
+      return NULL;
+    }
+  }
+
+  /**
+   * Deletes continuous job items.
+   *
+   * @param string $hash
+   *   The source string hash.
+   */
+  public function deleteContinuousJobItems(string $hash): void {
+    $jobItems = [];
+    foreach ($this->continuousManager->getContinuousJobs('en') as $job) {
+      $jobItems += $job->getItems([
+        'plugin' => 'babel',
+        'item_type' => 'default',
+        'item_id' => $hash,
+      ]);
+    }
+    if ($jobItems) {
+      $this->entityTypeManager->getStorage('tmgmt_job_item')->delete($jobItems);
+    }
+  }
+
+  /**
+   * Creates job items given a source string hash.
+   *
+   * The method creates a job items for each combination of target languages and
+   * translators that are qualifying to perform the translation.
+   *
+   * @param string $hash
+   *   The source string hash.
+   *
+   * @return array<int|string, \Drupal\tmgmt\JobItemInterface>
+   *   A list of job items keyed by their ID.
+   */
+  public function createJobItems(string $hash): array {
+    $jobItems = [];
+    if (!$this->storage->hashExists($hash)) {
+      return $jobItems;
+    }
+
+    $translatorIds = $this->configFactory->get('babel_tmgmt.settings')->get('translators');
+    if (!$translatorIds) {
+      // No translators are configured to be used by the 'babel' source.
+      return $jobItems;
+    }
+
+    // Load translator entities.
+    $translatorStorage = $this->entityTypeManager->getStorage('tmgmt_translator');
+    if (!$translators = $translatorStorage->loadMultiple($translatorIds)) {
+      return $jobItems;
+    }
+
+    $existing = $this->getExistingGraph($hash);
+    foreach (tmgmt_available_languages(['en']) as $langcode => $name) {
+      $translation = $this->stringsRepository->getStringTranslationByHash($langcode, $hash);
+      if ($translation->isTranslated()) {
+        // Already translated, and not requested to be translated again.
+        continue;
+      }
+
+      foreach ($translators as $translatorId => $translator) {
+        if (isset($existing[$langcode][$translatorId])) {
+          // This job already exists.
+          continue;
+        }
+
+        // Create the job.
+        $values = ['translator' => $translator];
+        $job = tmgmt_job_create('en', $langcode, $this->currentUser->id(), $values);
+
+        if (!$translator->checkTranslatable($job)->getSuccess()) {
+          // This job cannot be translated by this translator.
+          continue;
+        }
+
+        $job->save();
+        $jobItem = $job->addItem('babel', 'default', $hash);
+        $jobItems[$jobItem->id()] = $jobItem;
+      }
+    }
+
+    return $jobItems;
+  }
+
+  /**
+   * Create a graph with the existing jobs for a give hash.
+   *
+   * @param string $hash
+   *   The source string hash.
+   *
+   * @return array<string, array<string, true>>
+   *   Associative array keyed by language code. Values are associative arrays,
+   *   each keys/values as the translator ID.
+   */
+  protected function getExistingGraph(string $hash): array {
+    $return = [];
+
+    if (!$latest = tmgmt_job_item_load_latest('babel', 'default', $hash, 'en')) {
+      return $return;
+    }
+
+    foreach ($latest as $langcode => $jobItem) {
+      if ($translator = $jobItem->getTranslator()) {
+        $return[$langcode][$translator->id()] = $translator->id();
+      }
+    }
+
+    return $return;
+  }
+
+  /**
+   * Retrieves the entity storage of the translation job items.
+   *
+   * @return \Drupal\Core\Entity\ContentEntityStorageInterface
+   *   The entity storage of the translation job items.
+   */
+  protected function getJobItemStorage(): ContentEntityStorageInterface {
+    if (!isset($this->jobItemStorage)) {
+      $storage = $this->entityTypeManager->getStorage('tmgmt_job_item');
+      assert($storage instanceof ContentEntityStorageInterface);
+      $this->jobItemStorage = $storage;
+    }
+    return $this->jobItemStorage;
+  }
+
+}
diff --git a/modules/babel_tmgmt/src/EventSubscriber/BabelTmgmtSubscriber.php b/modules/babel_tmgmt/src/EventSubscriber/BabelTmgmtSubscriber.php
new file mode 100644
index 0000000000000000000000000000000000000000..a5e6f244a738a199c48c05018c3f1afc98228aca
--- /dev/null
+++ b/modules/babel_tmgmt/src/EventSubscriber/BabelTmgmtSubscriber.php
@@ -0,0 +1,94 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\babel_tmgmt\EventSubscriber;
+
+use Drupal\babel\Event\SourceStringDisabled;
+use Drupal\babel\Event\SourceStringEnabled;
+use Drupal\babel\Event\SourceStringInserted;
+use Drupal\babel\Event\SourceStringStatusChangedBase;
+use Drupal\babel\Event\TranslationLockChangedBase;
+use Drupal\babel\Event\TranslationLocked;
+use Drupal\babel\Event\TranslationUnlocked;
+use Drupal\Core\Queue\QueueFactory;
+use Symfony\Component\EventDispatcher\EventSubscriberInterface;
+
+/**
+ * Listens to events that require creation or deletion of continuous job items.
+ */
+class BabelTmgmtSubscriber implements EventSubscriberInterface {
+
+  public function __construct(protected QueueFactory $queueFactory) {}
+
+  /**
+   * {@inheritdoc}
+   */
+  public static function getSubscribedEvents(): array {
+    return [
+      SourceStringInserted::class => 'onSourceStringInserted',
+      SourceStringEnabled::class => 'onSourceStringStatusChanged',
+      SourceStringDisabled::class => 'onSourceStringStatusChanged',
+      TranslationUnlocked::class => 'onTranslationLockChanged',
+      TranslationLocked::class => 'onTranslationLockChanged',
+    ];
+  }
+
+  /**
+   * Schedules new source strings for continuous job items creation.
+   *
+   * @param \Drupal\babel\Event\SourceStringInserted $event
+   *   The event instance.
+   */
+  public function onSourceStringInserted(SourceStringInserted $event): void {
+    $this->queueStrings('create', $event->hashes);
+  }
+
+  /**
+   * Creates or deletes continuous job items when source string status changes.
+   *
+   * @param \Drupal\babel\Event\SourceStringStatusChangedBase $event
+   *   The event instance.
+   */
+  public function onSourceStringStatusChanged(SourceStringStatusChangedBase $event): void {
+    $operation = match(TRUE) {
+      $event instanceof SourceStringEnabled => 'create',
+      $event instanceof SourceStringDisabled => 'delete',
+    };
+    $this->queueStrings($operation, [$event->hash]);
+  }
+
+  /**
+   * Creates or deletes continuous job items when the translation lock changes.
+   *
+   * @param \Drupal\babel\Event\TranslationLockChangedBase $event
+   *   The event instance.
+   */
+  public function onTranslationLockChanged(TranslationLockChangedBase $event): void {
+    $operation = match(TRUE) {
+      $event instanceof TranslationUnlocked => 'create',
+      $event instanceof TranslationLocked => 'delete',
+    };
+    $this->queueStrings($operation, [$event->hash]);
+  }
+
+  /**
+   * Schedules a list of strings for continuous job items creation or deletion.
+   *
+   * @param string $operation
+   *   The operation to perform. Either 'create' or 'delete'.
+   * @param list<string> $hashes
+   *   List of source string hashes.
+   */
+  protected function queueStrings(string $operation, array $hashes): void {
+    assert($operation === 'create' || $operation === 'delete');
+
+    $queue = $this->queueFactory->get('babel_tmgmt_continuous_job_item');
+    $queue->createQueue();
+
+    foreach ($hashes as $hash) {
+      $queue->createItem(['operation' => $operation, 'hash' => $hash]);
+    }
+  }
+
+}
