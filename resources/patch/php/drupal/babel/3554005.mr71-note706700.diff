@@ -0,0 +1,85 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\babel_tmgmt\Hook;
+
+use Drupal\Core\Entity\EntityTypeManagerInterface;
+use Drupal\Core\Form\ConfigTarget;
+use Drupal\Core\Form\FormStateInterface;
+use Drupal\Core\Hook\Attribute\Hook;
+use Drupal\Core\Queue\QueueFactory;
+use Drupal\Core\StringTranslation\StringTranslationTrait;
+use Drupal\tmgmt\JobInterface;
+use Drupal\tmgmt\TranslatorInterface;
+
+/**
+ * Hook implementations for Babel TMGMT module.
+ */
+class BabelTmgmtHooks {
+
+  use StringTranslationTrait;
+
+  public function __construct(
+    protected EntityTypeManagerInterface $entityTypeManager,
+    protected QueueFactory $queueFactory,
+  ) {}
+
+  /**
+   * Implements hook_form_FORM_ID_alter() for 'babel_settings_form' form.
+   *
+   * @phpstan-ignore-next-line as Attribute class Drupal\Core\Hook\Attribute\Hook does not exist.
+   */
+  #[Hook('form_babel_settings_form_alter')]
+  public function babelTmgmtSettings(array &$form, FormStateInterface $formState): void {
+    if (!$this->entityTypeManager->hasDefinition('tmgmt_translator')) {
+      return;
+    }
+
+    $options = array_map(
+      fn(TranslatorInterface $translator): string|\Stringable => $translator->label(),
+      $this->entityTypeManager->getStorage('tmgmt_translator')->loadMultiple(),
+    );
+
+    if (!$options) {
+      return;
+    }
+
+    $form['tmgmt'] = [
+      '#type' => 'details',
+      '#title' => $this->t('TMGMT integration'),
+      'translators' => [
+        '#type' => 'checkboxes',
+        '#title' => $this->t('Translators'),
+        '#description' => $this->t('Select the TMGMT translators used to translate the strings managed by Babel.'),
+        '#options' => $options,
+        '#config_target' => new ConfigTarget(
+          configName: 'babel_tmgmt.settings',
+          propertyPath: 'translators',
+          fromConfig: fn(?array $value): array => (array) $value,
+          toConfig: fn(array $value): array => array_keys(array_filter($value)),
+        ),
+      ],
+    ];
+  }
+
+  /**
+   * Creates items for a newly created continuous job.
+   *
+   * @param \Drupal\tmgmt\JobInterface $job
+   *   A continuous job.
+   *
+   * @phpstan-ignore-next-line as Attribute class Drupal\Core\Hook\Attribute\Hook does not exist.
+   */
+  #[Hook('tmgmt_job_insert')]
+  public function jobCreated(JobInterface $job): void {
+    if ($job->isContinuous()) {
+      $this->queueFactory->get('babel_tmgmt_continuous_job_item')
+        ->createItem([
+          'operation' => 'continuous_job_created',
+          'job_id' => $job->id(),
+        ]);
+    }
+  }
+
+}
diff --git a/modules/babel_tmgmt/src/Plugin/QueueWorker/ContinuousJobItemCreationWorker.php b/modules/babel_tmgmt/src/Plugin/QueueWorker/ContinuousJobItemCreationWorker.php
new file mode 100644
