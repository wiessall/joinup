--- /dev/null
+++ b/modules/babel_tmgmt/src/Plugin/QueueWorker/ContinuousJobItemCreationWorker.php
@@ -0,0 +1,142 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\babel_tmgmt\Plugin\QueueWorker;
+
+use Drupal\babel_tmgmt\BabelTmgmtIntegration;
+use Drupal\Core\Database\Connection;
+use Drupal\Core\Entity\EntityTypeManagerInterface;
+use Drupal\Core\Plugin\ContainerFactoryPluginInterface;
+use Drupal\Core\Queue\Attribute\QueueWorker;
+use Drupal\Core\Queue\QueueFactory;
+use Drupal\Core\Queue\QueueWorkerBase;
+use Drupal\Core\StringTranslation\TranslatableMarkup;
+use Symfony\Component\DependencyInjection\ContainerInterface;
+
+/**
+ * Create/delete continuous job items.
+ */
+#[QueueWorker(
+  id: 'babel_tmgmt_continuous_job_item',
+  title: new TranslatableMarkup('Create continuous job item'),
+  cron: ['time' => 30],
+)]
+class ContinuousJobItemCreationWorker extends QueueWorkerBase implements ContainerFactoryPluginInterface {
+
+  private const ALLOWED_OPERATIONS = ['create', 'delete', 'continuous_job_created'];
+
+  public function __construct(
+    array $configuration,
+    $pluginId,
+    $pluginDefinition,
+    protected readonly BabelTmgmtIntegration $babelTmgmt,
+    protected readonly EntityTypeManagerInterface $entityTypeManager,
+    protected readonly Connection $db,
+    protected QueueFactory $queueFactory,
+  ) {
+    parent::__construct($configuration, $pluginId, $pluginDefinition);
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public static function create(ContainerInterface $container, array $configuration, $plugin_id, $plugin_definition): self {
+    return new static(
+      $configuration,
+      $plugin_id,
+      $plugin_definition,
+      $container->get(BabelTmgmtIntegration::class),
+      $container->get('entity_type.manager'),
+      $container->get('database'),
+      $container->get('queue'),
+    );
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function processItem($data): void {
+    if (!isset($data['operation']) || !in_array($data['operation'], self::ALLOWED_OPERATIONS, TRUE)) {
+      throw new \InvalidArgumentException('Invalid operation.');
+    }
+
+    match($data['operation']) {
+      'create', 'delete' => $this->createOrDeleteJobItems($data),
+      'continuous_job_created' => $this->addItemsForNewJob($data),
+    };
+  }
+
+  /**
+   * Creates or deletes continuous job items.
+   *
+   * @param array $data
+   *   The queue item data.
+   */
+  protected function createOrDeleteJobItems(array $data): void {
+    if (empty($data['hash']) || !is_string($data['hash']) || strlen($data['hash']) !== 64) {
+      throw new \InvalidArgumentException('Invalid hash.');
+    }
+
+    match($data['operation']) {
+      'create' => $this->babelTmgmt->createContinuousJobItems($data['hash']),
+      'delete' => $this->babelTmgmt->deleteContinuousJobItems($data['hash']),
+    };
+  }
+
+  /**
+   * Adds new job items for a new continuous job.
+   *
+   * @param array $data
+   *   The queue item data.
+   *
+   * @see \Drupal\babel_tmgmt\Hook\BabelTmgmtHooks::jobCreated()
+   */
+  protected function addItemsForNewJob(array $data): void {
+    if (!isset($data['job_id']) || !is_numeric($data['job_id'])) {
+      throw new \InvalidArgumentException('Invalid job ID');
+    }
+
+    $job = $this->entityTypeManager->getStorage('tmgmt_job')->load($data['job_id']);
+    if (!$job) {
+      // The job entity might have been deleted in the meantime. Exit silently.
+      return;
+    }
+
+    if (!$job->isContinuous()) {
+      throw new \InvalidArgumentException("Job with ID {$data['job_id']} is not a continuous job");
+    }
+
+    if (!isset($data['hashes'])) {
+      // This is the first iteration for this new job. Create all items and
+      // queue them for processing later, in the same queue.
+      $allHashes = $this->db->select('babel_source')
+        ->fields('babel_source', ['hash'])
+        ->execute()
+        ->fetchCol();
+      if (!$allHashes) {
+        return;
+      }
+
+      $queue = $this->queueFactory->get('babel_tmgmt_continuous_job_item');
+      $queue->createQueue();
+
+      // Queue hashes in batches of 50.
+      foreach (array_chunk($allHashes, 50) as $hashes) {
+        $queue->createItem([
+          'operation' => 'continuous_job_created',
+          'job_id' => $data['job_id'],
+          'hashes' => $hashes,
+        ]);
+      }
+
+      // We are done. Future worker runs will process scheduled hashes.
+      return;
+    }
+
+    foreach ($data['hashes'] as $hash) {
+      $this->babelTmgmt->createContinuousJobItemForJob($job, $hash);
+    }
+  }
+
+}
diff --git a/modules/babel_tmgmt/src/Plugin/tmgmt/Source/BabelSource.php b/modules/babel_tmgmt/src/Plugin/tmgmt/Source/BabelSource.php
new file mode 100644
index 0000000000000000000000000000000000000000..8053bc6c5018226f37be0eed96e393543b8ece0d
--- /dev/null
+++ b/modules/babel_tmgmt/src/Plugin/tmgmt/Source/BabelSource.php
@@ -0,0 +1,213 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\babel_tmgmt\Plugin\tmgmt\Source;
+
+use Drupal\babel\BabelStorageInterface;
+use Drupal\babel\BabelStringsRepositoryInterface;
+use Drupal\babel\Plugin\Babel\TranslationTypePluginManager;
+use Drupal\babel\Utility;
+use Drupal\Component\Gettext\PoItem;
+use Drupal\Core\Database\Connection;
+use Drupal\Core\Form\FormStateInterface;
+use Drupal\Core\Plugin\ContainerFactoryPluginInterface;
+use Drupal\tmgmt\ContinuousSourceInterface;
+use Drupal\tmgmt\Entity\Job;
+use Drupal\tmgmt\JobItemInterface;
+use Drupal\tmgmt\SourcePluginBase;
+use Symfony\Component\DependencyInjection\ContainerInterface;
+
+/**
+ * Translation Source plugin for Babel strings.
+ *
+ * @SourcePlugin(
+ *   id = "babel",
+ *   label = @Translation("Babel"),
+ *   description = @Translation("Source handler for Babel strings."),
+ *   ui = "Drupal\babel_tmgmt\Plugin\tmgmt\Source\BabelSourceUi",
+ * ),
+ */
+class BabelSource extends SourcePluginBase implements ContainerFactoryPluginInterface, ContinuousSourceInterface {
+
+  public function __construct(
+    array $configuration,
+    string $pluginId,
+    array $pluginDefinition,
+    protected readonly TranslationTypePluginManager $translationTypeManager,
+    protected readonly BabelStringsRepositoryInterface $babelStringsRepository,
+    protected readonly BabelStorageInterface $babelStorage,
+    protected Connection $db,
+  ) {
+    parent::__construct($configuration, $pluginId, $pluginDefinition);
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public static function create(ContainerInterface $container, array $configuration, $plugin_id, $plugin_definition): self {
+    return new static(
+      $configuration,
+      $plugin_id,
+      $plugin_definition,
+      $container->get(TranslationTypePluginManager::class),
+      $container->get(BabelStringsRepositoryInterface::class),
+      $container->get(BabelStorageInterface::class),
+      $container->get('database'),
+    );
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function getItemTypes(): array {
+    return ['default' => $this->t('Default')];
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function getLabel(JobItemInterface $job_item): string|false {
+    $sortKey = $this->db->select('babel_source')
+      ->fields('babel_source', ['sort_key'])
+      ->condition('hash', $job_item->getItemId())
+      ->execute()
+      ->fetchField();
+
+    // Remove a potential trailing delimiter when the translation context is an
+    // empty string.
+    return rtrim($sortKey, ':');
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function getData(JobItemInterface $job_item): array {
+    $sourceLangcode = $job_item->getSourceLangCode();
+    $targetLangcode = $job_item->getJob()->getTargetLangcode();
+
+    $translation = $this->babelStringsRepository
+      ->getStringTranslationByHash($sourceLangcode, $job_item->getItemId());
+
+    $variants = $translation->getSourcePluralVariants();
+    $isPlural = $translation->isPlural();
+    $variantsCount = $isPlural ? (int) $this->getNumberOfPlurals($targetLangcode) : 1;
+
+    $data = [];
+    for ($delta = 0; $delta < $variantsCount; $delta++) {
+      // Identify placeholders that need to be escaped. Assume that placeholders
+      // consist of alphanumeric characters and _,- only and are delimited by
+      // non-alphanumeric characters. There are cases that don't match, for
+      // example, appended SI units like "@valuems", there only @value is the
+      // actual placeholder.
+      $escape = [];
+      if (isset($variants[$delta])) {
+        if (preg_match_all('/([@!%][a-zA-Z0-9_-]+)/', $variants[$delta], $matches, PREG_OFFSET_CAPTURE)) {
+          foreach ($matches[0] as $match) {
+            $escape[$match[1]]['string'] = $match[0];
+          }
+        }
+      }
+
+      $variant = $variants[$delta] ?? '';
+
+      // The target language has more plural variants than the source. Fill the
+      // additional source plural variants with the first plural if it exists.
+      if ($variant === '' && $delta >= count($variants) && !empty($variants[1])) {
+        $variant = $variants[1];
+      }
+
+      [$key, $label] = $this->getKeyAndLabel($delta);
+      $data[$key] = [
+        '#label' => $label,
+        '#text' => $variant,
+        '#translate' => TRUE,
+        '#escape' => $escape,
+      ];
+    }
+
+    return $data;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function saveTranslation(JobItemInterface $job_item, $target_langcode): bool {
+    $data = $job_item->getData();
+    $isPlural = count($data) > 1;
+    $variantsCount = $isPlural ? (int) $this->getNumberOfPlurals($target_langcode) : 1;
+    $variants = [];
+
+    for ($delta = 0; $delta < $variantsCount; $delta++) {
+      [$key] = $this->getKeyAndLabel($delta);
+      $variants[$delta] = trim($data[$key]['#translation']['#text'] ?? '');
+
+    }
+
+    // Remove a potential trailing delimiter.
+    $translated = rtrim(implode(PoItem::DELIMITER, $variants), PoItem::DELIMITER);
+    if (!$translated) {
+      return FALSE;
+    }
+
+    $hash = $job_item->getItemId();
+    $translation = $this->babelStringsRepository->getStringTranslationByHash($target_langcode, $hash);
+    $instances = $this->babelStorage->getSourceStringInstances($hash);
+
+    foreach ($instances as $pluginId => $ids) {
+      $plugin = $this->translationTypeManager->createInstance($pluginId);
+      foreach ($ids as $id) {
+        $plugin->updateTranslation($translation, $id, $target_langcode, $translated);
+      }
+    }
+
+    return TRUE;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function getSourceLangCode(JobItemInterface $job_item): string|false {
+    // Babel depend on Locale module and handles its strings. For Locale source,
+    // English is always the source language.
+    return 'en';
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function continuousSettingsForm(array &$form, FormStateInterface $form_state, Job $job): array {
+    return [];
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function shouldCreateContinuousItem(Job $job, $plugin, $item_type, $item_id): bool {
+    $translation = $this->babelStringsRepository->getStringTranslationByHash($job->getTargetLangcode(), $item_id);
+    return $translation && !$translation->isLocked();
+  }
+
+  /**
+   * Returns the data key and label given the plural variant delta.
+   *
+   * @param int $delta
+   *   The plural variant delta.
+   *
+   * @return array{string, string|\Stringable}
+   *   A tuple with the data key and the label:
+   *   0: The key.
+   *   1: The label.
+   */
+  protected function getKeyAndLabel(int $delta): array {
+    return match(TRUE) {
+      $delta === 0 => ['singular', $this->t('Singular')],
+      $delta === 1 => ['plural:1', $this->t('Plural')],
+      default => ["plural:$delta", $this->t('@nth plural', [
+        '@nth' => Utility::getOrdinal($delta),
+      ]),
+      ],
+    };
+  }
+
+}
diff --git a/modules/babel_tmgmt/src/Plugin/tmgmt/Source/BabelSourceUi.php b/modules/babel_tmgmt/src/Plugin/tmgmt/Source/BabelSourceUi.php
new file mode 100644
index 0000000000000000000000000000000000000000..82a40da047213e9392c239ce40455d05383fba70
--- /dev/null
+++ b/modules/babel_tmgmt/src/Plugin/tmgmt/Source/BabelSourceUi.php
@@ -0,0 +1,371 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\babel_tmgmt\Plugin\tmgmt\Source;
+
+use Drupal\babel\BabelStringsRepositoryInterface;
+use Drupal\babel\Model\StringTranslation;
+use Drupal\Core\Batch\BatchBuilder;
+use Drupal\Core\Config\ConfigFactoryInterface;
+use Drupal\Core\Form\FormStateInterface;
+use Drupal\Core\Language\LanguageInterface;
+use Drupal\Core\Language\LanguageManagerInterface;
+use Drupal\Core\Pager\PagerManagerInterface;
+use Drupal\Core\Render\RendererInterface;
+use Drupal\tmgmt\SourcePluginUiBase;
+use Symfony\Component\HttpFoundation\Request;
+
+/**
+ * Babel source plugin UI.
+ */
+class BabelSourceUi extends SourcePluginUiBase {
+
+  /**
+   * No context value.
+   *
+   * @var string
+   */
+  private const NO_CONTEXT = '*****NOCONTEXT*****';
+
+  /**
+   * {@inheritdoc}
+   */
+  public function overviewForm(array $form, FormStateInterface $form_state, $type): array {
+    $form = parent::overviewForm($form, $form_state, $type);
+
+    $perPage = $this->getConfigFactory()->get('tmgmt.settings')->get('source_list_limit') ?? 20;
+
+    $form['items']['#empty'] = $this->t('No strings matching given criteria have been found.');
+
+    // Strings were already stored in form stare, in ::overviewSearchFormPart().
+    $all = $form_state->get('all_strings');
+
+    $pager = $this->getPagerManager()->getPager() ?: $this->getPagerManager()->createPager(count($all), $perPage);
+    if ($pager->getTotalItems() !== count($all)) {
+      // We have to reinitialize the pager.
+      // @see https://drupal.org/i/3388718
+      $pager = $this->getPagerManager()->createPager(count($all), $perPage);
+    }
+
+    $strings = array_slice($all, $pager->getCurrentPage() * $perPage, $perPage);
+
+    foreach ($strings as $hash => $languages) {
+      $form['items']['#options'][$hash] = ['id' => $hash];
+      $jobItems = tmgmt_job_item_load_latest('babel', $type, $hash, 'en') ?: NULL;
+      foreach ($languages as $langcode => $stringTranslation) {
+        $form['items']['#options'][$hash]['source'] ??= $stringTranslation->source->string;
+        $form['items']['#options'][$hash]['context'] ??= $stringTranslation->source->context;
+
+        $status = $this->getTranslationStatus($langcode, $stringTranslation);
+        $build = $this->buildTranslationStatus($status, $jobItems[$langcode] ?? NULL);
+        $form['items']['#options'][$hash]["langcode-$langcode"] = $this->getRenderer()->render($build);
+      }
+    }
+
+    $form['pager'] = ['#type' => 'pager'];
+
+    return $form;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function overviewSearchFormPart(array $form, FormStateInterface $form_state, $type): array {
+    $form = parent::overviewSearchFormPart($form, $form_state, $type);
+
+    $params = $this->getSearchFormSubmittedParams();
+
+    $form['search_wrapper']['search']['text'] = [
+      '#type' => 'textfield',
+      '#title' => t('Source text'),
+      '#default_value' => $params['text'],
+    ];
+
+    $languages = array_map(function (LanguageInterface $language): string {
+      return $language->getName();
+    }, $this->getLanguageManager()->getLanguages());
+    // Unset English as it is the source language for all strings.
+    unset($languages['en']);
+
+    $form['search_wrapper']['search']['missing'] = [
+      '#type' => 'select',
+      '#title' => t('Not translated to'),
+      '#options' => $languages,
+      '#empty_option' => '--',
+      '#default_value' => $params['missing'],
+    ];
+
+    $form_state->set('all_strings', $this->getStrings());
+
+    $form['search_wrapper']['search']['context'] = [
+      '#type' => 'select',
+      '#title' => t('Context'),
+      '#empty_option' => $this->t('--'),
+      '#empty_value' => self::NO_CONTEXT,
+      '#options' => $this->getContexts($form_state),
+      '#default_value' => $params['context'] ?? self::NO_CONTEXT,
+    ];
+
+    return $form;
+  }
+
+  /**
+   * Returns the TMGMT translation status string.
+   *
+   * @param string $langcode
+   *   The language code.
+   * @param \Drupal\babel\Model\StringTranslation $translation
+   *   The translation string object.
+   *
+   * @return string
+   *   The TMGMT translation status string.
+   */
+  protected function getTranslationStatus(string $langcode, StringTranslation $translation): string {
+    return match(TRUE) {
+      $langcode === 'en' => 'original',
+      $translation->isTranslated() => 'current',
+      default => 'missing',
+    };
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function overviewSearchFormRedirect(array $form, FormStateInterface $form_state, $type): bool {
+    if (
+      $form_state->getTriggeringElement()['#id'] == 'edit-search-submit' &&
+      $form_state->hasValue(['search', 'context']) &&
+      $form_state->getValue(['search', 'context']) === self::NO_CONTEXT
+    ) {
+      // Unset the context query string when no filtering on this parameter has
+      // been requested.
+      $form_state->unsetValue(['search', 'context']);
+    }
+
+    return parent::overviewSearchFormRedirect($form, $form_state, $type);
+  }
+
+  /**
+   * Returns all Babel strings.
+   *
+   * @return array<string, array<string, \Drupal\babel\Model\StringTranslation>>
+   *   All translatable strings.
+   */
+  protected function getStrings(): array {
+    $langcodes = array_keys($this->getLanguageManager()->getLanguages());
+
+    // Get filters.
+    $params = $this->getSearchFormSubmittedParams();
+
+    $strings = [];
+    foreach ($langcodes as $langcode) {
+      $langStrings = $this->getBabelStringsRepository()->getStrings(
+        langcode: $langcode,
+        translationStatus: (!empty($params['missing']) && $params['missing'] === $langcode) ? FALSE : NULL,
+        search: $params['text'],
+        context: $params['context'],
+        sourceStatus: TRUE,
+      );
+      foreach ($langStrings as $hash => $langString) {
+        $strings[$hash][$langcode] = $langString;
+      }
+    }
+
+    // Remove incomplete hashes. For instance a filter one of the languages
+    // might be set. Is such case remove this string in all languages.
+    foreach ($strings as $hash => $languages) {
+      if (count($languages) !== count($langcodes)) {
+        unset($strings[$hash]);
+      }
+    }
+
+    return $strings;
+  }
+
+  /**
+   * Returns overview form header.
+   *
+   * @return array
+   *   Header array definition as expected by table.
+   */
+  public function overviewFormHeader(): array {
+    $languages = $this->getLanguageManager()->getLanguages();
+
+    $header = [
+      'source' => ['data' => t('Source text')],
+      'context' => ['data' => t('Context')],
+      'langcode-en' => ['data' => $languages['en']->getName()],
+    ];
+    foreach ($languages as $langcode => $language) {
+      if ($langcode !== 'en') {
+        $header["langcode-$langcode"] = ['data' => $language->getName()];
+      }
+    }
+
+    return $header;
+  }
+
+  /**
+   * Gets submitted search parameters.
+   *
+   * @return array{text: string|null, missing: string|null, context:
+   *   string|null} Search parameters.
+   */
+  public function getSearchFormSubmittedParams(): array {
+    $query = $this->getCurrentRequest()->query;
+    return [
+      'text' => $query->get('text', FALSE) ?: NULL,
+      'missing' => $query->get('missing', FALSE) ?: NULL,
+      'context' => $query->get('context'),
+    ];
+  }
+
+  /**
+   * Gets a list of contexts.
+   *
+   * @return array<string, string|\Stringable>
+   *   List of contexts from the filtered list of strings.
+   */
+  public function getContexts(FormStateInterface $formState): array {
+    $contexts = [];
+    foreach ($formState->get('all_strings') as ['en' => $translation]) {
+      assert($translation instanceof StringTranslation);
+      $context = $translation->source->context;
+      if (!isset($contexts[$context])) {
+        $label = $context === '' ? $this->t('Default context ("")') : $context;
+        $contexts[$context] = $label;
+      }
+    }
+
+    return $contexts;
+  }
+
+  /**
+   * Adds selected sources to continuous jobs.
+   *
+   * @param \Drupal\Core\Form\FormStateInterface $formState
+   *   Form state array.
+   * @param string $itemType
+   *   Entity type.
+   */
+  public function overviewSubmitToContinuousJobs(FormStateInterface $formState, string $itemType): void {
+    $sourceLangcode = $formState->getValue('source_language');
+    $sourceLangcode = $sourceLangcode === '_source' ? 'en' : $sourceLangcode;
+
+    if ($formState->getValue('add_all_to_continuous_jobs')) {
+      $hashes = array_keys($this->getBabelStringsRepository()->getStrings(
+        langcode: $sourceLangcode,
+        sourceStatus: TRUE,
+      ));
+    }
+    else {
+      $hashes = array_keys(array_filter($formState->getValue('items')));
+    }
+
+    if (!$hashes) {
+      return;
+    }
+
+    $batch = new BatchBuilder();
+    foreach ($hashes as $hash) {
+      $batch->addOperation([static::class, 'createContinuousJobItem'], [$hash, $sourceLangcode]);
+    }
+
+    batch_set($batch->toArray());
+  }
+
+  /**
+   * Creates a continuous job item.
+   *
+   * @param string $hash
+   *   The source string hash.
+   * @param string $sourceLangcode
+   *   The source language code.
+   */
+  public static function createContinuousJobItem(string $hash, string $sourceLangcode): void {
+    $continuousManager = \Drupal::service('tmgmt.continuous');
+    foreach ($continuousManager->getContinuousJobs($sourceLangcode) as $job) {
+      $continuousManager->addItem($job, 'babel', 'default', $hash);
+    }
+  }
+
+  /**
+   * Returns the renderer service.
+   *
+   * Note that this type of plugin doesn't allow dependency injection.
+   *
+   * @return \Drupal\Core\Render\RendererInterface
+   *   The renderer service.
+   */
+  protected function getRenderer(): RendererInterface {
+    // @phpstan-ignore-next-line globalDrupalDependencyInjection.useDependencyInjection
+    return \Drupal::service('renderer');
+  }
+
+  /**
+   * Returns the pager manager service.
+   *
+   * Note that this type of plugin doesn't allow dependency injection.
+   *
+   * @return \Drupal\Core\Pager\PagerManagerInterface
+   *   The pager manager service.
+   */
+  protected function getPagerManager(): PagerManagerInterface {
+    // @phpstan-ignore-next-line globalDrupalDependencyInjection.useDependencyInjection
+    return \Drupal::service('pager.manager');
+  }
+
+  /**
+   * Returns the config factory service.
+   *
+   * Note that this type of plugin doesn't allow dependency injection.
+   *
+   * @return \Drupal\Core\Config\ConfigFactoryInterface
+   *   The config factory service.
+   */
+  protected function getConfigFactory(): ConfigFactoryInterface {
+    // @phpstan-ignore-next-line globalDrupalDependencyInjection.useDependencyInjection
+    return \Drupal::configFactory();
+  }
+
+  /**
+   * Returns the Babel strings repository service.
+   *
+   * Note that this type of plugin doesn't allow dependency injection.
+   *
+   * @return \Drupal\babel\BabelStringsRepositoryInterface
+   *   The Babel strings repository service.
+   */
+  protected function getBabelStringsRepository(): BabelStringsRepositoryInterface {
+    // @phpstan-ignore-next-line globalDrupalDependencyInjection.useDependencyInjection
+    return \Drupal::service(BabelStringsRepositoryInterface::class);
+  }
+
+  /**
+   * Returns the language manager service.
+   *
+   * Note that this type of plugin doesn't allow dependency injection.
+   *
+   * @return \Drupal\Core\Language\LanguageManagerInterface
+   *   The language manager service.
+   */
+  protected function getLanguageManager(): LanguageManagerInterface {
+    // @phpstan-ignore-next-line globalDrupalDependencyInjection.useDependencyInjection
+    return \Drupal::languageManager();
+  }
+
+  /**
+   * Returns the current request.
+   *
+   * Note that this type of plugin doesn't allow dependency injection.
+   *
+   * @return \Symfony\Component\HttpFoundation\Request
+   *   The current request.
+   */
+  protected function getCurrentRequest(): Request {
+    // @phpstan-ignore-next-line globalDrupalDependencyInjection.useDependencyInjection
+    return \Drupal::service('request_stack')->getCurrentRequest();
+  }
+
+}
diff --git a/modules/babel_tmgmt/tests/src/Functional/BabelTmgmtTest.php b/modules/babel_tmgmt/tests/src/Functional/BabelTmgmtTest.php
new file mode 100644
index 0000000000000000000000000000000000000000..cf504434fdd3e1e94168152eeaffaabe1f1ebab9
--- /dev/null
+++ b/modules/babel_tmgmt/tests/src/Functional/BabelTmgmtTest.php
@@ -0,0 +1,148 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\babel_tmgmt\Functional;
+
+use Drupal\language\Entity\ConfigurableLanguage;
+use Drupal\Tests\babel\Traits\ModuleInstallHelperTrait;
+use Drupal\Tests\BrowserTestBase;
+use Drupal\user\UserInterface;
+
+/**
+ * Tests the TMGMT integration.
+ *
+ * @group babel
+ * @coversDefaultClass \Drupal\babel_tmgmt\Plugin\tmgmt\Source\BabelSource
+ */
+class BabelTmgmtTest extends BrowserTestBase {
+
+  use ModuleInstallHelperTrait;
+
+  /**
+   * {@inheritdoc}
+   */
+  protected $defaultTheme = 'stark';
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'babel_test_config',
+    'babel_tmgmt',
+    'l10n_pconfig',
+    'tmgmt_local',
+  ];
+
+  /**
+   * Testing user account.
+   */
+  protected UserInterface $account;
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+
+    // Use a language that has more than 2 plural variants.
+    ConfigurableLanguage::createFromLangcode('ro')->save();
+
+    $this->account = $this->createUser(
+      permissions: [
+        'administer tmgmt',
+        'provide translation services',
+        'administer languages',
+      ],
+      values: [
+        'tmgmt_translation_skills' => [
+          'language_from' => 'en',
+          'language_to' => 'ro',
+        ],
+      ],
+    );
+    $this->drupalLogin($this->account);
+
+    // Add plural formula to Romanian.
+    $this->drupalGet('/admin/config/regional/language/edit/ro');
+    $this->submitForm([
+      'plural_formula' => 'nplurals=3; plural=n==1 ? 0 : (n==0 || (n%100 > 0 && n%100 < 20)) ? 1 : 2;',
+    ], 'Save language');
+
+    // Ensure that the \Drupal\locale\LocaleTranslation::$translations property
+    // has some cached translations in it.
+    $lookup = \Drupal::service('string_translator.locale.lookup');
+    // Hash: f071ac91d5854385bc8d295ba8aa003cd45cba6597b596cf5d06825595259d44.
+    $lookup->getStringTranslation('ro', 'Test', '');
+    // Hash: 3a6b2fe60c9b0ef6a66569054e58b56a1a3315c60b694777b9433d5021826035.
+    $lookup->getStringTranslation('ro', "1 hello\x03@count hellos", '');
+    $this->runInstallBatchOperations();
+  }
+
+  /**
+   * Tests TMGMT integration.
+   */
+  public function testIntegration(): void {
+    $this->drupalGet('/admin/tmgmt/sources/babel/default', ['query' => ['text' => 'Test']]);
+    $this->submitForm([
+      'source_language' => 'en',
+      'target_language' => 'ro',
+      'items[f071ac91d5854385bc8d295ba8aa003cd45cba6597b596cf5d06825595259d44]' => TRUE,
+    ], 'Request translation');
+
+    $this->submitForm(['settings[translator]' => $this->account->id()], 'Submit to provider');
+
+    $assert = $this->assertSession();
+
+    $assert->statusMessageContains('The translation for Test is now being processed.', 'status');
+    $assert->statusMessageContains('The translation job has been submitted.', 'status');
+
+    $this->drupalGet('/admin/tmgmt/sources/babel/default', ['query' => ['text' => 'hellos']]);
+    $this->submitForm([
+      'source_language' => 'en',
+      'target_language' => 'ro',
+      'items[3a6b2fe60c9b0ef6a66569054e58b56a1a3315c60b694777b9433d5021826035]' => TRUE,
+    ], 'Request translation');
+    $this->submitForm(['settings[translator]' => $this->account->id()], 'Submit to provider');
+
+    $assert->statusMessageContains('The translation for 1 hello @count hellos is now being processed.', 'status');
+    $assert->statusMessageContains('The translation job has been submitted.', 'status');
+
+    // Perform translations, including manager approvals.
+    $this->drupalGet('translate/items/1');
+    $this->submitForm(['singular[translation]' => '[RO] Test'], 'Save as completed');
+    $assert->statusMessageContains('The translation for Test has been saved as completed.', 'status');
+    $this->drupalGet('admin/tmgmt/items/1');
+    $this->submitForm([], 'Save as completed');
+    $assert->statusMessageContains('Validation completed successfully.', 'status');
+    $assert->statusMessageContains('The translation for Test has been accepted.', 'status');
+
+    $this->drupalGet('translate/items/2');
+    $this->submitForm([
+      'singular[translation]' => 'un salut',
+      'plural:1[translation]' => '@count saluturi',
+      'plural:2[translation]' => '@count de saluturi',
+    ], 'Save as completed');
+    $assert->statusMessageContains('The translation for 1 hello @count hellos has been saved as completed.', 'status');
+    $this->drupalGet('admin/tmgmt/items/2');
+    $this->submitForm([], 'Save as completed');
+    $assert->statusMessageContains('Validation completed successfully.', 'status');
+    $assert->statusMessageContains('The translation for 1 hello @count hellos has been accepted.', 'status');
+
+    // Inspect the Locale backend.
+    $storage = \Drupal::service('locale.storage');
+    $translation = $storage->getTranslations(['source' => 'Test', 'context' => '']);
+    $this->assertCount(1, $translation);
+    $this->assertSame('[RO] Test', $translation[0]->getString());
+    $translation = $storage->getTranslations(['source' => "1 hello\x03@count hellos", 'context' => '']);
+    $this->assertCount(1, $translation);
+    $this->assertSame("un salut\x03@count saluturi\x03@count de saluturi", $translation[0]->getString());
+
+    // Inspect the Config backend.
+    \Drupal::languageManager()->setConfigOverrideLanguage(ConfigurableLanguage::load('ro'));
+    $config = \Drupal::configFactory()->get('babel_test_config.content');
+    $this->assertSame('[RO] Test', $config->get('label'));
+    $this->assertSame("un salut\x03@count saluturi\x03@count de saluturi", $config->get('content.value'));
+  }
+
+}
diff --git a/modules/babel_tmgmt/tests/src/Kernel/BabelTmgmtIntegrationTest.php b/modules/babel_tmgmt/tests/src/Kernel/BabelTmgmtIntegrationTest.php
new file mode 100644
index 0000000000000000000000000000000000000000..674d08445dab204b3fe81abd76a3fc9d23494d3d
--- /dev/null
+++ b/modules/babel_tmgmt/tests/src/Kernel/BabelTmgmtIntegrationTest.php
@@ -0,0 +1,266 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\Tests\babel_tmgmt\Kernel;
+
+use Drupal\babel\BabelLockServiceInterface;
+use Drupal\babel\BabelStorageInterface;
+use Drupal\babel\Model\Source;
+use Drupal\babel_tmgmt\BabelTmgmtIntegration;
+use Drupal\KernelTests\KernelTestBase;
+use Drupal\language\Entity\ConfigurableLanguage;
+use Drupal\Tests\babel\Traits\ModuleInstallHelperTrait;
+use Drupal\Tests\user\Traits\UserCreationTrait;
+use Drupal\tmgmt\JobInterface;
+
+/**
+ * Tests the Drupal\babel_tmgmt\BabelTmgmtIntegration service.
+ *
+ * @coversDefaultClass \Drupal\babel_tmgmt\BabelTmgmtIntegration
+ * @group babel
+ */
+class BabelTmgmtIntegrationTest extends KernelTestBase {
+
+  use ModuleInstallHelperTrait;
+  use UserCreationTrait;
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = [
+    'babel',
+    'babel_tmgmt',
+    'field',
+    'language',
+    'locale',
+    'options',
+    'system',
+    'text',
+    'tmgmt',
+    'tmgmt_language_combination',
+    'tmgmt_local',
+    'user',
+    'views',
+  ];
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+
+    $this->installEntitySchema('user');
+    $this->installEntitySchema('tmgmt_job');
+    $this->installEntitySchema('tmgmt_job_item');
+    $this->installEntitySchema('tmgmt_message');
+    $this->installEntitySchema('tmgmt_local_task');
+    $this->installEntitySchema('tmgmt_local_task_item');
+    $this->installEntitySchema('tmgmt_remote');
+    $this->installSchema('babel', ['babel_source', 'babel_source_instance', 'babel_source_lock']);
+    $this->installSchema('locale', ['locales_source', 'locales_target', 'locales_location']);
+    $this->installConfig(['language', 'tmgmt_local']);
+
+    // Ensure that the \Drupal\locale\LocaleTranslation::$translations property
+    // has some cached translations in it.
+    $lookup = \Drupal::service('string_translator.locale.lookup');
+    $lookup->getStringTranslation('it', 'Test', '');
+
+    $this->runInstallBatchOperations();
+  }
+
+  /**
+   * Tests creating continuous job items.
+   *
+   * @legacy-covers covers ::createContinuousJobItems
+   */
+  public function testCreateContinuousJobItems(): void {
+    $service = $this->container->get(BabelTmgmtIntegration::class);
+    $translatorManager = $this->container->get('plugin.manager.tmgmt.translator');
+    $lockService = $this->container->get(BabelLockServiceInterface::class);
+    $storage = $this->container->get(BabelStorageInterface::class);
+
+    $jobItems = $service->createContinuousJobItems('non-existing hash');
+    $this->assertEmpty($jobItems);
+
+    $testingHash = (new Source('Test', ''))->getHash();
+
+    // The hash exists, but no continuous job is available.
+    $jobItems = $service->createContinuousJobItems($testingHash);
+    $this->assertEmpty($jobItems);
+
+    // Create a continuous job.
+    ConfigurableLanguage::createFromLangcode('it')->save();
+    tmgmt_translator_auto_create($translatorManager->getDefinition('local'));
+    $job = tmgmt_job_create('en', 'it', 0, [
+      'label' => 'Testing continuous job',
+      'translator' => 'local',
+      'job_type' => JobInterface::TYPE_CONTINUOUS,
+      'state' => JobInterface::STATE_CONTINUOUS,
+    ]);
+    $job->save();
+
+    $this->runQueue('babel_tmgmt_continuous_job_item');
+    $jobItems = $service->createContinuousJobItems($testingHash);
+    $queriedJobItems = $job->getItems([
+      'plugin' => 'babel',
+      'item_type' => 'default',
+      'item_id' => $testingHash,
+    ]);
+    $this->assertEquals(array_keys($queriedJobItems), array_keys($jobItems));
+
+    $this->assertCount(1, $jobItems);
+    $jobItem = reset($jobItems);
+    $this->assertSame('Testing continuous job', $jobItem->getJob()->label());
+    $this->assertSame('Test', $jobItem->label());
+    $this->assertSame('babel', $jobItem->getPlugin());
+    $this->assertSame('default', $jobItem->getItemType());
+    $this->assertSame($testingHash, $jobItem->getItemId());
+    $this->assertSame('Test', $jobItem->getData(['singular', '#text']));
+
+    // Locking a service removes the continuous job items.
+    $lockService->lock($testingHash, 'it');
+    $this->runQueue('babel_tmgmt_continuous_job_item');
+    $queriedJobItems = $job->getItems([
+      'plugin' => 'babel',
+      'item_type' => 'default',
+      'item_id' => $testingHash,
+    ]);
+    $this->assertEmpty($queriedJobItems);
+
+    // Unlocking a string translation adds the continuous job items.
+    $lockService->unlock($testingHash, 'it');
+    $this->runQueue('babel_tmgmt_continuous_job_item');
+    $queriedJobItems = $job->getItems([
+      'plugin' => 'babel',
+      'item_type' => 'default',
+      'item_id' => $testingHash,
+    ]);
+    $this->assertNotEmpty($queriedJobItems);
+
+    // Disabling the source string status also removes the continuous job items.
+    $storage->updateStatusForHash($testingHash, FALSE);
+    $this->runQueue('babel_tmgmt_continuous_job_item');
+    $queriedJobItems = $job->getItems([
+      'plugin' => 'babel',
+      'item_type' => 'default',
+      'item_id' => $testingHash,
+    ]);
+    $this->assertEmpty($queriedJobItems);
+
+    // Enabling a source string adds the continuous job items.
+    $storage->updateStatusForHash($testingHash, TRUE);
+    $this->runQueue('babel_tmgmt_continuous_job_item');
+    $queriedJobItems = $job->getItems([
+      'plugin' => 'babel',
+      'item_type' => 'default',
+      'item_id' => $testingHash,
+    ]);
+    $this->assertNotEmpty($queriedJobItems);
+  }
+
+  /**
+   * Tests creating job items.
+   *
+   * @legacy-covers ::createJobItems
+   */
+  public function testCreateJobItems(): void {
+    $account = $this->createUser();
+    $this->setCurrentUser($account);
+
+    $service = $this->container->get(BabelTmgmtIntegration::class);
+    $translatorManager = $this->container->get('plugin.manager.tmgmt.translator');
+
+    $service->createJobItems('non-existing hash');
+    $this->assertNoJobItemExists('non-existing hash');
+
+    $testingHash = (new Source('Test', ''))->getHash();
+
+    // Try to create a job for an existing hash.
+    $service->createJobItems($testingHash);
+    // Job was not created because there are no translators configured yet.
+    $this->assertNoJobItemExists($testingHash);
+
+    // Configure a translator.
+    $this->config('babel_tmgmt.settings')->set('translators.0', 'local')->save();
+
+    // Try again to create a job for an existing hash.
+    $service->createJobItems($testingHash);
+    // Job was not created because there are no translator entities yet.
+    $this->assertNoJobItemExists($testingHash);
+
+    // Add a translator.
+    tmgmt_translator_auto_create($translatorManager->getDefinition('local'));
+
+    // Try again. Now we have a translator.
+    $service->createJobItems($testingHash);
+    // There are no target languages.
+    $this->assertNoJobItemExists($testingHash);
+
+    // Create a target language.
+    ConfigurableLanguage::createFromLangcode('it')->save();
+
+    // Try again. Now we have a translator.
+    $service->createJobItems($testingHash);
+    // Now we have a target language but the translator doesn't support the
+    // translation from 'en' to 'it'.
+    $this->assertNoJobItemExists($testingHash);
+
+    // Support translations in all directions.
+    $this->config('tmgmt_local.settings')->set('allow_all', TRUE)->save();
+
+    // Try again. Now the translator supports this job.
+    $service->createJobItems($testingHash);
+    $this->assertJobItemExists($testingHash, 'it');
+
+    // Try again to create a new job while one already exists for the same hash.
+    $jobItems = $service->createJobItems($testingHash);
+    $this->assertEmpty($jobItems);
+  }
+
+  /**
+   * Asserts that a job item has been created for a hash and a target language.
+   *
+   * @param string $hash
+   *   The source string hash.
+   * @param string $targetLangcode
+   *   The target langcode.
+   */
+  protected function assertJobItemExists(string $hash, string $targetLangcode): void {
+    $jobItem = \tmgmt_job_item_load_latest('babel', 'default', $hash, 'en')[$targetLangcode] ?? NULL;
+    $this->assertNotNull($jobItem);
+    $this->assertSame('babel', $jobItem->getPlugin());
+    $this->assertSame('default', $jobItem->getItemType());
+    $this->assertSame('en', $jobItem->getSourceLangCode());
+    $this->assertSame($targetLangcode, $jobItem->getJob()->getTargetLangcode());
+    $this->assertSame($hash, $jobItem->getItemId());
+  }
+
+  /**
+   * Asserts that no job item has been created for a given hash.
+   *
+   * @param string $hash
+   *   The source string hash.
+   */
+  protected function assertNoJobItemExists(string $hash): void {
+    $this->assertEmpty(\tmgmt_job_item_load_latest('babel', 'default', $hash, 'en'));
+  }
+
+  /**
+   * Processes all pending items from a given queue.
+   *
+   * @param string $queueName
+   *   The queue name.
+   */
+  protected function runQueue(string $queueName): void {
+    $queueWorkerManager = $this->container->get('plugin.manager.queue_worker');
+    $queue = $this->container->get('queue')->get($queueName);
+
+    $worker = $queueWorkerManager->createInstance($queueName);
+    while ($item = $queue->claimItem()) {
+      $worker->processItem($item->data);
+      $queue->deleteItem($item);
+    }
+  }
+
+}
