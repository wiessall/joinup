+  /**
+   * Tests that a validation failure triggers the logger instead of a crash.
+   */
+  public function testUpdateTranslationValidationFailure(): void {
+    $link = $this->createRandomMenuLink('Valid Title', 'Valid Description');
+    $titleString = $this->plugin->getStrings(static::LANGCODE)['test:1:title:0'];
+    $invalidTitle = str_repeat('A', 256);
+
+    $this->plugin->updateTranslation(
+      $titleString,
+      'test:1:title:0',
+      static::LANGCODE,
+      $invalidTitle
+    );
+
+    // Assert that the translation was NOT saved due to validation failure.
+    $storage = \Drupal::entityTypeManager()->getStorage('menu_link_content');
+    $linkUnchanged = $storage->loadUnchanged($link->id());
+    $this->assertFalse($linkUnchanged->hasTranslation(static::LANGCODE));
+  }
+
