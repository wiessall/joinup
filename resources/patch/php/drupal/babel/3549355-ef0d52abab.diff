diff --git a/tests/src/Functional/TranslationInterfaceTest.php b/tests/src/Functional/TranslationInterfaceTest.php
index 9257f40af73e487f2d3e2d694c4bc17481647371..41f3840e415cf119cc9354cf4e29f6c3ad765646 100644
--- a/tests/src/Functional/TranslationInterfaceTest.php
+++ b/tests/src/Functional/TranslationInterfaceTest.php
@@ -155,6 +155,24 @@ class TranslationInterfaceTest extends BabelFunctionalTestBase {
     $assertSession->pageTextContains('Administration');
     $assertSession->pageTextContains('[TEST LANGCODE] Administration');
 
+    // Test that if a translation is done outside the form,
+    // the change is reflected in the form, after applying the filter.
+    $override = $this->container->get('language_manager')->getLanguageConfigOverride(static::LANGCODE, 'system.menu.admin');
+    $override->set('label', '[TEST UPDATE] Administration');
+    $override->save();
+    $page->pressButton('Filter');
+    $assertSession->pageTextContains('[TEST UPDATE] Administration');
+    // Test that if a translation is emptied but not saved,
+    // it doesn't change, after applying the filter.
+    $this->translateSourceStringTo('Administration', '', NULL, FALSE);
+    $page->pressButton('Filter');
+    $assertSession->pageTextContains('');
+    // Test that if a translation is filled but not saved,
+    // it doesn't change, after applying the filter.
+    $this->translateSourceStringTo('Administration', '[TEST UPDATE 2] Administration', NULL, FALSE);
+    $page->pressButton('Filter');
+    $assertSession->pageTextContains('[TEST UPDATE 2] Administration');
+
     // Test removing translation.
     $this->translateSourceStringTo('Administration', '');
     $assertSession->pageTextContains('Translation of source string "Administration" in language Portuguese, Portugal was deleted.');
