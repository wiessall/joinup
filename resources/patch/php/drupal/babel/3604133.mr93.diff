+    $this->populateAndConsumeQueue();
+    $this->assertNotEmpty($jobs['it']->getItems($filter));
+    $this->assertNotEmpty($jobs['fr']->getItems($filter));
+
+    $service->deleteContinuousJobItems([$testingHash], 'it');
+    $this->assertEmpty($jobs['it']->getItems($filter));
+    $this->assertNotEmpty($jobs['fr']->getItems($filter));
