diff --git a/modules/babel_tmgmt/src/EventSubscriber/BabelTmgmtSubscriber.php b/modules/babel_tmgmt/src/EventSubscriber/BabelTmgmtSubscriber.php
new file mode 100644
index 0000000000000000000000000000000000000000..15fe5bb3e34fc24203f354f8b1ad2a80be272fd7
--- /dev/null
+++ b/modules/babel_tmgmt/src/EventSubscriber/BabelTmgmtSubscriber.php
@@ -0,0 +1,68 @@
+<?php
+
+declare(strict_types=1);
+
+namespace Drupal\babel_tmgmt\EventSubscriber;
+
+use Drupal\babel\Event\SourceStringDisabled;
+use Drupal\babel\Event\TranslationLocked;
+use Drupal\Core\Entity\EntityTypeManagerInterface;
+use Symfony\Component\EventDispatcher\EventSubscriberInterface;
+
+/**
+ * Removes a job item if a translation is locked or disabled.
+ */
+class BabelTmgmtSubscriber implements EventSubscriberInterface {
+
+  public function __construct(
+    protected readonly EntityTypeManagerInterface $entityTypeManager,
+  ) {}
+
+  /**
+   * {@inheritdoc}
+   */
+  public static function getSubscribedEvents(): array {
+    return [
+      SourceStringDisabled::class => 'onSourceStringDisabled',
+      TranslationLocked::class => 'onTranslationLocked',
+    ];
+  }
+
+  /**
+   * Removes corresponding job items when a source string is disabled.
+   *
+   * @param \Drupal\babel\Event\SourceStringDisabled $event
+   *   The event object.
+   */
+  public function onSourceStringDisabled(SourceStringDisabled $event): void {
+    $storage = $this->entityTypeManager->getStorage('tmgmt_job_item');
+    $jobItems = $storage->loadByProperties([
+      'plugin' => 'babel',
+      'item_type' => 'default',
+      'item_id' => $event->hash,
+    ]);
+    if ($jobItems) {
+      $storage->delete($jobItems);
+    }
+  }
+
+  /**
+   * Removes corresponding job items when a translation is locked.
+   *
+   * @param \Drupal\babel\Event\TranslationLocked $event
+   *   The event object.
+   */
+  public function onTranslationLocked(TranslationLocked $event): void {
+    $storage = $this->entityTypeManager->getStorage('tmgmt_job_item');
+    $ids = $storage->getQuery()->accessCheck(FALSE)
+      ->condition('tjid.entity.target_language', $event->langcode)
+      ->condition('plugin', 'babel')
+      ->condition('item_type', 'default')
+      ->condition('item_id', $event->hash)
+      ->execute();
+    if ($ids) {
+      $storage->delete($storage->loadMultiple($ids));
+    }
+  }
+
+}
