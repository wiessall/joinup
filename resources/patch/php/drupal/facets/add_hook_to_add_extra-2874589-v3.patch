+/**
+ * Alter the Facets Query.
+ *
+ * @param \Drupal\search_api\Query\QueryInterface $query
+ * Represents a search query on a Search API index.
+ * @param \Drupal\facets\FacetInterface $facet
+ * The facet entity.
+ *
+ * @return void
+ */
+function hook_facets_query_alter(\Drupal\search_api\Query\QueryInterface &$query, \Drupal\facets\FacetInterface $facet) {
+  if ($facet->id() == 'owl') {
+    $query->addCondition('animal', 'owl');
+  }
+}
