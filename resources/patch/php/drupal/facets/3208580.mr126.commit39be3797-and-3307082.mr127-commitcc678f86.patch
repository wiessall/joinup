diff --git a/facets.install b/facets.install
index fdc8355..52bab57 100644
--- a/facets.install
+++ b/facets.install
@@ -249,3 +249,18 @@ function facets_update_8012() {
     ? sprintf('Facet caching was updated for the following views: %s.', implode(', ', $processed_views))
     : 'There are no views with search API cache plugins and facets in the same time, so nothing has been updated.';
 }
+
+/**
+ * Set new soft limit default value to show all items in facets.
+ */
+function facets_update_8013() {
+  $facets = Facet::loadMultiple();
+  foreach ($facets as $facet) {
+    $widget = $facet->get('widget');
+    if (array_key_exists('soft_limit', $widget['config']) && $widget['config']['soft_limit'] === 0) {
+      $widget['config']['soft_limit'] = -1;
+      $facet->set('widget', $widget);
+      $facet->save();
+    }
+  }
+}
