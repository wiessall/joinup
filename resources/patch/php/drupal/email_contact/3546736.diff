   protected $modal = FALSE;
 
+  /**
+   * Tests modal redirect when not Ajax.
+   */
+  public function testModalRedirectWhenNotAjax(): void {
+    // Set modal to TRUE for this test.
+    EntityViewDisplay::load('entity_test.entity_test.full')
+      ->setComponent('email', [
+        'type' => 'email_contact_link',
+        'settings' => [
+          'modal' => TRUE,
+        ],
+      ])->save();
+
+    // Visit the entity page.
+    $this->drupalGet($this->entity->toUrl());
+
+    // Click the contact link (displays as page, not Ajax).
+    $this->clickLink('Contact person by email');
+
+    // Assert that we're on the contact form page.
+    $assert = $this->assertSession();
+    $assert->addressMatches('/\/email-contact\/entity_test\/' . $this->entity->id() . '\/email(\/full)?$/');
+    $assert->elementTextEquals('css', 'h1', "{$this->entity->label()} - Email Contact");
+
+    // Verify the form is displayed as a regular page (not in a modal).
+    $assert->elementExists('css', 'form');
+    // Modal dialog should not exist.
+    $assert->elementNotExists('css', '.ui-dialog');
+  }
+
