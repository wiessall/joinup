From 785ee320e52247bd0dbd26f3e1912c8fc777c83e Mon Sep 17 00:00:00 2001
From: Adam Pietras <adam@crafter.net.pl>
Date: Tue, 7 Mar 2023 13:19:34 +0100
Subject: [PATCH] 3346470: Move form creation in a protected method from
 ContactController::content into ContactController:getForm.

---
 src/Controller/ContactController.php | 29 ++++++++++++++++++++++------
 1 file changed, 23 insertions(+), 6 deletions(-)

diff --git a/src/Controller/ContactController.php b/src/Controller/ContactController.php
index e94f503..c88aac6 100644
--- a/src/Controller/ContactController.php
+++ b/src/Controller/ContactController.php
@@ -127,12 +127,7 @@ class ContactController extends ControllerBase {
       $field_settings = $field_display['settings'];
     }
 
-    $form = $this->formBuilder->getForm(new ContactForm(
-      $entity->getEntityTypeId(),
-      $entity->id(),
-      $field_name,
-      $field_settings
-    ));
+    $form = $this->getForm($entity, $field_name, $field_settings);
 
     if ($field_settings['modal']) {
       $response = new AjaxResponse();
@@ -154,4 +149,26 @@ class ContactController extends ControllerBase {
     return $form;
   }
 
+  /**
+   * Gets a renderable form array.
+   *
+   * @param \Drupal\Core\Entity\EntityInterface $entity
+   *   The field host entity.
+   * @param string $field_name
+   *   The field name.
+   * @param array $field_settings
+   *   The field settings.
+   *
+   * @return array
+   *   The form array.
+   */
+  protected function getForm(EntityInterface $entity, string $field_name, array $field_settings): array {
+    return $this->formBuilder->getForm(new ContactForm(
+      $entity->getEntityTypeId(),
+      $entity->id(),
+      $field_name,
+      $field_settings
+    ));
+  }
+
 }
