+/**
+ * Helper function for help text.
+ */
+function _entity_form_field_label_replace_description_recursive(&$elements, $new_description, array $ignore = []): void {
+  if (array_key_exists('#description', $elements)) {
+    $elements['#description'] = $new_description;
+  }
+  foreach (Element::children($elements) as $child) {
+    if (in_array($child, $ignore, TRUE)) {
+      continue;
+    }
+    _entity_form_field_label_replace_description_recursive($elements[$child], $new_description, $ignore);
+  }
