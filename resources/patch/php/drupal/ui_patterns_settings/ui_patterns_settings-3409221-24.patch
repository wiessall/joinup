+/**
+ * Determine if the current core version needs the new field hook to be used.
+ *
+ * @return bool
+ *   Whether the current core version needs the new field hook to be used.
+ *
+ * @see https://drupal.org/node/3386675
+ */
+function _ui_patterns_settings_needs_new_storage_form_alter_hook(): bool {
+  $normalized_version = str_ends_with(\Drupal::VERSION, '-dev')
+    ? str_replace(['.x-dev', '-dev'], '.0', \Drupal::VERSION)
+    : \Drupal::VERSION;
+
+  return version_compare($normalized_version, '10.2.0', '>=');
+}
