+function _ui_patterns_settings_field_form_is_complex(): bool {
+  static $is_complex;
+  if (!isset($is_complex)) {
+    $normalized_version = str_ends_with(\Drupal::VERSION, '-dev')
+      ? str_replace(['.x-dev', '-dev'], '.0', \Drupal::VERSION)
+      : \Drupal::VERSION;
