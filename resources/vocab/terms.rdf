  <skos:Concept rdf:about="http://data.europa.eu/dr8/OrganisationalInteroperabilityRequirement_Properties">
    <dc:modified>2023-05-25</dc:modified>
    <skos:notation>Properties of Organisational Interoperability Requirement</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of Organisational Interoperability Requirement</skos:prefLabel>
    <dc:type>eira:OrganisationalInteroperabilityRequirement</dc:type>
