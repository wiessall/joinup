    <skos:note></skos:note>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/PrivateCommunicationNetwork_Properties">
    <dc:modified>2022-01-31</dc:modified>
    <skos:definition>Private Network ABB is a Communication Network that enables the implementation of a network used for realising the physical communication among Interoperable European Solution (e.g. sTESTA), and cannot be accessed by the public.</skos:definition>
    <skos:notation>Properties of Private Network</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of Private Network</skos:prefLabel>
