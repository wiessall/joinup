  <skos:Concept rdf:about="http://data.europa.eu/dr8/MachineLearningTechnologyService_Properties">
    <dc:modified>2023-05-25</dc:modified>
    <skos:definition>Machine Learning ABB is a Technology service that enables the procedures for implementing algorithms and models that can learn from and make predictions on data</skos:definition>
