    <eira:definitionSource>European Medicines Agency</eira:definitionSource>
    <eira:iopDimension>Behavioral IoP</eira:iopDimension>
    <eira:iopDimension>Structural IoP</eira:iopDimension>
    <eira:synonym></eira:synonym>
    <eira:iopSaliency>The Master Data ABB is a key interoperable enabler for semantic interoperability because it is a core element for digital public services enabling the reuse of relevant data such as identifiers for parties, or locations.</eira:iopSaliency>
    <skos:related rdf:resource="http://data.europa.eu/dr8/MasterDataObject"/>
