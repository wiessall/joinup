    <eira:definitionSource>EIF</eira:definitionSource>
    <eira:viewpoint>Key Interoperability Enablers viewpoint</eira:viewpoint>
    <eira:synonym></eira:synonym>
    <eira:iopSaliency></eira:iopSaliency>
    <skos:related rdf:resource="http://data.europa.eu/dr8/AchieveLegalInteroperabilityGoal"/>
