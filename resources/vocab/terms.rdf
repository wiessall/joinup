    <skos:prefLabel xml:lang="en">Data Management</skos:prefLabel>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/viewpoint/InteroperabilityPrivacyViewpoint"/>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/view/TechnicalView-Application"/>
