  <skos:Concept rdf:about="http://data.europa.eu/dr8/PhysicalCommunicationInfrastructureEquipment_Properties">
    <dc:modified>2023-05-25</dc:modified>
    <skos:definition>The Physical Communication Infrastructure ABB is an Equipment that enables components to exchange data.</skos:definition>
    <skos:notation>Properties of Physical Communication Infrastructure</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of Physical Communication Infrastructure</skos:prefLabel>
    <dc:type>eira:PhysicalCommunicationInfrastructureEquipment</dc:type>
    <skos:example></skos:example>
    <eira:PURI>http://data.europa.eu/dr8/PhysicalCommunicationInfrastructureEquipment</eira:PURI>
    <eira:concept>eira:ArchitectureBuildingBlock</eira:concept>
    <eira:definitionSource>Law Insider</eira:definitionSource>
    <eira:iopDimension>Structural IoP</eira:iopDimension>
    <eira:iopDimension>Behavioral IoP</eira:iopDimension>
    <eira:iopSaliency>The Physical Communication Infrastructure ABB is salient for technical interoperability because it provides the infrastructure in charge of bringing the data exchange and communication between public administration services.</eira:iopSaliency>
    <skos:related rdf:resource="http://data.europa.eu/dr8/PhysicalCommunicationInfrastructureEquipment"/>
    <eira:view>Technical view - infrastructure</eira:view>
    <dc:identifier>http://data.europa.eu/dr8/PhysicalCommunicationInfrastructureEquipment_Properties</dc:identifier>
    <dc:identifier>http://data.europa.eu/dr8/PhysicalCommunicationInfrastructureEquipment</dc:identifier>
    <eira:definitionSourceReference>https://www.lawinsider.com/dictionary/communication-infrastructure</eira:definitionSourceReference>
    <skos:note>The Physical Communication Infrastructure includes but is not limited to fixed links, radio communication transmitters, fibre/copper cable, towers, switches, base stations. Customer premise equipment is not included.</skos:note>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/PhysicalComputingInfrastructureEquipment_Properties">
    <dc:modified>2023-05-25</dc:modified>
    <skos:notation>Properties of Physical Computing Infrastructure</skos:notation>
    <skos:definition>The Physical Computing Infrastructure ABB is an Equipment that enables the processing, storage, and transmission of data in a computing environment.</skos:definition>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of Physical Computing Infrastructure</skos:prefLabel>
    <dc:type>eira:PhysicalComputingInfrastructureEquipment</dc:type>
    <skos:example></skos:example>
    <eira:PURI>http://data.europa.eu/dr8/PhysicalComputingInfrastructureEquipment</eira:PURI>
    <eira:definitionSource>Inspired on relevant IT infrastructure providers</eira:definitionSource>
    <eira:iopDimension>Behavioral IoP</eira:iopDimension>
    <eira:iopDimension>Structural IoP</eira:iopDimension>
    <eira:concept>eira:ArchitectureBuildingBlock</eira:concept>
    <eira:iopSaliency>The Physical Computing Infrastructure ABB is salient for technical interoperability because it establishes the infrastructure to analyse a large amount of information.</eira:iopSaliency>
    <skos:related rdf:resource="http://data.europa.eu/dr8/PhysicalComputingInfrastructureEquipment"/>
    <eira:view>Technical view - infrastructure</eira:view>
    <dc:identifier>http://data.europa.eu/dr8/PhysicalComputingInfrastructureEquipment</dc:identifier>
    <dc:identifier>http://data.europa.eu/dr8/PhysicalComputingInfrastructureEquipment_Properties</dc:identifier>
    <eira:definitionSourceReference></eira:definitionSourceReference>
    <skos:note></skos:note>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/PhysicalNetworkInfrastructureEquipment_Properties">
    <dc:modified>2023-05-25</dc:modified>
    <skos:notation>Properties of Physical Network Infrastructure</skos:notation>
    <skos:definition>The Physical Network Infrastructure ABB is an Equipment that enables connectivity and communication between users, devices, apps and the Internet.</skos:definition>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of Physical Network Infrastructure</skos:prefLabel>
    <dc:type>eira:PhysicalNetworkInfrastructureEquipment</dc:type>
    <eira:PURI>http://data.europa.eu/dr8/PhysicalNetworkInfrastructureEquipment</eira:PURI>
    <skos:example></skos:example>
    <eira:definitionSource>Inspired on relevant Physical Network Infrastructure providers</eira:definitionSource>
    <eira:concept>eira:ArchitectureBuildingBlock</eira:concept>
    <eira:iopDimension>Structural IoP</eira:iopDimension>
    <eira:iopDimension>Behavioral IoP</eira:iopDimension>
    <eira:iopSaliency>The Physical Network Infrastructure ABB is salient for technical interoperability because it provides the infrastructure to facilitate the hosting and execution of public administration services.</eira:iopSaliency>
    <skos:related rdf:resource="http://data.europa.eu/dr8/PhysicalNetworkInfrastructureEquipment"/>
    <eira:view>Technical view - infrastructure</eira:view>
    <dc:identifier>http://data.europa.eu/dr8/PhysicalNetworkInfrastructureEquipment</dc:identifier>
    <dc:identifier>http://data.europa.eu/dr8/PhysicalNetworkInfrastructureEquipment_Properties</dc:identifier>
    <eira:definitionSourceReference></eira:definitionSourceReference>
    <skos:note></skos:note>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/PhysicalPowerSupplyInfrastructureEquipment_Properties">
    <dc:modified>2023-05-25</dc:modified>
    <skos:notation>Properties of Physical Power Supply Infrastructure</skos:notation>
    <skos:definition>Physical Power Supply Infrastructure ABB is Equipment that enables reliable and uninterrupted electrical power to support the operation of public administration systems.</skos:definition>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of Physical Power Supply Infrastructure</skos:prefLabel>
    <dc:type>eira:PhysicalPowerSupplyInfrastructureEquipment</dc:type>
    <skos:example></skos:example>
    <eira:PURI>http://data.europa.eu/dr8/PhysicalPowerSupplyInfrastructureEquipment</eira:PURI>
    <eira:concept>eira:ArchitectureBuildingBlock</eira:concept>
    <eira:definitionSource>Inspired in Lawinsider</eira:definitionSource>
    <eira:iopDimension>Structural IoP</eira:iopDimension>
    <eira:iopSaliency>The Physical Power Supply Infrastructure ABB is salient for the technical interoperability due to it provides electrical supply to the public administration systems for ensuring their availability according to the service level agreements.</eira:iopSaliency>
    <skos:related rdf:resource="http://data.europa.eu/dr8/PhysicalPowerSupplyInfrastructureEquipment"/>
    <eira:view>Technical view - infrastructure</eira:view>
    <dc:identifier>http://data.europa.eu/dr8/PhysicalPowerSupplyInfrastructureEquipment_Properties</dc:identifier>
    <dc:identifier>http://data.europa.eu/dr8/PhysicalPowerSupplyInfrastructureEquipment</dc:identifier>
    <eira:definitionSourceReference>https://www.lawinsider.com/dictionary/power-supply-infrastructure</eira:definitionSourceReference>
    <skos:note></skos:note>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/PhysicalSecurityInfrastructureEquipment_Properties">
    <dc:modified>2023-05-25</dc:modified>
    <skos:definition>Physical Security Infrastructure ABB is Equipment that enables the protection of facilities and assets from actions and events that could cause damage or losses.</skos:definition>
    <skos:notation>Properties of Physical Security Infrastructure</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of Physical Security Infrastructure</skos:prefLabel>
    <dc:type>eira:PhysicalSecurityInfrastructureEquipment</dc:type>
    <skos:example></skos:example>
    <eira:PURI>http://data.europa.eu/dr8/PhysicalSecurityInfrastructureEquipment</eira:PURI>
    <eira:concept>eira:ArchitectureBuildingBlock</eira:concept>
    <eira:iopDimension>Structural IoP</eira:iopDimension>
    <eira:definitionSource>Inspired in Gartner</eira:definitionSource>
    <eira:iopSaliency>The Physical Security Infrastructure ABB is salient for technical interoperability because it provides the infrastructure capable of providing functionalities of data protection and privacy.</eira:iopSaliency>
    <skos:related rdf:resource="http://data.europa.eu/dr8/PhysicalSecurityInfrastructureEquipment"/>
    <eira:view>Technical view - infrastructure</eira:view>
    <dc:identifier>http://data.europa.eu/dr8/PhysicalSecurityInfrastructureEquipment_Properties</dc:identifier>
    <dc:identifier>http://data.europa.eu/dr8/PhysicalSecurityInfrastructureEquipment</dc:identifier>
    <eira:definitionSourceReference>https://www.gartner.com/en/information-technology/glossary/physical-security</eira:definitionSourceReference>
    <skos:note></skos:note>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/PreservationOfInformation_Properties">
    <dc:modified>2023-05-25</dc:modified>
    <skos:notation>Properties of Preservation of information</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of Preservation of information</skos:prefLabel>
    <dc:type>eira:PreservationOfInformation</dc:type>
    <eira:ID>ABB311</eira:ID>
    <eira:ABB_Status>Obsolete</eira:ABB_Status>
    <owl:deprecated>true</owl:deprecated>
    <skos:related rdf:resource="http://data.europa.eu/dr8/PreservationOfInformation"/>
    <dc:identifier>http://data.europa.eu/dr8/PreservationOfInformation_Properties</dc:identifier>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/PrivacyApplicationComponent_Properties">
    <dc:modified>2022-01-20</dc:modified>
    <skos:notation>Properties of Privacy</skos:notation>
    <skos:definition>Privacy ABB is an Application Component that enables the implementation of functionalities such as storing, securing, anonymising, pseudonymising, rectifying and erasing personal data.</skos:definition>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of Privacy</skos:prefLabel>
    <dc:type>eira:PrivacyApplicationComponent</dc:type>
    <skos:example>The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): SOLVIT - Solvit is a mailbox service for the access, rectification or deletion of personal data.(http://ec.europa.eu/solvit/privacy-statement/#maincontentSec8)</skos:example>
    <eira:PURI>http://data.europa.eu/dr8/PrivacyApplicationComponent</eira:PURI>
    <eira:concept>eira:ArchitectureBuildingBlock</eira:concept>
    <eira:iopDimension>Structural IoP</eira:iopDimension>
    <eira:definitionSource>ePrivacy Regulation</eira:definitionSource>
    <eira:synonym></eira:synonym>
    <eira:viewpoint>Interoperability Privacy viewpoint</eira:viewpoint>
    <eira:iopSaliency>The Privacy Component ABB  is salient for interoperability because &quot;security and privacy are primary concerns in the provision of public services&quot; (EIF) and, as stated in EIF Recommendation 15: &quot;Define a common security and privacy framework and establish processes for public services to ensure secure and trustworthy data exchange between public administrations and in interactions with citizens and businesses.&quot;</eira:iopSaliency>
    <skos:related rdf:resource="http://data.europa.eu/dr8/PrivacyApplicationComponent"/>
    <eira:view>Technical view - application</eira:view>
    <dc:identifier>http://data.europa.eu/dr8/PrivacyApplicationComponent_Properties</dc:identifier>
    <dc:identifier>http://data.europa.eu/dr8/PrivacyApplicationComponent</dc:identifier>
    <eira:definitionSourceReference>https://digital-strategy.ec.europa.eu/en/policies/eprivacy-regulation</eira:definitionSourceReference>
    <skos:note></skos:note>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/PrivacyApplicationService_Properties">
    <dc:modified>2022-01-20</dc:modified>
    <skos:definition>Privacy ABB is an Application Service enabling the share of functionalities such as storing, securing, anonymising, pseudonymising, rectifying and erasing personal data.</skos:definition>
    <skos:notation>Properties of Privacy</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of Privacy</skos:prefLabel>
    <dc:type>eira:PrivacyApplicationService</dc:type>
    <skos:example>The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): SOLVIT - Solvit is a mailbox service for the access, rectification or deletion of personal data.(http://ec.europa.eu/solvit/privacy-statement/#maincontentSec8)</skos:example>
    <eira:PURI>http://data.europa.eu/dr8/PrivacyApplicationService</eira:PURI>
    <eira:iopDimension>Behavioral IoP</eira:iopDimension>
    <eira:definitionSource>ePrivacy Regulation</eira:definitionSource>
    <eira:concept>eira:ArchitectureBuildingBlock</eira:concept>
    <eira:iopSaliency>The Privacy Service ABB  is salient for interoperability because &quot;security and privacy are primary concerns in the provision of public services&quot; (EIF) and, as stated in EIF Recommendation 15: &quot;Define a common security and privacy framework and establish processes for public services to ensure secure and trustworthy data exchange between public administrations and in interactions with citizens and businesses.&quot;</eira:iopSaliency>
    <eira:synonym></eira:synonym>
    <eira:viewpoint>Interoperability Privacy viewpoint</eira:viewpoint>
    <skos:related rdf:resource="http://data.europa.eu/dr8/PrivacyApplicationService"/>
    <eira:view>Technical view - application</eira:view>
    <dc:identifier>http://data.europa.eu/dr8/PrivacyApplicationService_Properties</dc:identifier>
    <dc:identifier>http://data.europa.eu/dr8/PrivacyApplicationService</dc:identifier>
    <eira:definitionSourceReference>https://digital-strategy.ec.europa.eu/en/policies/eprivacy-regulation</eira:definitionSourceReference>
    <skos:note></skos:note>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/PrivacyEnablersGrouping_Properties">
    <dc:modified>2023-05-25</dc:modified>
    <skos:definition>Privacy Enablers ABB is a Grouping that refers to components and services that facilitate the implementation of privacy-related functionality within an application or system</skos:definition>
    <skos:notation>Properties of Privacy Enablers</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of Privacy Enablers</skos:prefLabel>
    <dc:type>eira:PrivacyEnablersGrouping</dc:type>
    <eira:PURI>http://data.europa.eu/dr8/PrivacyEnablersGrouping</eira:PURI>
    <skos:example>The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): SOLVIT - Solvit is a mailbox service for the access, rectification or deletion of personal data.(http://ec.europa.eu/solvit/privacy-statement/#maincontentSec8)</skos:example>
    <eira:definitionSource>ePrivacy Regulation</eira:definitionSource>
    <eira:concept>eira:ArchitectureBuildingBlock</eira:concept>
    <eira:iopDimension>Behavioral IoP</eira:iopDimension>
    <eira:iopDimension>Structural IoP</eira:iopDimension>
    <eira:synonym></eira:synonym>
    <eira:iopSaliency>The Privacy Enablers Grouping ABB is salient for technical interoperability because it comprises tools and components that facilitate the implementation of privacy-related functionality within an application or system. This is relevant for the implementation and deployment of digital public services.</eira:iopSaliency>
    <skos:related rdf:resource="http://data.europa.eu/dr8/PrivacyEnablersGrouping"/>
    <eira:view>Technical view - application</eira:view>
    <dc:identifier>http://data.europa.eu/dr8/PrivacyEnablersGrouping</dc:identifier>
    <dc:identifier>http://data.europa.eu/dr8/PrivacyEnablersGrouping_Properties</dc:identifier>
    <eira:definitionSourceReference>https://digital-strategy.ec.europa.eu/en/policies/eprivacy-regulation</eira:definitionSourceReference>
    <skos:note></skos:note>
  </skos:Concept>

  <skos:Concept rdf:about="http://publications.europa.eu/resource/authority/language/ZXX">
    <skos:inScheme rdf:resource="http://publications.europa.eu/resource/authority/language"/>
    <skos:prefLabel xml:lang="en">No linguistic content</skos:prefLabel>
  </skos:Concept>

