    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/view/TechnicalView-Application"/>
    <skos:related rdf:resource="http://data.europa.eu/dr8/DataPersistenceApplicationApplicationService"/>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/DataSyntaxMappingCatalogueDataObject">
    <skos:definition xml:lang="en">Definition: Data Syntax Mapping Catalogue ABB is an Data Object bridging the differences between two systems, or data models, so that when data is moved from a source, it is accurate and usable at the destination.

Source: Inspired in Digital Strategy Europe

Source reference: &lt;a href=&quot;https://digital-strategy.ec.europa.eu/en/library/study-mapping-data-flows&quot; rel=&quot;nofollow&quot;&gt;https://digital-strategy.ec.europa.eu/en/library/study-mapping-data-flo…&lt;/a&gt;

LOST view: Semantic view

Identifier: &lt;a href=&quot;http://data.europa.eu/dr8/DataSyntaxMappingCatalogueDataObject&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/DataSyntaxMappingCatalogueDataObject&lt;/a&gt;

