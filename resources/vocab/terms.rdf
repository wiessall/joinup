  <skos:Concept rdf:about="http://data.europa.eu/dr8/CoordinationCapacityValue_Properties">
    <dc:modified>2023-05-25</dc:modified>
    <skos:definition>The Coordination Capacity Value ABB refers to mediating and bringing different administrative units and dispersed actors to work together to achieve joint actions. It is not only about vertical coordination by hierarchy but also about facilitating horizontal coordination across policy areas and organizations at the same administrative level.</skos:definition>
    <skos:notation>Properties of Coordination Capacity</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of Coordination Capacity</skos:prefLabel>
