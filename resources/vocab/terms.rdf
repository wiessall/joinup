  <skos:Concept rdf:about="http://data.europa.eu/dr8/APICatalogueDataObject_Properties">
    <dc:modified>2022-01-18</dc:modified>
    <skos:definition>API Catalogue ABB is a Data Object that corresponds to a collection of (open) software interfaces that allow data consumption by a specific digital solution</skos:definition>
    <skos:notation>Properties of API Catalogue</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of API Catalogue</skos:prefLabel>
    <dc:type>eira:APICatalogueDataObject</dc:type>
    <skos:example>The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): RapidAPI - RapidAPI is a collection of predefined APIs that are free to test, specifically updated for 2021. https://rapidapi.com/collection/list-of-free-apis</skos:example>
    <eira:concept>eira:ArchitectureBuildingBlock</eira:concept>
    <eira:PURI>http://data.europa.eu/dr8/APICatalogueDataObject</eira:PURI>
    <eira:definitionSource>Inspired in JRC</eira:definitionSource>
    <eira:iopDimension>Structural IoP</eira:iopDimension>
    <eira:iopDimension>Behavioral IoP</eira:iopDimension>
    <eira:iopSaliency>The API Catalogue Data Object ABB is salient for interoperability as it is a collection of software interfaces that allows data consumption between solutions and services.</eira:iopSaliency>
    <eira:synonym></eira:synonym>
    <skos:related rdf:resource="http://data.europa.eu/dr8/APICatalogueDataObject"/>
    <eira:view>Technical view - application</eira:view>
    <dc:identifier>http://data.europa.eu/dr8/APICatalogueDataObject</dc:identifier>
    <dc:identifier>http://data.europa.eu/dr8/APICatalogueDataObject_Properties</dc:identifier>
    <eira:definitionSourceReference>https://data.jrc.ec.europa.eu/dataset/5a431f38-1e2c-449a-898e-34f2a3234c3b</eira:definitionSourceReference>
    <skos:note></skos:note>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/APIDiscoveryandCatalogueApplicationService_Properties">
    <dc:modified>2022-01-18</dc:modified>
    <skos:definition>API Discovery and Catalogue Service ABB is an Application Service that enables the discovery and/or maintenance of the API Catalogue ABB.</skos:definition>
    <skos:notation>Properties of API Discovery and Catalogue</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of API Discovery and Catalogue</skos:prefLabel>
    <dc:type>eira:APIDiscoveryandCatalogueApplicationService</dc:type>
    <skos:example>The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): RapidAPI - RapidAPI is a collection of predefined APIs that are free to test, specifically updated for 2021. https://rapidapi.com/collection/list-of-free-apis</skos:example>
    <eira:PURI>http://data.europa.eu/dr8/APIDiscoveryandCatalogueApplicationService</eira:PURI>
    <eira:concept>eira:ArchitectureBuildingBlock</eira:concept>
    <eira:iopDimension>Structural IoP</eira:iopDimension>
    <eira:iopDimension>Behavioral IoP</eira:iopDimension>
    <eira:definitionSource>Inspired in Gartner</eira:definitionSource>
    <eira:iopSaliency>API Discovery and Catalogue Application Service ABB is a key interoperability enabler (*) for structural and behavioural interoperability by enabling and maintaining API Catalogues for public administration services. This is a key aspect enabling interoperability as it contributes to the discovery of APIs through catalogues.</eira:iopSaliency>
    <eira:synonym></eira:synonym>
    <eira:viewpoint>Key Interoperability Enablers viewpoint</eira:viewpoint>
    <skos:related rdf:resource="http://data.europa.eu/dr8/APIDiscoveryandCatalogueApplicationService"/>
    <eira:view>Technical view - application</eira:view>
    <dc:identifier>http://data.europa.eu/dr8/APIDiscoveryandCatalogueApplicationService</dc:identifier>
    <dc:identifier>http://data.europa.eu/dr8/APIDiscoveryandCatalogueApplicationService_Properties</dc:identifier>
    <eira:definitionSourceReference>https://www.gartner.com/en/information-technology/glossary/application-programming-interface</eira:definitionSourceReference>
    <skos:note></skos:note>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/APIEnablersGrouping_Properties">
    <dc:modified>2023-05-25</dc:modified>
    <skos:definition>API Enablers ABB is a Grouping that refers to components and frameworks that support the implementation and cataloguing of (open) software interfaces</skos:definition>
    <skos:notation>Properties of API Enablers</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of API Enablers</skos:prefLabel>
    <dc:type>eira:APIEnablersGrouping</dc:type>
    <skos:example></skos:example>
    <eira:concept>eira:ArchitectureBuildingBlock</eira:concept>
    <eira:PURI>http://data.europa.eu/dr8/APIEnablersGrouping</eira:PURI>
    <eira:iopDimension>Behavioral IoP</eira:iopDimension>
    <eira:iopDimension>Structural IoP</eira:iopDimension>
    <eira:definitionSource>European Comission</eira:definitionSource>
    <eira:synonym></eira:synonym>
    <eira:iopSaliency>The API Enablers Grouping ABB is salient for technical interoperability because this grouping composition of the different technologies that can implement software interfaces used to consume and provide data from public services. Implementing those technologies can enable interoperability throughout public services.</eira:iopSaliency>
    <skos:related rdf:resource="http://data.europa.eu/dr8/APIEnablersGrouping"/>
    <dc:identifier>http://data.europa.eu/dr8/APIEnablersGrouping_Properties</dc:identifier>
    <dc:identifier>http://data.europa.eu/dr8/APIEnablersGrouping</dc:identifier>
    <eira:view>Technical view - application</eira:view>
    <eira:definitionSourceReference>https://digital-strategy.ec.europa.eu/en/library/apis-enablers-digital-transformation-governments</eira:definitionSourceReference>
    <skos:note></skos:note>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/APIGatewayTechnologyService_Properties">
    <dc:modified>2022-01-31</dc:modified>
    <skos:definition>API Gateway ABB is a Technology Service that implements the behaviour of acting as a single entry point for multiple APIs (Application Programming Interfaces)</skos:definition>
    <skos:notation>Properties of API Gateway</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of API Gateway</skos:prefLabel>
    <dc:type>eira:APIGatewayTechnologyService</dc:type>
    <skos:example>The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): API Gateway Authentication Bundle. It authenticates requests from European Commission service API Gateway. https://joinup.ec.europa.eu/collection/ecphp/solution/api-gw-authentication-php/about</skos:example>
    <eira:concept>eira:ArchitectureBuildingBlock</eira:concept>
    <eira:PURI>http://data.europa.eu/dr8/APIGatewayTechnologyService</eira:PURI>
    <eira:iopDimension>Structural IoP</eira:iopDimension>
    <eira:iopDimension>Behavioral IoP</eira:iopDimension>
    <eira:definitionSource>Inspired in Joinup</eira:definitionSource>
    <eira:synonym></eira:synonym>
    <eira:iopSaliency>API Gateway ABB is salient for semantic interoperability due to its setting up the rules to share multiple public administration digital services to facilitate their accessibility, discovery and sharing across platforms (catalogue of APIs). These rules follow up existing standards and common practices in the API documentation and accessibility (Open APIs description).</eira:iopSaliency>
    <skos:related rdf:resource="http://data.europa.eu/dr8/APIGatewayTechnologyService"/>
    <eira:view>Technical view - infrastructure</eira:view>
    <dc:identifier>http://data.europa.eu/dr8/APIGatewayTechnologyService</dc:identifier>
    <dc:identifier>http://data.europa.eu/dr8/APIGatewayTechnologyService_Properties</dc:identifier>
    <eira:definitionSourceReference>https://joinup.ec.europa.eu/collection/api4dt/about</eira:definitionSourceReference>
    <skos:note></skos:note>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/APIManagerApplicationService_Properties">
    <dc:modified>2023-05-25</dc:modified>
    <skos:definition>API Manager Service ABB is a Application Service that that enables organizations to manage their Application Programming Interfaces (APIs) and create new APIs easily</skos:definition>
    <skos:notation>Properties of API Manager Service</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of API Manager Service</skos:prefLabel>
    <dc:type>eira:APIManagerApplicationService</dc:type>
    <skos:example></skos:example>
    <eira:concept>eira:ArchitectureBuildingBlock</eira:concept>
    <eira:PURI>http://data.europa.eu/dr8/APIManagerApplicationService</eira:PURI>
    <eira:iopDimension>Structural IoP</eira:iopDimension>
    <eira:iopDimension>Behavioral IoP</eira:iopDimension>
    <eira:iopDimension>Governance IoP</eira:iopDimension>
    <eira:definitionSource>Gartner</eira:definitionSource>
    <eira:viewpoint>REST API viewpoint</eira:viewpoint>
    <eira:synonym></eira:synonym>
    <eira:iopSaliency></eira:iopSaliency>
    <skos:related rdf:resource="http://data.europa.eu/dr8/APIManagerApplicationService"/>
    <dc:identifier>http://data.europa.eu/dr8/APIManagerApplicationService</dc:identifier>
    <dc:identifier>http://data.europa.eu/dr8/APIManagerApplicationService_Properties</dc:identifier>
