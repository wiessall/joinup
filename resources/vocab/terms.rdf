  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/SmartDevice_Properties">
    <dc:modified>2023-05-25</dc:modified>
    <skos:definition>Smart Device ABB is a Device that can operate interactively and autonomously, connected to other devices or networks through different communication protocols.</skos:definition>
    <skos:notation>Properties of Smart Device</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of Smart Device</skos:prefLabel>
    <dc:type>eira:SmartDevice</dc:type>
    <eira:PURI>http://data.europa.eu/dr8/SmartDevice</eira:PURI>
    <eira:iopDimension>Structural IoP</eira:iopDimension>
    <eira:iopDimension>Behavioral IoP</eira:iopDimension>
    <eira:definitionSource>European Comission</eira:definitionSource>
    <eira:concept>eira:ArchitectureBuildingBlock</eira:concept>
    <eira:iopSaliency>The Smart Device ABB is salient for technical interoperability because it provides the physical element to exchange information and events with the public administration digital services.</eira:iopSaliency>
    <eira:synonym></eira:synonym>
    <skos:related rdf:resource="http://data.europa.eu/dr8/SmartDevice"/>
    <eira:view>Technical view - infrastructure</eira:view>
    <dc:identifier>http://data.europa.eu/dr8/SmartDevice_Properties</dc:identifier>
    <dc:identifier>http://data.europa.eu/dr8/SmartDevice</dc:identifier>
    <eira:definitionSourceReference>https://digital-strategy.ec.europa.eu/en/policies/internet-things-policy</eira:definitionSourceReference>
    <skos:note>Smart devices typically incorporate sensors, processors, and connectivity technology, such as Wi-Fi or Bluetooth, that allow them to collect and exchange data</skos:note>
  </skos:Concept>

