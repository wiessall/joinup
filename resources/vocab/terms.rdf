&lt;li&gt;
             -
          data files
        &lt;/li&gt;
        
&lt;li&gt;
             -
          source code
        &lt;/li&gt;
        
&lt;li&gt;
             -
          build scripts
        &lt;/li&gt;
        
&lt;li&gt;
             -
          documentation
        &lt;/li&gt;
      
&lt;/ul&gt;
