  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/CreationOfInteroperableEuropeanSolutionsDriver_Properties">
    <dc:modified>2023-05-25</dc:modified>
    <skos:definition>The Creation of Interoperable European Solutions Driver represents an external or internal condition that motivates the public organisation to define its goals and implement the changes necessary to create Digital Public Services.</skos:definition>
    <skos:notation>Properties of Creation of Interoperable European Solutions</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of Creation of Interoperable European Solutions</skos:prefLabel>
    <dc:type>eira:CreationOfInteroperableEuropeanSolutionsDriver</dc:type>
    <skos:example></skos:example>
    <eira:PURI>http://data.europa.eu/dr8/CreationOfInteroperableEuropeanSolutionsDriver</eira:PURI>
    <eira:iopDimension>Structural IoP</eira:iopDimension>
    <eira:definitionSource>ArchiMate</eira:definitionSource>
    <eira:iopSaliency></eira:iopSaliency>
    <eira:synonym></eira:synonym>
    <eira:viewpoint>Enterprise Architecture Framework alignment guidelines viewpoint</eira:viewpoint>
    <skos:related rdf:resource="http://data.europa.eu/dr8/CreationOfInteroperableEuropeanSolutionsDriver"/>
    <eira:definitionSourceReference>https://pubs.opengroup.org/architecture/archimate3-doc/index.html</eira:definitionSourceReference>
    <dc:identifier>http://data.europa.eu/dr8/CreationOfInteroperableEuropeanSolutionsDriver_Properties</dc:identifier>
    <dc:identifier>http://data.europa.eu/dr8/CreationOfInteroperableEuropeanSolutionsDriver</dc:identifier>
    <skos:note></skos:note>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/DataAnalyticsApplicationComponent_Properties">
    <dc:modified>2022-01-20</dc:modified>
    <skos:definition>Data Analytics ABB is an Application Component that enables the implementation of procedures to analyze data and extract insights that can be used to improve business decision-making, optimize business processes, and drive innovation</skos:definition>
    <skos:notation>Properties of Data Analytics</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of Data Analytics</skos:prefLabel>
    <dc:type>eira:DataAnalyticsApplicationComponent</dc:type>
    <skos:example>The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): Microsoft Power BI - Power BI is a business analytics service by Microsoft. It aims to provide interactive visualizations and business intelligence capabilities with an interface simple enough for end users to create their own reports and dashboards. It is part of the Microsoft Power Platform.(https://powerbi.microsoft.com/it-it/what-is-power-bi/)</skos:example>
    <eira:PURI>http://data.europa.eu/dr8/DataAnalyticsApplicationComponent</eira:PURI>
    <eira:concept>eira:ArchitectureBuildingBlock</eira:concept>
    <eira:iopDimension>Structural IoP</eira:iopDimension>
    <eira:definitionSource>Inspired in Data Act</eira:definitionSource>
    <eira:iopSaliency>The Data Analytics Component ABB  is salient for technical interoperability because it provides the implementation of functionalities for the automation of mechanical processes and algorithms that work over raw data for human consumption.</eira:iopSaliency>
    <eira:synonym></eira:synonym>
    <skos:related rdf:resource="http://data.europa.eu/dr8/DataAnalyticsApplicationComponent"/>
    <eira:view>Technical view - application</eira:view>
    <eira:definitionSourceReference>https://digital-strategy.ec.europa.eu/en/policies/data-act</eira:definitionSourceReference>
    <dc:identifier>http://data.europa.eu/dr8/DataAnalyticsApplicationComponent_Properties</dc:identifier>
    <dc:identifier>http://data.europa.eu/dr8/DataAnalyticsApplicationComponent</dc:identifier>
    <skos:note>Data analytics component enable the automation of mechanical processes and algorithms that work over raw data for human consumption.</skos:note>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/DataAnalyticsApplicationService_Properties">
    <dc:modified>2022-01-20</dc:modified>
    <skos:definition>Data Analytics ABB is an Application Service that enables the use of procedures to analyze data and extract insights that can be used to improve business decision-making, optimize business processes, and drive innovation</skos:definition>
    <skos:notation>Properties of Data Analytics</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of Data Analytics</skos:prefLabel>
    <dc:type>eira:DataAnalyticsApplicationService</dc:type>
    <skos:example>The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): Microsoft Power BI - Power BI is a business analytics service by Microsoft. It aims to provide interactive visualizations and business intelligence capabilities with an interface simple enough for end users to create their own reports and dashboards. It is part of the Microsoft Power Platform.(https://powerbi.microsoft.com/it-it/what-is-power-bi/)</skos:example>
    <eira:PURI>http://data.europa.eu/dr8/DataAnalyticsApplicationService</eira:PURI>
    <eira:concept>eira:ArchitectureBuildingBlock</eira:concept>
    <eira:definitionSource>Inspired in Data Act</eira:definitionSource>
    <eira:iopDimension>Behavioral IoP</eira:iopDimension>
    <eira:iopSaliency>The Data Analytics Service ABB  is salient for technical interoperability because it enables the automated processing and analysis of different data source.</eira:iopSaliency>
    <eira:synonym></eira:synonym>
    <skos:related rdf:resource="http://data.europa.eu/dr8/DataAnalyticsApplicationService"/>
    <eira:view>Technical view - application</eira:view>
    <dc:identifier>http://data.europa.eu/dr8/DataAnalyticsApplicationService_Properties</dc:identifier>
    <dc:identifier>http://data.europa.eu/dr8/DataAnalyticsApplicationService</dc:identifier>
    <eira:definitionSourceReference>https://digital-strategy.ec.europa.eu/en/policies/data-act</eira:definitionSourceReference>
    <skos:note></skos:note>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/DataCatalogTechnologyService_Properties">
    <dc:modified>2022-12-1</dc:modified>
    <skos:definition>Data Catalog ABB is a Technology Service that enables the procedures of a centralised metadata repository to provide information about the data assets in a public administration</skos:definition>
    <skos:notation>Properties of Data Catalog</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of Data Catalog</skos:prefLabel>
    <dc:type>eira:DataCatalogTechnologyService</dc:type>
    <skos:example>The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): Jount Research Centre Data Catalogue. https://data.jrc.ec.europa.eu/</skos:example>
    <eira:PURI>http://data.europa.eu/dr8/DataCatalogTechnologyService</eira:PURI>
    <eira:concept>eira:ArchitectureBuildingBlock</eira:concept>
    <eira:definitionSource>Inspired in JRC</eira:definitionSource>
    <eira:iopDimension>Structural IoP</eira:iopDimension>
    <eira:iopDimension>Behavioral IoP</eira:iopDimension>
    <eira:iopSaliency>Data Catalog ABB is salient for semantic interoperability because it provides grouped datasets of information enhanced with metadata to promote their discovery, sharing and understanding for other digital services and public administrations</eira:iopSaliency>
    <eira:synonym></eira:synonym>
    <skos:related rdf:resource="http://data.europa.eu/dr8/DataCatalogTechnologyService"/>
    <eira:view>Technical view - infrastructure</eira:view>
    <dc:identifier>http://data.europa.eu/dr8/DataCatalogTechnologyService</dc:identifier>
    <dc:identifier>http://data.europa.eu/dr8/DataCatalogTechnologyService_Properties</dc:identifier>
    <eira:definitionSourceReference>https://data.jrc.ec.europa.eu/about</eira:definitionSourceReference>
    <skos:note></skos:note>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/DataEntity_Properties">
    <dc:modified>2023-05-25</dc:modified>
    <skos:notation>Properties of Data Entity</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of Data Entity</skos:prefLabel>
    <dc:type>eira:DataEntity</dc:type>
