  <skos:Concept rdf:about="http://data.europa.eu/dr8/TransationEnablersGrouping_Properties">
    <dc:modified>2023-05-25</dc:modified>
    <skos:definition>Machine Translation Enablers ABB is a Groping that refers to tools or components that facilitate the translation of text from one language to another using machine learning techniques</skos:definition>
    <skos:notation>Properties of Translation Enablers</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of Translation Enablers</skos:prefLabel>
    <skos:example></skos:example>
    <dc:type>eira:TransationEnablersGrouping</dc:type>
    <eira:concept>eira:ArchitectureBuildingBlock</eira:concept>
    <eira:PURI>http://data.europa.eu/dr8/TransationEnablersGrouping</eira:PURI>
    <eira:iopDimension>Structural IoP</eira:iopDimension>
    <eira:iopDimension>Behavioral IoP</eira:iopDimension>
    <eira:definitionSource>Inspired in eTranslation</eira:definitionSource>
    <eira:iopSaliency>The Translation Enablers Grouping ABB is salient for technical interoperability because it comprises a set of tools and components that ensure the translation of digital public services to different languages in the European Union by using machine learning techniques.</eira:iopSaliency>
    <eira:synonym></eira:synonym>
    <eira:view>Technical view - application</eira:view>
    <skos:related rdf:resource="http://data.europa.eu/dr8/TransationEnablersGrouping"/>
    <dc:identifier>http://data.europa.eu/dr8/TransationEnablersGrouping</dc:identifier>
    <dc:identifier>http://data.europa.eu/dr8/TransationEnablersGrouping_Properties</dc:identifier>
    <eira:definitionSourceReference>https://commission.europa.eu/resources-partners/etranslation_en</eira:definitionSourceReference>
    <skos:note></skos:note>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/Transparency_Properties">
    <dc:modified>2023-05-25</dc:modified>
    <skos:notation>Properties of Transparency</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
