  <skos:Concept rdf:about="http://data.europa.eu/dr8/BusinessProcessManagementComponent_Properties">
    <dc:modified>2023-05-25</dc:modified>
    <skos:notation>Properties of Business Process Management Component</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
