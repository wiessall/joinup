    <eira:definitionSourceReference>https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:32015D2240#d1e919-1-1</eira:definitionSourceReference>
    <skos:note></skos:note>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/KeyStructuralIopEnablersAssessment_Properties">
    <dc:modified>2023-05-25</dc:modified>
    <skos:definition>Key Structural IoP Enablers ABB is a Grouping enabling information interpretation to share and/or reuse of organizational resources of digital public services</skos:definition>
    <skos:notation>Properties of Key Structural IoP Enablers</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of Key Structural IoP Enablers</skos:prefLabel>
    <dc:type>eira:KeyStructuralIopEnablersAssessment</dc:type>
    <skos:example></skos:example>
