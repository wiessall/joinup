  <skos:Concept rdf:about="http://data.europa.eu/dr8/BusinessProcessManagerTechnologyService_Properties">
    <dc:modified>2023-05-25</dc:modified>
    <skos:definition>Business Process Manager ABB is a Technology Service that implements the behaviour of coordinates the behavior of people, systems, information and things to produce business outcomes in support of a business strategy</skos:definition>
    <skos:notation>Properties of Business Process Manager</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of Business Process Manager</skos:prefLabel>
    <dc:type>eira:BusinessProcessManagerTechnologyService</dc:type>
    <skos:example>The following implementation is an example of how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): UNDP- Business Process Re-engineering Manual. https://www.undp.org/sites/g/files/zskgke326/files/migration/uz/BPR-Manual_designed---Eng---final.pdf</skos:example>
    <eira:PURI>http://data.europa.eu/dr8/BusinessProcessManagerTechnologyService</eira:PURI>
    <eira:definitionSource>Gartner</eira:definitionSource>
    <eira:concept>eira:ArchitectureBuildingBlock</eira:concept>
    <eira:iopDimension>Structural IoP</eira:iopDimension>
    <eira:synonym></eira:synonym>
    <eira:iopSaliency>Business Process Manager ABB is salient for organizational interoperability due to it implements and defines business procedures related to public administration services.</eira:iopSaliency>
    <skos:related rdf:resource="http://data.europa.eu/dr8/BusinessProcessManagerTechnologyService"/>
    <dc:identifier>http://data.europa.eu/dr8/BusinessProcessManagerTechnologyService_Properties</dc:identifier>
    <dc:identifier>http://data.europa.eu/dr8/BusinessProcessManagerTechnologyService</dc:identifier>
    <eira:view>Technical view - infrastructure</eira:view>
    <eira:definitionSourceReference>https://www.gartner.com/en/information-technology/glossary/business-process-management-bpm</eira:definitionSourceReference>
    <skos:note></skos:note>
  </skos:Concept>

