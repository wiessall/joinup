  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/DataStandard_Properties">
    <dc:modified>2023-05-25</dc:modified>
    <skos:notation>Properties of Data Standard</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of Data Standard</skos:prefLabel>
    <dc:type>eira:DataStandard</dc:type>
    <eira:ABB_Status>Obsolete</eira:ABB_Status>
    <eira:ID>ABB183</eira:ID>
    <owl:deprecated>true</owl:deprecated>
    <skos:related rdf:resource="http://data.europa.eu/dr8/DataStandard"/>
