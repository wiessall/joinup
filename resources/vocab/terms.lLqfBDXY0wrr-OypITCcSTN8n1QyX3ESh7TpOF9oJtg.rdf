  <skos:Concept rdf:about="http://data.europa.eu/dr8/CapabilityRequirement_Properties">
    <dc:modified>2022-01-23</dc:modified>
    <skos:definition>Capability ABB is a Requirement that refers to the ability to develop, deploy, and maintain IoP applications and services. This includes knowledge and skills in areas such as software development, network engineering, data analytics, and cybersecurity</skos:definition>
    <skos:notation>Properties of Capability</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of Capability</skos:prefLabel>
    <dc:type>eira:CapabilityRequirement</dc:type>
    <skos:example></skos:example>
    <eira:PURI>http://data.europa.eu/dr8/CapabilityRequirement</eira:PURI>
    <eira:definitionSource>European Comission</eira:definitionSource>
    <eira:concept>eira:ArchitectureBuildingBlock</eira:concept>
    <eira:iopDimension>Structural IoP</eira:iopDimension>
    <eira:iopDimension>Governance IoP</eira:iopDimension>
    <eira:iopSaliency></eira:iopSaliency>
    <eira:synonym></eira:synonym>
    <eira:viewpoint>EIRA Ontology viewpoint</eira:viewpoint>
    <skos:related rdf:resource="http://data.europa.eu/dr8/CapabilityRequirement"/>
    <dc:identifier>http://data.europa.eu/dr8/CapabilityRequirement_Properties</dc:identifier>
    <dc:identifier>http://data.europa.eu/dr8/CapabilityRequirement</dc:identifier>
    <eira:definitionSourceReference>https://digital-strategy.ec.europa.eu/en/library/definition-artificial-intelligence-main-capabilities-and-scientific-disciplines</eira:definitionSourceReference>
    <skos:note></skos:note>
  </skos:Concept>

