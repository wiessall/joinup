  <skos:Concept rdf:about="http://data.europa.eu/dr8/ContentManagementService_Properties">
    <dc:modified>2023-05-25</dc:modified>
    <skos:notation>Properties of Content Management Service</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of Content Management Service</skos:prefLabel>
    <dc:type>eira:ContentManagementService</dc:type>
