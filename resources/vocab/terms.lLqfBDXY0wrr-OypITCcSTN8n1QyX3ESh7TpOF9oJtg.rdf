    <dc:type>eira:StreamingServerTechnologyService</dc:type>
    <skos:example>The following implementation is an example of how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): Study of use Open Source Software in the Public Sector. http://softlibre.unizar.es/manuales/legal/oss-fact-sheet.pdf</skos:example>
    <eira:PURI>http://data.europa.eu/dr8/StreamingServerTechnologyService</eira:PURI>
    <eira:concept>eira:ArchitectureBuildingBlock</eira:concept>
    <eira:iopDimension>Structural IoP</eira:iopDimension>
    <eira:iopDimension>Behavioral IoP</eira:iopDimension>
    <eira:iopSaliency></eira:iopSaliency>
    <eira:definitionSource>Inspired in Gartner</eira:definitionSource>
    <eira:synonym></eira:synonym>
    <skos:related rdf:resource="http://data.europa.eu/dr8/StreamingServerTechnologyService"/>
    <eira:view>Technical view - infrastructure</eira:view>
    <dc:identifier>http://data.europa.eu/dr8/StreamingServerTechnologyService</dc:identifier>
    <dc:identifier>http://data.europa.eu/dr8/StreamingServerTechnologyService_Properties</dc:identifier>
    <skos:note></skos:note>
    <eira:definitionSourceReference>https://www.gartner.com/en/information-technology/glossary/streaming</eira:definitionSourceReference>
  </skos:Concept>

