  <skos:Concept rdf:about="http://data.europa.eu/dr8/TechnicalInfrastructureFunctionalContentGrouping_Properties">
    <dc:modified>2023-05-25</dc:modified>
    <skos:definition>Technical Infrastructure Functional Content ABB is a Grouping of hardware, software, and network components that support the operation and functionality of an organization's IT systems and cloud services.</skos:definition>
    <skos:notation>Properties of Technical Infrastructure Functional content</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
