  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/CloudComputingFacility_Properties">
    <dc:modified>2023-11-1</dc:modified>
    <skos:notation>Properties of Cloud Computing Facility</skos:notation>
    <skos:definition>Cloud Computing Facility ABB is a Facility that enables the storage, processing and use of data on remotely located devices accessed over the internet</skos:definition>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of Cloud Computing Facility</skos:prefLabel>
    <dc:type>eira:CloudComputingFacility</dc:type>
    <skos:example>The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): FENIX is an infrastructure research project that incorporates cloud computing facilities from ICT Solutions for Brilliant Minds. https://fenix-ri.eu/about-fenix/project-partners</skos:example>
    <eira:concept>eira:ArchitectureBuildingBlock</eira:concept>
    <eira:definitionSource>European Comission-Unleashing the Potential of Cloud Computing in Europe</eira:definitionSource>
    <eira:PURI>http://data.europa.eu/dr8/CloudComputingFacility</eira:PURI>
    <eira:iopDimension>Structural IoP</eira:iopDimension>
    <eira:iopSaliency>The Cloud Computing Facility ABB is salient for organizational interoperability due to it provides the business rules and responsibilities to publish and manage the public administration services.</eira:iopSaliency>
    <eira:synonym></eira:synonym>
    <skos:related rdf:resource="http://data.europa.eu/dr8/CloudComputingFacility"/>
    <eira:view>Technical view - infrastructure</eira:view>
    <dc:identifier>http://data.europa.eu/dr8/CloudComputingFacility</dc:identifier>
    <dc:identifier>http://data.europa.eu/dr8/CloudComputingFacility_Properties</dc:identifier>
    <eira:definitionSourceReference>https://eur-lex.europa.eu/LexUriServ/LexUriServ.do?uri=COM:2012:0529:FIN:en:PDF</eira:definitionSourceReference>
    <skos:note></skos:note>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/CloudPrivateCommunicationNetwork_Properties">
    <dc:modified>2022-01-31</dc:modified>
    <skos:notation>Properties of Cloud Private Network</skos:notation>
    <skos:definition>Cloud Private Network ABB is a Communication Network that enables a virtual network that connects resources and services within a cloud computing environment.</skos:definition>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of Cloud Private Network</skos:prefLabel>
    <dc:type>eira:CloudPrivateCommunicationNetwork</dc:type>
    <skos:example>The following implementation is an example of how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): JRC- Development of the EU Green Public Procurement (GPP)- Criteria for Data Centres, Server Rooms and Cloud Services. https://ec.europa.eu/environment/gpp/pdf/jrc118558_2020_0605_data_centres_technical_report_jrc_clean_with_id.pdf</skos:example>
    <eira:concept>eira:ArchitectureBuildingBlock</eira:concept>
    <eira:definitionSource>Inspired in referent cloud service providers definitions</eira:definitionSource>
    <eira:PURI>http://data.europa.eu/dr8/CloudPrivateCommunicationNetwork</eira:PURI>
    <eira:iopSaliency>The Cloud Private Network ABB is salient for technical interoperability because it provides the needed infrastructure connection between cloud service providers to a specific group of people, organizations or systems.</eira:iopSaliency>
    <eira:iopDimension>Structural IoP</eira:iopDimension>
    <skos:related rdf:resource="http://data.europa.eu/dr8/CloudPrivateCommunicationNetwork"/>
    <eira:synonym></eira:synonym>
    <eira:view>Technical view - infrastructure</eira:view>
    <dc:identifier>http://data.europa.eu/dr8/CloudPrivateCommunicationNetwork</dc:identifier>
    <dc:identifier>http://data.europa.eu/dr8/CloudPrivateCommunicationNetwork_Properties</dc:identifier>
    <eira:definitionSourceReference></eira:definitionSourceReference>
    <skos:note></skos:note>
  </skos:Concept>

