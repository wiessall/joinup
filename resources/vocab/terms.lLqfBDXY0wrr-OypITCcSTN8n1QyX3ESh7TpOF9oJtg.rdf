    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/viewpoint/EnterpriseArchitectureFrameworkAlignmentGuidelinesViewpoint"/>
    <skos:related rdf:resource="http://data.europa.eu/dr8/SharedLegalContentGrouping"/>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/KeyBehaviouralIopEnablersAssessment">
    <skos:definition xml:lang="en"></skos:definition>
