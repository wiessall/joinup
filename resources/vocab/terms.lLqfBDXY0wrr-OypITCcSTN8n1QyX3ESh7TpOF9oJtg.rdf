  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/PrivateCloudFacility_Properties">
    <dc:modified>2022-01-31</dc:modified>
    <skos:definition>Private Cloud Computing Facility ABB is a Facility that enables a cloud infrastructure that is exclusively dedicated to a single organization or user.</skos:definition>
    <skos:notation>Properties of Private Cloud Computing Facility</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of Private Cloud Computing Facility</skos:prefLabel>
    <dc:type>eira:PrivateCloudFacility</dc:type>
    <skos:example>The following implementation is an example of how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): JRC- Development of the EU Green Public Procurement (GPP)- Critaria for Data Centres, Server Rooms and Cloud Services. https://ec.europa.eu/environment/gpp/pdf/jrc118558_2020_0605_data_centres_technical_report_jrc_clean_with_id.pdf</skos:example>
    <eira:concept>eira:ArchitectureBuildingBlock</eira:concept>
    <eira:PURI>http://data.europa.eu/dr8/PrivateCloudFacility</eira:PURI>
    <eira:iopDimension>Structural IoP</eira:iopDimension>
    <eira:definitionSource>Inspired in Redhat</eira:definitionSource>
    <eira:iopSaliency>Private Cloud Facilities ABB is salient for organizational and technical interoperability because it establishes the business rules and responsibilities to expose public digital services that are restricted for the use of custom organizations, users or devices.</eira:iopSaliency>
    <eira:viewpoint>Interoperability Security viewpoint</eira:viewpoint>
    <eira:synonym></eira:synonym>
    <eira:view>Technical view - infrastructure</eira:view>
    <skos:related rdf:resource="http://data.europa.eu/dr8/PrivateCloudFacility"/>
    <dc:identifier>http://data.europa.eu/dr8/PrivateCloudFacility_Properties</dc:identifier>
    <dc:identifier>http://data.europa.eu/dr8/PrivateCloudFacility</dc:identifier>
    <eira:definitionSourceReference>https://www.redhat.com/en/topics/cloud-computing/public-cloud-vs-private-cloud-and-hybrid-cloud</eira:definitionSourceReference>
    <skos:note></skos:note>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/PrivateCommunicationNetwork_Properties">
    <dc:modified>2022-01-31</dc:modified>
    <skos:definition>Private Network ABB is a Communication Network that enables the implementation of a network used for realising the physical communication among Interoperable European Solution (e.g. sTESTA), and cannot be accessed by the public.</skos:definition>
    <skos:notation>Properties of Private Network</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of Private Network</skos:prefLabel>
    <dc:type>eira:PrivateCommunicationNetwork</dc:type>
    <skos:example>The following implementation is an example of how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): ECC Report 301. https://docdb.cept.org/download/1395</skos:example>
    <eira:PURI>http://data.europa.eu/dr8/PrivateCommunicationNetwork</eira:PURI>
    <eira:concept>eira:ArchitectureBuildingBlock</eira:concept>
    <eira:iopDimension>Behavioral IoP</eira:iopDimension>
    <eira:iopDimension>Structural IoP</eira:iopDimension>
    <eira:iopSaliency>Private Network ABB is salient for technical interoperability because it implements and establishes the basis of the network of the public administration private area for exchanging, storing and sharing information at the internal level.</eira:iopSaliency>
    <eira:definitionSource>ISA2 - EIA Action</eira:definitionSource>
    <eira:synonym></eira:synonym>
    <eira:view>Technical view - infrastructure</eira:view>
    <skos:related rdf:resource="http://data.europa.eu/dr8/PrivateCommunicationNetwork"/>
    <dc:identifier>http://data.europa.eu/dr8/PrivateCommunicationNetwork_Properties</dc:identifier>
    <dc:identifier>http://data.europa.eu/dr8/PrivateCommunicationNetwork</dc:identifier>
    <eira:definitionSourceReference>https://ec.europa.eu/isa2/actions/towards-european-interoperability-architecture_en/</eira:definitionSourceReference>
    <skos:note></skos:note>
  </skos:Concept>

