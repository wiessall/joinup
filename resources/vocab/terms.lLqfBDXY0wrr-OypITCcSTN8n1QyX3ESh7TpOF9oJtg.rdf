  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/SmartDevice_Properties">
    <dc:modified>2023-05-25</dc:modified>
    <skos:definition>Smart Device ABB is a Device that can operate interactively and autonomously, connected to other devices or networks through different communication protocols.</skos:definition>
    <skos:notation>Properties of Smart Device</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of Smart Device</skos:prefLabel>
    <dc:type>eira:SmartDevice</dc:type>
    <eira:concept>eira:ArchitectureBuildingBlock</eira:concept>
    <eira:PURI>http://data.europa.eu/dr8/SmartDevice</eira:PURI>
    <eira:definitionSource>European Comission</eira:definitionSource>
    <eira:iopDimension>Structural IoP</eira:iopDimension>
    <eira:iopDimension>Behavioral IoP</eira:iopDimension>
    <eira:iopSaliency>The Smart Device ABB is salient for technical interoperability because it provides the physical element to exchange information and events with the public administration digital services.</eira:iopSaliency>
    <eira:synonym></eira:synonym>
    <skos:related>
      <skos:Concept rdf:about="http://data.europa.eu/dr8/SmartDevice">
        <skos:definition xml:lang="en">Definition: Smart Device ABB is a Device that can operate interactively and autonomously, connected to other devices or networks through different communication protocols.

Source: European Comission

Source reference: &lt;a href=&quot;https://digital-strategy.ec.europa.eu/en/policies/internet-things-policy&quot; rel=&quot;nofollow&quot;&gt;https://digital-strategy.ec.europa.eu/en/policies/internet-things-policy&lt;/a&gt;

Synonym:

Additional information: Smart devices typically incorporate sensors, processors, and connectivity technology, such as Wi-Fi or Bluetooth, that allow them to collect and exchange data

IoP Dimension:

LOST view: Technical view - Infrastructure

Interoperability saliency: The Smart Device ABB is salient for technical interoperability because it provides the physical element to exchange information and events with the public administration digital services.

Identifier: &lt;a href=&quot;http://data.europa.eu/dr8/SmartDevice&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/SmartDevice&lt;/a&gt;

eira:ID: &lt;a href=&quot;http://data.europa.eu/dr8/SmartDevice&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/SmartDevice&lt;/a&gt;

ABB name: eira:SmartDevice

EIRA concept: eira:ArchitectureBuildingBlock

Last modification:</skos:definition>
        <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
        <skos:prefLabel xml:lang="en">Smart Device</skos:prefLabel>
        <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/view/TechnicalView-Infrastructure"/>
      </skos:Concept>
    </skos:related>

    <eira:view>Technical view - infrastructure</eira:view>
    <dc:identifier>http://data.europa.eu/dr8/SmartDevice_Properties</dc:identifier>
    <dc:identifier>http://data.europa.eu/dr8/SmartDevice</dc:identifier>
    <skos:note>Smart devices typically incorporate sensors, processors, and connectivity technology, such as Wi-Fi or Bluetooth, that allow them to collect and exchange data</skos:note>
    <eira:definitionSourceReference>https://digital-strategy.ec.europa.eu/en/policies/internet-things-policy</eira:definitionSourceReference>
  </skos:Concept>

