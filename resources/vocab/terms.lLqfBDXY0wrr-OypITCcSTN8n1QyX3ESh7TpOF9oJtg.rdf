    <eira:definitionSourceReference>https://ec.europa.eu/isa2/eif_en/</eira:definitionSourceReference>
    <skos:note></skos:note>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/DigitalSolutionConstraintConstraint_Properties">
    <dc:modified>2022-01-23</dc:modified>
    <skos:definition>Digital Solution Constraint ABB is a Constraint that refers to the factor that limits the realization of the exchange and sharing of data across different platforms</skos:definition>
    <skos:notation>Properties of Digital Solution Constraint</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of Digital Solution Constraint</skos:prefLabel>
    <dc:type>eira:DigitalSolutionConstraintConstraint</dc:type>
    <skos:example></skos:example>
    <eira:PURI>http://data.europa.eu/dr8/DigitalSolutionConstraintConstraint</eira:PURI>
    <eira:definitionSource>ISA2-EIF</eira:definitionSource>
    <eira:concept>eira:ArchitectureBuildingBlock</eira:concept>
    <eira:iopDimension>Governance IoP</eira:iopDimension>
    <eira:iopDimension>Behavioral IoP</eira:iopDimension>
    <eira:iopSaliency></eira:iopSaliency>
    <eira:viewpoint>EIRA Ontology viewpoint</eira:viewpoint>
    <eira:viewpoint>Enterprise Architecture Framework alignment guidelines viewpoint</eira:viewpoint>
    <eira:synonym></eira:synonym>
    <skos:related rdf:resource="http://data.europa.eu/dr8/DigitalSolutionConstraintConstraint"/>
