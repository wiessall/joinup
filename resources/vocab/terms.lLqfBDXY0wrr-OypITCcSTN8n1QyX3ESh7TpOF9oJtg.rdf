  <skos:Concept rdf:about="http://data.europa.eu/dr8/SemanticGovernanceContentGrouping_Properties">
    <dc:modified>2023-05-25</dc:modified>
    <skos:definition>Semantic Governance Content ABB is a Grouping of the concepts and terms to support the elaboration of rules and mechanisms to enhance the availability, integrity, interoperability and  security of data while respecting data protection and ethical rules</skos:definition>
    <skos:notation>Properties of Semantic Governance content</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of Semantic Governance content</skos:prefLabel>
    <dc:type>eira:SemanticGovernanceContentGrouping</dc:type>
    <skos:example></skos:example>
    <eira:concept>eira:ArchitectureBuildingBlock</eira:concept>
    <eira:PURI>http://data.europa.eu/dr8/SemanticGovernanceContentGrouping</eira:PURI>
    <eira:definitionSource>EUR-LEX</eira:definitionSource>
    <eira:iopSaliency></eira:iopSaliency>
    <eira:viewpoint>Highlevel viewpoint</eira:viewpoint>
    <eira:viewpoint>Interoperability Governance viewpoint</eira:viewpoint>
    <eira:synonym></eira:synonym>
    <skos:related rdf:resource="http://data.europa.eu/dr8/SemanticGovernanceContentGrouping"/>
    <eira:view>Semantic view</eira:view>
    <dc:identifier>http://data.europa.eu/dr8/SemanticGovernanceContentGrouping</dc:identifier>
    <dc:identifier>http://data.europa.eu/dr8/SemanticGovernanceContentGrouping_Properties</dc:identifier>
    <eira:definitionSourceReference>https://eur-lex.europa.eu/legal-content/EN/TXT/PDF/?uri=CELEX:52020PC0767</eira:definitionSourceReference>
    <skos:note></skos:note>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/SemanticInteroperabilityAgreementContract_Properties">
    <dc:modified>2023-01-16</dc:modified>
    <skos:definition>Semantic interoperability agreement ABB is a Contract formalizing governance rules enabling collaboration between digital public services with ontological value.</skos:definition>
    <skos:notation>Properties of Semantic Interoperability Agreement</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of Semantic Interoperability Agreement</skos:prefLabel>
    <skos:example>The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): e-Invoicing Semantic Data Model - The semantic data model includes only the essential information elements that an electronic invoice needs to ensure legal (including fiscal) compliance and to enable interoperability for cross-border, cross-sector and for domestic trade. The semantic data model may be used by public and private sector organisations for public procurement invoicing and took into account the physical and financial supply chain perspective, reflecting both private and public sector requirements, with a view to allowing the full straight-through processing of an electronic invoice. https://ec.europa.eu/cefdigital/wiki/display/CEFDIGITAL/2017/06/28/CEN+Publishes+eInvoicing+Semantic+Data+Model</skos:example>
    <dc:type>eira:SemanticInteroperabilityAgreementContract</dc:type>
    <eira:PURI>http://data.europa.eu/dr8/SemanticInteroperabilityAgreementContract</eira:PURI>
    <eira:concept>eira:ArchitectureBuildingBlock</eira:concept>
    <eira:definitionSource>Joinup</eira:definitionSource>
    <eira:iopSaliency>The Semantic Interoperability Agreement ABB is a key interoperability enabler (*) for governance interoperability by enabling the understanding of information and collaboration between digital public services.</eira:iopSaliency>
    <eira:iopDimension>Governance IoP</eira:iopDimension>
    <eira:viewpoint>Interoperability Governance viewpoint</eira:viewpoint>
    <eira:viewpoint>Key Interoperability Enablers viewpoint</eira:viewpoint>
    <eira:synonym></eira:synonym>
    <skos:related rdf:resource="http://data.europa.eu/dr8/SemanticInteroperabilityAgreementContract"/>
    <eira:view>Semantic view</eira:view>
    <dc:identifier>http://data.europa.eu/dr8/SemanticInteroperabilityAgreementContract_Properties</dc:identifier>
    <dc:identifier>http://data.europa.eu/dr8/SemanticInteroperabilityAgreementContract</dc:identifier>
    <eira:definitionSourceReference>https://joinup.ec.europa.eu/sites/default/files/document/2015-03/Process</eira:definitionSourceReference>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/SemanticInteroperabilityRequirement_Properties">
    <dc:modified>2023-05-25</dc:modified>
