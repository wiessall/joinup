    <ns1:storage>[ Yes | No ]</ns1:storage>
    <owl:deprecated>true</owl:deprecated>
    <skos:related rdf:resource="http://data.europa.eu/dr8/PrivateHostingFacility"/>
    <dc:identifier>http://data.europa.eu/dr8/PrivateHostingFacility_Properties</dc:identifier>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/PrivateSubnetworkCommunicationNetwork_Properties">
    <dc:modified>2022-01-31</dc:modified>
    <skos:definition>Private Subnetwork ABB is a Communication Network that enables the implementation of a subset of a larger network that is isolated and only accessible to a specific group of devices or users</skos:definition>
    <skos:notation>Properties of Private Subnetwork</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of Private Subnetwork</skos:prefLabel>
    <skos:example>The following implementation is an example of how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): ECC Report 301. https://docdb.cept.org/download/1395</skos:example>
    <dc:type>eira:PrivateSubnetworkCommunicationNetwork</dc:type>
    <eira:concept>eira:ArchitectureBuildingBlock</eira:concept>
    <eira:PURI>http://data.europa.eu/dr8/PrivateSubnetworkCommunicationNetwork</eira:PURI>
    <eira:iopSaliency>The private subnetwork ABB is salient for technical interoperability because it provides custom private areas to share internal information about specific public administration internal services. These areas are only accessible by a restricted number of people and/or devices.</eira:iopSaliency>
    <eira:iopDimension>Structural IoP</eira:iopDimension>
    <eira:definitionSource>ISA2 - EIA Action</eira:definitionSource>
    <eira:synonym></eira:synonym>
    <skos:related rdf:resource="http://data.europa.eu/dr8/PrivateSubnetworkCommunicationNetwork"/>
    <eira:view>Technical view - infrastructure</eira:view>
    <dc:identifier>http://data.europa.eu/dr8/PrivateSubnetworkCommunicationNetwork_Properties</dc:identifier>
    <dc:identifier>http://data.europa.eu/dr8/PrivateSubnetworkCommunicationNetwork</dc:identifier>
    <eira:definitionSourceReference>https://ec.europa.eu/isa2/actions/towards-european-interoperability-architecture_en/</eira:definitionSourceReference>
    <skos:note></skos:note>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/Proactiveness_Properties">
    <dc:modified>2023-05-25</dc:modified>
    <skos:notation>Properties of Proactiveness</skos:notation>
