  <skos:Concept rdf:about="http://data.europa.eu/dr8/DatabaseCacheManagerTechnologyService_Properties">
    <dc:modified>2023-05-25</dc:modified>
    <skos:definition>Database Cache Manager ABB is a Technology Service that implements the behaviour of a software system that manages the caching of frequently accessed data in memory</skos:definition>
    <skos:notation>Properties of Database Cache Manager</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of Database Cache Manager</skos:prefLabel>
    <dc:type>eira:DatabaseCacheManagerTechnologyService</dc:type>
    <skos:example>The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): Redis, The open source, in-memory data store used by millions of developers as a database, cache, streaming engine, and message broker. https://redis.io/</skos:example>
    <eira:definitionSource>Inspired in the definition provided by relebant database vendors</eira:definitionSource>
    <eira:PURI>http://data.europa.eu/dr8/DatabaseCacheManagerTechnologyService</eira:PURI>
    <eira:concept>eira:ArchitectureBuildingBlock</eira:concept>
    <eira:iopDimension>Structural IoP</eira:iopDimension>
    <eira:iopSaliency>Database Cache Manager ABB is salient for semantic interoperability due to implementing a mechanism to manage data in memory to provide to the public administration consumers efficiently and in a short time response. It also facilitates data sharing and reuse using common data exchange models and serialisations.</eira:iopSaliency>
    <eira:synonym></eira:synonym>
    <skos:related rdf:resource="http://data.europa.eu/dr8/DatabaseCacheManagerTechnologyService"/>
    <eira:view>Technical view - infrastructure</eira:view>
    <dc:identifier>http://data.europa.eu/dr8/DatabaseCacheManagerTechnologyService</dc:identifier>
    <dc:identifier>http://data.europa.eu/dr8/DatabaseCacheManagerTechnologyService_Properties</dc:identifier>
    <eira:definitionSourceReference></eira:definitionSourceReference>
    <skos:note></skos:note>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/DatabaseInfrastructureEnablers_Properties">
    <dc:modified>2023-05-25</dc:modified>
    <skos:definition>Database Infrastructure Enablers ABB is a Groping that enables the tools and technology services for efficient management and operation of data under a storage system.</skos:definition>
    <skos:notation>Properties of Database Infrastructure Enablers</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of Database Infrastructure Enablers</skos:prefLabel>
    <dc:type>eira:DatabaseInfrastructureEnablers</dc:type>
    <skos:example>The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): MySQL manager, an SQL for MySQL.  https://www.sqlmanager.net/products/mysql/manager</skos:example>
    <eira:PURI>http://data.europa.eu/dr8/DatabaseInfrastructureEnablers</eira:PURI>
    <eira:concept>eira:ArchitectureBuildingBlock</eira:concept>
    <eira:definitionSource>Inspired in Gartner</eira:definitionSource>
    <eira:iopDimension>Structural IoP</eira:iopDimension>
    <eira:iopSaliency>Database Infrastructure Enablers ABB is salient for semantic and organization interoperability because it set up (i) tools to manage and manipulate data considering different types of data stores, (ii) establishes a data exchange mechanism to facilitate data understanding, (iii) manage data provenance through the public services interaction with the heterogeneous datastores.</eira:iopSaliency>
    <eira:synonym></eira:synonym>
    <skos:related rdf:resource="http://data.europa.eu/dr8/DatabaseInfrastructureEnablers"/>
    <eira:view>Technical view - infrastructure</eira:view>
    <eira:definitionSourceReference>https://www.gartner.com/en/information-technology/glossary/dbms-database-management-system</eira:definitionSourceReference>
    <dc:identifier>http://data.europa.eu/dr8/DatabaseInfrastructureEnablers</dc:identifier>
    <dc:identifier>http://data.europa.eu/dr8/DatabaseInfrastructureEnablers_Properties</dc:identifier>
    <skos:note></skos:note>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/DatabricksTechnologyService_Properties">
    <dc:modified>2023-05-25</dc:modified>
    <skos:definition>Databriks ABB is a Technology Service that enables the procedures of a collaborative workspace to process large amounts of public administration data</skos:definition>
    <skos:notation>Properties of Databricks</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Properties of Databricks</skos:prefLabel>
    <dc:type>eira:DatabricksTechnologyService</dc:type>
    <skos:example>The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): IOStack is an H2020 funded by the European Commission that implemented Databricks as the tool for processing large amounts of data. https://ec.europa.eu/research/participants/documents/downloadPublic?documentIds=080166e5ae65ba9a&amp;appId=PPGMS</skos:example>
    <eira:concept>eira:ArchitectureBuildingBlock</eira:concept>
    <eira:PURI>http://data.europa.eu/dr8/DatabricksTechnologyService</eira:PURI>
    <eira:definitionSource>Inspired in Databriks</eira:definitionSource>
    <eira:iopDimension>Structural IoP</eira:iopDimension>
    <eira:iopDimension>Behavioral IoP</eira:iopDimension>
    <eira:iopSaliency>Databriks ABB is salient for semantic interoperability because it permits to break of public administration siloes through the construction of shared spaces to process and analyse data from different sources and domains.</eira:iopSaliency>
    <eira:synonym></eira:synonym>
    <eira:view>Technical view - infrastructure</eira:view>
    <skos:related rdf:resource="http://data.europa.eu/dr8/DatabricksTechnologyService"/>
    <dc:identifier>http://data.europa.eu/dr8/DatabricksTechnologyService_Properties</dc:identifier>
    <dc:identifier>http://data.europa.eu/dr8/DatabricksTechnologyService</dc:identifier>
    <eira:definitionSourceReference>https://docs.databricks.com/introduction/index.html</eira:definitionSourceReference>
    <skos:note></skos:note>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/DefinitionOfPublicPolicyObjectives_Properties">
    <dc:modified>2023-05-25</dc:modified>
    <skos:notation>Properties of Definition of Public Policy Objectives</skos:notation>
    <skos:topConceptOf rdf:resource="http://data.europa.eu/dr8"/>
