		<skos:related rdf:resource="http://data.europa.eu/dr8/egovera/DataGovernanceApplicationService" />
		<skos:related rdf:resource="http://data.europa.eu/dr8/egovera/DataCatalogueManagementApplicationService" />
		<skos:related rdf:resource="http://data.europa.eu/dr8/DataManagementApplicationComponent" />
