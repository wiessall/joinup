	<skos:Concept rdf:about="http://data.europa.eu/dr8/LinkedDataRepresentation">
		<skos:notation><![CDATA[Linked Data (copy)]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/LinkedDataRepresentation</dcterms:identifier>
