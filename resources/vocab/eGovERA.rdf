	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/PublicBlockChainGovernanceBusinessObject_Properties">
		<skos:notation><![CDATA[Properties of Public BlockChain Governance (permissionless)]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/PublicBlockChainGovernanceBusinessObject_Properties</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[Properties of Public BlockChain Governance (permissionless)]]></skos:prefLabel>
		<skos:topConceptOf rdf:resource="http://data.europa.eu/dr8" />
