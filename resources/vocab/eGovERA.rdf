	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/BusinessAgnosticDataPolicyCatalogueGrouping_Properties">
		<skos:notation><![CDATA[Properties of Business Agnostic Data Policy Catalogue]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/BusinessAgnosticDataPolicyCatalogueGrouping_Properties</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[Properties of Business Agnostic Data Policy Catalogue]]></skos:prefLabel>
