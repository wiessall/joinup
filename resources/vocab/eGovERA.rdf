	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/BlockchainPolicyBusinessObject">
		<skos:notation><![CDATA[Blockchain policy]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/BlockchainPolicyBusinessObject</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[Blockchain policy]]></skos:prefLabel>
		<skos:topConceptOf rdf:resource="http://data.europa.eu/dr8" />
		<skos:definition xml:lang="en"><![CDATA[Definition: A Blockchain policy, as a specialization of a Data policy, can be defined as a set of rules, guidelines, and controls that govern the management, access, and utilization of data within a blockchain network or ecosystem. It outlines the specific protocols, procedures, and requirements for storing, validating, and securing data on the blockchain, ensuring integrity, immutability, and transparency.

Source: OECD

Source reference: https://www.oecd.org/daf/blockchain/

LOST view: SV-Governance Architecture Principles

Identifier: http://data.europa.eu/dr8/egovera/BlockchainPolicyBusinessObject

ABB name: egovera:BlockchainPolicyBusinessObject

EIRA concept: eira:ArchitectureBuildingBlock

Last modification: 2023-11-20

Identifier: http://data.europa.eu/dr8/egovera/BlockchainPolicyBusinessObject

Interoperability Layer: Semantic

Specialises: http://data.europa.eu/dr8/DataPolicy

]]></skos:definition>
		<egovera:BlockchainPolicyBusinessObject_Properties />
	</skos:Concept>
	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/BlockchainPolicyBusinessObject_Properties">
		<skos:notation><![CDATA[Properties of Blockchain policy]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/BlockchainPolicyBusinessObject_Properties</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[Properties of Blockchain policy]]></skos:prefLabel>
		<skos:topConceptOf rdf:resource="http://data.europa.eu/dr8" />
		<skos:related rdf:resource="http://data.europa.eu/dr8/egovera/BlockchainPolicyBusinessObject" />
