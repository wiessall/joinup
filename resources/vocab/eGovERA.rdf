		<dcterms:identifier>http://data.europa.eu/dr8/egovera/EIDAS-Proxy-ServiceApplicationService</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[eIDAS-Proxy-Service]]></skos:prefLabel>
