	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/ExchangeItemMetadataDataObject_Properties">
		<skos:notation><![CDATA[Properties of Exchange Item metadata]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/ExchangeItemMetadataDataObject_Properties</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[Properties of Exchange Item metadata]]></skos:prefLabel>
		<skos:topConceptOf rdf:resource="http://data.europa.eu/dr8" />
		<skos:related rdf:resource="http://data.europa.eu/dr8/egovera/ExchangeItemMetadataDataObject" />
		<skos:definition><![CDATA[Exchange Item Metadata refers to the structured information that provides descriptive and contextual details about an exchange item in a data exchange or integration process. It includes attributes such as the item's name, description, format, source, destination, and any additional metadata that helps define its characteristics and usage. Exchange Item Metadata serves as a standardized representation of the item's properties, enabling effective data integration, interoperability, and understanding across different systems and applications.]]></skos:definition>
		<eira:definitionSource><![CDATA[W3C]]></eira:definitionSource>
		<eira:definitionSourceReference><![CDATA[https://www.w3.org/standards/]]></eira:definitionSourceReference>
		<dcterms:modified>2023-11-20</dcterms:modified>
		<eira:concept>eira:ArchitectureBuildingBlock</eira:concept>
		<eira:PURI>http://data.europa.eu/dr8/egovera/ExchangeItemMetadataDataObject</eira:PURI>
		<dcterms:type>egovera:ExchangeItemMetadataDataObject</dcterms:type>
		<eira:view>SV-Business Agnostic Metadata</eira:view>
		<eira:view>SV-Functional Architecture Principles</eira:view>
		<eira:view>Semantic view - Motivation</eira:view>
		<eira:view>Semantic view</eira:view>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/ExchangeItemMetadataDataObject</dcterms:identifier>
		<eira:eifLayer>Semantic</eira:eifLayer>
		<skos:broader>http://data.europa.eu/dr8/DataSetDataObject</skos:broader>
	</skos:Concept>
	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/DCAT-APDataObject">
		<skos:notation><![CDATA[DCAT-AP]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/DCAT-APDataObject</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[DCAT-AP]]></skos:prefLabel>
		<skos:topConceptOf rdf:resource="http://data.europa.eu/dr8" />
		<skos:definition xml:lang="en"><![CDATA[Description: The DCAT Application Profile for data portals in Europe (DCAT-AP) is a specification based on the Data Catalogue Vocabulary (DCAT) developed by W3C. This application profile is a specification for metadata records to meet the specific application needs of data portals in Europe while providing semantic interoperability with other applications on the basis of reuse of established controlled vocabularies (e.g. EuroVoc) and mappings to existing metadata vocabularies (e.g. Dublin Core, SDMX, INSPIRE metadata, etc.).

Interoperability Dimension: Structural IoP

Publisher: European Commission

Source: https://joinup.ec.europa.eu/collection/semantic-interoperability-community-semic/solution/dcat-application-profile-data-portals-europe/about

LOST view: SV-Agnostic Ontologies

Identifier: http://data.europa.eu/dr8/egovera/DCAT-APDataObject

EIRA concept: eira:SolutionBuildingBlock

Last modification: 2024-01-28

Identifier: http://data.europa.eu/dr8/egovera/DCAT-APDataObject

Interoperability Layer: Semantic

Realises: http://data.europa.eu/dr8/ControlledVocabularyDataObject

]]></skos:definition>
		<egovera:DCAT-APDataObject_Properties />
	</skos:Concept>
