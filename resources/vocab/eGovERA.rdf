	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/EProfessionalQualificationApplicationInterface_Properties">
		<skos:notation><![CDATA[Properties of eProfessional Qualification]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/EProfessionalQualificationApplicationInterface_Properties</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[Properties of eProfessional Qualification]]></skos:prefLabel>
