		<skos:notation><![CDATA[Business Agnostic Dataspace Solutions]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/BusinessAgnosticDataspaceSolutionsGrouping</dcterms:identifier>
