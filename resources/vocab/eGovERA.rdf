	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/DataQualityFrameworkBusinessObject_Properties">
		<skos:notation><![CDATA[Properties of Data Quality Framework]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/DataQualityFrameworkBusinessObject_Properties</dcterms:identifier>
