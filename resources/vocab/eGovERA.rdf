		<skos:prefLabel xml:lang="en"><![CDATA[Properties of Mobile App]]></skos:prefLabel>
		<skos:topConceptOf rdf:resource="http://data.europa.eu/dr8" />
		<skos:related rdf:resource="http://data.europa.eu/dr8/MobileAppBusinessInterface" />
