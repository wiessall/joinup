	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/ADMSDataObject_Properties">
		<skos:notation><![CDATA[Properties of ADMS]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/ADMSDataObject_Properties</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[Properties of ADMS]]></skos:prefLabel>
