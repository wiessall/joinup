		<dcterms:identifier>http://data.europa.eu/dr8/egovera/EInvoicingApplicationInterface_Properties</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[Properties of eInvoicing]]></skos:prefLabel>
		<skos:topConceptOf rdf:resource="http://data.europa.eu/dr8" />
		<skos:related rdf:resource="http://data.europa.eu/dr8/egovera/EInvoicingApplicationInterface" />
