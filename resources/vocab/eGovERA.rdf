	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/AccessRightsBusinessObject_Properties">
		<skos:notation><![CDATA[Properties of Access rights]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/AccessRightsBusinessObject_Properties</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[Properties of Access rights]]></skos:prefLabel>
		<skos:topConceptOf rdf:resource="http://data.europa.eu/dr8" />
		<skos:related rdf:resource="http://data.europa.eu/dr8/egovera/AccessRightsBusinessObject" />
		<eira:PURI>http://data.europa.eu/dr8/egovera/AccessRightsBusinessObject</eira:PURI>
		<dcterms:modified>2023-11-20</dcterms:modified>
