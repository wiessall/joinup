	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/DigitalEuropeESignaturesDSSOpen-sourceLibraryApplicationService">
		<skos:notation><![CDATA[Digital Europe eSignature's DSS open-source library]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/DigitalEuropeESignaturesDSSOpen-sourceLibraryApplicationService</dcterms:identifier>
