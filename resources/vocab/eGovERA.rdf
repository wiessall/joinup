		<dcterms:title><![CDATA[Security Measure Information]]></dcterms:title>
		<eira:definitionSource><![CDATA[Collins Dictionary]]></eira:definitionSource>
		<eira:definitionSourceReference><![CDATA[https://www.collinsdictionary.com/dictionary/english/security-measure#:~:text=(s%C9%AA%CB%88kj%CA%8A%C9%99r%C9%AAt%C9%AA%20%CB%88m%C9%9B%CA%92%C9%99%20),terrorism%2C%20espionage%20or%20other%20danger]]></eira:definitionSourceReference>
