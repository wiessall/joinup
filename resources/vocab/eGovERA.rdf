	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/JRCDataCatalogueDataObject">
		<skos:notation><![CDATA[JRC Data Catalogue]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/JRCDataCatalogueDataObject</dcterms:identifier>
