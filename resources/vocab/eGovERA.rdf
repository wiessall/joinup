		<skos:related rdf:resource="http://data.europa.eu/dr8/egovera/PodmanApplicationService" />
		<eira:PURI>http://data.europa.eu/dr8/egovera/PodmanApplicationService</eira:PURI>
		<dcterms:modified>2024-01-28</dcterms:modified>
