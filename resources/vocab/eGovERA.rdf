	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/SupplyChainManagementApplicationInterface_Properties">
		<skos:notation><![CDATA[Properties of Supply Chain Management]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/SupplyChainManagementApplicationInterface_Properties</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[Properties of Supply Chain Management]]></skos:prefLabel>
		<skos:topConceptOf rdf:resource="http://data.europa.eu/dr8" />
		<skos:related rdf:resource="http://data.europa.eu/dr8/egovera/SupplyChainManagementApplicationInterface" />
		<dcterms:modified>2023-11-20</dcterms:modified>
		<skos:definition><![CDATA[The Supply Chain Management Application Service refers to a digital service that facilitates the planning, coordination, and optimization of activities involved in the end-to-end management of the supply chain. It encompasses the integration of various functions, including procurement, production, inventory management, logistics, and distribution, to ensure efficient and effective movement of goods or services from suppliers to customers. The application service provides functionalities such as demand forecasting, inventory tracking, order management, supplier collaboration, logistics optimization, and performance analytics. It aims to enhance visibility, transparency, and collaboration across the supply chain, enabling organizations to streamline operations, reduce costs, and improve customer satisfaction.]]></skos:definition>
		<eira:definitionSource><![CDATA[European Supply Chain Institute (ESCI)]]></eira:definitionSource>
		<eira:definitionSourceReference><![CDATA[]]></eira:definitionSourceReference>
		<eira:concept>eira:ArchitectureBuildingBlock</eira:concept>
		<eira:PURI>http://data.europa.eu/dr8/egovera/SupplyChainManagementApplicationInterface</eira:PURI>
		<dcterms:type>egovera:SupplyChainManagementApplicationInterface</dcterms:type>
		<eira:view>TVA-Functional Architecture Principles</eira:view>
		<eira:view>TVI-Management Infrastructure Enablers [Motivation]</eira:view>
		<eira:view>TVI-Application Integration Infrastructure Enablers [Motivation]</eira:view>
		<eira:view>Technical view - application</eira:view>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/SupplyChainManagementApplicationInterface</dcterms:identifier>
		<eira:eifLayer>TechnicalApplication</eira:eifLayer>
		<skos:broader>http://data.europa.eu/dr8/WebServiceApplicationInterface</skos:broader>
	</skos:Concept>
	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/EProfessionalQualificationApplicationInterface">
		<skos:notation><![CDATA[eProfessional Qualification]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/EProfessionalQualificationApplicationInterface</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[eProfessional Qualification]]></skos:prefLabel>
		<skos:topConceptOf rdf:resource="http://data.europa.eu/dr8" />
		<skos:definition xml:lang="en"><![CDATA[Definition: The eProfessional Qualification web service is a specialized application service that enables the management, verification, and processing of professional qualification-related information and services over the internet. It provides a standardized and secure interface for accessing and exchanging data related to professional qualifications, such as certifications, licenses, skills, and credentials. The eProfessional Qualification web service facilitates tasks such as qualification verification, applicant registration and assessment, qualification tracking, and reporting. It allows authorized stakeholders, including individuals, organizations, and regulatory bodies, to interact with the system and access accurate and up-to-date information regarding professional qualifications. The web service follows industry standards, protocols, and security measures to ensure the integrity, privacy, and reliability of the qualification data exchange.

Source: European Qualifications Framework (EQF)

Source reference: https://ec.europa.eu/ploteus/en/content/european-qualifications-framework-eqf

LOST view: TVA-API Enablers [Motivation]

Identifier: http://data.europa.eu/dr8/egovera/EProfessionalQualificationApplicationInterface

