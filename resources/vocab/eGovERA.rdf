	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/BusinessAgnosticDataFormatRepresentationAndSyntaxSolutionsGrouping_Properties">
		<skos:notation><![CDATA[Properties of Business Agnostic Data Format, Representation and Syntax Solutions]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/BusinessAgnosticDataFormatRepresentationAndSyntaxSolutionsGrouping_Properties</dcterms:identifier>
