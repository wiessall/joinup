	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/DigitalCollaborationBusinessService_Properties">
		<skos:notation><![CDATA[Properties of Digital Collaboration]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/DigitalCollaborationBusinessService_Properties</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[Properties of Digital Collaboration]]></skos:prefLabel>
