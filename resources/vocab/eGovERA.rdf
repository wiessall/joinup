		<skos:notation><![CDATA[Properties of RDF-XML]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/RDF-XMLRepresentation_Properties</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[Properties of RDF-XML]]></skos:prefLabel>
		<skos:topConceptOf rdf:resource="http://data.europa.eu/dr8" />
