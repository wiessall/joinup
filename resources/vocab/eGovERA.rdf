		<skos:notation><![CDATA[Properties of Data Persistence (copy)]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/DataPersistenceApplicationComponent_Properties</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[Properties of Data Persistence (copy)]]></skos:prefLabel>
