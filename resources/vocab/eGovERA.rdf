	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/SKOSRepresentation_Properties">
		<skos:notation><![CDATA[Properties of SKOS]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/SKOSRepresentation_Properties</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[Properties of SKOS]]></skos:prefLabel>
