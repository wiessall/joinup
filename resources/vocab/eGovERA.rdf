	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/TRiGRepresentation">
		<skos:notation><![CDATA[TRiG]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/TRiGRepresentation</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[TRiG]]></skos:prefLabel>
		<skos:topConceptOf rdf:resource="http://data.europa.eu/dr8" />
		<skos:definition xml:lang="en"><![CDATA[Description: TRiG is designed to express RDF data involving multiple named graphs or contexts. It allows the grouping of triples into different graphs, providing a way to differentiate and organize data within an RDF dataset. TRiG syntax is similar to Turtle, but it includes additional features for representing named graphs.

Publisher: W3C

Source: https://www.w3.org/TR/trig/

LOST view: SV-Functional Architecture Principles

Identifier: http://data.europa.eu/dr8/egovera/TRiGRepresentation

EIRA concept: eira:SolutionBuildingBlock

Last modification: 2024-01-28

Identifier: http://data.europa.eu/dr8/egovera/TRiGRepresentation

Interoperability Layer: Semantic

Realises: http://data.europa.eu/dr8/DataRepresentation

]]></skos:definition>
		<skos:broader rdf:resource="http://data.europa.eu/dr8/egovera/TurtleRepresentation" />
		<egovera:TRiGRepresentation_Properties />
	</skos:Concept>
	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/TRiGRepresentation_Properties">
		<skos:notation><![CDATA[Properties of TRiG]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/TRiGRepresentation_Properties</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[Properties of TRiG]]></skos:prefLabel>
		<skos:topConceptOf rdf:resource="http://data.europa.eu/dr8" />
		<skos:related rdf:resource="http://data.europa.eu/dr8/egovera/TRiGRepresentation" />
		<dcterms:modified>2024-01-28</dcterms:modified>
		<dcterms:publisher><![CDATA[W3C]]></dcterms:publisher>
		<dcterms:description>TRiG is designed to express RDF data involving multiple named graphs or contexts. It allows the grouping of triples into different graphs, providing a way to differentiate and organize data within an RDF dataset. TRiG syntax is similar to Turtle, but it includes additional features for representing named graphs.</dcterms:description>
		<dcterms:source><![CDATA[https://www.w3.org/TR/trig/]]></dcterms:source>
		<eira:concept>eira:SolutionBuildingBlock</eira:concept>
