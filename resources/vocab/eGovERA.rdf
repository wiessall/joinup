		<skos:notation><![CDATA[Properties of eDelivery]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/eDeliveryApplicationService_Properties</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[Properties of eDelivery]]></skos:prefLabel>
