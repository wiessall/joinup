		<skos:notation><![CDATA[Properties of Virtual Machine]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/VirtualMachineNode_Properties</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[Properties of Virtual Machine]]></skos:prefLabel>
