		<skos:notation><![CDATA[Properties of RDF Serialisations]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/RDFSerialisationsRepresentation_Properties</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[Properties of RDF Serialisations]]></skos:prefLabel>
		<skos:topConceptOf rdf:resource="http://data.europa.eu/dr8" />
		<skos:related rdf:resource="http://data.europa.eu/dr8/egovera/RDFSerialisationsRepresentation" />
		<skos:definition><![CDATA[RDF serialization can be defined as the process of encoding RDF (Resource Description Framework) data into a specific format or syntax that enables the storage, transmission, and exchange of structured data in a machine-readable manner. It involves transforming RDF triples into a serialized form, allowing data to be easily parsed, interpreted, and processed by both humans and computer systems.]]></skos:definition>
		<eira:definitionSource><![CDATA[W3C]]></eira:definitionSource>
		<eira:definitionSourceReference><![CDATA[https://www.w3.org/TR/rdf11-primer/]]></eira:definitionSourceReference>
		<dcterms:modified>2023-11-20</dcterms:modified>
		<eira:concept>eira:ArchitectureBuildingBlock</eira:concept>
		<eira:PURI>http://data.europa.eu/dr8/egovera/RDFSerialisationsRepresentation</eira:PURI>
		<dcterms:type>egovera:RDFSerialisationsRepresentation</dcterms:type>
		<eira:view>SV-Functional Architecture Principles</eira:view>
		<eira:view>Semantic view - Motivation</eira:view>
		<eira:view>Semantic view</eira:view>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/RDFSerialisationsRepresentation</dcterms:identifier>
		<eira:eifLayer>Semantic</eira:eifLayer>
		<skos:broader>http://data.europa.eu/dr8/DataRepresentation</skos:broader>
	</skos:Concept>
	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/RMLRepresentation">
		<skos:notation><![CDATA[RML]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/RMLRepresentation</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[RML]]></skos:prefLabel>
		<skos:topConceptOf rdf:resource="http://data.europa.eu/dr8" />
		<skos:definition xml:lang="en"><![CDATA[Description: The RDF Mapping Language (RML) is a technical specification that provides a standardized approach for transforming structured data from various formats into RDF (Resource Description Framework). RML enables the mapping of data from sources such as databases, spreadsheets, or APIs to RDF, which allows for semantic integration and interoperability. It provides a flexible and extensible mapping language that defines how the source data should be transformed into RDF triples. RML supports complex mappings, allowing for data extraction, transformation, and enrichment during the conversion process. By utilizing RML, technical teams can efficiently convert diverse data sources into RDF, facilitating seamless integration and utilization of structured data within the semantic web and linked data ecosystems.

Publisher: rml.io

Source: https://rml.io/specs/rml/

LOST view: SV-Functional Architecture Principles

Identifier: http://data.europa.eu/dr8/egovera/RMLRepresentation

EIRA concept: eira:SolutionBuildingBlock

Last modification: 2024-01-28

Identifier: http://data.europa.eu/dr8/egovera/RMLRepresentation

Interoperability Layer: Semantic

Realises: http://data.europa.eu/dr8/DataRepresentation

]]></skos:definition>
		<egovera:RMLRepresentation_Properties />
	</skos:Concept>
	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/RMLRepresentation_Properties">
		<skos:notation><![CDATA[Properties of RML]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/RMLRepresentation_Properties</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[Properties of RML]]></skos:prefLabel>
		<skos:topConceptOf rdf:resource="http://data.europa.eu/dr8" />
		<skos:related rdf:resource="http://data.europa.eu/dr8/egovera/RMLRepresentation" />
		<dcterms:modified>2024-01-28</dcterms:modified>
		<dcterms:publisher><![CDATA[rml.io]]></dcterms:publisher>
		<dcterms:description>The RDF Mapping Language (RML) is a technical specification that provides a standardized approach for transforming structured data from various formats into RDF (Resource Description Framework). RML enables the mapping of data from sources such as databases, spreadsheets, or APIs to RDF, which allows for semantic integration and interoperability. It provides a flexible and extensible mapping language that defines how the source data should be transformed into RDF triples. RML supports complex mappings, allowing for data extraction, transformation, and enrichment during the conversion process. By utilizing RML, technical teams can efficiently convert diverse data sources into RDF, facilitating seamless integration and utilization of structured data within the semantic web and linked data ecosystems.</dcterms:description>
		<dcterms:source><![CDATA[https://rml.io/specs/rml/]]></dcterms:source>
		<eira:concept>eira:SolutionBuildingBlock</eira:concept>
		<eira:PURI>http://data.europa.eu/dr8/egovera/RMLRepresentation</eira:PURI>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/RMLRepresentation</dcterms:identifier>
		<eira:view>SV-Functional Architecture Principles</eira:view>
		<eira:view>Semantic view - Motivation</eira:view>
		<eira:view>Semantic view</eira:view>
		<eira:eifLayer>Semantic</eira:eifLayer>
		<eira:implementedBy>http://data.europa.eu/dr8/DataRepresentation</eira:implementedBy>
	</skos:Concept>
	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/JSON-LRepresentation">
		<skos:notation><![CDATA[JSON-L]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/JSON-LRepresentation</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[JSON-L]]></skos:prefLabel>
		<skos:topConceptOf rdf:resource="http://data.europa.eu/dr8" />
		<skos:definition xml:lang="en"><![CDATA[Description: JSON Lines, also known as newline-delimited JSON, is a text format designed for storing structured data that can be processed one record at a time. It provides a convenient and efficient way to store and exchange data in a format that is compatible with Unix-style text processing tools and shell pipelines.

Publisher: JSON.org

Source: https://jsonlines.org/

LOST view: SV-Functional Architecture Principles

Identifier: http://data.europa.eu/dr8/egovera/JSON-LRepresentation

EIRA concept: eira:SolutionBuildingBlock

Last modification: 2024-01-28

Identifier: http://data.europa.eu/dr8/egovera/JSON-LRepresentation

Interoperability Layer: Semantic

Realises: http://data.europa.eu/dr8/DataRepresentation

]]></skos:definition>
		<skos:broader rdf:resource="http://data.europa.eu/dr8/egovera/JSONRepresentation" />
		<egovera:JSON-LRepresentation_Properties />
	</skos:Concept>
	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/JSON-LRepresentation_Properties">
		<skos:notation><![CDATA[Properties of JSON-L]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/JSON-LRepresentation_Properties</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[Properties of JSON-L]]></skos:prefLabel>
		<skos:topConceptOf rdf:resource="http://data.europa.eu/dr8" />
		<skos:related rdf:resource="http://data.europa.eu/dr8/egovera/JSON-LRepresentation" />
		<dcterms:modified>2024-01-28</dcterms:modified>
		<dcterms:publisher><![CDATA[JSON.org]]></dcterms:publisher>
		<dcterms:description>JSON Lines, also known as newline-delimited JSON, is a text format designed for storing structured data that can be processed one record at a time. It provides a convenient and efficient way to store and exchange data in a format that is compatible with Unix-style text processing tools and shell pipelines.</dcterms:description>
		<dcterms:source><![CDATA[https://jsonlines.org/]]></dcterms:source>
		<eira:concept>eira:SolutionBuildingBlock</eira:concept>
		<eira:PURI>http://data.europa.eu/dr8/egovera/JSON-LRepresentation</eira:PURI>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/JSON-LRepresentation</dcterms:identifier>
		<eira:view>SV-Functional Architecture Principles</eira:view>
		<eira:view>Semantic view - Motivation</eira:view>
		<eira:view>Semantic view</eira:view>
		<eira:eifLayer>Semantic</eira:eifLayer>
		<eira:implementedBy>http://data.europa.eu/dr8/DataRepresentation</eira:implementedBy>
	</skos:Concept>
	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/JSON-LDRepresentation">
		<skos:notation><![CDATA[JSON-LD]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/JSON-LDRepresentation</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[JSON-LD]]></skos:prefLabel>
		<skos:topConceptOf rdf:resource="http://data.europa.eu/dr8" />
		<skos:definition xml:lang="en"><![CDATA[Description: JSON-LD (JSON for Linked Data) is a serialization format that enables the representation of linked data using JSON (JavaScript Object Notation). It allows for the integration of structured data from different sources on the web, facilitating interoperability and knowledge sharing across systems.

Publisher: W3C

Source: https://www.w3.org/TR/json-ld11/

LOST view: SV-Functional Architecture Principles

Identifier: http://data.europa.eu/dr8/egovera/JSON-LDRepresentation

EIRA concept: eira:SolutionBuildingBlock

Last modification: 2024-01-28

Identifier: http://data.europa.eu/dr8/egovera/JSON-LDRepresentation

Interoperability Layer: Semantic

Realises: http://data.europa.eu/dr8/DataRepresentation

]]></skos:definition>
		<skos:broader rdf:resource="http://data.europa.eu/dr8/egovera/RDFSerialisationsRepresentation" />
		<skos:broader rdf:resource="http://data.europa.eu/dr8/egovera/JSONRepresentation" />
		<egovera:JSON-LDRepresentation_Properties />
	</skos:Concept>
	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/JSON-LDRepresentation_Properties">
		<skos:notation><![CDATA[Properties of JSON-LD]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/JSON-LDRepresentation_Properties</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[Properties of JSON-LD]]></skos:prefLabel>
		<skos:topConceptOf rdf:resource="http://data.europa.eu/dr8" />
		<skos:related rdf:resource="http://data.europa.eu/dr8/egovera/JSON-LDRepresentation" />
		<dcterms:modified>2024-01-28</dcterms:modified>
		<dcterms:publisher><![CDATA[W3C]]></dcterms:publisher>
		<dcterms:description>JSON-LD (JSON for Linked Data) is a serialization format that enables the representation of linked data using JSON (JavaScript Object Notation). It allows for the integration of structured data from different sources on the web, facilitating interoperability and knowledge sharing across systems.</dcterms:description>
		<dcterms:source><![CDATA[https://www.w3.org/TR/json-ld11/]]></dcterms:source>
		<eira:concept>eira:SolutionBuildingBlock</eira:concept>
		<eira:PURI>http://data.europa.eu/dr8/egovera/JSON-LDRepresentation</eira:PURI>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/JSON-LDRepresentation</dcterms:identifier>
		<eira:view>SV-Functional Architecture Principles</eira:view>
		<eira:view>Semantic view - Motivation</eira:view>
		<eira:view>Semantic view</eira:view>
		<eira:eifLayer>Semantic</eira:eifLayer>
		<eira:implementedBy>http://data.europa.eu/dr8/DataRepresentation</eira:implementedBy>
	</skos:Concept>
	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/RDFRepresentation">
		<skos:notation><![CDATA[RDF]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/RDFRepresentation</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[RDF]]></skos:prefLabel>
		<skos:topConceptOf rdf:resource="http://data.europa.eu/dr8" />
		<skos:definition xml:lang="en"><![CDATA[Description: RDF (Resource Description Framework) is a standard that enables businesses to represent and connect information in a structured and machine-readable way. It uses triples, which are subject-predicate-object statements, to describe resources and their relationships. RDF facilitates data integration and sharing across domains and systems, providing a common language for businesses to exchange and utilize structured information effectively. It forms the basis for building semantic web applications and supports data interoperability, enabling organizations to leverage and connect their data assets for improved decision-making and collaboration.

Publisher: W3C

Source: https://www.w3.org/RDF/

LOST view: SV-Functional Architecture Principles

Identifier: http://data.europa.eu/dr8/egovera/RDFRepresentation

EIRA concept: eira:SolutionBuildingBlock

Last modification: 2024-01-28

Identifier: http://data.europa.eu/dr8/egovera/RDFRepresentation

Interoperability Layer: Semantic

Realises: http://data.europa.eu/dr8/DataRepresentation

]]></skos:definition>
		<skos:narrower rdf:resource="http://data.europa.eu/dr8/egovera/RDF-SRepresentation" />
		<egovera:RDFRepresentation_Properties />
	</skos:Concept>
	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/RDFRepresentation_Properties">
		<skos:notation><![CDATA[Properties of RDF]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/RDFRepresentation_Properties</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[Properties of RDF]]></skos:prefLabel>
		<skos:topConceptOf rdf:resource="http://data.europa.eu/dr8" />
		<skos:related rdf:resource="http://data.europa.eu/dr8/egovera/RDFRepresentation" />
		<dcterms:modified>2024-01-28</dcterms:modified>
		<dcterms:publisher><![CDATA[W3C]]></dcterms:publisher>
		<dcterms:description>RDF (Resource Description Framework) is a standard that enables businesses to represent and connect information in a structured and machine-readable way. It uses triples, which are subject-predicate-object statements, to describe resources and their relationships. RDF facilitates data integration and sharing across domains and systems, providing a common language for businesses to exchange and utilize structured information effectively. It forms the basis for building semantic web applications and supports data interoperability, enabling organizations to leverage and connect their data assets for improved decision-making and collaboration.</dcterms:description>
		<dcterms:source><![CDATA[https://www.w3.org/RDF/]]></dcterms:source>
		<eira:concept>eira:SolutionBuildingBlock</eira:concept>
		<eira:PURI>http://data.europa.eu/dr8/egovera/RDFRepresentation</eira:PURI>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/RDFRepresentation</dcterms:identifier>
		<eira:view>SV-Functional Architecture Principles</eira:view>
		<eira:view>Semantic view - Motivation</eira:view>
		<eira:view>Semantic view</eira:view>
		<eira:eifLayer>Semantic</eira:eifLayer>
		<eira:implementedBy>http://data.europa.eu/dr8/DataRepresentation</eira:implementedBy>
	</skos:Concept>
	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/N3Representation">
		<skos:notation><![CDATA[N3]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/N3Representation</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[N3]]></skos:prefLabel>
		<skos:topConceptOf rdf:resource="http://data.europa.eu/dr8" />
		<skos:definition xml:lang="en"><![CDATA[Description: N3 is a serialization format for representing RDF (Resource Description Framework) data. It is an extension of Turtle (Terse RDF Triple Language) and provides additional features for expressing rules, formulas, and logical statements within RDF graphs. N3 aims to provide a more expressive and flexible syntax for representing RDF data compared to other serialization formats.

Publisher: W3C

Source: https://www.w3.org/TeamSubmission/n3/

LOST view: SV-Functional Architecture Principles

Identifier: http://data.europa.eu/dr8/egovera/N3Representation

EIRA concept: eira:SolutionBuildingBlock

Last modification: 2024-01-28

Identifier: http://data.europa.eu/dr8/egovera/N3Representation

Interoperability Layer: Semantic

Realises: http://data.europa.eu/dr8/DataRepresentation

]]></skos:definition>
		<skos:broader rdf:resource="http://data.europa.eu/dr8/egovera/RDFSerialisationsRepresentation" />
		<egovera:N3Representation_Properties />
	</skos:Concept>
	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/N3Representation_Properties">
		<skos:notation><![CDATA[Properties of N3]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/N3Representation_Properties</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[Properties of N3]]></skos:prefLabel>
		<skos:topConceptOf rdf:resource="http://data.europa.eu/dr8" />
		<skos:related rdf:resource="http://data.europa.eu/dr8/egovera/N3Representation" />
		<dcterms:modified>2024-01-28</dcterms:modified>
		<dcterms:publisher><![CDATA[W3C]]></dcterms:publisher>
		<dcterms:description>N3 is a serialization format for representing RDF (Resource Description Framework) data. It is an extension of Turtle (Terse RDF Triple Language) and provides additional features for expressing rules, formulas, and logical statements within RDF graphs. N3 aims to provide a more expressive and flexible syntax for representing RDF data compared to other serialization formats.</dcterms:description>
		<dcterms:source><![CDATA[https://www.w3.org/TeamSubmission/n3/]]></dcterms:source>
		<eira:concept>eira:SolutionBuildingBlock</eira:concept>
		<eira:PURI>http://data.europa.eu/dr8/egovera/N3Representation</eira:PURI>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/N3Representation</dcterms:identifier>
		<eira:view>SV-Functional Architecture Principles</eira:view>
		<eira:view>Semantic view - Motivation</eira:view>
		<eira:view>Semantic view</eira:view>
		<eira:eifLayer>Semantic</eira:eifLayer>
		<eira:implementedBy>http://data.europa.eu/dr8/DataRepresentation</eira:implementedBy>
	</skos:Concept>
	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/SIARD20FormatForDatabasesRepresentation">
		<skos:notation><![CDATA[SIARD 2.0 format for databases]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/SIARD20FormatForDatabasesRepresentation</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[SIARD 2.0 format for databases]]></skos:prefLabel>
		<skos:topConceptOf rdf:resource="http://data.europa.eu/dr8" />
		<skos:definition xml:lang="en"><![CDATA[Description: SIARD (Software Independent Archival of Relational Databases) is a normative description of an open file format for the long-term archiving of relational databases. SIARD is a nonproprietary, published open standard. The SIARD format is based on open standards, including the ISO standards Unicode, XML, and SQL, the URI Internet standard, and the industry standard ZIP. The aim of employing internationally recognised standards is to ensure the long-term preservation of, and access to, the widely used relational database model, as well as easy exchange of database content, independent of proprietary “dump” formats.

Publisher: The Digital Information LifeCycle Interoperability Standards Board (DILCIS Board)

Source: https://siard.dilcis.eu/

LOST view: SV-Functional Architecture Principles

Identifier: http://data.europa.eu/dr8/egovera/SIARD20FormatForDatabasesRepresentation

EIRA concept: eira:SolutionBuildingBlock

Last modification: 2024-01-28

Identifier: http://data.europa.eu/dr8/egovera/SIARD20FormatForDatabasesRepresentation

Interoperability Layer: Semantic

Realises: http://data.europa.eu/dr8/DataRepresentation

]]></skos:definition>
		<skos:broader rdf:resource="http://data.europa.eu/dr8/egovera/XMLRepresentation" />
		<egovera:SIARD20FormatForDatabasesRepresentation_Properties />
	</skos:Concept>
	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/SIARD20FormatForDatabasesRepresentation_Properties">
		<skos:notation><![CDATA[Properties of SIARD 2.0 format for databases]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/SIARD20FormatForDatabasesRepresentation_Properties</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[Properties of SIARD 2.0 format for databases]]></skos:prefLabel>
		<skos:topConceptOf rdf:resource="http://data.europa.eu/dr8" />
		<skos:related rdf:resource="http://data.europa.eu/dr8/egovera/SIARD20FormatForDatabasesRepresentation" />
		<dcterms:modified>2024-01-28</dcterms:modified>
		<dcterms:publisher><![CDATA[The Digital Information LifeCycle Interoperability Standards Board (DILCIS Board)]]></dcterms:publisher>
		<dcterms:description>SIARD (Software Independent Archival of Relational Databases) is a normative description of an open file format for the long-term archiving of relational databases. SIARD is a nonproprietary, published open standard. The SIARD format is based on open standards, including the ISO standards Unicode, XML, and SQL, the URI Internet standard, and the industry standard ZIP. The aim of employing internationally recognised standards is to ensure the long-term preservation of, and access to, the widely used relational database model, as well as easy exchange of database content, independent of proprietary “dump” formats.</dcterms:description>
		<dcterms:source><![CDATA[https://siard.dilcis.eu/]]></dcterms:source>
		<eira:concept>eira:SolutionBuildingBlock</eira:concept>
		<eira:PURI>http://data.europa.eu/dr8/egovera/SIARD20FormatForDatabasesRepresentation</eira:PURI>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/SIARD20FormatForDatabasesRepresentation</dcterms:identifier>
		<eira:view>SV-Functional Architecture Principles</eira:view>
		<eira:view>Semantic view - Motivation</eira:view>
		<eira:view>Semantic view</eira:view>
		<eira:eifLayer>Semantic</eira:eifLayer>
		<eira:implementedBy>http://data.europa.eu/dr8/DataRepresentation</eira:implementedBy>
	</skos:Concept>
	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/NQadsRepresentation">
		<skos:notation><![CDATA[NQads]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/NQadsRepresentation</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[NQads]]></skos:prefLabel>
		<skos:topConceptOf rdf:resource="http://data.europa.eu/dr8" />
		<skos:definition xml:lang="en"><![CDATA[Description: NQuads is a serialization format used for representing RDF (Resource Description Framework) data that extends the capabilities of the N-Triples format. NQuads provides a straightforward and flexible way to express RDF data in a quad format, which includes an additional context or named graph component. This makes it suitable for representing RDF datasets that involve multiple named graphs or contexts.

Publisher: W3C

Source: https://www.w3.org/TR/n-quads/

LOST view: SV-Functional Architecture Principles

Identifier: http://data.europa.eu/dr8/egovera/NQadsRepresentation

EIRA concept: eira:SolutionBuildingBlock

Last modification: 2024-01-28

Identifier: http://data.europa.eu/dr8/egovera/NQadsRepresentation

Interoperability Layer: Semantic

Realises: http://data.europa.eu/dr8/DataRepresentation

]]></skos:definition>
		<skos:broader rdf:resource="http://data.europa.eu/dr8/egovera/RDFSerialisationsRepresentation" />
		<egovera:NQadsRepresentation_Properties />
	</skos:Concept>
	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/NQadsRepresentation_Properties">
		<skos:notation><![CDATA[Properties of NQads]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/NQadsRepresentation_Properties</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[Properties of NQads]]></skos:prefLabel>
		<skos:topConceptOf rdf:resource="http://data.europa.eu/dr8" />
		<skos:related rdf:resource="http://data.europa.eu/dr8/egovera/NQadsRepresentation" />
		<dcterms:modified>2024-01-28</dcterms:modified>
		<dcterms:publisher><![CDATA[W3C]]></dcterms:publisher>
		<dcterms:description>NQuads is a serialization format used for representing RDF (Resource Description Framework) data that extends the capabilities of the N-Triples format. NQuads provides a straightforward and flexible way to express RDF data in a quad format, which includes an additional context or named graph component. This makes it suitable for representing RDF datasets that involve multiple named graphs or contexts.</dcterms:description>
		<dcterms:source><![CDATA[https://www.w3.org/TR/n-quads/]]></dcterms:source>
		<eira:concept>eira:SolutionBuildingBlock</eira:concept>
		<eira:PURI>http://data.europa.eu/dr8/egovera/NQadsRepresentation</eira:PURI>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/NQadsRepresentation</dcterms:identifier>
		<eira:view>SV-Functional Architecture Principles</eira:view>
		<eira:view>Semantic view - Motivation</eira:view>
		<eira:view>Semantic view</eira:view>
		<eira:eifLayer>Semantic</eira:eifLayer>
		<eira:implementedBy>http://data.europa.eu/dr8/DataRepresentation</eira:implementedBy>
	</skos:Concept>
	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/KMLRepresentation">
		<skos:notation><![CDATA[KML]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/KMLRepresentation</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[KML]]></skos:prefLabel>
		<skos:topConceptOf rdf:resource="http://data.europa.eu/dr8" />
		<skos:definition xml:lang="en"><![CDATA[Description: Keyhole Markup Language (KML) is an XML notation for expressing geographic annotation and visualization within two-dimensional maps and three-dimensional Earth browsers. KML was developed for use with Google Earth, which was originally named Keyhole Earth Viewer. It was created by Keyhole, Inc, which was acquired by Google in 2004. KML became an international standard of the Open Geospatial Consortium in 2008. Google Earth was the first program able to view and graphically edit KML files, but other projects such as Marble have added KML support.

Publisher: Keyhole.inc

Source: https://www.bing.com/search?q=keyhole+markup+language&cvid=61ba8b6734a744768bdc79af95473cc8&aqs=edge.1.69i57j0l8j69i11004.7235j0j4&FORM=ANAB01&PC=U531

LOST view: SV-Functional Architecture Principles

Identifier: http://data.europa.eu/dr8/egovera/KMLRepresentation

EIRA concept: eira:SolutionBuildingBlock

Last modification: 2024-01-28

Identifier: http://data.europa.eu/dr8/egovera/KMLRepresentation

Interoperability Layer: Semantic

Realises: http://data.europa.eu/dr8/DataRepresentation

]]></skos:definition>
		<egovera:KMLRepresentation_Properties />
	</skos:Concept>
	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/KMLRepresentation_Properties">
