		<dcterms:identifier>http://data.europa.eu/dr8/ServiceLevelAgreementContract_Properties</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[Properties of Service Level Agreement]]></skos:prefLabel>
