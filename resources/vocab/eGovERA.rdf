	</skos:Concept>
	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/InteroperabilityPolicyBusinessObject_Properties">
		<skos:notation><![CDATA[Properties of Interoperability Policy]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/InteroperabilityPolicyBusinessObject_Properties</dcterms:identifier>
