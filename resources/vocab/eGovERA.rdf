	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/EQualificationBusinessService_Properties">
		<skos:notation><![CDATA[Properties of eQualification]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/EQualificationBusinessService_Properties</dcterms:identifier>
