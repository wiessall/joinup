		<dcterms:identifier>http://data.europa.eu/dr8/egovera/FederatedDataCatalogueManagementApplicationService_Properties</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[Properties of Federated Data Catalogue Management (copy)]]></skos:prefLabel>
