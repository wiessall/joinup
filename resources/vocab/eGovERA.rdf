	</skos:Concept>
	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/EQualificationApplicationInterface_Properties">
		<skos:notation><![CDATA[Properties of eQualification]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/EQualificationApplicationInterface_Properties</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[Properties of eQualification]]></skos:prefLabel>
		<skos:topConceptOf rdf:resource="http://data.europa.eu/dr8" />
		<skos:related rdf:resource="http://data.europa.eu/dr8/egovera/EQualificationApplicationInterface" />
		<dcterms:modified>2023-11-20</dcterms:modified>
		<skos:definition><![CDATA[The eQualification Application Service refers to a digital service that enables the management and processing of qualifications and certifications in an electronic format. It facilitates the creation, verification, storage, and sharing of qualifications and related documentation electronically. The service provides a secure and efficient platform for individuals, educational institutions, employers, and certification bodies to manage qualifications, track progress, and validate credentials. It may include features such as online qualification submission, document verification, real-time qualification status updates, and integration with educational databases and certification authorities.]]></skos:definition>
		<eira:definitionSource><![CDATA[European Commission]]></eira:definitionSource>
		<eira:definitionSourceReference><![CDATA[https://ec.europa.eu/education/sites/education/files/2014-11-25-equal-recognition-foreign-qualifications_en.pdf]]></eira:definitionSourceReference>
		<eira:concept>eira:ArchitectureBuildingBlock</eira:concept>
