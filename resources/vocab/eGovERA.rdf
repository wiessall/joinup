	<skos:Concept rdf:about="http://data.europa.eu/dr8/EuropeanInteroperabilityReferenceArchitectureAssessment">
		<skos:notation><![CDATA[European Interoperability Reference Architecture]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/EuropeanInteroperabilityReferenceArchitectureAssessment</dcterms:identifier>
