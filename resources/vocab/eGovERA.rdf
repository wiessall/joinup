	<skos:Concept rdf:about="http://data.europa.eu/dr8/egovera/ODRLDataObject_Properties">
		<skos:notation><![CDATA[Properties of ODRL]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/egovera/ODRLDataObject_Properties</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[Properties of ODRL]]></skos:prefLabel>
		<skos:topConceptOf rdf:resource="http://data.europa.eu/dr8" />
		<skos:related rdf:resource="http://data.europa.eu/dr8/egovera/ODRLDataObject" />
		<dcterms:modified>2024-01-28</dcterms:modified>
		<dcterms:publisher><![CDATA[W3C]]></dcterms:publisher>
		<dcterms:description>The Organization Ontology is a standardized representation of organizational structures, roles, and relationships within the field of Linked Data and the Semantic Web. It provides a framework for describing and modeling various aspects of organizations, such as their hierarchy, departments, employees, and roles.</dcterms:description>
		<dcterms:source><![CDATA[https://www.w3.org/TR/vocab-org/]]></dcterms:source>
