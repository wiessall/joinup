	<skos:Concept rdf:about="http://data.europa.eu/dr8/MicroserviceArchitectureGoal_Properties">
		<skos:notation><![CDATA[Properties of Microservice Architecture]]></skos:notation>
		<dcterms:identifier>http://data.europa.eu/dr8/MicroserviceArchitectureGoal_Properties</dcterms:identifier>
		<skos:prefLabel xml:lang="en"><![CDATA[Properties of Microservice Architecture]]></skos:prefLabel>
