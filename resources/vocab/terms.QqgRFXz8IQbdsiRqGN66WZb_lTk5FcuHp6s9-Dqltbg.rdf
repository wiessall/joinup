  <skos:Concept rdf:about="http://data.europa.eu/dr8/CloudPrivateCommunicationNetwork">
    <skos:definition xml:lang="en">Definition: Cloud Private Network ABB is a Communication Network that enables a virtual network that connects resources and services within a cloud computing environment.

Source: Inspired in referent cloud service providers definitions

Example: The following implementation is an example of how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): JRC- Development of the EU Green Public Procurement (GPP)- Criteria for Data Centres, Server Rooms and Cloud Services. &lt;a href=&quot;https://ec.europa.eu/environment/gpp/pdf/jrc118558_2020_0605_data_centres_technical_report_jrc_clean_with_id.pdf&quot; rel=&quot;nofollow&quot;&gt;https://ec.europa.eu/environment/gpp/pdf/jrc118558_2020_0605_data_centr…&lt;/a&gt;

LOST view: Technical view - Infrastructure

Interoperability saliency: The Cloud Private Network ABB is salient for technical interoperability because it provides the needed infrastructure connection between cloud service providers to a specific group of people, organizations or systems.

Identifier: &lt;a href=&quot;http://data.europa.eu/dr8/CloudPrivateCommunicationNetwork&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/CloudPrivateCommunicationNetwork&lt;/a&gt;

eira:ID: &lt;a href=&quot;http://data.europa.eu/dr8/CloudPrivateCommunicationNetwork&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/CloudPrivateCommunicationNetwork&lt;/a&gt;

ABB name: eira:CloudPrivateCommunicationNetwork

EIRA concept: eira:ArchitectureBuildingBlock

Last modification: 2022-31-01</skos:definition>
    <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Cloud Private Network</skos:prefLabel>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/view/TechnicalView-Infrastructure"/>
    <ns0:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of Cloud Private Network&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/CloudPrivateCommunicationNetwork_Properties&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/CloudPrivateCommunicationNetwork&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of Cloud Private Network&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/CloudPrivateCommunicationNetwork&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:CloudPrivateCommunicationNetwork&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2022-01-31&quot;},{&quot;property&quot;:&quot;skos:definition&quot;,&quot;value&quot;:&quot;Cloud Private Network ABB is a Communication Network that enables a virtual network that connects resources and services within a cloud computing environment.&quot;},{&quot;property&quot;:&quot;eira:definitionSource&quot;,&quot;value&quot;:&quot;Inspired in referent cloud service providers definitions&quot;},{&quot;property&quot;:&quot;skos:example&quot;,&quot;value&quot;:&quot;The following implementation is an example of how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): JRC- Development of the EU Green Public Procurement (GPP)- Criteria for Data Centres, Server Rooms and Cloud Services. https:\/\/ec.europa.eu\/environment\/gpp\/pdf\/jrc118558_2020_0605_data_centres_technical_report_jrc_clean_with_id.pdf&quot;},{&quot;property&quot;:&quot;eira:iopSaliency&quot;,&quot;value&quot;:&quot;The Cloud Private Network ABB is salient for technical interoperability because it provides the needed infrastructure connection between cloud service providers to a specific group of people, organizations or systems.&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Structural IoP&quot;},{&quot;property&quot;:&quot;eira:view&quot;,&quot;value&quot;:&quot;Technical view - infrastructure&quot;}]}</ns0:properties>
