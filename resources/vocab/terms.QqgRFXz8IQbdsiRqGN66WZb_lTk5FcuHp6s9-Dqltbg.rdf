  <skos:Concept rdf:about="http://data.europa.eu/dr8/BusinessStakeholder">
    <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Business</skos:prefLabel>
    <skos:definition xml:lang="en">Definition: Business ABB is a Stakeholder that correspond to an individual, group, or organization that has an interest or stake in the success or failure of a particular product or service. Indeed, they focus on making, buying or selling goods or even, providing services in pursuing a benefit.

Source: Inspired in definition provided by relevant consultancy services

Source reference: &lt;a href=&quot;https://www.gartner.com/en/information-technology/glossary/business-process-as-a-service-bpaas&quot; rel=&quot;nofollow&quot;&gt;https://www.gartner.com/en/information-technology/glossary/business-pro…&lt;/a&gt;

Example: The following implementation is an example of how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB):  The instance of an Economic Operator that is using a digital public service to submit a tender.

IoP Dimension: Behavioural IoP

LOST view: Organisational view

Interoperability saliency: The Business ABB is salient for behavioural and organizational interoperability because it permits the identification of a specific stakeholder, which in turn allows the identification of its rights, permissions, and digital business capabilities. It also allows the security assurance and control configuration associated with this stakeholder, the discovery of data types that it can provide, as well as other aspects necessary to assure, monitor and control the exchange of data between this stakeholder and the digital public services providing to or consuming data from this stakeholder.

Identifier: &lt;a href=&quot;http://data.europa.eu/dr8/BusinessStakeholder&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/BusinessStakeholder&lt;/a&gt;

eira:ID: &lt;a href=&quot;http://data.europa.eu/dr8/BusinessStakeholder&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/BusinessStakeholder&lt;/a&gt;

ABB name: eira:BusinessStakeholder

EIRA concept: eira:ArchitectureBuildingBlock

Last modification: 2022-26-01</skos:definition>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/viewpoint/InteroperabilityPrivacyViewpoint"/>
    <ns1:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of Business&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/BusinessStakeholder_Properties&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/BusinessStakeholder&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of Business&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/BusinessStakeholder&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:BusinessStakeholder&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2022-01-26&quot;},{&quot;property&quot;:&quot;skos:definition&quot;,&quot;value&quot;:&quot;Business ABB is a Stakeholder that correspond to an individual, group, or organization that has an interest or stake in the success or failure of a particular product or service. Indeed, they focus on making, buying or selling goods or even, providing services in pursuing a benefit.&quot;},{&quot;property&quot;:&quot;eira:definitionSource&quot;,&quot;value&quot;:&quot;Inspired in definition provided by relevant consultancy services&quot;},{&quot;property&quot;:&quot;eira:definitionSourceReference&quot;,&quot;value&quot;:&quot;https:\/\/www.gartner.com\/en\/information-technology\/glossary\/business-process-as-a-service-bpaas&quot;},{&quot;property&quot;:&quot;skos:example&quot;,&quot;value&quot;:&quot;The following implementation is an example of how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB):  The instance of an Economic Operator that is using a digital public service to submit a tender.&quot;},{&quot;property&quot;:&quot;eira:iopSaliency&quot;,&quot;value&quot;:&quot;The Business ABB is salient for behavioural and organizational interoperability because it permits the identification of a specific stakeholder, which in turn allows the identification of its rights, permissions, and digital business capabilities. It also allows the security assurance and control configuration associated with this stakeholder, the discovery of data types that it can provide, as well as other aspects necessary to assure, monitor and control the exchange of data between this stakeholder and the digital public services providing to or consuming data from this stakeholder.&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Behavioral IoP&quot;},{&quot;property&quot;:&quot;eira:view&quot;,&quot;value&quot;:&quot;Organisational view&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;Interoperability Privacy viewpoint&quot;}]}</ns1:properties>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/DeliveryCapacityValue">
    <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Delivery Capacity</skos:prefLabel>
    <skos:definition xml:lang="en">Definition: The Delivery Capacity Value ABB refers to the ability of public administrations to deliver public services, programs, and policies effectively and efficiently to citizens and stakeholders. It encompasses the overall performance, effectiveness, and responsiveness of public administration in meeting the needs and expectations of the public.

Source: Public Administration Reform: A Comparative Analysis

IoP Dimension: Governance IoP

Identifier: &lt;a href=&quot;http://data.europa.eu/dr8/DeliveryCapacityValue&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/DeliveryCapacityValue&lt;/a&gt;

eira:ID: &lt;a href=&quot;http://data.europa.eu/dr8/DeliveryCapacityValue&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/DeliveryCapacityValue&lt;/a&gt;

ABB name: eira:DeliveryCapacityValue

EIRA concept: eira:ArchitectureBuildingBlock</skos:definition>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/viewpoint/EnterpriseArchitectureFrameworkAlignmentGuidelinesViewpoint"/>
    <ns1:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of Delivery Capacity&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/DeliveryCapacityValue_Properties&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/DeliveryCapacityValue&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of Delivery Capacity&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/DeliveryCapacityValue&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:DeliveryCapacityValue&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2023-05-25&quot;},{&quot;property&quot;:&quot;skos:definition&quot;,&quot;value&quot;:&quot;The Delivery Capacity Value ABB refers to the ability of public administrations to deliver public services, programs, and policies effectively and efficiently to citizens and stakeholders. It encompasses the overall performance, effectiveness, and responsiveness of public administration in meeting the needs and expectations of the public.&quot;},{&quot;property&quot;:&quot;eira:definitionSource&quot;,&quot;value&quot;:&quot;Public Administration Reform: A Comparative Analysis&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Governance IoP&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;Enterprise Architecture Framework alignment guidelines viewpoint&quot;}]}</ns1:properties>
