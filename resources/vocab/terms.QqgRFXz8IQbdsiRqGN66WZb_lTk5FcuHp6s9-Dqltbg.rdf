&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/FirewallApplicationService&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Structural IoP&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Behavioral IoP&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Governance IoP&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;REST API viewpoint&quot;}]}</ns0:properties>
