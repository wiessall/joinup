  <skos:Concept rdf:about="http://data.europa.eu/dr8/CapabilityRequirement">
    <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Capability</skos:prefLabel>
    <skos:definition xml:lang="en">Definition: Capability ABB is a Requirement that refers to the ability to develop, deploy, and maintain IoP applications and services. This includes knowledge and skills in areas such as software development, network engineering, data analytics, and cybersecurity

Source: European Comission

Source reference: &lt;a href=&quot;https://digital-strategy.ec.europa.eu/en/library/definition-artificial-intelligence-main-capabilities-and-scientific-disciplines&quot; rel=&quot;nofollow&quot;&gt;https://digital-strategy.ec.europa.eu/en/library/definition-artificial-…&lt;/a&gt;

Identifier: &lt;a href=&quot;http://data.europa.eu/dr8/CapabilityRequirement&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/CapabilityRequirement&lt;/a&gt;

ABB name: eira:CapabilityRequirement

Last modification: 2022-23-01</skos:definition>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/viewpoint/EIRAOntologyViewpoint"/>
    <ns1:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of Capability&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/CapabilityRequirement_Properties&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/CapabilityRequirement&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of Capability&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/CapabilityRequirement&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:CapabilityRequirement&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2022-01-23&quot;},{&quot;property&quot;:&quot;skos:definition&quot;,&quot;value&quot;:&quot;Capability ABB is a Requirement that refers to the ability to develop, deploy, and maintain IoP applications and services. This includes knowledge and skills in areas such as software development, network engineering, data analytics, and cybersecurity&quot;},{&quot;property&quot;:&quot;eira:definitionSource&quot;,&quot;value&quot;:&quot;European Comission&quot;},{&quot;property&quot;:&quot;eira:definitionSourceReference&quot;,&quot;value&quot;:&quot;https:\/\/digital-strategy.ec.europa.eu\/en\/library\/definition-artificial-intelligence-main-capabilities-and-scientific-disciplines&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Structural IoP&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Governance IoP&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;EIRA Ontology viewpoint&quot;}]}</ns1:properties>
