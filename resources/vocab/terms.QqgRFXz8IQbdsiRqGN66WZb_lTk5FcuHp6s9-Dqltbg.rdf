  <skos:Concept rdf:about="http://data.europa.eu/dr8/MobileAppBusinessInterface">
    <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Mobile App</skos:prefLabel>
    <skos:definition xml:lang="en">Definition: Mobile APP ABB is a Business Interface that corresponds to a computer program designed to run on a mobile device, such as a smartphone or tablet

Source: ISO/IEC 29179:2012

Source reference: &lt;a href=&quot;https://www.iso.org/standard/45258.html&quot; rel=&quot;nofollow&quot;&gt;https://www.iso.org/standard/45258.html&lt;/a&gt;

Example: The following implementation is an example of how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): EU Council mobile app. &lt;a href=&quot;https://play.google.com/store/apps/details?id=eu.europa.publications.eucouncil&amp;amp;hl=en_US&amp;amp;gl=US&amp;amp;pli=1&quot; rel=&quot;nofollow&quot;&gt;https://play.google.com/store/apps/details?id=eu.europa.publications.eu…&lt;/a&gt;

LOST view: Organisational view

Interoperability saliency: Mobile App ABB is salient for organizational, semantic and technical interoperability because it offers (i) a visual environment to interact with the public service procedures and data; (ii) an understanding of the information to be represented; and (iii) an elaborate mechanism to exchange data with public services.

Identifier: &lt;a href=&quot;http://data.europa.eu/dr8/MobileAppBusinessInterface&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/MobileAppBusinessInterface&lt;/a&gt;

eira:ID: &lt;a href=&quot;http://data.europa.eu/dr8/MobileAppBusinessInterface&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/MobileAppBusinessInterface&lt;/a&gt;

ABB name: eira:MobileAppBusinessInterface

EIRA concept: eira:ArchitectureBuildingBlock

Last modification: 2022-20-01</skos:definition>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/view/OrganisationalView"/>
    <ns1:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of Mobile App&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/MobileAppBusinessInterface_Properties&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/MobileAppBusinessInterface&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of Mobile App&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/MobileAppBusinessInterface&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:MobileAppBusinessInterface&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2022-01-20&quot;},{&quot;property&quot;:&quot;skos:definition&quot;,&quot;value&quot;:&quot;Mobile APP ABB is a Business Interface that corresponds to a computer program designed to run on a mobile device, such as a smartphone or tablet&quot;},{&quot;property&quot;:&quot;eira:definitionSource&quot;,&quot;value&quot;:&quot;ISO\/IEC 29179:2012&quot;},{&quot;property&quot;:&quot;eira:definitionSourceReference&quot;,&quot;value&quot;:&quot;https:\/\/www.iso.org\/standard\/45258.html&quot;},{&quot;property&quot;:&quot;skos:example&quot;,&quot;value&quot;:&quot;The following implementation is an example of how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): EU Council mobile app. https:\/\/play.google.com\/store\/apps\/details?id=eu.europa.publications.eucouncil\u0026hl=en_US\u0026gl=US\u0026pli=1&quot;},{&quot;property&quot;:&quot;eira:iopSaliency&quot;,&quot;value&quot;:&quot;Mobile App ABB is salient for organizational, semantic and technical interoperability because it offers (i) a visual environment to interact with the public service procedures and data; (ii) an understanding of the information to be represented; and (iii) an elaborate mechanism to exchange data with public services.&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Structural IoP&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Behavioral IoP&quot;},{&quot;property&quot;:&quot;eira:view&quot;,&quot;value&quot;:&quot;Organisational view&quot;}]}</ns1:properties>
