  <skos:Concept rdf:about="http://data.europa.eu/dr8/PublicPolicyEvaluation">
    <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Public Policy Evaluation</skos:prefLabel>
    <skos:definition xml:lang="en">A Public Policy Evaluation is an assessment of how the public policy met its objectives (according to defined criteria).

Source: Based on the concepts laid out in &lt;a href=&quot;http://www.europarl.europa.eu/RegData/etudes/etudes/join/2013/507457/IPOL-IMCO_ET(2013)507457_EN.pdf&quot; rel=&quot;nofollow&quot;&gt;http://www.europarl.europa.eu/RegData/etudes/etudes/join/2013/507457/IP…&lt;/a&gt;</skos:definition>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/Deprecated"/>
