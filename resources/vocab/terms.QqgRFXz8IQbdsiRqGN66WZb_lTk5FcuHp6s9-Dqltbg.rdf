        <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/view/TechnicalView-Infrastructure"/>
        <ns0:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of Enterprise Service Bus&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/EnterpriseServiceBusTechnologyService_Properties&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/EnterpriseServiceBusTechnologyService&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of Enterprise Service Bus&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/EnterpriseServiceBusTechnologyService&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:EnterpriseServiceBusTechnologyService&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2022-01-23&quot;},{&quot;property&quot;:&quot;skos:definition&quot;,&quot;value&quot;:&quot;Enterprise Service Bus ABB is a Technology Service that enables integration between applications by acting as a centralized component to perform the transformation in data models, handle connectivity, perform message routing, convert communication protocols and manage the composition of multiple requests.&quot;},{&quot;property&quot;:&quot;eira:definitionSource&quot;,&quot;value&quot;:&quot;Gartner&quot;},{&quot;property&quot;:&quot;eira:definitionSourceReference&quot;,&quot;value&quot;:&quot;https:\/\/www.gartner.com\/en\/documents\/1405237&quot;},{&quot;property&quot;:&quot;skos:example&quot;,&quot;value&quot;:&quot;The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): eXTra Enterprise Service Bus (eESB), eESB is an Enterprise Service Bus for exchanging data between the institutes of the German pension insurance. To connect the services within one institute EJB-Technology is used. The communication with external partners and between the different institutes of the German pension insurance is based on SOAP-WebServices. As data structure for the general communication the eXTra-Standard is used to address the responsible service applications. https:\/\/joinup.ec.europa.eu\/collection\/egovernment\/solution\/extra-enterprise-service-bus-eesb\/about&quot;},{&quot;property&quot;:&quot;eira:iopSaliency&quot;,&quot;value&quot;:&quot;Enterprise Service Bus ABB is salient for semantic and technical interoperability due to it ensuring (i) data sharing across different public service applications and infrastructures using specific enhanced datasets with metadata, and (ii) providing data sharing mechanism using open specifications and open data standards.&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Structural IoP&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Behavioral IoP&quot;},{&quot;property&quot;:&quot;eira:view&quot;,&quot;value&quot;:&quot;Technical view - infrastructure&quot;}]}</ns0:properties>
        <skos:related rdf:resource="http://data.europa.eu/dr8/SharedInfrastructureContentGrouping"/>
      </skos:Concept>
    </skos:related>

  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/ApplicationPresentationEnablersGrouping">
    <skos:definition xml:lang="en">Definition: Application Presentation Enablers ABB is a Grouping that enables the implementation of visually appealing and interactive user interfaces for software applications

Source: Inspired in Redhat

Source reference: &lt;a href=&quot;https://www.redhat.com/architect/5-essential-patterns-software-architecture&quot; rel=&quot;nofollow&quot;&gt;https://www.redhat.com/architect/5-essential-patterns-software-architec…&lt;/a&gt;

IoP Dimension: Behavioral IoP

LOST view: Technical view - application

Interoperability saliency: The Application Presentation Enablers Grouping ABB is salient for interoperability because is composed of the Human Interface Application Interface which is a key interoperability enabler that facilitates the data exchange between parties using the digital public service. In addition, this is relevant for interoperability because the ABBs included can work as a tool through which to assess compatible interfaces.

Identifier: &lt;a href=&quot;http://data.europa.eu/dr8/ApplicationPresentationEnablersGrouping&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/ApplicationPresentationEnablersGrouping&lt;/a&gt;

eira:ID: &lt;a href=&quot;http://data.europa.eu/dr8/ApplicationPresentationEnablersGrouping&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/ApplicationPresentationEnablersGrouping&lt;/a&gt;

ABB name: eira:ApplicationPresentationEnablersGrouping

EIRA concept: eira:ArchitectureBuildingBlock</skos:definition>
    <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Application Presentation Enablers</skos:prefLabel>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/viewpoint/EIRAOntologyViewpoint"/>
    <ns0:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of Application Presentation Enablers&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/ApplicationPresentationEnablersGrouping_Properties&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/ApplicationPresentationEnablersGrouping&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of Application Presentation Enablers&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/ApplicationPresentationEnablersGrouping&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:ApplicationPresentationEnablersGrouping&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2023-05-25&quot;},{&quot;property&quot;:&quot;skos:definition&quot;,&quot;value&quot;:&quot;Application Presentation Enablers ABB is a Grouping that enables the implementation of visually appealing and interactive user interfaces for software applications&quot;},{&quot;property&quot;:&quot;eira:definitionSource&quot;,&quot;value&quot;:&quot;Inspired in Redhat&quot;},{&quot;property&quot;:&quot;eira:definitionSourceReference&quot;,&quot;value&quot;:&quot;https:\/\/www.redhat.com\/architect\/5-essential-patterns-software-architecture&quot;},{&quot;property&quot;:&quot;eira:iopSaliency&quot;,&quot;value&quot;:&quot;The Application Presentation Enablers Grouping ABB is salient for interoperability because is composed of the Human Interface Application Interface which is a key interoperability enabler that facilitates the data exchange between parties using the digital public service. In addition, this is relevant for interoperability because the ABBs included can work as a tool through which to assess compatible interfaces.&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Behavioral IoP&quot;},{&quot;property&quot;:&quot;eira:view&quot;,&quot;value&quot;:&quot;Technical view - application&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;Highlevel viewpoint&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;EIRA Ontology viewpoint&quot;}]}</ns0:properties>
    <skos:related>
      <skos:Concept rdf:about="http://data.europa.eu/dr8/HumanApplicationInterface">
        <skos:definition xml:lang="en">Definition: Human Interface ABB is an Application Interface that enables the exchange of data between stakeholders (individuals, public administration or legal entities) and a service. This ABB is a key interoperability enabler (*) for assessing compatible interfaces.

Source: EIA Action

Source reference: &lt;a href=&quot;https://ec.europa.eu/isa2/eif_en&quot; rel=&quot;nofollow&quot;&gt;https://ec.europa.eu/isa2/eif_en&lt;/a&gt;

Synonym: User interface, UI, Graphical User Interface, GUI

Example: The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): GrapesJS - GrapesJS is an open-source, multi-purpose, Web Builder Framework which combines different tools and features with the goal to help you (or users of your application) to build HTML templates without any knowledge of coding. It's a perfect solution to replace the common WYSIWYG editors, which are good for content editing but inappropriate for creating HTML structures. You can see it in action with the official demos, but using its API you're able to build your own editors. &lt;a href=&quot;https://grapesjs.com/&quot; rel=&quot;nofollow&quot;&gt;https://grapesjs.com/&lt;/a&gt;

IoP Dimension: Behavioral IoP

LOST view: Technical view - application

Interoperability saliency: The Human Interface ABB is a key interoperability enabler because it supports to achieve technical behavioral interoperability by enabling the exchange of data, information, and knowledge between digital public services and individuals.

Identifier: &lt;a href=&quot;http://data.europa.eu/dr8/HumanApplicationInterface&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/HumanApplicationInterface&lt;/a&gt;

eira:ID: ABB37

ABB name: eira:HumanApplicationInterface

EIRA concept: eira:ArchitectureBuildingBlock

Last modification: 2022-18-01</skos:definition>
        <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
        <skos:prefLabel xml:lang="en">Human Interface</skos:prefLabel>
        <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/viewpoint/RESTAPIViewpoint"/>
        <ns0:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of Human Interface&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/HumanApplicationInterface_Properties&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/HumanApplicationInterface&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of Human Interface&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/HumanApplicationInterface&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:HumanApplicationInterface&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2022-01-18&quot;},{&quot;property&quot;:&quot;eira:synonym&quot;,&quot;value&quot;:&quot;User interface, UI, Graphical User Interface, GUI&quot;},{&quot;property&quot;:&quot;skos:definition&quot;,&quot;value&quot;:&quot;Human Interface ABB is an Application Interface that enables the exchange of data between stakeholders (individuals, public administration or legal entities) and a service. This ABB is a key interoperability enabler (*) for assessing compatible interfaces.&quot;},{&quot;property&quot;:&quot;eira:definitionSource&quot;,&quot;value&quot;:&quot;EIA Action&quot;},{&quot;property&quot;:&quot;eira:definitionSourceReference&quot;,&quot;value&quot;:&quot;https:\/\/ec.europa.eu\/isa2\/eif_en&quot;},{&quot;property&quot;:&quot;skos:example&quot;,&quot;value&quot;:&quot;The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): GrapesJS - GrapesJS is an open-source, multi-purpose, Web Builder Framework which combines different tools and features with the goal to help you (or users of your application) to build HTML templates without any knowledge of coding. It\u0027s a perfect solution to replace the common WYSIWYG editors, which are good for content editing but inappropriate for creating HTML structures. You can see it in action with the official demos, but using its API you\u0027re able to build your own editors. https:\/\/grapesjs.com\/&quot;},{&quot;property&quot;:&quot;eira:iopSaliency&quot;,&quot;value&quot;:&quot;The Human Interface ABB is a key interoperability enabler because it supports to achieve technical behavioral interoperability by enabling the exchange of data, information, and knowledge between digital public services and individuals.&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Behavioral IoP&quot;},{&quot;property&quot;:&quot;eira:view&quot;,&quot;value&quot;:&quot;Technical view - application&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;Interoperability Security viewpoint&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;Highlevel viewpoint&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;EIRA Ontology viewpoint&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;Interoperable European Solution viewpoint&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;REST API viewpoint&quot;}]}</ns0:properties>
