ot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/SolutionSpecificationDataObject&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;EIRA Ontology viewpoint&quot;}]}</ns0:properties>
