  <skos:Concept rdf:about="http://data.europa.eu/dr8/SolutionSpecificationDataObject">
    <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Solution Specification</skos:prefLabel>
    <skos:definition xml:lang="en">Definition: Solution Specification ABB is a Data Object that refers to detailed description of the requirements and functionality of a proposed solution to a specific problem or challenge

Source: ISA2-EIF

Source reference: &lt;a href=&quot;https://ec.europa.eu/isa2/eif_en/&quot; rel=&quot;nofollow&quot;&gt;https://ec.europa.eu/isa2/eif_en/&lt;/a&gt;

Identifier: &lt;a href=&quot;http://data.europa.eu/dr8/SolutionSpecificationDataObject&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/SolutionSpecificationDataObject&lt;/a&gt;

eira:ID: ABB486

ABB name: eira:SolutionSpecificationDataObject</skos:definition>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/viewpoint/EIRAOntologyViewpoint"/>
