  <skos:Concept rdf:about="http://data.europa.eu/dr8/InformationBusinessObject">
    <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Information</skos:prefLabel>
    <skos:definition xml:lang="en">Definition: Information ABB is a Business Object describing business facts, assets, or opinions that are exchanged in the context of a digital public service to support its delivery. Information is enacted via interpretation rules (expressed in an ontology) of data and considering knowledge of a given context. Examples include an invoice, a medical prescription, a driving license.

Source: TOGAF guide about business capabilities, TOGAF definition of information

Source reference: (&lt;a href=&quot;https://www2.opengroup.org/ogsys/catalog/g161&quot; rel=&quot;nofollow&quot;&gt;https://www2.opengroup.org/ogsys/catalog/g161&lt;/a&gt;)), (&lt;a href=&quot;http://pubs.opengroup.org/architecture/togaf9-doc/arch/&quot; rel=&quot;nofollow&quot;&gt;http://pubs.opengroup.org/architecture/togaf9-doc/arch/&lt;/a&gt;)

Synonym: Business Facts, Business Data, Business Opinions

Example: The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): Surveillance3 - Surveillance information: Published Surveillance information (Business Information) on Europa: Textile category 1 - Cotton yarn, not put up for retail sale [Council Regulation (EEC) No 3030/93] from Belarus in 2015: see URL for details(&lt;a href=&quot;http://ec.europa.eu/taxation_customs/dds2/surv/surv_data_list.jsp?Lang=en&amp;amp;survNumber=670010&amp;amp;survType=1&amp;amp;startDate=20150101&amp;amp;originCode=BY&quot; rel=&quot;nofollow&quot;&gt;http://ec.europa.eu/taxation_customs/dds2/surv/surv_data_list.jsp?Lang=…&lt;/a&gt;)

LOST view: Organisational view

Interoperability saliency: The Information ABB  is salient for organisational interoperability because it represents the data being exchanged between organisations. Its interoperability needs to be guaranteed using organisational and semantic interoperability specifications.

Identifier: &lt;a href=&quot;http://data.europa.eu/dr8/InformationBusinessObject&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/InformationBusinessObject&lt;/a&gt;

eira:ID: ABB13

ABB name: eira:InformationBusinessObject

EIRA concept: eira:ArchitectureBuildingBlock

Last modification: 2023-11-01

eira:dimension: Behavioral IoP</skos:definition>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/viewpoint/HighlevelViewpoint"/>
    <ns1:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of Information&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/InformationBusinessObject_Properties&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/InformationBusinessObject&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of Information&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/InformationBusinessObject&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:InformationBusinessObject&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2023-11-1&quot;},{&quot;property&quot;:&quot;eira:synonym&quot;,&quot;value&quot;:&quot;Business Facts, Business Data, Business Opinions&quot;},{&quot;property&quot;:&quot;skos:definition&quot;,&quot;value&quot;:&quot;Information ABB is a Business Object describing business facts, assets, or opinions that are exchanged in the context of a digital public service to support its delivery. Information is enacted via interpretation rules (expressed in an ontology) of data and considering knowledge of a given context. Examples include an invoice, a medical prescription, a driving license.&quot;},{&quot;property&quot;:&quot;eira:definitionSource&quot;,&quot;value&quot;:&quot;TOGAF guide about business capabilities, TOGAF definition of information&quot;},{&quot;property&quot;:&quot;eira:definitionSourceReference&quot;,&quot;value&quot;:&quot;(https:\/\/www2.opengroup.org\/ogsys\/catalog\/g161)), (http:\/\/pubs.opengroup.org\/architecture\/togaf9-doc\/arch\/)&quot;},{&quot;property&quot;:&quot;skos:example&quot;,&quot;value&quot;:&quot;The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): Surveillance3 - Surveillance information: Published Surveillance information (Business Information) on Europa: Textile category 1 - Cotton yarn, not put up for retail sale [Council Regulation (EEC) No 3030\/93] from Belarus in 2015: see URL for details(http:\/\/ec.europa.eu\/taxation_customs\/dds2\/surv\/surv_data_list.jsp?Lang=en\u0026survNumber=670010\u0026survType=1\u0026startDate=20150101\u0026originCode=BY)&quot;},{&quot;property&quot;:&quot;eira:iopSaliency&quot;,&quot;value&quot;:&quot;The Information ABB  is salient for organisational interoperability because it represents the data being exchanged between organisations. Its interoperability needs to be guaranteed using organisational and semantic interoperability specifications.&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Behavioral IoP&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Structural IoP&quot;},{&quot;property&quot;:&quot;eira:view&quot;,&quot;value&quot;:&quot;Organisational view&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;Interoperability Privacy viewpoint&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;Highlevel viewpoint&quot;}]}</ns1:properties>
