  <skos:Concept rdf:about="http://data.europa.eu/dr8/PublicPolicyImplementation">
    <skos:definition xml:lang="en">A Public Policy Implementation is the process of putting a public policy into effect. [Oxford Dictionary]</skos:definition>
    <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Public Policy Implementation</skos:prefLabel>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/Deprecated"/>
