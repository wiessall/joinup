t;http:\/\/eur-lex.europa.eu\/legal-content\/EN\/TXT\/?uri=uriserv%3AOJ.L_.2014.257.01.0073.01.ENG&quot;},{&quot;property&quot;:&quot;eira:iopSaliency&quot;,&quot;value&quot;:&quot;The Trust Enablers Grouping is salient for interoperability because it comprises the set of tools, services and applications that allow to secure the digital public services across borders. Trust enablers are focused on transactions and interactions between parties (services, platforms, individuals) related to services. By applying those mechanisms identities, and timestamps (amongst other aspects) can be guaranteed and ensure the trustworthy data exchange&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Behavioral IoP&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Structural IoP&quot;},{&quot;property&quot;:&quot;eira:view&quot;,&quot;value&quot;:&quot;Technical view - application&quot;}]}</ns0:properties>
