    <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Data Exchange Enablers</skos:prefLabel>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/view/TechnicalView-Application"/>
    <ns0:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of Data Exchange Enablers&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/DataExchangeEnablersGrouping_Properties&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/DataExchangeEnablersGrouping&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of Data Exchange Enablers&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/DataExchangeEnablersGrouping&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:DataExchangeEnablersGrouping&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2023-05-25&quot;},{&quot;property&quot;:&quot;skos:definition&quot;,&quot;value&quot;:&quot;Digital Exchange Enablers ABB is a Grouping that refers to tools or components that facilitate the exchange of data between systems or applications&quot;},{&quot;property&quot;:&quot;eira:definitionSource&quot;,&quot;value&quot;:&quot;EIFv2&quot;},{&quot;property&quot;:&quot;eira:definitionSourceReference&quot;,&quot;value&quot;:&quot;http:\/\/ec.europa.eu\/isa\/documents\/isa_annex_ii_eif_en.pdf&quot;},{&quot;property&quot;:&quot;skos:example&quot;,&quot;value&quot;:&quot;The Data Exchange Service ABB \u00a0is salient for technical interoperability because it provides secure and trustworthy data exchange between different ICT systems as stated in the EIF: \u0022Define a common security and privacy framework and establish processes for public services to ensure secure and trustworthy data exchange between public administrations and in interactions with citizens and businesses.\u0022&quot;},{&quot;property&quot;:&quot;eira:iopSaliency&quot;,&quot;value&quot;:&quot;The Data Exchange Enablers Grouping ABB is salient for technical interoperability because it provides secure and trustworthy data exchange between different ICT systems as stated in the EIF: \u0022Define a common security and privacy framework and establish processes for public services to ensure secure and trustworthy data exchange between public administrations and in interactions with citizens and businesses.\u0022&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Structural IoP&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Behavioral IoP&quot;},{&quot;property&quot;:&quot;eira:view&quot;,&quot;value&quot;:&quot;Technical view - application&quot;}]}</ns0:properties>
    <skos:related rdf:resource="http://data.europa.eu/dr8/DataExchangeApplicationService"/>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/DataExtractionTransformationandLoadingApplicationComponent">
    <skos:definition xml:lang="en">Definition: Data Extraction, Transformation and Loading ABB is an Application Component that enables the implementation of the process of extracting data from various sources, transforming the data to specific data models and loading the data into a target data store.

Source: Inspired in definitions from referent companies of IT sector

Example: The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): Eurostat SDMX converter - The SDMX Converter is a tool that converts statistical datasets between different formats. It is a Java application which is actively developed by Eurostat and is published as open source software. &lt;a href=&quot;http://ec.europa.eu/eurostat/web/sdmx-infospace/sdmx-it-tools/sdmx-converter&quot; rel=&quot;nofollow&quot;&gt;http://ec.europa.eu/eurostat/web/sdmx-infospace/sdmx-it-tools/sdmx-conv…&lt;/a&gt;

IoP Dimension: Structural IoP

LOST view: Technical view - application

Interoperability saliency: The Data Extraction, Transformation, and Loading Component ABB  is salient for technical interoperability  because it enables the implementation of the functionalities to transform internal data structures to common and agreed interoperable formats as stated in the EIF recommendation n° 41: &quot;Establish procedures and processes to integrate the opening of data in your common business processes, working routines, and in the development of new information systems.&quot;

Identifier: &lt;a href=&quot;http://data.europa.eu/dr8/DataExtraction,Transformation,andLoadingApplicationComponent&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/DataExtraction,Transformation,andLoadingAppli…&lt;/a&gt;

eira:ID: ABB61

ABB name: eira:DataExtraction,Transformation,andLoadingApplicationComponent

EIRA concept: eira:ArchitectureBuildingBlock

Last modification: 2022-23-01</skos:definition>
    <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Data Extraction, Transformation, and Loading</skos:prefLabel>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/viewpoint/InteroperabilityPrivacyViewpoint"/>
    <ns0:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of Data Extraction, Transformation, and Loading&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/DataExtractionTransformationandLoadingApplicationComponent_Properties&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/DataExtractionTransformationandLoadingApplicationComponent&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of Data Extraction, Transformation, and Loading&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/DataExtractionTransformationandLoadingApplicationComponent&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:DataExtractionTransformationandLoadingApplicationComponent&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2022-01-23&quot;},{&quot;property&quot;:&quot;skos:definition&quot;,&quot;value&quot;:&quot;Data Extraction, Transformation and Loading ABB is an Application Component that enables the implementation of the process of extracting data from various sources, transforming the data to specific data models and loading the data into a target data store.&quot;},{&quot;property&quot;:&quot;eira:definitionSource&quot;,&quot;value&quot;:&quot;Inspired in definitions from referent companies of IT sector&quot;},{&quot;property&quot;:&quot;skos:example&quot;,&quot;value&quot;:&quot;The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): Eurostat SDMX converter - The SDMX Converter is a tool that converts statistical datasets between different formats. It is a Java application which is actively developed by Eurostat and is published as open source software. http:\/\/ec.europa.eu\/eurostat\/web\/sdmx-infospace\/sdmx-it-tools\/sdmx-converter&quot;},{&quot;property&quot;:&quot;eira:iopSaliency&quot;,&quot;value&quot;:&quot;The Data Extraction, Transformation, and Loading Component ABB \u00a0is salient for technical interoperability  because it enables the implementation of the functionalities to transform internal data structures to common and agreed interoperable formats as stated in the EIF recommendation n\u00b0 41: \u0022Establish procedures and processes to integrate the opening of data in your common business processes, working routines, and in the development of new information systems.\u0022&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Structural IoP&quot;},{&quot;property&quot;:&quot;eira:view&quot;,&quot;value&quot;:&quot;Technical view - application&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;Interoperability Privacy viewpoint&quot;}]}</ns0:properties>
