  <skos:Concept rdf:about="http://data.europa.eu/dr8/AgentBusinessRole">
    <skos:definition xml:lang="en">Definition: Agent ABB is a Business Role defined as an Entity that is able to carry out action.

Source: SEMIC-CPV or SEMIC-CCCEV

Source reference: &lt;a href=&quot;https://semiceu.github.io/Core-Person-Vocabulary/releases/2.00/#Agent&quot; rel=&quot;nofollow&quot;&gt;https://semiceu.github.io/Core-Person-Vocabulary/releases/2.00/#Agent&lt;/a&gt;

Example: The following implementation is an example of how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): foaf:Agent An agent (eg. person, group, software or physical artifact). (&lt;a href=&quot;http://xmlns.com/foaf/0.1/#term_Agent&quot; rel=&quot;nofollow&quot;&gt;http://xmlns.com/foaf/0.1/#term_Agent&lt;/a&gt;)

LOST view: Organisational view

Interoperability saliency: The Agent ABB is salient for organizational and behavioural interoperability because it permits the identification of procedures and business rules related to specific organizations, individuals or public services that facilitates the exchange of data, information and knowledge between digital public services.

Identifier: &lt;a href=&quot;http://data.europa.eu/dr8/AgentBusinessRole&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/AgentBusinessRole&lt;/a&gt;

eira:ID: ABB498

ABB name: eira:AgentBusinessRole

EIRA concept: eira:ArchitectureBuildingBlock

Last modification: 2023-12-01</skos:definition>
    <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Agent</skos:prefLabel>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/view/OrganisationalView"/>
    <ns0:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of Agent&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/AgentBusinessRole_Properties&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/AgentBusinessRole&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of Agent&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/AgentBusinessRole&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:AgentBusinessRole&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2023-12-1&quot;},{&quot;property&quot;:&quot;skos:definition&quot;,&quot;value&quot;:&quot;Agent ABB is a Business Role defined as an Entity that is able to carry out action.&quot;},{&quot;property&quot;:&quot;eira:definitionSource&quot;,&quot;value&quot;:&quot;SEMIC-CPV or SEMIC-CCCEV&quot;},{&quot;property&quot;:&quot;eira:definitionSourceReference&quot;,&quot;value&quot;:&quot;https:\/\/semiceu.github.io\/Core-Person-Vocabulary\/releases\/2.00\/#Agent&quot;},{&quot;property&quot;:&quot;skos:example&quot;,&quot;value&quot;:&quot;The following implementation is an example of how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): foaf:Agent An agent (eg. person, group, software or physical artifact). (http:\/\/xmlns.com\/foaf\/0.1\/#term_Agent)&quot;},{&quot;property&quot;:&quot;eira:iopSaliency&quot;,&quot;value&quot;:&quot;The Agent ABB is salient for organizational and behavioural interoperability because it permits the identification of procedures and business rules related to specific organizations, individuals or public services that facilitates the exchange of data, information and knowledge between digital public services.&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Structural IoP&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Behavioral IoP&quot;},{&quot;property&quot;:&quot;eira:view&quot;,&quot;value&quot;:&quot;Organisational view&quot;}]}</ns0:properties>
