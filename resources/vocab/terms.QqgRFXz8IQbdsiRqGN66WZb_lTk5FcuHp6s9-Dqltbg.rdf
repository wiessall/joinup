  <skos:Concept rdf:about="http://data.europa.eu/dr8/BusinessIntelligenceComponent">
    <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Business Intelligence Component</skos:prefLabel>
    <skos:definition xml:lang="en">Implements the functionalities that include i) the applications, ii) infrastructure and tools, and/or iii) best practices that enable access to and analysis of information to improve and optimize decisions and performance.

Based on Gartner
&lt;a href=&quot;http://www.gartner.com/it-glossary/business-intelligence-bi/&quot; rel=&quot;nofollow&quot;&gt;http://www.gartner.com/it-glossary/business-intelligence-bi/&lt;/a&gt;

The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB):

JasperReports
The JasperReports Library is an open source reporting engine. It is entirely written in Java and it is able to use data coming from any kind of data source and produce pixel-perfect documents that can be viewed, printed or exported in a variety of document formats including HTML, PDF, Excel, OpenOffice and Word.
&lt;a href=&quot;https://community.jaspersoft.com/project/jasperreports-library&quot; rel=&quot;nofollow&quot;&gt;https://community.jaspersoft.com/project/jasperreports-library&lt;/a&gt;</skos:definition>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/Deprecated"/>
    <ns1:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;owl&quot;:{&quot;namespace&quot;:&quot;owl:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2002\/07\/owl#&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of Business Intelligence Component&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/BusinessIntelligenceComponent_Properties&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of Business Intelligence Component&quot;},{&quot;property&quot;:&quot;owl:deprecated&quot;,&quot;value&quot;:&quot;true&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:BusinessIntelligenceComponent&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2023-05-25&quot;},{&quot;property&quot;:&quot;eira:ABB_Status&quot;,&quot;value&quot;:&quot;Obsolete&quot;},{&quot;property&quot;:&quot;eira:ID&quot;,&quot;value&quot;:&quot;ABB66&quot;}]}</ns1:properties>
