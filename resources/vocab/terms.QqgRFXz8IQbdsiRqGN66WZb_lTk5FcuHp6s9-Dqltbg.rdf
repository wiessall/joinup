erty&quot;:&quot;eira:definitionSourceReference&quot;,&quot;value&quot;:&quot;https:\/\/ec.europa.eu\/isa2\/actions\/towards-european-interoperability-architecture_en\/&quot;},{&quot;property&quot;:&quot;eira:iopSaliency&quot;,&quot;value&quot;:&quot;The External Facility ABB is saliency for organizational and technical interoperability because it establishes the business rules and responsibilities to share infrastructures for the use of public administrations. The ABB also provides the application of open specifications and solutions to make interoperable public administration solutions.&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Structural IoP&quot;},{&quot;property&quot;:&quot;eira:view&quot;,&quot;value&quot;:&quot;Technical view - infrastructure&quot;}]}</ns0:properties>
