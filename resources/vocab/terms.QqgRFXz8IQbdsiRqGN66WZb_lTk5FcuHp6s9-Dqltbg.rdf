  <skos:Concept rdf:about="http://data.europa.eu/dr8/GraphDatabaseManagerTechnologyService">
    <skos:definition xml:lang="en">Definition: Graph Database manager ABB is a Technology Service that implements the behaviour of a software system that manages and manipulates data stores in the form of nodes, edges, and properties, which are represented as a graph

Source: Inspired in the definition provided by relebant Graph database vendors

Example: The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): neo4j Graph Database management. &lt;a href=&quot;https://neo4j.com/docs/graph-data-science/current/management-ops/&quot; rel=&quot;nofollow&quot;&gt;https://neo4j.com/docs/graph-data-science/current/management-ops/&lt;/a&gt;

LOST view: Technical view - Infrastructure

Identifier: &lt;a href=&quot;http://data.europa.eu/dr8/GraphDatabaseManagerTechnologyService&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/GraphDatabaseManagerTechnologyService&lt;/a&gt;

eira:ID: &lt;a href=&quot;http://data.europa.eu/dr8/GraphDatabaseManagerTechnologyService&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/GraphDatabaseManagerTechnologyService&lt;/a&gt;

ABB name: eira:GraphDatabaseManagerTechnologyService

EIRA concept: eira:ArchitectureBuildingBlock</skos:definition>
    <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Graph Database Manager</skos:prefLabel>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/view/TechnicalView-Infrastructure"/>
    <ns0:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of Graph Database Manager&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/GraphDatabaseManagerTechnologyService_Properties&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/GraphDatabaseManagerTechnologyService&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of Graph Database Manager&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/GraphDatabaseManagerTechnologyService&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:GraphDatabaseManagerTechnologyService&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2023-05-25&quot;},{&quot;property&quot;:&quot;skos:definition&quot;,&quot;value&quot;:&quot;Graph Database manager ABB is a Technology Service that implements the behaviour of a software system that manages and manipulates data stores in the form of nodes, edges, and properties, which are represented as a graph&quot;},{&quot;property&quot;:&quot;eira:definitionSource&quot;,&quot;value&quot;:&quot;Inspired in the definition provided by relebant Graph database vendors&quot;},{&quot;property&quot;:&quot;skos:example&quot;,&quot;value&quot;:&quot;The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): neo4j Graph Database management. https:\/\/neo4j.com\/docs\/graph-data-science\/current\/management-ops\/&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Structural IoP&quot;},{&quot;property&quot;:&quot;eira:view&quot;,&quot;value&quot;:&quot;Technical view - infrastructure&quot;}]}</ns0:properties>
