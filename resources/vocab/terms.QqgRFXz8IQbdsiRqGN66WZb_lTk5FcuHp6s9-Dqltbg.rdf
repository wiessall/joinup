    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/view/OrganisationalView"/>
    <ns1:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of Digital Public Service Human Agent&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/DigitalPublicServiceDeliveryHumanAgentBusinessActor_Properties&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/DigitalPublicServiceDeliveryHumanAgentBusinessActor&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of Digital Public Service Human Agent&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/DigitalPublicServiceDeliveryHumanAgentBusinessActor&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:DigitalPublicServiceDeliveryHumanAgentBusinessActor&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2023-12-1&quot;},{&quot;property&quot;:&quot;skos:definition&quot;,&quot;value&quot;:&quot;Digital Public Service Human Agent ABB is a Business Actor representing a stakeholder who works in the public service sector and uses digital technologies to improve the delivery of public services to citizens. This agent has the potential to improve the accessibility, efficiency, and quality of public services, ultimately leading to better outcomes for citizens and society as a whole.&quot;},{&quot;property&quot;:&quot;eira:definitionSource&quot;,&quot;value&quot;:&quot;Inspired on the information available in Digital Public Services  in the Digital Economy and Society Index&quot;},{&quot;property&quot;:&quot;eira:definitionSourceReference&quot;,&quot;value&quot;:&quot;https:\/\/digital-strategy.ec.europa.eu\/en\/policies\/desi-digital-public-services&quot;},{&quot;property&quot;:&quot;skos:example&quot;,&quot;value&quot;:&quot;The following implemenation is an example of how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): OECD Goverment as a Glance (https:\/\/www.oecd.org\/gov\/government-at-a-glance-22214399.htm)&quot;},{&quot;property&quot;:&quot;eira:iopSaliency&quot;,&quot;value&quot;:&quot;The Digital Public Service Human Agent ABB is salient for organizational and behavioural interoperability because it permits the identification of procedures and business rules related to human interactions in public administration. This identification and consensus will facilitate the exchange of data, information and knowledge between public services and human stakeholders.&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Behavioral IoP&quot;},{&quot;property&quot;:&quot;eira:view&quot;,&quot;value&quot;:&quot;Organisational view&quot;}]}</ns1:properties>
    <skos:related rdf:resource="http://data.europa.eu/dr8/AgentBusinessRole"/>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/DigitalPublicServiceDeliveryModelBusinessCollaboration">
    <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Digital Public Service Delivery Model</skos:prefLabel>
    <skos:definition xml:lang="en">Definition: Digital Public Service Delivery Model ABB is a Business Collaboration representing a collection of concepts related to the way in which the public sector delivers digital technologies to citizens and businesses.

Source: OECD

Source reference: &lt;a href=&quot;https://www.oecd-ilibrary.org/docserver/gov_glance-2017-72-en.pdf?expires=1649771036&amp;amp;id=id&amp;amp;accname=guest&amp;amp;checksum=15BFD2F7E916921236CCF160605A6430&quot; rel=&quot;nofollow&quot;&gt;https://www.oecd-ilibrary.org/docserver/gov_glance-2017-72-en.pdf?expir…&lt;/a&gt;

Example: The following implementation is an example of how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): OECD Public service design and delivery in the digital age (&lt;a href=&quot;https://www.oecd-ilibrary.org/sites/3252a73a-en/index.html?itemId=/content/component/3252a73a-en&quot; rel=&quot;nofollow&quot;&gt;https://www.oecd-ilibrary.org/sites/3252a73a-en/index.html?itemId=/cont…&lt;/a&gt;)

LOST view: Organisational view

Interoperability saliency: Digital Public Service Delivery Model ABB is salient for organizational and behavioural interoperability due to it permits to (i) reuse and share common digital services across different public administrations to deploy and publish digital services, (ii) establish common business procedures to elaborate and form the digital services for public administration, (iii) the maintenance procedures to make available such digital services.

Identifier: &lt;a href=&quot;http://data.europa.eu/dr8/DigitalPublicServiceDeliveryModelBusinessCollaboration&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/DigitalPublicServiceDeliveryModelBusinessColl…&lt;/a&gt;

eira:ID: ABB493

ABB name: eira:DigitalPublicServiceDeliveryModelBusinessCollaboration

EIRA concept: eira:ArchitectureBuildingBlock</skos:definition>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/viewpoint/EnterpriseArchitectureFrameworkAlignmentGuidelinesViewpoint"/>
    <ns1:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of Digital Public Service Delivery Model&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/DigitalPublicServiceDeliveryModelBusinessCollaboration_Properties&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/DigitalPublicServiceDeliveryModelBusinessCollaboration&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of Digital Public Service Delivery Model&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/DigitalPublicServiceDeliveryModelBusinessCollaboration&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:DigitalPublicServiceDeliveryModelBusinessCollaboration&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2023-05-25&quot;},{&quot;property&quot;:&quot;skos:definition&quot;,&quot;value&quot;:&quot;Digital Public Service Delivery Model ABB is a Business Collaboration representing a collection of concepts related to the way in which the public sector delivers digital technologies to citizens and businesses.&quot;},{&quot;property&quot;:&quot;eira:definitionSource&quot;,&quot;value&quot;:&quot;OECD&quot;},{&quot;property&quot;:&quot;eira:definitionSourceReference&quot;,&quot;value&quot;:&quot;https:\/\/www.oecd-ilibrary.org\/docserver\/gov_glance-2017-72-en.pdf?expires=1649771036\u0026id=id\u0026accname=guest\u0026checksum=15BFD2F7E916921236CCF160605A6430&quot;},{&quot;property&quot;:&quot;skos:example&quot;,&quot;value&quot;:&quot;The following implementation is an example of how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): OECD Public service design and delivery in the digital age (https:\/\/www.oecd-ilibrary.org\/sites\/3252a73a-en\/index.html?itemId=\/content\/component\/3252a73a-en)&quot;},{&quot;property&quot;:&quot;eira:iopSaliency&quot;,&quot;value&quot;:&quot;Digital Public Service Delivery Model ABB is salient for organizational and behavioural interoperability due to it permits to (i) reuse and share common digital services across different public administrations to deploy and publish digital services, (ii) establish common business procedures to elaborate and form the digital services for public administration, (iii) the maintenance procedures to make available such digital services.&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Behavioral IoP&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Structural IoP&quot;},{&quot;property&quot;:&quot;eira:view&quot;,&quot;value&quot;:&quot;Organisational view&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;Highlevel viewpoint&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;Enterprise Architecture Framework alignment guidelines viewpoint&quot;}]}</ns1:properties>
