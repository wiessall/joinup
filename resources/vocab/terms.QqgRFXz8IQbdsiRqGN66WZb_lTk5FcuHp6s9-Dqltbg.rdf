  <skos:Concept rdf:about="http://data.europa.eu/dr8/DigitalSolutionArtifact">
    <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Interoperable Digital Solution</skos:prefLabel>
    <skos:definition xml:lang="en">Definition: Interoperable Digital Solution ABB is an Artifact that refers to the software or hardware system that is designed to work seamlessly with other systems or technologies

Source: ISA2-EIF

Source reference: &lt;a href=&quot;https://ec.europa.eu/isa2/eif_en/&quot; rel=&quot;nofollow&quot;&gt;https://ec.europa.eu/isa2/eif_en/&lt;/a&gt;

Identifier: &lt;a href=&quot;http://data.europa.eu/dr8/DigitalSolutionArtifact&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/DigitalSolutionArtifact&lt;/a&gt;

eira:ID: ABB611

ABB name: eira:DigitalSolutionArtifact</skos:definition>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/viewpoint/EIRAOntologyViewpoint"/>
