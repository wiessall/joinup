    <ns1:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of Digital Workplace Infrastructure Enablers&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/DigitalWorkplaceInfrastructureEnablers_Properties&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/DigitalWorkplaceInfrastructureEnablers&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of Digital Workplace Infrastructure Enablers&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/DigitalWorkplaceInfrastructureEnablers&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:DigitalWorkplaceInfrastructureEnablers&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2023-05-25&quot;},{&quot;property&quot;:&quot;skos:definition&quot;,&quot;value&quot;:&quot;Digital Workplace Infrastructure Enablers ABB is a Grouping that enables the set of components and services that enable organizations to create and manage virtual workplaces environments and facilitate their access remotely.&quot;},{&quot;property&quot;:&quot;eira:definitionSource&quot;,&quot;value&quot;:&quot;Inspired in Gartner&quot;},{&quot;property&quot;:&quot;eira:definitionSourceReference&quot;,&quot;value&quot;:&quot;https:\/\/www.gartner.com\/en\/information-technology\/glossary\/remote-access&quot;},{&quot;property&quot;:&quot;skos:example&quot;,&quot;value&quot;:&quot;The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): PSI Remote Desktop Service from the European Open Science Cloud https:\/\/marketplace.eosc-portal.eu\/services\/remote-desktop-service?from_recommendation_panel=true\u0026fromc=access-physical-einfrastructures&quot;},{&quot;property&quot;:&quot;eira:iopSaliency&quot;,&quot;value&quot;:&quot;Digital Workplace Infrastructure Enablers ABB is salient for technical interoperability due to it refers to setting up the workplace ecosystem to establish access to European public services remotely to access applications using open specifications and interfaces.&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Structural IoP&quot;},{&quot;property&quot;:&quot;eira:view&quot;,&quot;value&quot;:&quot;Technical view - infrastructure&quot;}]}</ns1:properties>
    <skos:related rdf:resource="http://data.europa.eu/dr8/RemoteDesktopTechnologyService"/>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/StorageInfrastructureEnablers">
    <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Storage Infrastructure Enablers</skos:prefLabel>
    <skos:definition xml:lang="en">Definition: Storage Infrastructure Enablers ABB is a Grouping of a set of tools and digital services that facilitate the efficient and effective storage of data

Source: TECHNOPEDIA

Source reference: &lt;a href=&quot;https://www.techopedia.com/definition/30476/storage-infrastructure&quot; rel=&quot;nofollow&quot;&gt;https://www.techopedia.com/definition/30476/storage-infrastructure&lt;/a&gt;

Example: The following implementation is an example of how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): GARTNER- Distributed File Systems and Objects Storage Reviews and Ratings. &lt;a href=&quot;https://www.gartner.com/reviews/market/distributed-file-systems-and-object-storage&quot; rel=&quot;nofollow&quot;&gt;https://www.gartner.com/reviews/market/distributed-file-systems-and-obj…&lt;/a&gt;

LOST view: Technical view - Infrastructure

Interoperability saliency: Storage Infrastructure Enablers ABB is salient for technical interoperability because it establishes the mechanism to (i) ensure the correct management of the information across single or multiple infrastructures, and (ii) minimize the effects of data loss in case of unexpected behaviour of public services through data recovery strategies.

Identifier: &lt;a href=&quot;http://data.europa.eu/dr8/StorageInfrastructureEnablers&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/StorageInfrastructureEnablers&lt;/a&gt;

eira:ID: &lt;a href=&quot;http://data.europa.eu/dr8/StorageInfrastructureEnablers&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/StorageInfrastructureEnablers&lt;/a&gt;

ABB name: eira:StorageInfrastructureEnablers

EIRA concept: eira:ArchitectureBuildingBlock</skos:definition>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/view/TechnicalView-Infrastructure"/>
    <ns1:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of Storage Infrastructure Enablers&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/StorageInfrastructureEnablers_Properties&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/StorageInfrastructureEnablers&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of Storage Infrastructure Enablers&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/StorageInfrastructureEnablers&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:StorageInfrastructureEnablers&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2023-05-25&quot;},{&quot;property&quot;:&quot;skos:definition&quot;,&quot;value&quot;:&quot;Storage Infrastructure Enablers ABB is a Grouping of a set of tools and digital services that facilitate the efficient and effective storage of data&quot;},{&quot;property&quot;:&quot;eira:definitionSource&quot;,&quot;value&quot;:&quot;TECHNOPEDIA&quot;},{&quot;property&quot;:&quot;eira:definitionSourceReference&quot;,&quot;value&quot;:&quot;https:\/\/www.techopedia.com\/definition\/30476\/storage-infrastructure&quot;},{&quot;property&quot;:&quot;skos:example&quot;,&quot;value&quot;:&quot;The following implementation is an example of how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): GARTNER- Distributed File Systems and Objects Storage Reviews and Ratings. https:\/\/www.gartner.com\/reviews\/market\/distributed-file-systems-and-object-storage&quot;},{&quot;property&quot;:&quot;eira:iopSaliency&quot;,&quot;value&quot;:&quot;Storage Infrastructure Enablers ABB is salient for technical interoperability because it establishes the mechanism to (i) ensure the correct management of the information across single or multiple infrastructures, and (ii) minimize the effects of data loss in case of unexpected behaviour of public services through data recovery strategies.&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Structural IoP&quot;},{&quot;property&quot;:&quot;eira:view&quot;,&quot;value&quot;:&quot;Technical view - infrastructure&quot;}]}</ns1:properties>
    <skos:related rdf:resource="http://data.europa.eu/dr8/BackupTechnologyService"/>
  </skos:Concept>

