  <skos:Concept rdf:about="http://data.europa.eu/dr8/CreationOfInteroperableEuropeanSolutionsDriver">
    <skos:definition xml:lang="en">Definition: The Creation of Interoperable European Solutions Driver represents an external or internal condition that motivates the public organisation to define its goals and implement the changes necessary to create Digital Public Services.

Source: ArchiMate

Source reference: &lt;a href=&quot;https://pubs.opengroup.org/architecture/archimate3-doc/index.html&quot; rel=&quot;nofollow&quot;&gt;https://pubs.opengroup.org/architecture/archimate3-doc/index.html&lt;/a&gt;

IoP Dimension: Structural IoP

LOST view: Interoperability Motivation View

Identifier: &lt;a href=&quot;http://data.europa.eu/dr8/CreationOfInteroperableEuropeanSolutionsDriver&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/CreationOfInteroperableEuropeanSolutionsDriver&lt;/a&gt;

eira:ID: &lt;a href=&quot;http://data.europa.eu/dr8/CreationOfInteroperableEuropeanSolutionsDriver&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/CreationOfInteroperableEuropeanSolutionsDriver&lt;/a&gt;

ABB name: eira:CreationOfInteroperableEuropeanSolutionsDriver</skos:definition>
    <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Creation of Interoperable European Solutions</skos:prefLabel>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/viewpoint/EnterpriseArchitectureFrameworkAlignmentGuidelinesViewpoint"/>
    <ns0:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of Creation of Interoperable European Solutions&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/CreationOfInteroperableEuropeanSolutionsDriver_Properties&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/CreationOfInteroperableEuropeanSolutionsDriver&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of Creation of Interoperable European Solutions&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/CreationOfInteroperableEuropeanSolutionsDriver&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:CreationOfInteroperableEuropeanSolutionsDriver&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2023-05-25&quot;},{&quot;property&quot;:&quot;skos:definition&quot;,&quot;value&quot;:&quot;The Creation of Interoperable European Solutions Driver represents an external or internal condition that motivates the public organisation to define its goals and implement the changes necessary to create Digital Public Services.&quot;},{&quot;property&quot;:&quot;eira:definitionSource&quot;,&quot;value&quot;:&quot;ArchiMate&quot;},{&quot;property&quot;:&quot;eira:definitionSourceReference&quot;,&quot;value&quot;:&quot;https:\/\/pubs.opengroup.org\/architecture\/archimate3-doc\/index.html&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Structural IoP&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;Enterprise Architecture Framework alignment guidelines viewpoint&quot;}]}</ns0:properties>
