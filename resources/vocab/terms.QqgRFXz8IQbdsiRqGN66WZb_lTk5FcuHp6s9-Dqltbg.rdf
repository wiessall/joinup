  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/SharedApplicationContentGrouping">
    <skos:definition xml:lang="en">Definition: Shared Application Content ABB is a Grouping that refers to tools and services to perform the sharing of digital content or data between multiple users within an application or software program.

Source: Inspired in referent cloud service providers definitions

IoP Dimension: Governance IoP, Behavioural IoP, Structural IoP

LOST view: Technical view - application

Interoperability saliency: The Shared Application Content ABB is a key interoperability enabler (*) for governance, behavioural and structural interoperability because it aggregates components to enable knowledge sharing across public administration to achieve their public policy goals.

Identifier: &lt;a href=&quot;http://data.europa.eu/dr8/SharedApplicationContentGrouping&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/SharedApplicationContentGrouping&lt;/a&gt;

eira:ID: &lt;a href=&quot;http://data.europa.eu/dr8/SharedApplicationContentGrouping&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/SharedApplicationContentGrouping&lt;/a&gt;

ABB name: eira:SharedApplicationContentGrouping

EIRA concept: eira:ArchitectureBuildingBlock

Last modification: 2022-15-02</skos:definition>
    <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Shared Application Content</skos:prefLabel>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/viewpoint/InteroperableEuropeanSolutionViewpoint"/>
    <ns0:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of Shared Application Content&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/SharedApplicationContentGrouping_Properties&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/SharedApplicationContentGrouping&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of Shared Application Content&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/SharedApplicationContentGrouping&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:SharedApplicationContentGrouping&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2022-02-15&quot;},{&quot;property&quot;:&quot;eira:definitionSource&quot;,&quot;value&quot;:&quot;Inspired in referent cloud service providers definitions&quot;},{&quot;property&quot;:&quot;skos:definition&quot;,&quot;value&quot;:&quot;Shared Application Content ABB is a Grouping that refers to tools and services to perform the sharing of digital content or data between multiple users within an application or software program.&quot;},{&quot;property&quot;:&quot;eira:iopSaliency&quot;,&quot;value&quot;:&quot;The Shared Application Content ABB is a key interoperability enabler (*) for governance, behavioural and structural interoperability because it aggregates components to enable knowledge sharing across public administration to achieve their public policy goals.&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Governance IoP&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Behavioral IoP&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Structural IoP&quot;},{&quot;property&quot;:&quot;eira:view&quot;,&quot;value&quot;:&quot;Technical view - application&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;Highlevel viewpoint&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;Key Interoperability Enablers viewpoint&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;EIRA Ontology viewpoint&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;Interoperable European Solution viewpoint&quot;}]}</ns0:properties>
    <skos:related>
      <skos:Concept rdf:about="http://data.europa.eu/dr8/UXManagementApplicationService">
        <skos:definition xml:lang="en">Definition: UX Management Service ABB is Application Service managing user experience design-related activities inside an organization to create growth and good management practices. Typical UX management activities are to define an organization’s UX design language and strategy and manage the work processes around UX design.

Source: Interaction design

Source reference: (&lt;a href=&quot;https://www.interaction-design.org/literature/topics/ux-management&quot; rel=&quot;nofollow&quot;&gt;https://www.interaction-design.org/literature/topics/ux-management&lt;/a&gt;)

LOST view: Technical view - application

Identifier: &lt;a href=&quot;http://data.europa.eu/dr8/UXManagementService&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/UXManagementService&lt;/a&gt;

Identifier: &lt;a href=&quot;http://data.europa.eu/dr8/UXManagementApplicationService&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/UXManagementApplicationService&lt;/a&gt;

eira:ID: ABB484

ABB name: eira:UXManagementApplicationService

EIRA concept: eira:ArchitectureBuildingBlock

Last modification: 2022-23-01</skos:definition>
        <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
        <skos:prefLabel xml:lang="en">UX Management</skos:prefLabel>
        <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/viewpoint/KeyInteroperabilityEnablersViewpoint"/>
        <ns0:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of UX Management&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/UXManagementApplicationService_Properties&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/UXManagementApplicationService&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of UX Management&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:UXManagementApplicationService&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2022-01-23&quot;},{&quot;property&quot;:&quot;skos:definition&quot;,&quot;value&quot;:&quot;UX Management Service ABB is Application Service managing user experience design-related activities inside an organization to create growth and good management practices. Typical UX management activities are to define an organization\u2019s UX design language and strategy and manage the work processes around UX design.&quot;},{&quot;property&quot;:&quot;eira:definitionSource&quot;,&quot;value&quot;:&quot;Interaction design&quot;},{&quot;property&quot;:&quot;eira:definitionSourceReference&quot;,&quot;value&quot;:&quot;(https:\/\/www.interaction-design.org\/literature\/topics\/ux-management)&quot;},{&quot;property&quot;:&quot;eira:iopSaliency&quot;,&quot;value&quot;:&quot;UX Management ABB is a key interoperability enabler (*) for behavioural interoperability, governance and semantic interoperability by enabling (i) a set of rules and best practices for user experience with public service components; (ii) a set of indicators to monitor and understand usability in public services; and (ii) metadata information to understand the visual elements of the public service components&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/UXManagementApplicationService&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Behavioral IoP&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;Key Interoperability Enablers viewpoint&quot;}]}</ns0:properties>
