  <skos:Concept rdf:about="http://data.europa.eu/dr8/TransationEnablersGrouping">
    <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Translation Enablers</skos:prefLabel>
    <skos:definition xml:lang="en">Definition: Machine Translation Enablers ABB is a Groping that refers to tools or components that facilitate the translation of text from one language to another using machine learning techniques

Source: Inspired in eTranslation

Source reference: &lt;a href=&quot;https://commission.europa.eu/resources-partners/etranslation_en&quot; rel=&quot;nofollow&quot;&gt;https://commission.europa.eu/resources-partners/etranslation_en&lt;/a&gt;

IoP Dimension: Structural IoP, Behavioral IoP

LOST view: Technical view - application

Interoperability saliency: The Translation Enablers Grouping ABB is salient for technical interoperability because it comprises a set of tools and components that ensure the translation of digital public services to different languages in the European Union by using machine learning techniques.

Identifier: &lt;a href=&quot;http://data.europa.eu/dr8/TransationEnablersGrouping&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/TransationEnablersGrouping&lt;/a&gt;

eira:ID: &lt;a href=&quot;http://data.europa.eu/dr8/TransationEnablersGrouping&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/TransationEnablersGrouping&lt;/a&gt;

ABB name: eira:TransationEnablersGrouping

EIRA concept: eira:ArchitectureBuildingBlock</skos:definition>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/view/TechnicalView-Application"/>
    <ns1:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of Translation Enablers&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/TransationEnablersGrouping_Properties&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/TransationEnablersGrouping&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of Translation Enablers&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/TransationEnablersGrouping&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:TransationEnablersGrouping&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2023-05-25&quot;},{&quot;property&quot;:&quot;skos:definition&quot;,&quot;value&quot;:&quot;Machine Translation Enablers ABB is a Groping that refers to tools or components that facilitate the translation of text from one language to another using machine learning techniques&quot;},{&quot;property&quot;:&quot;eira:definitionSource&quot;,&quot;value&quot;:&quot;Inspired in eTranslation&quot;},{&quot;property&quot;:&quot;eira:definitionSourceReference&quot;,&quot;value&quot;:&quot;https:\/\/commission.europa.eu\/resources-partners\/etranslation_en&quot;},{&quot;property&quot;:&quot;eira:iopSaliency&quot;,&quot;value&quot;:&quot;The Translation Enablers Grouping ABB is salient for technical interoperability because it comprises a set of tools and components that ensure the translation of digital public services to different languages in the European Union by using machine learning techniques.&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Structural IoP&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Behavioral IoP&quot;},{&quot;property&quot;:&quot;eira:view&quot;,&quot;value&quot;:&quot;Technical view - application&quot;}]}</ns1:properties>
