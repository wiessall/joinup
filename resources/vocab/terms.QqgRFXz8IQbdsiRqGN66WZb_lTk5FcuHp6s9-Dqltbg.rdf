t;eira:definitionSourceReference&quot;,&quot;value&quot;:&quot;https:\/\/ec.europa.eu\/isa2\/eif_en\/&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Governance IoP&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Behavioral IoP&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;EIRA Ontology viewpoint&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;Enterprise Architecture Framework alignment guidelines viewpoint&quot;}]}</ns1:properties>
