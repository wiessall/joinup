  <skos:Concept rdf:about="http://data.europa.eu/dr8/HostingFacility">
    <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Hosting Facility</skos:prefLabel>
    <skos:definition xml:lang="en">DEFINITION:
Hosting Facility ABB is a Node supporting the hosting of Interoperable European Solutions and their components, usually embodied in a building.

Source: DIGIT C Infrastructure Services Provision
(&lt;a href=&quot;http://ec.europa.eu/ipg/build/infrastructure/index_en.htm&quot; rel=&quot;nofollow&quot;&gt;http://ec.europa.eu/ipg/build/infrastructure/index_en.htm&lt;/a&gt;)

INTEROPERABILITY SALIENCY:
IoP Dimension: Structural IoP
The Hosting Facility ABB is salient for technical interoperability because it provides all the equipment supporting the hosting of interaoperable solutions and their components.

EXAMPLES:
The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB):

DIGIT/C Hosting Facility
DIGIT/C offers a high availability and high performance hosting infrastructure that is being comprised, among other elements, of back-end web server instances and application servers for hosting and serving both static and dynamic sites.
The dynamic sites supported by the standard Apache web servers are mainly sites based on Coldfusion and in some cases also sites using CGI scripts.
Dynamic sites based on particular technologies (i.e. Weblogic) are being hosted on individual application servers and are being integrated with the other related sites using reverse proxy mappings.
Direct HTTP access to the back-end web servers hosting the static sites is denied by the standard web server configuration.

Source: (&lt;a href=&quot;http://ec.europa.eu/ipg/build/infrastructure/index_en.htm&quot; rel=&quot;nofollow&quot;&gt;http://ec.europa.eu/ipg/build/infrastructure/index_en.htm&lt;/a&gt;)</skos:definition>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/Deprecated"/>
    <ns1:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;owl&quot;:{&quot;namespace&quot;:&quot;owl:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2002\/07\/owl#&quot;},&quot;owlturtle&quot;:{&quot;namespace&quot;:&quot;owlturtle:&quot;,&quot;uri&quot;:&quot;http:\/\/www.semanticweb.org\/owl\/owlapi\/turtle#&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of Hosting Facility&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/HostingFacility_Properties&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/HostingFacility&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of Hosting Facility&quot;},{&quot;property&quot;:&quot;owl:deprecated&quot;,&quot;value&quot;:&quot;true&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:HostingFacility&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2023-05-25&quot;},{&quot;property&quot;:&quot;owlturtle:secure_access&quot;,&quot;value&quot;:&quot;[ Yes | No ]&quot;},{&quot;property&quot;:&quot;owlturtle:processing&quot;,&quot;value&quot;:&quot;[ Yes | No ]&quot;},{&quot;property&quot;:&quot;owlturtle:storage&quot;,&quot;value&quot;:&quot;[ Yes | No ]&quot;},{&quot;property&quot;:&quot;eira:ABB_Status&quot;,&quot;value&quot;:&quot;Obsolete&quot;},{&quot;property&quot;:&quot;eira:ID&quot;,&quot;value&quot;:&quot;ABB191&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/HostingFacility&quot;},{&quot;property&quot;:&quot;skos:definition&quot;,&quot;value&quot;:&quot;Hosting Facility ABB is a Facility that enables components and services to make public services available on the Internet for their use.&quot;},{&quot;property&quot;:&quot;eira:definitionSource&quot;,&quot;value&quot;:&quot;Law Insider&quot;},{&quot;property&quot;:&quot;eira:definitionSourceReference&quot;,&quot;value&quot;:&quot;https:\/\/www.lawinsider.com\/dictionary\/hosting-facility#:~:text=Hosting%20Facility%20means%20a%20third,for%20use%20by%20End%20Users.&quot;},{&quot;property&quot;:&quot;skos:example&quot;,&quot;value&quot;:&quot;The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): DIGIT\/C Hosting Facility - DIGIT\/C offers a high availability and high-performance hosting infrastructure that is comprised, among other elements, of back-end web server instances and application servers for hosting and serving both static and dynamic sites. The dynamic sites supported by the standard Apache web servers are mainly sites based on Coldfusion and in some cases also sites using CGI scripts. Dynamic sites based on particular technologies (i.e. Weblogic) are being hosted on individual application servers and are being integrated with the other related sites using reverse proxy mappings. Direct HTTP access to the back-end web servers hosting the static sites is denied by the standard web server configuration. http:\/\/ec.europa.eu\/ipg\/build\/infrastructure\/index_en.htm&quot;},{&quot;property&quot;:&quot;eira:iopSaliency&quot;,&quot;value&quot;:&quot;Hosting Facility ABB is salient for the technical interoperability because it establish the set up of IT systems to deliver the different public administration digital services and architectures that permit to integrate data from different infrastructure and remove existing IT silos in public administration.&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Structural IoP&quot;},{&quot;property&quot;:&quot;eira:view&quot;,&quot;value&quot;:&quot;Technical view - infrastructure&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;Interoperability Security viewpoint&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;Highlevel viewpoint&quot;}]}</ns1:properties>
