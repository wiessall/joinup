  <skos:Concept rdf:about="http://data.europa.eu/dr8/MachineLearningTechnologyService">
    <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Machine Learning</skos:prefLabel>
    <skos:definition xml:lang="en">Definition: Machine Learning ABB is a Technology service that enables the procedures for implementing algorithms and models that can learn from and make predictions on data

Source: European Comision-White paper on AI

Source reference: &lt;a href=&quot;https://commission.europa.eu/system/files/2020-02/commission-white-paper-artificial-intelligence-feb2020_en.pdf&quot; rel=&quot;nofollow&quot;&gt;https://commission.europa.eu/system/files/2020-02/commission-white-pape…&lt;/a&gt;

Example: The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): AI Whatch Artificial Intelligence in public administrations. &lt;a href=&quot;https://publications.jrc.ec.europa.eu/repository/bitstream/JRC120399/jrc120399_misuraca-ai-watch_public-services_30062020_def.pdf&quot; rel=&quot;nofollow&quot;&gt;https://publications.jrc.ec.europa.eu/repository/bitstream/JRC120399/jr…&lt;/a&gt;

LOST view: Technical view - Infrastructure

Interoperability saliency: Machine Learning ABB is salient for semantic interoperability because it refers to the generation of newer insights (knowledge) from public data to generate (i) new curated datasets and/or (ii) new public data assets based on the combination of other public data.

Identifier: &lt;a href=&quot;http://data.europa.eu/dr8/MachineLearningTechnologyService&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/MachineLearningTechnologyService&lt;/a&gt;

eira:ID: &lt;a href=&quot;http://data.europa.eu/dr8/MachineLearningTechnologyService&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/MachineLearningTechnologyService&lt;/a&gt;

ABB name: eira:MachineLearningTechnologyService

EIRA concept: eira:ArchitectureBuildingBlock</skos:definition>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/view/TechnicalView-Infrastructure"/>
    <ns1:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of Machine Learning&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/MachineLearningTechnologyService_Properties&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/MachineLearningTechnologyService&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of Machine Learning&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/MachineLearningTechnologyService&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:MachineLearningTechnologyService&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2023-05-25&quot;},{&quot;property&quot;:&quot;skos:definition&quot;,&quot;value&quot;:&quot;Machine Learning ABB is a Technology service that enables the procedures for implementing algorithms and models that can learn from and make predictions on data&quot;},{&quot;property&quot;:&quot;eira:definitionSource&quot;,&quot;value&quot;:&quot;European Comision-White paper on AI&quot;},{&quot;property&quot;:&quot;eira:definitionSourceReference&quot;,&quot;value&quot;:&quot;https:\/\/commission.europa.eu\/system\/files\/2020-02\/commission-white-paper-artificial-intelligence-feb2020_en.pdf&quot;},{&quot;property&quot;:&quot;skos:example&quot;,&quot;value&quot;:&quot;The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): AI Whatch Artificial Intelligence in public administrations. https:\/\/publications.jrc.ec.europa.eu\/repository\/bitstream\/JRC120399\/jrc120399_misuraca-ai-watch_public-services_30062020_def.pdf&quot;},{&quot;property&quot;:&quot;eira:iopSaliency&quot;,&quot;value&quot;:&quot;Machine Learning ABB is salient for semantic interoperability because it refers to the generation of newer insights (knowledge) from public data to generate (i) new curated datasets and\/or (ii) new public data assets based on the combination of other public data.&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Structural IoP&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Behavioral IoP&quot;},{&quot;property&quot;:&quot;eira:view&quot;,&quot;value&quot;:&quot;Technical view - infrastructure&quot;}]}</ns1:properties>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/LoggerTechnologyService">
    <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Logger</skos:prefLabel>
    <skos:definition xml:lang="en">Definition: Logger ABB is a Technology Service that enables the procedures recording events or messages that occur within a system or application

Source: Inspired in Gartner

Source reference: &lt;a href=&quot;https://www.gartner.com/en/information-technology/glossary/event-fault-and-log-management&quot; rel=&quot;nofollow&quot;&gt;https://www.gartner.com/en/information-technology/glossary/event-fault-…&lt;/a&gt;

Example: The following implementation is an example of how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): OECD-OPSI- Quality of Public Administrations - A toolbox for practicioners. &lt;a href=&quot;https://oecd-opsi.org/toolkits/quality-of-public-administration-a-toolbox-for-practitioners/&quot; rel=&quot;nofollow&quot;&gt;https://oecd-opsi.org/toolkits/quality-of-public-administration-a-toolb…&lt;/a&gt;

LOST view: Technical view - Infrastructure

Interoperability saliency: Logger ABB is salient for semantic and technical interoperability due to it defines the mechanisms to manage messages from the applications to enhance their behavioural understanding in the execution or when unexpected behaviours occur. These mechanisms are based on open specifications for messaging representation and exchange.

Identifier: &lt;a href=&quot;http://data.europa.eu/dr8/LoggerTechnologyService&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/LoggerTechnologyService&lt;/a&gt;

eira:ID: &lt;a href=&quot;http://data.europa.eu/dr8/LoggerTechnologyService&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/LoggerTechnologyService&lt;/a&gt;

ABB name: eira:LoggerTechnologyService

EIRA concept: eira:ArchitectureBuildingBlock</skos:definition>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/view/TechnicalView-Infrastructure"/>
    <ns1:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of Logger&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/LoggerTechnologyService_Properties&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/LoggerTechnologyService&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of Logger&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/LoggerTechnologyService&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:LoggerTechnologyService&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2023-05-25&quot;},{&quot;property&quot;:&quot;skos:definition&quot;,&quot;value&quot;:&quot;Logger ABB is a Technology Service that enables the procedures recording events or messages that occur within a system or application&quot;},{&quot;property&quot;:&quot;eira:definitionSource&quot;,&quot;value&quot;:&quot;Inspired in Gartner&quot;},{&quot;property&quot;:&quot;eira:definitionSourceReference&quot;,&quot;value&quot;:&quot;https:\/\/www.gartner.com\/en\/information-technology\/glossary\/event-fault-and-log-management&quot;},{&quot;property&quot;:&quot;skos:example&quot;,&quot;value&quot;:&quot;The following implementation is an example of how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): OECD-OPSI- Quality of Public Administrations - A toolbox for practicioners. https:\/\/oecd-opsi.org\/toolkits\/quality-of-public-administration-a-toolbox-for-practitioners\/&quot;},{&quot;property&quot;:&quot;eira:iopSaliency&quot;,&quot;value&quot;:&quot;Logger ABB is salient for semantic and technical interoperability due to it defines the mechanisms to manage messages from the applications to enhance their behavioural understanding in the execution or when unexpected behaviours occur. These mechanisms are based on open specifications for messaging representation and exchange.&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Structural IoP&quot;},{&quot;property&quot;:&quot;eira:view&quot;,&quot;value&quot;:&quot;Technical view - infrastructure&quot;}]}</ns1:properties>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/ContainersManagerTechnologyService">
    <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Containers Manager</skos:prefLabel>
    <skos:definition xml:lang="en">Definition: Containers Manager ABB is a Technology Service that implements the process of organizing, adding or replacing large numbers of software containers

Source: Inspired in referent cloud service providers

Source reference:

Synonym:

Example: The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): OpenSHIFT is a secure and an enterprise-grade cloud-based container orchestration system with Kubernetes at the backend. It can be used both as a Red Hat Container Orchestration Engine and Platform-as-a-Service (PaaS). &lt;a href=&quot;https://github.com/openshift/origin&quot; rel=&quot;nofollow&quot;&gt;https://github.com/openshift/origin&lt;/a&gt;

LOST view: Technical view - Infrastructure

Interoperability saliency: Containers Manager ABB is salient for technical interoperability due to its setting up the software tool to manage virtual public services and tools.

Identifier: &lt;a href=&quot;http://data.europa.eu/dr8/ContainersManagerTechnologyService&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/ContainersManagerTechnologyService&lt;/a&gt;

eira:ID: &lt;a href=&quot;http://data.europa.eu/dr8/ContainersManagerTechnologyService&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/ContainersManagerTechnologyService&lt;/a&gt;

ABB name: eira:ContainersManagerTechnologyService

EIRA concept: eira:ArchitectureBuildingBlock

Last modification:</skos:definition>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/view/TechnicalView-Infrastructure"/>
    <ns1:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of Containers Manager&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/ContainersManagerTechnologyService_Properties&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/ContainersManagerTechnologyService&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of Containers Manager&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/ContainersManagerTechnologyService&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:ContainersManagerTechnologyService&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2023-05-25&quot;},{&quot;property&quot;:&quot;skos:definition&quot;,&quot;value&quot;:&quot;Containers Manager ABB is a Technology Service that implements the process of organizing, adding or replacing large numbers of software containers&quot;},{&quot;property&quot;:&quot;eira:definitionSource&quot;,&quot;value&quot;:&quot;Inspired in referent cloud service providers&quot;},{&quot;property&quot;:&quot;skos:example&quot;,&quot;value&quot;:&quot;The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): OpenSHIFT is a secure and an enterprise-grade cloud-based container orchestration system with Kubernetes at the backend. It can be used both as a Red Hat Container Orchestration Engine and Platform-as-a-Service (PaaS). https:\/\/github.com\/openshift\/origin&quot;},{&quot;property&quot;:&quot;eira:iopSaliency&quot;,&quot;value&quot;:&quot;Containers Manager ABB is salient for technical interoperability due to its setting up the software tool to manage virtual public services and tools.&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Structural IoP&quot;},{&quot;property&quot;:&quot;eira:view&quot;,&quot;value&quot;:&quot;Technical view - infrastructure&quot;}]}</ns1:properties>
