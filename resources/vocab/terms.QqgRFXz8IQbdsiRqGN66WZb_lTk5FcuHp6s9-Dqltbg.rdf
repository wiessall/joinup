  <skos:Concept rdf:about="http://data.europa.eu/dr8/DigitalPublicServiceDeliveryBusinessInterface">
    <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Digital Public Service Delivery</skos:prefLabel>
    <skos:definition xml:lang="en">Definition: Digital Public Service Delivery ABB is a Business Interface representing the way in which the public sector delivers digital technologies and public services to citizens and businesses.

Source: OECD

Source reference: &lt;a href=&quot;https://www.oecd-ilibrary.org/docserver/gov_glance-2017-72-en.pdf?expires=1649771036&amp;amp;id=id&amp;amp;accname=guest&amp;amp;checksum=15BFD2F7E916921236CCF160605A6430&quot; rel=&quot;nofollow&quot;&gt;https://www.oecd-ilibrary.org/docserver/gov_glance-2017-72-en.pdf?expir…&lt;/a&gt;

Example: The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): The Spanish Tax Agency is responsible for providing Digital Public Services on TAX payment. &lt;a href=&quot;https://sede.agenciatributaria.gob.es/Sede/en_gb/iva.html&quot; rel=&quot;nofollow&quot;&gt;https://sede.agenciatributaria.gob.es/Sede/en_gb/iva.html&lt;/a&gt;

IoP Dimension: Behavioural IoP

LOST view: Organisational view

Interoperability saliency: The Digital Public Service Delivery ABB is a key interoperability enabler (*) for organizational and semantic interoperability because it defines the mechanism to deliver digital services in terms of (i) establishing a mechanism to interact with the data; (ii) establishing rules to validate the data and procedures; and (iii) provide a transparent response to the different petitions from the stakeholders.

Identifier: &lt;a href=&quot;http://data.europa.eu/dr8/DigitalPublicServiceDeliveryBusinessInterface&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/DigitalPublicServiceDeliveryBusinessInterface&lt;/a&gt;

eira:ID: ABB504

ABB name: eira:DigitalPublicServiceDeliveryBusinessInterface

EIRA concept: eira:ArchitectureBuildingBlock

Last modification: 2023-11-01</skos:definition>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/viewpoint/KeyInteroperabilityEnablersViewpoint"/>
    <ns1:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of Digital Public Service Delivery&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/DigitalPublicServiceDeliveryBusinessInterface_Properties&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/DigitalPublicServiceDeliveryBusinessInterface&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of Digital Public Service Delivery&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/DigitalPublicServiceDeliveryBusinessInterface&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:DigitalPublicServiceDeliveryBusinessInterface&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2023-11-1&quot;},{&quot;property&quot;:&quot;skos:definition&quot;,&quot;value&quot;:&quot;Digital Public Service Delivery ABB is a Business Interface representing the way in which the public sector delivers digital technologies and public services to citizens and businesses.&quot;},{&quot;property&quot;:&quot;eira:definitionSource&quot;,&quot;value&quot;:&quot;OECD&quot;},{&quot;property&quot;:&quot;eira:definitionSourceReference&quot;,&quot;value&quot;:&quot;https:\/\/www.oecd-ilibrary.org\/docserver\/gov_glance-2017-72-en.pdf?expires=1649771036\u0026id=id\u0026accname=guest\u0026checksum=15BFD2F7E916921236CCF160605A6430&quot;},{&quot;property&quot;:&quot;skos:example&quot;,&quot;value&quot;:&quot;The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): The Spanish Tax Agency is responsible for providing Digital Public Services on TAX payment. https:\/\/sede.agenciatributaria.gob.es\/Sede\/en_gb\/iva.html&quot;},{&quot;property&quot;:&quot;eira:iopSaliency&quot;,&quot;value&quot;:&quot;The Digital Public Service Delivery ABB is a key interoperability enabler (*) for organizational and semantic interoperability because it defines the mechanism to deliver digital services in terms of (i) establishing a mechanism to interact with the data; (ii) establishing rules to validate the data and procedures; and (iii) provide a transparent response to the different petitions from the stakeholders.&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Behavioral IoP&quot;},{&quot;property&quot;:&quot;eira:view&quot;,&quot;value&quot;:&quot;Organisational view&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;Highlevel viewpoint&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;Key Interoperability Enablers viewpoint&quot;}]}</ns1:properties>
