  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/EiraArchitectureBuildingBlock">
    <skos:definition xml:lang="en">DEFINITION:
EIRA Architecture Building Block ABB is a Business Object acting as a requirement of an intermediate  level of granularity, in alignment with at least one EIF principle, formulated as an agreed normative statement in functional terms on a legal, organisational, semantic, or technical attribute of a To-Be European Public Service. An EIRA ABB might encapsulate several interoperability aspects

Source: Europa
(&lt;a href=&quot;https://ec.europa.eu/digital-building-blocks/wikis/display/CEFDIGITAL/What+is+a+Building+Block&quot; rel=&quot;nofollow&quot;&gt;https://ec.europa.eu/digital-building-blocks/wikis/display/CEFDIGITAL/W…&lt;/a&gt;)

EXAMPLES:
The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB):

A Legal Act is an EIRA Architecture Building Block from a Legal view perspective.</skos:definition>
    <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">EIRA Architecture Building Block</skos:prefLabel>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/Deprecated"/>
    <ns0:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;owl&quot;:{&quot;namespace&quot;:&quot;owl:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2002\/07\/owl#&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of EIRA Architecture Building Block&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/EiraArchitectureBuildingBlock_Properties&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of EIRA Architecture Building Block&quot;},{&quot;property&quot;:&quot;owl:deprecated&quot;,&quot;value&quot;:&quot;true&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:EiraArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2023-05-25&quot;},{&quot;property&quot;:&quot;eira:ABB_Status&quot;,&quot;value&quot;:&quot;Obsolete&quot;},{&quot;property&quot;:&quot;eira:ID&quot;,&quot;value&quot;:&quot;ABB337&quot;}]}</ns0:properties>
