  <skos:Concept rdf:about="http://data.europa.eu/dr8/BusinessProcessManagementComponent">
    <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Business Process Management Component</skos:prefLabel>
    <skos:definition xml:lang="en">A Business Process Management Component encapsulates the functionalities for the orchestration/choreography of business processes.</skos:definition>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/Deprecated"/>
    <ns1:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;owl&quot;:{&quot;namespace&quot;:&quot;owl:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2002\/07\/owl#&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of Business Process Management Component&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/BusinessProcessManagementComponent_Properties&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of Business Process Management Component&quot;},{&quot;property&quot;:&quot;owl:deprecated&quot;,&quot;value&quot;:&quot;true&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:BusinessProcessManagementComponent&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2023-05-25&quot;},{&quot;property&quot;:&quot;eira:ABB_Status&quot;,&quot;value&quot;:&quot;Obsolete&quot;},{&quot;property&quot;:&quot;eira:ID&quot;,&quot;value&quot;:&quot;ABB166&quot;}]}</ns1:properties>
