  <skos:Concept rdf:about="http://data.europa.eu/dr8/PublicPolicyDevelopmentEnabler">
    <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Public Policy Development Enabler</skos:prefLabel>
    <skos:definition xml:lang="en">A Public Policy Development Enabler is an organisation or thing that make the development and implementation of the Public Policy possible. [Oxford Dictionary]

Source: &lt;a href=&quot;http://www.oxforddictionaries.com/definition/english/enabler&quot; rel=&quot;nofollow&quot;&gt;http://www.oxforddictionaries.com/definition/english/enabler&lt;/a&gt;</skos:definition>
