    <skos:prefLabel xml:lang="en">Object-Oriented Database Manager</skos:prefLabel>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/view/TechnicalView-Infrastructure"/>
    <ns0:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of Object-Oriented Database Manager&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/Object-OrientedDatabaseManagerTechnologyService_Properties&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/Object-OrientedDatabaseManagerTechnologyService&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of Object-Oriented Database Manager&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/Object-OrientedDatabaseManagerTechnologyService&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:Object-OrientedDatabaseManagerTechnologyService&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2023-05-25&quot;},{&quot;property&quot;:&quot;skos:definition&quot;,&quot;value&quot;:&quot;Object Oriented Database Manager ABB is a Technology Service that implements the behaviour of a software system that applies concepts of object-oriented programming, and applies them to the management of persistent objects on behalf of multiple users, with capabilities for security, integrity, recovery and contention management&quot;},{&quot;property&quot;:&quot;eira:definitionSource&quot;,&quot;value&quot;:&quot;Gartner&quot;},{&quot;property&quot;:&quot;eira:definitionSourceReference&quot;,&quot;value&quot;:&quot;https:\/\/www.gartner.com\/en\/information-technology\/glossary\/oodbms-object-oriented-database-management-system&quot;},{&quot;property&quot;:&quot;skos:example&quot;,&quot;value&quot;:&quot;The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): PostgreSQL is an open source object-relational database system that has an edge over other relational databases as the software supports user-defined objects and their behaviors including operators, data types, domains, and indexes. This makes the database software more flexible and robust. https:\/\/www.postgresql.org\/&quot;},{&quot;property&quot;:&quot;eira:iopSaliency&quot;,&quot;value&quot;:&quot;Object Oriented DatabaseManager ABB is salient for semantic interoperability because it implements data management using object-oriented specifications and their corresponding data representation to share the information with different public administration services.&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Behavioral IoP&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Structural IoP&quot;},{&quot;property&quot;:&quot;eira:view&quot;,&quot;value&quot;:&quot;Technical view - infrastructure&quot;}]}</ns0:properties>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/OnPremiseFacility">
    <skos:definition xml:lang="en">Definition: On Premise Facility ABB is a Facility referring to to a physical location, such as an office or data center, that is owned and managed by a business or organization

Source: Inspired in The Free Dictionary

Source reference: &lt;a href=&quot;https://encyclopedia2.thefreedictionary.com/Facility&quot; rel=&quot;nofollow&quot;&gt;https://encyclopedia2.thefreedictionary.com/Facility&lt;/a&gt;

Example: The following implementation is an example of how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): JRC- Development of the EU Green Public Procurement (GPP)- Critaria for Data Centres, Server Rooms and Cloud Services. &lt;a href=&quot;https://ec.europa.eu/environment/gpp/pdf/jrc118558_2020_0605_data_centres_technical_report_jrc_clean_with_id.pdf&quot; rel=&quot;nofollow&quot;&gt;https://ec.europa.eu/environment/gpp/pdf/jrc118558_2020_0605_data_centr…&lt;/a&gt;

LOST view: Technical view - Infrastructure

Interoperability saliency: The On Premise Facility ABB is salient for organizational interoperability because it establishes the business rules and responsibilities to place the public administration ICT infrastructure in a custom location.

Identifier: &lt;a href=&quot;http://data.europa.eu/dr8/OnPremiseFacility&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/OnPremiseFacility&lt;/a&gt;

eira:ID: &lt;a href=&quot;http://data.europa.eu/dr8/OnPremiseFacility&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/OnPremiseFacility&lt;/a&gt;

ABB name: eira:OnPremiseFacility

EIRA concept: eira:ArchitectureBuildingBlock

Last modification: 2022-31-01</skos:definition>
