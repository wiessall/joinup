    <skos:related>
      <skos:Concept rdf:about="http://data.europa.eu/dr8/CoordinationCapacityValue">
        <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
        <skos:prefLabel xml:lang="en">Coordination Capacity</skos:prefLabel>
        <skos:definition xml:lang="en">Definition: The Coordination Capacity Value ABB refers to mediating and bringing different administrative units and dispersed actors to work together to achieve joint actions. It is not only about vertical coordination by hierarchy but also about facilitating horizontal coordination across policy areas and organizations at the same administrative level.

Source: Administrative coordination capacity; does the wickedness of policy areas matter?

Source reference: &lt;a href=&quot;https://www.duo.uio.no/bitstream/handle/10852/76072/10-108014494035-2019-1584147.pdf?sequence=4&amp;amp;isAllowed=y&quot; rel=&quot;nofollow&quot;&gt;https://www.duo.uio.no/bitstream/handle/10852/76072/10-108014494035-201…&lt;/a&gt;

IoP Dimension: Governance IoP

Identifier: &lt;a href=&quot;http://data.europa.eu/dr8/CoordinationCapacityValue&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/CoordinationCapacityValue&lt;/a&gt;

eira:ID: &lt;a href=&quot;http://data.europa.eu/dr8/CoordinationCapacityValue&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/CoordinationCapacityValue&lt;/a&gt;

ABB name: eira:CoordinationCapacityValue

EIRA concept: eira:ArchitectureBuildingBlock</skos:definition>
        <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/viewpoint/EnterpriseArchitectureFrameworkAlignmentGuidelinesViewpoint"/>
        <ns1:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of Coordination Capacity&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/CoordinationCapacityValue_Properties&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/CoordinationCapacityValue&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of Coordination Capacity&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/CoordinationCapacityValue&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:CoordinationCapacityValue&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2023-05-25&quot;},{&quot;property&quot;:&quot;skos:definition&quot;,&quot;value&quot;:&quot;The Coordination Capacity Value ABB refers to mediating and bringing different administrative units and dispersed actors to work together to achieve joint actions. It is not only about vertical coordination by hierarchy but also about facilitating horizontal coordination across policy areas and organizations at the same administrative level.&quot;},{&quot;property&quot;:&quot;eira:definitionSource&quot;,&quot;value&quot;:&quot;Administrative coordination capacity; does the wickedness of policy areas matter?&quot;},{&quot;property&quot;:&quot;eira:definitionSourceReference&quot;,&quot;value&quot;:&quot;https:\/\/www.duo.uio.no\/bitstream\/handle\/10852\/76072\/10-108014494035-2019-1584147.pdf?sequence=4\u0026isAllowed=y&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Governance IoP&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;Enterprise Architecture Framework alignment guidelines viewpoint&quot;}]}</ns1:properties>
