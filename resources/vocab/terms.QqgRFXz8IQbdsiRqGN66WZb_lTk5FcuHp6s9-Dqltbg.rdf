    <ns1:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of Server&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/ServerNode_Properties&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/ServerNode&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of Server&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/ServerNode&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:ServerNode&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2022-01-31&quot;},{&quot;property&quot;:&quot;skos:definition&quot;,&quot;value&quot;:&quot;Server ABB is a Node that enables access to resources or services to other computers or devices on a network&quot;},{&quot;property&quot;:&quot;eira:definitionSource&quot;,&quot;value&quot;:&quot;Gartner&quot;},{&quot;property&quot;:&quot;eira:definitionSourceReference&quot;,&quot;value&quot;:&quot;https:\/\/www.gartner.com\/en\/information-technology\/glossary\/clientserver&quot;},{&quot;property&quot;:&quot;skos:example&quot;,&quot;value&quot;:&quot;The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): DIGIT\/C Hosting Service - DIGIT\/C offers a high availability and high performance hosting infrastructure that is being comprised, among other elements, of back-end web server instances and application servers for hosting and serving both static and dynamic sites. http:\/\/ec.europa.eu\/ipg\/build\/infrastructure\/index_en.htm&quot;},{&quot;property&quot;:&quot;eira:iopSaliency&quot;,&quot;value&quot;:&quot;The Server ABB is salient for technical interoperability because it provides the capabilities to host public administration services at both levels, internally and externally.&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Structural IoP&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Behavioral IoP&quot;},{&quot;property&quot;:&quot;eira:view&quot;,&quot;value&quot;:&quot;Technical view - infrastructure&quot;}]}</ns1:properties>
