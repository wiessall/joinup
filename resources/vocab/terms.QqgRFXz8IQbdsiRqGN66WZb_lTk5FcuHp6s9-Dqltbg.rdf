    <skos:related rdf:resource="http://data.europa.eu/dr8/NoSQLDatabaseManagerTechnologyService"/>
  </skos:Concept>

  <skos:Concept rdf:about="http://data.europa.eu/dr8/ApplicationPresentationEnablersGrouping">
    <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Application Presentation Enablers</skos:prefLabel>
    <skos:definition xml:lang="en">Definition: Application Presentation Enablers ABB is a Grouping that enables the implementation of visually appealing and interactive user interfaces for software applications

Source: Inspired in Redhat

Source reference: &lt;a href=&quot;https://www.redhat.com/architect/5-essential-patterns-software-architecture&quot; rel=&quot;nofollow&quot;&gt;https://www.redhat.com/architect/5-essential-patterns-software-architec…&lt;/a&gt;

IoP Dimension: Behavioral IoP

LOST view: Technical view - application

Interoperability saliency: The Application Presentation Enablers Grouping ABB is salient for interoperability because is composed of the Human Interface Application Interface which is a key interoperability enabler that facilitates the data exchange between parties using the digital public service. In addition, this is relevant for interoperability because the ABBs included can work as a tool through which to assess compatible interfaces.

Identifier: &lt;a href=&quot;http://data.europa.eu/dr8/ApplicationPresentationEnablersGrouping&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/ApplicationPresentationEnablersGrouping&lt;/a&gt;

eira:ID: &lt;a href=&quot;http://data.europa.eu/dr8/ApplicationPresentationEnablersGrouping&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/ApplicationPresentationEnablersGrouping&lt;/a&gt;

ABB name: eira:ApplicationPresentationEnablersGrouping

EIRA concept: eira:ArchitectureBuildingBlock</skos:definition>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/viewpoint/EIRAOntologyViewpoint"/>
    <ns1:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of Application Presentation Enablers&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/ApplicationPresentationEnablersGrouping_Properties&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/ApplicationPresentationEnablersGrouping&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of Application Presentation Enablers&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/ApplicationPresentationEnablersGrouping&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:ApplicationPresentationEnablersGrouping&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2023-05-25&quot;},{&quot;property&quot;:&quot;skos:definition&quot;,&quot;value&quot;:&quot;Application Presentation Enablers ABB is a Grouping that enables the implementation of visually appealing and interactive user interfaces for software applications&quot;},{&quot;property&quot;:&quot;eira:definitionSource&quot;,&quot;value&quot;:&quot;Inspired in Redhat&quot;},{&quot;property&quot;:&quot;eira:definitionSourceReference&quot;,&quot;value&quot;:&quot;https:\/\/www.redhat.com\/architect\/5-essential-patterns-software-architecture&quot;},{&quot;property&quot;:&quot;eira:iopSaliency&quot;,&quot;value&quot;:&quot;The Application Presentation Enablers Grouping ABB is salient for interoperability because is composed of the Human Interface Application Interface which is a key interoperability enabler that facilitates the data exchange between parties using the digital public service. In addition, this is relevant for interoperability because the ABBs included can work as a tool through which to assess compatible interfaces.&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Behavioral IoP&quot;},{&quot;property&quot;:&quot;eira:view&quot;,&quot;value&quot;:&quot;Technical view - application&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;Highlevel viewpoint&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;EIRA Ontology viewpoint&quot;}]}</ns1:properties>
