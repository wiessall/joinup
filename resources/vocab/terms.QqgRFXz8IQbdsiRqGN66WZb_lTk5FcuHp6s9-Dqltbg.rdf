  <skos:Concept rdf:about="http://data.europa.eu/dr8/DeliveryCapacityValue">
    <skos:definition xml:lang="en">Definition: The Delivery Capacity Value ABB refers to the ability of public administrations to deliver public services, programs, and policies effectively and efficiently to citizens and stakeholders. It encompasses the overall performance, effectiveness, and responsiveness of public administration in meeting the needs and expectations of the public.

Source: Public Administration Reform: A Comparative Analysis

IoP Dimension: Governance IoP

Identifier: &lt;a href=&quot;http://data.europa.eu/dr8/DeliveryCapacityValue&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/DeliveryCapacityValue&lt;/a&gt;

eira:ID: &lt;a href=&quot;http://data.europa.eu/dr8/DeliveryCapacityValue&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/DeliveryCapacityValue&lt;/a&gt;

ABB name: eira:DeliveryCapacityValue

EIRA concept: eira:ArchitectureBuildingBlock</skos:definition>
    <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Delivery Capacity</skos:prefLabel>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/viewpoint/EnterpriseArchitectureFrameworkAlignmentGuidelinesViewpoint"/>
    <ns0:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of Delivery Capacity&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/DeliveryCapacityValue_Properties&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/DeliveryCapacityValue&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of Delivery Capacity&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/DeliveryCapacityValue&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:DeliveryCapacityValue&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2023-05-25&quot;},{&quot;property&quot;:&quot;skos:definition&quot;,&quot;value&quot;:&quot;The Delivery Capacity Value ABB refers to the ability of public administrations to deliver public services, programs, and policies effectively and efficiently to citizens and stakeholders. It encompasses the overall performance, effectiveness, and responsiveness of public administration in meeting the needs and expectations of the public.&quot;},{&quot;property&quot;:&quot;eira:definitionSource&quot;,&quot;value&quot;:&quot;Public Administration Reform: A Comparative Analysis&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Governance IoP&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;Enterprise Architecture Framework alignment guidelines viewpoint&quot;}]}</ns0:properties>
