quot;value&quot;:&quot;http:\/\/ec.europa.eu\/eurostat\/data\/data-validation&quot;},{&quot;property&quot;:&quot;skos:example&quot;,&quot;value&quot;:&quot;The following implementation is an example of how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): Opinion of the European Economic and Social Committee on Next Generation SME Strategy \u2014 Enhancing Effective and Swift Delivery (own-initiative opinion). https:\/\/eur-lex.europa.eu\/legal-content\/EN\/TXT\/?uri=CELEX%3A52021IE3668\u0026qid=1664779252884&quot;},{&quot;property&quot;:&quot;eira:iopSaliency&quot;,&quot;value&quot;:&quot;The Non-binding Instrument ABB is a key salient for the legal and governance interoperability enabler as a specialisation of the Legal Act, it makes the recommendation of implementation of the policies and rules.&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Governance IoP&quot;},{&quot;property&quot;:&quot;eira:view&quot;,&quot;value&quot;:&quot;Legal view&quot;}]}</ns0:properties>
