  <skos:Concept rdf:about="http://data.europa.eu/dr8/DatabricksTechnologyService">
    <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Databricks</skos:prefLabel>
    <skos:definition xml:lang="en">Definition: Databriks ABB is a Technology Service that enables the procedures of a collaborative workspace to process large amounts of public administration data

Source: Inspired in Databriks

Source reference: &lt;a href=&quot;https://docs.databricks.com/introduction/index.html&quot; rel=&quot;nofollow&quot;&gt;https://docs.databricks.com/introduction/index.html&lt;/a&gt;

Example: The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): IOStack is an H2020 funded by the European Commission that implemented Databricks as the tool for processing large amounts of data. &lt;a href=&quot;https://ec.europa.eu/research/participants/documents/downloadPublic?documentIds=080166e5ae65ba9a&amp;amp;appId=PPGMS&quot; rel=&quot;nofollow&quot;&gt;https://ec.europa.eu/research/participants/documents/downloadPublic?doc…&lt;/a&gt;

LOST view: Technical view - Infrastructure

Interoperability saliency: Databriks ABB is salient for semantic interoperability because it permits to break of public administration siloes through the construction of shared spaces to process and analyse data from different sources and domains.

Identifier: &lt;a href=&quot;http://data.europa.eu/dr8/DatabricksTechnologyService&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/DatabricksTechnologyService&lt;/a&gt;

eira:ID: &lt;a href=&quot;http://data.europa.eu/dr8/DatabricksTechnologyService&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/DatabricksTechnologyService&lt;/a&gt;

ABB name: eira:DatabricksTechnologyService

EIRA concept: eira:ArchitectureBuildingBlock</skos:definition>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/view/TechnicalView-Infrastructure"/>
    <ns1:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of Databricks&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/DatabricksTechnologyService_Properties&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/DatabricksTechnologyService&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of Databricks&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/DatabricksTechnologyService&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:DatabricksTechnologyService&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2023-05-25&quot;},{&quot;property&quot;:&quot;skos:definition&quot;,&quot;value&quot;:&quot;Databriks ABB is a Technology Service that enables the procedures of a collaborative workspace to process large amounts of public administration data&quot;},{&quot;property&quot;:&quot;eira:definitionSource&quot;,&quot;value&quot;:&quot;Inspired in Databriks&quot;},{&quot;property&quot;:&quot;eira:definitionSourceReference&quot;,&quot;value&quot;:&quot;https:\/\/docs.databricks.com\/introduction\/index.html&quot;},{&quot;property&quot;:&quot;skos:example&quot;,&quot;value&quot;:&quot;The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): IOStack is an H2020 funded by the European Commission that implemented Databricks as the tool for processing large amounts of data. https:\/\/ec.europa.eu\/research\/participants\/documents\/downloadPublic?documentIds=080166e5ae65ba9a\u0026appId=PPGMS&quot;},{&quot;property&quot;:&quot;eira:iopSaliency&quot;,&quot;value&quot;:&quot;Databriks ABB is salient for semantic interoperability because it permits to break of public administration siloes through the construction of shared spaces to process and analyse data from different sources and domains.&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Structural IoP&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Behavioral IoP&quot;},{&quot;property&quot;:&quot;eira:view&quot;,&quot;value&quot;:&quot;Technical view - infrastructure&quot;}]}</ns1:properties>
