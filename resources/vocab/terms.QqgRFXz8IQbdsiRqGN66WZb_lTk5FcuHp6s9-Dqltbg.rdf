  <skos:Concept rdf:about="http://data.europa.eu/dr8/LinkedDataRepresentation">
    <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Linked Data</skos:prefLabel>
    <skos:definition xml:lang="en">Definition: Linked data ABB is a Representation that enables a set of principles and technologies for publishing, sharing, and connecting structured data on the web.

Source: W3C-Linked Data

Source reference: &lt;a href=&quot;https://www.w3.org/standards/semanticweb/data&quot; rel=&quot;nofollow&quot;&gt;https://www.w3.org/standards/semanticweb/data&lt;/a&gt;

Example: The following implementation is an example of how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): Publications Office Linked Data Repository. &lt;a href=&quot;https://op.europa.eu/en/linked-data&quot; rel=&quot;nofollow&quot;&gt;https://op.europa.eu/en/linked-data&lt;/a&gt;

LOST view: Semantic view

Interoperability saliency: The Linked Data Representation ABB is salient for semantic interoperability because it provides a set of publishing, sharing, and connection methods that allow linking the data from digital public services, making it more meaningful and increasing the quality and scope of data and services.

Identifier: &lt;a href=&quot;http://data.europa.eu/dr8/LinkedDataRepresentation&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/LinkedDataRepresentation&lt;/a&gt;

eira:ID: &lt;a href=&quot;http://data.europa.eu/dr8/LinkedDataRepresentation&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/LinkedDataRepresentation&lt;/a&gt;

ABB name: eira:LinkedDataRepresentation

EIRA concept: eira:ArchitectureBuildingBlock

Last modification: 2022-26-01</skos:definition>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/view/SemanticView"/>
    <ns1:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of Linked Data&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/LinkedDataRepresentation_Properties&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/LinkedDataRepresentation&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of Linked Data&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/LinkedDataRepresentation&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:LinkedDataRepresentation&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2022-01-26&quot;},{&quot;property&quot;:&quot;skos:definition&quot;,&quot;value&quot;:&quot;Linked data ABB is a Representation that enables a set of principles and technologies for publishing, sharing, and connecting structured data on the web.&quot;},{&quot;property&quot;:&quot;eira:definitionSource&quot;,&quot;value&quot;:&quot;W3C-Linked Data&quot;},{&quot;property&quot;:&quot;eira:definitionSourceReference&quot;,&quot;value&quot;:&quot;https:\/\/www.w3.org\/standards\/semanticweb\/data&quot;},{&quot;property&quot;:&quot;skos:example&quot;,&quot;value&quot;:&quot;The following implementation is an example of how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): Publications Office Linked Data Repository. https:\/\/op.europa.eu\/en\/linked-data&quot;},{&quot;property&quot;:&quot;eira:iopSaliency&quot;,&quot;value&quot;:&quot;The Linked Data Representation ABB is salient for semantic interoperability because it provides a set of publishing, sharing, and connection methods that allow linking the data from digital public services, making it more meaningful and increasing the quality and scope of data and services.&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Behavioral IoP&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Structural IoP&quot;},{&quot;property&quot;:&quot;eira:view&quot;,&quot;value&quot;:&quot;Semantic view&quot;}]}</ns1:properties>
