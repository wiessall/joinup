  <skos:Concept rdf:about="http://data.europa.eu/dr8/DataStandard">
    <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Data Standard</skos:prefLabel>
    <skos:definition xml:lang="en">A data standard is a structural metadata specification that describes or defines other data [ISO111179]. Structural metadata indicates how compound objects are put together [NISO]. It can consist of among others data models, reference data, and identifier schemas.</skos:definition>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/Deprecated"/>
