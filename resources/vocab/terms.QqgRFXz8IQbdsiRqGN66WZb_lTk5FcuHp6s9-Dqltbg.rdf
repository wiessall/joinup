  <skos:Concept rdf:about="http://data.europa.eu/dr8/MetadataDataObject">
    <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Metadata</skos:prefLabel>
    <skos:definition xml:lang="en">Definition: Metadata ABB is a Data Object providing information about one or more aspects of the data

Source: W3C

Source reference: &lt;a href=&quot;http://www.w3.org/Metadata/&quot; rel=&quot;nofollow&quot;&gt;www.w3.org/Metadata/&lt;/a&gt;

Example: The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): &lt;a href=&quot;https://data.europa.eu/en&quot; rel=&quot;nofollow&quot;&gt;https://data.europa.eu/en&lt;/a&gt;

IoP Dimension: Behavioual IoP

LOST view: Semantic view

Interoperability saliency: The Metadata ABB is a key interoperability enabler (*) for behavioural interoperability by enabling data discoverability and reuse enhancing the delivery and collaboration between digital public services.

Identifier: &lt;a href=&quot;http://data.europa.eu/dr8/MetadataDataObject&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/MetadataDataObject&lt;/a&gt;

eira:ID: ABB513

ABB name: eira:MetadataDataObject

EIRA concept: eira:ArchitectureBuildingBlock

Last modification: 2022-17-01</skos:definition>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/viewpoint/KeyInteroperabilityEnablersViewpoint"/>
    <ns1:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of Metadata&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/MetadataDataObject_Properties&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/MetadataDataObject&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of Metadata&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/MetadataDataObject&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:MetadataDataObject&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2022-01-17&quot;},{&quot;property&quot;:&quot;skos:definition&quot;,&quot;value&quot;:&quot;Metadata ABB is a Data Object providing information about one or more aspects of the data&quot;},{&quot;property&quot;:&quot;eira:definitionSource&quot;,&quot;value&quot;:&quot;W3C&quot;},{&quot;property&quot;:&quot;eira:definitionSourceReference&quot;,&quot;value&quot;:&quot;www.w3.org\/Metadata\/&quot;},{&quot;property&quot;:&quot;skos:example&quot;,&quot;value&quot;:&quot;The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): https:\/\/data.europa.eu\/en&quot;},{&quot;property&quot;:&quot;eira:iopSaliency&quot;,&quot;value&quot;:&quot;The Metadata ABB is a key interoperability enabler (*) for behavioural interoperability by enabling data discoverability and reuse enhancing the delivery and collaboration between digital public services.&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Behavioral IoP&quot;},{&quot;property&quot;:&quot;eira:view&quot;,&quot;value&quot;:&quot;Semantic view&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;Key Interoperability Enablers viewpoint&quot;}]}</ns1:properties>
