  <skos:Concept rdf:about="http://data.europa.eu/dr8/RegulatoryCapacityValue">
    <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Regulatory Capacity</skos:prefLabel>
    <skos:definition xml:lang="en">Definition: The Regulatory Capacity Value ABB relates to a government's ability to develop, implement, and enforce regulations and rules effectively. It involves having the necessary resources, expertise, and mechanisms in place to establish and enforce regulatory frameworks that protect public interests, promote compliance, and achieve desired outcomes.

Source: Public Administration Reform: A Comparative Analysis

IoP Dimension: Governance IoP

Identifier: &lt;a href=&quot;http://data.europa.eu/dr8/RegulatoryCapacityValue&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/RegulatoryCapacityValue&lt;/a&gt;

eira:ID: &lt;a href=&quot;http://data.europa.eu/dr8/RegulatoryCapacityValue&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/RegulatoryCapacityValue&lt;/a&gt;

ABB name: eira:RegulatoryCapacityValue

EIRA concept: eira:ArchitectureBuildingBlock</skos:definition>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/viewpoint/EnterpriseArchitectureFrameworkAlignmentGuidelinesViewpoint"/>
    <ns1:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of Regulatory Capacity&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/RegulatoryCapacityValue_Properties&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/RegulatoryCapacityValue&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of Regulatory Capacity&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/RegulatoryCapacityValue&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:RegulatoryCapacityValue&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2023-05-25&quot;},{&quot;property&quot;:&quot;skos:definition&quot;,&quot;value&quot;:&quot;The Regulatory Capacity Value ABB relates to a government\u0027s ability to develop, implement, and enforce regulations and rules effectively. It involves having the necessary resources, expertise, and mechanisms in place to establish and enforce regulatory frameworks that protect public interests, promote compliance, and achieve desired outcomes.&quot;},{&quot;property&quot;:&quot;eira:definitionSource&quot;,&quot;value&quot;:&quot;Public Administration Reform: A Comparative Analysis&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Governance IoP&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;Enterprise Architecture Framework alignment guidelines viewpoint&quot;}]}</ns1:properties>
