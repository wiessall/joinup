  <skos:Concept rdf:about="http://data.europa.eu/dr8/PublicServiceManifestation">
    <skos:definition xml:lang="en">A Public Service Manifestation is a behaviour EIRA© Architecture Building Block, i.e. a unit of activity performed by one or more Public Service Components.</skos:definition>
    <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Public Service Manifestation</skos:prefLabel>
