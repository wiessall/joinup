quot;:&quot;Inspired in the Law Insider dictionary definition&quot;},{&quot;property&quot;:&quot;eira:definitionSourceReference&quot;,&quot;value&quot;:&quot;https:\/\/www.lawinsider.com\/dictionary\/organizational-agreement&quot;},{&quot;property&quot;:&quot;skos:example&quot;,&quot;value&quot;:&quot;The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): DSI Organisational Agreement: The Trust and Golden agreement hereby consent to this assignment by SAC of its rights under the Organizational Agreement to DSI and the assumption by DSI of SAC\u0027s interest in such Agreement and the duties and obligations thereunder, and agree, subject to the terms and conditions of said Agreement, to look to DSI for the performance of the duties and obligations formerly owed by SAC under said Agreement. https:\/\/www.sec.gov\/Archives\/edgar\/data\/1618181\/000119312518153039\/d419625dex42.htm&quot;},{&quot;property&quot;:&quot;eira:iopSaliency&quot;,&quot;value&quot;:&quot;The Organisational Agreement ABB is relevant for governance and behavioural interoperability because it sets the foundations and management for (i) controlling the collaborations and data flows established between public digital services, and (ii) specifying the digital business capabilities expected from the public digital services.&quot;},{&quot;property&quot;:&quot;skos:note&quot;,&quot;value&quot;:&quot;For example (among other things), fees are paid to the organisation or to a delegated party in exchange for organizational, managing, consulting or similar services.&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Governance IoP&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Behavioral IoP&quot;},{&quot;property&quot;:&quot;eira:view&quot;,&quot;value&quot;:&quot;Organisational view&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;Interoperability Governance viewpoint&quot;}]}</ns1:properties>
