uot;:&quot;Inspired in Digital Strategy Europe&quot;},{&quot;property&quot;:&quot;eira:definitionSourceReference&quot;,&quot;value&quot;:&quot;https:\/\/digital-strategy.ec.europa.eu\/en\/library\/study-mapping-data-flows&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Structural IoP&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Behavioral IoP&quot;},{&quot;property&quot;:&quot;eira:view&quot;,&quot;value&quot;:&quot;Semantic view&quot;}]}</ns1:properties>
