iew&quot;,&quot;value&quot;:&quot;Organisational view&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;Interoperability Governance viewpoint&quot;}]}</ns0:properties>
