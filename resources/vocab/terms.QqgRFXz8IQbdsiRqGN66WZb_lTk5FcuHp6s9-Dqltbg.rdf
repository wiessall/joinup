    <ns0:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of Key Interoperability Enablers&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/KeyInteroperabilityEnablers_Properties&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/KeyInteroperabilityEnablers&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of Key Interoperability Enablers&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/KeyInteroperabilityEnablers&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:KeyInteroperabilityEnablers&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2023-05-25&quot;},{&quot;property&quot;:&quot;skos:definition&quot;,&quot;value&quot;:&quot;A Key Interoperability Enabler is a Grouping that enables the efficient and effective delivery of public services across administrations&quot;},{&quot;property&quot;:&quot;eira:definitionSource&quot;,&quot;value&quot;:&quot;ISA2 Article 2 (14)&quot;},{&quot;property&quot;:&quot;eira:definitionSourceReference&quot;,&quot;value&quot;:&quot;https:\/\/eur-lex.europa.eu\/legal-content\/EN\/TXT\/HTML\/?uri=CELEX:32015D2240#d1e919-1-1&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Structural IoP&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Behavioral IoP&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;Key Interoperability Enablers viewpoint&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;EIRA Ontology viewpoint&quot;}]}</ns0:properties>
