  <skos:Concept rdf:about="http://data.europa.eu/dr8/HumanApplicationInterface">
    <skos:inScheme rdf:resource="http://data.europa.eu/dr8"/>
    <skos:prefLabel xml:lang="en">Human Interface</skos:prefLabel>
    <skos:definition xml:lang="en">Definition: Human Interface ABB is an Application Interface that enables the exchange of data between stakeholders (individuals, public administration or legal entities) and a service. This ABB is a key interoperability enabler (*) for assessing compatible interfaces.

Source: EIA Action

Source reference: &lt;a href=&quot;https://ec.europa.eu/isa2/eif_en&quot; rel=&quot;nofollow&quot;&gt;https://ec.europa.eu/isa2/eif_en&lt;/a&gt;

Synonym: User interface, UI, Graphical User Interface, GUI

Example: The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): GrapesJS - GrapesJS is an open-source, multi-purpose, Web Builder Framework which combines different tools and features with the goal to help you (or users of your application) to build HTML templates without any knowledge of coding. It's a perfect solution to replace the common WYSIWYG editors, which are good for content editing but inappropriate for creating HTML structures. You can see it in action with the official demos, but using its API you're able to build your own editors. &lt;a href=&quot;https://grapesjs.com/&quot; rel=&quot;nofollow&quot;&gt;https://grapesjs.com/&lt;/a&gt;

IoP Dimension: Behavioral IoP

LOST view: Technical view - application

Interoperability saliency: The Human Interface ABB is a key interoperability enabler because it supports to achieve technical behavioral interoperability by enabling the exchange of data, information, and knowledge between digital public services and individuals.

Identifier: &lt;a href=&quot;http://data.europa.eu/dr8/HumanApplicationInterface&quot; rel=&quot;nofollow&quot;&gt;http://data.europa.eu/dr8/HumanApplicationInterface&lt;/a&gt;

eira:ID: ABB37

ABB name: eira:HumanApplicationInterface

EIRA concept: eira:ArchitectureBuildingBlock

Last modification: 2022-18-01</skos:definition>
    <skos:broaderTransitive rdf:resource="http://data.europa.eu/dr8/viewpoint/RESTAPIViewpoint"/>
    <ns1:properties rdf:datatype="http://www.w3.org/2001/XMLSchema#string">{&quot;namespaces&quot;:{&quot;rdf&quot;:{&quot;namespace&quot;:&quot;rdf:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/1999\/02\/22-rdf-syntax-ns#&quot;},&quot;skos&quot;:{&quot;namespace&quot;:&quot;skos:&quot;,&quot;uri&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#&quot;},&quot;dct&quot;:{&quot;namespace&quot;:&quot;dct:&quot;,&quot;uri&quot;:&quot;http:\/\/purl.org\/dc\/terms\/&quot;},&quot;eira&quot;:{&quot;namespace&quot;:&quot;eira:&quot;,&quot;uri&quot;:&quot;http:\/\/data.europa.eu\/dr8\/&quot;}},&quot;rows&quot;:[{&quot;property&quot;:&quot;rdf:type&quot;,&quot;value&quot;:&quot;http:\/\/www.w3.org\/2004\/02\/skos\/core#Concept&quot;},{&quot;property&quot;:&quot;skos:notation&quot;,&quot;value&quot;:&quot;Properties of Human Interface&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/HumanApplicationInterface_Properties&quot;},{&quot;property&quot;:&quot;dct:identifier&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/HumanApplicationInterface&quot;},{&quot;property&quot;:&quot;skos:prefLabel&quot;,&quot;value&quot;:&quot;Properties of Human Interface&quot;},{&quot;property&quot;:&quot;eira:PURI&quot;,&quot;value&quot;:&quot;http:\/\/data.europa.eu\/dr8\/HumanApplicationInterface&quot;},{&quot;property&quot;:&quot;dct:type&quot;,&quot;value&quot;:&quot;eira:HumanApplicationInterface&quot;},{&quot;property&quot;:&quot;dct:modified&quot;,&quot;value&quot;:&quot;2022-01-18&quot;},{&quot;property&quot;:&quot;eira:synonym&quot;,&quot;value&quot;:&quot;User interface, UI, Graphical User Interface, GUI&quot;},{&quot;property&quot;:&quot;skos:definition&quot;,&quot;value&quot;:&quot;Human Interface ABB is an Application Interface that enables the exchange of data between stakeholders (individuals, public administration or legal entities) and a service. This ABB is a key interoperability enabler (*) for assessing compatible interfaces.&quot;},{&quot;property&quot;:&quot;eira:definitionSource&quot;,&quot;value&quot;:&quot;EIA Action&quot;},{&quot;property&quot;:&quot;eira:definitionSourceReference&quot;,&quot;value&quot;:&quot;https:\/\/ec.europa.eu\/isa2\/eif_en&quot;},{&quot;property&quot;:&quot;skos:example&quot;,&quot;value&quot;:&quot;The following implementation is an example on how this specific Architecture Building Block (ABB) can be instantiated as a Solution Building Block (SBB): GrapesJS - GrapesJS is an open-source, multi-purpose, Web Builder Framework which combines different tools and features with the goal to help you (or users of your application) to build HTML templates without any knowledge of coding. It\u0027s a perfect solution to replace the common WYSIWYG editors, which are good for content editing but inappropriate for creating HTML structures. You can see it in action with the official demos, but using its API you\u0027re able to build your own editors. https:\/\/grapesjs.com\/&quot;},{&quot;property&quot;:&quot;eira:iopSaliency&quot;,&quot;value&quot;:&quot;The Human Interface ABB is a key interoperability enabler because it supports to achieve technical behavioral interoperability by enabling the exchange of data, information, and knowledge between digital public services and individuals.&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Behavioral IoP&quot;},{&quot;property&quot;:&quot;eira:view&quot;,&quot;value&quot;:&quot;Technical view - application&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;Interoperability Security viewpoint&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;Highlevel viewpoint&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;EIRA Ontology viewpoint&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;Interoperable European Solution viewpoint&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;REST API viewpoint&quot;}]}</ns1:properties>
