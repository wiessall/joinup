\tStatus of trust service providers\/trust service, compensation of information, path validation. https:\/\/ec.europa.eu\/cefdigital\/wiki\/display\/CEFDIGITAL\/eSignaturefile:\/\/\/C:\/Users\/bocquilp\/Downloads\/DSS(ServiceOfferingDescription)%20(v0.03)%20(5).pdf&quot;},{&quot;property&quot;:&quot;eira:iopSaliency&quot;,&quot;value&quot;:&quot;The e-Seal Verification and Validation Service ABB \u00a0is salient for technical interoperability because it provides the functionalities required for e-seal verification and validation service.&quot;},{&quot;property&quot;:&quot;skos:note&quot;,&quot;value&quot;:&quot;An \u2018electronic seal\u0027 means data in electronic form, which is attached to or logically associated with other data in electronic form to ensure the latter\u2019s origin and integrity. The \u2018creator of a seal\u2019 is a legal person who creates an electronic seal.&quot;},{&quot;property&quot;:&quot;eira:concept&quot;,&quot;value&quot;:&quot;eira:ArchitectureBuildingBlock&quot;},{&quot;property&quot;:&quot;eira:iopDimension&quot;,&quot;value&quot;:&quot;Behavioral IoP&quot;},{&quot;property&quot;:&quot;eira:view&quot;,&quot;value&quot;:&quot;Technical view - application&quot;},{&quot;property&quot;:&quot;eira:viewpoint&quot;,&quot;value&quot;:&quot;Interoperability Security viewpoint&quot;}]}</ns1:properties>
