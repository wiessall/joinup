<?php

/**
 * @file
 * Functions to support theming in the Interoperable Europe theme.
 */

declare(strict_types = 1);

use Drupal\joinup_bundle_class\LogoInterface;

/**
 * Implements hook_preprocess_HOOK() for html.html.twig.
 */
function iop_preprocess_paragraph__row(array &$variables): void {
  $paragraph = $variables['elements']['#paragraph'];
  $variables['row_theme'] = $paragraph->get('row_theme')->value ?? 'light';
  if (!$paragraph->get('paragraph_row_background')->isEmpty()) {
    /** @var \Drupal\file\FileInterface $file */
    $file = $paragraph->get('paragraph_row_background')->entity;
    // @todo Is this the best way to get the background? Because normally we
    // need a style image (compressed?) but also, the image will be used for
    // large screens too. To be decided by the FE team.
    $variables['row_background'] = \Drupal::service('file_url_generator')->generateAbsoluteString($file->getFileUri());
  }
}

/**
 * Implements hook_preprocess().
 */
function iop_preprocess(array &$variables): void {
  // @todo Setup the icons for the carousels. This was copied from Ventuno.
  /** @var \Drupal\Core\Extension\ThemeHandler $themeHandler */
  $themeHandler = \Drupal::service('theme_handler');
  $ventuno = $themeHandler->getTheme('ventuno')->getPath();
  $variables['bcl_icon_path'] = base_path() . $ventuno . '/assets/icons/icons.svg';
}

/**
 * Implements hook_preprocess_HOOK() for paragraph.html.twig.
 */
function iop_preprocess_paragraph(array &$variables): void {
  $variables['#attached']['library'][] = 'iop/paragraph';
}

/**
 * Implements hook_preprocess_HOOK().
 */
function iop_preprocess_node__carousel(array &$variables): void {
  /** @var \Drupal\node\NodeInterface $node */
  $node = $variables['node'];
  if (($node instanceof LogoInterface) && $logo = $node->getLogoAsFile()) {
    $variables['logo_url'] = \Drupal::getContainer()->get('file_url_generator')->generateAbsoluteString($logo->getFileUri());
  }
}

/**
 * Implements hook_preprocess_HOOK().
 */
function iop_preprocess_rdf_entity__carousel(array &$variables): void {
  /** @var \Drupal\rdf_entity\RdfInterface $entity */
  $entity = $variables['rdf_entity'];
  if (($entity instanceof LogoInterface) && $logo = $entity->getLogoAsFile()) {
    $variables['logo_url'] = \Drupal::getContainer()->get('file_url_generator')->generateAbsoluteString($logo->getFileUri());
  }
}

/**
 * Implements hook_preprocess_HOOK() for paragraph__image.html.twig.
 */
function iop_preprocess_paragraph__image(array &$variables): void {
  $paragraph = $variables['elements']['#paragraph'];
  if (!$paragraph->get('paragraph_image_visibility')->isEmpty()) {
    foreach ($paragraph->get('paragraph_image_visibility')->getValue() as $value) {
      $variables['attributes']['class'][] = 'paragraph--image--' . $value['value'];
    }
  }
}
