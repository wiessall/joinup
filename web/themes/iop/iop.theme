<?php

/**
 * @file
 * Functions to support theming in the Interoperable Europe theme.
 */

declare(strict_types=1);

use Drupal\Core\Url;
use Drupal\custom_page\Entity\CustomPageInterface;
use Drupal\interoperable_europe\InteroperableEuropeCollectionInterface;
use Drupal\joinup_event\Entity\EventInterface;
use Drupal\joinup_news\Entity\NewsInterface;
use Drupal\node\NodeInterface;

/**
 * Implements hook_preprocess().
 */
function iop_preprocess(array &$variables): void {
  /** @var \Drupal\Core\Extension\ThemeHandler $themeHandler */
  $themeHandler = \Drupal::service('theme_handler');
  $ventuno = $themeHandler->getTheme('ventuno')->getPath();
  $variables['bcl_icon_path'] = base_path() . $ventuno . '/assets/icons/icons.svg';
}

/**
 * Implements hook_preprocess_HOOK() for paragraph.html.twig.
 */
function iop_preprocess_paragraph(array &$variables): void {
  $variables['#attached']['library'][] = 'iop/paragraph__' . $variables['paragraph']->bundle();
  $variables['attributes']['class'][] = 'paragraph--' . str_replace('_', '-', $variables['paragraph']->bundle());
}

/**
 * Implements hook_preprocess_HOOK() for paragraph__image.html.twig.
 */
function iop_preprocess_paragraph__image(array &$variables): void {
  $paragraph = $variables['elements']['#paragraph'];
  if (!$paragraph->get('paragraph_image_visibility')->isEmpty()) {
    foreach ($paragraph->get('paragraph_image_visibility')->getValue() as $value) {
      $variables['attributes']['class'][] = 'paragraph--image--' . $value['value'];
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for paragraph__content_listing.html.twig.
 */
function iop_preprocess_paragraph__content_listing(array &$variables): void {
  unset($variables['content']['paragraph_content_listing_content_listing_top']);
}

/**
 * Implements hook_preprocess_HOOK().
 */
function iop_preprocess_page(array &$variables): void {
  $route_name = \Drupal::routeMatch()->getRouteName();
  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node instanceof NodeInterface) {
    $uuid = $variables['node']->uuid();
    // News listing page.
    if ($uuid === InteroperableEuropeCollectionInterface::NEWS_LISTING) {
      $variables['#attached']['library'][] = 'iop/listing';
      $variables['node_classes'] = ['listing', 'page--news'];
      $variables['page_header']['title'] = t('News');
      $variables['page_header']['has_heading'] = TRUE;
    }
    // Events listing page.
    elseif ($uuid === InteroperableEuropeCollectionInterface::EVENT_LISTING) {
      $variables['#attached']['library'][] = 'iop/listing';
      $variables['node_classes'] = ['listing', 'page--events'];
      $variables['page_header']['title'] = t('Events');
      $variables['page_header']['has_heading'] = TRUE;
    }
    // FAQ page.
    elseif ($uuid === InteroperableEuropeCollectionInterface::FAQ) {
      $variables['#attached']['library'][] = 'iop/accordion-faq';
      $variables['node_classes'] = ['page--faq'];
      $variables['page_header']['title'] = t('FAQs');
      $variables['page_header']['has_heading'] = TRUE;
    }
    // POLICY page.
    elseif ($uuid === InteroperableEuropeCollectionInterface::POLICY) {
      $variables['node_classes'] = ['page--policy'];
      $variables['page_header']['title'] = t('Policy');
      $variables['page_header']['has_heading'] = TRUE;
    }
    // News item.
    elseif ($route_name === 'entity.node.canonical' && $node->bundle() === 'news') {
      $variables['node_classes'] = ['page--news'];
      $variables['page_header']['title'] = t('News');
    }
    // Event item.
    elseif ($route_name === 'entity.node.canonical' && $node->bundle() === 'event') {
      $variables['node_classes'] = ['page--events'];
      $variables['page_header']['title'] = t('Events');
    }
  }
}

/**
 * Implements template_preprocess_HOOK() for html.
 */
function iop_preprocess_html(array &$variables): void {
  $variables['html_attributes']->removeClass('t-ventuno')->addClass('t-iop');
}

/**
 * Implements hook_preprocess_HOOK().
 */
function iop_preprocess_node(array &$variables): void {
  if ($variables['view_mode'] === 'carousel' && !empty($variables['image'])) {
    $variables['image'] = $variables['node']->getLogoAsRenderArray([
      'label' => 'hidden',
      'type' => 'responsive_image',
      'settings' => [
        'responsive_image_style' => 'iop_carousel',
        'image_link' => 'none',
      ],
    ]);
  }

  // Disables the "Report" link for IOP.
  if (isset($variables['content']['report'])) {
    $variables['content']['report']['#access'] = FALSE;
  }

  // News listing page.
  if (!empty($variables['content']['field_news_logo'])) {
    $variables['logo'][] = $variables['content']['field_news_logo'];
  }
  // Events listing page.
  elseif (!empty($variables['content']['field_event_logo'])) {
    $variables['logo'][] = $variables['content']['field_event_logo'];
  }
}

/**
 * Implements hook_preprocess_HOOK().
 */
function iop_preprocess_node__custom_page__full(array &$variables): void {
  $node = $variables['node'];
  if (($node instanceof CustomPageInterface)
    && ($group = $node->getGroup())
    && ($landing_page = $group->getSetting('landing_page'))
    && $landing_page->getEntity()->get('landing_page')->target_id === $node->id()) {

    // For the custom page that is set as landing page, do not display the title
    // or the report link.
    unset($variables['label']);
  }
}

/**
 * Implements hook_preprocess_block().
 */
function iop_preprocess_block(array &$variables): void {
  $block_id = $variables['elements']['#id'] ?? NULL;
  if ($block_id !== 'openeuropawebtoolsetrans') {
    return;
  }

  $variables['#attached']['library'][] = 'ventuno/etrans';
}

/**
 * Implements hook_preprocess_block().
 */
function iop_preprocess_block__iope_navigation(array &$variables): void {
  $variables['base_path'] = base_path();
}

/**
 * Implements hook_preprocess_node__news__view_mode_tile().
 */
function iop_preprocess_node__news__view_mode_tile(&$variables): void {
  _iop_preprocess_news_event_tile($variables);
}

/**
 * Implements hook_preprocess_node__event__view_mode_tile().
 */
function iop_preprocess_node__event__view_mode_tile(&$variables): void {
  _iop_preprocess_news_event_tile($variables);
}

/**
 * Alters tile view mode of news and event content.
 *
 * @param array $variables
 *   Variables passed to the node template.
 */
function _iop_preprocess_news_event_tile(&$variables): void {
  $node = $variables['node'];
  // Override logo so we can control the image style without affecting also the
  // parent theme Ventuno.
  $variables['logo'] = $node->getLogoAsRenderArray([
    'label' => 'hidden',
    'type' => 'image',
    'settings' => [
      'image_style' => 'iop_news_events',
      'image_link' => 'content',
    ],
  ]);
}

/**
 * Implements hook_preprocess_page_title().
 */
function iop_preprocess_page_title(array &$variables): void {
  $entity = $variables['entity'] ?? NULL;
  $link = NULL;
  if ($entity instanceof NewsInterface || $entity instanceof EventInterface) {
    $listing = match ($entity->bundle()) {
      'news' => Drupal::service('entity.repository')->loadEntityByUuid('node', InteroperableEuropeCollectionInterface::NEWS_LISTING),
      'event' => Drupal::service('entity.repository')->loadEntityByUuid('node', InteroperableEuropeCollectionInterface::EVENT_LISTING),
    };
    $url = Url::fromRoute('entity.node.canonical', ['node' => $listing->id()]);
    $node = Drupal::request()->attributes->get('node');
    $variables['logo'] = $node->getLogoAsRenderArray([
      'label' => 'hidden',
      'type' => 'image',
      'settings' => [
        'image_style' => 'wysiwyg_full_width',
        'image_link' => 'none',
      ],
    ]);
    switch ($entity->bundle()) {
      case 'news':
        /** @var \Drupal\Core\Entity\EntityViewBuilderInterface $view_builder */
        $view_builder = \Drupal::entityTypeManager()->getViewBuilder('node');
        $field_news_headline = $view_builder->viewField($node->field_news_headline, 'default');
        $variables['title'] = $field_news_headline;
        $link = [
          '#type' => 'link',
          '#url' => $url,
          '#title' => t('more news'),
        ];
        break;

      case 'event':
        $link = [
          '#type' => 'link',
          '#url' => $url,
          '#title' => t('more events'),
        ];
        break;
    }
    $variables['url_more'] = $link;
  }
}
