{
  "name": "iop",
  "author": "European Commission",
  "license": "EUPL-1.2",
  "version": "1.0.0",
  "description": "IOP is a Drupal child theme of Ventuno for IOP Europe in Joinup.",
  "private": true,
  "scripts": {
    "watch": "watch 'npm run build' src",
    "clean:assets": "del-cli assets/*",
    "clean:scripts": "del-cli assets/js",
    "clean:styles": "del-cli assets/css",
    "eslint": "eslint src/js/",
    "build": "npm-run-all clean:scripts clean:styles build:scripts build:styles build:copy",
    "build:scripts": "cross-env bcl-builder scripts",
    "build:styles": "cross-env bcl-builder styles",
    "build:copy": "cross-env bcl-builder copy",
    "build:sprite": "cross-env bcl-builder sprite",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@openeuropa/bcl-bootstrap": "1.0.2",
    "@openeuropa/bcl-builder": "1.0.2",
    "@openeuropa/bcl-theme-default": "1.0.2",
    "@openeuropa/bcl-theme-joinup": "1.0.2",
    "cross-env": "7.0.3",
    "del-cli": "^4.0.1",
    "glob": "7.1.7",
    "npm-run-all": "4.1.5",
    "patch-package": "^6.5.0",
    "slim-select": "^1.27.1",
    "watch": "^0.13.0"
  },
  "dependencies": {
    "@glidejs/glide": "^3.5.2"
  }
}
