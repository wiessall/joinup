{#
/**
 * @file
 * FAO corporate header (SDC: fao:fao-header), FAO Design System markup
 * (.fao-header.subsite-header), styled by vendor/fao-ds. The Discover menu is
 * a Bootstrap dropdown (bootstrap.bundle.min.js).
 */
#}
<header class="fao-header subsite-header">
  <div class="container">
    <div class="row">
      <div class="header-wrapper col-12">
        <div class="fao-header-left">
          {% if logo.image %}
            <a href="{{ logo.url }}">
              <img src="{{ logo.image }}" alt="{{ logo.alt }}" class="header-fao-logo" height="40" decoding="async">
            </a>
          {% endif %}
        </div>
        <div class="fao-header-right">
          {% if menu.items %}
            <div class="dropdown discover-dropdown">
              <button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">{{ menu.button }}</button>
              <ul class="dropdown-menu dropdown-menu-end">
                {% for item in menu.items %}
                  <li><a class="dropdown-item" href="{{ item.url }}">{{ item.label }}</a></li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}
          {{ tools }}
        </div>
      </div>
    </div>
  </div>
</header>
