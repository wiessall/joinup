{#
/**
 * @file
 * Page layout: FAO corporate header, site bar (breadcrumb, site name, main
 * menu), main content with optional sidebar, FAO footer.
 *
 * Regions hold blocks placed in Block layout (Structure > Block layout > FAO).
 * The corporate header/footer are components fed by fao_preprocess_page().
 */
#}
{{ include('fao:fao-header', fao_chrome.header|default({}), false) }}

{% if page.header %}
  <div class="fao-site-header">
    <div class="container">{{ page.header }}</div>
  </div>
{% endif %}

<div class="subheader">
  <div class="container">
    {{ page.breadcrumb }}
    <p class="page-title h1 mb-2">
      <a href="{{ path('<front>') }}" class="text-reset text-decoration-none">{{ site_name }}</a>
    </p>
    {% if page.primary_nav %}
      <nav class="navbar navbar-expand-lg p-0" aria-label="{{ 'Main'|t }}">
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#fao-primary-nav" aria-controls="fao-primary-nav" aria-expanded="false" aria-label="{{ 'Toggle navigation'|t }}">
          <span class="bi bi-list" aria-hidden="true"></span>
        </button>
        <div class="collapse navbar-collapse" id="fao-primary-nav">
          {{ page.primary_nav }}
        </div>
      </nav>
    {% endif %}
  </div>
</div>

<main id="main-content" tabindex="-1">
  {% if page.full_width %}
    <div class="fao-full-width">{{ page.full_width }}</div>
  {% endif %}

  <div class="container py-4">
    {{ page.messages }}
    <div{{ create_attribute({class: [page.sidebar ? 'fao-page--with-sidebar']}) }}>
      <div class="fao-page__content">{{ page.content }}</div>
      {% if page.sidebar %}
        <aside class="fao-page__sidebar" aria-label="{{ 'Sidebar'|t }}">{{ page.sidebar }}</aside>
      {% endif %}
    </div>
  </div>
</main>

{{ include('fao:fao-footer', fao_chrome.footer|default({})|merge({site_links: page.footer}), false) }}
