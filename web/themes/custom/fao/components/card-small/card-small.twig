{#
/**
 * @file
 * Card component template.
 *
 * Available variables:
 * - variant: Card variant (default, no-border, overlay, background, background-dark)
 * - image: Object with src and alt properties
 * - category: Category text
 * - title: Card title text
 * - text: Card body text
 * - link: Link rendered
 * - card_extra: Optional slot for additional content
 */
#}

{% set border_class = variant == 'no-border' ? 'border-0' : '' %}
{% set background_class = variant == 'background' ? 'bg-gray-light' : '' %}


<div class="card d-flex align-items-center {{ variant_class }} {{ border_class }} {{ background_class }}">

  {% if media or image %}
    <div class="card-image">

      {% block card_media %}
        {% if external_link %}
          <a href="{{ external_link[0]['#url'] }}" target="_blank" rel="noopener noreferrer">
            {{ media }}
          </a>
        {% else %}
          {{ media }}
        {% endif %}
      {% endblock %}
    </div>
  {% endif %}

  <div class="text-center">
    {% if category %}
      <h6 class="title-category">{{ category }}</h6>
    {% endif %}
    {% if title %}
        <p class="small text-color-gray-medium text-center -align-center d-block"></p>
        {% if link %}
        {{link|raw}}
        {% else %}
          {{ title }}
        {% endif %}
      </p>
    {% endif %}
    {% if text %}
      <div class="card-text">{{ text|raw }}</div>
    {% endif %}
    {% block card_extra %}{% endblock %}
  </div>
</div>
