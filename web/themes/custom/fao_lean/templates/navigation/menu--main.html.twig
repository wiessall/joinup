{#
/**
 * @file
 * Main menu as a Bootstrap navbar (two levels; the second level opens as a
 * dropdown, which needs bootstrap.bundle.min.js). Place the "Main navigation"
 * block in the Primary navigation region.
 */
#}
{% import _self as menus %}
{{ menus.menu_links(items, attributes, 0) }}

{% macro menu_links(items, attributes, menu_level) %}
  {% import _self as menus %}
  {% if items %}
    {% if menu_level == 0 %}
      <ul{{ attributes.addClass('navbar-nav', 'me-auto')|without('id') }}>
        <li class="nav-item">
          <a class="nav-link" href="{{ path('<front>') }}">
            <span class="bi bi-house-fill" aria-hidden="true"></span>
            <span class="visually-hidden">{{ 'Home'|t }}</span>
          </a>
        </li>
    {% else %}
      <ul class="dropdown-menu">
    {% endif %}
    {% for item in items %}
      {% set has_dropdown = item.below and menu_level == 0 %}
      <li{{ item.attributes.addClass(menu_level ? '' : 'nav-item', has_dropdown ? 'dropdown') }}>
        {% set link_classes = [
          menu_level ? 'dropdown-item' : 'nav-link',
          item.in_active_trail ? 'active',
          has_dropdown ? 'dropdown-toggle',
        ] %}
        {% if has_dropdown %}
          {{ link(item.title, item.url, {class: link_classes, 'data-bs-toggle': 'dropdown', 'aria-expanded': 'false', role: 'button'}) }}
          {{ menus.menu_links(item.below, attributes, menu_level + 1) }}
        {% else %}
          {{ link(item.title, item.url, {class: link_classes}) }}
        {% endif %}
      </li>
    {% endfor %}
    </ul>
  {% endif %}
{% endmacro %}
