{#
/**
 * @file
 * Local tasks on every page where the horizontal tabs block is hidden
 * (joinup_core_theme_suggestions_alter()).
 *
 * Primary tasks (Edit, Settings, Moderate content…) are a three-dots
 * dropdown. Secondary tasks (the moderation hub: Content, Members,
 * Duplicates…) are a row of tabs in the page, rendered by a separate
 * "secondary only" tabs block in the content region.
 */
#}
{% if primary %}
  <div class="dropdown fao-actions">
    <button type="button" class="btn btn-outline-primary rounded-circle fao-actions__btn" data-bs-toggle="dropdown" aria-expanded="false" title="{{ 'Show options'|t }}">
      <span class="bi bi-three-dots" aria-hidden="true"></span>
      <span class="visually-hidden">{{ 'Primary tabs'|t }}</span>
    </button>
    <ul class="dropdown-menu dropdown-menu-end">{{ primary }}</ul>
  </div>
{% endif %}
{% if secondary %}
  <h2 class="visually-hidden">{{ 'Secondary tabs'|t }}</h2>
  <ul class="nav nav-tabs mb-3">{{ secondary }}</ul>
{% endif %}
