{#
/**
 * @file
 * Themeing for the search_list_item view mode of eif rdf entities.
 *
 * Available variables:
 * - eif_title: The eif title.
 * - spdx_title: The spdx eif title.
 * - spdx_url: The spdx eif url.
 * - spdx_eif_id: The spdx eif code.
 * - spdx_eif_id_plain: The plain spdx eif code.
 * - legal_categories: a concatenated string of lowercase characters of the legal type categories related to the
 * eif.
 * - category_lists: An array of variables with details on the category lists. Contains variables:
 * -- title: The title of the parent.
 * -- class: An array of list items.
 * -- items: A list of items for each category. Contains variables:
 * --- title: The label of the item.
 * --- description: the description of the item.
 */
#}
{%
  set classes = [
    'eif-tile',
    'mdl-cell',
    'mdl-cell--12-col',
    'mdl-cell--12-col-wide',
  ]
%}
<div class="listing listing--grid">
  <div class="row">
    <div class="mdl-grid">
      <div {{ attributes.addClass(classes) }} data-eif-category="{{ eif_categories }}">
        {{ title_prefix }}
        <div class="listing__card listing__card--inline-container mdl-card">
          <div class="listing__inner-tile listing__inner-tile--shifted">
            <div class="listing__field">
              <h2 class="listing__title licence-tile__title">{{ label }}</h2>
            </div>
          </div>
        </div>
        {{ title_suffix }}
        <div class="listing__card listing__card--inline-container mdl-card">
          <div class="listing__inner-tile listing__inner-tile--wider">
            {% for category_list in category_lists  %}
              <div class="listing__field">
                <div class="eif-tile__line {{ category_list.class }}">
                  <div class="eif-tile__label-wrapper">
                    <span class="eif-tile__label">
                      {{ category_list.title }}
                    </span>
                  </div>
                  <div class="eif-tile__value">
                    {% for item in category_list.items %}
                      <span title="{{ item.description }}">{{ item.title }}</span>{% if loop.last == false %}, {% endif %}
                    {% endfor %}
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
          <div class="listing__metadata listing__metadata--eif">
            <p>{{ 'eif comment'|t }}:</p>
            <div class="listing__field">
              {{ content.field_eif_description }}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
