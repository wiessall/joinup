{#
/**
 * @file
 * Theme override to display primary and secondary local tasks.
 *
 * Available variables:
 * - primary: HTML list items representing primary tasks.
 * - secondary: HTML list items representing primary tasks.
 *
 * Each item in these variables (primary and secondary) can be individually
 * themed in menu-local-task.html.twig.
 */
#}
{% if primary %}
  {# Menu visible on desktop and tablet #}
  <div class="circle-menu circle-menu--tablet">
    <button href="#" id="local-tasks-primary--tablet" title="{{ 'Primary tabs'|t }}"  class="circle-menu__button mdl-button mdl-js-button mdl-button--fab mdl-js-ripple-effect">
      <span class="icon icon--dots"></span>
    </button>

    <ul class="circle-menu__dropdown mdl-menu mdl-menu--bottom-right mdl-js-menu" for="local-tasks-primary--tablet">
      {{ primary }}
    </ul>
  </div>
  {# Menu visible on mobile #}
  <div class="circle-menu circle-menu--mobile">
    <button href="#" id="local-tasks-primary--mobile" class="circle-menu__button mdl-button mdl-js-button mdl-button--fab mdl-js-ripple-effect">
      <span class="icon icon--dots"></span>
    </button>

    <ul class="circle-menu__dropdown mdl-menu mdl-menu--top-right mdl-js-menu" for="local-tasks-primary--mobile">
      {{ primary }}
    </ul>
  </div>
{% endif %}
{% if secondary %}
  <button id="local-tasks-secondary" class="mdl-button mdl-js-button mdl-button--icon">
    <span class="icon icon--dots"></span>
  </button>
  <h2 class="visually-hidden">{{ 'Secondary tabs'|t }}</h2>
  <ul class="mdl-menu mdl-menu--bottom-right mdl-js-menu mdl-js-ripple-effect" for="local-tasks-secondary">{{ secondary }}</ul>
{% endif %}
