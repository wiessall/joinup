{{ attach_library('ventuno/bootstrap-base') }}
{{ attach_library('ventuno/footer') }}
<div class="bs-wrapper">
  <footer role="contentinfo" class="page__footer">
    <div class="container text-light">
      <div class="row py-4 py-lg-5">
        <!--Joinup logo-->
        <div class="col-md-12 col-lg-3 column-logo">
          <p class="joinup-logo"><a href="{{ base_path }}" class="joinup-logo-white mb-3"><span class="visually-hidden">Joinup</span></a></p>
          <p class="joinup-version"><a href="{{ version_url }}">{{ version }}</a></p>
        </div>

        <div id="block-aboutus" class="block block-system block-system-menu-blockfooter-about-us col-md-3 col-lg-2 about-us-menu">
          <h3>About us</h3>
          <ul class="list-unstyled">
            <li>
              <span>Joinup</span>
            </li>
            <li>
              <a href="{{ base_path }}collection/joinup/about">What is Joinup</a>
            </li>
            <li>
              <a href="{{ base_path }}collection/eupl/solution/joinup-licensing-assistant/jla-find-and-compare-software-licenses">Joinup Licensing Assistant</a>
            </li>
            <li>
              <a href="{{ base_path }}collection/nifo-national-interoperability-framework-observatory/solution/eif-toolbox/eif-toolbox">EIF Toolbox</a>
            </li>
            <li>
              <span>Interoperable Europe</span>
            </li>
            <li>
              <a href="{{ base_path }}collection/interoperable-europe/interoperable-europe">What is Interoperable Europe</a>
            </li>
          </ul>
        </div>

        <div id="block-helpandsupport" class="block block-system block-system-menu-blockfooter-help-and-support col-md-3 col-lg-2 help-and-support-menu">
          <h3>Help and support</h3>
          <ul class="list-unstyled">
            {% if tour_available %}
              <li>
                <a href="" data-drupal-tour-link="" class="js-tour-start-button">Take a tour</a>
              </li>
            {% endif %}
            <li>
              <a href="{{ contact_form_link }}" data-drupal-link-system-path="contact">Contact Joinup Support</a>
            </li>
            <li>
              <a href="{{ base_path }}collection/joinup/federation-solutions">Federation of solutions</a>
            </li>
            <li>
              <a href="{{ base_path }}joinup/legal-notice" data-drupal-link-system-path="legal/document/legal_notice">Legal notice</a>
            </li>
            <li>
              <a href="{{ base_path }}collection/joinup/specific-privacy-statement">Privacy statement</a>
            </li>
            <li>
              <a href="{{ base_path }}collection/joinup/how-video-tutorials">How-to &amp; video tutorials</a></li>
            <li>
              <a href="{{ base_path }}collection/joinup/faq">FAQ</a>
            </li>
          </ul>
        </div>

        <div id="block-europeancommission" class="block block-system block-system-menu-blockfooter-european-commission col-md-3 col-lg-3 european-commission-menu">
          <h3>European Commission</h3>
          <ul class="list-unstyled">
            <li>
              <a href="https://ec.europa.eu/info/about-commissions-new-web-presence_en">About the Commission&#039;s new web presence</a>
            </li>
            <li>
              <a href="https://ec.europa.eu/info/resources-partners_en">Resources for partners</a>
            </li>
            <li>
              <a href="https://ec.europa.eu/info/cookies_en">Cookies</a>
            </li>
            <li>
              <a href="https://ec.europa.eu/info/contact_en">Contact European Commission</a>
            </li>
            <li>
              <a href="https://ec.europa.eu/info/europa-analytics_en">Europa Analytics</a>
            </li>
          </ul>
        </div>

        <div class="col-md-3 col-lg-2 column-follow-us">
          <div id="block-followus" class="block block-system block-system-menu-blockfooter-follow-us follow-us-menu">
            <h3>Follow us</h3>
            <ul class="list-unstyled">
              <li>
                <span>Joinup</span>
              </li>
              <li>
                <a href="http://ec.europa.eu/newsroom/joinup/subscription-quick-generic-form-fullpage.cfm?service_id=877">Newsletter subscription</a>
              </li>
              <li>
                <a href="https://ec.europa.eu/newsroom/joinup/newsletter-archives/view/service/877">Newsletter archive</a>
              </li>
              <li>
                <a href="https://twitter.com/joinup_eu">Twitter</a>
              </li>
              <li>
                <a href="https://www.linkedin.com/groups/2600644/">LinkedIn</a>
              </li>
              <li>
                <span>Interoperable Europe</span>
              </li>
              <li>
                <a href="https://ec.europa.eu/newsroom/informatics/newsletter-archives/view/service/1115">Newsletter archive</a>
              </li>
              <li>
                <a href="https://ec.europa.eu/newsroom/informatics/user-subscriptions/1115/create">Newsletter subscription</a>
              </li>
              <li>
                <a href="https://www.linkedin.com/in/interoperableeurope/">LinkedIn</a>
              </li>
              <li>
                <a href="https://twitter.com/InteroperableEU">Twitter</a>
              </li>
              <li>
                <a href="https://www.youtube.com/c/interoperableeurope">Youtube</a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </footer>
</div>
