{#
/**
 * @file
 * Theme override to display a region.
 *
 * Available variables:
 * - content: The content for this region, typically blocks.
 * - attributes: HTML attributes for the region div.
 * - region: The name of the region variable as defined in the theme's
 *   .info.yml file.
 *
 * @see template_preprocess_region()
 */
#}
{{ attach_library('ventuno/bootstrap-base') }}
{{ attach_library('ventuno/navbar') }}
<div class="bs-wrapper">
  <div class="bcl-header bcl-header--ec">
    <nav class="w-100 shadow-sm navbar navbar-expand-lg navbar-light" aria-label="Top Navigation">
      <div class="container">
        <a class="navbar-brand" href="https://ec.europa.eu/info/index_en">
          <img src="{{ path('<front>') }}themes/ventuno/assets/images/logo-ec--en.svg" alt="European Commission logo"/>
        </a>
      </div>
    </nav>
  </div>
  <header role="banner" class="region-header">
    {% set items = logged_in ? [{
      breakpoint: "lg",
      classes: ["order-1"],
      id: "landing-pages",
      icon: { name: "justify" },
      label: "Toggle menu"|t,
      links: landing_page_links,
    }] : [] %}
    {% set items = items|merge([{
      breakpoint: logged_in ? "" : "lg",
      id: logged_in ? "account" : "navbar-toggler",
      icon: {
        name: logged_in ? "person-circle" : "justify",
      },
      label: logged_in ? user_name : "Toggle menu"|t,
      links: logged_in ? profile_links : anonymous_links,
    },{
      type: "search",
      breakpoint: "",
      classes: ["order-1 dropdown-search"],
      id: "search",
      icon: {
        name: "search",
      },
      label: "Toggle search box"|t,
      links: search,
    }]) %}
    {% include directory ~ '/../ventuno/templates/navigation/navbar.html.twig' with {
      brand: {
        src: path('<front>') ~ "themes/ventuno/assets/images/logo.svg",
        alt: "Joinup logo"|t,
        link: path('<front>'),
      },
      collapse_id: "main-navbar",
      list_id: "main-navbar-list",
      items: items,
      search: content,
    } %}
  </header>
</div>
