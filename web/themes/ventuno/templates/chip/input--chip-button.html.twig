{#
/**
 * @file
 * Theme override for the submit button of a chip.
 *
 * Available variables:
 * - attributes: A list of HTML attributes for the input element.
 * - children: Optional additional rendered elements.
 *
 * @see template_preprocess_input()
 *
 * @ingroup themeable
 */
#}
<button {{ attributes.addClass('chip--close icon--close') }} aria-hidden="true"><svg class="bi icon--xs"><use xlink:href="/web/themes/ventuno/assets/icons/icons.svg#x-circle-fill"></use></svg>{{ children }}</button>
