{#
/**
 * @file
 * Default theme implementation of link that are accompanied with an icon.
 *
 * Available variables:
 * - attributes: An array of attributes to apply to the link.
 * - icon: The name of the icon. This should be one of the icons listed in the
 *   `_icon.scss` file.
 * - title: The link title.
 * - url: The link URL.
 *
 * @ingroup themeable
 */
#}
{%
  set classes = [
    'btn',
    'btn-md',
    'btn-outline-brand'
  ]
%}
{% spaceless %}
<div class="d-flex justify-content-end">
  <a href="{{ url }}"{{ attributes.addClass(classes) }}>
    {{ title }}
    <svg class="ms-2 bi icon--fluid">
      <use xlink:href="{{ bcl_icon_path }}#{{ icon }}"></use>
    </svg>
  </a>
</div>
{% endspaceless %}
