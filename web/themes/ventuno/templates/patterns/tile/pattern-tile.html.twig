{#
/**
 * @file
 * Tile pattern.
 */
#}
{% apply spaceless %}

  {# Parameters:
    - featured (boolean) (default: false)
    - image (object) (default: {})
    - url (string) (default: '')
    - title_prefix ()
    - title (string) (default: '')
    - title_suffix ()
    - text (string) (default: '')
    - subtext (string) (default: '')
    - metadata (array of objects) (default: [])
  #}

  {% set _featured = featured|default(false) %}
  {% set _image = image|default({}) %}
  {% set _url = url|default('') %}
  {% set _title_prefix = title_prefix|default('') %}
  {% set _title = title|default('') %}
  {% set _title_suffix = title_suffix|default('') %}
  {% set _text = text|default('') %}
  {% set _subtext = subtext|default('') %}
  {% set _metadata = metadata|default([]) %}

  {% set attributes = create_attribute() %}
  {% set _classes = [
    'card',
    'card--tile',
    'h-100',
    'mb-3',
    _featured ? 'bg-secondary',
  ] %}
  {% if _image is empty %}
    {% set _image %}
      <a href="{{ _url }}" class="d-block">
        <svg class="bi img-fluid{{ _featured ? ' text-primary' : ' text-secondary' }}"><use xlink:href="{{ bcl_icon_path }}#{{ _metadata|last.icon }}"></use></svg>
      </a>
    {% endset %}
  {% endif %}

  {{ attach_library('ventuno/card') }}
  <div class="col">
    <article{{ attributes.addClass(_classes) }}>
      {% if _text is empty %}
        <div class="card-header border-0 bg-transparent">
          <figure class="d-flex justify-content-center mb-0">
            {{ _image }}
          </figure>
        </div>
      {% endif %}
      <div class="card-body">
        {{ _title_prefix }}
        <h1 class="card-title fs-6">
          <a class="text-primary" href="{{ _url }}">
            {{ _title }}
          </a>
        </h1>
        {{ _title_suffix }}
        {% if _text is not empty %}
          <p class="card-text">
            {{ _text }}
          </p>
        {% endif %}
        {% if _subtext is not empty %}
          <div class="mt-2 fs-sm">
            {{ _subtext }}
          </div>
        {% endif %}
      </div>
      <div data-drupal-card-stats class="card-footer border-0 bg-transparent fs-sm text-muted d-flex align-items-center justify-content-end">
        {% for data in metadata %}
          <span{% if not loop.first %} class="ms-3"{% endif %}>
            {% if data.label is defined and data.label is not empty %}
              {{ data.label }}
            {% endif %}
            {% if data.icon is defined and data.icon is not empty %}
              <svg class="bi icon--xs">
                <use xlink:href="{{ bcl_icon_path }}#{{ data.icon }}"></use>
              </svg>
            {% endif %}
          </span>
        {% endfor %}
      </div>
    </article>
  </div>
{% endapply %}
