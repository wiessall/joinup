{#
/**
 * @file
 * Tile pattern.
 */
#}
{# Parameters:
    - horizontal (boolean) (default: false)
    - attributes (object) (default: {}})
    - image (object) (default: {})
    - url (string) (default: '')
    - date (string) (default: '')
    - info (object) (default: {})
    - title_prefix ()
    - label (string) (default: '')
    - title_suffix ()
    - text (string) (default: '')
    - action (object) (default: {})
    - badges (array) (default: [])
    - user_badges (array) (default: [])
    - extra_data (array of objects) (default: [])
    - bundle (object) (default: {})
    - indicators (array) (default: [])
#}

{% set _horizontal = horizontal|default(false) %}
{% set _attributes = attributes|default({}) %}
{% set _image = image|default({}) %}
{% set _url = url|default('') %}
{% set _highlighted = highlighted|default({}) %}
{% set _info = info|default('') %}
{% set _title_prefix = title_prefix|default('') %}
{% set _label = label|default('') %}
{% set _title_suffix = title_suffix|default('') %}
{% set _text = text|default({}) %}
{% set _action = action|default({}) %}
{% set _badges = badges|default([]) %}
{% set _user_badges = user_badges|default([]) %}
{% set _extra_data = extra_data|default([]) %}
{% set _bundle = bundle|default({}) %}
{% set _indicators = indicators|default([]) %}

{{ attach_library('ventuno/tile') }}

{% if _attributes is empty %}
  {% set _attributes = create_attribute() %}
{% endif %}
{% set _classes = [
  'tile',
  'rounded',
  'shadow-hover',
  _horizontal ? 'tile--horizontal',
  'd-flex',
  'mb-3',
] %}
{% if _image is empty %}
  {% set _image %}
    <div class="tile__default-img h-100 w-100 bg-secondary d-flex flex-column align-items-center justify-content-center position-relative">
      <svg class="tile__default-icon position-relative bi img-fluid">
        <use xlink:href="{{ bcl_icon_path }}#{{ _bundle.icon }}"></use>
      </svg>
    </div>
  {% endset %}
{% endif %}

<div class="col">
  <article{{ _attributes.addClass(_classes) }}>
    {{- _title_prefix -}}
    {{- _title_suffix -}}
    <a class="tile__link position-absolute top-0 end-0 bottom-0 start-0" href="{{ _url }}" title="{{ _label|render|striptags|trim|raw }}"></a>
    <figure class="tile__figure mb-0">
      {{- _image -}}
    </figure>
    <div class="tile__body d-flex flex-column{% if _highlighted is not empty %} position-relative{% endif %}">
      {%- if _highlighted.text is not empty -%}
        <div class="tile__standout-info position-absolute z-1 d-flex align-items-center text-end bg-brand rounded text-white fw-bold fs-sm px-2 py-1">
          {%- if _highlighted.icon is not empty -%}
            <svg class="tile__standout-info-icon bi icon--xs me-1">
              <use xlink:href="{{ bcl_icon_path }}#{{ _highlighted.icon }}"></use>
            </svg>
          {%- endif -%}
          {{- _highlighted.text -}}
        </div>
      {%- endif -%}
      <div>
        {%- if _info -%}
          <div class="fs-sm text-dark d-flex align-items-center justify-content-start my-2">
            <svg class="tile__info-icon bi icon--xs me-1">
              <use xlink:href="{{ bcl_icon_path }}#{{ _info.icon }}"></use>
            </svg>
            <span class="tile__info-text tile__action">{{- _info.label -}}</span>
          </div>
        {%- endif -%}
        <h3 class="tile__title h5 text-primary fw-bold my-0">
          {{- _label -}}
          {%- if _user_badges is not empty -%}
            <span class="user-badges ms-1">{{ _user_badges }}</span>
          {%- endif -%}
        </h3>
        {%- if _text is not empty -%}
          <div class="tile__text text-dark fs-sm my-1">{{- _text -}}</div>
        {%- endif -%}
        {%- if _extra_data.submitter is not empty -%}
          <div class="tile__submitter">
           {{ _extra_data.submitter }}
          </div>
        {%- endif -%}
        {%- if _action -%}
          <div class="tile__action">
            {{- _action -}}
          </div>
        {%- endif -%}
      </div>
      {%- if _badges is not empty and _badges is iterable -%}
        <div class="my-2">
          {{- attach_library('ventuno/badge') -}}
          {%- for _badge in _badges -%}
            {{- include('@oe-bcl/badge', {
              label: _badge.label,
              background: 'light',
              rounded_pill: true,
              attributes: create_attribute().addClass(['fs-sm', 'me-1', 'mb-1']),
            }, false) -}}
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- if _indicators is not empty and _indicators is iterable -%}
        <div class="mt-2 d-flex flex-wrap">
          {%- for _indicator in _indicators -%}
            {{- _indicator -}}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    <div class="tile__footer tile__action p-3">
      <div class="fs-xs text-muted d-flex flex-wrap align-items-center justify-content-between">
        <div data-joinup-card-stats class="d-flex align-items-center">
          {%- for key, data in _extra_data -%}
            {%- if key != 'flag_interoperability' -%}
              <span class="d-flex align-items-center me-2">
                {%- if data.icon is defined and data.icon is not empty -%}
                  <svg class="bi icon--xs me-1">
                    <use xlink:href="{{ bcl_icon_path }}#{{ data.icon }}"></use>
                  </svg>
                {%- endif -%}
                {%- if data.label is defined and data.label is not empty -%}
                  {{- data.label -}}
                {%- endif -%}
              </span>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="d-flex flex-wrap">
          {%- if _extra_data['flag_interoperability'] is defined and _extra_data['flag_interoperability'] is not empty -%}
            <span class="d-flex align-items-center me-2">
              {%- if _extra_data['flag_interoperability'].icon is defined and _extra_data['flag_interoperability'].icon is not empty -%}
                <svg class="bi icon--xs me-1">
                  <use xlink:href="{{ bcl_icon_path }}#{{ _extra_data['flag_interoperability'].icon }}"></use>
                </svg>
              {%- endif -%}
              {%- if _extra_data['flag_interoperability'].label is defined and _extra_data['flag_interoperability'].label is not empty -%}
                {{- _extra_data['flag_interoperability'].label -}}
              {%- endif -%}
            </span>
          {%- endif -%}
          <span class="d-flex align-items-center me-2">
            <div class="tile__bundle-icon d-flex align-items-center justify-content-center rounded-pill me-1">
              <svg class="bi icon--xs text-warning">
                <use xlink:href="{{ bcl_icon_path }}#{{ _bundle.icon }}"></use>
              </svg>
            </div>
            {{- _bundle.label -}}
          </span>
        </div>
      </div>
    </div>
  </article>
</div>
