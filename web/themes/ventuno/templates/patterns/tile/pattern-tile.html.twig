{#
/**
 * @file
 * Tile pattern.
 */
#}
{% apply spaceless %}

  {# Parameters:
    - featured (boolean) (default: false)
    - image (object) (default: {})
    - url (string) (default: '')
    - title_prefix ()
    - title (string) (default: '')
    - title_suffix ()
    - text (string) (default: '')
    - metadata (array of objects) (default: [])
  #}

  {% set _featured = featured|default(false) %}
  {% set _image = image|default({}) %}
  {% set _url = url|default('') %}
  {% set _title_prefix = title_prefix|default('') %}
  {% set _title = title|default('') %}
  {% set _title_suffix = title_suffix|default('') %}
  {% set _text = text|default('') %}
  {% set _metadata = metadata|default([]) %}

  {% set attributes = create_attribute() %}
  {% set _classes = [
    'card',
    'h-100',
    _featured ? 'bg-secondary',
  ] %}
  {% if _image is empty %}
    {% set _image %}
      <a href="{{ _url }}">
        <figure class="w-100 py-3 bg-secondary">
          <svg class="bi img-fluid text-white">
            <use xlink:href="{{ bcl_icon_path }}#{{ _metadata|last.icon }}"></use></svg>
        </figure>
      </a>
    {% endset %}
  {% endif %}

  {{ attach_library('ventuno/card') }}
  <div class="col-12 col-sm-6 col-lg-4 col-xl-3 mb-4">
    <article{{ attributes.addClass(_classes) }}>
      {{ _title_prefix }}
      {{ _image }}
      <div class="card-body">
        <h1 class="card-title fs-6">
          <a class="text-primary" href="{{ _url }}">
            {{ _title }}
          </a>
        </h1>
        {% if _text is not empty %}
          <p class="card-text">
            {{ _text }}
          </p>
        {% endif %}
      </div>
      {% if metadata is not empty %}
        <div class="card-footer border-0 bg-transparent fs-sm text-muted d-flex align-items-center justify-content-end">
          {% for data in metadata %}
            <span{% if not loop.last %} class="me-3"{% endif %}>
              {% if data.label is defined and data.label is not empty %}
                {{ data.label }}
              {% endif %}
              {% if data.icon is defined and data.icon is not empty %}
                <svg class="bi icon--xs">
                  <use xlink:href="{{ bcl_icon_path }}#{{ data.icon }}"></use>
                </svg>
              {% endif %}
            </span>
          {% endfor %}
        </div>
      {% endif %}
      {{ _title_suffix }}
    </article>
  </div>
{% endapply %}
