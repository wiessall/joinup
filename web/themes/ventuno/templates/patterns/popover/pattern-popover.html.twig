{#
/**
 * @file
 * Popover pattern.
 */
#}
{# Parameters:
    - trigger_text (string) (default: '')
    - content (string) (default: '')
    - placement (string) (default: 'bottom')
    - trigger_classes (array) (default: [])
    - popover_classes (array) (default: [])
    - trigger_attributes (array) (default: [])
    - popover_attributes (array) (default: [])
    - show_close_button (boolean) (default: false)
#}

{% set _trigger_text = trigger_text|default('') %}
{% set _content = content|default('') %}
{% set _placement = placement|default('bottom') %}
{% set _trigger_classes = trigger_classes|default([]) %}
{% set _popover_classes = popover_classes|default([]) %}
{% set _trigger_attributes = trigger_attributes|default([]) %}
{% set _popover_attributes = popover_attributes|default([]) %}
{% set _show_close_button = show_close_button|default(false) %}

{% set popover_id = 'ventuno-popover-' ~ random() %}
{% set trigger_class_list = ['ventuno-popover__trigger']|merge(_trigger_classes) %}
{% set popover_class_list = ['ventuno-popover']|merge(_popover_classes) %}

<div class="{{ popover_class_list|join(' ') }}"{{ _popover_attributes ? create_attribute(_popover_attributes) }}>
  <button
    type="button"
    class="{{ trigger_class_list|join(' ') }}"
    data-bs-toggle="popover"
    data-bs-placement="{{ _placement }}"
    data-bs-html="true"
    data-popover-target="{{ popover_id }}"
    aria-label="{{ _trigger_text }}"
    {{ _trigger_attributes ? create_attribute(_trigger_attributes) }}
  >
    {% if _trigger_text %}
      <span class="ventuno-popover__trigger-text">{{ _trigger_text }}</span>
    {% endif %}
  </button>

  <div id="{{ popover_id }}" class="ventuno-popover__content visually-hidden">
    {% if _show_close_button %}
      <div class="ventuno-popover__close-wrapper">
        <a href="#" class="ventuno-popover__close close" onclick="return false;">&times;</a>
      </div>
    {% endif %}
    {{ _content }}
  </div>
</div>
