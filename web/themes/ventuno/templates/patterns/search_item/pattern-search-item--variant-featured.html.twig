{#
/**
 * @file
 * Search item pattern featured variant.
 */
#}
{% apply spaceless %}

  {# Parameters:
    - image (object) (default: {})
    - badges (array of badge object) (default: [])
    - title (string) (default: '')
    - text (string) (default: '')
    - metadata (string) (default: '')
  #}

  {% set _image = image|default({}) %}
  {% set _badges = badges|default([]) %}
  {% set _title = title|default('') %}
  {% set _text = text|default('') %}
  {% set _metadata = metadata|default('') %}

  <article class="border-0 border-bottom pb-3 mb-3 card tile">
    <div class="row g-1">
      <div class="col-12 col-md-2">
        {{ _image }}
      </div>
      <div class="col-12 col-md-10">
        {%- if _badges is not empty and _badges is iterable -%}
          <div class="card-header border-0 bg-transparent p-0 px-md-3">
            {% for _badge in _badges %}
              {% include '@oe-bcl/badge' with _badge only %}
            {% endfor %}
          </div>
        {%- endif -%}
        <div class="card-body p-0 px-md-3">
          <h1 class="card-title">
            {{ title }}
          </h1>
          <p class="card-text">
            {{ text }}
          </p>
          {% if metadata is not empty %}
            <p>
              {{ metadata }}
            </p>
          {% endif %}
        </div>
      </div>
    </div>
  </article>
{% endapply %}
