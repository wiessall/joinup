{#
/**
 * @file
 * Default implementation of displaying a licence comparer cell content.
 *
 * Available variables:
 * - spdx_id: The SPDX ID.
 * - legal_category: The legal category
 * - legal_type: The legal type.
 * - checked: Whether the rule is applied.
 */
#}
{% if checked %}
  <span class="visually-hidden">
    {% if (legal_category == 'Can' or legal_category == 'Must' or legal_category == 'Cannot') %}
      {{ spdx_id }} {{ legal_category|lower }} {{ legal_type|lower }}.
    {% elseif legal_category == 'Compatible' %}
      {{ spdx_id }} is {{ legal_category|lower }} with {{ legal_type|lower }}.
    {% elseif (legal_category == 'Law' or legal_category == 'Support') %}
      {{ spdx_id }}'s {{ legal_category|lower }} is {{ legal_type }}.
    {% endif %}
  </span>
  <svg class="bi icon--s text-success">
    <use xlink:href="{{ bcl_icon_path }}#check-circle-fill"></use>
  </svg>
{% else %}
  <span class="visually-hidden">
    {% if (legal_category == 'Can' or legal_category == 'Must' or legal_category == 'Cannot') %}
      {{ spdx_id }} {{ legal_category|lower }} not {{ legal_type|lower }}.
    {% elseif legal_category == 'Compatible' %}
      {{ spdx_id }} is not {{ legal_category|lower }} with {{ legal_type|lower }}.
    {% elseif (legal_category == 'Law' or legal_category == 'Support') %}
      {{ spdx_id }}'s {{ legal_category|lower }} is not {{ legal_type }}.
    {% endif %}
  </span>
{% endif %}
