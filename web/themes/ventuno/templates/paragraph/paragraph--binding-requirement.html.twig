{#
/**
 * @file
 * Template for binding_requirement with top panel + collapsible details,
 * wrapped in a Bootstrap container.
 */
#}

  {% set classes = [
    'paragraph',
    'paragraph--' ~ paragraph.bundle|clean_class,
    'card',
    'border',
    'shadow-sm',
    'mb-3',
    'p-3',
  ] %}
  {% block paragraph %}
    <div{{ attributes.addClass(classes) }}>
      <div class="card-body pb-2">
        {{ content }}
      </div>
    </div>

  {% endblock %}
