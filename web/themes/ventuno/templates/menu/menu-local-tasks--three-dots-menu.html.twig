{#
/**
 * @file
 * Theme override to display primary and secondary local tasks.
 *
 * Available variables:
 * - primary: HTML list items representing primary tasks.
 * - secondary: HTML list items representing primary tasks.
 *
 * Each item in these variables (primary and secondary) can be individually
 * themed in menu-local-task.html.twig.
 *
 * @see joinup_core_theme_suggestions_alter()
 *
 * @ingroup themeable
 */
#}
{{ attach_library('ventuno/three-dots-menu') }}
{% if primary %}
  <div class="three-dots-menu three-dots-menu--primary dropdown">
    <button aria-label="{{ 'Show primary options'|t }}" id="local-tasks-primary" class="btn text-light p-0 rounded-pill three-dots-menu__button dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
      <svg class="bi icon--m">
        <use xlink:href="{{ bcl_icon_path }}#three-dots-vertical"></use>
      </svg>
    </button>
    <div class="dropdown-menu dropdown-menu-end px-3" aria-labelledby="local-tasks-primary">
      <h2 class="visually-hidden">{{ 'Primary tabs'|t }}</h2>
      {{ pattern('navigation', {
        'variant': 'pills',
        'orientation': 'vertical',
        'items': primary,
      }) }}
    </div>
  </div>
{% endif %}
{% if secondary %}
  <div class="three-dots-menu three-dots-menu--secondary dropdown">
    <button aria-label="{{ 'Show secondary options'|t }}" id="local-tasks-secondary" class="btn btn-light p-0 rounded-pill three-dots-menu__button dropdown-toggle">
      <svg class="bi icon--m">
        <use xlink:href="{{ bcl_icon_path }}#three-dots-vertical"></use>
      </svg>
    </button>
    <div class="dropdown-menu dropdown-menu-end px-3" aria-labelledby="local-tasks-secondary">
      <h2 class="visually-hidden">{{ 'Secondary tabs'|t }}</h2>
      {{ pattern('navigation', {
        'variant': 'pills',
        'orientation': 'vertical',
        'items': secondary,
      }) }}
    </div>
  </div>
{% endif %}
