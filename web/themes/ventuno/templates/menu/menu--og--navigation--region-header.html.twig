{% import _self as menus %}

{{ attach_library('ventuno/menu--og--navigation') }}
{{ attach_library('ventuno/duplicate-id-fixer') }}

{{ menus.menu_links(items, attributes, 0) }}

{% macro menu_links(items, attributes, menu_level) %}
  {% import _self as menus %}

  {%
    set attributes = menu_level == 0
      ? attributes.addClass('menu--og--navigation', 'bg-light')
      : create_attribute()
  %}
  {%
    set next_level_items = {}
  %}

  {% if items %}
    {% if menu_level == 0 %}
      <div{{ attributes }}>
      <div class="container">
      <nav aria-label="{{ 'Secondary navigation'|t }}">
    {% endif %}

    <ul class="nav">
    {% for item in items %}
      {%
        set classes = [
          'nav-link',
          item.in_active_trail ? 'is-active',
        ]
      %}
      <li class="nav-item">
        <a{{ item.attributes|without(href).setAttribute('title', item.title).addClass(classes) }} href="{{ item.url }}">{{ item.title }}</a>
        {% if item.trigger %}
          {{ item.trigger.title }}
        {% endif %}

        {% if item.below %}
          {% set next_level_items = next_level_items|merge([item.below]) %}
        {% endif %}
      </li>
    {% endfor %}
    </ul>

    {% for next_level in next_level_items %}
      {{ menus.menu_links(next_level, attributes, menu_level + 1) }}
    {% endfor %}

    {% if menu_level == 0 %}
      </nav>
      </div>
      </div>
    {% endif %}

  {% endif %}
{% endmacro %}
