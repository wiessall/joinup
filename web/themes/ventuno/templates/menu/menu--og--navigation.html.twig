{#
/**
 * @file
 * Template for a menu.
 *
 * Available variables:
 * - pattern_items:  A nested list of menu items. Each menu item contains:
 *   - label: The menu link label.
 *   - path: The path corresponding to the menu item.
 *   - attributes: HTML attributes for the menu item.
 */
#}
{{ attach_library('ventuno/dropdown') }}
{{ attach_library('ventuno/menu--og--navigation') }}
{% set menu = pattern('navigation', {
    'variant': 'pills',
    'orientation': 'vertical',
    'items': pattern_items,
  })
%}
<div class="dropdown menu--og--navigation">
  {{ pattern('button', {
    label: 'Toggle menu'|t,
    variant: 'primary',
    outline: true,
    size: 'md',
    type: 'button',
    icon: 'justify',
    attributes: create_attribute()
      .addClass(['d-lg-none', 'w-100'])
      .setAttribute('data-bs-toggle', 'dropdown')
      .setAttribute('id', 'dropdownMenuButton')
      .setAttribute('aria-expanded', 'false'),
  }) }}
  <div class="dropdown-menu menu--og--navigation__menu" aria-labelledby="dropdownMenuButton">
    {{ menu }}
  </div>
</div>
