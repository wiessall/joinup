{#
/**
 * @file
 * Template for a menu.
 *
 * Available variables:
 * - items:  A nested list of menu items. Each menu item contains:
 *   - label: The menu link label.
 *   - path: The path corresponding to the menu item.
 *   - attributes: HTML attributes for the menu item.
 */
#}
{{ attach_library('ventuno/menu--og--navigation') }}

{% for item in items %}
  {% set item %}
    {{ item.attributes.setAttribute('title', item.title) }}
  {% endset %}
{% endfor %}

{% if items|length < 6 %}
  {% set menu = pattern('navigation', {
      'variant': 'tabs',
      'orientation': 'horizontal',
      'items': items,
      attributes: create_attribute()
        .addClass('pe-4')
    })
  %}
  <div class="menu--og--navigation">
    <div class="menu--og--navigation__menu">
      <div class="container">
        {{ menu }}
      </div>
    </div>
  </div>
{% else %}
  {% set items_to_show = items|slice(0, 5) %}
  {% set items_to_hide = items|slice(5) %}
  {% set show_more_button %}
    {{ pattern('button', {
      label: 'See more'|t,
      variant: 'link',
      outline: false,
      size: 'md',
      type: 'button',
      icon: 'chevron-down',
      attributes: create_attribute()
        .addClass('menu--og--navigation__show-more-btn')
        .setAttribute('data-bs-toggle', 'dropdown')
        .setAttribute('id', 'dropdownShowMoreMenuButton')
        .setAttribute('aria-expanded', 'false')
    }) }}
  {% endset %}
  {% set menu = pattern('navigation', {
    'variant': 'tabs',
    'orientation': 'horizontal',
    'items': items_to_show,
  }) %}
  {% set show_more_menu = pattern('navigation', {
    'variant': 'pills',
    'orientation': 'vertical',
    'items': items_to_hide,
  }) %}
  <div class="menu--og--navigation">
    <div class="menu--og--navigation__menu">
      <div class="container d-flex flex-nowrap">
        {{ menu }}
        <div class="menu--og--navigation__show-more pe-4">
          {{ show_more_button }}
          <div class="dropdown-menu" aria-labelledby="dropdownShowMoreMenuButton">
            {{ show_more_menu }}
          </div>
        </div>
      </div>
    </div>
  </div>
{% endif %}
