{#
/**
 * @file
 * Template for a menu.
 *
 * Available variables:
 * - items:  A nested list of menu items. Each menu item contains:
 *   - label: The menu link label.
 *   - path: The path corresponding to the menu item.
 *   - attributes: HTML attributes for the menu item.
 */
#}
{{ attach_library('ventuno/menu--og--navigation') }}

{% for item in items %}
  {% set item %}
    {%
      set classes = [
      item.in_active_trail ? 'is-active',
    ]
    %}
    {{ item.attributes.addClass(classes) }}
    {{ item.attributes.setAttribute('title', item.title) }}
  {% endset %}
{% endfor %}

<div class="menu--og--navigation">
  <div class="container">
    <nav>
      {{ pattern('navigation', {
        'variant': 'default',
        'items': items,
      }) }}
      <div class="menu--og--navigation--dropdown dropdown">
        <button type="button" data-bs-toggle="dropdown" id="ogNavigationDropdown" aria-expanded="false" class="btn btn-link px-0">{{ 'See more'|t }}
          <svg class="bi icon--xs"><use xlink:href="{{ bcl_icon_path }}#chevron-down"></use></svg>
        </button>
        <ul class="hidden-links dropdown-menu dropdown-menu-end" aria-labelledby="ogNavigationDropdown"></ul>
      </div>
    </nav>
  </div>
</div>
