{#
/**
 * @file
 * Theme override for the account menu in the header (profile dropdown).
 *
 * Available variables:
 * - items: A nested list of menu items from the menu tree.
 * - user_name: The display name of the current user, shown as the toggle label.
 *   Provided by ventuno_preprocess_menu__account().
 * - attributes: HTML attributes for the menu.
 */
#}
<li class="nav-item dropdown">
  <button
    id="account"
    class="dropdown-toggle nav-link"
    data-bs-toggle="dropdown"
    aria-expanded="false"
    type="button"
    data-bs-auto-close="outside"
    aria-label="{{ user_name }}"
  >
    <span class="visually-hidden">{{ user_name }}</span>
    <svg class="bi icon--s">
      <use xlink:href="{{ bcl_icon_path }}#person-circle"></use>
    </svg>
  </button>
  <div class="dropdown-menu p-0" aria-labelledby="account" data-popper-placement="right">
    <ul class="dropdown-list">
      {% for item in items %}
        {% set link = item.dropdown is defined and item.dropdown ? item.trigger : item %}
        <li class="dropdown-list-item">
          <a href="{{ link.path }}" class="dropdown-list-link{{ link.in_active_trail ? ' is-active' }}">{{ link.label }}</a>
        </li>
      {% endfor %}
    </ul>
  </div>
</li>
