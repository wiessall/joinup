{#
/**
 * @file
 * Themeing override for the teaser view mode of the topic meta entity.
 */
#}
{% set classes = [
  'rounded',
  'h-100',
  'overflow-hidden',
  'shadow-sm',
] %}aasdfasdfasdfasdfasdf
<article{{ attributes.addClass(classes) }}>
  {#
    @todo Move the title and the description to the header of a page template.
  #}
  {{ title_prefix }}
  {{ content.label }}
  {{ title_suffix }}
  {{ content.description }}

  {#
    @todo Remove the label and description from display once they are moved
    to the header of a page template.
  #}
  {{ content|without('label', 'description') }}
</article>
