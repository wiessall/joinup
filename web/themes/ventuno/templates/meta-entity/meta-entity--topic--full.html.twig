{#
/**
 * @file
 * Themeing override for the teaser view mode of the topic meta entity.
 */
#}
{{ attach_library('ventuno/header-topic') }}
<article{{ attributes }}>
  <header class="header-topic mb-3">
    {{ title_prefix }}
    <h1 class="header-topic__title">{{ content.label }}</h1>
    <div class="header-topic__description">{{ content.description }}</div>
    {{ title_suffix }}
  </header>
  {{ content|without('label', 'description') }}
</article>
