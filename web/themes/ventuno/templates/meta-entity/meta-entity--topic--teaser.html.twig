{#
/**
 * @file
 * Themeing override for the teaser view mode of the topic meta entity.
 */
#}
{% set classes = [
  'position-relative',
  'rounded',
  'h-100',
  'overflow-hidden',
  'shadow-sm',
] %}
<div class="col">
  <article{{ attributes.addClass(classes) }}>
    <a href="{{ url }}" class="position-absolute top-0 end-0 bottom-0 start-0" title="{{ 'Read more about'|t ~ ' ' ~ content.label|render|striptags|trim }}">
      <span class="visually-hidden">{{ 'Read more about'|t ~ ' ' ~ content.label|render|striptags|trim }}</span>
    </a>
    {{ title_prefix }}
    {{ content.image }}
    <div class="p-3">
      <h1{{ title_attributes.addClass(['h5', 'text-primary']) }}>{{ content.label }}</h1>
      <div class="text-dark fs-sm">{{ content.description }}</div>
    </div>
    {{ title_suffix }}
  </article>
</div>
