{% set images_directory = site_url ~ '/' ~ directory ~ '/assets/images' %}

{% set subscription_url = site_url ~ path('joinup_subscription.my_subscriptions') %}

{% set unsubscription_url = site_url ~ path('joinup_subscription.unsubscribe_all', {user: receiver_id}) %}

{% set contact_url = site_url ~ path('contact_form.contact_page') %}

<tbody>
  <tr>
    <td>
      <table role="presentation" style="max-width:750px; margin: 0 auto;">
        <tbody>
          <tr>
            <td>
              <table role="presentation">
                <tbody>
                  <!-- HEADER START-->
                  <tr class="bg-primary" style="background-image: url({{ images_directory }}/digest-message/digest-message-header.jpg); background-repeat: no-repeat; background-size: contain; background-position: center center; height: 180px;">
                    <td valign="top">
                      <table role="presentation">
                        <tbody>
                          <tr>
                            <td style="width: 550px;">&nbsp;</td>
                            <td style="width: 20px;">&nbsp;</td>
                            <td style="width: 110px; height: 30px;" class="text-warning fs-sm fw-bold">
                              {% trans %}Issue: {{ issue_date }}{% endtrans %}
                            </td>
                            <td style="width: 20px;">&nbsp;</td>
                          </tr>
                        </tbody>
                      </table>
                    </td>
                  </tr>
                  <!-- HEADER END-->

                  <!-- WELCOME START-->
                    <td class="text-left" style="padding: 10px 0;">
                      <span class="fs-lg fw-bold">{% trans %}Dear {{ receiver_name }},{% endtrans %}</span>
                    </td>
                  </tr>
                  <!-- WELCOME END-->

                  <!-- MESSAGES START-->
                  <tr>
                    <td>
                      {{ messages }}
                    </td>
                  </tr>
                  <!-- MESSAGES END-->

                  <tr>
                    <td style="padding: 20px 0 10px 0;">
                      {% trans %}
                        <b>Kind regards,</b><br/> <small>The Portal Support Team</small>
                      {% endtrans %}
                    </td>
                  </tr>
                </tbody>
              </table>
            </td>
          </tr>
        </tbody>
      </table>
    </td>
  </tr>

  <!-- FOOTER START-->
  <tr>
    <td class="fs-sm">
      <table role="presentation" style="max-width:750px; margin: 0 auto;">
        <tbody>
          <tr>
            <td style="height: 10px;" class="bg-primary">&nbsp;</td>
          </tr>
            <td class="fs-sm" style="padding: 10px 0;">
              <p>{% trans %}
                You received this email because you opted in for Interoperable Europe Portal digest messages.<br/>
                <a href="{{ subscription_url }}">Manage</a> your subscription notifications or <a href="{{ unsubscription_url }}">unsubscribe</a> from all.<br/>
                <a href="{{ contact_url }}">Contact us</a>.
              {% endtrans %}</p>
            </td>
          </tr>
        </tbody>
      </table>
    </td>
  </tr>
  <!-- FOOTER END-->
</tbody>
