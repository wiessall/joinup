{#
/**
 * @file
 * Override theme implementation to display a single Drupal page while offline.
 *
 * All available variables are mirrored in page.html.twig.
 * Some may be blank but they are provided for consistency.
 *
 * @see template_preprocess_maintenance_page()
 *
 * @ingroup themeable
 */
#}
<div class="layout-container">
  {{ include('@ventuno/parts/header.html.twig') }}
  {{ attach_library('ventuno/navbar') }}
  <header class="joinup-navbar navbar navbar-expand" aria-label="{{ 'Main header'|t }}">
    <div class="container">
      <a class="navbar-brand" href="{{ path('<front>') }}" title="{{ 'Interoperable Europe Portal'|t }}">
        <img class="navbar-brand-image" src="{{ file_url('themes/ventuno/assets/images/logo-interoperable-europe.svg') }}" alt="{{ 'Interoperable Europe logo'|t }}" />
      </a>
    </div>
  </header>
  {% if page.header %}
    {{ page.header }}
  {% endif %}

  {% if page.messages %}
    <div class="container">
      {{ page.messages }}
    </div>
  {% endif %}

  {{ page.content_top }}

  <main role="main">
    <div id="main-content" tabindex="-1">{# link is in html.html.twig #}
      <div class="container layout-content">
      {% if title %}
        <h1 class="mt-5 mb-4">{{ title }}</h1>
      {% endif %}
      <p>{{ page.content }}</p>
      </div>
    </div>{# /.layout-content #}
  </main>

</div>{# /.layout-container #}
