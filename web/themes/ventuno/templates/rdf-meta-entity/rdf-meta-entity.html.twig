{#
/**
 * @file
 * Themeing for RDF meta entities.
 */
#}
<article{{ attributes }}>
  <h4>The {{ solution_label }} {{ "implements the following"|t }}:</h4>
  <div class="row">
    <div class="col col-lg-4 col-md-4 col-sm-4 col-xs-12">
      <h5><a href="/">Principles</a></h5>
      {{ content.eif_principle }}
    </div>
    <div class="col col-lg-4 col-md-4 col-sm-4 col-xs-12">
      <h5><a href="/">Interoperability layers</a></h5>
      {{ content.eif_layer }}
    </div>
    <div class="col col-lg-4 col-md-4 col-sm-4 col-xs-12">
      <h5><a href="/">Conceptual model</a></h5>
      {{ content.eif_model }}
    </div>
  </div>
  <div class="row">
    <h4>{{ solution_label }} {{ "implements the following EIF recommendations as explained below"|t }}:</h4>
  </div>
  <div class="row">
    {{ content.eif_recommendation }}
  </div>
</article>
