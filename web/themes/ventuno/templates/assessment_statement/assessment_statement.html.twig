{#
/**
 * @file
 * Bootstrap card layout for an assessment_statement entity.
 *
 * Variables:
 * - content.judgement
 * - content.interpretation
 * - content.landing_page
 * - content['#bundle']
 */
#}

{% set classes = [
  'assessment-statement',
  'card',
  'border',
  'shadow-sm',
  'p-3'
] %}

<article{{ attributes.addClass(classes) }}>
  <div class="card-body">

    <div class="row align-items-start">
      <div class="col-md-12">
        <div class="text-muted small">
          {% if content.interpretation %}
            {{ 'Has a ' }}
            <strong>{{ content.interpretation|render|striptags }}</strong>{{ ' interpretation' }}
          {% endif %}
          {% if content.landing_page|render|striptags %}
            {{ 'supported by the following documents'|t }}:&nbsp;
            {{ content.landing_page }}
          {% endif %}
        </div>
      </div>
    </div>
  </div>
  {% if content.judgement|render|striptags|trim %}
    <details>
      <summary class="p-2 small text-muted">
        {{ 'Judgement'|t }}
      </summary>

      <div class="card-body">

        <div>
          <div class="small text-muted">
            {{ content.judgement }}
          </div>
        </div>
      </div>
    </details>
  {% endif %}

</article>
