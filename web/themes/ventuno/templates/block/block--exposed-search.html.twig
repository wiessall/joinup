{#
/**
 * @file
 * Default theme implementation for the search bar on homepage's header.
 *
 * Available variables:
 * - filters: the search filters, to be displayed as chips.
 *
 * @ingroup themeable
 */
#}
{%
  set search_url = path('view.search.page_1')
%}
{%
  set classes = [
  'row',
  'block',
  'block-' ~ configuration.provider|clean_class,
  'block-' ~ plugin_id|clean_class,
]
%}
<div{{ attributes.addClass(classes) }}>
  <div class="col-12 col-lg-6 text-white">
    <p class="iop-header"><span class="iop-header--gradient">Interoperable</span> Europe portal</p>
    <p>{{ 'Interoperable Europe is a European Commission initiative that helps public administrations across the EU cooperate more effectively. Supported by the Interoperable Europe Act, it provides a common framework for collaboration across the European public sector.'}}</p>
    <p>{{ 'The Interoperable Europe Portal is the online hub for this initiative. It brings together tools, reusable IT solutions, good practices, news, and events to foster interoperability and digital government.'|t }}</p>
  </div>
  <div class="col-12 col-lg-6 ps-xl-5 d-flex flex-column justify-content-center">
    <div class="search-bar">
      {% block content %}
        {{ content }}
      {% endblock %}
    </div>
    <div class="col-12">
      <p class="text-white text-end">
        {% trans %}
          <span class="d-block d-sm-inline">Need more search options?</span>
          <span class="d-block d-sm-inline">Use our <a class="text-white text-decoration-underline fw-bold" href="{{ search_url }}">advanced search</a></span>
        {% endtrans %}
      </p>
    </div>
  </div>
</div>
