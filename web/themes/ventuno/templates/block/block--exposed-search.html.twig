{#
/**
 * @file
 * Default theme implementation for the search bar on homepage's header.
 *
 * Available variables:
 * - filters: the search filters, to be displayed as chips.
 *
 * @ingroup themeable
 */
#}
{%
  set search_url = path('view.search.page_1')
%}
{%
  set classes = [
  'row',
  'block',
  'block-' ~ configuration.provider|clean_class,
  'block-' ~ plugin_id|clean_class,
]
%}
<div{{ attributes.addClass(classes) }}>
  <div class="col-12 col-md-5 offset-xl-1 col-xl-5 ps-xl-5 ps-xxl-4">
    <p><img src="{{ file_url('themes/ventuno/assets/images/portal.svg') }}" alt="{{ 'Portal'|t }}" width="180" height="50" class="ms-xl-2 ms-xxl-3" /></p>
  </div>
  <div class="col-12 col-md-7 col-xl-6 ps-xl-5">
    <div class="search-bar pe-2">
      {% block content %}
        {{ content }}
      {% endblock %}
    </div>
    <div class="col-12">
      <p class="text-light">
        {% trans %}
          <span class="d-block d-sm-inline">Need more search options?</span>
          <span class="d-block d-sm-inline">Use our <a class="text-light text-decoration-underline fw-bold" href="{{ search_url }}">advanced search</a></span>
        {% endtrans %}
      </p>
    </div>
  </div>
</div>
