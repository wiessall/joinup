{#
/**
 * @file
 * Default theme implementation for the search bar on homepage's header.
 *
 * Available variables:
 * - filters: the search filters, to be displayed as chips.
 *
 * @ingroup themeable
 */
#}
{%
  set search_url = path('view.search_oss_catalogue.search')
%}
<div{{ attributes.addClass('pt-5') }}>
  <p class="text-light">{{ 'Welcome to the EU Open Source Solution Catalogue'|t }}</p>
  <div class="row">
    <div class="col-12 col-md-10 col-lg-8">
      <label for="search-bar__input" style="display: none">{{ 'Search'|t }}</label>
      {% block content %}
        {{ content }}
      {% endblock %}
    </div>
    <p class="mb-4 mb-md-0 text-center text-md-start text-light">
      <span class="d-block d-md-inline">{{ 'Need more search options?'|t }}</span>
      <span class="d-block d-md-inline">{{ 'Use our'|t }} <a class="text-light text-decoration-underline fw-bold" href="{{ search_url }}">advanced search</a></span>
    </p>
  </div>
</div>
