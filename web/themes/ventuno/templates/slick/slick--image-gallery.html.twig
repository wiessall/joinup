{#
/**
 * @file
 * Template override for Image Gallery carousel template.
 *
 * @see template_preprocess_slick()
 * @see @slick/slick.html.twig
 */
#}
{%
  set classes = [
    'carousel',
    settings.unslick ? 'unslick',
    settings.vertical ? 'slick--vertical',
    settings.attributes.class ? settings.attributes.class|join(' '),
    settings.skin ? 'slick--skin--' ~ settings.skin|clean_class,
    'boxed' in settings.skin ? 'slick--skin--boxed',
    'split' in settings.skin ? 'slick--skin--split',
    settings.optionset ? 'slick--optionset--' ~ settings.optionset|clean_class,
    arrow_down_attributes is defined ? 'slick--has-arrow-down',
    settings.asNavFor ? 'slick--' ~ display|clean_class,
    settings.slidesToShow > 1 ? 'slick--multiple-view',
    blazies.count <= settings.slidesToShow ? 'slick--less',
    display == 'main' and settings.media_switch ? 'slick--' ~ settings.media_switch|clean_class,
    display == 'thumbnail' and settings.thumbnail_caption ? 'slick--has-caption'
  ]
%}
{%
  set arrow_nav_classes = [
    'slick__arrow',
    settings.vertical ? 'slick__arrow--v',
    settings.skin_arrows ? 'slick__arrow--' ~ settings.skin_arrows|clean_class,
    'd-flex',
    'flex-wrap',
    'align-items-baseline',
    'justify-content-end',
  ]
%}

{# TODO: This needs to be changed in ISAICP-8444 #}
{{ attach_library('ventuno/image-gallery') }}

<div{{ attributes.addClass(classes) }}>

  {% block slick_arrow %}
    <nav{{ arrow_attributes.addClass(arrow_nav_classes) }}>
      {% if joinup_slick_field_label %}
        <h2 class="carousel__title mb-3">{{ joinup_slick_field_label }}</h2>
      {% endif %}
      {% if not settings.unslick %}
      <button type="button" data-role="none" class="slick-prev glide__arrow glide__arrow--left btn btn-lg btn-secondary rounded-circle p-0 me-2" aria-label="{{ settings.prevArrow|t|striptags }}" tabindex="0">
        <svg class="icon--m">
          <use xlink:href="{{ bcl_icon_path }}#chevron-left"></use>
        </svg>
      </button>

      <button type="button" data-role="none" class="slick-next glide__arrow glide__arrow--right btn btn-lg btn-secondary rounded-circle p-0 me-2" aria-label="{{ settings.nextArrow|t|striptags }}" tabindex="0">
        <svg class="icon--m">
          <use xlink:href="{{ bcl_icon_path }}#chevron-right"></use>
        </svg>
      </button>
      {%- endif -%}
    </nav>
  {% endblock %}

  <div{{ content_attributes.addClass('slick__slider', 'mx-n2') }}>
    {% block slick_content %}
      {{- items -}}
    {% endblock %}
  </div>
</div>
