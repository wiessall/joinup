{#
/**
 * @file
 * Default theme implementation to present an assessment entity.
 *
 * This template is used when viewing a canonical assessment page,
 *
 * Available variables:
 * - content: A list of content items. Use 'content' to print all content, or
 *   print a subset such as 'content.label'.
 * - attributes: HTML attributes for the container element.
 *
 * @see template_preprocess_assessment()
 */
#}
<article{{ attributes }}>
  {% if view_mode != 'full' %}
    {{ title_prefix }}
    {{ title_suffix }}
  {% endif %}
  <div class="page-title__details">
    <span class="page-title__detail">{{ 'Submitted by'|t }}&nbsp;{{ content.uid }}</span>
    <span class="page-title__detail">{{ 'on'|t }}&nbsp;{{ content.created }},</span>
    <span class="page-title__detail"><strong>{{ 'Provided by'|t }}</strong>&nbsp;{{ content.provider }}</span>
    <span class="page-title__detail">{{ 'Status:'|t }}&nbsp;{{ content.state }}</span>
  </div>

  {% if not (assessment.binding_requirement.isEmpty == true) and content.binding_requirement is defined %}
    <h2 class="heading-d mt-3">{{ 'The assessment report was based on the following binding requirements'|t }}</h2>
    {{ content.binding_requirement }}
  {% endif %}

  {# Some pretty preparation before presenting the resulst. #}
  <h2 class="heading-d mt-3">{{ 'Identified effects on cross-border interoperability'|t }}</h2>

  {# For each of the legal_interoperability, organisational_interoperability, semantic_interoperability, technical_interoperability, print the entity if exists #}
  {% for section in [
    'legal_interoperability',
    'organisational_interoperability',
    'semantic_interoperability',
    'technical_interoperability',
  ] %}
    {% if not (assessment[section].isEmpty == true) and content[section] is defined %}
      {{ content[section] }}
    {% endif %}
  {% endfor %}


</article>
