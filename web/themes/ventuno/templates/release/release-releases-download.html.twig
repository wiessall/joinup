{#
/**
 * @file
 * Themeing for release node entities.
 *
 * Available variables:
 * - releases: An array of releases render arrays.
 */
#}
{% if releases %}
  {{ attach_library('ventuno/timeline') }}
  {{ attach_library('ventuno/releases') }}
  <ol class="bcl-timeline releases">
    {{ releases }}
  </ol>
{% else %}
  {{ 'No releases yet'|t }}
{% endif %}
