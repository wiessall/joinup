{#
/**
 * @file
  * Theme override to display a user search result.
 */
#}
{% if content %}
  {{ pattern('card', {
    attributes: create_attribute().addClass(['border-0', 'mb-4']),
    horizontal: true,
    horizontal_grid: {
      left_col_classes: 'col-4',
      right_col_classes: 'col-8',
      gutter: '1',
    },
    extra_classes_header: 'border-0 bg-transparent py-0',
    extra_classes_body: 'py-0',
    badges: [],
    title: {
      tag: 'a',
      classes: 'fs-5 text-underline-hover mb-2',
      attributes: [
        {
          name: 'href',
          value: path('entity.user.canonical', {'user': user.id}),
        },
        {
          name: 'target',
          value: '_blank',
        }
      ],
      content: full_name
    },
    text: {
      content: content,
    }
  }) }}
{% endif %}
