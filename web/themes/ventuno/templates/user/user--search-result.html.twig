{#
/**
 * @file
  * Theme override to display a user search result.
 */
#}
{% if content %}
  {% set title %}
    <a class="fs-5 fw-normal text-underline-hover mb-3" href="{{ path('entity.user.canonical', {'user': user.id}) }}">{{ full_name }}</a>
  {% endset %}
  {{ pattern('card', {
    attributes: create_attribute().addClass(['border-0', 'mb-4']),
    horizontal: true,
    horizontal_grid: {
      left_col_classes: 'col-4',
      right_col_classes: 'col-8',
      gutter: '1',
    },
    extra_classes_header: 'border-0 bg-transparent py-0',
    extra_classes_body: 'py-0',
    badges: [],
    title: title,
    text: content|without('field_user_photo'),
  }) }}
{% endif %}
