{#
/**
 * @file
 * Theme override to present all user data.
 *
 * This template is used when viewing a registered user's page,
 * e.g., example.com/user/123. 123 being the user's ID.
 *
 * Available variables:
 * - content: A list of content items. Use 'content' to print all content, or
 *   print a subset such as 'content.field_example'. Fields attached to a user
 *   such as 'user_picture' are available as 'content.user_picture'.
 * - attributes: HTML attributes for the container element.
 * - user: A Drupal User entity.
 * - member_for: A custom variable, which contains a 'member for' timespan.
 *
 * @see template_preprocess_user()
 */
#}
{{ attach_library('ventuno/user--group-header') }}
<section class="user--group-header text-light py-3">
  <div class="container">
    <div class="row">
      <div class="col-12 col-md-3">
        <div class="d-flex justify-content-center">
          <div class="rounded-pill overflow-hidden">
            {{ content.field_user_photo }}
          </div>
        </div>
        {% if content.field_social_media|field_value %}
          <div class="mt-3">
           {{ content.field_social_media }}
          </div>
        {% endif %}
        <div class="mt-3 text-center text-sm">
          <span class="fw-bold">{{ 'Member for'|t }}:</span>
          <span>{{ member_for }}</span>
        </div>
        {% if content.blocked_reason|field_value %}
          <div class="mt-3 text-center text-sm">
            <span class="fw-bold">{{ 'Blocked reason'|t }}:</span>
            <span>{{ content.blocked_reason|field_value }}</span>
          </div>
        {% endif %}
      </div>
      <div class="col-12 col-md-9">
        <h1 class="mt-3 mt-md-0 fw-normal text-light text-center text-md-start">
          {{ full_name }} <span class="achievement-badges">{{ content.badges }}</span>
        </h1>
        {% if content.field_user_business_title|field_value %}
          <p class="mb-0 text-center text-md-start">
            {{ content.field_user_business_title }}
          </p>
        {% endif %}
        {% if content.field_user_nationality|field_value %}
          <div class="mt-3 text-center text-md-start">
            <p class="mb-0 fw-bold">{{ 'Country of origin'|t }}:</p>
            {{ content.field_user_nationality }}
          </div>
        {% endif %}
        {% if content.field_user_country_of_residence|field_value %}
          <div class="mt-3 text-center text-md-start">
            <p class="mb-0 fw-bold">{{ 'Country of residence'|t }}:</p>
            {{ content.field_user_country_of_residence }}
          </div>
        {% endif %}
        <div class="row">
          {% if content.field_user_organisation|field_value %}
            <div class="col-12 col-md-5 col-lg-4 mt-3">
              <p class="mb-0 fw-bold">{{ 'Organisation'|t }}:</p>
              {{ content.field_user_organisation }}
            </div>
          {% endif %}
          {% if content.function_of_administration|field_value %}
            <div class="col-12 col-md-7 col-lg-8 mt-3">
              <p class="mb-0 fw-bold">{{ 'Function of administration'|t }}:</p>
              {{ content.function_of_administration }}
            </div>
          {% endif %}
          {% if content.field_user_professional_domain|field_value %}
            <div class="col-12 col-md-7 col-lg-8 mt-3">
              <p class="mb-0 fw-bold">{{ 'Domains'|t }}:</p>
              {{ content.field_user_professional_domain }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>
