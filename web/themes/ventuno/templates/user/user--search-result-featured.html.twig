{#
/**
 * @file
 * Theme override to display a user search result featured.
 */
#}
{% if content %}
  {{ pattern('card', {
    attributes: create_attribute().addClass(['border-0', 'mb-4']),
    horizontal: true,
    horizontal_grid: {
      left_col_classes: 'col-4',
      right_col_classes: 'col-8',
      gutter: '1',
    },
    extra_classes_header: 'border-0 bg-transparent py-0',
    extra_classes_body: 'py-0',
    badges: [],
    title: {
      content: '<a class="fs-5 text-underline-hover mb-3" href="' ~ path('entity.user.canonical', {'user': user.id}) ~ '">' ~ full_name ~ '</a>'
    },
    text: {
      content: content|without('field_user_photo'),
    },
    image: {
      path: file_url(content.field_user_photo.0['#item'].entity.uri.value),
      alt: content.field_user_photo.0['#item'].alt,
      position: 'top',
      extra_classes: 'd-none d-md-block',
    },
  }) }}
{% endif %}
