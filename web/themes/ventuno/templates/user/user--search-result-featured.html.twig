{#
/**
 * @file
 * Theme override to display a user search result featured.
 */
#}
{% if content %}
  {% set title %}
    <a class="fs-5 fw-normal text-underline-hover mb-3" href="{{ path('entity.user.canonical', {'user': user.id}) }}">{{ full_name }}</a>
  {% endset %}
  {{ pattern('search_item', {
    badges: [],
    title: title,
    text: text|without('field_user_photo'),
    metadata: '',
  }) }}
{% endif %}
