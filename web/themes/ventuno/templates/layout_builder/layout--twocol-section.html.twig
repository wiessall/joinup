{#
/**
 * @file
 * Default theme implementation to display a two-column layout.
 *
 * Available variables:
 * - in_preview: Whether the plugin is being rendered in preview mode.
 * - content: The content for this layout.
 * - attributes: HTML attributes for the layout <div>.
 *
 * @ingroup themeable
 */
#}
{% if content %}
  <div{{ attributes.addClass(['row']).removeClass(['layout', 'layout--twocol-section', 'layout--twocol-section--50-50']) }}>

    {% if content.first %}
      <div {{ region_attributes.first.addClass(['col-md-6']) }}>
        {{ content.first }}
      </div>
    {% endif %}

    {% if content.second %}
      <div {{ region_attributes.first.addClass(['col-md-6']) }}>
        {{ content.second }}
      </div>
    {% endif %}

  </div>
{% endif %}
