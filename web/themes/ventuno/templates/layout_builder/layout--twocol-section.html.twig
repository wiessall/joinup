{#
/**
 * @file
 * Default theme implementation to display a two-column layout.
 *
 * Available variables:
 * - in_preview: Whether the plugin is being rendered in preview mode.
 * - content: The content for this layout.
 * - attributes: HTML attributes for the layout <div>.
 *
 * @ingroup themeable
 */
#}
{% if in_preview or content|render is not empty %}
  <div{{ attributes.removeClass('layout--twocol-section').addClass('row') }}>

    <div {{ region_attributes.first.addClass(first_col_class) }}>
      {{ content.first }}
    </div>

    <div {{ region_attributes.second.addClass(second_col_class) }}>
      {{ content.second }}
    </div>

  </div>
{% endif %}
