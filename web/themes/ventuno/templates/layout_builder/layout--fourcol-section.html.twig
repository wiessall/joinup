{#
/**
 * @file
 * Default theme implementation for a four-column 25%-25%-25%-25% layout.
 *
 * Available variables:
 * - in_preview: Whether the plugin is being rendered in preview mode.
 * - content: The content for this layout.
 * - attributes: HTML attributes for the layout <div>.
 *
 * @ingroup themeable
 */
#}
{% if content %}
  <div{{ attributes.addClass(['row']) }}>

    <div {{ region_attributes.first.addClass(['col-md-3']) }}>
      {{ content.first }}
    </div>

    <div {{ region_attributes.second.addClass(['col-md-3']) }}>
      {{ content.second }}
    </div>

    <div {{ region_attributes.third.addClass(['col-md-3']) }}>
      {{ content.third }}
    </div>

    <div {{ region_attributes.fourth.addClass(['col-md-3']) }}>
      {{ content.fourth }}
    </div>

  </div>
{% endif %}
