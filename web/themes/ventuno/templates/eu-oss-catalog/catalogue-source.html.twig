{#
/**
 * @file
 * Default theme implementation of catalogue_source.
 *
 * Available variables:
 * - provider: Provider object.
 * - label: Provider label.
 * - type: Provider type.
 * - country: Optional country.
 * - description: Propvider description.
 * - wenlinks: Array of links.
 *
 * @ingroup themeable
 */
#}

<div class="catalogue-source">

  <div class="page-title mb-3">
    <h3 class="page-title__title">{{ label }}</h3>
  </div>

  <p>
    <strong>{{ 'Type:'|t }}</strong> {{ type }}
  </p>

  {% if country %}
    <p>
      <strong>{{ 'Country:'|t }}</strong> {{ country }}
    </p>
  {% endif %}

  <div>
    <strong>{{ 'Description:'|t }}</strong>
    {{ description }}
  </div>

  {% if weblinks %}
    <div>
      <strong>{{ 'Weblinks:'|t }}</strong>
      <ul>
        {% for weblink in weblinks %}
          <li>{{ weblink }}</li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}

</div>
