{#
/**
 * @file
 * Themeing for RDF entities.
 */
#}
{{ attach_library('ventuno/tables') }}
<article{{ attributes }}>
    {{ title_prefix }}
    {{ title_suffix }}
    {{ content|without('share_link') }}
  <div class="d-flex justify-content-end my-3">
    {{ content.share_link }}
  </div>
</article>
