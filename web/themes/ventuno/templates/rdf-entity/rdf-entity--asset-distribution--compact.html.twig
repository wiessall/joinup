{#
/**
 * @file
 * Themeing for rdf entities, bundle 'asset_distribution', 'compact' view mode.
 */
#}

<article class="tile my-2 d-md-flex justify-content-between align-items-center p-3 border rounded">
  <div>
    <h1 class="h6 mb-2"><a href="{{ url }}" rel="bookmark">{{ label }}</a></h1>
    {% if content.field_ad_file_size|render %}
    <div class="d-flex flex-wrap fs-sm">
      <span class="text-muted me-1">{{ 'File size:'|t }}</span>
      <span class="text-dark">{{ content.field_ad_file_size }}</span>
    </div>
    {% endif %}
    {% if content.field_ad_licence|render %}
      <div class="d-flex flex-wrap fs-sm">
        <span class="text-muted me-1">{{ 'Licence:'|t }}</span>
        {{ content.field_ad_licence }}
      </div>
    {% endif %}
  </div>
  {{ content.field_ad_access_url }}
</article>
