{#
/**
 * @file
 * Themeing for rdf entities.
 */
#}
{% set classes =
  [
    'mt-3',
    'd-flex',
    'justify-content-center',
  ]
%}
<article{{ attributes.addClass(classes) }}>
  <div class="w-50">
    {{ content }}
  </div>
  {# {{ title_prefix }} #}
  {# <a href="{{ url }}" rel="bookmark">{{ label }}</a> #}
  {# {{ title_suffix }} #}
</article>
