{#
/**
 * @file
 * Theme override to display a rdf entities.
 */
#}
{% block content %}
  {{ pattern('card', {
    attributes: create_attribute().addClass(['border-0', 'mb-4']),
    horizontal: true,
    horizontal_grid: {
      left_col_classes: "col-4",
      right_col_classes: "col-8",
      gutter: "1",
    },
    extra_classes_header: 'border-0 bg-transparent py-0',
    extra_classes_body: 'py-0',
    badges: [
      {
        label: content.field_topic,
        background: 'secondary',
        rounded_pill: true,
        attributes: create_attribute().addClass('text-primary'),
      }
    ],
    title: {
      tag: 'a',
      classes: 'fs-5 text-underline-hover mb-2',
      attributes: [
        {
          name: 'href',
          value: url,
        },
        {
          name: 'target',
          value: '_blank',
        }
      ],
      content: label
    },
    text: {
      content: content,
    },
    content: '<span class="text-muted text-nowrap me-4-5">NEWS</span><span class="text-muted text-nowrap me-4-5">8 hours ago</span><span class="text-muted text-nowrap">1 comment</span>',
    image: {
      path: 'https://picsum.photos/200',
      alt: 'alt img',
      position: 'top',
      extra_classes: 'd-none d-md-block',
    },
  }) }}
{% endblock %}
