{#
/**
 * @file
 * Theme override to display a rdf entities.
 */
#}
{% block content %}
  {% set title %}
    <a class="fs-5 fw-normal text-underline-hover mb-3" href="{{ url }}">{{ label|raw }}</a>
  {% endset %}
  {% set metadata %}
    <span class="text-muted text-nowrap me-4">{{ type }}</span><span class="text-muted text-nowrap me-4">{{ creation }}</span><span class="text-muted text-nowrap me-4">{{ changed }}</span>
  {% endset %}
  {% set badges = [] %}
  {% for topic in topics %}
    {% if loop.index == 4 %}
      {% set badges = badges|merge([{
        label: topic.name.value,
        background: 'light',
        rounded_pill: true,
        attributes: create_attribute().addClass(['text-muted', 'me-2', 'mb-2', 'fs-sm'])
      }]) %}
    {% else %}
      {% set badges = badges|merge([{
        label: topic.name.value,
        background: 'secondary',
        rounded_pill: true,
        attributes: create_attribute().addClass(['text-primary', 'me-2', 'mb-2', 'text-underline-hover', 'fs-sm']),
        url: path('view.search.page_1', {}, {'query': {'f': { 0: 'topic:' ~ topic.tid.value }}}),
      }]) %}
    {% endif %}
  {% endfor %}
  {{ pattern('search_item', {
    image: image,
    badges: badges,
    title: title,
    text: text,
    metadata: metadata,
  }, 'featured') }}
{% endblock %}
