{#
/**
 * @file
 * Theme override to display a rdf entities.
 */
#}
{% block content %}
  {{ pattern('card', {
    horizontal: true,
    horizontal_grid: {
      left_col_classes: "col-md-3",
      right_col_classes: "col-md-9",
      gutter: 0,
    },
    title: {
      tag: "a",
      classes: "fs-5 text-decoration-none mb-2",
      attributes: [
        {
          name: "href",
          value: url,
        },
        {
          name: "target",
          value: '_blank',
        }
      ],
      content: label,
    },
    extra_classes_body: "p-0 p-md-3",
    content: content,
  }) }}
{% endblock %}
