{#
/**
 * @file
 * Themeing for rdf entities.
 */
#}
<article{{ attributes.addClass('glide__slide') }}>
  {{ title_prefix }}
  {% if not page %}
    <h3{{ title_attributes }}>
      <a href="{{ url }}" rel="bookmark">{{ label }}</a>
    </h3>
  {% endif %}
  {{ title_suffix }}
  {{ content }}
</article>
