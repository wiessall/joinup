{#
/**
 * @file
 * Themeing for RDF entities.
 */
#}
{% set status = content.field_status|render|striptags|trim %}
{% if status is same as 'Completed' %}
  {% set status_icon = 'check-circle' %}
{% elseif status is same as 'Deprecated' %}
  {% set status_icon = 'file-x' %}
{% elseif status is same as 'Under development' %}
  {% set status_icon = 'clock-history' %}
{% elseif status is same as 'Withdrawn' %}
  {% set status_icon = 'patch-exclamation' %}
{% endif %}
{{ pattern('tile', {
  attributes: attributes,
  url: url,
  highlighted: {
    icon: '',
    text: content.field_isr_release_number
  },
  info: {
    icon: 'calendar-event',
    label: 'Release date'|t ~ ': ' ~ date|render|striptags|trim,
  },
  title_prefix: title_prefix,
  title: release_label,
  title_suffix: title_suffix,
  metadata: [{
    label: status,
    icon: status_icon
  }],
  bundle: {
    label: 'Release',
    icon: 'file-earmark-zip'
  },
}) }}
