{#
/**
 * @file
 * Themeing for RDF entities.
 */
#}
{% set view_mode_featured = view_mode is same as 'view_mode_featured' %}
{% set text %}
  <p class="mb-0">{{ 'Release number'|t }}: <span class="fw-bold">{{ content.field_isr_release_number }}</span></p>
  <p class="mb-0">{{ 'Status'|t }}: <span class="fw-bold">{{ content.field_status }}</span></p>
{% endset %}
{{ pattern('tile', {
  attributes: attributes,
  featured: view_mode_featured,
  url: url,
  title_prefix: title_prefix,
  title: label,
  title_suffix: title_suffix,
  text: text,
  metadata: [{
    label: date,
    icon: 'calendar'
  },{
    label: 'release',
    icon: 'file-earmark-zip'
  }],
}) }}
