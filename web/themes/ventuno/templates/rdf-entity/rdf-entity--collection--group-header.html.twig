{#
/**
 * @file
 * Themeing for solution header.
 */
#}
<article {{ attributes.addClass(['pt-2', 'pb-3', 'bg-light', 'group-banner']) }}>
  <div class="container d-flex flex-column flex-lg-row justify-content-between">
    <div class="d-flex flex-column flex-lg-row align-items-center justify-content-center">
      <span data-drupal-group-logo class="me-3">{{ content.field_ar_logo }}</span>
      <div>
        {{ title_prefix }}
        <a class="h2 mb-0" href="{{ path('entity.rdf_entity.canonical',{'rdf_entity': rdf_entity.id()}) }}">
          {{ label }}
        </a>
        {{ title_suffix }}
        <ul class="list-unstyled d-none d-lg-flex mb-0">
          <li class="me-3 text-muted">{{ 'Last update'|t }}:&nbsp;{{ content.last_update }}</li>
          <li class="me-3 text-muted">{{ content.members }}</li>
          <li class="text-muted">{{ content.solutions }}</li>
        </ul>
      </div>
    </div>
    {% if content.join_collection|render|striptags %}
      <div class="mt-4 mt-lg-2 d-flex flex-wrap justify-content-center text-light">
        {{ content.join_collection }}
      </div>
    {% endif %}
  </div>
</article>
