{#
/**
 * @file
 * Themeing for rdf entities.
 */
#}
<article {{ attributes.addClass(['bg-secondary', 'py-4', 'py-md-5']) }}>
  <div class="row">
    {# {{ title_prefix }} #}
    <div class="col-12 col-sm-6 d-flex flex-column align-items-center align-items-sm-end justify-content-center">
      <a class="d-flex flex-column align-items-center align-items-sm-end" href="{{ path('entity.rdf_entity.canonical',{'rdf_entity': rdf_entity.id()}) }}">
        {{content.field_ar_logo}}
        <p class="mb-sm-0 text-center text-sm-end fs-1 fw-bold text-primary">{{ label }}</p>
      </a>
    </div>
    {# {{ title_suffix }} #}
    <div class="col-12 col-sm-6 d-flex flex-column align-items-center align-items-sm-start justify-content-center">
      <ul class="list-unstyled ms-3 mb-0 text-primary">
        <li class="my-2 d-flex align-items-center">
          <svg class="bi icon--s me-2">
            <use xlink:href="{{ bcl_icon_path }}#calendar3"></use>
          </svg>
          <span>{{ 'Last update'|t }}</span>&nbsp;<span class="fw-bold">{{ content.last_update }}</span>
        </li>
        <li class="my-2 d-flex align-items-center">
          <svg class="bi icon--s me-2">
            <use xlink:href="{{ bcl_icon_path }}#person-circle"></use>
          </svg>
          {{ content.members }}
        </li>
        <li class="my-2 d-flex align-items-center">
          <svg class="bi icon--s me-2">
            <use xlink:href="{{ bcl_icon_path }}#clipboard-check"></use>
          </svg>
          {{ content.solutions }}
        </li>
      </ul>
    </div>
    <div class="col-12 mt-4 d-flex flex-column align-items-center">
      {{ content.join_collection }}
    </div>
  </div>
</article>
