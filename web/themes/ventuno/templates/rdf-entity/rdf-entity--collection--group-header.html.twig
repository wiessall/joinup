{#
/**
 * @file
 * Themeing for solution header.
 */
#}
{{ attach_library('ventuno/group-banner') }}
<header{{ attributes.addClass(['group-banner', 'bg-light', 'py-2']) }}>
  <div class="container py-2 d-flex flex-column flex-lg-row align-items-center align-items-lg-start">
    <div data-drupal-group-logo class="group-banner__logo me-lg-2">
      {{ content.field_ar_logo }}
    </div>
    <div class="w-100 d-flex flex-column flex-lg-row flex-wrap">
      <div class="group-banner__title text-center text-lg-start my-2 my-lg-0">
        {{ title_prefix }}
          <a class="h1 fw-bold mb-0" href="{{ path('entity.rdf_entity.canonical',{'rdf_entity': rdf_entity.id()}) }}">
            {{ label }}
          </a>
        {{ title_suffix }}
      </div>
      {% if content.join_collection %}
        <div class="group-banner__actions order-1 order-lg-0 d-flex justify-content-center align-items-start my-3 my-lg-0">
          {{ content.join_collection }}
        </div>
      {% endif %}
      {% if not meta_banner_disabled %}
        <ul class="group-banner__meta mw-100 align-self-end list-unstyled d-flex flex-wrap mt-2 mb-0 group-stats fs-5">
          <li class="group-banner__li text-muted">{{ 'Last update'|t }}:&nbsp;{{ content.last_update }}</li>
          <li class="group-banner__li text-muted">{{ content.members }}</li>
          <li class="group-banner__li text-muted">{{ content.solutions }}</li>
        </ul>
      {% endif %}
    </div>
  </div>
</header>
