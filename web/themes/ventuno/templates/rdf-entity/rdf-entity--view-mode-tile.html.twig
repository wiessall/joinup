{#
/**
 * @file
 * Themeing for rdf entities.
 */
#}
<article{{ attributes.addClass('card-tile') }}>
  {{ title_prefix }}
  {{ pattern('search_item', {
    image: content.field_is_logo,
    url: url,
    title: page ? '' : label|render|striptags|raw,
    text: content.field_is_description|render|striptags,
  }, 'featured') }}
  {{ title_suffix }}

  <div data-drupal-card-stats class="card-stats"></div>
</article>
