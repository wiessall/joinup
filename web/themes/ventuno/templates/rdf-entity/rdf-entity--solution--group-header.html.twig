{#
/**
 * @file
 * Themeing for collection header.
 */
#}
<article {{ attributes.addClass(['pt-2', 'pb-3', 'bg-light', 'group-banner']) }}>
  <div class="container d-flex flex-column flex-lg-row justify-content-between">
    <div class="d-flex flex-column flex-lg-row align-items-start justify-content-center">
      <span data-drupal-group-logo class="my-2 me-lg-3 my-lg-0">{{ content.field_is_logo }}</span>
      <div>
        {{ title_prefix }}
        <a class="h2 mb-0" href="{{ path('entity.rdf_entity.canonical',{'rdf_entity': rdf_entity.id()}) }}">
          {{ label }}
        </a>
        {{ title_suffix }}
        <ul class="list-unstyled d-none d-lg-flex mb-0">
          <li class="me-3 text-muted">{{ content.collections }}</li>
          <li class="me-3 text-muted">{{ 'Downloads'|t }}: {{ content.downloads|render|striptags }}</li>
          <li class="text-muted">{{ content.field_topic }}</li>
        </ul>
      </div>
    </div>
    {% if content.solution_subscribe or content.releases_overview %}
      <div class="mt-4 mt-lg-2 d-flex flex-column flex-lg-row flex-wrap align-content-center align-content-lg-start text-light">
        {{ content.solution_subscribe }}
        {{ content.releases_overview }}
      </div>
    {% endif %}
  </div>
</article>
