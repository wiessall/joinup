{#
/**
 * @file
 * Themeing for RDF entities.
 */
#}
{{ pattern('tile', {
  attributes: attributes,
  image: content.field_ar_logo,
  url: url,
  info: {
    icon: 'calendar-event',
    label: 'Last update'|t ~ ': ' ~ changed,
  },
  title_prefix: title_prefix,
  title: label,
  title_suffix: title_suffix,
  metadata: [{
    label: content.members['#count'],
    icon: 'people'
  }],
  bundle: {
    label: 'Collection',
    icon: 'folder2-open'
  },
}) }}
