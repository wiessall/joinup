{#
/**
 * @file
 * Theme override to display an RDF entity.
 *
 * @see template_preprocess_rdf_entity()
 */
#}
{% set image_url = site_url ~ '/' ~ directory ~ '/assets/images/digest-message/' ~ rdf_entity.bundle ~ '_icon.png' %}
{% set publication_date = rdf_entity.getCreatedTime()|format_date('date_only') %}
{% if content.field_isr_release_number|render %}
  {% set release_number = content.field_isr_release_number|render|striptags %}
{% endif %}
{% if content.field_isr_release_notes %}
  {% set body = content.field_isr_release_notes %}
{% elseif content.field_ad_description %}
  {% set body = content.field_ad_description %}
{% endif %}
<!-- RDF -->
<tr>
  <td style="height: 20px;" class="bg-secondary">&nbsp;</td>
</tr>
<tr>
  <td class="bg-light text-center">
    <table role="presentation">
    <tbody>
      <tr>
        <td class="bg-primary text-white fs-sm fw-bold text-uppercase"><span>{{ publication_date }}</span></td>
      </tr>
      <tr>
        <td style="height: 10px;">&nbsp;</td>
      </tr>
      <tr>
        <td class="fs-lg fw-bold text-primary">
          <a class="text-none" href="{{ url }}">{{ label }}{% if release_number %} {{ release_number }}{% endif %}</a>
        </td>
      </tr>
      <tr>
        <td style="height: 20px;">&nbsp;</td>
      </tr>

      <tr>
        <td>
        <table role="presentation">
          <tbody>
            <tr>
              {% if image_url %}
                <td style="height: 200px;" class="d-sm-none"><a href="{{ url }}"><img src="{{ image_url }}" width="200" alt=""/></a></td>
                <td style="height: 20px;" class="d-sm-none">&nbsp;</td>
              {% endif %}
              <td>{{ body }}</td>
            </tr>
          </tbody>
        </table></td>
      </tr>
      <tr>
        <td style="height: 20px;">&nbsp;</td>
      </tr>
      <tr>
        <td class="d-flex justify-content-center">
          <a class="btn btn-brand" href="{{ url }}">{{ 'Read more'|t }}</a>
        </td>
      </tr>
      <tr>
        <td style="height: 30px;">&nbsp;</td>
      </tr>
    </tbody>
  </table></td>
</tr>
<!-- RDF END -->
