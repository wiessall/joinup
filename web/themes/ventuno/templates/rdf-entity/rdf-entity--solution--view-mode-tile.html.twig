{#
/**
 * @file
 * Themeing for RDF entities.
 */
#}
{{ pattern('tile', {
  attributes: attributes,
  image: content.field_is_logo,
  url: url,
  info: {
    icon: 'calendar-event',
    label: 'Last update'|t ~ ': ' ~ changed,
  },
  title_prefix: title_prefix,
  title: label,
  title_suffix: title_suffix,
  metadata: show_download_counter ?
    [{
      label: content.downloads|render|striptags,
      icon: 'download'
    }],
  bundle: {
    label: 'Solution',
    icon: 'clipboard-check'
  }
}) }}
