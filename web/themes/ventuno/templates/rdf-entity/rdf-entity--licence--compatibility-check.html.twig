{#
/**
 * @file
 * Themeing for rdf entities.
 */
#}
{% set classes = [
  'licence-tile',
  'p-3',
  'my-3',
  'border',
  'rounded',
] %}
{% set spdx_licence_id = content.spdx_licence_id|render|striptags|trim|replace({'_': '-'}) %}
<article{{ attributes.addClass(classes) }} data-spdx="{{ spdx_licence_id }}" data-licence-category="{{ content.legal_categories }}">
  <div class="row">
    <div class="col-12 col-sm-6 col-md-4">
      {{ title_prefix }}
      <h1{{ title_attributes.addClass('fs-6') }}>
        <a href="{{ url }}" rel="bookmark">{{ spdx_licence_id }}</a>
      </h1>
      {{ title_suffix }}
      <p class="mb-0 fs-sm text-dark">{{ label }}</p>
    </div>
    <div class="col-12 col-sm-6 col-md-8 mt-3 mt-sm-0 d-flex flex-row flex-wrap justify-content-end align-items-center">
      <div class="w-100 w-md-auto d-flex flex-row flex-wrap justify-content-around align-items-baseline">
        <div class="form-check mx-2">
          <input class="form-check-input" type="radio" id="{{ spdx_licence_id }}-inbound" name="inbound-licence" data-licence-name="{{ content.field_licence_description|render|striptags }}">
          <label for="{{ spdx_licence_id }}-inbound" class="form-check-label">{{ 'Inbound'|t }}</label>
        </div>
        <div class="form-check mx-2">
          <input class="form-check-input" type="radio" id="{{ spdx_licence_id }}-outbound" name="outbound-licence" data-licence-name="{{ content.field_licence_description|render|striptags }}">
          <label for="{{ spdx_licence_id }}-outbound" class="form-check-label">{{ 'Outbound'|t }}</label>
        </div>
        <button type="button" class="btn btn-sm btn-primary w-100 w-md-auto my-2 mx-md-3 licence-tile__button licence-tile__button--compatible licence-tile__button--disabled" id="licence-tile__button--check-compatibility" disabled="true" aria-disabled="true">{{ 'Check compatibility'|t }}</button>
        {% if content.spdx_licence_external_url %}
          <a class="btn btn-sm btn-link w-100 w-md-auto my-2" href="{{ content.spdx_licence_external_url['#url'] }}" target="_blank" rel="noopener">
            {{ content.spdx_licence_external_url['#title'] }}
            <svg class="bi icon--2xs ms-1">
              <use xlink:href="{{ bcl_icon_path }}#box-arrow-up-right"></use>
            </svg>
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</article>
