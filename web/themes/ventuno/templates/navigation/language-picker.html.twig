{#
/**
 * @file
 * Ventuno theme override for language picker with dropdown.
 *
 * Available variables:
 * - current_language: The current language object.
 * - languages: Array of language objects with 'code', 'name', and 'url'.
 */
#}
{{ attach_library('ventuno/language-picker') }}

<button id="language-picker__button" class="btn btn-link bg-white icon-link d-inline-flex px-3" type="button" data-bs-toggle="dropdown" aria-label="{{ 'Toggle language picker'|t }}">{{ current_language.code|upper }}</button>
<div class="dropdown-menu dropdown-menu-end p-3" role="menu" aria-labelledby="language-picker__button">
  <ul class="list-unstyled mb-0 row row-cols-2 row-cols-md-3">
  {% for language in languages %}
    <li class="col">
      <a href="{{ language.url }}"{{ language.attributes }}><span class="language-picker__code">{{ language.code|upper }}</span> {{ language.name }}</a>
    </li>
  {% endfor %}
  </ul>
</div>
