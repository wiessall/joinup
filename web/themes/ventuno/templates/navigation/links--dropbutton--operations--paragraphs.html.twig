{#
/**
 * @file
 * Template for links within a dropbutton.
 */
#}
{{ attach_library('ventuno/button-group') }}
<div{{ attributes.removeClass('dropbutton').addClass('btn-group') }}>
  {{ button }}
  <button type="button" class="btn btn-secondary dropdown-toggle dropdown-toggle-split px-2" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
    <span class="visually-hidden">{{ 'List additional actions'|t }}</span>
    <svg class="bi icon--xs">
      <use xlink:href="{{ bcl_icon_path }}#caret-down-fill"></use>
    </svg>
  </button>
    <ul class="dropdown-menu dropdown-menu-end">
      {%- for item in links -%}
        <li>
          {%- if item.link -%}
            {{ item.link }}
          {%- elseif item.text_attributes -%}
            <span{{ item.text_attributes }}>{{ item.text }}</span>
          {%- else -%}
            {{ item.text }}
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
</div>

