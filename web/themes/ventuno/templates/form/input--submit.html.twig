{#
/**
 * @file
 * Theme override for an 'input' #type form element.
 *
 * Available variables:
 * - attributes: A list of HTML attributes for the input element.
 * - children: Optional additional rendered elements.
 *
 * @see template_preprocess_input()
 */
#}
{% if attributes['value'] == 'Publish' or attributes['value'] == 'Save as draft' or attributes['value'] == 'Propose' or attributes['value'] == 'Request archival' or attributes['value'] == 'Archive' %}
  {% set attributes = attributes.addClass(['btn-outline-primary', 'mb-2', 'me-md-2']) %}
{% elseif attributes.hasClass('button--primary') or (attributes['data-drupal-selector'] == 'edit-submit') %}
  {% set attributes = attributes.addClass(['btn-primary', 'mb-2', 'me-md-2']) %}
{% else %}
  {% set attributes = attributes.addClass(['btn-secondary', 'mb-2', 'me-md-2']) %}
{% endif %}
{% if attributes.disabled == 'disabled' %}
  {% set attributes = attributes.addClass(['disabled']) %}
{% endif %}

<input{{ attributes.addClass(['btn']) }} />{{ children }}
