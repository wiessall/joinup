{#
/**
 * @file
 * Template to render the buttons separated form.
 * The form content and action buttons are separated.
 *
 * Available variables:
 * - form: the form build array.
 *
 * @ingroup themeable
 */
#}
<div class="my-3 p-3 pt-0 bg-light rounded">
  <div class="row">
    <div class="col-12">
      {{ form.combine }}
    </div>
    <div class="col-12 col-md-6">
      {{ form.roles_target_id }}
    </div>
    <div class="col-12 col-md-6 my-3">
      {{ form.member_permissions_link }}
    </div>
  </div>
  <div class="d-flex justify-content-center">
    {{ form.actions }}
  </div>
  {{ form|without('roles_target_id', 'combine', 'actions', 'member_permissions_link') }}
</div>
