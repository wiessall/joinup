{#
/**
 * @file
 * Template to render the share content form.
 *
 * Note that the form tag will be added through a theme wrapper.
 *
 * Available variables:
 * - form: the form build array.
 *
 * @ingroup themeable
 */
#}
{% if form.groups|render %}
  <div class="row">
    <div class="col-12 col-md-6">
      <h3 class="fs-5">{{ 'Social networks'|t }}</h3>
      {{ form.share }}
    </div>
    <div class="col-12 col-md-6">
      <h3 class="fs-5">{{ 'Other groups on Joinup'|t }}</h3>
      {{ form|without('share')|render }}
    </div>
  </div>
{% else %}
  <h3 class="fs-5 text-center">{{ 'Social networks'|t }}</h3>
  <div class="d-flex justify-content-center">
    {{ form.share }}
  </div>
{% endif %}
