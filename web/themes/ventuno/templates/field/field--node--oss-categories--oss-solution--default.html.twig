{#
/**
 * @file
 * Template for OSS default categories field.
 */
#}
{%
  set classes = [
    'field--name-' ~ field_name|clean_class,
    bundle|clean_class ~ '__' ~ field_name_clean|clean_class,
    label_display == 'inline' ? 'd-md-flex',
  ]
%}
{%
  set title_classes = [
    'field__label',
    'fw-bold',
    label_display == 'visually_hidden' ? 'visually-hidden',
  ]
%}

  <div{{ attributes.addClass(classes) }}>
    <div{{ title_attributes.addClass(title_classes) }}>
      {{ label }}{% if label_display == 'inline' %}<span class="me-1">:</span>{% endif %}
    </div>
    {% if multiple %}
    <div class="field__items d-flex flex-wrap col-gap-2 row-gap-2 categories-wrapper">
      {% endif %}
      {% for item in items %}
        <div{{ item.attributes.addClass('field__item') }}>{{ item.content }}</div>
      {% endfor %}
      {% if multiple %}
    </div>
    {% endif %}
  </div>
