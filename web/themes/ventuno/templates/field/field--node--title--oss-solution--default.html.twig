{#
/**
 * @file
 * Ventuno's theme implementation for the node title field.
 *
 * @see field.html.twig
 * @see node_preprocess_field__node()
 *
 * @ingroup themeable
 */
#}

{% if not is_inline %}
  {% include "field.html.twig" %}
{% else %}
  <h1{{ attributes }}>
  {%- for item in items -%}
    {{ item.content }}
  {%- endfor -%}
</h1>
{% endif %}
