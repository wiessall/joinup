{#
/**
 * @file
 * Default template for a field.
 */
#}
{%
  set classes = [
    'field--name-' ~ field_name|clean_class,
    bundle|clean_class ~ '__' ~ field_name_clean|clean_class,
  ]
%}
{%
  set item_classes = [
    'badge',
    'rounded-pill',
    'badge-outline-light',
    'fs-sm',
    'mb-1'
  ]
%}
{{ attach_library('ventuno/badge') }}
<div{{ attributes.addClass(classes) }}>
  {% for item in items %}
    <span{{ item.attributes.addClass(item_classes) }}>{{ item.content }}</span>
  {% endfor %}
</div>
