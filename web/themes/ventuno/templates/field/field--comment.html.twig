{#
/**
 * @file
 * Template for the comment field.
 */
#}
{{ attach_library('ventuno/comments') }}
<section{{ attributes.addClass(['mt-3', 'comments']) }}>
  {{ title_prefix }}
  <h2 class="h3">{{ 'Comments'|t }}</h2>
  {{ title_suffix }}

  {{ comments }}

  {% if comment_form %}
    {{ comment_form }}
  {% endif %}
</section>
