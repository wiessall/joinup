{#
/**
 * @file
 * Default template for a field.
 */
#}
{%
  set classes = [
    'field--name-' ~ field_name|clean_class,
    bundle|clean_class ~ '__' ~ field_name_clean|clean_class,
    label_display == 'inline' ? 'd-flex',
  ]
%}
{% for item in items %}
  {% if item.content|render|striptags|split(' ')|length < 50 %}
    <div class="oss-solution__long-description">
      {{ item.content }}
    </div>
  {% else %}
    <div class="oss-solution__long-description oss-solution__long-description--long collapse" id="collapseDescription">
      {{ item.content }}
    </div>
    <button
      class="mt-4 btn btn-link p-0 oss-solution__see-more-btn js-see-more-btn"
      type="button"
      data-joinup-seemore-collapsed="true"
      data-bs-toggle="collapse"
      data-bs-target="#collapseDescription"
      aria-expanded="false"
      aria-controls="collapseDescription">
      {{ 'See more'|t }}
      <svg class="bi icon--s">
        <use xlink:href="{{ bcl_icon_path }}#chevron-down"></use>
      </svg>
    </button>
  {% endif %}
{% endfor %}
