{#
/**
 * @file
 * Template override for fieldset with additional "Show more" collapse functionality.
 */
#}

{{ attach_library('ventuno/fieldset-show-more') }}
{% import _self as fieldset %}

{% if label_hidden %}
  {% if multiple %}
    <div{{ attributes.addClass('fieldset-show-more') }}>
      {% if items|length > 5 %}
        {{ fieldset.render_items(items|slice(0,5)) }}
        <div class="collapse" id="extraItems">
          {{ fieldset.render_items(items|slice(5)) }}
        </div>
        <button class="btn btn-link px-0 fieldset-show-more__btn" type="button" data-bs-toggle="collapse" data-bs-target="#extraItems" aria-expanded="false" aria-controls="extraItems">
          <span class="fieldset-show-more__btn-text">{{ 'Show more'|t }}</span>
          <svg class="bi icon--s">
            <use xlink:href="{{ bcl_icon_path }}#chevron-down"></use>
          </svg>
        </button>
      {% else %}
        {{ fieldset.render_items(items) }}
      {% endif %}
    </div>
  {% else %}
    {{ fieldset.render_items(items) }}
  {% endif %}
{% else %}
  <div{{ attributes.addClass('fieldset__field') }}>
    <div{{ title_attributes.addClass('fieldset__field-label') }}>{{ label }}</div>
    {% if multiple %}
      <div>
    {% endif %}
        {{ fieldset.render_items(items) }}
    {% if multiple %}
      </div>
    {% endif %}
  </div>
{% endif %}

{%  macro render_items(items) %}
  {% for item in items %}
    <div{{ item.attributes.addClass('fieldset__field-item') }}>{{ item.content }}</div>
  {% endfor %}
{% endmacro %}
