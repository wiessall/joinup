{#
/**
 * @file
 * Override of private-message.html.twig to display a private message in a thread.
 *
 * @see joinup_private_message_preprocess_private_message()
 */
#}
<div{{ attributes }}>
  {{ title_suffix }}
  <div class="fw-bold">{{ owner }} {{ content.created }}</div>
  <div class="private_message_inbox_content">
    {{ content.message }}
  </div>
</div>
