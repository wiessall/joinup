{#
/**
 * @ingroup themeable
 */
#}

{% set classes = [
  'list-unstyled',
  'd-flex',
  'justify-content-center',
  'mt-3'
] %}
<ul{{ attributes.addClass(classes) }}>
  {% for platform in platforms %}
    <li class="mx-2">
      <a href="{{ platform.url }}" target="_blank" rel="noopener" class="text-light" title="{{ platform.name }}">
        {{ pattern('icon', {
          name: platform.id,
          size: 's'
        }) }}
      </a>
    </li>
  {% endfor %}
</ul>
