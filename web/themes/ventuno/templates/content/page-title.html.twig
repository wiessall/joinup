{#
/**
 * @file
 * Template for the page title.
 */
#}
{% set permalink = entity.getPermalink() %}
{% set hidden_title_collection_settings = entity.collection_settings.entity.landing_page.entity.field_hide_title.value %}
{% set hidden_title_solution_settings = entity.solution_settings.entity.landing_page.entity.field_hide_title.value %}

{{ attach_library('ventuno/page-title') }}
{{ title_prefix }}
{% if title %}
<div class="page-title">
  <h1{{ title_attributes.addClass('page-title__title', (hidden_title_collection_settings or hidden_title_solution_settings) ? 'visually-hidden' : '', 'mt-3') }}>
    {{ title }}
    {% block badges %}{% endblock %}
    {% if permalink %}
      <a class="permalink" href="{{ permalink }}" title="{{ 'Permalink'|t }}">
        {{ pattern('icon', {
          name: 'link-45deg',
          size: 'm'
        }) }}
      </a>
    {% endif %}
  </h1>
  {% if additional_content.is_archived %}
    <div class="page-title__details">
      {{ include('@ventuno/parts/page-title-detail-archive.html.twig') }}
    </div>
  {% endif %}
</div>
{% endif %}
{{ title_suffix }}
{% block metadata %}{% endblock %}
