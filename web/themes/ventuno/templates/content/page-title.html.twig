{#
/**
 * @file
 * Template for the page title.
 */
#}
{{ title_prefix }}
{% if title %}
  <h1{{ title_attributes.addClass('mt-4') }}>{{ title }}</h1>
  {% if permalink %}
    {# TODO: Needs styling #}
    <a class="permalink" href="{{ permalink }}" alt="{{ 'Permalink'|t }}" title="{{ 'Permalink'|t }}">
      <span>{{ 'Permalink'|t }}</span>
    </a>
  {% endif %}
{% endif %}
{{ title_suffix }}
