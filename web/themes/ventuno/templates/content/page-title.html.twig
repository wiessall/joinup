{#
/**
 * @file
 * Template for the page title.
 */
#}
{{ attach_library('ventuno/page-title') }}
{{ title_prefix }}
{% if title %}
  <h1{{ title_attributes.addClass('page-title') }}>
    {{ title }}
    {% if permalink %}
      <a class="permalink" href="{{ permalink }}" title="{{ 'Permalink'|t }}">
        {{ pattern('icon', {
          name: 'link-45deg',
          size: 'fluid'
        }) }}
      </a>
    {% endif %}
  </h1>
{% endif %}
{{ title_suffix }}
