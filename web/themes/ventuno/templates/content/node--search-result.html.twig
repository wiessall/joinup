{#
/**
 * @file
 * Theme override to display a node.
 */
#}
{% block content %}
  {% set badges = [] %}
  {% for topic in topics %}
    {% set badges = badges|merge([{
      label: topic.name.value,
      background: 'secondary',
      rounded_pill: true,
      attributes: create_attribute().addClass(['text-primary', 'me-2-5'])
    }]) %}
  {% endfor %}
  {{ pattern('card', {
    attributes: create_attribute().addClass(['border-0', 'border-bottom', 'pb-3', 'mb-3']),
    horizontal: true,
    horizontal_grid: {
      left_col_classes: 'col-4',
      right_col_classes: 'col-8',
      gutter: '1',
    },
    extra_classes_header: 'border-0 bg-transparent py-0',
    extra_classes_body: 'py-0',
    badges: badges,
    title: {
      content: '<a class="fs-5 text-underline-hover mb-3" href="url">' ~ label ~ '</a>',
    },
    text: {
      content: body,
    },
    content: footer,
  }) }}
{% endblock %}
