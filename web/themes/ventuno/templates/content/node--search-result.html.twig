{#
/**
 * @file
 * Theme override to display a node.
 */
#}
{% block content %}
  {% set badges = [] %}
  {% for topic in topics %}
    {% set badges = badges|merge([{
      label: topic.name.value,
      background: 'secondary',
      rounded_pill: true,
      attributes: create_attribute().addClass('text-primary')
    }]) %}
  {% endfor %}
  {{ pattern('card', {
    attributes: create_attribute().addClass(['border-0', 'mb-4']),
    horizontal: true,
    horizontal_grid: {
      left_col_classes: 'col-4',
      right_col_classes: 'col-8',
      gutter: '1',
    },
    extra_classes_header: 'border-0 bg-transparent py-0',
    extra_classes_body: 'py-0',
    badges: badges,
    title: {
      tag: 'a',
      classes: 'fs-5 text-underline-hover mb-2',
      attributes: [
        {
          name: 'href',
          value: url,
        },
        {
          name: 'target',
          value: '_blank',
        }
      ],
      content: label
    },
    text: {
      content: body,
    },
    content: footer,
  }) }}
{% endblock %}
