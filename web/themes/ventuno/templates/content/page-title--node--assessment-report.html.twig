{#
/**
 * @file
 * Theme override for assessment report page title.
 *
 * Available variables:
 * - title_attributes: HTML attributes for the page title element.
 * - title_prefix: Additional output populated by modules, intended to be
 *   displayed in front of the main title tag that appears in the template.
 * - title: The page title, for use in the actual content.
 * - title_suffix: Additional output populated by modules, intended to be
 *   displayed after the main title tag that appears in the template.
 */
#}
{% set permalink = entity.getPermalink() %}
{{ attach_library('ventuno/page-title') }}
{{ title_prefix }}
{% if title %}
  <div class="page-title d-flex flex-column my-4">
    <h1 class="page-title__title order-1">
      {{ title }}
      {% if permalink %}
        <a class="permalink" href="{{ permalink }}" title="{{ 'Permalink'|t }}">
          {{ pattern('icon', {
            name: 'link-45deg',
            size: 'm'
          }) }}
        </a>
      {% endif %}
    </h1>

    <div class="page-title__details order-1">
      <span class="page-title__detail">{{ additional_content.organization }}</span>
      <span class="page-title__detail">{{ 'Published on'|t }}: {{ additional_content.publication_date }}</span>
      <span class="page-title__detail">
        <span class="me-2">
          {{ bundle_label }}
        </span>
        {{ pattern('icon', {
          name: 'file-earmark-check',
          size: 's'
        }) }}
      </span>
    </div>
  </div>
{% endif %}
{{ title_suffix }}
