{#
/**
 * @file
 * Template for a Node.
 */
#}
<div class="pt-3 pb-5 border-bottom">
  {{ content.body }}
</div>
{% if content.field_attachment|render|striptags %}
  <div class="pt-5 pb-3 border-bottom mb-5">
    <h3>{{ 'Attachments'|t }}</h3>
    {{ content.field_attachment }}
  </div>
{% endif %}
<div class="d-flex flex-wrap align-items-end flex-row justify-content-end my-3">
  {{ content.report }}
  {{ content.invite_link }}
  {{ content.share_link }}
  {{ content.flag_subscribe_discussions }}
</div>
{{ content.field_replies }}
{{ content.field_shared_in }}
