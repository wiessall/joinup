{#
/**
 * @file
 * Template override for solution header.
 *
 * @see ventuno_preprocess_node__solution__group_header().
 * @see ventuno_preprocess_node().
 * @see template_preprocess_node().
 */
#}
{{ attach_library('ventuno/group-banner') }}
{{ attach_library('ventuno/group') }}
<div{{ attributes.addClass(['group-banner', 'bg-light', 'pt-2', 'py-lg-2']).setAttribute('role', 'region').setAttribute('aria-label', 'Solution header'|t) }}>
  <div class="container py-0 py-md-2 d-flex flex-column flex-lg-row">
    <div data-drupal-group-logo class="group-banner__logo me-lg-2 w-100 w-lg-auto text-center">
      {{ content.logo }}
    </div>
    <div class="w-100 d-flex flex-column flex-lg-row flex-wrap">
      <div class="group-banner__title my-2 my-lg-0 text-center text-lg-start d-flex align-items-center justify-content-center justify-content-lg-start">
        {{ title_prefix }}
        {% if has_no_landing_page %}
          <h1>
        {% endif %}
        <a class="h1 fw-bold mb-0" href="{{ url }}">
          {{ label }}
        </a>
        {% if has_no_landing_page %}
          </h1>
        {% endif %}
        {{ title_suffix }}
      </div>
      {% if content.solution_subscribe or content.releases_overview %}
        <div class="group-banner__actions order-1 order-lg-0 d-flex flex-wrap justify-content-center align-items-start my-3 my-lg-0">
          {% if content.solution_subscribe %}
            {{ content.solution_subscribe }}
          {% endif %}
          {% if content.releases_overview %}
            {{ content.releases_overview }}
          {% endif %}
        </div>
      {% endif %}
      {% if not meta_banner_disabled %}
        <ul class="group-banner__meta mw-100 align-self-start list-unstyled d-flex flex-column flex-lg-row flex-wrap mt-2 mb-0 group-stats fs-6">
          <li class="group-banner__li group-banner__li--collection text-muted">{{ content.collections }}</li>
          <li class="group-banner__li text-muted">
            <a href="{{ path('entity.node.member_overview', {node: node.id()}) }}">
              <svg class="bi icon--xs me-1">
                <use xlink:href="{{ bcl_icon_path }}#people"></use>
              </svg>
              {{ content.members }}
            </a>
          </li>
          <li class="group-banner__li text-muted">
            {{ content.flag_interoperability }}
          </li>
          {% if is_archived %}
            <li class="group-banner__li group-banner__li--archived text-muted">
              <svg class="bi icon--xs me-1">
                <use xlink:href="{{ bcl_icon_path }}#archive"></use>
              </svg>
              {{ 'Archived'|t }}
            </li>
          {% endif %}
          <li class="group-banner__li group-banner__li--topics text-muted d-flex align-items-baseline mw-100 w-100">{{ 'Topics'|t }}: {{ content.field_topic }}</li>
        </ul>
      {% endif %}
    </div>
  </div>
</div>
