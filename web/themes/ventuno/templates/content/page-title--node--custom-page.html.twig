{#
/**
 * @file
 * Template for the page title.
 */
#}
{% set permalink = entity.getPermalink() %}
{{ attach_library('ventuno/page-title') }}
{{ title_prefix }}

{% set h1_attributes = create_attribute().addClass(['page-title__title']) %}

{% set classes = [
  'page-title__title',
  'mt-4',
  additional_content.hide_title ? 'visually-hidden'
] %}

{% if title %}
  <div class="page-title page__title-wrapper">
    <h1{{ h1_attributes.addClass(classes) }}>
      <span>
        {{ title|striptags }}
        {% if permalink %}
          <a class="permalink" href="{{ permalink }}" title="{{ 'Permalink'|t }}">
            {{ pattern('icon', {
              name: 'link-45deg',
              size: 'm'
            }) }}
          </a>
        {% endif %}
      </span>
    </h1>

    <div class="page-title__details">
      {% if additional_content.is_archived %}
        {{ include('@ventuno/parts/page-title-detail-archive.html.twig') }}
      {% endif %}
    </div>
  </div>
{% endif %}
{{ title_suffix }}
{% block metadata %}{% endblock %}
