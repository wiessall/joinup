{#
/**
 * @file
 * Default theme implementation of anonymous comment links.
 *
 * @ingroup themeable
 */
#}
{% set classes = [
  'mt-3',
  'bg-light',
  'p-3',
  'text-center',
] %}
<div{{ attributes.addClass(classes) }}>
  {{ '<a href=":login_url">Login</a> or <a href=":register_url">create an account</a> to comment.'|t({':login_url': path('cas.login'), ':register_url': path('user.register')}) }}
</div>
