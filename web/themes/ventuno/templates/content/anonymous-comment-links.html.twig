{#
/**
 * @file
 * Default theme implementation of anonymous comment links.
 *
 * @ingroup themeable
 */
#}
{% set classes = [
  'mt-3',
  'bg-light',
  'p-3',
  'text-center',
] %}
<div{{ attributes.addClass(classes) }}>
  <a href="{{ url('cas.login') }}">Login</a> or
  <a href="{{ url('user.register') }}">create an account</a> to comment.
</div>
