{#
/**
 * @file
 * Template for the page title.
 */
#}
{% set permalink = entity.getPermalink() %}
{{ attach_library('ventuno/page-title') }}
{{ title_prefix }}
{% if title %}
  <h1{{ title_attributes.addClass(['page-title', 'my-3']) }}>
    {{ additional_content.full_label }}
    {{ attach_library('ventuno/badge') }}
    {% if additional_content.is_latest_release %}
      <span class="badge bg-success">{{ 'Latest release'|t }}</span>
    {% else %}
      <a class="badge badge-outline-brand" href="{{ additional_content.latest_release }}">{{ 'Switch to the latest release'|t }}</a>
    {% endif %}
    {% if permalink %}
      <a class="permalink" href="{{ permalink }}" title="{{ 'Permalink'|t }}">
        {{ pattern('icon', {
          name: 'link-45deg',
          size: 'm'
        }) }}
      </a>
    {% endif %}
  </h1>
{% endif %}
{{ title_suffix }}
{# Metadata line #}
<div class="page-title__details fs-sm mb-3 d-flex">
  <span class="page-title__detail">{{ 'Published on'|t }}: {{ additional_content.published }}</span>
  {% if additional_content.published != additional_content.updated %}
    <span class="page-title__detail">{{ 'Last update'|t }}: {{ additional_content.updated }}</span>
  {% endif %}

  {% if additional_content.is_archived %}
    {{ include('@ventuno/parts/page-title-detail-archive.html.twig') }}
  {% endif %}
</div>
