{#
/**
 * @file
 * Group content header used in content subscription digest messages.
 */
#}
<!-- GROUP HEADER START-->
<table role="presentation" class="p-0">
  <tbody>
  <tr>
    <td class="bg-white">
      <table role="presentation">
        <tbody>
        <tr>
          <td style="width: 30px; height: 25px;">&nbsp;</td>
          <td>&nbsp;</td>
          <td style="width: 30px;">&nbsp;</td>
        </tr>
        <tr>
          <td>&nbsp;</td>
          <td>
            <span>{{ 'New content published in'|t }}</span> <a href="{{ url }}">{{ label }}</a>
          </td>
          <td>&nbsp;</td>
        </tr>
        <tr>
          <td style="height: 25px;">&nbsp;</td>
          <td>&nbsp;</td>
          <td>&nbsp;</td>
        </tr>
        </tbody>
      </table>
    </td>
  </tr>
  <tr>
    <td style="height: 20px;">&nbsp;</td>
  </tr>
  </tbody>
</table>
<!-- GROUP HEADER END-->
