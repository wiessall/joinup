{#
/**
 * @file
 * Theme override for page titles.
 *
 * Available variables:
 * - title_attributes: HTML attributes for the page title element.
 * - title_prefix: Additional output populated by modules, intended to be
 *   displayed in front of the main title tag that appears in the template.
 * - title: The page title, for use in the actual content.
 * - title_suffix: Additional output populated by modules, intended to be
 *   displayed after the main title tag that appears in the template.
 */
#}
{{ attach_library('ventuno/page-title') }}
{{ title_prefix }}
{% if title %}
  <div class="page-title page__title-wrapper">
    <h1 class="page-title__title h2">
      {{ title }}
      {% if permalink %}
        <a class="permalink" href="{{ permalink }}" title="{{ 'Permalink'|t }}">
          {{ pattern('icon', {
            name: 'link-45deg',
            size: 'fluid'
          }) }}
        </a>
      {% endif %}
    </h1>

    <div class="page-title__details">
      <span class="page-title__detail">{{ 'Published on'|t }}: {{ additional_content.published }}</span>
      <span class="page-title__detail">{{ 'Last update'|t }}: {{ additional_content.updated }}</span>
    </div>

    <div class="bg-light p-3 rounded d-inline-flex">
      <div class="d-flex flex-column">
        <div class="page-title__headline d-inline-flex align-items-center">
          <svg class="bi icon--m text-brand me-2">
            <use xlink:href="{{ bcl_icon_path }}#calendar-event"></use>
          </svg>
          <span class="text-primary">{{ additional_content.field_event_date }}</span>
        </div>
        {% if additional_content.field_event_location|render|striptags %}
          <div class="page-title__headline d-flex align-items-center mt-2">
            <svg class="bi icon--m text-brand me-2">
              <use xlink:href="{{ bcl_icon_path }}#geo-alt"></use>
            </svg>
            <span class="text-primary">{{ additional_content.field_event_location }}</span>
          </div>
        {% endif %}
      </div>
      {{ additional_content.field_add_to_cal }}
    </div>
  </div>
{% endif %}
{{ title_suffix }}
