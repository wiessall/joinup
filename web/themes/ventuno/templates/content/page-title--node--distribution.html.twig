{#
/**
 * @file
 * Template for the page title.
 */
#}
{% extends '@ventuno/content/page-title.html.twig' %}

{% block metadata %}
  <div class="fs-sm mb-3 d-flex">
    {% set _file_size = additional_content.file_size|render %}
    {% if _file_size|striptags|trim %}
      {{ _file_size }}
    {% endif %}
    {% set _licence = additional_content.licence|render %}
    {% if _file_size|striptags|trim and _licence|striptags|trim %}
      <span class="mx-1">|</span>
    {% endif %}
    {% if _licence|striptags|trim %}
      <span class="me-1">Licence:</span> {{ _licence }}
    {% endif %}
  </div>
  <div class="page-title__details fs-sm mb-3 d-flex">
    <span class="page-title__detail">{{ 'Published on'|t }}: {{ additional_content.published }}</span>
    {% if additional_content.published != additional_content.updated %}
      <span class="page-title__detail">{{ 'Last update'|t }}: {{ additional_content.updated }}</span>
    {% endif %}
  </div>
{% endblock %}
