{#
/**
 * @file
 * Theme override to display a node.
 *
 * @see template_preprocess_node()
 */
#}
{% if content.field_short_title|field_value %}
  {% set digest_item_title = content.field_short_title|field_value %}
{% else %}
  {% set digest_item_title = label|field_value %}
{% endif %}

{% if content.field_news_logo|field_value %}
  {% set digest_item_img = site_url ~ content.field_news_logo|render|striptags|trim %}
{% elseif content.field_event_logo|field_value %}
  {% set digest_item_img = site_url ~ content.field_event_logo|render|striptags|trim %}
{% else %}
  {% set digest_item_img = site_url ~ '/' ~ directory ~ '/assets/images/digest-message/' ~ node.bundle ~ '_icon.png' %}
{% endif %}

{% set digest_item_body = content.description ?? content.abstract ?? content.body %}

<p style="margin: 20px 0 0 0;" class="fw-bold fs-sm text-uppercase">{{ digest_item_date }}</p>
<h2 style="margin-top: 0" class="fs-md"><a class="text-primary text-none" href="{{ url }}">{{ digest_item_title }}</a></h2>
{{ digest_item_body }}
<p><a href="{{ url }}" style="padding: 10px 0; display: block;">{{ 'Read more'|t }}</a></p>
<hr>
