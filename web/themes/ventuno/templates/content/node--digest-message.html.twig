{#
/**
 * @file
 * Theme override to display a node.
 *
 * @see template_preprocess_node()
 */
#}
{% set _field_short_title = content.field_short_title|render %}
{% if _field_short_title %}
  {% set digest_item_title = _field_short_title %}
{% else %}
  {% set digest_item_title = label %}
{% endif %}

{% set _field_news_logo = content.field_news_logo|render %}
{% set _field_event_logo = content.field_event_logo|render %}
{% if _field_news_logo|striptags|trim %}
  {% set digest_item_img = site_url ~ _field_news_logo|striptags|trim %}
{% elseif _field_event_logo|striptags|trim %}
  {% set digest_item_img = site_url ~ _field_event_logo|striptags|trim %}
{% else %}
  {% set digest_item_img = site_url ~ '/' ~ directory ~ '/assets/images/digest-message/' ~ node.bundle ~ '_icon.png' %}
{% endif %}

{% set digest_item_body = content.description ?? content.abstract ?? content.body %}

<table role="presentation">
  <tbody>
  <tr>
    <td class="bg-primary p-3">
      <span class="d-inline-flex flex-row fw-bold fs-sm text-white text-uppercase">{{ digest_item_date }}</span>
    </td>
  </tr>
  <tr>
    <td class="fs-lg fw-bold">
      <a class="text-primary text-none" href="{{ url }}">{{ digest_item_title }}</a>
    </td>
  </tr>
  <tr>
    <td style="height: 10px;">&nbsp;</td>
  </tr>

  <tr>
    <td>
      <table role="presentation">
        <tbody>
        <tr>
          <td style="width: 200px;" class="d-none d-sm-block me-3"><a href="{{ url }}"><img src="{{ digest_item_img }}" width="200" alt=""/></a></td>
          <td style="width: 20px;" class="d-none d-sm-block">&nbsp;</td>
          <td style="vertical-align: top;">
            {{ digest_item_body }}
          </td>
        </tr>
        </tbody>
      </table>
    </td>
  </tr>
  <tr>
    <td style="height: 20px;">&nbsp;</td>
  </tr>

  <tr>
    <td class="d-flex justify-content-center">
      <a class="btn btn-brand" href="{{ url }}">{{ 'Read more'|t }}</a>
    </td>
  </tr>
  <tr>
    <td style="height: 30px;">&nbsp;</td>
  </tr>
  </tbody>
</table>
