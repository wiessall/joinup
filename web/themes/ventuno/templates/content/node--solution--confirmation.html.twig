{#
/**
 * @file
 * Override the emplate for a the confirmation step of a Solution.
 *
 * @see web/themes/ventuno/templates/content/node.html.twig
 */
#}
{%
  set classes = [
  'node',
  node.isPromoted() ? 'node--promoted',
  node.isSticky() ? 'node--sticky',
  not node.isPublished() ? 'node--unpublished',
  node.bundle|clean_class,
  node.bundle|clean_class ~ '--' ~ view_mode|clean_class,
]
%}
{% set group_solution_information = content.group_solution_information %}
{% set group_solution_information = group_solution_information|merge({title: content.title}) %}
{% set content = content|merge({group_solution_information: group_solution_information}) %}
<article{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {{ title_suffix }}

  {% block content %}
    <div{{ content_attributes }}>
      {{ content|without('report', 'share_link', 'title') }}
    </div>
    <div class="d-flex flex-wrap align-items-end flex-row justify-content-end my-3">
      {{ content.report }}
      {{ content.share_link }}
    </div>
  {% endblock %}
</article>
