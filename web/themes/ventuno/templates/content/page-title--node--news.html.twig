{#
/**
 * @file
 * Theme override for page titles.
 *
 * Available variables:
 * - title_attributes: HTML attributes for the page title element.
 * - title_prefix: Additional output populated by modules, intended to be
 *   displayed in front of the main title tag that appears in the template.
 * - title: The page title, for use in the actual content.
 * - title_suffix: Additional output populated by modules, intended to be
 *   displayed after the main title tag that appears in the template.
 */
#}
{{ attach_library('ventuno/page-title') }}
{{ title_prefix }}
{% if title %}
<div class="page-title">
  <p class="page-title__headline">{{ title }}</p>
  <h1 class="page-title__title">
    {{ additional_content.field_news_headline }}
    {% if permalink %}
      <a class="permalink" href="{{ permalink }}" title="{{ 'Permalink'|t }}">
        {{ pattern('icon', {
          name: 'link-45deg',
          size: 'fluid'
        }) }}
      </a>
    {% endif %}
  </h1>
  <div class="page-title__details">
    <div class="page-title__detail">
      {{ additional_content.author }}
    </div>
    <div class="page-title__detail">
      {{ 'Published on'|t }}: {{ additional_content.published }}
    </div>
    {% if additional_content.published != additional_content.updated %}
      <div class="page-title__detail">
        {{ 'Last update'|t }}: {{ additional_content.updated }}
      </div>
    {% endif %}
    <div class="page-title__detail">
      <span class="me-2">
        {{ bundle_label }}
      </span>
      {{ pattern('icon', {
          name: 'newspaper',
          size: 's'
        }) }}
    </div>
  </div>
</div>
{% endif %}
{{ title_suffix }}
