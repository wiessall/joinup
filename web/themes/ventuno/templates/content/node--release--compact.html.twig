{#
/**
 * @file
 * Themeing for rdf entities, bundle 'release', 'compact' view mode.
 */
#}

{{ attach_library('ventuno/badge') }}
<li class="mb-3 releases__item{% if is_latest_release %} is-latest{% endif %}">
  {% if content.release_number|render %}<span class="badge bg-brand fs-sm">{{ content.release_number }}</span>{% endif %}
  {% if is_latest_release %}<span class="badge bg-success fs-sm">{{ 'Latest release'|t }}</span>{% endif %}
  <h2 class="h3 mt-3 releases__item-title"><a href="{{ url }}" rel="bookmark">{{ full_label }}</a></h2>
  <div class="page-title__details fs-sm mb-3 d-flex">
    <span class="page-title__detail">{{ 'Published on'|t }}: {{ additional_content.published }}</span>
    {% if additional_content.published != additional_content.updated %}
      <span class="page-title__detail">{{ 'Last update'|t }}: {{ additional_content.updated }}</span>
    {% endif %}
  </div>
  {% set abstract = content.description|render|striptags %}
  {{ abstract|length > 200 ? abstract|slice(0, 200) ~ '...' : abstract }}
  <a href="{{ url }}">
    {{ 'Read full release note'|t }}
    <svg class="bi icon--xs ms-1">
      <use xlink:href="{{ bcl_icon_path }}#arrow-right"></use>
    </svg>
  </a>
  <div class="mt-3">
    <h3 class="h5{% if content.distributions %} d-inline{% endif %}">{{ 'Distributions:'|t }}</h3>
    {% if content.distributions|render %}
      {{ content.distributions }}
    {% else %}
      {{ 'No distributions yet.'|t }}
    {% endif %}
  </div>
  <div class="d-flex justify-content-end">
    <a href="{{ url }}">
      {{ 'Read full release note'|t }}
      <svg class="bi icon--xs ms-1">
        <use xlink:href="{{ bcl_icon_path }}#arrow-right"></use>
      </svg>
    </a>
</li>
