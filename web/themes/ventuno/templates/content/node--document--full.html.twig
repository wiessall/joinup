{#
/**
 * @file
 * Template override for Document's full view mode.
 */
#}
<div class="pt-3 pb-5 border-bottom">
  {# Render every field which isn't rendered below. #}
  {{ content|without('group_categorisation', 'group_attachment', 'report', 'share_link', 'field_shared_in', 'field_comments') }}
</div>
{% if content.group_categorisation|render|striptags %}
  <div class="pb-5 border-bottom my-5">
    {{ content.group_categorisation }}
  </div>
{% endif %}
{% if content.group_attachment|render|striptags %}
  <div class="pb-5 border-bottom my-5">
    {{ content.group_attachment }}
  </div>
{% endif %}
<div class="d-flex flex-wrap align-items-end flex-row justify-content-end my-3">
  {{ content.report }}
  {{ content.share_link }}
</div>
{{ content.field_shared_in }}
{{ content.field_comments }}
