{#
/**
 * @file
 * Template override for Document's full view mode.
 */
#}
<div class="pt-3 pb-5 border-bottom">
  {# Render every field which isn't rendered below. #}
  {{ content|without('group_categorisation', 'group_attachment', 'report', 'share_link', 'field_shared_in', 'field_comments', 'field_short_title') }}
</div>
{% set _group_categorisation = content.group_categorisation|render %}
{% if _group_categorisation|striptags %}
  <div class="pb-5 border-bottom my-5">
    {{ _group_categorisation }}
  </div>
{% endif %}
{% set _group_attachment = content.group_attachment|render %}
{% if _group_attachment|striptags %}
  <div class="pb-5 border-bottom my-5">
    {{ _group_attachment }}
  </div>
{% endif %}
<div class="d-flex flex-wrap align-items-end flex-row justify-content-end my-3">
  {{ content.report }}
  {{ content.share_link }}
</div>
{{ content.field_comments }}
{{ content.field_shared_in }}
