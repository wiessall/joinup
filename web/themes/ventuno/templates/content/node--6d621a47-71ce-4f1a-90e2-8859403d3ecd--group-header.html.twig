{#
/**
 * @file
 * Themeing for EU OSS Catalogue header.
 */
#}
{{ attach_library('ventuno/group-banner') }}
<div{{ attributes.addClass(['group-banner', 'bg-light', 'py-2']).setAttribute('role', 'complementary').setAttribute('aria-label', 'OSS Catalogue header'|t) }}>

  <div class="container py-2 d-flex flex-column flex-lg-row align-items-center align-items-lg-start">
    <div data-drupal-group-logo class="group-banner__logo me-lg-2">
      {{ content.field_ar_logo }}
    </div>
    <div class="w-100 d-flex flex-column flex-lg-row flex-wrap">
      <div class="group-banner__title text-center text-lg-start my-2 my-lg-0">
        {{ title_prefix }}
        {% if is_canonical %}
          <h1 class="mb-0">
        {% endif %}
        <a class="h1 fw-bold mb-0" href="{{ path('entity.node.canonical', {node: node.id()}) }}">
          {{ label }}
        </a>
        {% if is_canonical %}
          </h1>
        {% endif %}
        {{ title_suffix }}
      </div>
      <div class="group-banner__meta mw-100 align-self-end list-unstyled d-flex flex-column mb-0 group-stats fs-6">
        <p class="text-muted mb-0">{{ 'Solutions created by and for European Public Services'|t }}</p>
      </div>
    </div>
  </div>
</div>
