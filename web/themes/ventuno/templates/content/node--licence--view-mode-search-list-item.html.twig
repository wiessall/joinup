{#
/**
 * @file
 * Themeing for licence nodes.
 */
#}
{%
  set classes = [
    'licence-tile',
    'shadow',
    'p-3',
    'mb-3',
  ]
%}
{% set spdx_licence_id = render_var(content.spdx_id) %}
<article {{ attributes.addClass(classes) }} data-joinup-spdx="{{ spdx_licence_id_plain }}" data-joinup-licence-category="{{ legal_categories }}">
  {{ title_prefix }}
  {% if spdx_licence_id %}
    <h1 class="h4 ms-md-5 d-flex align-items-center flex-wrap">
      {{ spdx_licence_id_plain }}
      {{ pattern('badge', {
        label: label,
        background: 'secondary',
        attributes: create_attribute().addClass(['text-primary', 'ms-1']),
        rounded_pill: true,
        dismissible: false,
      }) }}
    </h1>
  {% endif %}
  {{ title_suffix }}

  <div class="row">
    <div class="col-12 col-md-6 col-lg-5">
      {% for category_list in category_lists %}
        <div class="d-flex align-items-baseline licence-tile__line licence-tile__line--{{ category_list.class }} fs-sm">
          <div class="licence-tile__label-wrapper me-1">
            <span class="licence-tile__label badge">{{ category_list.title }}</span>
          </div>
          <div class="licence-tile__values">
            {% for item in category_list.items %}
              <span class="licence-tile__value" title="{{ item.description|striptags }}">{{ item.title }}</span>{% if loop.last == false %}, {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endfor %}
    </div>
    <div class="col-12 col-md-6 col-lg-7">
      <p class="mb-1 fw-bold">{{ 'Licence comment'|t }}:</p>
      {{ content.description }}
      <div class="d-flex align-items-center flex-wrap">
        <div class="form-check">
          <input class="form-check-input" type="checkbox" value="" id="{{ url }}" data-joinup-licence-name="{{ spdx_licence_id_plain }}">
          <label class="form-check-label" for="{{ url }}">
            {{ 'Add to compare list'|t }}
          </label>
        </div>
        <button class="btn btn-primary ms-3 jla-compare" type="button" disabled aria-disabled="true">{{ 'Compare'|t }}</button>
        {% if content.spdx_licence_external_url %}
          {{ content.spdx_licence_external_url }}
        {% endif %}
      </div>
    </div>
  </div>
</article>
