{#
/**
 * @file
 * Theme override to display the full page for a topic taxonomy term.
 */
#}
{% extends '@ventuno/layout/page.html.twig' %}

{% block page_header %}
  {{ attach_library('ventuno/header-topic') }}
  {{ attach_library('ventuno/see-more') }}
  <div class="container region-header" role="complementary" aria-label="{{ 'Header region'|t }}">
    <div class="header-topic">
      {{ title_prefix }}
      <h1 class="header-topic__title">
        {{ meta_title }}
      </h1>
      {{ title_suffix }}

      {% set _meta_description = meta_description|render %}
      {% if _meta_description|striptags|split(' ')|length < 50 %}
        <div class="header-topic__description">
          {{ _meta_description }}
        </div>
      {% else %}
        <div class="header-topic__description see-more see-more--long collapse" id="collapseSeeMore">
          {{ _meta_description }}
        </div>
        <div class="d-flex justify-content-end mt-3{{ logged_in ? ' mb-3' }}">
          <button
            class="btn btn-link p-0 header-topic__see-more-btn js-see-more-btn"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#collapseSeeMore"
            aria-expanded="false"
            aria-controls="collapseSeeMore">
            {{ 'See more'|t }}
            <svg class="bi icon--s">
              <use xlink:href="{{ bcl_icon_path }}#chevron-down"></use>
            </svg>
          </button>
        </div>
      {% endif %}
      </div>
    </div>
  {{ page.header }}
{% endblock %}

{% block page_content %}
  <div class="layout-content mt-3">
    {{ page.content }}
  </div>
{% endblock %}
