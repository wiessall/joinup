{#
/**
 * @file
 * Flag count text template
 *
 * Available variables:
 * - flag: The flag object.
 * - flaggable: The flaggable entity.
 */
#}
{# Set the remaining Flag CSS classes. #}
  {% set classes = [
    'flag',
    'flag__link',
    'flag-' ~ flag.id()|clean_class,
    'use-ajax',
    'd-flex',
    'align-items-center',
    'text-muted',
  ] %}
  {% set attributes = create_attribute() %}
  {% set count = flagcount(flag, flaggable) %}
  {% set link_title = 'Sign in or register to like this content'|t %}

{% set attributes = attributes.addClass(classes)
    .setAttribute('data-dialog-type', 'modal')
    .setAttribute('data-dialog-options', '{"width": "auto","height":"auto"}')
    .setAttribute('href', path('joinup_modal.anonymous', {type: 'like'}, {query: {destination: path('<current>')}}))
    .setAttribute('aria-label', link_title)
    .setAttribute('role', 'button') %}

<a{{ attributes }}><span class="visually-hidden">{{- link_title -}}</span><svg class="bi icon--xs me-1"><use xlink:href="{{ bcl_icon_path }}#hand-thumbs-up"></use></svg>{{- count -}}</a>
