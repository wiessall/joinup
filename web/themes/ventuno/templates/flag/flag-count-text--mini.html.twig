{#
/**
 * @file
 * Flag count text template
 *
 * Available variables:
 * - flag: The flag object.
 * - flaggable: The flaggable entity.
 */
#}
{% apply spaceless %}
  {# Set the remaining Flag CSS classes. #}
  {% set classes = [
    'flag',
    'flag__link',
    'flag-' ~ flag.id()|clean_class,
    'use-ajax',
    'd-flex',
    'align-items-center',
    'text-muted',
  ] %}
  {% set attributes = create_attribute() %}
  {% set count = flagcount(flag, flaggable) %}

  <a{{ attributes.addClass(classes).setAttribute('data-dialog-type', 'modal').setAttribute('href', path('joinup_modal.anonymous', {'type': 'like'})).setAttribute('title', 'Login or register to like this content'|t) }}>
    <svg class="bi icon--xs me-1">
      <use xlink:href="{{ bcl_icon_path }}#hand-thumbs-up"></use>
    </svg>
    {{ count }}
  </a>
{% endapply %}
