{#
/**
 * @file
 * Flag count text template
 *
 * Available variables:
 * - flag: The flag object.
 * - flaggable: The flaggable entity.
 */
#}
{% spaceless %}
  {# Set the remaining Flag CSS classes. #}
  {% set classes = [
    'flag',
    'flag-' ~ flag.id()|clean_class,
    'use-ajax',
    'btn',
    'btn-secondary',
  ] %}
  {% set attributes = create_attribute() %}
  {% set count = flagcount(flag, flaggable) %}

  <a{{ attributes.addClass(classes).setAttribute('data-dialog-type', 'modal').setAttribute('href', '/web/like/not-logged-in') }}>
    <svg class="bi icon--fluid mb-1">
      <use xlink:href="{{ bcl_icon_path }}#hand-thumbs-up"></use>
    </svg>
    {{ flag.get('flag_short') }} ({{ count }})
  </a>
{% endspaceless %}
