{#
/**
 * @file
 * Theme implementation of a facet result item for the facet type widget.
 *
 * Available variables:
 * - value: The item value.
 * - show_count: If this facet provides count.
 * - count: The amount of results.
 *
 * @ingroup themeable
 */
#}
{% if type is same as 'custom_page' %}
  {% set icon = 'file-earmark-richtext' %}
{% elseif type is same as 'discussion' %}
  {% set icon = 'chat-left-text' %}
{% elseif type is same as 'document' %}
  {% set icon = 'file-earmark-text' %}
{% elseif type is same as 'event' %}
  {% set icon = 'calendar3' %}
{% elseif type is same as 'news' %}
  {% set icon = 'newspaper' %}
{% elseif type is same as 'video' %}
  {% set icon = 'file-earmark-play' %}
{% elseif type is same as 'collection' %}
  {% set icon = 'folder2-open' %}
{% elseif type is same as 'licence' %}
  {% set icon = 'file-earmark-medical' %}
{% elseif type is same as 'asset_release' %}
  {% set icon = 'file-earmark-zip' %}
{% elseif type is same as 'asset_distribution' %}
  {% set icon = 'file-earmark-post' %}
{% elseif type is same as 'solution' %}
  {% set icon = 'clipboard-check' %}
{% endif %}
<div class="d-flex flex-column mx-4 my-2 text-center">
  <svg class="bi icon--xl m-auto">
    <use xlink:href="{{ bcl_icon_path }}#{{ icon }}"></use>
  </svg>
  <span class="mt-2 fs-4 fw-bold">
    {% if show_count %}{{ count }}{% endif %}
    {{ value }}
  </span>
</div>
