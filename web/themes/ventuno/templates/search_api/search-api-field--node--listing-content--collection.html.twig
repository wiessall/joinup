{#
/**
 * @file
 * Theme override for a collection of search results.
 *
 * Available variables:
 * - search_title: The title accompanying the search results.
 * - no_of_results: A text string indicating the number of search results that
 *   were found.
 * - results: The search results.
 * - pager: The pager.
 * - entity_type: The entity type machine name of the entity that contains the
 *   Search API field.
 * - bundle: The bundle name of the entity that contains the Search API field.
 * - field_name: The machine name of the Search API field.
 * - entity: The entity object that contains the Search API field.
 * - form: The search form.
 * - no_results_found: A text string mentioning that no results were found.
 *   This will be empty if there are search results.
 * - search_help: A text string containing some helpful tips to increase the
 *   likelyhood to find search results. This will be empty if there are search
 *   results.
 * - newsletter_enabled: Whether the newsletter is enabled.
 * - newsletter_motivation: Newsletter motivation.
 * - newsletter_form: The newsletter subscription form.
 *
 * @see \Drupal\search_api_field\Plugin\Field\FieldFormatter\SearchFormatter::viewElements()
 *
 * @ingroup themeable
 */
#}

{% if results %}
  <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-3 mb-3">
    {{ results }}
    {% if newsletter_enabled %}
      <div class="col">
        <article class="tile bg-secondary shadow h-100 mb-3 d-flex flex-column justify-content-between">
          <div class="tile__body p-2">
            <h3 class="tile__title h5 text-primary fw-bold ">{{ 'Newsletter'|t }}</h3>
            {{ newsletter_motivation }}
          </div>
          <div class="tile__footer p-2">
            {{ newsletter_form }}
          </div>
        </article>
      </div>
    {% endif %}
  </div>
  {{ pager }}
{% endif %}
