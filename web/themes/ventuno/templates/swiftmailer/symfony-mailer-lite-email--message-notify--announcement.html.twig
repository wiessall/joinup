{#
/**
 * @file
 * The default template file for group announcements emails.
 *
 * Available variables:
 * - subject: The email subject.
 * - body: The email content.
 * - is_html: True if generating HTML output, false for plain text.
 * - message: The $message array created and used in the mail building
 *   procedure. Its main content:
 *   - from: The email address of the sender.
 *   - to: The recipient email address.
 *   - recipient_name: The recipient full-name.
 *   - recipient_profile: The recipient profile page URL.
 *   - recipient_profile_edit: The recipient profile edit page URL.
 *   - recipient_subscriptions: The user subscriptions page URL.
 *   - recipient_unsubscribe: The URL used to unsubscrbe from announcements
 *     of this group.
 *   - group_type: One of 'collection' or 'solution'.
 *   - group_title: The group title.
 *   - group_logo: The URL of the group logo, if any.
 *   - group_landing_page: The group landing page URL.
 *   - group_members_page: The group members URL.
 *   - author_name: The announcement authore full-name.
 *   - author_profile: The announcement author profile URL.
 *   - delivery_time: The date/time when this email has been actually sent.
 *   The `message` variable contains also some other technical, less used,
 *   values such as:
 *   - id: The message identifier.
 *   - module: The module that handles the building of the message.
 *   - key: The key of the message.
 *   - langcode: The langcode to use to compose the e-mail.
 *   - params: The message parameters.
 * - base_url: The site base url including scheme, without trailing slash.
 *
 * @see \joinup_group_mail_alter()
 * @sse \Drupal\joinup_group\Form\AnnouncementForm::getArguments()
 * @see \template_preprocess_symfony_mailer_lite_email()
 *
 * @ingroup themeable
 */
#}
{% if is_html %}
<html>
  <head>
    {{ include('@ventuno/parts/mail-head.html.twig') }}
  </head>
  <body>
    <table role="presentation">
      <thead>
        <tr>
          <td class="bg-primary text-white px-3">
            <div width="112" class="m-auto py-3">
              {% if message.group_logo %}
                <img src="{{ message.group_logo }}" alt="{{ message.group_title }} logo" width="112" />
              {% else %}
                <img src="{{ site_url }}/themes/ventuno/assets/images/logo-interoperable-europe.svg" alt="Interoperable Europe logo" width="112"/>
              {% endif %}
            </div>
          </td>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="p-3 text-right">
            <span class="d-inline-block p-3 bg-primary text-white text-bold">{{ message.delivery_time|date('j F Y') }}</span>
          </td>
        </tr>
        <tr>
          <td class="p-3 pt-0">
            <p class="fw-bold">{{ 'Dear @recipient_name,'|t({'@recipient_name': message.recipient_name}) }}</p>
            <p class="mb-3">{{ '<a href=":group_url" target="_blank">:group_title</a> :group_type has an announcement for its members:'|t({
              ':group_url': message.group_landing_page,
              ':group_title': message.group_title,
              ':group_type': message.group_type
            }) }}</p>
          </td>
        </tr>
        <tr class="bg-light">
          <td class="p-3">
            <p class="fw-bold">
              {#
                We cannot use subject directly as it comes from twig with
                message_notify, and twig encodes "'&>< chars to HTML entities
                which would be printed as-is.
                This is safe since Email::deliver already strips all tags.
                @see \Drupal\message_notify\Plugin\Notifier\Email::deliver
              #}
              {{ subject|raw }}
            </p>
          </td>
        </tr>
        <tr>
          <td class="p-3 pt-5">
            {{ body }}
          </td>
        </tr>
        <tr>
          <td class="p-3 pt-0">
            <p class="fw-bold">{{ 'Kind regards,'|t }}</p>
            <p class="fw-bold">{{ 'The <span class="text-primary">:group_title</span> :group_type team'|t({
              ':group_title': message.group_title,
              ':group_type': message.group_type
            }) }}</p>
          </td>
        </tr>
      </tbody>
      <tfoot>
        <tr>
          <td class="px-3 bg-primary">
            <div style="width: 112px" class="m-auto py-3">
              <a href="https://interoperable-europe.ec.europa.eu/" target="_blank">
                <img src="{{ site_url }}/themes/ventuno/assets/images/logo-interoperable-europe.svg" alt="" height="30"/>
              </a>
            </div>
          </td>
        </tr>
        <tr class="bg-light">
          <td class="p-3 fs-sm text-center">
              <p>{{ 'You received this e-mail because, as a registered user of Interoperable Europe Portal and a member of :group_title :group_type, you agreed to receive information sent to you by the :group_title :group_type owner/administrator (based on Article 5(d) of Regulation (EU) 2018/1725).'|t({
                ':group_title': message.group_title,
                ':group_type': message.group_type
              }) }}</p>
              <p>{{ 'In case you do not want to receive such e-mails, you can <a href=":unsubscribe_url" target="_blank">unsubscribe</a> from group announcement notifications or manage all your subscription notifications from the <a href=":subscriptions_url" target="_blank">user subscriptions</a> page.'|t({
                ':unsubscribe_url': message.recipient_unsubscribe,
                ':subscriptions_url': message.recipient_subscriptions
              }) }}</p>
              <p>{{ 'This is an unmonitored email address, please do not reply.'|t({
                ':group_title': message.group_title,
                ':group_type': message.group_type,
                ':group_url': message.group_landing_page
              }) }}</p>
          </td>
        </tr>
      </tfoot>
    </table>
  </body>
</html>
{% else %}
{{ body }}
{% endif %}
