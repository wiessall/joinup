{{ form.messages }}
<div class="poll">
  <div class="vote-form">
    {% if show_question %}
      <h3 class="poll-question">{{ question }}</h3>
      {{ form.actions.result }}
    {% endif %}

    {{ form.choice }}

    {{ form.actions|without('result') }}
  </div>
  {{ form|without('actions', 'choice', 'messages', 'question') }}

  {{ summary }}
</div>
