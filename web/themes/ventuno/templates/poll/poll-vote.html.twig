{{ form.messages }}
<div class="poll bg-light py-3">
  <div class="vote-form">
    {% if show_question %}
      <div class="d-flex align-items-end justify-content-between px-3 pb-3">
        <h2 class="poll-question fs-6 fw-bold text-dark m-0">{{ question }}</h2>
        {{ form.actions.result }}
      </div>
    {% endif %}

    {{ form.choice }}

    <div class="js-hide">{{ form.actions|without('result') }}</div>
  </div>
  <div class="px-3">
    {{ summary }}
  </div>
</div>

