{#
/**
 * @file
 * Ventuno theme implementation to display the poll results in a block.
 *
 * Variables available:
 * - title: The title of the poll.
 * - results: The results of the poll.
 * - votes: The total results in the poll.
 * - links: Links in the poll.
 * - pid: The pid of the poll
 * - cancel_form: A form to cancel the user's vote, if allowed.
 * - raw_links: The raw array of links.
 * - vote: The choice number of the current user's vote.
 *
 * @see template_preprocess_poll_results()
 *
 * @ingroup themeable
 */
#}
<div class="poll">
  <div class="d-flex align-items-end justify-content-between pb-3">
    {% if show_question %}
      <h2 class="poll-question fs-6 fw-bold text-dark m-0">{{ question }}</h2>
      <div class="poll__back"></div>
    {% else %}
      <h2 class="poll-results-title fs-6 fw-bold text-dark m-0">{{ results_title }}</h2>
    {% endif %}
  </div>
  <ul class="list-unstyled">
    {{ results }}
  </ul>

  {{ summary }}
</div>

  {{ cancel_form }}
