{% set lang = language.getId() ?? app.request.locale %}
{% set logo_path = 'themes/ventuno/assets/images/logo-ec/logo-ec-' ~ lang ~ '.svg' %}

<div class="bcl-header bcl-header--ec">
  <div role="complementary" class="w-100 shadow-sm navbar navbar-expand-lg navbar-light py-0" aria-label="{{ 'Site branding'|t }}">
    <div class="container">
      <div class="d-flex w-100 justify-content-between align-items-end">
        <a class="navbar-brand py-0" href="https://ec.europa.eu/info/index_{{ lang }}" aria-label="{{ 'Visit European Commission website'|t }}">
          <img src="{{ file_url(logo_path) }}" alt="{{ 'European Commission logo'|t }}" width="100" height="25"/>
        </a>
        {% if top_bar %}
          <div class="region-top-bar">
            {{ top_bar }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
{% set items = logged_in ? [{
  type: 'mmenu',
  breakpoint: 'xl',
  classes: ['order-1'],
  id: 'landing-pages',
  icon: {name: 'justify'},
  label: 'Toggle menu'|t,
  links: landing_page_links,
}] : [] %}
{% set items = items|merge([{
  type: logged_in ? 'dropdown' : 'mmenu',
  breakpoint: logged_in ? '' : 'xl',
  id: logged_in ? 'account' : 'navbar-toggler',
  icon: {
    name: logged_in ? 'person-circle' : 'justify',
  },
  label: logged_in ? user_name : 'Toggle menu'|t,
  links: logged_in ? profile_links : anonymous_links,
}]) %}
{% if bookmark_link %}
  {% set items = items|merge([{
    breakpoint: 'all',
    label: 'Bookmarks'|t,
    links: [bookmark_link|merge({order: 1})],
  }]) %}
{% endif %}
{% if not hide_searchbar %}
  {% set items = items|merge([{
    type: 'search',
    breakpoint: '',
    classes: ['order-2 dropdown-search'],
    id: 'search-box-dropdown',
    icon: {
      name: 'search',
    },
    label: 'Toggle search box'|t,
    links: search,
  }]) %}
{% endif %}
{{ include(directory ~ '/templates/navigation/navbar.html.twig', {
  brand: {
    title: 'Interoperable Europe Portal'|t,
    src: file_url('themes/ventuno/assets/images/logo-interoperable-europe.svg'),
    alt: 'Interoperable Europe logo'|t,
    link: path('<front>'),
  },
  collapse_id: 'main-navbar',
  list_id: 'main-navbar-list',
  items: items,
  private_message: private_message,
  search: hide_searchbar ? '' : searchbar,
}) }}
