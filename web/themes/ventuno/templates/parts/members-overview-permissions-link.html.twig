{#
/**
 * @file
 * Template to render the members overview permissions info link.
 *
 * Available variables:
 * - url: the link URL.
 * - text: the link text.
 * - dialog: info to show as dialog.
 *
 * @ingroup themeable
 */
#}
{% set attributes = attributes
  .addClass(['btn', 'btn-md', 'btn-link'])
%}
{% if dialog %}
  {% set attributes = attributes
    .addClass('use-ajax')
    .setAttribute('data-dialog-type', dialog.type)
    .setAttribute('data-dialog-options', dialog.options|json_encode)
  %}
{% endif %}

<a href="{{ url }}"{{ attributes }}>
  <svg class="bi icon--s me-2">
    <use xlink:href="{{ file_url('themes/ventuno/assets/icons/icons.svg#info-circle') }}"></use>
  </svg>
  {{ text }}
</a>
