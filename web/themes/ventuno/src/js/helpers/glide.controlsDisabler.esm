/**
 * @file
 * Disables GlideJS controls depending on specific cases.
 *
 * Strongly based on https://github.com/glidejs/glide/issues/307#issuecomment-502729940
 */
const classes = {
  controls: "glide__arrows",
  backArrow: "glide__arrow--left",
  nextArrow: "glide__arrow--right",
};

function ControlsDisabler(Glide, Components) {
  return {
    mount() {
      // Only in effect when rewinding is disabled
      if (Glide.settings.rewind) {
        return;
      }

      // Prevent swipe if there are not enough items to fill available space.
      Glide.on(["mount.after", "resize"], () => {
        if (Components.Sizes.length <= Glide.settings.perView) {
          // Unfortunately `Swipe.disable()` does not work even though it
          // should, see https://glidejs.com/docs/components/swipe#disable-
          Glide.disable();
        }
        else {
          Glide.enable();
        }
      });

      Glide.on(["mount.after", "run", "resize"], () => {
        Components.Controls.items.forEach((controlItem) => {
          // Set left arrow state
          const left = controlItem.querySelector(`.${classes.backArrow}`);
          if (left) {
            if (
              Glide.index === 0 ||
              Components.Sizes.length <= Glide.settings.perView
            ) {
              left.setAttribute("disabled", ""); // Disable on first slide
            } else {
              left.removeAttribute("disabled"); // Enable on other slides
            }
          }

          // Set right arrow state
          const right = controlItem.querySelector(`.${classes.nextArrow}`);
          if (right) {
            // Glide.index is based on the active slide
            // For bound: true, add perView to correctly calculate the last slide
            const lastSlideIndex = Glide.settings.bound
              ? Glide.index + (Glide.settings.perView - 1)
              : Glide.index;

            if (
              lastSlideIndex === Components.Sizes.length - 1 ||
              Components.Sizes.length <= Glide.settings.perView
            ) {
              right.setAttribute("disabled", ""); // Disable on last slide
            } else {
              right.removeAttribute("disabled"); // Disable on other slides
            }
          }

          // Hide if we do not have nothing to scroll.
          if (left.disabled && right.disabled) {
            controlItem.classList.add('glide__arrows--disabled');
          } else {
            controlItem.classList.remove('glide__arrows--disabled');
          }
        });
      });
    },
  };
}

export default ControlsDisabler;
