{#
/**
 * @file
 * Generic popover component template.
 *
 * Available variables:
 * - trigger_text: Text for the trigger button.
 * - trigger_classes: Array of CSS classes for the trigger button.
 * - content: The popover content (can be HTML).
 * - popover_classes: Array of CSS classes for the popover.
 * - placement: Popover placement ('bottom', 'top', 'left', 'right').
 * - trigger_attributes: Additional attributes for the trigger button.
 * - popover_attributes: Additional attributes for the popover content.
 */
#}
{% set popover_id = 'ventuno-popover-' ~ random() %}
{% set trigger_class_list = ['ventuno-popover__trigger']|merge(trigger_classes) %}
{% set popover_class_list = ['ventuno-popover']|merge(popover_classes) %}

<div class="{{ popover_class_list|join(' ') }}"{{ popover_attributes ? create_attribute(popover_attributes) }}>
  <button
    type="button"
    class="{{ trigger_class_list|join(' ') }}"
    data-bs-toggle="popover"
    data-bs-placement="{{ placement }}"
    data-bs-html="true"
    data-popover-target="{{ popover_id }}"
    aria-label="{{ trigger_text }}"
    {{ trigger_attributes ? create_attribute(trigger_attributes) }}
  >
    {% if trigger_text %}
      <span class="ventuno-popover__trigger-text">{{ trigger_text }}</span>
    {% endif %}
  </button>

  <div id="{{ popover_id }}" class="ventuno-popover__content visually-hidden">
    {{ content }}
  </div>
</div>
