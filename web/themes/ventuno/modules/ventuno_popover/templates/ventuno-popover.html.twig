{#
/**
 * @file
 * Generic popover component template.
 *
 * Available variables:
 * - trigger_text: Text for the trigger button.
 * - trigger_classes: Array of CSS classes for the trigger button.
 * - content: The popover content (can be HTML).
 * - popover_classes: Array of CSS classes for the popover.
 * - placement: Popover placement ('bottom', 'top', 'left', 'right').
 * - trigger_attributes: Additional attributes for the trigger button.
 * - popover_attributes: Additional attributes for the popover content.
 */
#}
{{ pattern('popover', {
  trigger_text: trigger_text,
  content: content,
  placement: placement,
  trigger_classes: trigger_classes,
  popover_classes: popover_classes,
  trigger_attributes: trigger_attributes,
  popover_attributes: popover_attributes
}) }}
