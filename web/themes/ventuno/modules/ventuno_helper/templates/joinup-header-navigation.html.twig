{#
/**
 * @file
 * Default theme implementation for the header navigation block.
 *
 * Renders the navbar list items that are not menus (search, bookmarks and the
 * anonymous sign in / get started items).
 *
 * Available variables:
 * - items: The navbar items, in the BCL header format.
 * - search: The rendered search block, printed inside the search dropdown.
 */
#}
{% import _self as menu %}
{% macro mmenu_links(links) %}
  {% import _self as menu %}
  <ul>
    {% for link in links %}
      <li>
        <a href="{{ link.link }}"{{ create_attribute(link.attributes|default([])) }}>{{ link.label }}</a>
        {% if link.links %}
          {{ menu.mmenu_links(link.links) }}
        {% endif %}
      </li>
    {% endfor %}
  </ul>
{% endmacro %}
{% for item in items %}
  {% if item.breakpoint %}
    {% for link in item.links %}
      {% set desktop_li_classes = [
        'nav-item',
        item.breakpoint != 'all' ? 'd-none',
        item.breakpoint != 'all' ? 'd-' ~ item.breakpoint ~ '-inline-block' : 'd-inline-block',
        link.order ? 'order-' ~ link.order,
        link.in_active_trail ? 'is-active',
      ] %}
      <li{{ create_attribute().addClass(desktop_li_classes) }}>
        {% if link.link %}
          {% set attributes = create_attribute(link.attributes|default([])) %}
          {{ link(link.label, link.link, attributes.addClass(['nav-link', 'nav-link--underline', link.in_active_trail ? 'is-active'])) }}
        {% elseif link.popover %}
          <button
            id="{{ link.id }}"
            class="btn btn-light get-started__trigger"
            data-bs-toggle="dropdown"
            aria-expanded="false"
            type="button"
            data-bs-auto-close="outside"
          >
            {{ link.label }}
          </button>
          <div
            class="dropdown-menu get-started__menu pt-2 pb-3 px-3"
            aria-labelledby="{{ link.id }}"
            data-popper-placement="right"
          >
            <p class="mb-1"><a class="get-started__cta fw-bold" href="{{ link.popover.cta.link }}" {{ link.popover.cta.attributes }}>
              {{ link.popover.cta.text }}
              <svg class="bi icon--s ms-2">
                <use xlink:href="{{ bcl_icon_path }}#arrow-right"></use>
              </svg>
            </a></p>
            <p class="get-started__description mb-0 fs-sm">{{ link.popover.description }}</p>
          </div>
        {% endif %}
      </li>
    {% endfor %}
  {% elseif item.type == 'search' %}
    {% set search_li_classes = item.classes|default([])|merge(['nav-item', 'dropdown']) %}
    <li{{ create_attribute({class: search_li_classes}) }}>
      <button
        id="{{ item.id }}"
        class="dropdown-toggle nav-link"
        data-bs-toggle="dropdown"
        aria-expanded="false"
        type="button"
        data-bs-auto-close="outside"
        aria-label="{{ item.label }}"
      >
        <span class="visually-hidden">{{ item.label }}</span>
        {% if item.icon is not empty %}
          <svg class="bi icon--s">
            <use xlink:href="{{ bcl_icon_path }}#{{ item.icon.name }}"></use>
          </svg>
        {% endif %}
      </button>
      <div id="dropdown-menu--search"
        class="dropdown-menu p-0"
        aria-labelledby="{{ item.id }}"
        data-popper-placement="right"
      >
        <div class="navbar-search p-2">
          {{ search }}
        </div>
      </div>
    </li>
  {% elseif item.type == 'mmenu' %}
    <li class="nav-item dropdown mmenu-nav d-xl-none order-1">
      <button id="{{ item.id }}" class="nav-link mmenu-nav__toggle" type="button" aria-label="{{ item.label }}">
        <span class="visually-hidden">{{ item.label }}</span>
        <svg class="bi icon--s">
          <use xlink:href="{{ bcl_icon_path }}#{{ item.icon }}"></use>
        </svg>
      </button>
      <div class="mmenu-nav__menu p-0 d-none" aria-labelledby="{{ item.id }}">
        {{ menu.mmenu_links(item.links) }}
      </div>
    </li>
  {% endif %}
{% endfor %}
