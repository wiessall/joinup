<?php

/**
 * @file
 * Hook implementations for Ventuno Helper module.
 */

declare(strict_types = 1);

use Drupal\Component\Serialization\Json;
use Drupal\ventuno_helper\ModalDialogHelper;

/**
 * Implements hook_link_alter().
 */
function ventuno_helper_link_alter(array &$variables): void {
  if (!ModalDialogHelper::linkOpensModal($variables['options']['attributes'] ?? [])) {
    return;
  }

  // @todo Remove this check when the legacy joinup_theme theme is dropped.
  if (\Drupal::theme()->getActiveTheme()->getName() === 'ventuno') {
    // Replace values Drupal of modal dialog attributes with Bootstrap 4 Modal.
    $variables['options']['attributes']['data-dialog-type'] = 'bootstrap4_modal';
    $variables['options']['attributes']['data-dialog-options'] = Json::encode([
      'dialogClasses' => 'modal-dialog-centered',
      'dialogShowHeader' => TRUE,
      'dialogShowHeaderTitle' => TRUE,
    ]);
    $variables['url']->setOption('attributes', $variables['options']['attributes']);
  }
}

/**
 * Implements hook_element_info_alter().
 */
function ventuno_helper_element_info_alter(array &$info): void {
  // Attach modal library to modal dialog links.
  $info['link']['#pre_render'][] = [
    ModalDialogHelper::class,
    'attachModalLibrary',
  ];
}
