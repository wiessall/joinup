<?php

/**
 * @file
 * Hook implementations for Ventuno Helper module.
 */

declare(strict_types = 1);

use Drupal\bootstrap4_modal\Ajax\CloseBootstrap4ModalDialogCommand;
use Drupal\joinup_bundle_class\LogoInterface;

/**
 * Implements hook_ajax_render_alter().
 */
function ventuno_helper_ajax_render_alter(array &$data): void {
  if (\Drupal::theme()->getActiveTheme()->getName() === 'ventuno') {
    foreach ($data as $key => $command) {
      if ($command['command'] === 'closeDialog') {
        unset($data[$key]);
        $bootstrap_command = new CloseBootstrap4ModalDialogCommand();
        $data[] = $bootstrap_command->render();
        break;
      }
    }
  }
}

/**
 * Implements hook_link_alter().
 */
function ventuno_helper_link_alter(array &$variables): void {
  // @see \Drupal\asset_distribution\Plugin\Field\FieldFormatter\TrackedHostedFileDownloadFormatter::viewElements()
  if (array_key_exists('data-joinup-tracking', $variables['options']['attributes'])) {
    $variables['options']['attributes']['class'][] = 'btn';
    $variables['options']['attributes']['class'][] = 'btn-outline-primary';
  }
  // @see collection_rdf_entity_view()
  if (array_key_exists('data-drupal-group-view-mode', $variables['options']['attributes'])) {
    if ($variables['options']['attributes']['data-drupal-group-view-mode'] === 'explore_item') {
      $variables['options']['attributes']['class'][] = 'btn';
      $variables['options']['attributes']['class'][] = 'btn-secondary';
    }
  }
}

/**
 * Implements hook_preprocess_rdf_entity().
 */
function ventuno_helper_preprocess_rdf_entity(array &$variables): void {
  // View modes where tiles are expected.
  $tile_view_modes = ['view_mode_tile', 'view_mode_tile_horizontal', 'carousel'];
  // Prepare data for the tiles.
  if (in_array($variables['view_mode'], $tile_view_modes)) {
    _ventuno_helper_preprocess_tile($variables, 'rdf_entity');
  }
}

/**
 * Implements hook_preprocess_node().
 */
function ventuno_helper_preprocess_node(array &$variables): void {
  // View modes where tiles are expected.
  $tile_view_modes = [
    'highlighted',
    'view_mode_tile',
    'view_mode_tile_horizontal',
    'carousel',
  ];
  // Prepare data for the tiles.
  if (in_array($variables['view_mode'], $tile_view_modes)) {
    _ventuno_helper_preprocess_tile($variables, 'node');
  }
}

/**
 * Prepares some variables for tile view mode.
 *
 * @param array $variables
 *   The variables array.
 * @param string $entity_type_id
 *   The entity type ID.
 */
function _ventuno_helper_preprocess_tile(array &$variables, string $entity_type_id): void {
  $entity = $variables[$entity_type_id];
  $view_mode = $variables['view_mode'];
  if (\Drupal::theme()->getActiveTheme()->getName() === 'ventuno' && $variables['view_mode'] === 'carousel') {
    $view_mode = 'view_mode_tile';
  }
  $variables['image'] = ($entity instanceof LogoInterface) && $entity->getLogoAsFile()
    ? $entity->getLogoAsRenderArray($view_mode)
    : [];
}
