<?php

/**
 * @file
 * Install functions of the Joinup user module.
 */

declare(strict_types=1);

use Drupal\joinup_user\JoinupUserDefaultAvatarImageHelper;
use Drupal\joinup_user\JoinupUserFullNameInterface;

/**
 * Implements hook_schema().
 */
function joinup_user_schema(): array {
  return [
    JoinupUserFullNameInterface::TABLE => [
      'fields' => [
        'uid' => [
          'description' => 'The {users}.uid.',
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'deleted' => [
          'description' => 'Whether the user is deleted.',
          'type' => 'int',
          'size' => 'small',
          'not null' => TRUE,
          'default' => 0,
        ],
        'full_name' => [
          'description' => 'The user full name.',
          'type' => 'varchar',
          'length' => 255,
          'not null' => TRUE,
        ],
      ],
      'primary key' => ['uid'],
      'indexes' => [
        'deleted' => ['deleted'],
        'full_name' => ['full_name'],
      ],
      'foreign keys' => [
        'data_user' => [
          'table' => 'users',
          'columns' => [
            'uid' => 'uid',
          ],
        ],
      ],
    ],
  ];
}

/**
 * Implements hook_install().
 */
function joinup_user_install(): void {
  \Drupal::classResolver(JoinupUserDefaultAvatarImageHelper::class)->createOrUpdate();
}
