<?php

/**
 * @file
 * Install functions of the Joinup user module.
 */

declare(strict_types=1);

use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\joinup_user\JoinupUserDefaultAvatarImageHelper;
use Drupal\joinup_user\JoinupUserDeletedInterface;

/**
 * Implements hook_schema().
 */
function joinup_user_schema(): array {
  return [
    JoinupUserDeletedInterface::TABLE_USER => [
      'fields' => [
        'uid' => [
          'description' => 'The {users}.uid.',
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'full_name' => [
          'description' => 'The user full name.',
          'type' => 'varchar',
          'length' => 255,
          'not null' => TRUE,
        ],
      ],
      'primary key' => ['uid'],
      'indexes' => [
        'full_name' => ['full_name'],
      ],
      'foreign keys' => [
        'data_user' => [
          'table' => 'users',
          'columns' => [
            'uid' => 'uid',
          ],
        ],
      ],
    ],
    JoinupUserDeletedInterface::TABLE_USER_CONTENT => [
      'fields' => [
        'uid' => [
          'description' => 'The {users}.uid.',
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
        'entity_type' => [
          'description' => 'The entity type.',
          'type' => 'varchar',
          'length' => EntityTypeInterface::ID_MAX_LENGTH,
          'not null' => TRUE,
        ],
        // In more generic scenario, this field should be a string. But we only
        // deal with entity types having their IDs as integers.
        // @see \Drupal\joinup_user\JoinupUserDeletedInterface::ENTITY_TYPES
        'entity_id' => [
          'description' => 'The entity ID.',
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
        ],
      ],
      'primary key' => ['uid', 'entity_type', 'entity_id'],
      'foreign keys' => [
        'data_user' => [
          'table' => 'users',
          'columns' => [
            'uid' => 'uid',
          ],
        ],
      ],
    ],
  ];
}

/**
 * Implements hook_install().
 */
function joinup_user_install(): void {
  \Drupal::classResolver(JoinupUserDefaultAvatarImageHelper::class)->createOrUpdate();
}
