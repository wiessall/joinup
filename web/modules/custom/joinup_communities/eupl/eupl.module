<?php

/**
 * @file
 * Hook implementations for EUPL module.
 */

declare(strict_types=1);

use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\custom_page\Entity\CustomPageInterface;
use Drupal\joinup_licence\Entity\LicenceInterface;
use Drupal\node\NodeInterface;

/**
 * Implements hook_ENTITY_TYPE_view_alter().
 */
function eupl_node_view_alter(array &$build, NodeInterface $node, EntityViewDisplayInterface $display): void {
  $assistant_pages = [701805, 703242];
  if ($node instanceof CustomPageInterface && in_array($node->id(), $assistant_pages)) {
    // Don't expose contextual links and the 'Report abusive content' link on
    // licence comparer and compatibility check assistants.
    unset($build['#contextual_links']);
    unset($build['report']);
  }
  elseif ($node instanceof LicenceInterface && $display->getMode() === 'compatibility_check') {
    // Don't expose contextual links on licence tiles on licence comparer and
    // compatibility check assistants.
    unset($build['#contextual_links']);
  }
}
