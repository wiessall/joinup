<?php

/**
 * @file
 * Main functions and hook implementations of the eira module.
 */

declare(strict_types=1);

use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\eira\Entity\Term\Egovera;
use Drupal\eira\Entity\Term\SolutionType;

/**
 * Implements hook_ENTITY_TYPE_view().
 */
function eira_taxonomy_term_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode): void {
  if (!in_array($entity->bundle(), ['egovera', 'eira', 'solution_type'])) {
    return;
  }

  // Enforce eira_format description format for EIRA terms.
  if (empty($build['description'][0]['#text']) || $view_mode !== 'full') {
    return;
  }
  $build['description'][0]['#format'] = 'eira_format';
}

/**
 * Implements hook_entity_bundle_info_alter().
 */
function eira_entity_bundle_info_alter(array &$bundles): void {
  if (isset($bundles['taxonomy_term']['egovera'])) {
    // phpcs:ignore Drupal.Classes.FullyQualifiedNamespace.UseStatementMissing
    $bundles['taxonomy_term']['egovera']['class'] = Egovera::class;
  }
  if (isset($bundles['taxonomy_term']['solution_type'])) {
    $bundles['taxonomy_term']['solution_type']['class'] = SolutionType::class;
  }
}
