<?php

/**
 * @file
 * Hook implementations for the Interoperable Europe community.
 */

declare(strict_types=1);

use Drupal\Core\Form\FormStateInterface;
use Drupal\interoperable_europe\InteroperableEuropeCollectionInterface;
use Drupal\joinup_group\Form\JoinGroupFormInterface;

/**
 * Implements hook_form_FORM_ID_alter().
 *
 * Customizes the button label of the join group form, both for authenticated
 * and anonymous users.
 */
function interoperable_europe_form_join_group_form_alter(&$form, FormStateInterface $form_state, $form_id): void {
  $form_object = $form_state->getFormObject();
  if ($form_object instanceof JoinGroupFormInterface) {
    $group = $form_object->getGroup();
    if ($group->id() === InteroperableEuropeCollectionInterface::COLLECTION_ENTITY_ID) {
      if (isset($form['authenticate']['#title'])) {
        $form['authenticate']['#title'] = t('Subscribe for fresh content');
      }
      if (isset($form['join']['#value'])) {
        $form['join']['#value'] = t('Subscribe for fresh content');
      }
    }
  }
}

/**
 * Implements hook_entity_prepare_view().
 */
function interoperable_europe_entity_prepare_view(string $entity_type_id, array $entities, array $displays, string $view_mode): void {
  if ($entity_type_id !== 'node' || $view_mode !== 'view_mode_tile') {
    return;
  }

  $bundles = ['event'];
  $group = \Drupal::getContainer()->get('og.context')->getGroup();
  if (!$group) {
    return;
  }

  foreach ($entities as $entity) {
    if ($entity->get('og_audience')->target_id !== InteroperableEuropeCollectionInterface::COLLECTION_ENTITY_ID) {
      continue;
    }

    // Only apply the changes for the Interoperable Europe collection pages.
    if ($group->id() !== InteroperableEuropeCollectionInterface::COLLECTION_ENTITY_ID) {
      continue;
    }

    if (!in_array($entity->bundle(), $bundles)) {
      continue;
    }

    if ($component = $displays['event']->getComponent('field_paragraphs_body')) {
      $component['settings']['trim_length'] = 600;
      $displays['event']->setComponent('field_paragraphs_body', $component);
    }
  }
}
