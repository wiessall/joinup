<?php

/**
 * @file
 * Hook implementations for the Interoperable Europe community.
 */

declare(strict_types = 1);

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\collection\Entity\CollectionInterface;
use Drupal\interoperable_europe\InteroperableEuropeCollectionInterface;
use Drupal\interoperable_europe\Plugin\Condition\TemporaryIopCondition;
use Drupal\joinup_group\Form\JoinGroupFormInterface;

/**
 * Implements hook_theme().
 */
function interoperable_europe_theme(): array {
  return [
    // Normally theme suggestion templates are only picked up when they are in
    // themes. We explicitly define a theme suggestion here so that our custom
    // template will be included.
    'rdf_entity__collection__interoperable_europe__group_header' => [
      'render element' => 'elements',
      'base hook' => 'rdf_entity',
    ],
  ];
}

/**
 * Implements hook_form_FORM_ID_alter().
 *
 * Customizes the button label of the join group form, both for authenticated
 * and anonymous users.
 */
function interoperable_europe_form_join_group_form_alter(&$form, FormStateInterface $form_state, $form_id): void {
  $form_object = $form_state->getFormObject();
  if ($form_object instanceof JoinGroupFormInterface) {
    $group = $form_object->getGroup();
    if ($group->id() === InteroperableEuropeCollectionInterface::COLLECTION_ENTITY_ID) {
      if (isset($form['authenticate']['#title'])) {
        $form['authenticate']['#title'] = t('Subscribe for fresh content');
      }
      if (isset($form['join']['#value'])) {
        $form['join']['#value'] = t('Subscribe for fresh content');
      }
    }
  }
}

/**
 * Implements hook_condition_info_alter().
 */
function interoperable_europe_condition_info_alter(array &$definitions): void {
  // Temporary replace the original plugin class to define some exceptions.
  // @see \Drupal\interoperable_europe\Plugin\Condition\TemporaryIopCondition
  $definitions['group_context']['class'] = TemporaryIopCondition::class;
}

/**
 * Implements hook_ENTITY_TYPE_create_access().
 */
function interoperable_europe_paragraph_create_access(AccountInterface $account, array $context, string $entity_bundle): AccessResultInterface {
  if ($entity_bundle !== 'row') {
    return AccessResult::neutral();
  }

  // Only allow rows for interoperable europe for now.
  $group = \Drupal::getContainer()->get('og.context')->getGroup();
  if (!empty($group) && $group->id() === InteroperableEuropeCollectionInterface::COLLECTION_ENTITY_ID) {
    return AccessResult::allowed();
  }

  return AccessResult::forbidden();
}
