<?php

/**
 * @file
 * Hook implementations for the Interoperable Europe community.
 */

declare(strict_types=1);

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\block\BlockInterface;
use Drupal\interoperable_europe\InteroperableEuropeCollectionInterface;
use Drupal\joinup_group\Entity\GroupInterface;
use Drupal\joinup_group\Form\JoinGroupFormInterface;

/**
 * Implements hook_form_FORM_ID_alter().
 *
 * Customizes the button label of the join group form, both for authenticated
 * and anonymous users.
 */
function interoperable_europe_form_join_group_form_alter(&$form, FormStateInterface $form_state, $form_id): void {
  $form_object = $form_state->getFormObject();
  if ($form_object instanceof JoinGroupFormInterface) {
    $group = $form_object->getGroup();
    if ($group->uuid() === InteroperableEuropeCollectionInterface::COLLECTION_UUID) {
      if (isset($form['authenticate']['#title'])) {
        $form['authenticate']['#title'] = t('Subscribe for fresh content');
      }
      if (isset($form['join']['#value'])) {
        $form['join']['#value'] = t('Subscribe for fresh content');
      }
    }
  }
}

/**
 * Implements hook_block_access().
 */
function interoperable_europe_block_access(BlockInterface $block, string $operation, AccountInterface $account): AccessResultInterface {
  if (
    $operation === 'view' &&
    $block->id() === 'iop_three_dots_menu'
  ) {
    $group = \Drupal::service('joinup_group.group_manager')->getGroupFromContext();
    if (
      $group instanceof GroupInterface &&
      $group->uuid() === InteroperableEuropeCollectionInterface::COLLECTION_UUID
    ) {
      /** @var \Drupal\joinup_workflow\WorkflowHelperInterface $workflow_helper */
      $workflow_helper = \Drupal::service('joinup_workflow.workflow_helper');
      return $workflow_helper->checkTransitionAccess($group, $account);
    }
  }

  return AccessResult::neutral();
}
