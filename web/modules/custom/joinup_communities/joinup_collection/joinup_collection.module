<?php

/**
 * @file
 * Main file of Joinup module.
 */

declare(strict_types=1);

use Drupal\Core\Cache\Cache;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\collection\Entity\CollectionInterface;
use Drupal\joinup_collection\JoinupCollectionHelper;
use Drupal\og\Entity\OgMembership;
use Drupal\og\OgMembershipInterface;
use Drupal\rdf_sync\RdfSyncMapper;
use Drupal\user\UserInterface;

/**
 * Implements hook_ENTITY_TYPE_insert().
 *
 * Add the 'Joinup' collection membership to every new user.
 */
function joinup_collection_user_insert(UserInterface $account): void {
  $rdfSyncMapper = \Drupal::service('rdf_sync.mapper');
  assert($rdfSyncMapper instanceof RdfSyncMapper);
  $joinupCollection = $rdfSyncMapper->getEntityByUri(JoinupCollectionHelper::getCollectionId());
  if (!$joinupCollection instanceof CollectionInterface) {
    return;
  }

  // Add the membership only it doesn't exist yet.
  $membership = $joinupCollection->getMembership((int) $account->id(), []);
  if (!$membership) {
    OgMembership::create()
      ->setGroup($joinupCollection)
      ->setOwner($account)
      ->setState(OgMembershipInterface::STATE_ACTIVE)
      ->save();
    return;
  }

  // If the membership exists but is not active, activate it.
  if ($membership->getState() !== OgMembershipInterface::STATE_ACTIVE) {
    $membership->setState(OgMembershipInterface::STATE_ACTIVE)->save();
  }
}

/**
 * Implements hook_form_BASE_FORM_ID_alter().
 *
 * Remove the 'joinup_og_membership_delete_action' action.
 */
function joinup_collection_form_views_form_og_members_overview_default_alter(&$form, FormStateInterface $form_state, $form_id): void {
  /** @var \Drupal\views\ViewExecutable $view */
  $view = $form_state->getBuildInfo()['args'][0];
  // The first view argument is the entity type.
  if (isset($view->args[0]) && $view->args[0] === 'node') {
    $rdfSyncMapper = \Drupal::service('rdf_sync.mapper');
    assert($rdfSyncMapper instanceof RdfSyncMapper);
    $joinupCollection = $rdfSyncMapper->getEntityByUri(JoinupCollectionHelper::getCollectionId());
    // The second view argument is the group entity ID.
    if (
      $joinupCollection &&
      !empty($view->args[1]) &&
      $view->args[1] == $joinupCollection->id()
    ) {
      unset($form['header']['og_membership_bulk_form']['action']['#options']['joinup_og_membership_delete_action']);
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_insert().
 */
function joinup_collection_node_insert(EntityInterface $entity): void {
  // Invalidate a custom cache tag, used to rebuild the hamburger menu so that
  // the 'About us' link can be shown depending on whether the Joinup collection
  // exists. Mainly intended for tests since in the production site the Joinup
  // collection is not regularly deleted.
  if (!$entity instanceof CollectionInterface) {
    return;
  }
  $rdfSyncMapper = \Drupal::service('rdf_sync.mapper');
  assert($rdfSyncMapper instanceof RdfSyncMapper);
  $uriField = $rdfSyncMapper->getRdfUriFieldName('node', 'collection');
  if ($entity->get($uriField)->first()->getString() === JoinupCollectionHelper::getCollectionId()) {
    Cache::invalidateTags(['joinup_collection:exists']);
  }
}

/**
 * Implements hook_ENTITY_TYPE_delete().
 */
function joinup_collection_node_delete(EntityInterface $entity): void {
  joinup_collection_node_insert($entity);
}
