{#
/**
 * @file
 * Default theme implementation of catalogue_provider.
 *
 * Available variables:
 * - provider: Provider object.
 * - type: Provider type.
 * - country: Optional country.
 * - description: Propvider description.
 * - wenlinks: Array of links.
 *
 * @ingroup themeable
 */
#}

<div class="catalogue-provider">

  <p>
    <strong>{{ 'Type:'|t }}</strong> {{ type }}
  </p>

  {% if country %}
    <p>
      <strong>{{ 'Country:'|t }}</strong> {{ country }}
    </p>
  {% endif %}

  <div>
    <strong>{{ 'Description:'|t }}</strong>
    {{ description }}
  </div>

  <div>
    <strong>{{ 'Weblinks:'|t }}</strong>
    <ul>
      {% for weblink in weblinks %}
        <li>{{ weblink }}</li>
      {% endfor %}
    </ul>
  </div>

</div>
