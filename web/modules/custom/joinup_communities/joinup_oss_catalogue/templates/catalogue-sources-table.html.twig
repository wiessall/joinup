{#
/**
 * @file
 * Default theme implementation of catalogue_source_table.
 *
 * Available variables:
 * - providers: Provider objects.
 *
 * @ingroup themeable
 */
#}

<div class="catalogue-source-table">
  <div class="table-responsive">
    <table id="oss-catalogue-list" class="table table-hover">
      <thead>
      <tr>
        <th>{{ 'Catalogue'|t }}</th>
        <th>{{ 'Type'|t }}</th>
        <th>{{ 'Country'|t }}</th>
        <th>{{ 'Description'|t }}</th>
        <th>{{ 'Weblinks'|t }}</th>
      </tr>
      </thead>
      <tbody>
      {% for plugin_id, provider in providers %}
        <tr id="oss-catalogue-source-{{ plugin_id }}">
          {% for key, value in provider %}
            <td>{{ value }}</td>
          {% endfor %}
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</div>
