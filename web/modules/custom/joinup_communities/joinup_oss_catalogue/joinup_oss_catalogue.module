<?php

/**
 * @file
 * Main file of Joinup OSS Catalogue module.
 */

declare(strict_types = 1);

use Drupal\block\BlockInterface;
use Drupal\collection\Entity\CollectionInterface;
use Drupal\Core\Access\AccessResult;
use Drupal\Core\Cache\Cache;
use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\Core\Session\AccountInterface;
use Drupal\joinup_group\Entity\GroupInterface;
use Drupal\joinup_oss_catalogue\Entity\JoinupOssSolution;
use Drupal\joinup_oss_catalogue\OssCatalogueCollectionInterface;
use Drupal\joinup_oss_catalogue\Plugin\Field\ShortDescriptionWithFallback;

/**
 * Implements hook_views_plugins_argument_alter().
 */
function joinup_oss_catalogue_views_plugins_argument_alter(array &$plugins): void {
  // We don't want to apply a group contextual filter for search_oss_catalogue
  // view. The contextual filter is added only for validation.
  // @see joinup_group_views_data_alter()
  // @see \Drupal\joinup_group\Plugin\views\argument\SearchApiGroupArgument
  $plugins['search_api_group']['exceptions'][] = 'search_oss_catalogue';
}

/**
 * Implements hook_entity_bundle_info_alter().
 */
function joinup_oss_catalogue_entity_bundle_info_alter(array &$bundles): void {
  if (!empty($bundles['node']['oss_solution'])) {
    $bundles['node']['oss_solution']['class'] = JoinupOssSolution::class;
  }
}

/**
 * Implements hook_entity_extra_field_info().
 */
function joinup_oss_catalogue_entity_extra_field_info(): array {
  $fields = [];
  $fields['rdf_entity']['collection']['display']['oss_solutions'] = [
    'label' => t('Amount of OpenSource Solutions'),
    'description' => t('Amount of OpenSource Solutions.'),
    'visible' => FALSE,
  ];
  return $fields;
}

/**
 * Implements hook_ENTITY_TYPE_view().
 *
 * Shows extra fields for the collection bundle.
 */
function joinup_oss_catalogue_rdf_entity_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, string $view_mode): void {
  if (!$entity instanceof CollectionInterface && $entity->id() === OssCatalogueCollectionInterface::COLLECTION_ENTITY_ID) {
    return;
  }

  // OSS Solution count.
  if ($display->getComponent('oss_solutions')) {
    $oss_solution_count = \Drupal::entityTypeManager()->getStorage('node')
      ->getQuery()
      ->accessCheck()
      ->condition('status', 1)
      ->condition('type', 'oss_solution')
      ->condition('langcode', 'en')
      ->count()
      ->execute();
    $markup = $oss_solution_count === 0 ?
      \Drupal::translation()->translate('No Open Source Software Solutions were federated yet') :
      \Drupal::translation()->formatPlural(
        $oss_solution_count,
        '@oss_solution_count Open Source Software Solution',
        '@oss_solution_count Open Source Software Solutions',
        ['@oss_solution_count' => $oss_solution_count],
      );
    $build['oss_solutions'] = [
      '#markup' => $markup,
    ];
    (new CacheableMetadata())
      ->addCacheTags(Cache::buildTags('og-group-content', $entity->getCacheTagsToInvalidate()))
      ->addCacheTags(['rdf_entity_list', 'node_list:oss_solution'])
      ->applyTo($build['oss_solutions']);

  }
}

/**
 * Implements hook_block_access().
 */
function joinup_oss_catalogue_block_access(BlockInterface $block, string $operation, AccountInterface $account) {
  if (
    $operation === 'view' &&
    $block->id() === 'ventuno_three_dots_menu' &&
    $account->isAnonymous()
  ) {

    $group = \Drupal::service('joinup_group.group_manager')
      ->getGroupFromContext();
    if ($group && $group->id() === OssCatalogueCollectionInterface::COLLECTION_ENTITY_ID) {
      return AccessResult::forbidden();
    }
  }
}

/**
 * Implements hook_preprocess_facets_item_list__checkbox__oss_source().
 */
function joinup_oss_catalogue_preprocess_facets_item_list__checkbox__oss_source(array &$variables): void {
  $descriptions = \Drupal::service('plugin.manager.eu_oss_catalogue.provider')->getDefinitionsAsOptions('description');
  foreach ($variables['items'] as &$item) {
    $provider = $item['value']['#attributes']['data-drupal-facet-item-value'];
    if ($provider && isset($descriptions[$provider])) {
      $item['attributes']['title'] = $descriptions[$provider];
    }
  }
}

/**
 * Implements hook_entity_bundle_field_info().
 */
function joinup_oss_catalogue_entity_bundle_field_info(EntityTypeInterface $entity_type, $bundle): array {
  $fields = [];
  if ($entity_type->id() === 'node' && $bundle === 'oss_solution') {
    $fields['description'] = BaseFieldDefinition::create('string_long')
      ->setLabel(t('Short description'))
      ->setComputed(TRUE)
      ->setDisplayConfigurable('view', TRUE)
      ->setClass(ShortDescriptionWithFallback::class);
  }
  return $fields;
}

/**
 * Implements hook_preprocess_HOOK().
 */
function joinup_oss_catalogue_preprocess_node(array &$variables): void {
  // Disables the "Report" link for OSS pages.
  $group = \Drupal::routeMatch()->getParameter('rdf_entity');
  if (
    $group instanceof GroupInterface &&
    $group->id() === OssCatalogueCollectionInterface::COLLECTION_ENTITY_ID
  ) {
    $variables['content']['report']['#access'] = FALSE;
  }
}
