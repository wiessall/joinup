<?php

/**
 * @file
 * Install, update, and uninstall functions for the Joinup core module.
 */

declare(strict_types=1);

/**
 * Implements hook_requirements().
 */
function joinup_core_requirements($phase): array {
  $requirements = [];

  if ($phase === 'runtime') {
    if (\Drupal::moduleHandler()->moduleExists('dblog')) {
      $requirements['joinup_core_dblog'] = [
        'title' => t('Database logging'),
        'description' => t('On production environments logs should be written to a file, not to the database.'),
        'severity' => REQUIREMENT_ERROR,
        'value' => t('Database logging is enabled'),
      ];
    }
  }

  return $requirements;
}

/**
 * Remove configuration for the removed discussion_comment REST resource.
 */
function joinup_core_update_200800(): string {
  // The webform_update_8648 updates roles with a given permission. The
  // developer role, being an admin, has all permissions so it tries to grant
  // them a new permission. This triggers a series of events that collects all
  // permissions according to all providers, one of which is the rest module.
  // The removed discussion_comment REST resource is still registered there
  // during the update process, causing a plugin not found exception, as the
  // class does not exist yet. To avoid this, we delete the configuration here
  // before  the rest module collects permissions.
  $config_to_delete = 'rest.resource.discussion_comment';
  $config_to_delete = \Drupal::configFactory()->getEditable($config_to_delete);
  $config_to_delete->delete();
  return 'Configuration for the removed discussion_comment REST resource has been deleted.';
}
