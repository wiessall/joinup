<?php

/**
 * @file
 * Install, update, and uninstall functions for the Joinup core module.
 */

declare(strict_types=1);

use Drupal\joinup_core\SharedInUpdateHelper;

/**
 * Implements hook_requirements().
 */
function joinup_core_requirements($phase): array {
  $requirements = [];

  if ($phase === 'runtime') {
    if (\Drupal::moduleHandler()->moduleExists('dblog')) {
      $requirements['joinup_core_dblog'] = [
        'title' => t('Database logging'),
        'description' => t('On production environments logs should be written to a file, not to the database.'),
        'severity' => REQUIREMENT_ERROR,
        'value' => t('Database logging is enabled'),
      ];
    }
  }

  return $requirements;
}

/**
 * Implements hook_update_dependencies().
 */
function joinup_core_update_dependencies(): array {
  $dependencies['joinup_core'][200402] = [
    'joinup_core' => 200401,
  ];
  $dependencies['joinup_core'][200403] = [
    'joinup_core' => 200402,
  ];
  return $dependencies;
}

/**
 * Install the meta entity type which stores shares.
 */
function joinup_core_update_200401(): void {
  SharedInUpdateHelper::installFromConfigSync(
    'meta_entity.type.shared_in.yml',
  );
}

/**
 * Install the meta entity field storage where shares are stored.
 */
function joinup_core_update_200402(): void {
  SharedInUpdateHelper::installFromConfigSync(
    'field.storage.meta_entity.field_shared_in.yml',
  );
}

/**
 * Install the sharing meta entity's field_shared_in field instance.
 */
function joinup_core_update_200403(): void {
  SharedInUpdateHelper::installFromConfigSync(
    'field.field.meta_entity.shared_in.field_shared_in.yml',
  );
}
