<?php

/**
 * @file
 * Install, update, and uninstall functions for the Joinup core module.
 */

declare(strict_types=1);

use Drupal\taxonomy\Entity\Term;

/**
 * Implements hook_requirements().
 */
function joinup_core_requirements($phase): array {
  $requirements = [];

  if ($phase === 'runtime') {
    if (\Drupal::moduleHandler()->moduleExists('dblog')) {
      $requirements['joinup_core_dblog'] = [
        'title' => t('Database logging'),
        'description' => t('On production environments logs should be written to a file, not to the database.'),
        'severity' => REQUIREMENT_ERROR,
        'value' => t('Database logging is enabled'),
      ];
    }
  }

  return $requirements;
}

/**
 * Replace rdf uri with term ID in paragraph content listing.
 */
function joinup_core_update_200400(): void {
  $database = \Drupal::database();
  $messenger = \Drupal::messenger();

  $query = $database->select('paragraph__content_listing', 'p')
    ->fields('p', ['entity_id', 'content_listing_value'])
    ->condition('p.content_listing_value', '%topic|http%', 'LIKE');
  $results = $query->execute()->fetchAll();

  $rowsUpdated = 0;

  foreach ($results as $row) {
    $data = unserialize($row->content_listing_value, ['allowed_classes' => FALSE]);

    if (preg_match_all('/http:\/\/[^,\s|\r]+/', $data['query_presets'], $matches)) {
      foreach ($matches[0] as $uri) {
        $query = $database->select('rdf_sync_uri', 'rsu')
          ->fields('rsu', ['entity_id'])
          ->condition('rsu.uri', $uri, '=')
          ->range(0, 1);
        $result = $query->execute()->fetchAll();
        $term = reset($result);
        if (!empty($term->entity_id)) {
          $topic = Term::load($term->entity_id);
          $data['query_presets'] = str_replace($uri, $topic->getName(), $data['query_presets']);
        }
        else {
          $data['query_presets'] = str_replace('topic|' . $uri, '', $data['query_presets']);
        }
      }

      $serializedData = serialize($data);

      $database->update('paragraph__content_listing')
        ->fields(['content_listing_value' => $serializedData])
        ->condition('entity_id', $row->entity_id)
        ->execute();
      $rowsUpdated++;
      $messenger->addMessage("Entity ID: {$row->entity_id} was updated");
    }
  }

  $messenger->addMessage(t('@count rows updated in paragraph__content_listing.', ['@count' => $rowsUpdated]));
}

/**
 * Remove rdf sync for topic vocabulary.
 */
function joinup_core_update_200401(): string {
  $query = \Drupal::database()->select('rdf_sync_uri', 'r')
    ->fields('r', ['entity_id'])
    ->condition('bundle', 'topic');

  $result = $query->execute();
  $tids = $result->fetchCol();

  if (!isset($sandbox['total'])) {
    $sandbox['total'] = count($tids);
    $sandbox['current'] = 0;
  }

  if (!empty($tids)) {
    $terms = Term::loadMultiple($tids);
    foreach ($terms as $term) {
      rdf_sync_entity_delete($term);
    }
    $sandbox['current'] += count($tids);

    if ($sandbox['current'] >= $sandbox['total']) {
      return sprintf('Deletion of RDF storage for \"topic\" vocabulary completed. %d records removed.', $sandbox['total']);
    }
  }
}
