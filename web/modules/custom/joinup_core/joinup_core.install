<?php

/**
 * @file
 * Install, update, and uninstall functions for the Joinup core module.
 */

declare(strict_types=1);

/**
 * Implements hook_requirements().
 */
function joinup_core_requirements($phase): array {
  $requirements = [];

  if ($phase === 'runtime') {
    if (\Drupal::moduleHandler()->moduleExists('dblog')) {
      $requirements['joinup_core_dblog'] = [
        'title' => t('Database logging'),
        'description' => t('On production environments logs should be written to a file, not to the database.'),
        'severity' => REQUIREMENT_ERROR,
        'value' => t('Database logging is enabled'),
      ];
    }

    // Warn when the RDF synchronization to Virtuoso is switched off, as entity
    // changes are then not propagated to the SPARQL endpoint and the two stores
    // drift apart.
    if (\Drupal::moduleHandler()->moduleExists('rdf_sync')
      && !\Drupal::service('rdf_sync.synchronizer')->isSynchronizationEnabled()) {
      $requirements['joinup_core_rdf_sync'] = [
        'title' => t('RDF synchronization'),
        'description' => t('Synchronization of entities to the Virtuoso RDF store is disabled. Changes are not being propagated to the SPARQL endpoint and the relational and triple stores will drift apart until it is re-enabled.'),
        'severity' => REQUIREMENT_WARNING,
        'value' => t('Disabled'),
      ];
    }
  }

  return $requirements;
}

/**
 * Delete visit_count and download_count meta entities before config sync.
 */
function joinup_core_update_201500(array &$sandbox): string {
  $database = \Drupal::database();
  $bundles = ['visit_count', 'download_count'];

  if (!isset($sandbox['total'])) {
    $sandbox['total'] = (int) $database->select('meta_entity', 'm')
      ->condition('type', $bundles, 'IN')
      ->countQuery()
      ->execute()
      ->fetchField();
    $sandbox['deleted'] = 0;
  }

  if ($sandbox['total'] === 0) {
    $sandbox['#finished'] = 1;
    return 'No visit_count/download_count meta entities to delete.';
  }

  $ids = $database->select('meta_entity', 'm')
    ->fields('m', ['id'])
    ->condition('type', $bundles, 'IN')
    ->range(0, 5000)
    ->execute()
    ->fetchCol();

  if ($ids) {
    $schema = $database->schema();
    if ($schema->tableExists('meta_entity__count')) {
      $database->delete('meta_entity__count')
        ->condition('entity_id', $ids, 'IN')
        ->execute();
    }
    if ($schema->tableExists('meta_entity__target')) {
      $database->delete('meta_entity__target')
        ->condition('entity_id', $ids, 'IN')
        ->execute();
    }
    $database->delete('meta_entity_field_data')
      ->condition('id', $ids, 'IN')
      ->execute();
    $database->delete('meta_entity')
      ->condition('id', $ids, 'IN')
      ->execute();
    $sandbox['deleted'] += count($ids);
  }

  $sandbox['#finished'] = (!$ids || $sandbox['deleted'] >= $sandbox['total'])
    ? 1
    : ($sandbox['deleted'] / $sandbox['total']);

  return sprintf('Deleted %d/%d visit_count/download_count meta entities.', $sandbox['deleted'], $sandbox['total']);
}
