<?php

/**
 * @file
 * Install, update, and uninstall functions for the Joinup core module.
 */

declare(strict_types=1);

/**
 * Implements hook_requirements().
 */
function joinup_core_requirements($phase): array {
  $requirements = [];

  if ($phase === 'runtime') {
    if (\Drupal::moduleHandler()->moduleExists('dblog')) {
      $requirements['joinup_core_dblog'] = [
        'title' => t('Database logging'),
        'description' => t('On production environments logs should be written to a file, not to the database.'),
        'severity' => REQUIREMENT_ERROR,
        'value' => t('Database logging is enabled'),
      ];
    }
  }

  return $requirements;
}

/**
 * Backup keyword values.
 */
function joinup_core_update_200500(): string {
  $keywords = \Drupal::database()->select('node__field_keywords', 'k')
    ->fields('k')
    ->execute()
    ->fetchAll(\PDO::FETCH_OBJ);

  $backup = [];
  // Fields returned by the query are:
  // entity_id, revision_id, bundle, delta, field_keywords_value.
  foreach ($keywords as $data) {
    $backup[$data->entity_id][] = [
      'entity_id' => $data->entity_id,
      'revision_id' => $data->revision_id,
      'bundle' => $data->bundle,
      'delta' => $data->delta,
      'field_keywords_value' => $data->field_keywords_value,
    ];
  }

  \Drupal::state()->set('joinup_core.keywords', $backup);
  return 'Keywords have been backed up.';
}
