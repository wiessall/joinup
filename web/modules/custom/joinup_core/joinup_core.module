/**
 * Implements hook_theme().
 */
function joinup_core_theme(array $existing, string $type, string $theme, string $path): array {
  return [
    '404_not_found' => [
      'variables' => [],
    ],
    'download_link' => [
      'variables' => [
        'attributes' => [],
        'extension' => '',
        'url' => NULL,
        'title' => '',
      ],
    ],
    'vertical_table' => [
      'variables' => [
        'attributes' => [],
        'rows' => [],
      ],
    ],
    'field__in_modal' => [
      'base hook' => 'field',
    ],
  ];
}

/**
 * Implements hook_requirements_alter().
 */
function joinup_core_requirements_alter(array &$requirements): void {
  $ignored = getenv('DRUPAL_STATUS_REPORT_IGNORE') ?: 'conflicting emails,update status,search_api_solr_schema_joinup_modifications,metatag_maintenance_mode,webform_libraries,output_buffering,deprecated_modules,field_group_jquery_ui_accordion,media_insecure_iframe';
  $ignored = array_map('trim', explode(',', $ignored));

  $requirements = array_filter($requirements, function (string $requirement) use ($ignored): bool {
    return !in_array($requirement, $ignored, TRUE);
  }, ARRAY_FILTER_USE_KEY);
}

/**
 * Implements hook_cron().
 */
function joinup_core_cron(): void {
  \Drupal::getContainer()->get('batch.storage')->cleanup();
}

/**
 * Implements hook_node_links_alter().
 */
function joinup_core_node_links_alter(array &$links, NodeInterface $entity, array &$context): void {
  if (isset($links['comment__field_comments']['#links']['comment-add'])) {
    unset($links['comment__field_comments']['#links']['comment-add']);
  }
  if (isset($links['comment__field_replies']['#links']['comment-add'])) {
    unset($links['comment__field_replies']['#links']['comment-add']);
  }
}

/**
 * Implements hook_field_formatter_info_alter().
 *
 * - Make sure the standard formatter for links can be used for the link that is
 *   used to report inappropriate content.
 */
function joinup_core_field_formatter_info_alter(array &$info): void {
  $info['link']['field_types'][] = 'report_link';
  $allPluginIds = array_keys(\Drupal::service('plugin.manager.field.field_type')->getDefinitions());

  foreach (['joinup_core_more_in_modal', 'joinup_core_item_count'] as $id) {
    if (isset($info[$id])) {
      $info[$id]['field_types'] = $allPluginIds;
    }
  }
}

/**
 * Implements hook_element_info_alter().
 *
 * Override the validate handler for the datetime widget in order to show a
 * custom validation message when part of the widget is not filled in.
 */
function joinup_core_element_info_alter(array &$info): void {
  if (isset($info['datetime'])) {
    $info['datetime']['#element_validate'] = [
      [
        Datetime::class,
        'validateDatetime',
      ],
    ];
  }
}

/**
 * Implements hook_ENTITY_TYPE_delete().
 *
 * File entities might have file system redirects coming from previous platform
 * versions, following this pattern (relative to files directory):
 * @code
 * legacy/path/to/image.png -> actual/path/to/image.png
 * @endcode
 * Such redirects are not cleared automatically by the Redirect module, when the
 * source file entity is deleted, thus we're fulfilling this task here.
 */
function joinup_core_file_delete(EntityInterface $entity): void {
  /** @var \Drupal\file\FileInterface $entity */
  $uri = $entity->getFileUri();
  $scheme = StreamWrapperManager::getScheme($uri);
  $current_user = \Drupal::currentUser();
  $current_time = \Drupal::time()->getRequestTime();
  $group = \Drupal::service('og.context')->getGroup();
  $path = 'base:/' . \Drupal::service('stream_wrapper.public')->getDirectoryPath() . '/' . StreamWrapperManager::getTarget($uri);
  \Drupal::service('logger.channel.group_membership')->info('The file @filepath has been deleted.', [
    '@type' => $entity->bundle(),
    '@title' => $entity->label(),
    '@group' => $group ? $group->label() : NULL,
    '@user' => $current_user->getDisplayName(),
    '@filepath' => $path,
    '@deleted_time' => date('Y-m-d H:i:s', $current_time),
    'type' => 'joinup:delete_file',
    'actor' => $current_user->id(),
  ]);

  if ($scheme !== 'public') {
    return;
  }
  // Delete all redirects targeting this path.
  redirect_delete_by_path($path);
}

/**
 * Implements hook_preprocess_HOOK().
 *
 * @see template_preprocess_image_formatter()
 */
function joinup_core_preprocess_image_formatter(&$variables): void {
  if ($variables['image']['#alt'] === NULL) {
    $variables['image']['#alt'] = '';
  }
}

/**
 * Implements hook_preprocess_HOOK().
 *
 * @see template_preprocess_responsive_image_formatter()
 */
function joinup_core_preprocess_responsive_image_formatter(&$variables): void {
  if ($variables['responsive_image']['#attributes']['alt'] === NULL) {
    $variables['responsive_image']['#attributes']['alt'] = '';
  }
}

/**
 * Implements hook_module_implements_alter().
 */
function joinup_core_module_implements_alter(array &$implementations, $hook): void {
  switch ($hook) {
    case 'block_view_system_menu_block_alter':
      // Do not show the contextual links to edit menus. This functionality is
      // used very rarely, but the contextual links menu causes visual clutter.
      unset($implementations['menu_ui']);
      break;

    case 'mail_alter':
      if (array_key_exists('joinup_core', $implementations)) {
        $our = $implementations['joinup_core'];
        unset($implementations['joinup_core']);
        $implementations['joinup_core'] = $our;
      }
  }
}

/**
 * Implements hook_block_access().
 *
 * Determines on which pages to show the Webtools eTrans block. Not all pages
 * are suitable for machine translation.
 *
 * This is handled using a custom access check rather than configuring block
 * visibility conditions in the block UI since we need to check conditions
 * across several domains. This is not possible in the UI because the conditions
 * are compared using "AND" logic.
 *
 * @see https://www.drupal.org/project/drupal/issues/923934
 */
function joinup_core_block_access(BlockInterface $block, string $operation, AccountInterface $account): AccessResultInterface {
  if ($operation === 'view' && $block->id() === 'three_dots_menu') {
    /** @var \Drupal\joinup_core\LocalTaskLinksHelperInterface $local_task_links_helper */
    $local_task_links_helper = \Drupal::service('joinup_core.local_task_links_helper');
    // A local tasks block can be either a horizontal tabs menu or a three-dots
    // menu. Both are not possible on the same page. In order to determine the
    // pages with horizontal tabs, the 'horizontal_tabs' block visibility should
    // be edited. All others pages will show the local tasks as three-dots menu.
    // Avoid the redundancy of maintaining the visibility also for the
    // 'three_dots_menu' block by implementing this hook.
    return $local_task_links_helper->allowThreeDotsMenu();
  }

  if ($operation !== 'view' || $block->getPluginId() !== 'oe_webtools_etrans') {
    return AccessResult::neutral();
  }

  // Check if we are on a route that is suitable for machine translation.
  $build = [];
  $etrans_config = joinup_core_get_etrans_block_config_for_current_page($build);

  if (!empty($etrans_config)) {
    $cache_meta = CacheableMetadata::createFromRenderArray($build);
    return AccessResult::allowed()
      ->addCacheableDependency($cache_meta);
  }
  return AccessResult::forbidden();
}

/**
 * Implements hook_block_build_BASE_BLOCK_ID_alter().
 *
 * Ensures that the Webtools eTrans block varies by route, since we are altering
 * the block configuration depending on the route.
 *
 * @see \joinup_core_block_view_oe_webtools_etrans_alter()
 */
function joinup_core_block_build_oe_webtools_etrans_alter(array &$build, BlockPluginInterface $block): void {
  $cacheable_metadata = CacheableMetadata::createFromRenderArray($build);
  $cacheable_metadata->addCacheContexts(['route']);
  $cacheable_metadata->applyTo($build);
}

/**
 * Implements hook_block_view_BASE_BLOCK_ID_alter().
 *
 * Tailors the HTML elements that need to be translated by the Webtools eTrans
 * service to the type of the current page.
 */
function joinup_core_block_view_oe_webtools_etrans_alter(array &$build, BlockPluginInterface $block): void {
  $block->setConfiguration(joinup_core_get_etrans_block_config_for_current_page($build) + $block->getConfiguration());
}

/**
 * Returns the Webtools eTrans block configuration for the current page.
 *
 * @param array $build
 *   The renderable array to merge the cache metadata into.
 *
 * @return array
 *   The Webtools eTrans block configuration.
 *
 * @see \Drupal\oe_webtools_etrans\Plugin\Block\ETransBlock
 */
function joinup_core_get_etrans_block_config_for_current_page(array &$build = []): array {
  $current_route_name = \Drupal::routeMatch()->getRouteName();
  if (array_key_exists($current_route_name, ETransBlockConfiguration::CONFIG_MAPPING['routes'])) {
    return ETransBlockConfiguration::CONFIG_MAPPING['routes'][$current_route_name];
  }

  /** @var \Drupal\Core\Plugin\Context\ContextRepositoryInterface $context_repository */
  $context_repository = \Drupal::service('context.repository');
  $contexts = $context_repository->getRuntimeContexts(
    [
      '@node.node_route_context:node',
    ]
  );
  $cachableMetadata = CacheableMetadata::createFromRenderArray($build);
  $etransConfig = [];

  foreach ($contexts as $context) {
    if (!$context->hasContextValue()) {
      continue;
    }

    $entity = $context->getContextValue();
    $cachableMetadata->addCacheableDependency($entity);
    if (!str_ends_with($current_route_name, '.canonical')) {
      continue;
    }
    // Groups might have custom landing page.
    if ($entity instanceof GroupInterface) {
      try {
        $entity = $entity->getSetting('landing_page')->entity ?? $entity;
      }
      catch (\InvalidArgumentException) {
      }
    }
    foreach (ETransBlockConfiguration::CONFIG_MAPPING['bundles'] as $bundleClass => $config) {
      if ($entity instanceof $bundleClass) {
        $cachableMetadata->addCacheableDependency($entity);
        $etransConfig = $config;
        break 2;
      }
    }
  }

  $cachableMetadata->applyTo($build);
  return $etransConfig;
}

/**
 * Implements hook_theme_suggestions_alter().
 */
function joinup_core_theme_suggestions_alter(array &$suggestions, array $variables, string $hook): void {
  static $horizontal_tabs_access;
  if (!in_array($hook, ['menu_local_task', 'menu_local_tasks'], TRUE)) {
    return;
  }

  if (!isset($horizontal_tabs_access)) {
    /** @var \Drupal\joinup_core\LocalTaskLinksHelperInterface $local_task_links_helper */
    $local_task_links_helper = \Drupal::service('joinup_core.local_task_links_helper');
    $horizontal_tabs_access = $local_task_links_helper->allowHorizontalTabs();
  }

  if ($horizontal_tabs_access->isNeutral()) {
    return;
  }
  elseif ($horizontal_tabs_access->isAllowed()) {
    $suggestions[] = "{$hook}__horizontal_tabs";
    return;
  }
  $suggestions[] = "{$hook}__three_dots_menu";
}

/**
 * Implements hook_entity_base_field_info().
 *
 * - Provides a 'report' field on community content pages that can be used to
 *   report inappropriate content.
 */
function joinup_core_entity_base_field_info(EntityTypeInterface $entity_type): array {
  $fields = [];

  // Add a 'report' field to community content entities. Currently all node
  // types are community content.
  if ($entity_type->id() === 'node') {
    $fields['report'] = BaseFieldDefinition::create('report_link')
      ->setName('report')
      ->setLabel(t('Report'))
      ->setComputed(TRUE)
      ->setClass(ReportLinkFieldItemList::class)
      ->setDisplayConfigurable('view', TRUE)
      ->setDisplayOptions('view', [
        'label' => 'hidden',
        'weight' => 50,
        'settings' => [
          'trim_length' => 80,
          'url_only' => FALSE,
          'url_plain' => FALSE,
          'rel' => '',
          'target' => '',
        ],
      ]);
  }

  return $fields;
}

/**
 * Implements hook_entity_bundle_field_info().
 */
function joinup_core_entity_bundle_field_info(EntityTypeInterface $entity_type, ?string $bundle, array $base_field_definitions): array {
  $fields = [];
  $threshold = \Drupal::config('joinup_core.outdated_content_threshold')->get("thresholds.{$entity_type->id()}.$bundle");
  if ($threshold) {
    $fields['outdated_time'] = BaseFieldDefinition::create('timestamp')
      ->setLabel(t('Outdated time'))
      ->setDescription(t('A date/time when this content will become outdated.'))
      ->setComputed(TRUE)
      ->setRequired(FALSE)
      ->setClass(OutdatedContentFieldItemList::class)
      ->setCardinality(1)
      ->setDefaultValue(NULL);
  }

  $permalink_bundles = [
    'node' => [
      'assessment_report',
      'custom_page',
      'discussion',
      'distribution',
      'document',
      'event',
      'licence',
      'news',
      'release',
    ],
    'comment' => ['comment', 'reply'],
  ];
  if (in_array($bundle, $permalink_bundles[$entity_type->id()] ?? [])) {
    $fields['permalink'] = BaseFieldDefinition::create('link')
      ->setLabel(t('Permalink'))
      ->setDescription(t('The permalink for the entity.'))
      ->setComputed(TRUE)
      ->setRequired(FALSE)
      ->setClass(PermalinkFieldItemList::class)
      ->setCardinality(1)
      ->setDefaultValue(NULL)
      ->setSettings([
        'link_type' => LinkItemInterface::LINK_EXTERNAL,
        'title' => DRUPAL_DISABLED,
      ])
      ->setDisplayConfigurable('form', FALSE)
      ->setDisplayConfigurable('display', FALSE);
  }

  return $fields;
}

/**
 * Implements hook_entity_view_alter().
 */
function joinup_core_entity_view_alter(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display): void {
  // Don't show information about outdated content if entity is archived.
  if ($entity instanceof ArchivableEntityInterface && $entity->isArchived()) {
    return;
  }

  if ($entity instanceof OutdatedContentInterface && $display->getMode() === 'default') {
    /** @var \Drupal\Core\Entity\EntityTypeBundleInfoInterface $bundle_info */
    $bundle_info = \Drupal::service('entity_type.bundle.info');
    $bundle_singular_label = $bundle_info->getBundleInfo($entity->getEntityTypeId())[$entity->bundle()]['label_singular'];
    $build['#attached']['drupalSettings']['outdatedContent'] = [
      'outdatedTime' => $entity->getOutdatedTime(),
      'publicationTime' => $entity->getPublicationTime(),
      'bundle' => $bundle_singular_label,
    ];
    $build['#attached']['library'][] = 'joinup_core/outdated_content';

    // Invalidate the cache when the outdated content thresholds are changing.
    CacheableMetadata::createFromRenderArray($build)
      ->addCacheableDependency(\Drupal::config('joinup_core.outdated_content_threshold'))
      ->applyTo($build);
  }
}

/**
 * Implements hook_menu_local_tasks_alter().
 */
function joinup_core_menu_local_tasks_alter(&$data, $route_name, RefinableCacheableDependencyInterface &$cacheability): void {
  $routes = [
    'entity.node.canonical',
    'entity.user.canonical',
  ];
  if (in_array($route_name, $routes) && isset($data['tabs'][0][$route_name])) {
    $data['tabs'][0][$route_name]['#access'] = AccessResult::forbidden();
  }
}

/**
 * Implements hook_page_attachments().
 */
function joinup_core_page_attachments(array &$attachments): void {
  // As Joinup uses multiple themes, we pass the active theme to the page to be
  // used in various contexts.
  $attachments['#attached']['drupalSettings']['theme'] = \Drupal::theme()->getActiveTheme()->getName();
}

/**
 * Implements hook_field_widget_info_alter().
 */
function joinup_core_field_widget_info_alter(array &$info): void {
  if (isset($info['image_library_widget'])) {
    $info['image_library_widget']['class'] = ImageLibraryWidget::class;
  }
}

/**
 * Implements hook_mail_alter().
 */
function joinup_core_mail_alter(&$message): void {
  if (
    empty($message['headers']['Content-Type']) ||
    $message['headers']['Content-Type'] !== MailContentTypeHeader::TextHtml->value
  ) {
    return;
  }

  // Transform body lines not wrapped in block-level HTML tags to paragraphs
  // in HTML mails.
  $html_mail_body = implode(PHP_EOL . PHP_EOL, $message['body']);
  $message['body'] = [Markup::create(_filter_autop($html_mail_body))];
}

/**
 * Implements hook_field_widget_single_element_WIDGET_TYPE_form_alter().
 */
function joinup_core_field_widget_single_element_tagify_entity_reference_autocomplete_widget_form_alter(array &$element, FormStateInterface $form_state, array $context): void {
  // Remove the "Drag to re-order @entity_types." mention in description.
  /* @see \Drupal\tagify\Plugin\Field\FieldWidget\TagifyEntityReferenceAutocompleteWidget::formElement */
  $items = $context['items'];
  \assert($items instanceof FieldItemListInterface);
  $element['#description'] = FieldFilteredMarkup::create(\Drupal::token()->replace((string) $items->getFieldDefinition()->getDescription()));
}

/**
 * Implements hook_inline_entity_form_reference_form_alter().
 */
function joinup_core_inline_entity_form_reference_form_alter(array &$reference_form, FormStateInterface $form_state): void {
  // Avoid showing two labels one after each other.
  $reference_form['entity_id']['#title_display'] = 'invisible';
}

/**
 * Implements hook_field_widget_inline_entity_form_complex_form_alter().
 *
 * Simplifies the widget buttons when only a bundle is configured.
 */
function joinup_core_field_widget_inline_entity_form_complex_form_alter(array &$element, FormStateInterface $form_state, array $context): void {
  if (isset($element['actions']['bundle']['#type']) && $element['actions']['bundle']['#type'] === 'value') {
    $buttons = [
      'ief_add' => t('Add new'),
      'ief_add_existing' => t('Add existing'),
    ];

    foreach ($buttons as $key => $label) {
      if (!empty($element['actions'][$key])) {
        $element['actions'][$key]['#value'] = $label;
      }
    }
  }
}
