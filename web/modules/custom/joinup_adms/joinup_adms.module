<?php

/**
 * @file
 * Hook implementations for Joinup ADMS module.
 */

declare(strict_types = 1);

use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\Core\Field\FieldDefinition;

/**
 * Implements hook_entity_field_storage_info().
 */
function joinup_adms_entity_field_storage_info(EntityTypeInterface $entityType): array {
  $definitions = [];
  $admsEntityTypes = ['taxonomy_term'];
  if (in_array($entityType->id(), $admsEntityTypes, TRUE)) {
    $definitions['uri'] = BaseFieldDefinition::create('uri')
      ->setName('uri')
      ->setTargetEntityTypeId('taxonomy_term')
      ->setTargetBundle(NULL)
      ->setLabel(t('URI'))
      // Limit to allow indexing.
      // @see https://citnet.tech.ec.europa.eu/CITnet/jira/browse/ISAICP-7751
      ->setSetting('max_length', 768)
      ->setRevisionable(FALSE)
      ->setCardinality(1);
  }
  return $definitions;
}

/**
 * Implements hook_entity_bundle_field_info().
 */
function joinup_taxonomy_entity_bundle_field_info(EntityTypeInterface $entityType, string $bundle, array $baseFieldDefinitions): array {
  $fields = [];
  $mapper = \Drupal::getContainer()->get('rdf_sync.mapper');
  if ($mapper->isMappedBundle($entityType->id(), $bundle)) {
    $storageDefinitions = \Drupal::service('entity_field.manager')->getActiveFieldStorageDefinitions('taxonomy_term');
    if (isset($storageDefinitions['uri'])) {
      $fields['uri'] = FieldDefinition::createFromFieldStorageDefinition($storageDefinitions['uri'])
        ->setTargetBundle($bundle)
        ->setLabel(t('URI'))
        ->setRequired(TRUE)
        ->addConstraint('UniqueField')
        ->setDisplayConfigurable('form', TRUE)
        ->setDisplayConfigurable('view', TRUE);
    }
  }
  return $fields;
}
