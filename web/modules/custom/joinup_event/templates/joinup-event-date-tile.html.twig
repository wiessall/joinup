{#
/**
 * @file
 * Joinup date tile.
 *
 * Available variables:
 * - date: Date object.
 */
#}

<span class="joinup-date-tile">
  <span class="joinup-date-tile__month pt-2">{{ date|date('M') }}</span>
  <span class="joinup-date-tile__day pb-2">{{ date|date('d') }}</span>
  <span class="joinup-date-tile__year py-1">{{ date|date('Y') }}</span>
</span>
