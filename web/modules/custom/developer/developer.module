<?php

/**
 * @file
 * Primary module hooks for Developer module.
 */

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\block\Entity\Block;
use Drupal\Core\Session\AccountProxy;
use Drupal\user\UserInterface;

/**
 * Implements hook_block_access().
 */
function developer_block_access(Block $block, $operation, AccountInterface $account): AccessResultInterface {
  if ($operation !== 'view' || $block->getPluginId() !== 'developer_warning_message' || !getenv('AUTOLOGOUT_PRODUCTION')) {
    return AccessResult::neutral();
  }

  // Deny access to the block for local environments to not allow the devs get
  // used to the warning message.
  return AccessResult::forbidden();
}

/**
 * Implements hook_user_login().
 */
function developer_user_login(UserInterface $account): void {
  if (!getenv('AUTOLOGOUT_PRODUCTION')) {
    return;
  }

  if (!$account->hasRole('developer')) {
    return;
  }

  // Disable config read-only mode for developers.
  touch(DRUPAL_ROOT. '/../disable-config-readonly');
}

/**
 * Implements hook_user_logout().
 */
function developer_user_logout(AccountProxy $account): void {
  if (!getenv('AUTOLOGOUT_PRODUCTION')) {
    return;
  }

  if (!$account->hasRole('developer')) {
    return;
  }

  // Enable config read-only mode for developers.
  \Drupal::getContainer()->get('file_system')->unlink(DRUPAL_ROOT . '/../disable-config-readonly');
}
