<?php

/**
 * @file
 * Primary module hooks for Developer module.
 */

use Drupal\Core\Session\AccountInterface;
use Drupal\user\UserInterface;

/**
 * Implements hook_user_login().
 */
function developer_user_login(UserInterface $account): void {
  if (!getenv('AUTOLOGOUT_PRODUCTION')) {
    return;
  }

  if (!$account->hasRole('developer')) {
    return;
  }

  // Disable config read-only mode for developers.
  if (!file_exists(DRUPAL_ROOT . '/../disable-config-readonly')) {
    touch(DRUPAL_ROOT . '/../disable-config-readonly');
  }
}

/**
 * Implements hook_user_logout().
 */
function developer_user_logout(AccountInterface $account): void {
  if (!getenv('AUTOLOGOUT_PRODUCTION')) {
    return;
  }

  if (!$account->hasRole('developer')) {
    return;
  }

  // Check if there are active sessions of users with the 'developer' role.
  $role = \Drupal::entityTypeManager()->getStorage('user_role')->load('developer');
  $query = \Drupal::database()->select('sessions', 's');
  $query->leftJoin('users_field_data', 'u', 's.uid = u.uid');
  $query->leftJoin('user__roles', 'r', 'u.uid = r.entity_id');
  $query->fields('s', ['uid']);
  $query->condition('s.uid', 0, '<>');
  $query->condition('r.roles_target_id', $role->id());

  $result = $query->countQuery()->execute()->fetchCol();
  if ($result[0] === '1') {
    // The last active developers session is about to be closed, so we can
    // restore the config read-only mode.
    \Drupal::getContainer()->get('file_system')->unlink(DRUPAL_ROOT . '/../disable-config-readonly');
    \Drupal::messenger()->addMessage('Config read-only mode has been restored.');
  }
  else {
    \Drupal::messenger()->addMessage('Config read-only mode is still disabled as there seem to be more developers currently logged in.');
  }
}
