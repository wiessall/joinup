<?php

/**
 * @file
 * Provides functionality for the Joinup search module.
 */

declare(strict_types=1);

use Drupal\Core\Form\FormStateInterface;
use Drupal\joinup_community_content\Entity\CommunityContentInterface;

/**
 * Implements hook_form_BASE_FORM_ID_alter().
 */
function joinup_security_form_node_form_alter(array &$form, FormStateInterface $form_state): void {
  $node = $form_state->getFormObject()->getEntity();

  if (!$node instanceof CommunityContentInterface) {
    return;
  }

  if (!$node->isNew()) {
    return;
  }
  $securityService = \Drupal::service('Drupal\joinup_security\Services\JoinupSecurityService');
  if (!$securityService->currentUserHasNodeCreationLimit($node->getCollection()) && isset($form['actions']) && is_array($form['actions'])) {
    foreach ($form['actions'] as &$action) {
      if (is_array($action) && isset($action['#type']) && in_array($action['#type'], [
        'submit',
        'button',
      ])) {
        $action['#disabled'] = TRUE;
      }
    }
    \Drupal::messenger()->addWarning(t('You are not allowed to create content today. Please, try tomorrow'));
  }
  $form['#validate'][] = 'joinup_security_node_form_validate';
}

/**
 * Validates form to prevent HTTP POST bypass.
 *
 * @param array $form
 *   Form param.
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 *   Form state param.
 */
function joinup_security_node_form_validate(array &$form, FormStateInterface $form_state): mixed {
  $node = $form_state->getFormObject()->getEntity();
  $securityService = \Drupal::service('Drupal\joinup_security\Services\JoinupSecurityService');
  return $securityService->currentUserHasNodeCreationLimit($node->getCollection());
}
