<?php

/**
 * @file
 * Hook implementations for the Portal Stats test module.
 */

declare(strict_types=1);

use Drupal\joinup_distribution\Entity\DistributionInterface;
use Drupal\joinup_stats_test\Entity\CommunityContent;

/**
 * Implements hook_entity_bundle_info_alter().
 */
function joinup_stats_test_entity_bundle_info_alter(&$bundles): void {
  foreach (['discussion', 'document', 'event', 'news'] as $bundle) {
    if (!empty($bundles['node'][$bundle])) {
      $bundles['node'][$bundle]['class'] = CommunityContent::class;
    }
  }
  if (!empty($bundles['node']['distribution'])) {
    $bundles['node']['distribution']['class'] = DistributionInterface::class;
  }
}
