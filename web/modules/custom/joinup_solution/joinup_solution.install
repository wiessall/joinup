<?php

/**
 * @file
 * Install, update, and uninstall functions for the Joinup core module.
 */

declare(strict_types=1);

use Drupal\Core\Database\Database;
use Drupal\field\Entity\FieldConfig;
use Drupal\joinup_core\SharedInUpdateHelper;

/**
 * Install the meta entity field storage of group_moderation.
 */
function joinup_solution_update_200500(): void {
  SharedInUpdateHelper::installFromConfigSync(
    'field.storage.meta_entity.group_moderation.yml',
  );
}

/**
 * Install the solution_settings meta entity's group_moderation field instance.
 */
function joinup_solution_update_200501(): void {
  SharedInUpdateHelper::installFromConfigSync(
    'field.field.meta_entity.solution_settings.group_moderation.yml',
  );
}

/**
 * Migrates fields from solution to solution_settings meta entity.
 */
function joinup_solution_update_200502(): void {
  $entity_type_manager = \Drupal::entityTypeManager();
  $node_storage = $entity_type_manager->getStorage('node');
  $meta_storage = \Drupal::entityTypeManager()->getStorage('meta_entity');
  $nids = $node_storage->getQuery()
    ->condition('type', 'solution')
    ->accessCheck(TRUE)
    ->execute();
  $migrated_count = 0;

  foreach ($nids as $nid) {
    $solution = $node_storage->load($nid);
    $exists = $meta_storage->loadByProperties([
      'type' => 'solution_settings',
      'target' => ['target_id' => $solution->id()],
    ]);

    $meta_entity = reset($exists);
    $moderation = (int) $solution->get('group_moderation')->value;
    if (empty($meta_entity)) {
      $meta_entity = $meta_storage->create([
        'type' => 'solution_settings',
        'label' => $solution->label(),
        'target' => $solution,
        'group_moderation' => $moderation,
      ]);
    }
    else {
      if ($meta_entity->hasField('group_moderation')) {
        $meta_entity->set('group_moderation', $moderation);
      }
    }

    $meta_entity->save();
    $migrated_count++;
  }

  \Drupal::messenger()
    ->addMessage(t('Migrated @count meta entities.', ['@count' => $migrated_count]));

  $field = FieldConfig::load('node.solution.group_moderation');
  if ($field) {
    $field->delete();
  }

  try {
    $connection = Database::getConnection();
    $connection->delete('node__group_moderation')
      ->condition('entity_id', $nids, 'IN')
      ->execute();
    $connection->delete('node_revision__group_moderation')
      ->condition('entity_id', $nids, 'IN')
      ->execute();

    \Drupal::messenger()
      ->addMessage(t('Field "group_moderation" removed from node type.'));
  }
  catch (\Exception $e) {
    \Drupal::logger('joinup_solution')
      ->error('Failed to delete group_moderation field: @msg', ['@msg' => $e->getMessage()]);
  }
}
