{#
/**
 * @file
 * Default theme implementation of a collection's member count.
 *
 * Available variables:
 * - count: the number of members in the solution.
 * - view_mode: View mode; for example, "teaser" or "full".
 * - attributes: A list of HTML attributes for the input element.
 *
 * @ingroup themeable
 */
#}
<div{{ attributes.addClass(classes) }}>
    {% trans %}
        1 member
    {% plural count %}
        {{ count }} members
    {% endtrans %}
</div>
