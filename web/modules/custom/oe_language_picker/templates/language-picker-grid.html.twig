{#
/**
 * @file
 * Language picker grid template for popover content.
 *
 * Available variables:
 * - languages: Array of language objects with 'code', 'name', and 'url'.
 */
#}
<div class="oe-language-picker__grid">
  {% for language in languages %}
    <div class="oe-language-picker__item">
      <a href="{{ language.url }}" class="oe-language-picker__link">
        <span class="oe-language-picker__code">{{ language.code|upper }}</span>
        <span class="oe-language-picker__name">{{ language.name }}</span>
      </a>
    </div>
  {% endfor %}
</div>