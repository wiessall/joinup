<?php

/**
 * @file
 * Hook implementations for the Joinup bookmark module.
 */
/**
 * Implements hook_theme().
 */
function joinup_bookmark_theme(): array {
  return [
    'flag_bookmark_text' => [
      'variables' => [
        'flag' => NULL,
        'flaggable' => NULL,
        'view_mode' => NULL,
      ],
    ],
  ];
}

/**
 * Implements hook_preprocess_HOOK().
 */
function joinup_bookmark_preprocess_joinup_modal_anonymous__bookmark(&$variables): void {
  $variables['title'] = t('Sign in or register to bookmark this content');
  $variables['description'] = t('Bookmarking content allows you to save it for later reference and helps you organise your favourite resources.');
}
