<?php

/**
 * @file
 * Primary module hooks for GitHub feed module.
 */

declare(strict_types=1);

/**
 * Implements hook_theme().
 */
function github_feed_theme(array $existing, string $type, string $theme, string $path): array {
  return [
    'github_feed' => [
      'variables' => [
        'url' => NULL,
        'feed_type' => NULL,
        'items' => NULL,
      ],
    ],
    'github_feed_issue' => [
      'variables' => [
        'item' => NULL,
      ],
    ],
    'github_feed_pull_request' => [
      'variables' => [
        'item' => NULL,
      ],
    ],
    'github_feed_comments' => [
      'variables' => [
        'title' => NULL,
        'comments' => NULL,
      ],
    ],
    'github_feed_comment' => [
      'variables' => [
        'item' => NULL,
      ],
    ],
    'github_feed_events' => [
      'variables' => [
        'item' => NULL,
      ],
    ],
  ];
}

/**
 * Implements template_preprocess_HOOK().
 */
function template_preprocess_github_feed(array &$variables): void {
  switch ($variables['feed_type']) {
    case 'issue':
      $variables['type_parsed'] = t('Issues');
      $variables['icon_id'] = 'info-circle';
      $variables['icon_color'] = 'danger';
      $variables['type_url'] = $variables['url'] . '/issues';
      break;

    case 'pull_request':
      $variables['type_parsed'] = t('Pull requests');
      $variables['icon_id'] = 'code-slash';
      $variables['icon_color'] = 'warning';
      $variables['type_url'] = $variables['url'] . '/pulls';
      break;

    case 'events':
      $variables['type_parsed'] = t('Activity feed');
      $variables['icon_id'] = 'rss';
      $variables['icon_color'] = 'dark';
      $variables['type_url'] = $variables['url'] . '/events';
      break;
  }
}

/**
 * Implements template_preprocess_HOOK().
 */
function template_preprocess_github_feed_issue(array &$variables): void {
  _github_feed_preprocess_item($variables);
  $item = &$variables['item'];
  $truncate_html = \Drupal::getContainer()->get('smart_trim.truncate_html');
  $item['title'] = $truncate_html->truncateChars($item['title'], 50);
}

/**
 * Implements template_preprocess_HOOK().
 */
function template_preprocess_github_feed_pull_request(array &$variables): void {
  _github_feed_preprocess_item($variables);
  $item = &$variables['item'];
  $truncate_html = \Drupal::getContainer()->get('smart_trim.truncate_html');
  $item['title'] = $truncate_html->truncateChars($item['title'], 50);
}

/**
 * Implements template_preprocess_HOOK().
 */
function template_preprocess_github_feed_events(array &$variables): void {
  _github_feed_preprocess_item($variables);
  $item = &$variables['item'];
  $truncate_html = \Drupal::getContainer()->get('smart_trim.truncate_html');

  // Convert the above in a switch state.
  switch ($item['type']) {
    case 'IssueCommentEvent':
    case 'IssuesEvent':
      $item['payload']['issue']['title'] = $truncate_html->truncateChars($item['payload']['issue']['title'], 50);
      break;

    case 'PullRequestEvent':
      $item['payload']['pull_request']['title'] = $truncate_html->truncateChars($item['payload']['pull_request']['title'], 50);
      break;

    case 'PullRequestReview':
      $item['payload']['pull_request']['title'] = $truncate_html->truncateChars($item['payload']['pull_request']['title'], 50);
      $item['payload']['pull_request']['title'] = $truncate_html->truncateChars($item['payload']['pull_request']['title'], 50);
      break;

    default:
      break;
  }
}

/**
 * Converts the item created date to a human-readable format.
 *
 * @param array $variables
 *   The variables array.
 */
function _github_feed_preprocess_item(array &$variables): void {
  $item = &$variables['item'];
  $date_formatter = \Drupal::getContainer()->get('date.formatter');
  $item['created_at'] = [
    '#type' => 'markup',
    '#markup' => $date_formatter->format(strtotime($item['created_at']), 'short'),
  ];

  if (isset($item['updated_at'])) {
    $item['updated_at'] = [
      '#type' => 'markup',
      '#markup' => $date_formatter->format(strtotime($item['updated_at']), 'short'),
    ];
  }
}
