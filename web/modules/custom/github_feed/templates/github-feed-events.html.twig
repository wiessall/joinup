{#
/**
 * @file
 * Default template for the github_feed_events element.
 *
 * Available variables:
 * - item: The issue as fetched by the API endpoint.
 */
#}
<div class="github-feed-activity-stream-item">
  <div class="github-feed-activity-stream-item__header">
    <small class="github-feed-activity-stream-item__header__meta__time">
      {{ item.created_at }}
    </small>
  </div>
</div>
<div class="github-feed-activity-stream-item__body">
  <div class="github-feed-activity-stream-item__body__content">
    <div class="github-feed-activity-stream-item__body__content__event">
      {% if item.type == 'IssueCommentEvent' %}
        {{ ':action comment :number on <a href=":issue_url">:title</a> by <a href=":actor_url">:actor</a>.'|t({
          ':action': item.payload.action,
          ':number': item.payload.issue.number,
          ':issue_url': item.payload.issue.html_url,
          ':title': item.payload.issue.title,
          ':actor_url': item.actor.url,
          ':actor': item.actor.login
        }) }}
      {% elseif item.type == 'IssuesEvent' %}
        {{ ':action issue on <a href=":issue_url">:title</a> by <a href=":actor_url">:actor</a>.'|t({
          ':action': item.payload.action,
          ':issue_url': item.payload.issue.html_url,
          ':title': item.payload.issue.title,
          ':actor_url': item.actor.url,
          ':actor': item.actor.login
        }) }}
      {% elseif item.type == 'PullRequestEvent' %}
        {{ ':action pull request on <a href=":pr_url">:title</a> by <a href=":actor_url">:actor</a>.'|t({
          ':action': item.payload.action,
          ':pr_url': item.payload.pull_request.html_url,
          ':title': item.payload.pull_request.title,
          ':actor_url': item.actor.url,
          ':actor': item.actor.login
        }) }}
      {% elseif item.type == 'PullRequestReviewEvent' %}
        {{ ':action pull request review on <a href=":pr_url">:title</a> by <a href=":actor_url">:actor</a>.'|t({
          ':action': item.payload.action,
          ':pr_url': item.payload.pull_request.html_url,
          ':title': item.payload.pull_request.title,
          ':actor_url': item.actor.url,
          ':actor': item.actor.login
        }) }}
      {% elseif item.type == 'PushEvent' %}
        {{ ':count commits on <a href=":commit_url">:sha</a> by <a href=":actor_url">:actor</a>.'|t({
          ':count': item.payload.commits|length,
          ':commit_url': item.payload.commits.0.url,
          ':sha': item.payload.commits.0.sha|slice(0, 7),
          ':actor_url': item.actor.url,
          ':actor': item.actor.login
        }) }}
      {% elseif item.type == 'WatchEvent' %}
        {{ 'User :username starred the repository.'|t({':username': item.actor.login}) }}
      {% elseif item.type == 'ForkEvent' %}
        {{ 'User :username forked the repository.'|t({':username': item.actor.login}) }}
      {% elseif item.type == 'CreateEvent' %}
        {{ ':ref_type created: :ref'|t({
          ':ref_type': item.payload.ref_type,
          ':ref': item.payload.ref
        }) }}
      {% elseif item.type == 'DeleteEvent' %}
        {{ ':ref_type deleted: :ref'|t({
          ':ref_type': item.payload.ref_type,
          ':ref': item.payload.ref
        }) }}
      {% elseif item.type == 'PullRequestReviewCommentEvent' %}
        {{ ':action comment on pull request on <a href=":pr_url">:title</a> by <a href=":actor_url">:actor</a>.'|t({
          ':action': item.payload.action,
          ':pr_url': item.payload.pull_request.html_url,
          ':title': item.payload.pull_request.title,
          ':actor_url': item.actor.url,
          ':actor': item.actor.login
        }) }}
      {% elseif item.type == 'CommitCommentEvent' %}
        {{ ':action comment on commit :commit_id by <a href=":actor_url">:actor</a>.'|t({
          ':action': item.payload.action,
          ':commit_id': item.payload.comment.commit_id|slice(0, 7),
          ':actor_url': item.actor.url,
          ':actor': item.actor.login
        }) }}
      {% elseif item.type == 'ReleaseEvent' %}
        {{ ':action release :tag_name by <a href=":actor_url">:actor</a>.'|t({
          ':action': item.payload.action,
          ':tag_name': item.payload.release.tag_name,
          ':actor_url': item.actor.url,
          ':actor': item.actor.login
        }) }}
      {% elseif item.type == 'MemberEvent' %}
        {{ ':action user :username was added to the repository.'|t({
          ':action': item.payload.action,
          ':username': item.payload.member.login
        }) }}
      {% elseif item.type == 'PublicEvent' %}
        {{ 'Repository made public.'|t }}
      {% elseif item.type == 'GollumEvent' %}
        {{ ':count wiki page(s) :action on the repository.'|t({
          ':count': item.payload.pages|length,
          ':action': item.payload.pages.0.action
        }) }}
      {% else %}
        {{ 'Unrecognized event type'|t }}
      {% endif %}
    </div>
  </div>
</div>
