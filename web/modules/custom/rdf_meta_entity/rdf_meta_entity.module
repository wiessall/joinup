<?php

/**
 * @file
 * Contains functions and hooks for the rdf_meta_entity module.
 */

declare(strict_types = 1);

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\rdf_entity\RdfInterface;

/**
 * Implements hook_ENTITY_TYPE_presave().
 */
function rdf_meta_entity_rdf_entity_presave(RdfInterface $entity): void {
  $bundles = ['eif_layer', 'eif_model', 'eif_principle', 'eif_recommendation'];
  if (in_array($entity->bundle(), $bundles)) {
    rdf_meta_entity_eif_auto_label($entity);
  }
}

/**
 * Implements hook_inline_entity_form_entity_form_alter().
 */
function rdf_meta_entity_inline_entity_form_entity_form_alter(array &$entity_form, FormStateInterface &$form_state) {
  $bundles = ['eif_layer', 'eif_model', 'eif_principle', 'eif_recommendation'];
  if ($entity_form['#entity_type'] === 'rdf_entity' && in_array($entity_form['#bundle'], $bundles)) {
    $entity_form['#entity_builders'][] = 'rdf_meta_entity_inline_entity_form_entity_builder';
  }
}

/**
 * Entity builder callback for the inline entity creation form.
 *
 * @param string $entity_type
 *   The type of the entity being created.
 * @param \Drupal\Core\Entity\EntityInterface $entity
 *   The entity being built.
 */
function rdf_meta_entity_inline_entity_form_entity_builder(string $entity_type, EntityInterface $entity) {
  rdf_meta_entity_eif_auto_label($entity);
}

/**
 * Assigns a label automatically to the EIF setting according to the qualifier.
 *
 * @param \Drupal\rdf_entity\RdfInterface $rdf_entity
 *   The RDF entity to set the label for.
 */
function rdf_meta_entity_eif_auto_label(RdfInterface $rdf_entity): void {
  if ($target_principle = $rdf_entity->get('eif_settings_qualifier')->entity) {
    $rdf_entity->set('label', $target_principle->label());
  }
}
