<?php

/**
 * @file
 * Main functions and hook implementations of the joinup_modal module.
 */

declare(strict_types=1);

/**
 * Implements hook_theme().
 */
function joinup_modal_theme(): array {
  return [
    'joinup_modal_anonymous' => [
      'variables' => [
        'title' => NULL,
        'description' => NULL,
        'login' => NULL,
        'register' => NULL,
      ],
    ],
  ];
}
