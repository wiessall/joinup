<?php

/**
 * @file
 * Primary module hooks for joinup_private_message module.
 */

declare(strict_types=1);

use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;
use Drupal\symfony_mailer_lite\Plugin\Mail\SymfonyMailer;

/**
 * Implements hook_form_alter().
 */
function joinup_private_message_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  if ($form_id === 'private_message_add_form') {
    $current_route_name = \Drupal::routeMatch()->getRouteName();
    if (isset($form['message'])) {
      if ($current_route_name !== 'private_message.private_message_create') {
        // Change the label from "Message" to "Reply".
        $form['message']['widget'][0]['#title'] = t('Reply');
      }
      // Set the default format to 'Minimal'
      // and limit the allowed formats to only 'Minimal'.
      $form['message']['widget'][0]['#format'] = 'minimal';
      $form['message']['widget'][0]['#allowed_formats'] = ['minimal'];
    }
    $form['actions']['submit']['#submit'][] = 'joinup_private_message_form_submit';
  }
}

/**
 * Custom form submit handler for redirect.
 */
function joinup_private_message_form_submit(array &$form, FormStateInterface $form_state): void {
  // The entity.private_message_thread.canonical route has been removed,
  // so we will redirect to the Private Messages page.
  $form_state->setRedirect('private_message.private_message_page');
}

/**
 * Implements hook_entity_view_alter().
 */
function joinup_private_message_entity_view_alter(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display): void {
  $current_user = Drupal::currentUser();
  $user_id = $current_user->id();
  // Check if this is the custom entity you want to alter.
  if ($entity->getEntityTypeId() === 'private_message' && $entity->getOwnerId() !== $user_id) {
    $report_url = Url::fromRoute('joinup_private_message.report_form', [
      'private_message' => $entity->id(),
    ]);

    // Create the button render array.
    $report_button = [
      '#type' => 'link',
      '#title' => t('Report'),
      '#url' => $report_url,
      '#attributes' => [
        'class' => ['button', 'report-button', 'use-ajax', 'btn', 'btn-primary'],
        'data-dialog-type' => 'modal',
        'data-dialog-options' => json_encode([
          'width' => 'auto',
          'height' => 'auto',
        ]),
      ],
    ];

    // Add the button to the entity view array.
    if (!isset($build['links'])) {
      $build['links'] = [];
    }
    $build['links']['report'] = $report_button;
  }
}

/**
 * Implements hook_mail().
 */
function joinup_private_message_mail($key, &$message, $params): void {
  switch ($key) {
    case 'report_message':
      $message['subject'] = $params['subject'];
      $message['body'][] = $params['message'];
      $message['headers']['Content-Type'] = SymfonyMailer::FORMAT_HTML;
      break;
  }
}
