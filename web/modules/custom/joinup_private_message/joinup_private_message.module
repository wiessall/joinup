<?php

/**
 * @file
 * Primary module hooks for joinup_private_message module.
 */

declare(strict_types=1);

use Drupal\Component\Serialization\Json;
use Drupal\Core\Ajax\AjaxResponse;
use Drupal\Core\Ajax\CloseModalDialogCommand;
use Drupal\Core\Ajax\RedirectCommand;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;
use Drupal\private_message\Entity\PrivateMessageThread;

/**
 * Implements hook_preprocess_HOOK().
 */
function joinup_private_message_preprocess_private_message(&$variables): void {
  if ($variables['view_mode'] === 'inbox') {
    /** @var \Drupal\private_message\Entity\PrivateMessage $private_message */
    $private_message = $variables['private_message'];

    // Get the other member in the conversation.
    if ($private_message->getOwnerId() !== \Drupal::currentUser()->id()) {
      $other_member = $private_message->getOwner();
    }
    else {
      /** @var \Drupal\private_message\Entity\PrivateMessageThreadInterface $thread_id */
      $thread_id = \Drupal::service('private_message.mapper')
        ->getThreadIdFromMessage($private_message);
      $thread = PrivateMessageThread::load($thread_id);
      foreach ($thread->getMembers() as $member) {
        if ($member->id() !== \Drupal::currentUser()->id()) {
          $other_member = $member;
        }
      }
    }
    $variables['other_member']['#markup'] = $other_member?->getDisplayName();

    // Get the created datetime in the right format.
    $created = (int) $private_message->getCreatedTime();
    $format = date('Y-m-d') === date('Y-m-d', $created) ? 'H:i' : 'Y-m-d';
    $variables['created']['#markup'] = date($format, $created);
  }
}

/**
 * Implements hook_form_alter().
 */
function joinup_private_message_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  if ($form_id === 'private_message_add_form') {
    $current_route_name = \Drupal::routeMatch()->getRouteName();
    if (isset($form['message'])) {
      if ($current_route_name !== 'private_message.private_message_create') {
        // Change the label from "Message" to "Reply".
        $form['message']['widget'][0]['#title'] = t('Reply');
      }
      // Set the default format to 'Minimal'
      // and limit the allowed formats to only 'Minimal'.
      $form['message']['widget'][0]['#format'] = 'minimal';
      $form['message']['widget'][0]['#allowed_formats'] = ['minimal'];
    }
  }

  if (in_array($form_id, ['private_message_add_form', 'private_message_delete_form'])) {
    $form['actions']['submit']['#submit'][] = 'joinup_private_message_form_submit';
  }

  if ($form_id === 'private_message_thread_clear_personal_history_form') {
    $form['#title'] = t('Delete conversation for me');
    $form['description']['#markup'] = t('This action cannot be undone. The conversation will be removed from your view, but it will remain accessible to the other participant.');
    // Change the submit button label from "Clear history" to "Delete for me".
    if (isset($form['actions']['submit']['#value'])) {
      $form['actions']['submit']['#value'] = t('Delete for me');
    }
  }
}

/**
 * Custom form submit handler for redirect.
 */
function joinup_private_message_form_submit(array &$form, FormStateInterface $form_state): void {
  // The entity.private_message_thread.canonical route has been removed,
  // so we will redirect to the Private Messages page.
  $form_state->setRedirect('private_message.private_message_page');
}

/**
 * Implements hook_form_BASE_FORM_ID_alter().
 */
function joinup_private_message_form_private_message_add_form_alter(array &$form): void {
  $current_route_name = \Drupal::routeMatch()->getRouteName();
  if ($current_route_name === 'private_message.private_message_create') {
    $form['#title'] = t('New message');
    $form['#prefix'] = '<div id="private-message-create-form-wrapper">';
    $form['#suffix'] = '</div>';

    $form['actions']['submit']['#ajax'] = [
      'callback' => 'joinup_private_message_create_ajax_callback',
      'wrapper' => 'private-message-create-form-wrapper',
      'effect' => 'fade',
    ];
  }
}

/**
 * Ajax callback for add a new thead form.
 *
 * @param array $form
 *   Form fields.
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 *   Form state.
 */
function joinup_private_message_create_ajax_callback(array &$form, FormStateInterface $form_state): array|AjaxResponse {
  $response = new AjaxResponse();

  if ($form_state->hasAnyErrors()) {
    return $form;
  }

  $url = Url::fromRoute('private_message.private_message_page');

  $response->addCommand(new CloseModalDialogCommand());
  $response->addCommand(new RedirectCommand($url->toString()));

  return $response;
}

/**
 * Implements hook_ENTITY_TYPE_view_alter().
 *
 * @see private_message_private_message_thread_view_alter()
 */
function joinup_private_message_private_message_thread_view_alter(array &$build, EntityInterface $node, EntityViewDisplayInterface $display): void {
  if (isset($build['delete_link'])) {
    // Open form in a modal.
    $build['delete_link']['#attributes'] = _joinup_private_message_get_ajax_modal_attributes();
  }
  if (isset($build['clear_history_link'])) {
    // Open form in a modal.
    $build['clear_history_link']['#title'] = t('Delete for me');
    $build['clear_history_link']['#attributes'] = _joinup_private_message_get_ajax_modal_attributes();
    if ($display->id() === 'private_message_thread.private_message_thread.inbox') {
      unset($build['clear_history_link']);
    }
  }

}

/**
 * Implements hook_contextual_links_view_alter().
 */
function joinup_private_message_contextual_links_view_alter(array &$element, array $items): void {
  if (isset($element['#links']['private-messagedelete'])) {
    // Open form in a modal.
    $element['#links']['private-messagedelete']['attributes'] = _joinup_private_message_get_ajax_modal_attributes();
  }

}

/**
 * Gets the attributes for use with an AJAX modal.
 *
 * @return array
 *   The attributes for use with an AJAX modal.
 */
function _joinup_private_message_get_ajax_modal_attributes(): array {
  return [
    'class' => ['use-ajax'],
    'data-dialog-type' => 'modal',
    'data-dialog-options' => Json::encode([
      'width' => 'auto',
    ]),
  ];
}
