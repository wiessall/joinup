<?php

/**
 * @file
 * Hook implementations for the Joinup flag module.
 */

declare(strict_types=1);

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\joinup_like\Plugin\ActionLink\CountLink;

/**
 * Implements hook_flag_link_type_info_alter().
 */
function joinup_flag_flag_link_type_info_alter(array &$link_types): void {
  if (isset($link_types['count_link'])) {
    $link_types['count_link']['class'] = CountLink::class;
  }
}

/**
 * Implements hook_entity_access().
 */
function joinup_flag_entity_access(EntityInterface $entity, string $operation, AccountInterface $account): AccessResultInterface {
  // Grant access to flagging entities,
  // so that they can be shown in bookmarks listing.
  if ($operation === 'view' && $entity->getEntityTypeId() === 'flagging') {
    $access = $account->isAuthenticated() ? AccessResult::allowed() : AccessResult::forbidden();
    return $access->addCacheContexts(['user.roles:authenticated']);
  }

  return AccessResult::neutral();
}
