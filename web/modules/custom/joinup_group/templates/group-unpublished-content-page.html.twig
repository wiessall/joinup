{#
/**
 * @file
 * Template to render the unpublished content page.
 *
 * Available variables:
 * - draft_block: the draft block.
 * - proposed_block: the proposed block.
 *
 * @ingroup themeable
 */
#}
<div class="unpublished-content-page">
  <h3>{{ 'Draft Content'|trans }}</h3>
  <div>
    {{ draft_block }}
  </div>
  <h3>{{ 'Proposed Content'|trans }}</h3>
  <div>
    {{ proposed_block }}
  </div>
</div>
