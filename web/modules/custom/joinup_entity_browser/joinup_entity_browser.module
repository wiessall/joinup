<?php

/**
 * @file
 * Joinup Entity Browser module hooks.
 */

declare(strict_types=1);

use Drupal\joinup_entity_browser\EntityBrowserNodeAccessControlHandler;

/**
 * Implements hook_entity_type_alter().
 */
function joinup_entity_browser_entity_type_alter(array &$entity_types): void {
  if (isset($entity_types['node'])) {
    $entity_types['node']->setAccessClass(EntityBrowserNodeAccessControlHandler::class);
  }
}
