<?php

/**
 * @file
 * Contains hook implementations for the Joinup SEO module.
 */

declare(strict_types=1);

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\joinup_rdf\Entity\RdfSyncEntityInterface;
use Drupal\joinup_seo\JoinupSeoExportHelperInterface;
use Drupal\rdf_entity\RdfInterface;

/**
 * Implements hook_simple_sitemap_sitemap_types_alter().
 */
function joinup_seo_simple_sitemap_sitemap_types_alter(array &$sitemap_types): void {
  if (!isset($sitemap_types['default_hreflang'])) {
    return;
  }

  // Replace the default entity generator entry to allow to skip recent news
  // entries.
  if ($index = array_search('entity', $sitemap_types['default_hreflang']['urlGenerators'])) {
    $sitemap_types['default_hreflang']['urlGenerators'][$index] = 'joinup_entity';
  }
}

/**
 * Implements hook_metatags_alter().
 *
 * When a field contains multiple values, the normal way of adding one entry for
 * each delta is to use the Pivot. Pivot will allow the field to be rendered as
 * an array value objects instead of a single object.
 * In order to render all deltas in the field, the tag tokens must include all
 * deltas separated by comma, e.g.
 * '[node:field_file:0:entity:url],[node:field_file:1:entity:url]' etc.
 * When the field has unlimited cardinality though, it is impossible to do such
 * a thing. Thus, dynamically change the metatags for the entity to include a
 * specific number of tokens with delta that ensure that all values are
 * rendered.
 */
function joinup_seo_metatags_alter(array &$metatags, array &$context): void {
  if (!isset($metatags['schema_social_media_posting_shared_content'])) {
    return;
  }

  $count = count($context['entity']->get('field_attachment')->getValue());
  if ($count === 1) {
    return;
  }

  $tags = unserialize($metatags['schema_social_media_posting_shared_content'], [
    'allowed_classes' => FALSE,
  ]);

  $tag_list = [
    '@id' => 'entity:url',
    'name' => 'entity:name',
    'url' => 'entity:url',
    'datePublished' => 'entity:created:html_datetime',
  ];
  foreach ($tag_list as $tag_name => $tag_suffix) {
    $new_tags = [];
    for ($i = 0; $i <= $count; $i++) {
      $new_tags[] = "[node:field_attachment:{$i}:{$tag_suffix}]";
    }
    $tags[$tag_name] = implode(',', $new_tags);
  }
  $metatags['schema_social_media_posting_shared_content'] = serialize($tags);
}

/**
 * Implements hook_module_implements_alter().
 */
function joinup_seo_module_implements_alter(&$implementations, $hook): void {
  if ($hook === 'page_attachments_alter') {
    if (
      array_key_exists('schema_metatag', $implementations) &&
      array_key_exists('joinup_seo', $implementations)
    ) {
      $schemaMetatagHookIndex = array_search('schema_metatag', array_keys($implementations));
      $our = $implementations['joinup_seo'];
      unset($implementations['joinup_seo']);
      $implementations = array_merge(
        array_slice($implementations, 0, $schemaMetatagHookIndex),
        ['joinup_seo' => $our],
        array_slice($implementations, $schemaMetatagHookIndex)
      );
    }
  }
}

/**
 * Implements hook_page_attachments_alter().
 *
 * Adds JSON-LD structured data to the canonical routes of RDF entities or
 * entities being synced with RDF entities.
 *
 * @todo Remove BC layer built arount RDF entities in ISAICP-8376.
 */
function joinup_seo_page_attachments_alter(array &$attachments): void {
  // Don't do anything if HTML <head> attachments already have a
  // "schema_metatag" script.
  $pageHasSchemaMetatag = array_reduce(
    $attachments['#attached']['html_head'] ?? [],
    function (bool $carry, array $attachment): bool {
      $carry = $carry ?: ($attachment[1] ?? NULL) === 'schema_metatag';
      return $carry;
    },
    FALSE,
  );
  if ($pageHasSchemaMetatag) {
    return;
  }

  $routeMatch = \Drupal::service('current_route_match');
  assert($routeMatch instanceof RouteMatchInterface);
  $routeApplies = preg_match('/^entity\.([^.]*)\.canonical$/', $routeMatch->getRouteName(), $matches);
  if (!$routeApplies) {
    return;
  }
  $entity = $routeMatch->getParameter($matches[1]);
  // @todo Remove BC layer focusing on RdfInterface entities in ISAICP-8376.
  if (
    !$entity instanceof RdfInterface &&
    !$entity instanceof RdfSyncEntityInterface
  ) {
    return;
  }

  $serializer = \Drupal::service('joinup_seo.export_helper');
  assert($serializer instanceof JoinupSeoExportHelperInterface);
  $output = NULL;
  try {
    $output = $serializer->getEntityJsonLdString($entity);
  }
  catch (\Exception $exception) {
    \Drupal::logger('joinup_seo')->error(
      "The '@entity-class' entity '@entity-label' (id: ':entity-id') cannot be serialized to JsonLD object. @exception-message",
      [
        '@entity-class' => get_class($entity),
        '@entity-label' => $entity->label(),
        ':entity-id' => $entity->id(),
        '@exception-message' => $exception->getMessage(),
        '@backtrace' => $exception->getTraceAsString(),
      ],
    );
  }

  if (!$output) {
    return;
  }

  $attachments['#attached']['html_head'][] = [
    [
      '#tag' => 'script',
      '#attributes' => [
        'type' => 'application/ld+json',
      ],
      '#value' => $output,
    ],
    'joinup_seo_json_ld',
  ];
}
