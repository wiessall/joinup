<?php

/**
 * @file
 * Install, update and schema hooks for sti_dedupe.
 */

declare(strict_types=1);

use Drupal\node\NodeInterface;
use Drupal\paragraphs\ParagraphInterface;
use Drupal\sti_dedupe\ContentModel;
use Drupal\sti_dedupe\DecisionStore;

/**
 * Implements hook_schema().
 */
function sti_dedupe_schema(): array {
  $schema['sti_dedupe_candidate'] = [
    'description' => 'Precomputed duplicate candidates, one row per ordered pair.',
    'fields' => [
      'id' => ['type' => 'serial', 'not null' => TRUE],
      'source_nid' => [
        'description' => 'The newly imported solution.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'candidate_nid' => [
        'description' => 'An existing solution that may describe the same innovation.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'collection_nid' => [
        'description' => 'Collection of the source solution, for cheap listing.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'score' => [
        'description' => 'Match score, 0..1, stored x1000 as an integer.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'reasons' => [
        'description' => 'Human-readable scoring breakdown.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ],
      'computed' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['id'],
    'unique keys' => ['pair' => ['source_nid', 'candidate_nid']],
    'indexes' => [
      'collection_score' => ['collection_nid', 'score'],
      'source' => ['source_nid'],
    ],
  ];

  $schema['sti_dedupe_decision'] = [
    'description' => 'Reviewer decisions about pairs of solutions, low nid first.',
    'fields' => [
      'id' => ['type' => 'serial', 'not null' => TRUE],
      'nid_low' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'nid_high' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'decision' => [
        'description' => "One of: same, different; 'merged' rows are history from the first version.",
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
      ],
      'uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'created' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['id'],
    'unique keys' => ['pair' => ['nid_low', 'nid_high']],
    'indexes' => [
      'low_decision' => ['nid_low', 'decision'],
      'high_decision' => ['nid_high', 'decision'],
    ],
  ];

  $schema['sti_dedupe_replacement'] = _sti_dedupe_replacement_schema();

  return $schema;
}

/**
 * Returns the schema of the innovation replacement table.
 */
function _sti_dedupe_replacement_schema(): array {
  return [
    'description' => 'ATIO innovations unpublished in favour of another by a "same" decision.',
    'fields' => [
      'replaced_nid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'survivor_nid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'created' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['replaced_nid'],
    'indexes' => ['survivor' => ['survivor_nid']],
  ];
}

/**
 * Implements hook_update_dependencies().
 */
function sti_dedupe_update_dependencies(): array {
  // 11002 saves solutions and deletes claim paragraphs; both bundles must be
  // on their typed sti_namespace URI plugins before anything is synced.
  return [
    'sti_dedupe' => [
      11001 => ['sti_rdf' => 11001],
    ],
  ];
}

/**
 * Link instead of merge: replacement table and decision vocabulary.
 *
 * Data only. The new fields, paragraph types and settings arrive through
 * config/sync (drush deploy runs cim right after updb): creating them here
 * as well would leave cim to delete or replace them, because config/sync is
 * what cim treats as the truth.
 */
function sti_dedupe_update_11001(): string {
  $moduleHandler = \Drupal::moduleHandler();
  $missing = array_filter(
    ['options', 'entity_reference_revisions', 'paragraphs', 'rdf_sync', 'sti_rdf', 'atio'],
    static fn(string $module): bool => !$moduleHandler->moduleExists($module),
  );
  if ($missing) {
    throw new \RuntimeException(sprintf('sti_dedupe now requires: %s. Install them with drush pm:install, then run the updates again.', implode(', ', $missing)));
  }

  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('sti_dedupe_replacement')) {
    $schema->createTable('sti_dedupe_replacement', _sti_dedupe_replacement_schema());
  }
  $decisionSpec = sti_dedupe_schema()['sti_dedupe_decision'];
  foreach ($decisionSpec['indexes'] as $index => $columns) {
    if (!$schema->indexExists('sti_dedupe_decision', $index)) {
      $schema->addIndex('sti_dedupe_decision', $index, $columns, $decisionSpec);
    }
  }

  $converted = \Drupal::database()->update('sti_dedupe_decision')
    ->fields(['decision' => DecisionStore::SAME])
    ->condition('decision', 'same_separate')
    ->execute();

  return (string) t('Created the replacement table and turned @count "same, keep both" decision(s) into "same". The new fields arrive with config import.', [
    '@count' => $converted,
  ]);
}

/**
 * Turn the first version's sameInnovationAs claims into decisions.
 *
 * That version wrote "same" as a claim on each solution, attributed to the
 * solution's collection, although the reviewer, not the collection, made the
 * statement. Each such claim becomes a "same" decision; the claim paragraph,
 * the matching related_solutions entry, the sameInnovationAs property term
 * and the field_claim_ref_node field are then removed. Fails, without
 * removing the field, if any such claim is left.
 */
function sti_dedupe_update_11002(array &$sandbox): string {
  $entityTypeManager = \Drupal::entityTypeManager();
  $paragraphs = $entityTypeManager->getStorage('paragraph');

  if (!isset($sandbox['tid'])) {
    $sandbox['tid'] = _sti_dedupe_same_as_term_id();
    $sandbox['converted'] = 0;
    $sandbox['skipped'] = 0;
    $sandbox['total'] = $sandbox['tid'] === NULL ? 0 : (int) $paragraphs->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', ContentModel::CLAIM)
      ->condition(ContentModel::CLAIM_PROPERTY, $sandbox['tid'])
      ->count()
      ->execute();
  }

  if ($sandbox['tid'] !== NULL) {
    $ids = $paragraphs->getQuery()
      ->accessCheck(FALSE)
      ->condition('type', ContentModel::CLAIM)
      ->condition(ContentModel::CLAIM_PROPERTY, $sandbox['tid'])
      ->sort('id')
      ->range(0, 50)
      ->execute();

    foreach ($paragraphs->loadMultiple($ids) as $claim) {
      assert($claim instanceof ParagraphInterface);
      if (_sti_dedupe_convert_same_as_claim($claim)) {
        $sandbox['converted']++;
      }
      else {
        $sandbox['skipped']++;
      }
    }

    if ($ids) {
      $done = $sandbox['converted'] + $sandbox['skipped'];
      $sandbox['#finished'] = $sandbox['total'] > 0 ? min(0.99, $done / $sandbox['total']) : 0.99;
      return (string) t('Converted @done of @total sameInnovationAs claims.', [
        '@done' => $done,
        '@total' => $sandbox['total'],
      ]);
    }
  }

  // Every claim is gone; remove the term and the legacy field.
  if ($sandbox['tid'] !== NULL) {
    $left = (int) $paragraphs->getQuery()
      ->accessCheck(FALSE)
      ->condition(ContentModel::CLAIM_PROPERTY, $sandbox['tid'])
      ->count()
      ->execute();
    if ($left > 0) {
      throw new \RuntimeException(sprintf('%d sameInnovationAs claims remain after conversion; the legacy field was not removed.', $left));
    }
    $entityTypeManager->getStorage('taxonomy_term')->load($sandbox['tid'])?->delete();
  }
  $field = $entityTypeManager->getStorage('field_config')->load('paragraph.' . ContentModel::CLAIM . '.' . ContentModel::CLAIM_REF_NODE_LEGACY);
  $field?->delete();

  $sandbox['#finished'] = 1;
  return (string) t('Turned @converted sameInnovationAs claim(s) into decisions (@skipped skipped: one side no longer exists) and removed the legacy field.', [
    '@converted' => $sandbox['converted'],
    '@skipped' => $sandbox['skipped'],
  ]);
}

/**
 * Converts one legacy sameInnovationAs claim and removes it.
 *
 * @return bool
 *   TRUE when a decision was recorded; FALSE when one side no longer exists
 *   (the claim is removed either way).
 */
function _sti_dedupe_convert_same_as_claim(ParagraphInterface $claim): bool {
  $subject = $claim->getParentEntity();
  $object = NULL;
  if ($claim->hasField(ContentModel::CLAIM_REF_NODE_LEGACY) && !$claim->get(ContentModel::CLAIM_REF_NODE_LEGACY)->isEmpty()) {
    $object = $claim->get(ContentModel::CLAIM_REF_NODE_LEGACY)->entity;
  }
  elseif ($claim->hasField(ContentModel::CLAIM_LITERAL) && preg_match('#/node/(\d+)$#', (string) $claim->get(ContentModel::CLAIM_LITERAL)->value, $matches)) {
    // The fallback stored the object's absolute URL as a literal.
    $object = \Drupal::entityTypeManager()->getStorage('node')->load((int) $matches[1]);
  }

  $recorded = FALSE;
  if ($subject instanceof NodeInterface && $object instanceof NodeInterface
    && $subject->bundle() === ContentModel::SOLUTION && $object->bundle() === ContentModel::SOLUTION
    && (int) $subject->id() !== (int) $object->id()) {
    \Drupal::service('sti_dedupe.decisions')->record((int) $subject->id(), (int) $object->id(), DecisionStore::SAME);
    $recorded = TRUE;
  }

  if ($subject instanceof NodeInterface && $subject->hasField(ContentModel::CLAIMS)) {
    $items = array_values(array_filter(
      $subject->get(ContentModel::CLAIMS)->getValue(),
      static fn(array $item): bool => (int) $item['target_id'] !== (int) $claim->id(),
    ));
    $subject->set(ContentModel::CLAIMS, $items);
    if ($object instanceof NodeInterface && $subject->hasField(ContentModel::RELATED_SOLUTIONS)) {
      $related = array_values(array_filter(
        $subject->get(ContentModel::RELATED_SOLUTIONS)->getValue(),
        static fn(array $item): bool => (int) $item['target_id'] !== (int) $object->id(),
      ));
      $subject->set(ContentModel::RELATED_SOLUTIONS, $related);
    }
    $subject->setNewRevision(TRUE);
    $subject->setRevisionLogMessage('sti_dedupe: legacy sameInnovationAs claim replaced by a duplicate decision.');
    $subject->save();
  }

  // Deleted rather than left to the orphan purger: an orphaned claim would
  // still be synced to the graph as a FieldClaim nobody points to.
  $claim->delete();
  return $recorded;
}

/**
 * Finds the legacy sameInnovationAs claim property term.
 */
function _sti_dedupe_same_as_term_id(): ?int {
  $ids = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->getQuery()
    ->accessCheck(FALSE)
    ->condition('vid', ContentModel::CLAIM_PROPERTIES)
    ->condition('name', 'sameInnovationAs')
    ->sort('tid')
    ->range(0, 1)
    ->execute();
  return $ids ? (int) reset($ids) : NULL;
}
