<?php

/**
 * @file
 * Hook implementations for SPDX Licences module.
 */

declare(strict_types=1);

use Drupal\joinup_taxonomy\Entity\MappedTerm;

/**
 * Implements hook_entity_bundle_info_alter().
 */
function spdx_entity_bundle_info_alter(array &$bundles): void {
  if (!empty($bundles['taxonomy_term']['spdx_licence'])) {
    $bundles['taxonomy_term']['spdx_licence']['class'] = MappedTerm::class;
  }
}
