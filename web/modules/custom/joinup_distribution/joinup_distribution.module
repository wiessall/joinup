<?php

/**
 * @file
 * Hook implementations for Distribution module.
 */

declare(strict_types=1);

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\Core\Field\FieldStorageDefinitionInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\joinup_distribution\DistributionsFieldItemList;
use Drupal\joinup_distribution\Entity\Distribution;
use Drupal\joinup_distribution\Entity\DistributionInterface;
use Drupal\joinup_distribution\Entity\DistributionsParentInterface;
use Drupal\joinup_distribution\Plugin\DataType\EntityReference;
use Drupal\joinup_taxonomy\Entity\MappedTerm;
use Symfony\Component\HttpKernel\Exception\AccessDeniedHttpException;

/**
 * Implements hook_data_type_info_alter().
 *
 * @todo Drop this hook in ISAICP-8572.
 */
function joinup_distribution_data_type_info_alter(&$data_types): void {
  if (isset($data_types['entity_reference'])) {
    $data_types['entity_reference']['class'] = EntityReference::class;
  }
}

/**
 * Implements hook_entity_bundle_info_alter().
 */
function joinup_distribution_entity_bundle_info_alter(array &$bundles): void {
  if (!empty($bundles['node']['distribution'])) {
    $bundles['node']['distribution']['class'] = Distribution::class;
  }
  $vids = ['file_type', 'representation_technique'];
  foreach ($vids as $vid) {
    if (!empty($bundles['taxonomy_term'][$vid])) {
      $bundles['taxonomy_term'][$vid]['class'] = MappedTerm::class;
    }
  }
}

/**
 * Implements hook_entity_base_field_info_alter().
 */
function joinup_distribution_entity_base_field_info_alter(array &$fields, EntityTypeInterface $entity_type): void {
  if ($entity_type->id() === 'node' && !empty($fields['title'])) {
    $fields['title']->addConstraint('UniqueDistributionTitle', []);
  }
}

/**
 * Implements hook_entity_bundle_field_info().
 */
function joinup_distribution_entity_bundle_field_info(EntityTypeInterface $entity_type, $bundle, array $base_field_definitions): array {
  if ($entity_type->id() !== 'rdf_entity') {
    return [];
  }

  if (!in_array($bundle, ['joinup_release', 'solution'])) {
    return [];
  }

  // Define a distributions field that computes the distributions of a solution
  // or a release and can be placed in the displays.
  $fields['distributions'] = BaseFieldDefinition::create('entity_reference')
    ->setLabel(t('Distributions'))
    ->setDescription(t('The distributions of this entity.'))
    ->setCardinality(FieldStorageDefinitionInterface::CARDINALITY_UNLIMITED)
    ->setComputed(TRUE)
    ->setSetting('target_type', 'node')
    ->setSetting('handler', 'default')
    ->setSetting('handler_settings', [
      'target_bundles' => [
        'distribution' => 'distribution',
      ],
      'sort' => [
        'field' => 'created',
        'direction' => 'DESC',
      ],
    ])
    ->setDisplayOptions('view', [
      'label' => 'hidden',
      'type' => 'entity_reference_entity_view',
      'weight' => 0,
    ])
    ->setDisplayConfigurable('form', FALSE)
    ->setDisplayConfigurable('view', TRUE)
    ->setClass(DistributionsFieldItemList::class);

  return $fields;
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function joinup_distribution_form_node_distribution_form_alter(array &$form, FormStateInterface $formState): void {
  $parent = \Drupal::routeMatch()->getParameter('rdf_entity');
  if (empty($parent)) {
    // Try to also check if a node parameter is passed as releases are nodes.
    // @todo This should be converted to only checking nodes in ISAICP-8572.
    $parent = \Drupal::routeMatch()->getParameter('node');
  }

  // Bail out if the solution or release is not present on the route. Since this
  // form is only intended to be used in the context of a solution or  release,
  // there is no field provided for it. Without a solution or a release the
  // distribution will be dangling and won't be reachable.
  if (!$parent || !$parent instanceof DistributionsParentInterface) {
    throw new AccessDeniedHttpException('Distributions can only be created in context of a solution or an asset release.');
  }
}

/**
 * Implements hook_ENTITY_TYPE_access().
 */
function joinup_distribution_node_access(EntityInterface $entity, string $operation, AccountInterface $account): AccessResultInterface {
  if (!$entity instanceof DistributionInterface) {
    return AccessResult::neutral();
  }

  $solution = $entity->getSolution();
  if ($operation !== 'view' && $solution->isArchived()) {
    return AccessResult::forbidden()->addCacheableDependency($solution);
  }

  return AccessResult::neutral()->addCacheableDependency($solution);
}

/**
 * Implements hook_preprocess_HOOK().
 */
function joinup_distribution_preprocess_node(array &$variables): void {
  $distribution = $variables['node'];
  if ($distribution instanceof DistributionInterface && $variables['view_mode'] === 'compact') {
    // Provide a flag if this is a standalone distribution.
    $variables['is_standalone'] = $distribution->isStandalone();
  }
}

/**
 * Implements hook_preprocess_HOOK().
 */
function joinup_distribution_preprocess_views_view_field(array &$variables): void {
  $view = $variables['view'];
  $field = $variables['field'];
  if ($view->storage->id() !== 'distribution_downloads' || $view->current_display !== 'page' || $field->field !== 'parent_entity_id') {
    return;
  }

  /** @var \Drupal\joinup_distribution\Entity\DownloadEvent $downloadEvent */
  $downloadEvent = $variables['row']->_entity;
  if ($downloadEvent->get('parent_entity_type')->isEmpty() || $downloadEvent->get('parent_entity_id')->isEmpty()) {
    return;
  }

  // Notice: This code works for any entity type, though it is only meant for
  // distributions, so it might be too much.
  $entityType = $downloadEvent->get('parent_entity_type')->value;
  $entityId = $downloadEvent->get('parent_entity_id')->value;

  try {
    $storage = $storages[$entityType] ?? \Drupal::entityTypeManager()->getStorage($entityType);
  }
  catch (\Exception $exception) {
    return;
  }

  $entity = $storage->load($entityId);
  if (!empty($entity)) {
    $variables['output'] = $entity->toLink($entity->label());
  }
}
