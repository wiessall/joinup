{
    "name": "drupal/eu_oss_catalogue",
    "description": "EU Open Source Solutions Catalogue, with federated sources & repositories",
    "type": "drupal-module",
    "homepage": "https://www.drupal.org/sandbox/itamair/3372413",
    "authors": [
        {
            "name": "Claudiu Cristea",
            "homepage": "https://www.drupal.org/u/claudiucristea",
            "role": "Maintainer"
        },
        {
            "name": "Italo Mairo",
            "homepage": "https://www.drupal.org/u/itamair",
            "role": "Maintainer"
        }
    ],
    "support": {
        "source": "https://git.drupalcode.org/sandbox/itamair-3372413.git",
        "merges_requests": "https://git.drupalcode.org/sandbox/itamair-3372413/-/merge_requests"
    },
    "license": "GPL-2.0+",
    "minimum-stability": "dev",
    "require": {
        "bitbucket/client": "^4.5",
        "cfpinto/graphql": "dev-master",
        "claudiu-cristea/drupal-cache-adapter": "^1.0",
        "cweagans/composer-patches": "^1.7",
        "drupal/markdown_easy": "^1.0",
        "drupal/multivalue_form_element": "^1.0",
        "knplabs/github-api": "^3.0",
        "m4tthumphrey/php-gitlab-api": "^11.11",
        "spdx/license-list-data": "1.0.0"
    },
    "require-dev": {
        "drupal/http_request_mock": "^1.1",
        "drush/drush": "^12.1"
    },
    "extra": {
        "enable-patching": true,
        "composer-exit-on-patch-failure": true,
        "patches": {
            "cfpinto/graphql": {
                "Enum argument: https://github.com/cfpinto/graphql/issues/24": "https://patch-diff.githubusercontent.com/raw/cfpinto/graphql/pull/25.diff"
            },
            "m4tthumphrey/php-gitlab-api": {
                "GraphQL API: https://github.com/GitLabPHP/Client/issues/766": "resources/patch/php/drupal/m4tthumphrey/php-gitlab-api/772.diff"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "cweagans/composer-patches": true
        }
    },
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "spdx/license-list-data",
                "version": "1.0.0",
                "source": {
                    "url": "https://github.com/spdx/license-list-data",
                    "type": "git",
                    "reference": "main"
                }
            }
        },
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ]
}
