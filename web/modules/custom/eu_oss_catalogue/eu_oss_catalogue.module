<?php

/**
 * @file
 * Hook implementations for EU OSS Catalogue module.
 */

declare(strict_types=1);

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\eu_oss_catalogue\Entity\OssContact;
use Drupal\eu_oss_catalogue\Entity\OssContractor;
use Drupal\eu_oss_catalogue\Entity\OssSolution;
use Drupal\eu_oss_catalogue\Entity\OssSolutionInterface;
use Drupal\eu_oss_catalogue\Plugin\Field\RelevantField;
use Drupal\eu_oss_catalogue\Plugin\Field\RelevantLanguageCode;
use Drupal\node\NodeInterface;

/**
 * Implements hook_entity_bundle_info_alter().
 */
function eu_oss_catalogue_entity_bundle_info_alter(array &$bundles): void {
  if (!empty($bundles['node']['oss_solution'])) {
    $bundles['node']['oss_solution']['class'] = OssSolution::class;
  }
  if (!empty($bundles['node']['oss_contact'])) {
    $bundles['node']['oss_contact']['class'] = OssContact::class;
  }
  if (!empty($bundles['node']['oss_contractor'])) {
    $bundles['node']['oss_contractor']['class'] = OssContractor::class;
  }
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function eu_oss_catalogue_form_views_exposed_form_alter(array &$form, FormStateInterface $form_state): void {
  /** @var \Drupal\views\ViewExecutable $view */
  $view = $form_state->get('view');
  if ($view->id() === 'eu_oss_catalogue_admin' && $view->current_display === 'admin') {
    /** @var \Drupal\eu_oss_catalogue\EuOssCataloguePluginManagerInterface $providerPluginManager */
    $providerPluginManager = \Drupal::service('plugin.manager.eu_oss_catalogue.provider');
    $form['oss_source'] = [
      '#type' => 'select',
      '#options' => ['' => t('- Any -')] + $providerPluginManager->getDefinitionsAsOptions('label'),
      '#default_value' => $form['oss_source']['#default_value'],
    ];

    // Use yes-no instead of true-false.
    $form['oss_archived']['#options'][1] = t('Yes');
    $form['oss_archived']['#options'][0] = t('No');
  }
}

/**
 * Implements hook_entity_bundle_field_info().
 */
function eu_oss_catalogue_entity_bundle_field_info(EntityTypeInterface $entityType, ?string $bundle): array {
  $fields = [];
  if ($entityType->id() === 'node' && $bundle === 'oss_solution') {
    $fields['oss__description'] = BaseFieldDefinition::create('text_long')
      ->setLabel(t('Short description'))
      ->setComputed(TRUE)
      ->setDisplayConfigurable('view', TRUE)
      ->setSetting(
        RelevantField::SOURCE_FIELDS_SETTING_KEY,
        [
          'oss_short_description',
          'oss_git_description',
        ]
      )
      ->setSetting(RelevantField::RICHEST_FIELDS_SETTING_KEY, FALSE)
      ->setClass(RelevantField::class);
  }
  return $fields;
}

/**
 * Implements hook_entity_bundle_field_info_alter().
 */
function eu_oss_catalogue_entity_bundle_field_info_alter(array &$fields, EntityTypeInterface $entityType, ?string $bundle): void {
  if ($entityType->id() !== 'node' || $bundle !== 'oss_solution') {
    return;
  }

  // If there are field candidates, also add the richest language code computed
  // field.
  $fields[RelevantLanguageCode::FIELD_NAME] = BaseFieldDefinition::create('language')
    ->setName(RelevantLanguageCode::FIELD_NAME)
    ->setTargetEntityTypeId($entityType->id())
    ->setTargetBundle($bundle)
    ->setLabel(t('Relevant language code'))
    ->setComputed(TRUE)
    ->setClass(RelevantLanguageCode::class);

  // During module installation, configurable fields may not be available yet
  // when this hook is called, as the EntityFieldManager cache hasn't been
  // rebuilt. Filter out any missing fields to handle this timing issue.
  $computedFieldCandidates = array_filter([
    $fields['oss_screenshots'] ?? NULL,
    $fields['oss_documentation'] ?? NULL,
  ]);
  foreach ($computedFieldCandidates as $fieldDefinition) {
    \assert($fieldDefinition instanceof FieldDefinitionInterface);
    $computedName = preg_replace('#^oss_(.*)$#', 'oss__$1', $fieldDefinition->getName());

    // Field config labels have the " [stored]" suffix, what we remove here.
    // This original label might be a string or a (translatable)
    // MarkupInterface.
    $relevantLabel = preg_replace('/ \[stored\]/', '', (string) $fieldDefinition->getLabel());
    $fields[$computedName] = BaseFieldDefinition::createFromFieldStorageDefinition($fieldDefinition->getFieldStorageDefinition())
      ->setName($computedName)
      ->setLabel($relevantLabel)
      ->setSetting(RelevantField::SOURCE_FIELDS_SETTING_KEY, [$fieldDefinition->getName()])
      ->setSetting(RelevantField::RICHEST_FIELDS_SETTING_KEY, TRUE)
      ->setComputed(TRUE)
      ->setDisplayConfigurable('view', TRUE)
      ->setClass(RelevantField::class);
  }
}

/**
 * Implements hook_node_access().
 */
function eu_oss_catalogue_node_access(NodeInterface $entity, string $operation, AccountInterface $account): AccessResult {
  if (!$entity instanceof OssSolutionInterface || $operation !== 'view') {
    return AccessResult::neutral();
  }

  // Only admin can view archived solutions.
  return AccessResult::forbiddenIf($entity->isArchived() && !$account->hasPermission('administer eu oss catalogue'))
    ->addCacheableDependency($entity)
    ->cachePerPermissions();
}

/**
 * Implements hook_theme().
 */
function eu_oss_catalogue_theme(): array {
  return [
    'validation_issue' => [
      'variables' => [
        'type' => NULL,
        'key' => NULL,
        'line' => NULL,
        'column' => NULL,
        'description' => NULL,
      ],
    ],
  ];
}

/**
 * Implements hook_cron().
 */
function eu_oss_catalogue_cron(): void {
  $state = \Drupal::state();
  $request_time = \Drupal::time()->getRequestTime();
  $last_check = $state->get('eu_oss_catalogue.last_check', 0);
  // 24Hours.
  $interval = 86400;
  if (($request_time - $last_check) < $interval) {
    return;
  }
  $queue_fetcher = \Drupal::queue('eu_oss_catalogue_fetcher');
  $queue_fetcher->createQueue();

  /** @var \Drupal\eu_oss_catalogue\EuOssCataloguePluginManagerInterface $providerPluginManager */
  $providerPluginManager = \Drupal::service('plugin.manager.eu_oss_catalogue.provider');
  foreach ($providerPluginManager->getDefinitionsAsOptions('label') as $provider => $label) {
    $queue_fetcher->createItem(['provider' => $provider]);
  }

  // Establish the timestamp as 2 AM of the current day.
  $datetime = new \DateTime('@' . $request_time);
  $datetime->setTime(2, 0);
  $state->set('eu_oss_catalogue.last_check', $datetime->getTimestamp());
  \Drupal::logger('eu_oss_catalogue')->info('Cron eu_oss_catalogue_cron ran successfully.');
}
