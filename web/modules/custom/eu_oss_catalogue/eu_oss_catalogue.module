<?php

/**
 * @file
 * Hook implementations for EU OSS Catalogue module.
 */

declare(strict_types = 1);

use Drupal\Core\Entity\ContentEntityTypeInterface;
use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\StringTranslation\TranslatableMarkup;
use Drupal\eu_oss_catalogue\Entity\OssContact;
use Drupal\eu_oss_catalogue\Entity\OssContractor;
use Drupal\eu_oss_catalogue\Entity\OssSolution;
use Drupal\eu_oss_catalogue\Plugin\Field\RelevantField;
use Drupal\eu_oss_catalogue\Plugin\Field\RelevantLanguageCode;

/**
 * Implements hook_entity_bundle_info_alter().
 */
function eu_oss_catalogue_entity_bundle_info_alter(array &$bundles): void {
  if (!empty($bundles['node']['oss_solution'])) {
    $bundles['node']['oss_solution']['class'] = OssSolution::class;
  }
  if (!empty($bundles['node']['oss_contact'])) {
    $bundles['node']['oss_contact']['class'] = OssContact::class;
  }
  if (!empty($bundles['node']['oss_contractor'])) {
    $bundles['node']['oss_contractor']['class'] = OssContractor::class;
  }
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function eu_oss_catalogue_form_views_exposed_form_alter(array &$form, FormStateInterface $form_state): void {
  /** @var \Drupal\views\ViewExecutable $view */
  $view = $form_state->get('view');
  if ($view->id() === 'eu_oss_catalogue_admin' && $view->current_display === 'admin') {
    /** @var \Drupal\eu_oss_catalogue\EuOssCataloguePluginManagerInterface $providerPluginManager */
    $providerPluginManager = \Drupal::service('plugin.manager.eu_oss_catalogue.provider');
    $form['oss_source'] = [
      '#type' => 'select',
      '#options' => ['' => t('- Any -')] + $providerPluginManager->getDefinitionsAsOptions('label'),
      '#default_value' => $form['oss_source']['#default_value'],
    ];
  }
}

/**
 * Implements hook_entity_bundle_field_info().
 */
function eu_oss_catalogue_entity_bundle_field_info(EntityTypeInterface $entity_type, $bundle): array {
  $fields = [];
  if ($entity_type->id() === 'node' && $bundle === 'oss_solution') {

    // We will convert these labels back to the source field's label.
    /* @see \eu_oss_catalogue_preprocess_field() */
    $label = t(
      '@original-field-label (from relevant translation, with fallback)',
      ['@original-field-label' => t('Short description')],
      ['context' => 'Relevant field admin label']
    );

    $fields['description'] = BaseFieldDefinition::create('string_long')
      ->setLabel($label)
      ->setComputed(TRUE)
      ->setDisplayConfigurable('view', TRUE)
      ->setSetting(
        RelevantField::SOURCE_FIELDS_SETTING_KEY,
        [
          'oss_short_description',
          'oss_git_description',
        ]
      )
      ->setClass(RelevantField::class);
  }
  return $fields;
}

/**
 * Implements hook_entity_bundle_field_info_alter().
 */
function eu_oss_catalogue_entity_bundle_field_info_alter(&$fields, EntityTypeInterface $entity_type, $bundle): void {
  if ($bundle !== 'oss_solution' || !$entity_type instanceof ContentEntityTypeInterface) {
    return;
  }

  $computedFieldCandidates = array_filter(
    $fields,
    function (FieldDefinitionInterface $definition) {
      // Include every translatable field which is not computed and can be
      // configured on entity view display.
      return $definition->isTranslatable()
        && !$definition->isComputed()
        && $definition->isDisplayConfigurable('view');
    }
  );

  // If there are field candidates, also add the richest language code computed
  // field.
  if (!empty($computedFieldCandidates)) {
    $fields[RelevantLanguageCode::FIELD_NAME] = BaseFieldDefinition::create('language')
      ->setLabel(t('Relevant language code'))
      ->setComputed(TRUE)
      ->setClass(RelevantLanguageCode::class);
  }

  // Create a computed field for every translatable fields which than will
  // display the field value fetched from the richest language code.
  foreach ($computedFieldCandidates as $originalFieldName => $fieldDefinition) {
    \assert($fieldDefinition instanceof FieldDefinitionInterface);
    $computedName = preg_replace('#^oss_(.*)$#', 'oss__$1', $originalFieldName);

    // We will convert these labels back to the source field's label.
    /* @see \eu_oss_catalogue_preprocess_field() */
    $relevantLabel = t(
      '@original-field-label (from relevant translation)',
      ['@original-field-label' => $fieldDefinition->getLabel()],
      ['context' => 'Relevant field admin label']
    );

    $fields[$computedName] = BaseFieldDefinition::createFromFieldStorageDefinition($fieldDefinition->getFieldStorageDefinition())
      ->setName($computedName)
      ->setLabel($relevantLabel)
      ->setSetting(RelevantField::SOURCE_FIELDS_SETTING_KEY, [$originalFieldName])
      ->setComputed(TRUE)
      ->setDisplayConfigurable('view', TRUE)
      ->setClass(RelevantField::class);
  }
}

/**
 * Implements hook_preprocess_HOOK() for field.
 *
 * Restores the label in templates to the source field label of RelevantField
 * instances when fields are displayed.
 */
function eu_oss_catalogue_preprocess_field(&$variables): void {
  if (
    !isset($variables['element']['#title'])
    || !($label = &$variables['element']['#title']) instanceof TranslatableMarkup
  ) {
    return;
  }

  $markupOptions = $label->getOptions();
  if (($markupOptions['context'] ?? '') !== 'Relevant field admin label') {
    return;
  }

  $originalLabel = $label->getArguments()['@original-field-label'] ?? NULL;
  if (!isset($originalLabel)) {
    return;
  }

  if ($label === $variables['label']) {
    $variables['label'] = $originalLabel;
  }

  $label = $originalLabel;
}
