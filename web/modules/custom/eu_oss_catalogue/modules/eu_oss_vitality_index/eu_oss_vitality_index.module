<?php

/**
 * @file
 * Hook implementations for EU OSS Vitality index module.
 */

declare(strict_types=1);

/**
 * Implements hook_cron().
 */
function eu_oss_vitality_index_cron(): void {
  $state = \Drupal::state();
  $lastProcessedNid = $state->get('eu_oss_catalogue.vitality_index.last_nid', 0);
  \Drupal::service('eu_oss_catalogue.vitality_index')->processBatch($lastProcessedNid);
  if ($lastProcessedNid === NULL) {
    // A complete pass through all OSS solutions is done. Reset the tracker.
    $state->delete('eu_oss_catalogue.vitality_index.last_nid');
  }
  // Save next node ID.
  $state->set('eu_oss_catalogue.vitality_index.last_nid', $lastProcessedNid);
}

/**
 * Implements hook_theme().
 */
function eu_oss_vitality_index_theme(): array {
  return [
    'vitality_index_chart' => [
      'variables' => [
        'info' => NULL,
        'range' => [],
      ],
    ],
  ];
}

/**
 * Prepares variables for vitality-index-chart.html.twig templates.
 */
function template_preprocess_vitality_index_chart(&$variables): void {
  $variables['attributes']['data-vitality-index-range'] = $variables['range'];
}
