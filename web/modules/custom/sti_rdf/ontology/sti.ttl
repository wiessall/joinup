# Curated axioms for the sti: namespace (platform, tier 1).
# Merged into the generated namespace document by OntologyDocumentBuilder.
# Declare here only what rdf_sync config cannot express.

@prefix sti:     <https://sti-portal.fao.org/sti#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix schema:  <https://schema.org/> .

<https://sti-portal.fao.org/sti>
    rdfs:label "STI Portal platform vocabulary"@en .

sti:SourceRecord
    a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:comment """One collection's record of an innovation, as harvested and
    normalised. Never merged with another collection's record: sameness is a
    sti:sameInnovationAs claim on each record, naming the other."""@en .

sti:sameInnovationAs
    a rdf:Property ;
    rdfs:label "same innovation as"@en ;
    schema:domainIncludes sti:SourceRecord ;
    schema:rangeIncludes sti:SourceRecord ;
    rdfs:comment """Used as the claimProperty of a FieldClaim whose
    claimRefValue is another source record: both describe the same
    innovation. Written on both records by duplicate review, each claim
    attributed to the collection holding that record, and kept across
    re-imports."""@en .

sti:FieldClaim
    a owl:Class ;
    rdfs:comment """A reified statement by one collection about one property
    of a source record: claimedBy, claimProperty, claimRefValue or
    claimLiteralValue, claimedAt."""@en .

sti:claimedBy
    schema:rangeIncludes dcat:Catalog .

sti:inCollection
    rdfs:subPropertyOf dcterms:isPartOf ;
    schema:rangeIncludes dcat:Catalog .
