<?php

/**
 * @file
 * Install and update hooks for STI RDF.
 */

declare(strict_types=1);

/**
 * P0: switch STI bundles to typed sti_namespace URI plugins.
 *
 * Config only. Bare 'sti_namespace' stops being a valid plugin id when the
 * deriver arrives, and collections and owners leave Joinup's
 * data.europa.eu/w21 namespace, so this must run in the same deploy as the
 * code. Entities created from now on get https://sti-portal.fao.org/id/ URIs.
 *
 * URIs already stored are deliberately left alone. rdf_sync replaces an
 * entity's triples by the URI it has stored; rewriting that URI without
 * rebuilding the graph would strand the old triples next to the new ones.
 * Left alone, every entity stays consistent with the graph on its next save.
 *
 * To re-mint existing URIs, in a maintenance window:
 *   ddev drush sti-rdf:uri-remint
 *   (drop the graph)
 *   ddev drush rdf_sync:synchronize node
 *   ddev drush rdf_sync:synchronize paragraph
 *   ddev drush rdf_sync:synchronize taxonomy_term
 */
function sti_rdf_update_11001(): string {
  // \Drupal::service() is the only way in: update hooks are procedural and
  // offer no injection point.
  /** @var \Drupal\sti_rdf\Service\UriReminter $reminter */
  $reminter = \Drupal::service('sti_rdf.uri_reminter');

  // The URI generator just gained a deriver; make sure plugin discovery does
  // not serve the old, underived definition from cache.
  \Drupal::service('plugin.cache_clearer')->clearCachedDefinitions();
  $bundles = $reminter->applyConfigChanges();
  $legacy = array_sum($reminter->verify());

  return (string) t('Switched @bundles bundle(s) to typed URI plugins. @legacy stored URI(s) still use a pre-P0 pattern; re-mint them with drush sti-rdf:uri-remint when the graph can be rebuilt.', [
    '@bundles' => $bundles,
    '@legacy' => $legacy,
  ]);
}
