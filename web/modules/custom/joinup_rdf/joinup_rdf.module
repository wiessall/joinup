<?php

/**
 * @file
 * Hook implementations for the Joinup RDF module.
 */

declare(strict_types=1);

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\BubbleableMetadata;
use Drupal\joinup_distribution\Entity\DistributionInterface;
use Drupal\joinup_rdf\Entity\RdfSyncEntityInterface;
use Drupal\joinup_release\Entity\ReleaseInterface;
use Drupal\joinup_solution\Entity\SolutionInterface;
use Drupal\rdf_sync\Model\SyncMethod;

/**
 * Implements hook_form_BASE_FORM_ID_alter().
 */
function joinup_rdf_form_node_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  /** @var \Drupal\Core\Extension\ModuleHandlerInterface $module_handler */
  $module_handler = \Drupal::service('module_handler');
  if ($module_handler->moduleExists('honeypot')) {
    $honeypot_forms = [
      'node_collection_propose_form',
      'node_collection_edit_form',
      'node_distribution_form',
      'node_distribution_edit_form',
      'node_licence_add_form',
      'node_licence_edit_form',
      'node_release_form',
      'node_release_edit_form',
      'node_solution_form',
      'node_solution_edit_form',
    ];
    if (in_array($form_id, $honeypot_forms)) {
      \Drupal::service('honeypot')->addFormProtection(
        $form,
        $form_state,
        ['honeypot', 'time_restriction']
      );
    }
  }
}

/**
 * Implements hook_token_info_alter().
 */
function joinup_rdf_token_info_alter(&$info): void {
  $rdfUriInfo = [
    'name' => t('The legacy RDF uri of the entity'),
    'description' => t('The legacy RDF uri of the entity, if any.'),
  ];
  $info['tokens']['node']['rdf-uri'] = $rdfUriInfo;
  $info['tokens']['term']['rdf-uri'] = $rdfUriInfo;
}

/**
 * Implements hook_tokens().
 */
function joinup_rdf_tokens($type, $tokens, array $data, array $options, BubbleableMetadata $bubbleable_metadata): array {
  $entity = $data[$type] ?? NULL;
  if (
    !array_key_exists('rdf-uri', $tokens) ||
    !isset($entity) ||
    !$entity instanceof RdfSyncEntityInterface
  ) {
    return [];
  }

  $bubbleable_metadata->addCacheableDependency($entity);
  return [
    $tokens['rdf-uri'] => $entity->getUri(),
  ];
}

/**
 * Implements hook_entity_insert().
 */
function joinup_rdf_entity_insert(EntityInterface $entity): void {
  // Use the entity insert, even though it is only for nodes, so that we can run
  // this after the rdf_sync hook_entity_insert.
  if (!$entity instanceof RdfSyncEntityInterface) {
    return;
  }

  _joinup_rdf_resync_parent_entities($entity);
}

/**
 * Implements hook_entity_update().
 */
function joinup_rdf_entity_update(EntityInterface $entity): void {
  // Use the entity insert, even though it is only for nodes, so that we can run
  // this after the rdf_sync hook_entity_update.
  if (!$entity instanceof RdfSyncEntityInterface) {
    return;
  }

  _joinup_rdf_resync_parent_entities($entity);
}

/**
 * Resync the parent entities of the given entity.
 *
 * @param \Drupal\Core\Entity\EntityInterface $entity
 *   The entity that was inserted or updated.
 */
function _joinup_rdf_resync_parent_entities(EntityInterface $entity): void {
  // For solutions, re-sync the parent collection to also include the relation
  // to the solution.
  if ($entity instanceof SolutionInterface) {
    $parent = $entity->getCollection();
  }
  // For releases, re-sync the parent solution to include the hasVersion
  // property.
  elseif ($entity instanceof ReleaseInterface) {
    $parent = $entity->getSolution();
  }
  // For distributions, re-sync the parent - whether solution or release - to
  // include the distribution property.
  elseif ($entity instanceof DistributionInterface) {
    $parent = $entity->getParent();
  }

  if (!empty($parent)) {
    \Drupal::getContainer()->get('rdf_sync.synchronizer')->synchronize(
      SyncMethod::UPDATE,
      [$parent]
    );
  }
}

/**
 * Implements hook_module_implements_alter().
 */
function joinup_rdf_module_implements_alter(&$implementations, $hook): void {
  if ($hook === 'entity_insert' || $hook === 'entity_update') {
    // Move the joinup_rdf implementation to the end of the list.
    $group = $implementations['joinup_rdf'];
    unset($implementations['joinup_rdf']);
    $implementations['joinup_rdf'] = $group;
  }
}

/**
 * Implements hook_ENTITY_TYPE_delete().
 */
function joinup_rdf_node_delete(EntityInterface $entity): void {
  if (!$entity instanceof RdfSyncEntityInterface) {
    return;
  }
  $uri = $entity->getUri();
  if (empty($uri)) {
    return;
  }
  // Delete entries where the entity is the object from the default graph.
  $graph_uri = \Drupal::config('rdf_sync.settings')->get('graph_uri');
  $query = <<<QUERY
WITH <{$graph_uri}>
DELETE {
  ?s ?p ?o .
}
WHERE {
  ?s ?p ?o .
  FILTER (?o = <{$uri}>) .
}
QUERY;
  \Drupal::service('rdf_sync.connection')->query($query);
}
