<?php

/**
 * @file
 * Hook implementations for the Joinup RDF module.
 */

declare(strict_types=1);

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Link;
use Drupal\Core\Render\BubbleableMetadata;
use Drupal\Core\Session\AccountInterface;
use Drupal\joinup_group\Entity\GroupInterface;
use Drupal\joinup_rdf\Entity\RdfSyncEntityInterface;
use Drupal\joinup_workflow\EntityWorkflowStateInterface;
use Drupal\og\Og;

/**
 * Implements hook_entity_create_access().
 */
function joinup_rdf_entity_create_access(AccountInterface $account, array $context, $bundle) {
  // OG handles node content in its own hook_entity_create_access(). This is the
  // RDF entity equivalent.
  $entity_type_id = $context['entity_type_id'];
  if ($entity_type_id !== 'rdf_entity') {
    return AccessResult::neutral();
  }

  if (!Og::isGroupContent($entity_type_id, $bundle)) {
    // Not a group content.
    return AccessResult::neutral();
  }

  // A user with the global permission to administer all groups has full access.
  $access_result = AccessResult::allowedIfHasPermission($account, 'administer organic groups');
  if ($access_result->isAllowed()) {
    return $access_result;
  }

  // This check needs the group parameter to be passed in the context. In order
  // to do that, the access check must be called through the access control
  // handler using:
  // @code
  // \Drupal::entityTypeManager()->getAccessControlHandler($entity_type_id)
  //   ->createAccess($bundle, $account, [
  //     'group' => $group,
  //   ]);
  // @endcode
  if (empty($context['group']) || !($context['group'] instanceof GroupInterface)) {
    // Fail silently as it might not be always the case that this is set.
    return AccessResult::neutral();
  }

  $group = $context['group'];
  // Note: The OG structure of the permission is used instead of the RDF entity.
  // That is why it is `rdf_entity` and not `rdf entity`.
  if (!$group->hasGroupPermission($account->id(), "create $bundle rdf_entity")) {
    return AccessResult::forbidden();
  }

  // Create an empty entity with the correct group in order to check the allowed
  // transitions.
  /** @var \Drupal\joinup_group\Entity\GroupContentInterface $entity */
  $entity = \Drupal::entityTypeManager()->getStorage($entity_type_id)->create([
    'rid' => $bundle,
  ]);

  // If the entity does not have a workflow, do not run a check.
  if (!($entity instanceof EntityWorkflowStateInterface)) {
    return AccessResult::neutral();
  }

  $entity->setGroup($group);
  return $entity->getWorkflow()->getAllowedTransitions($entity->getWorkflowState(), $entity)
    ? AccessResult::allowed()
    : AccessResult::forbidden();
}

/**
 * Implements hook_form_BASE_FORM_ID_alter().
 *
 * @todo Remove this hack as part of ISAICP-3021.
 * @see https://citnet.tech.ec.europa.eu/CITnet/jira/browse/ISAICP-3021
 *
 * Hide the table drag handlers on multivalue fields for RDF entities. These are
 * useless since weights are currently not stored and the ordering of the values
 * is not retained after submitting the form.
 */
function joinup_rdf_form_rdf_entity_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  /** @var \Drupal\rdf_entity\Form\RdfForm $form_object */
  $form_object = $form_state->getFormObject();
  /** @var \Drupal\rdf_entity\RdfInterface $rdf */
  $rdf = $form_object->getEntity();
  $exceptions = ['field_is_related_solutions'];

  /** @var \Drupal\Core\Field\FieldDefinitionInterface[] $field_definitions */
  $field_definitions = \Drupal::service('entity_field.manager')->getFieldDefinitions($rdf->getEntityTypeId(), $rdf->bundle());
  // Keep only fields that are on the form.
  $field_definitions = array_intersect_key($field_definitions, $form);
  foreach ($field_definitions as $field_name => $field_definition) {
    if ($field_definition->getFieldStorageDefinition()->isMultiple() && !in_array($field_definition->getName(), $exceptions)) {
      // We are questioning only multi-value fields.
      $form[$field_name]['#attributes']['class'][] = 'joinup-nodrag';
    }
  }

  /** @var \Drupal\Core\Extension\ModuleHandlerInterface $module_handler */
  $module_handler = \Drupal::service('module_handler');
  if ($module_handler->moduleExists('honeypot')) {
    $honeypot_forms = [
      'rdf_entity_collection_propose_form',
      'rdf_entity_collection_edit_form',
      'rdf_entity_solution_form',
      'rdf_entity_solution_edit_form',
      'rdf_entity_licence_add_form',
      'rdf_entity_licence_edit_form',
      'node_release_form',
      'node_release_edit_form',
      'node_distribution_form',
      'node_distribution_edit_form',
    ];
    if (in_array($form_id, $honeypot_forms)) {
      \Drupal::service('honeypot')->addFormProtection(
        $form,
        $form_state,
        ['honeypot', 'time_restriction']
      );
    }
  }
}

/**
 * Implements hook_entity_base_field_info().
 *
 * - Provides a 'path' field only for the 'rdf_entity' entities.
 */
function joinup_rdf_entity_base_field_info(EntityTypeInterface $entity_type) {
  $fields = [];

  // Allow alias features for RDF entities.
  if (($entity_type->id() === 'rdf_entity') && \Drupal::moduleHandler()->moduleExists('path')) {
    $fields['path'] = BaseFieldDefinition::create('path')
      ->setLabel(t('URL alias'))
      ->setTranslatable(TRUE)
      ->setComputed(TRUE);
  }

  return $fields;
}

/**
 * Implements hook_entity_type_alter().
 */
function joinup_rdf_entity_type_alter(array &$entity_types): void {
  /** @var \Drupal\Core\Entity\EntityTypeInterface[] $entity_types */
  if (isset($entity_types['rdf_entity'])) {
    // Add validation constraint to the node entity.
    // @todo Adapt in ISAICP-8376.
    $entity_types['rdf_entity']->addConstraint('IDMaxLength');
    // @todo Remove in ISAICP-8376.
    $entity_types['rdf_entity']->setLinkTemplate('rdf-export', '/rdf_entity/{rdf_entity}/export-metadata');
  }
}

/**
 * Implements hook_ENTITY_TYPE_storage_load().
 *
 * Fill $term->extension and $term->mime_type fields from 'file_type' vocabulary
 * by a direct query as, due to their RDF representation, this cannot be done by
 * a simple RDF field mapping. Because we do this at storage level, the values
 * get cached in the 'cache_entity' bin, avoiding performance issues.
 */
function joinup_rdf_taxonomy_term_storage_load(array $terms) {
  $sparql = \Drupal::service('sparql.endpoint');
  /** @var \Drupal\sparql_entity_storage\Driver\Database\sparql\ConnectionInterface $sparql */

  $query = <<<QUERY
SELECT ?extension ?mime_type
WHERE {
  <%s> <http://publications.europa.eu/ontology/authority/op-mapped-code> ?op_extension .
  ?op_extension <http://purl.org/dc/elements/1.1/source> "file-extension" .
  ?op_extension <http://publications.europa.eu/ontology/authority/legacy-code> ?extension .
  <%s> <http://publications.europa.eu/ontology/authority/op-mapped-code> ?op_mime_type .
  ?op_mime_type <http://purl.org/dc/elements/1.1/source> "manifestation-type-cellar" .
  ?op_mime_type <http://publications.europa.eu/ontology/authority/legacy-code> ?mime_type .
}
QUERY;

  /** @var \Drupal\taxonomy\TermInterface[] $terms */
  foreach ($terms as $term) {
    if ($term->bundle() === 'file_type') {
      $term_id = $term->id();
      $results = $sparql->query(sprintf($query, $term_id, $term_id));
      if ($results->count()) {
        $result = &$results[0];
        // A file type might have more than one extension separated by space.
        $extensions = array_filter(explode(' ', trim($result->extension->getValue())));
        foreach ($extensions as $extension) {
          $term->get('extension')->appendItem(['value' => $extension]);
        }
        $term->set('mime_type', trim($result->mime_type->getValue()));
      }
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_view().
 *
 * Shows an information message to users who have access to the draft version
 * of the rdf entity if the user is viewing the published version.
 */
function joinup_rdf_rdf_entity_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode) {
  // Show only in full mode views.
  if ($view_mode !== 'full') {
    return;
  }
  $graph = $entity->get('graph')->target_id;
  if ($graph !== 'default' || !$entity->hasGraph('draft')) {
    return;
  }

  // The draft link is already set in the list of the link templates of the rdf
  // entity as 'rdf-draft-{$graph_name}'.
  $url = $entity->toUrl('rdf-draft-draft');
  if (!$url->access()) {
    return;
  }

  $link = Link::fromTextAndUrl(t('here'), $url)->toString();
  \Drupal::messenger()->addMessage(t('You are viewing the published version. To view the latest draft version, click @here.', [
    '@here' => $link,
  ]), 'warning');
}

/**
 * Implements hook_condition_info_alter().
 */
function joinup_rdf_condition_info_alter(array &$definitions): void {
  if (!isset($definitions['rdf_entity_bundle'])) {
    throw new \Exception("The deprecated 'rdf_entity_bundle' condition plugin has been removed. Drop joinup_rdf_condition_info_alter() implementation");
  }
  // The 'rdf_entity_bundle' condition plugin is deprecated and replaced with
  // 'entity_bundle:rdf_entity'.
  // @see https://www.drupal.org/node/3283076
  unset($definitions['rdf_entity_bundle']);
}

/**
 * Implements hook_token_info_alter().
 */
function joinup_rdf_token_info_alter(&$info) {
  $rdfUriInfo = [
    'name' => t('The legacy RDF uri of the entity'),
    'description' => t('The legacy RDF uri of the entity, if any.'),
  ];
  $info['tokens']['node']['rdf-uri'] = $rdfUriInfo;
  $info['tokens']['term']['rdf-uri'] = $rdfUriInfo;
}

/**
 * Implements hook_tokens().
 */
function joinup_rdf_tokens($type, $tokens, array $data, array $options, BubbleableMetadata $bubbleable_metadata): array {
  $entity = $data[$type] ?? NULL;
  if (
    !array_key_exists('rdf-uri', $tokens) ||
    !isset($entity) ||
    !$entity instanceof RdfSyncEntityInterface
  ) {
    return [];
  }

  $bubbleable_metadata->addCacheableDependency($entity);
  return [
    $tokens['rdf-uri'] => $entity->getUri(),
  ];
}
