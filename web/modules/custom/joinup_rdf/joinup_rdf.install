<?php

/**
 * @file
 * Post update functions for the Joinup RDF module.
 */

declare(strict_types=1);

use Drupal\Component\Serialization\Json;
use Drupal\Core\Serialization\Yaml;

/**
 * Performs checks for the RDF entities and its storage.
 *
 * Performs the following checks:
 * - Checks for leftover graphs from the ADMS validation.
 * - Checks for orphaned triples.
 */
function joinup_rdf_requirements(string $phase): array {
  if ($phase !== 'runtime') {
    return [];
  }

  $requirements = [];

  // Ensure that leftover graphs from the ADMS validation graph do not exist.
  $requirements['joinup_rdf_content_integrity'] = [
    'title' => t('RDF content integrity'),
    'description' => t('A series of requirements that ensure the consistency in the SPARQL database.'),
    'severity' => REQUIREMENT_OK,
    'value' => t('No issues found.'),
  ];

  if ($errors = \Drupal::getContainer()->get('joinup_rdf.requirements_helper')->getRequirementErrors()) {
    $requirements['joinup_rdf_content_integrity']['severity'] = REQUIREMENT_ERROR;
    $requirements['joinup_rdf_content_integrity']['value'] = $errors;
  }

  return $requirements;
}

/**
 * Release EIRA references.
 */
function joinup_rdf_update_110500(): void {
  $sparql = \Drupal::getContainer()->get('sparql.endpoint');

  $idToUri = \Drupal::database()->select('rdf_sync_uri')
    ->fields('rdf_sync_uri', ['entity_id', 'uri'])
    ->condition('entity_type', 'taxonomy_term')
    ->condition('bundle', 'eira')
    ->execute()
    ->fetchAllKeyed();

  $query = <<<QUERY
    SELECT ?g ?s ?o
    WHERE {
      GRAPH ?g {
        ?s <http://joinup.eu/test_resource_type> ?o .
        FILTER ( REGEX(?o, "^\\\d+$") ) .
      }
    }
    QUERY;

  $rows = [];
  foreach ($sparql->query($query) as $row) {
    $rows[$row->g->getUri()][$row->s->getUri()][] = $row->o->getUri();
  }

  $cleanup = <<<CLEANUP
    WITH <%s>
    DELETE { ?s <http://joinup.eu/test_resource_type> ?o }
    WHERE {
      ?s <http://joinup.eu/test_resource_type> ?o .
      FILTER ( ?s IN(%s) ) .
    }
    CLEANUP;

  foreach ($rows as $graph => $triples) {
    $insert = ["INSERT DATA INTO <$graph> {"];
    $sparql->update(sprintf($cleanup, $graph, '<' . implode('>, <', array_keys($triples)) . '>'));
    foreach ($triples as $subject => $objects) {
      foreach ($objects as $object) {
        $uri = $idToUri[$object];
        $insert[] = "<$subject> <http://joinup.eu/test_resource_type> <$uri> .";
      }
    }
    $insert[] = '}';
    $sparql->update(implode("\n", $insert));
  }
}

/**
 * Delete SPDX Licence & Licence RDF entities.
 */
function joinup_rdf_update_110501(): void {
  // Save licences in a temporary file because we need to delete the content
  // prior to delete the bundle configs. Data will be restored later, in a
  // deploy hook.
  $store = \Drupal::getContainer()->get('joinup_sparql.graph_store.helper')->createGraphStore();
  $licences = $store->get('http://joinup.eu/licence/published')->toRdfPhp();
  file_put_contents('private://licences', Json::encode($licences));
  $sparql = \Drupal::getContainer()->get('sparql.endpoint');
  $sparql->update("CLEAR GRAPH <http://joinup.eu/spdx_licence/published>;");
  $sparql->update("CLEAR GRAPH <http://joinup.eu/licence/published>;");
}

/**
 * Store document > licence data.
 */
function joinup_rdf_update_110502(): void {
  $db = \Drupal::database();
  $documentToLicence = $db->select('node__field_licence', 'l')
    ->fields('l', ['entity_id', 'field_licence_target_id'])
    ->execute()
    ->fetchAllKeyed();
  file_put_contents('private://document_to_licence', Json::encode($documentToLicence));
  $db->truncate('node__field_licence')->execute();
  $db->truncate('node_revision__field_licence')->execute();
}

/**
 * Delete leftover path aliases of licence RDF entities.
 */
function joinup_rdf_update_110503(&$sandbox): string {
  if (!isset($sandbox['ids'])) {
    $sandbox['ids'] = \Drupal::database()->select('path_alias', 'pa')
      ->fields('pa', ['id'])
      ->condition('pa.alias', '/licence/%', 'LIKE')
      ->execute()
      ->fetchAllKeyed(0, 0);
    $sandbox['processed'] = 0;
    $sandbox['total'] = count($sandbox['ids']);
  }

  $idsToDelete = array_slice($sandbox['ids'], $sandbox['processed'], 50);
  $aliasStorage = \Drupal::entityTypeManager()->getStorage('path_alias');

  $aliasStorage->delete($aliasStorage->loadMultiple($idsToDelete));

  $deletedCount = count($idsToDelete);
  $sandbox['processed'] += $deletedCount;
  $sandbox['#finished'] = $sandbox['processed'] / $sandbox['total'];

  return "Deleted $deletedCount licence aliases ({$sandbox['processed']} / {$sandbox['total']}) total";
}

/**
 * Remove EIF perspective data.
 */
function joinup_rdf_update_110504(): void {
  $db = \Drupal::database();
  $perms = [
    'create eif wrapper entity',
    'create eif_perspective rdf-meta-entity',
    'delete eif wrapper entity',
    'update eif wrapper entity',
    'update eif_perspective rdf-meta-entity',
    'view eif wrapper entity',
    'view eif_perspective rdf-meta-entity',
  ];
  // Anticipate removal of several permissions to avoid errors on config sync.
  foreach (['anonymous', 'authenticated', 'moderator'] as $rid) {
    $config = unserialize($db->select('config')
      ->fields('config', ['data'])
      ->condition('collection', '')
      ->condition('name', "user.role.$rid")
      ->execute()
      ->fetchField(), ['allowed_classes' => FALSE]);
    $config['dependencies']['module'] = array_diff($config['dependencies']['module'], ['rdf_meta_entity']);
    $config['permissions'] = array_diff($config['permissions'], $perms);
    $db->update('config')
      ->fields(['data' => serialize($config)])
      ->condition('collection', '')
      ->condition('name', "user.role.$rid")
      ->execute();
  }
  \Drupal::configFactory()->reset();

  $store = \Drupal::getContainer()->get('joinup_sparql.graph_store.helper')->createGraphStore();
  $sparql = \Drupal::getContainer()->get('sparql.endpoint');

  $graphUri = 'http://joinup.eu/rdf_meta_entity/eif_perspective/graph/published';
  $graph = $store->get($graphUri);
  file_put_contents('private://eif.yml', Yaml::encode($graph->toRdfPhp()));
  $sparql->update("CLEAR GRAPH <$graphUri>");

  $graphUri = 'http://joinup.eu/eif-wrapper/graph/recommendation';
  $graph = $store->get($graphUri);
  file_put_contents('private://eif_wrapper.yml', Yaml::encode($graph->toRdfPhp()));
  $sparql->update("CLEAR GRAPH <$graphUri>");

  // The code will be removed later, in a second deployment.
  $manager = \Drupal::entityDefinitionUpdateManager();
  $eifWrapperType = $manager->getEntityType('eif_wrapper_type');
  $eifWrapper = $manager->getEntityType('eif_wrapper');
  $manager->uninstallEntityType($eifWrapperType);
  $manager->uninstallEntityType($eifWrapper);
}

/**
 * Dismantle federation.
 */
function joinup_rdf_update_110505(): void {
  // Anticipate removal of permissions from moderator role to avoid errors on
  // configuration synchronization.
  $db = \Drupal::database();
  $config = unserialize($db->select('config')
    ->fields('config', ['data'])
    ->condition('collection', '')
    ->condition('name', 'user.role.moderator')
    ->execute()
    ->fetchField(), ['allowed_classes' => FALSE]);
  $removedRoles = [
    'access pipeline report',
    'access pipeline selector',
    'execute dpsi pipeline',
    'execute eu_sic pipeline',
    'execute joinup_collection pipeline',
    'execute nio pipeline',
    'execute spain pipeline',
    'reset dpsi pipeline',
    'reset eu_sic pipeline',
    'reset joinup_collection pipeline',
    'reset nio pipeline',
    'reset spain pipeline',
  ];
  $removedModuleDependencies = ['pipeline', 'joinup_pipeline_log'];
  $config['permissions'] = array_diff($config['permissions'], $removedRoles);
  $config['dependencies']['module'] = array_diff($config['dependencies']['module'], $removedModuleDependencies);
  $db->update('config')
    ->fields(['data' => serialize($config)])
    ->condition('collection', '')
    ->condition('name', 'user.role.moderator')
    ->execute();

  // Cleanup joinup_pipeline_log key/value entries.
  $collection = \Drupal::getContainer()->get('keyvalue')->get('joinup_pipeline_log');
  $collection->deleteAll();

  // Remove provenance records from the RDF backend.
  \Drupal::getContainer()->get('sparql.endpoint')->update("CLEAR GRAPH <http://joinup.eu/provenance_activity>;");
}

/**
 * Clean up invalid release type entries and update the predicate.
 */
function joinup_rdf_update_110506(): void {
  $sparql = \Drupal::getContainer()->get('sparql.endpoint');
  $cleanup_query = <<<SPARQL
DELETE {
  GRAPH ?g {
    ?s <http://joinup.eu/test_resource_type> ?deletedTermUri .
  }
}
WHERE {
  GRAPH ?g {
    ?s a <http://www.w3.org/ns/dcat#Dataset> .
    ?s <http://joinup.eu/test_resource_type> ?deletedTermUri .
    FILTER NOT EXISTS {
      SELECT ?deletedTermUri
      WHERE {
        GRAPH <http://data> {
          ?deletedTermUri <http://www.w3.org/2004/02/skos/core#inScheme> <http://data.europa.eu/dr8> .
        }
      }
    }
  }
}
SPARQL;

  $sparql->update($cleanup_query);

  $update_query = <<<SPARQL
DELETE {
  GRAPH ?g {
    ?s <http://joinup.eu/test_resource_type> ?o .
  }
}
INSERT {
  GRAPH ?g {
    ?s <http://purl.org/dc/terms/type> ?o .
  }
}
WHERE {
  GRAPH ?g {
    ?s a <http://www.w3.org/ns/dcat#Dataset> .
    ?s <http://joinup.eu/test_resource_type> ?o .
    VALUES ?g { <http://joinup.eu/asset_release/published> <http://joinup.eu/asset_release/draft> }
  }
}
SPARQL;

  $sparql->update($update_query);
}
