<?php

/**
 * @file
 * Post update functions for the Joinup RDF module.
 */

declare(strict_types=1);

use Drupal\Component\Serialization\Yaml;
use Drupal\field\Entity\FieldStorageConfig;

/**
 * Performs checks for the RDF entities and its storage.
 *
 * Performs the following checks:
 * - Checks for leftover graphs from the ADMS validation.
 * - Checks for orphaned triples.
 */
function joinup_rdf_requirements(string $phase): array {
  if ($phase !== 'runtime') {
    return [];
  }

  $requirements = [];

  // Ensure that leftover graphs from the ADMS validation graph do not exist.
  $requirements['joinup_rdf_content_integrity'] = [
    'title' => t('RDF content integrity'),
    'description' => t('A series of requirements that ensure the consistency in the SPARQL database.'),
    'severity' => REQUIREMENT_OK,
    'value' => t('No issues found.'),
  ];

  if ($errors = \Drupal::getContainer()->get('joinup_rdf.requirements_helper')->getRequirementErrors()) {
    $requirements['joinup_rdf_content_integrity']['severity'] = REQUIREMENT_ERROR;
    $requirements['joinup_rdf_content_integrity']['value'] = $errors;
  }

  return $requirements;
}

/**
 * Delete the collection and solution entity types.
 */
function joinup_rdf_update_200001(): string {
  \Drupal::entityTypeManager()->getStorage('rdf_type')->delete(
    \Drupal::entityTypeManager()->getStorage('rdf_type')->loadByProperties([
      'rid' => [
        'collection',
        'solution',
        ],
      ]
    )
  );

  return 'Deleted collection and solution entity types.';
}

/**
 * Prepare various data in tables for the migration.
 */
function joinup_rdf_update_200002(): string {
  $connection = \Drupal::database();
  $messages = [];

  foreach (['like', 'bookmark'] as $flag_id) {
    // Update both the flag_id from `*_rdf_entity` to `*_node` and the
    // entity_type from `rdf_entity` to `node`.
    $query = <<<SQL
      UPDATE flagging
      SET flag_id = '{$flag_id}_node', entity_type = 'node'
      WHERE flag_id = '{$flag_id}_rdf_entity' AND entity_type = 'rdf_entity'
      SQL;
    $query = $connection->prepareStatement($query, [], TRUE);
    $query->execute();
    $count = $query->rowCount();
    $messages[] = "Updated $count rows in the flagging table for the $flag_id flagging.";
  }

  // Update the invitation table.
  $query = <<<SQL
    UPDATE invitation
    SET entity_type = 'node'
    WHERE entity_type = 'rdf_entity'
    SQL;
  $query = $connection->prepareStatement($query, [], TRUE);
  $query->execute();
  $count = $query->rowCount();
  $messages[] = "Updated $count rows in the invitation table.";

  // Update the invitation__field_invitation_og_role table.
  $query = <<<SQL
    UPDATE invitation__field_invitation_og_role
    SET field_invitation_og_role_target_id = REPLACE(field_invitation_og_role_target_id, 'rdf_entity', 'node')
    WHERE field_invitation_og_role_target_id LIKE '%rdf_entity%'
    SQL;
  $query = $connection->prepareStatement($query, [], TRUE);
  $query->execute();
  $count = $query->rowCount();
  $messages[] = "Updated $count rows in the invitation__field_invitation_og_role table.";

  // Update the meta_entity table.
  $query = <<<SQL
    UPDATE meta_entity
    SET target__target_type = 'node'
    WHERE target__target_type = 'rdf_entity'
    SQL;
  $query = $connection->prepareStatement($query, [], TRUE);
  $query->execute();
  $count = $query->rowCount();
  $messages[] = "Updated $count rows in the meta_entity table.";

  // Update the joinup_group_node_access table.
  $query = <<<SQL
    UPDATE joinup_group_node_access
    SET entity_type = 'node'
    WHERE entity_type = 'rdf_entity'
    SQL;
  $query = $connection->prepareStatement($query, [], TRUE);
  $query->execute();
  $count = $query->rowCount();
  $messages[] = "Updated $count rows in the joinup_group_node_access table.";

  // Update the og_membership table.
  $query = <<<SQL
    UPDATE og_membership
    SET entity_type = 'node'
    WHERE entity_type = 'rdf_entity'
    SQL;
  $query = $connection->prepareStatement($query, [], TRUE);
  $query->execute();
  $count = $query->rowCount();
  $messages[] = "Updated $count rows in the og_membership table.";

  // Update the og_membership__roles table.
  $query = <<<SQL
    UPDATE og_membership__roles
    SET roles_target_id = REPLACE(roles_target_id, 'rdf_entity', 'node')
    WHERE roles_target_id LIKE '%rdf_entity%'
    SQL;
  $query = $connection->prepareStatement($query, [], TRUE);
  $query->execute();
  $count = $query->rowCount();
  $messages[] = "Updated $count rows in the og_membership__roles table.";

  return implode("\n", $messages);
}

/**
 * Manually change fields that cannot have their schema changed with data in db.
 */
function joinup_rdf_update_200003(): string {
  $fieldStorages = [
    'node.field_shared_in',
    'node.field_news_referenced_solution',
    'node.og_audience',
    'media.og_audience',
    'ogmenu_instance.og_audience',
  ];
  $fieldInstances = [
    'field.field.media.image.og_audience',
    'field.field.media.video.og_audience',
    'field.field.media.file.og_audience',
    'field.field.node.news.field_news_referenced_solution',
    'field.field.node.video.og_audience',
    'field.field.node.news.og_audience',
    'field.field.node.news.field_shared_in',
    'field.field.node.glossary.og_audience',
    'field.field.node.event.og_audience',
    'field.field.node.event.field_shared_in',
    'field.field.node.document.og_audience',
    'field.field.node.document.field_shared_in',
    'field.field.node.distribution.og_audience',
    'field.field.node.discussion.og_audience',
    'field.field.node.discussion.field_shared_in',
    'field.field.node.custom_page.og_audience',
    'field.field.node.release.og_audience',
  ];

  foreach ($fieldStorages as $fieldStorage) {
    FieldStorageConfig::load($fieldStorage)->setSetting('target_type', 'node')->save();
  }

  $configFactory = \Drupal::configFactory();
  foreach ($fieldInstances as $fieldInstance) {
    $contents = Yaml::decode(file_get_contents("../config/sync/$fieldInstance.yml"));
    $configFactory->getEditable($fieldInstance)->setData($contents)->save();
  }

  \Drupal::getContainer()->get('entity_type.manager')->clearCachedDefinitions();
  \Drupal::getContainer()->get('entity_field.manager')->clearCachedFieldDefinitions();

  return 'Updated field storages: ' . implode(', ', $fieldStorages);
}

/**
 * Copy data to a backup table.
 */
function joinup_rdf_update_200004(): string {
  // Now that we have disabled rdf_entity, we cannot simply import
  // configuration as it breaks because of the og audience pointing to
  // rdf_entity at this stage. We also cannot leave the table with data
  // because the storage will fail to update because of the existing data.
  // Lastly, the data cannot remain as they are, because they point to a
  // non-numeric entity id. Thus, we need to copy data over to a backup
  // table and then truncate the original table. Then, after the migration
  // has run, and data are updated to point to the correct entity type, we
  // can copy the data back to the original table and delete the backup
  // table.
  $tables = [
    'node__field_news_referenced_solution' => 'field_news_referenced_solution_target_id',
    'node_revision__field_news_referenced_solution' => 'field_news_referenced_solution_target_id',
    'node__og_audience' => 'og_audience_target_id',
    'node_revision__og_audience' => 'og_audience_target_id',
    'media__og_audience' => 'og_audience_target_id',
    'media_revision__og_audience' => 'og_audience_target_id',
  ];

  $messages = [];
  $base_fields = [
    'bundle',
    'deleted',
    'entity_id',
    'revision_id',
    'langcode',
    'delta',
  ];

  foreach ($tables as $table => $target_column) {
    $database = \Drupal::database();
    $query = "CREATE TABLE IF NOT EXISTS {$table}_backup LIKE $table";
    $database->query($query);
    $messages[] = "Created backup table {$table}_backup LIKE $table.";

    $data = $database->select($table, 't')
      ->fields('t')
      ->execute()
      ->fetchAllAssoc('revision_id');

    if (!empty($data)) {
      $fields = $base_fields;
      $fields[] = $target_column;
      $values = [];
      foreach ($data as $row) {
        $values = (array) $row;
        // If any of the fields do not exist in the original table, we need to
        // throw an exception.
        if (array_diff(array_keys($values), $fields)) {
          throw new \Exception("Fields in the backup table do not match the original table.");
        }
      }
      $database->insert($table . '_backup')
        ->fields($fields)
        ->values($values)
        ->execute();
      $messages[] = "Inserted backup rows into $table.";
    }

    $database->truncate($table)->execute();
    $messages[] = "Truncated table $table.";
  }

  return implode("\n", $messages);
}

/**
 * Re run user_update_10000.
 */
function joinup_rdf_update_200005(): void {
  require_once DRUPAL_ROOT . '/core/modules/user/user.install';
  user_update_10000();
}
