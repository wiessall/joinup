<?php

/**
 * @file
 * Install, update and requirements functions for the Joinup RDF module.
 */

declare(strict_types=1);

use EasyRdf\Serialiser\Ntriples;

/**
 * Implements hook_requirements().
 */
function joinup_rdf_requirements(string $phase): array {
  if ($phase !== 'runtime') {
    return [];
  }

  $requirements = [];

  // Flag when the automatic RDF synchronization is switched off: while it is
  // disabled, entity changes are no longer pushed to the triplestore, so the
  // graph silently drifts out of sync with Drupal.
  if (!\Drupal::service('rdf_sync.synchronizer')->isSynchronizationEnabled()) {
    $requirements['joinup_rdf_synchronization'] = [
      'title' => t('RDF synchronization'),
      'value' => t('Disabled'),
      'description' => t('Automatic synchronization to the SPARQL endpoint is turned off. Entity changes are not being exported to the triplestore. Re-enable it with <code>drush rdf_sync:enable</code>.'),
      'severity' => REQUIREMENT_WARNING,
    ];
  }

  // Number of URIs verified per SPARQL query. A VALUES clause resolves through
  // the subject index, so batching keeps each query cheap while bounding the
  // number of round trips to the endpoint.
  $batchSize = 500;

  $database = \Drupal::database();
  $connection = \Drupal::service('rdf_sync.connection');
  $graphUri = \Drupal::config('rdf_sync.settings')->get('graph_uri');
  $serializer = new Ntriples();

  // Expected count of tracked entities per entity type.
  $expected = $database->select('rdf_sync_uri', 'u');
  $expected->addField('u', 'entity_type', 'entity_type');
  $expected->addExpression('COUNT(*)', 'total');
  $expected->groupBy('u.entity_type');
  $totals = $expected->execute()->fetchAllKeyed();

  $stats = [];
  try {
    foreach ($totals as $entityType => $total) {
      $total = (int) $total;
      $present = 0;
      $offset = 0;

      while ($offset < $total) {
        // {rdf_sync_uri} has no numeric key, so paginate on a stable sort.
        $uris = $database->select('rdf_sync_uri', 'u')
          ->fields('u', ['uri'])
          ->condition('u.entity_type', $entityType)
          ->orderBy('u.entity_id')
          ->range($offset, $batchSize)
          ->execute()
          ->fetchCol();

        if (!$uris) {
          break;
        }
        $offset += count($uris);

        $serialized = array_map(
          static fn(string $uri): string => $serializer->serialiseValue(['type' => 'uri', 'value' => $uri]),
          $uris,
        );
        $values = implode(' ', $serialized);
        $result = $connection->query("SELECT (COUNT(DISTINCT ?s) AS ?present) FROM <$graphUri> WHERE { VALUES ?s { $values } ?s ?p ?o }");
        foreach ($result as $row) {
          $present += (int) (string) $row->present;
        }
      }

      $stats[$entityType] = [
        'total' => $total,
        'present' => $present,
        'missing' => $total - $present,
      ];
    }
  }
  catch (\Exception $e) {
    $requirements['joinup_rdf_endpoint_data'] = [
      'title' => t('RDF endpoint data'),
      'value' => t('Unable to verify the SPARQL endpoint data.'),
      'description' => t('The check for entities missing from the SPARQL endpoint could not be completed: @message', ['@message' => $e->getMessage()]),
      'severity' => REQUIREMENT_WARNING,
    ];
    return $requirements;
  }

  $missing = array_sum(array_column($stats, 'missing'));
  $total = array_sum(array_column($stats, 'total'));

  if ($missing === 0) {
    $requirements['joinup_rdf_endpoint_data'] = [
      'title' => t('RDF endpoint data'),
      'value' => t('All @total tracked entities are present in the SPARQL endpoint.', ['@total' => $total]),
      'severity' => REQUIREMENT_OK,
    ];
    return $requirements;
  }

  // List only the entity types that are missing data, with a present/expected
  // breakdown; the individual URIs are intentionally omitted as the list can be
  // very long.
  $items = [];
  foreach ($stats as $entityType => $stat) {
    if ($stat['missing'] === 0) {
      continue;
    }
    $items[] = t('@type: @present of @total present (@missing missing)', [
      '@type' => $entityType,
      '@present' => $stat['present'],
      '@total' => $stat['total'],
      '@missing' => $stat['missing'],
    ]);
  }

  $requirements['joinup_rdf_endpoint_data'] = [
    'title' => t('RDF endpoint data'),
    'value' => t('@missing of @total tracked entities are missing from the SPARQL endpoint', [
      '@missing' => $missing,
      '@total' => $total,
    ]),
    'description' => [
      'summary' => [
        '#markup' => t('Some entities are tracked as synchronised but are absent from the graph (@graph) and should be re-exported to Virtuoso.', ['@graph' => $graphUri]),
      ],
      'breakdown' => [
        '#theme' => 'item_list',
        '#items' => $items,
      ],
    ],
    'severity' => REQUIREMENT_WARNING,
  ];

  return $requirements;
}
