<?php

/**
 * @file
 * Post update functions for the Joinup RDF module.
 */

declare(strict_types=1);
use Drupal\joinup_solution\Entity\Solution;
use Drupal\node\NodeInterface;

/**
 * Performs checks for the RDF entities and its storage.
 *
 * Performs the following checks:
 * - Checks for leftover graphs from the ADMS validation.
 * - Checks for orphaned triples.
 */
function joinup_rdf_requirements(string $phase): array {
  if ($phase !== 'runtime') {
    return [];
  }

  $requirements = [];

  // Ensure that leftover graphs from the ADMS validation graph do not exist.
  $requirements['joinup_rdf_content_integrity'] = [
    'title' => t('RDF content integrity'),
    'description' => t('A series of requirements that ensure the consistency in the SPARQL database.'),
    'severity' => REQUIREMENT_OK,
    'value' => t('No issues found.'),
  ];

  if ($errors = \Drupal::getContainer()->get('joinup_rdf.requirements_helper')->getRequirementErrors()) {
    $requirements['joinup_rdf_content_integrity']['severity'] = REQUIREMENT_ERROR;
    $requirements['joinup_rdf_content_integrity']['value'] = $errors;
  }

  return $requirements;
}

/**
 * Re run user_update_10000.
 */
function joinup_rdf_update_111101(): void {
  require_once DRUPAL_ROOT . '/core/modules/user/user.install';
  user_update_10000();
}

/**
 * Delete the asset_release RDF bundle. Enable joinup_release, joinup_solution.
 */
function joinup_rdf_update_111102(): void {
  // Delete the asset_release RDF bundle.
  \Drupal::entityTypeManager()->getStorage('rdf_type')->load('asset_release')->delete();

  // Install the joinup_release module because the joinup_distribution services
  // have some dependency on the services provided by the joinup_release module.
  \Drupal::service('module_installer')->install(['joinup_release', 'joinup_solution']);
}

/**
 * Update the OG roles for solutions - IDs and names.
 *
 * @todo Also update the solution IDs of the OG membership after the migration.
 */
function joinup_rdf_update_111103(array &$sandbox): string {
  if (empty($sandbox['solution_ids'])) {
    /** @var \Drupal\sparql_entity_storage\Entity\Query\Sparql\Query $query */
    $query = \Drupal::entityTypeManager()->getStorage('rdf_entity')->getQuery();
    $sandbox['solution_ids'] = $query
      ->accessCheck(FALSE)
      ->graphs(['default', 'draft'])
      ->condition('rid', 'solution')
      ->execute();

    $sandbox['solution_ids'] = array_values($sandbox['solution_ids']);
    $sandbox['current'] = 0;
    $sandbox['total'] = count($sandbox['solution_ids']);
  }

  $connection = \Drupal::database();
  $ids = array_splice($sandbox['solution_ids'], 0, 100);
  foreach ($ids as $id) {
    // Replace the keyword `rdf_entity` with `node` in the column
    // `roles_target_id` of the `og_membership__roles` where the `entity_id`
    // is the same as the `id` column of the `og_membership` table and the`
    // `entity_id` is the `solution_node_id`.
    $query = <<<SQL
UPDATE og_membership__roles
SET roles_target_id = REPLACE(roles_target_id, 'rdf_entity', 'node')
WHERE entity_id IN (
  SELECT id
  FROM og_membership
  WHERE entity_id = :id
)
SQL;
    $connection->query($query, [':id' => $id]);
  }

  $sandbox['current'] += count($ids);
  $sandbox['#finished'] = $sandbox['current'] / $sandbox['total'];
  return sprintf('Updated %d of %d solution OG roles.', $sandbox['current'], $sandbox['total']);
}

/**
 * Set the meta entities pointing to solutions to point to nodes.
 *
 * @todo Also update the solution IDs after the migration.
 */
function joinup_rdf_update_111104(): string {
  $connection = \Drupal::database();
  $ids = \Drupal::entityQuery('rdf_entity')
    ->accessCheck(FALSE)
    ->graphs(['default', 'draft'])
    ->condition('rid', 'solution')
    ->execute();
  $ids = array_values($ids);
  $query = <<<SQL
UPDATE meta_entity
SET target__target_type = 'node'
WHERE target__target_id IN (:ids[])
SQL;
  $connection->query($query, [':ids[]' => $ids]);
  return 'Updated the meta entities pointing to solutions from rdf_entity to node.';
}
