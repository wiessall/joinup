<?php

/**
 * @file
 * Hook implementations for the Topic module.
 */

declare(strict_types=1);

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\meta_entity\Entity\MetaEntityInterface;
use Drupal\taxonomy\TermInterface;
use Drupal\topic\Entity\TopicTerm;
use Drupal\topic\Entity\TopicTermInterface;
use Drupal\topic\Entity\TopicMetaEntity;
use Drupal\topic\Entity\TopicMetaEntityInterface;

/**
 * Implements hook_entity_bundle_info_alter().
 */
function topic_entity_bundle_info_alter(&$bundles): void {
  if (!empty($bundles['taxonomy_term']['topic'])) {
    $bundles['taxonomy_term']['topic']['class'] = TopicTerm::class;
  }
  if (!empty($bundles['meta_entity']['topic'])) {
    $bundles['meta_entity']['topic']['class'] = TopicMetaEntity::class;
  }
}

/**
 * Implements hook_ENTITY_TYPE_update().
 */
function topic_taxonomy_term_update(TermInterface $term): void {
  if (!$term instanceof TopicTermInterface) {
    return;
  }

  $original = $term->getOriginal();
  if ($original && $term->label() != $original->label()) {
    /** @var \Drupal\topic\Entity\TopicMetaEntity $meta_entity */
    if ($meta_entity = $term->topic->entity) {
      // Trigger the update of the label.
      // @see \topic_meta_entity_presave.
      $langcode = $term->language()->getId();
      $translated = $meta_entity->hasTranslation($langcode) ? $meta_entity->getTranslation($langcode) : $meta_entity->addTranslation($langcode);
      $translated->save();
    }
  }
}



/**
 * Redirects to the same page after saving the form.
 *
 * @param array $form
 *   The form render array.
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 *   The form state.
 */
function topic_form_entity_subqueue_homepage_topics_edit_form_alter_submit(array &$form, FormStateInterface $form_state): void {
  // The default redirect of the form is to the admin page of the entity
  // subqueue. Moderators do not have access to the page so the redirect leads
  // to a 403. We redirect to the same page in order to also allow further
  // actions.
  $route_match = \Drupal::getContainer()->get('current_route_match');
  $form_state->setRedirect($route_match->getRouteName(), $route_match->getRawParameters()->all());
}

/**
 * Implements hook_theme().
 */
function topic_theme(): array {
  return [
    // Normally theme suggestion templates are only picked up when they are in
    // themes. We explicitly define a theme suggestion here so that our custom
    // template will be included.
    'meta_entity__homepage_topics__configurable_listing__list' => [
      'render element' => 'elements',
      'base hook' => 'node',
    ],
    'meta_entity__homepage_topics__configurable_listing__grid' => [
      'render element' => 'elements',
      'base hook' => 'node',
    ],
  ];
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function topic_form_meta_entity_topic_edit_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $meta_entity = $form_state->getFormObject()->getEntity();
  if ($meta_entity->bundle() !== 'topic') {
    return;
  }

  $form['actions']['submit']['#submit'][] = 'topic_form_meta_entity_topic_edit_form_alter_submit';
}

/**
 * Redirects to the canonical page after saving the form.
 *
 * @param array $form
 *   The form render array.
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 *   The form state.
 */
function topic_form_meta_entity_topic_edit_form_alter_submit(array &$form, FormStateInterface $form_state): void {
  // Redirect only if there is no destination query parameter.
  if (empty(\Drupal::request()->query->get('destination'))) {
    $form_state->setRedirectUrl($form_state->getFormObject()->getEntity()->toUrl());
  }
}
