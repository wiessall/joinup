<?php

/**
 * @file
 * Hook implementations for the Topic module.
 */

declare(strict_types = 1);

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;
use Drupal\meta_entity\Entity\MetaEntityInterface;
use Drupal\taxonomy\TermInterface;
use Drupal\topic\Entity\Topic;
use Drupal\topic\Entity\TopicInterface;
use Drupal\topic\Entity\TopicMetaEntity;
use Drupal\topic\Entity\TopicMetaEntityInterface;

/**
 * Implements hook_entity_bundle_info_alter().
 */
function topic_entity_bundle_info_alter(&$bundles) {
  if (!empty($bundles['taxonomy_term']['topic'])) {
    $bundles['taxonomy_term']['topic']['class'] = Topic::class;
  }
  if (!empty($bundles['meta_entity']['topic'])) {
    $bundles['meta_entity']['topic']['class'] = TopicMetaEntity::class;
  }
}

/**
 * Implements hook_ENTITY_TYPE_update().
 */
function topic_taxonomy_term_update(TermInterface $term): void {
  if ($term instanceof TopicInterface) {
    /** @var \Drupal\topic\Entity\TopicInterface $original */
    if (($original = $term->original) && $term->label() != $original->label()) {
      /** @var \Drupal\topic\Entity\TopicMetaEntity $meta_entity */
      if ($meta_entity = $term->topic->entity) {
        $meta_entity->set('label', $term->label())->save();
      }
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_presave().
 */
function topic_meta_entity_presave(MetaEntityInterface $meta_entity): void {
  if ($meta_entity instanceof TopicMetaEntityInterface && $term = $meta_entity->getTargetEntity()) {
    $meta_entity->set('label', $term->label());
  }
}

/**
 * Implements hook_form_BASE_FORM_ID_alter().
 */
function topic_form_entity_subqueue_homepage_topics_edit_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  foreach (Element::children($form['actions']) as $action) {
    $form['actions'][$action]['#submit'][] = 'topic_form_entity_subqueue_homepage_topics_edit_form_alter_submit';
  }
}

/**
 * Redirect to the same page after saving the form.
 */
function topic_form_entity_subqueue_homepage_topics_edit_form_alter_submit(array &$form, FormStateInterface $form_state) {
  // The default redirect of the form is to the admin page of the entity
  // subqueue. Moderators do not have access to the page so the redirect leads
  // to a 403. We redirect to the same page in order to also allow further
  // actions.
  $route_match = \Drupal::getContainer()->get('current_route_match');
  $form_state->setRedirect($route_match->getRouteName(), $route_match->getRawParameters()->all());
}
