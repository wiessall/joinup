<?php

/**
 * @file
 * Hook implementations for the Topic module.
 */

declare(strict_types=1);

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;
use Drupal\Core\Session\AccountInterface;
use Drupal\Core\Url;
use Drupal\meta_entity\Entity\MetaEntityInterface;
use Drupal\taxonomy\TermInterface;
use Drupal\topic\Entity\Topic;
use Drupal\topic\Entity\TopicInterface;
use Drupal\topic\Entity\TopicMetaEntity;
use Drupal\topic\Entity\TopicMetaEntityInterface;

/**
 * Implements hook_entity_bundle_info_alter().
 */
function topic_entity_bundle_info_alter(&$bundles): void {
  if (!empty($bundles['taxonomy_term']['topic'])) {
    $bundles['taxonomy_term']['topic']['class'] = Topic::class;
  }
  if (!empty($bundles['meta_entity']['topic'])) {
    $bundles['meta_entity']['topic']['class'] = TopicMetaEntity::class;
  }
}

/**
 * Implements hook_ENTITY_TYPE_update().
 */
function topic_taxonomy_term_update(TermInterface $term): void {
  if (!$term instanceof TopicInterface) {
    return;
  }

  $original = $term->getOriginal();
  if ($original && $term->label() != $original->label()) {
    /** @var \Drupal\topic\Entity\TopicMetaEntity $meta_entity */
    if ($meta_entity = $term->topic->entity) {
      $meta_entity->set('label', $term->label())->save();
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_update().
 */
function topic_meta_entity_update(EntityInterface $entity): void {
  if (!$entity instanceof TopicMetaEntityInterface) {
    return;
  }

  // If the term is unpublished, remove it from the curated entityqueue list.
  $original = $entity->getOriginal();
  if ($original && $entity->published->value !== $original->published->value && !$entity->published->value) {
    $queue = \Drupal::entityTypeManager()->getStorage('entity_subqueue')->load('homepage_topics');
    if ($queue->hasItem($entity)) {
      $queue->removeItem($entity)->save();
      \Drupal::messenger()->addMessage(t('The topic has been removed from the homepage topics curated list since it was unpublished.'));
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_presave().
 */
function topic_meta_entity_presave(MetaEntityInterface $meta_entity): void {
  if ($meta_entity instanceof TopicMetaEntityInterface && $term = $meta_entity->getTargetEntity()) {
    $meta_entity->set('label', $term->label());
  }
}

/**
 * Implements hook_form_BASE_FORM_ID_alter().
 */
function topic_form_entity_subqueue_homepage_topics_edit_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $form['#validate'][] = 'topic_form_entity_subqueue_homepage_topics_validate';
  foreach (Element::children($form['actions']) as $action) {
    $form['actions'][$action]['#submit'][] = 'topic_form_entity_subqueue_homepage_topics_edit_form_alter_submit';
  }

  $help = [
    '#theme' => 'item_list',
    '#items' => [
      t('In this page you can add/remove/rearrange the topics that are displayed on the homepage.'),
      t('Add topics by name from the autocomplete field below.'),
      t('Only published topics can be added in the list.'),
      t('In order to publish the topic, go to <a href=":dashboard">Dashboard</a> > <a href=":topics">Topics</a> and click on the "Edit" button of the topic you want to publish.', [
        ':dashboard' => Url::fromRoute('dashboard.page')->toString(),
        ':topics' => Url::fromRoute('view.topic_meta_entity.page')->toString(),
      ]),
      t('Once you are done, come back here to add it to the list.'),
      t('A maximum of 8 topics are allowed in the list.'),
    ],
  ];
  $form['help'] = [
    '#type' => 'html_tag',
    '#tag' => 'p',
    '#value' => \Drupal::service('renderer')->renderInIsolation($help),
  ];
}

/**
 * Provides an additional form validator for the homepage_topics queue form.
 *
 * @param array $form
 *   The form render array.
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 *   The form state.
 */
function topic_form_entity_subqueue_homepage_topics_validate(array &$form, FormStateInterface $form_state): void {
  $items = $form_state->getValue('items');
  if (!isset($items['add_more']['new_item']['target_id'])) {
    return;
  }
  $existing_items = [];
  foreach ($items as $key => $item) {
    if (is_numeric($key) && isset($item['target_id'])) {
      $existing_items[] = $item['target_id'];
    }
  }
  if (in_array($items['add_more']['new_item']['target_id'], $existing_items)) {
    $form_state->setErrorByName('items', t('The %topic topic is already in the list.', [
      '%topic' => \Drupal::entityTypeManager()->getStorage('meta_entity')
        ->load($items['add_more']['new_item']['target_id'])
        ->label(),
    ]));
  }
}

/**
 * Redirects to the same page after saving the form.
 *
 * @param array $form
 *   The form render array.
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 *   The form state.
 */
function topic_form_entity_subqueue_homepage_topics_edit_form_alter_submit(array &$form, FormStateInterface $form_state): void {
  // The default redirect of the form is to the admin page of the entity
  // subqueue. Moderators do not have access to the page so the redirect leads
  // to a 403. We redirect to the same page in order to also allow further
  // actions.
  $route_match = \Drupal::getContainer()->get('current_route_match');
  $form_state->setRedirect($route_match->getRouteName(), $route_match->getRawParameters()->all());
}

/**
 * Implements hook_theme().
 */
function topic_theme(): array {
  return [
    // Normally theme suggestion templates are only picked up when they are in
    // themes. We explicitly define a theme suggestion here so that our custom
    // template will be included.
    'meta_entity__homepage_topics__configurable_listing__list' => [
      'render element' => 'elements',
      'base hook' => 'node',
    ],
    'meta_entity__homepage_topics__configurable_listing__grid' => [
      'render element' => 'elements',
      'base hook' => 'node',
    ],
  ];
}

/**
 * Implements hook_ENTITY_TYPE_create_access().
 *
 * Allows access to the creation of the configurable listing paragraph only for
 * the topic meta entity.
 */
function topic_paragraph_create_access(AccountInterface $account, array $context, string $entity_bundle): AccessResultInterface {
  if (\Drupal::routeMatch()->getRouteName() !== 'entity.meta_entity.edit_form') {
    return AccessResult::neutral()->addCacheContexts(['route']);
  }

  $meta_entity = \Drupal::routeMatch()->getParameter('meta_entity')->bundle();
  if ($meta_entity === 'topic') {
    if ($entity_bundle === 'configurable_listing') {
      return AccessResult::allowed()
        ->addCacheableDependency($meta_entity)
        ->addCacheContexts(['route']);
    }

    $denied_paragraphs = [
      'accordion',
      'call_to_action',
      'carousel',
      'content_listing',
      'iframe',
      'image',
      'json_map',
      'testimony',
    ];

    if (in_array($entity_bundle, $denied_paragraphs, TRUE)) {
      return AccessResult::forbidden()
        ->addCacheableDependency($meta_entity)
        ->addCacheContexts(['route']);
    }
  }

  return AccessResult::neutral()->addCacheContexts(['route']);
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function topic_form_meta_entity_topic_edit_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $meta_entity = $form_state->getFormObject()->getEntity();
  if ($meta_entity->bundle() !== 'topic') {
    return;
  }

  $form['actions']['submit']['#submit'][] = 'topic_form_meta_entity_topic_edit_form_alter_submit';
}

/**
 * Redirects to the canonical page after saving the form.
 *
 * @param array $form
 *   The form render array.
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 *   The form state.
 */
function topic_form_meta_entity_topic_edit_form_alter_submit(array &$form, FormStateInterface $form_state): void {
  // Redirect only if there is no destination query parameter.
  if (empty(\Drupal::request()->query->get('destination'))) {
    $form_state->setRedirectUrl($form_state->getFormObject()->getEntity()->toUrl());
  }
}
