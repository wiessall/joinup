<?php

/**
 * @file
 * Hook implementations for RDF Sync Test module.
 */

declare(strict_types=1);

use Drupal\rdf_sync_test\Category;
use Drupal\rdf_sync_test\Page;

/**
 * Implements hook_entity_bundle_info_alter().
 */
function rdf_sync_test_entity_bundle_info_alter(array &$bundles): void {
  if (isset($bundles['taxonomy_term']['category'])) {
    $bundles['taxonomy_term']['category']['class'] = Category::class;
  }
  if (isset($bundles['node']['page'])) {
    $bundles['node']['page']['class'] = Page::class;
  }
}
