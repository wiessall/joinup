<?php

/**
 * @file
 * Install, update and schema hooks for sti_dedupe.
 */

declare(strict_types=1);

use Drupal\node\NodeInterface;
use Drupal\sti_dedupe\ContentModel;

/**
 * Implements hook_schema().
 */
function sti_dedupe_schema(): array {
  $schema['sti_dedupe_candidate'] = [
    'description' => 'Precomputed duplicate candidates, one row per ordered pair.',
    'fields' => [
      'id' => ['type' => 'serial', 'not null' => TRUE],
      'source_nid' => [
        'description' => 'The newly imported solution.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'candidate_nid' => [
        'description' => 'An existing solution that may describe the same innovation.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'collection_nid' => [
        'description' => 'Collection of the source solution, for cheap listing.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'score' => [
        'description' => 'Match score, 0..1, stored x1000 as an integer.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'reasons' => [
        'description' => 'Human-readable scoring breakdown.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ],
      'computed' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['id'],
    'unique keys' => ['pair' => ['source_nid', 'candidate_nid']],
    'indexes' => [
      'collection_score' => ['collection_nid', 'score'],
      'source' => ['source_nid'],
    ],
  ];

  $schema['sti_dedupe_decision'] = _sti_dedupe_decision_schema();

  $schema['sti_dedupe_replacement'] = _sti_dedupe_replacement_schema();

  return $schema;
}

/**
 * Returns the schema of the innovation replacement table.
 */
function _sti_dedupe_replacement_schema(): array {
  return [
    'description' => 'ATIO innovations unpublished in favour of another by a "same" decision.',
    'fields' => [
      'replaced_nid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'survivor_nid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'created' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['replaced_nid'],
    'indexes' => ['survivor' => ['survivor_nid']],
  ];
}

/**
 * Returns the schema of the decision table.
 */
function _sti_dedupe_decision_schema(): array {
  return [
    'description' => "Each collection's decisions about pairs of solutions, low nid first.",
    'fields' => [
      'id' => ['type' => 'serial', 'not null' => TRUE],
      'collection_nid' => [
        'description' => 'The collection that decided; 0 for a decision no collection could be found for.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'nid_low' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'nid_high' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE],
      'decision' => [
        'description' => "One of: same, different; 'merged' rows are history from the first version.",
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
      ],
      'uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'created' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['id'],
    'unique keys' => ['pair' => ['collection_nid', 'nid_low', 'nid_high']],
    'indexes' => [
      'low_decision' => ['nid_low', 'decision'],
      'high_decision' => ['nid_high', 'decision'],
    ],
  ];
}

/**
 * Implements hook_update_last_removed().
 */
function sti_dedupe_update_last_removed(): int {
  return 11002;
}

/**
 * Decisions belong to a collection.
 *
 * Earlier decisions wrote a sameInnovationAs claim on both records, each
 * attributed to its own collection, so each is copied to both records'
 * collections: that is what the claims already say. Rows whose records have
 * no collection keep collection_nid 0 and are reported.
 */
function sti_dedupe_update_11003(): string {
  $schema = \Drupal::database()->schema();
  $table = 'sti_dedupe_decision';
  $spec = _sti_dedupe_decision_schema();
  if (!$schema->fieldExists($table, 'collection_nid')) {
    $schema->addField($table, 'collection_nid', $spec['fields']['collection_nid']);
  }
  $schema->dropUniqueKey($table, 'pair');
  $schema->addUniqueKey($table, 'pair', $spec['unique keys']['pair']);

  $database = \Drupal::database();
  $rows = $database->select($table, 'd')->fields('d')->condition('collection_nid', 0)->execute()->fetchAll();
  $nids = [];
  foreach ($rows as $row) {
    $nids[] = (int) $row->nid_low;
    $nids[] = (int) $row->nid_high;
  }
  $audience = [];
  foreach (\Drupal::entityTypeManager()->getStorage('node')->loadMultiple(array_unique($nids)) as $nid => $node) {
    if ($node instanceof NodeInterface && $node->hasField(ContentModel::AUDIENCE) && !$node->get(ContentModel::AUDIENCE)->isEmpty()) {
      $audience[(int) $nid] = (int) $node->get(ContentModel::AUDIENCE)->target_id;
    }
  }

  $assigned = 0;
  $orphans = [];
  foreach ($rows as $row) {
    $collections = array_values(array_unique(array_filter([
      $audience[(int) $row->nid_low] ?? 0,
      $audience[(int) $row->nid_high] ?? 0,
    ])));
    if (!$collections) {
      $orphans[] = $row->nid_low . '/' . $row->nid_high;
      continue;
    }
    $database->update($table)->fields(['collection_nid' => $collections[0]])->condition('id', $row->id)->execute();
    $assigned++;
    if (isset($collections[1])) {
      $database->insert($table)->fields([
        'collection_nid' => $collections[1],
        'nid_low' => $row->nid_low,
        'nid_high' => $row->nid_high,
        'decision' => $row->decision,
        'uid' => $row->uid,
        'created' => $row->created,
      ])->execute();
      $assigned++;
    }
  }

  $left = (int) $database->select($table, 'd')->condition('collection_nid', 0)->countQuery()->execute()->fetchField();
  if ($left !== count($orphans)) {
    throw new \RuntimeException(sprintf('%d decision(s) still have no collection; expected %d.', $left, count($orphans)));
  }

  $message = sprintf('Assigned %d decision(s) to collections.', $assigned);
  if ($orphans) {
    $message .= sprintf(' %d pair(s) have no collection and keep collection_nid 0: %s.', count($orphans), implode(', ', $orphans));
  }
  return $message;
}
