{#
/**
 * @file
 * FAO Design System rendering of the grouped claim facet dropdowns.
 *
 * Place at:
 *   web/themes/custom/fao/templates/facets/claim-facets-grouped.html.twig
 *
 * Reproduces the STI Portal filter column's class contract:
 * - `.view-filters` wrapper, as views-exposed-form--atio-kb-sti-faceted-search
 * - `.form-label` above each control
 * - `.form-select` on the control, from
 *   fao/templates/form/form-element--select.html.twig
 * - `.badge.text-bg-secondary.bg-secondary` for applied-filter counts
 *
 * Chosen replaces each <select> with a `.chosen-container-multi` carrying the
 * placeholder and chevron. The theme already loads the CSS
 * (css/faceted-search-dropdown.css) and the tree enhancement
 * (js/faceted-search-dropdown.js) from the `fao/theme` library, so nothing
 * extra is attached here.
 *
 * Thirty dropdowns in a flat column is unusable, so sections render as a
 * Bootstrap 5 accordion. Bootstrap 5.0.2 is vendored in the theme and fao's
 * SCSS already styles `.accordion-item .accordion-header strong`, so no new
 * CSS is required for the accordion itself.
 *
 * Two deliberate constraints:
 * - No `data-bs-parent`, so several sections can be open at once. Exclusive
 *   accordions are wrong for filtering.
 * - No `<span class="label">` inside the buttons. fao/expandable binds to
 *   every `.accordion` on node pages and rewrites `button .label` text to
 *   "expand to read more", which would clobber the section labels.
 *
 * Available variables:
 * - sections: Ordered filter groups (id, label, active_count, open, filters).
 *   Each filter has slug, label, id, active, active_values, option_count,
 *   multiple and select.
 * - facet_id: The facet's machine name.
 * - active_count: Total applied values across all sections.
 *
 * @see \Drupal\import_ird_jsons\Plugin\facets\widget\GroupedClaimDropdownWidget
 */
#}
{% set accordion_id = 'claim-facets-' ~ facet_id|clean_id %}

<div class="view-filters claim-facets-grouped mt-4" data-facet="{{ facet_id }}">

  <div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="sub-title h3 mb-0">{{ 'Filter by'|t }}</h2>
    {% if active_count %}
      <span class="badge text-bg-secondary bg-secondary">
        {{ '@count applied'|t({'@count': active_count}) }}
      </span>
    {% endif %}
  </div>

  {% if sections|length > 1 %}

    <div class="accordion" id="{{ accordion_id }}">
      {% for section in sections %}
        <div class="accordion-item">
          <h3 class="accordion-header" id="{{ section.id }}-heading">
            <button
              class="accordion-button{{ section.open ? '' : ' collapsed' }}"
              type="button"
              data-bs-toggle="collapse"
              data-bs-target="#{{ section.id }}"
              aria-expanded="{{ section.open ? 'true' : 'false' }}"
              aria-controls="{{ section.id }}">
              <strong>{{ section.label }}</strong>
              {% if section.active_count %}
                <span class="badge text-bg-secondary bg-secondary ms-2">{{ section.active_count }}</span>
              {% endif %}
            </button>
          </h3>
          <div
            id="{{ section.id }}"
            class="accordion-collapse collapse{{ section.open ? ' show' }}"
            aria-labelledby="{{ section.id }}-heading">
            <div class="accordion-body">
              {% for filter in section.filters %}
                {{ _self.dropdown(filter) }}
              {% endfor %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

  {% else %}

    {# Single unsectioned list: no accordion chrome, matching STI's flat column. #}
    {% for section in sections %}
      {% for filter in section.filters %}
        {{ _self.dropdown(filter) }}
      {% endfor %}
    {% endfor %}

  {% endif %}

</div>

{% macro dropdown(filter) %}
  <div class="claim-facet-dropdown-wrapper mb-3{{ filter.active ? ' claim-facet--active' }}">
    <label class="form-label" for="{{ filter.id }}">
      {{ filter.label }}
      {% if filter.active_values|length > 1 %}
        <span class="badge text-bg-secondary bg-secondary ms-1">{{ filter.active_values|length }}</span>
      {% elseif filter.active %}
        <i class="bi bi-funnel-fill ms-1 text-primary" aria-hidden="true"></i>
      {% endif %}
    </label>
    {{ filter.select }}
  </div>
{% endmacro %}
