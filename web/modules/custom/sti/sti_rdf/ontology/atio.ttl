# Curated axioms for the atio: namespace (ATIO, tier 2).
# Merged into the generated namespace document by OntologyDocumentBuilder.
# Declare here only what rdf_sync config cannot express.

@prefix atio:    <https://sti-portal.fao.org/atio#> .
@prefix sti:     <https://sti-portal.fao.org/sti#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix schema:  <https://schema.org/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

<https://sti-portal.fao.org/atio>
    rdfs:label "ATIO Knowledge Base vocabulary"@en .

atio:Innovation
    a owl:Class ;
    rdfs:subClassOf schema:Thing ;
    rdfs:comment """A real-world agrifood innovation as curated by ATIO,
    synthesised from one or more source records."""@en .

atio:derivedFromSource
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    schema:rangeIncludes sti:SourceRecord .

# Defined, not asserted: an innovation is grassroots when its flag says so.
# Sources can disagree about the flag, so it must not be baked into identity.
atio:GrassrootsInnovation
    a owl:Class ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty atio:isGrassroots ;
        owl:hasValue true
    ] .
