<?php

/**
 * @file
 * Main functions and hook implementations of the Owner module.
 */

declare(strict_types=1);

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\Core\StringTranslation\TranslatableMarkup;
use Drupal\joinup_taxonomy\Entity\MappedTerm;
use Drupal\node\NodeInterface;
use Drupal\owner\Entity\Owner;
use Drupal\owner\Entity\OwnerInterface;
use Drupal\rdf_entity\RdfInterface;

/**
 * Implements hook_entity_bundle_info_alter().
 */
function owner_entity_bundle_info_alter(array &$bundles): void {
  if (!empty($bundles['node']['owner'])) {
    $bundles['node']['owner']['class'] = Owner::class;
  }
  if (!empty($bundles['taxonomy_term']['owner_type'])) {
    $bundles['taxonomy_term']['owner_type']['class'] = MappedTerm::class;
  }
}

/**
 * Implements hook_ENTITY_TYPE_create().
 *
 * Sets the initial workflow state of an owner to 'published'.
 */
function owner_node_create(NodeInterface $entity): void {
  if (!$entity instanceof OwnerInterface) {
    return;
  }

  // The initial state of an owner is published. The owner is created as part of
  // proposing a collection, and in the collection propose form the workflow
  // state is hidden from the user, so it would remain in the "__new__" state
  // after submission.
  // We can safely set the initial state to "published" because a newly created
  // owner doesn't need to be published by a third party.
  if ($entity->field_state->value === '__new__') {
    $entity->set('field_state', 'published');
  }
}

/**
 * Implements hook_form_BASEFORM_ID_alter().
 */
function owner_form_node_form_alter(array &$form, FormStateInterface $form_state): void {
  /** @var \Drupal\node\NodeInterface $entity */
  $entity = $form_state->getFormObject()->getEntity();
  if ($entity->bundle() !== 'owner') {
    return;
  }

  $form['#validate'][] = 'owner_form_alter_validate';
}

/**
 * Form validation callback.
 *
 * Checks that an owner entity cannot transition to the 'Request deletion' state
 * if it is still associated with a collection.
 *
 * @see owner_form_node_form_alter()
 */
function owner_form_alter_validate(array &$form, FormStateInterface $form_state): void {
  /** @var \Drupal\node\NodeInterface $entity */
  $entity = $form_state->getFormObject()->getEntity();

  $element = $form_state->getTriggeringElement();
  if (
    // Check if the form was submitted using one of the workflow buttons.
    !empty($element['#state_id']) &&
    // Check if we are transitioning to "Request deletion".
    $element['#state_id'] === 'deletion_request' &&
    // Check if the owner is still referenced by one or more collections.
    $entity->isReferencedByGroups()
  ) {
    // Compile a list of collections that are referencing the owner, to show in
    // the form validation error message.
    $collection_labels = array_map(function (RdfInterface $collection) {
      return '"' . $collection->label() . '"';
    }, $entity->getReferencingGroups());

    $form_state->setError($element, new TranslatableMarkup('The owner cannot be deleted since it owns the following collections: @collections. Please set a different owner for these collections before requesting deletion.', [
      '@collections' => implode(', ', $collection_labels),
    ]));
  }
}

/**
 * Implements hook_ENTITY_TYPE_access().
 */
function owner_node_access(NodeInterface $entity, string $operation, AccountInterface $account): AccessResultInterface {
  if (!$entity instanceof OwnerInterface) {
    return AccessResult::neutral();
  }

  if ($operation === 'edit'
    && $entity->getWorkflowState() === 'deletion_request'
    && $entity->getOwnerId() === $account->id()
    // We need to differentiate between the owner and the moderator. The 'edit
    // any owner content' permission is used to determine if the user is a
    // moderator.
    && !$account->hasPermission('edit any owner content')
  ) {
    return AccessResult::forbidden('The owner is in the "deletion_request" state.');
  }

  // By specifications, deletion should be forbidden if the owner entity is
  // referenced by any other entity.
  if ($operation === 'delete') {
    return AccessResult::forbiddenIf($entity->isReferencedByGroups());
  }

  if ($operation !== 'view') {
    return AccessResult::neutral();
  }

  // For anonymous users, deny access to the canonical route.
  $route_match = \Drupal::routeMatch();
  if ($account->isAnonymous() && $route_match->getRouteName() === 'entity.node.canonical') {
    $route_entity = $route_match->getParameter('node');
    if ($route_entity instanceof OwnerInterface && $route_entity->id() === $entity->id()) {
      return AccessResult::forbidden('Anonymous users should not see the owner canonical route.');
    }
  }

  return AccessResult::neutral();
}

/**
 * Implements hook_inline_entity_form_table_fields_alter().
 */
function owner_inline_entity_form_table_fields_alter(array &$fields, array $context): void {
  if ($context['entity_type'] == 'node' && $context['allowed_bundles'] === ['owner']) {
    // Add the type column.
    $fields['owner_type'] = [
      'type' => 'field',
      'label' => t('Type'),
      'weight' => 10,
    ];
  }
}
