<?php

/**
 * @file
 * User Achievement module hooks and functions.
 */

declare(strict_types=1);

use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\Core\Field\FieldStorageDefinitionInterface;
use Drupal\Core\Render\Element;
use Drupal\Core\StringTranslation\TranslatableMarkup;
use Drupal\user_achievement\Plugin\Field\FieldType\UserAchievementsFieldItemList;

/**
 * Implements hook_entity_base_field_info().
 */
function user_achievement_entity_base_field_info(EntityTypeInterface $entity_type): array {
  if ($entity_type->id() !== 'user') {
    return [];
  }

  $fields['achievements'] = BaseFieldDefinition::create('entity_reference')
    ->setLabel(new TranslatableMarkup('Achievements'))
    ->setDescription(new TranslatableMarkup('Badges awarded to this user for their engagement on the Portal.'))
    ->setSetting('target_type', 'user_achievement')
    ->setCardinality(FieldStorageDefinitionInterface::CARDINALITY_UNLIMITED)
    ->setComputed(TRUE)
    ->setClass(UserAchievementsFieldItemList::class)
    ->setDisplayConfigurable('view', TRUE)
    ->setDisplayConfigurable('form', FALSE)
    ->setDisplayOptions('view', [
      'type' => 'user_achievements',
      'label' => 'hidden',
      'weight' => 0,
    ])
    ->setDisplayOptions('form', ['region' => 'hidden']);

  return $fields;
}

/**
 * Implements hook_theme().
 */
function user_achievement_theme(): array {
  return [
    'user_achievement' => ['render element' => 'elements'],
  ];
}

/**
 * Prepares variables for user_achievement templates.
 *
 * Default template: user-achievement.html.twig.
 *
 * @param array $variables
 *   An associative array containing:
 *   - elements: An associative array containing the achievement information
 *     and any fields attached to the entity.
 *   - attributes: HTML attributes for the containing element.
 */
function template_preprocess_user_achievement(array &$variables): void {
  $variables['view_mode'] = $variables['elements']['#view_mode'];
  foreach (Element::children($variables['elements']) as $key) {
    $variables['content'][$key] = $variables['elements'][$key];
  }

  /** @var \Drupal\user_achievement\Entity\AchievementInterface $achievement */
  $achievement = $variables['elements']['#user_achievement'];
  /** @var \Drupal\user_achievement\Entity\AchievementTypeInterface $type */
  $type = \Drupal::entityTypeManager()
    ->getStorage('achievement_type')
    ->load($achievement->bundle());

  if ($type !== NULL) {
    $variables['icon_id'] = $type->getIcon();
    $variables['label'] = $type->label();
    $variables['description'] = $type->getDescription();
  }
}

/**
 * Implements hook_theme_suggestions_HOOK().
 */
function user_achievement_theme_suggestions_user_achievement(array $variables): array {
  $sanitized_view_mode = strtr($variables['elements']['#view_mode'], '.', '_');

  return [
    'user_achievement__' . $sanitized_view_mode,
  ];
}
