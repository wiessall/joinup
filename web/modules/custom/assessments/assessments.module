<?php

declare(strict_types=1);

/**
 * @file
 * Provides an agent entity type.
 */

use Drupal\Core\Render\Element;
use Drupal\user\UserInterface;

/**
 * Implements hook_theme().
 */
function assessments_theme(): array {
  return [
    'assessment_agent' => ['render element' => 'elements'],
    'assessment_participation' => ['render element' => 'elements'],
    'assessment_asset' => ['render element' => 'elements'],
    'assessment_organization' => ['render element' => 'elements'],
    'assessment_service' => ['render element' => 'elements'],
    'assessment_expression' => ['render element' => 'elements'],
    'assessment_statement' => ['render element' => 'elements'],
    'assessment_requirement' => ['render element' => 'elements'],
    'assessment' => ['render element' => 'elements'],
  ];
}

/**
 * Prepares variables for assessment templates.
 *
 * @param array $variables
 *   An associative array containing:
 *   - elements: An associative array containing the assessment information and any
 *     fields attached to the entity.
 *   - attributes: HTML attributes for the containing element.
 */
function _assessments_template_preprocess(array &$variables): void {
  $variables['view_mode'] = $variables['elements']['#view_mode'];
  foreach (Element::children($variables['elements']) as $key) {
    $variables['content'][$key] = $variables['elements'][$key];
  }
}

/**
 * Prepares variables for agent templates.
 *
 * Default template: assessments-agent.html.twig.
 *
 * @param array $variables
 *   An associative array containing:
 *   - elements: An associative array containing the agent information and any
 *     fields attached to the entity.
 *   - attributes: HTML attributes for the containing element.
 */
function template_preprocess_assessments_agent(array &$variables): void {
  _assessments_template_preprocess($variables);

}

