/**
 * Checks if an account can moderate an assessment.
 *
 * @param \Drupal\Core\Entity\EntityInterface $entity
 *   The entity to check.
 * @param \Drupal\Core\Session\AccountInterface $account
 *   The user account to check access for.
 *
 * @return \Drupal\Core\Access\AccessResultInterface
 *   The access result with proper caching.
 */
function _assessments_can_moderate(EntityInterface $entity, AccountInterface $account): AccessResultInterface {
  if (!$entity instanceof AssessmentReport) {
    return AccessResult::forbidden('This assessment bundle does not support moderation.')
      ->addCacheableDependency($entity);
  }

  return AccessResult::allowedIf($entity->getWorkflowState() === 'review')
    ->andIf(AccessResult::allowedIfHasPermission($account, 'moderate assessment report'))
    ->addCacheableDependency($entity);
}

/**
 * Implements hook_entity_operation().
 */
function assessments_entity_operation(EntityInterface $entity): array {
  $operations = [];

  if (!$entity instanceof AssessmentReport) {
    return $operations;
  }

  $current_user = \Drupal::service('current_user')->getAccount();
  $access = _assessments_can_moderate($entity, $current_user);

  // Only add the operation if access is explicitly allowed.
  if (!$access->isAllowed()) {
    return $operations;
  }

  $operations['moderate'] = [
    'title' => t('Moderate'),
    'url' => Url::fromRoute('assessments.moderate', [
      'assessment_type' => $entity->bundle(),
      'assessment' => $entity->id(),
    ]),
    'weight' => 50,
  ];

  return $operations;
}

/**
 * After build callback to change "Create" to "Add" for asset form button.
 */
function _assessments_process_asset_form_button(array $element, FormStateInterface $form_state): array {
  // At this point, buildEntityFormActions has already run and created the
  // button.
  if (isset($element['actions']['ief_add_save'])) {
    /** @var \Drupal\Core\StringTranslation\TranslatableMarkup $markup */
    $markup = $element['actions']['ief_add_save']['#value'];
    $arguments = $markup->getArguments();
    $element['actions']['ief_add_save']['#value'] = new TranslatableMarkup('Add @type_singular', $arguments);
  }
  return $element;
}

/**
 * Implements hook_inline_entity_form_entity_form_alter().
 */
function assessments_inline_entity_form_entity_form_alter(array &$entity_form, FormStateInterface &$formState): void {
  $solution = $entity_form['#entity'];

  if ($entity_form['#ief_id'] === 'asset-form' && $solution instanceof SolutionInterface) {
    if ($entity_form['#op'] === 'add') {
      $entity_form['#after_build'][] = '_assessments_process_asset_form_button';
    }

    $collection = \Drupal::service('entity.repository')->loadEntityByUuid('node', AssessmentInterface::SOLUTION_COLLECTOR);
    assert($collection instanceof CollectionInterface);

    $solution
      // All solutions created via assessments form are belonging to a
      // 'collector' collection.
      ->setGroup($collection)
      // And are published by default.
      ->set('field_state', 'published');

    // In this context the landing page is mandatory.
    $entity_form['landing_page']['widget']['uri']['#required'] = TRUE;
  }
  if ($solution->bundle() === 'participation') {
    $delta = $entity_form['#ief_row_delta'];
    $entity_form['stakeholder_country']['#states'] = [
      'visible' => [
        ':input[name="has_participation[' . $delta . '][inline_entity_form][eu_countries][value]"]' => ['checked' => FALSE],
      ],
    ];
  }
}

/**
 * Implements hook_inline_entity_form_table_fields_alter().
 */
function assessments_inline_entity_form_table_fields_alter(array &$fields, array $context): void {
  if (
    $context['parent_entity_type'] === 'paragraph' &&
    $context['parent_bundle'] === 'binding_requirement' &&
    $context['field_name'] === 'asset'
  ) {
    unset($fields['status']);

    $fields['landing_page'] = [
      'type' => 'field',
      'label' => t('Relevant website'),
      'weight' => 10,
    ];

    $fields['abstract'] = [
      'type' => 'field',
      'label' => t('Description'),
      'weight' => 11,
      'display_options' => [
        'type' => 'field_fallback_formatter',
        'settings' => [
          'main_field_formatter_id' => 'string',
          'main_field_formatter_settings' => ['link_to_entity' => FALSE],
          'fallback_field_id' => 'description',
          'fallback_field_formatter_id' => 'smart_trim',
          'fallback_field_formatter_settings' => [
            'trim_length' => 255,
            'trim_type' => 'chars',
            'trim_suffix' => '…',
            'wrap_output' => FALSE,
            'wrap_class' => 'trimmed',
            'more' => [
              'display_link' => FALSE,
              'target_blank' => FALSE,
              'link_trim_only' => FALSE,
              'class' => 'more-link',
              'text' => '',
              'aria_label' => '',
            ],
            'trim_options' => [
              'text' => TRUE,
              'trim_zero' => FALSE,
              'replace_tokens' => FALSE,
            ],
          ],
        ],
      ],
    ];
  }
}

/**
 * Implements hook_module_implements_alter().
 */
function assessments_module_implements_alter(array &$implementations, $hook): void {
  if ($hook === 'node_create_access') {
    // The state_machine_permissions_node_create_access() implementation,
    // forbids access to a solution which is not in the context of a group. But
    // in the context of assessments, we allow a user to create solutions via
    // the assessment report form, and immediately, we set the group to a
    // collection acting as a collector for such solutions. We add our own
    // implementation that allows this exception.
    // @see state_machine_permissions_node_create_access()
    // @see assessments_node_create_access()
    unset($implementations['state_machine_permissions']);
  }
}

/**
 * Implements hook_ENTITY_TYPE_create_access().
 */
function assessments_node_create_access(AccountInterface $account, array $context, string $entity_bundle): AccessResultInterface {
  // Detect if the access is checked as part of the inline entity form widget,
  // specifically, the one that allow adding new solutions.
  $isAssetInlineEntityFormWidget = isset($context['parent_entity_type']) &&
    $context['parent_entity_type'] === 'paragraph' &&
    isset($context['parent_bundle']) &&
    $context['parent_bundle'] === 'binding_requirement' &&
    isset($context['field_name']) &&
    $context['field_name'] === 'asset';

  if ($isAssetInlineEntityFormWidget) {
    return AccessResult::allowed();
  }

  return state_machine_permissions_node_create_access($account, $context, $entity_bundle);
}

/**
 * Implements hook_ENTITY_TYPE_presave() for assessment entities.
 */
function assessments_assessment_presave(AssessmentInterface $entity): void {
  // For expression entities, copy initiative_name to name field.
  if ($entity->bundle() === 'expression' && $entity->hasField('initiative_name')) {
    $initiative_name = $entity->get('initiative_name')->value;
    if (!empty($initiative_name)) {
      // Truncate to 255 characters if necessary.
      $name = mb_strlen($initiative_name) > 255 ? mb_substr($initiative_name, 0, 255) : $initiative_name;
      $entity->set('name', $name);
    }
  }
  elseif ($entity->bundle() === 'participation') {
    $eu_country = $entity->get('eu_countries')->value;
    $vocabHelper = \Drupal::service(AssessmentVocabularyHelper::class);
    if ($eu_country) {
      $term_id = $vocabHelper->getTermIdFromIdentifier('spatial', 'EU', 'code');
      $entity->set('stakeholder_country', ['target_id' => $term_id]);
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_insert() for assessment entities.
 */
function assessments_assessment_insert(AssessmentInterface $entity): void {
  _assessments_handle_report_state_notification($entity);
}

/**
 * Implements hook_ENTITY_TYPE_update() for assessment entities.
 */
function assessments_assessment_update(AssessmentInterface $entity): void {
  _assessments_handle_report_state_notification($entity);
}

/**
 * Handles notification dispatching for assessment report state changes.
 *
 * @param \Drupal\assessments\AssessmentInterface $entity
 *   The assessment entity.
 */
function _assessments_handle_report_state_notification(AssessmentInterface $entity): void {
  if (!$entity instanceof AssessmentReport) {
    return;
  }

  $original_state = $entity->original instanceof AssessmentReport ? $entity->original->getWorkflowState() : NULL;
  $current_state = $entity->getWorkflowState();

  if ($current_state === 'review' && $original_state !== 'review') {
    $event = new AssessmentReportEvent($entity);
    \Drupal::service('event_dispatcher')
      ->dispatch($event, NotificationEvents::ASSESSMENT_REPORT_SUBMITTED_FOR_REVIEW);
  }
}

/**
 * Implements hook_views_data_alter().
 */
function assessments_views_data_alter(array &$data): void {
  // Duplicate data to provide custom argument handler for assessment country.
  $code_value = $data['taxonomy_term__code']['code_value'];
  $code_value['title'] = $code_value['title short'] = new TranslatableMarkup('Assessment country code');
  $code_value['argument']['id'] = 'assessment_country_code';
  $data['taxonomy_term__code']['assessment_country_code'] = $code_value;
}
