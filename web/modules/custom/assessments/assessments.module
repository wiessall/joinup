/**
 * Implements hook_user_cancel().
 */
function assessments_user_cancel($edit, UserInterface $account, $method): void {
  switch ($method) {
    case 'user_cancel_reassign':
      // Anonymize agents.
      $storage = \Drupal::entityTypeManager()->getStorage('assessments_agent');
      $assessments_agent_ids = $storage->getQuery()
        ->condition('uid', $account->id())
        ->accessCheck(FALSE)
        ->execute();
      foreach ($storage->loadMultiple($assessments_agent_ids) as $assessments_agent) {
        $assessments_agent->setOwnerId(0)->save();
      }

      // Anonymize participations.
      $storage = \Drupal::entityTypeManager()->getStorage('assessments_participation');
      $assessments_participation_ids = $storage->getQuery()
        ->condition('uid', $account->id())
        ->accessCheck(FALSE)
        ->execute();
      foreach ($storage->loadMultiple($assessments_participation_ids) as $assessments_participation) {
        $assessments_participation->setOwnerId(0)->save();
      }

      // Anonymize assets.
      $storage = \Drupal::entityTypeManager()->getStorage('assessments_asset');
      $assessments_asset_ids = $storage->getQuery()
        ->condition('uid', $account->id())
        ->accessCheck(FALSE)
        ->execute();
      foreach ($storage->loadMultiple($assessments_asset_ids) as $assessments_asset) {
        $assessments_asset->setOwnerId(0)->save();
      }

      // Anonymize publicorganizations.
      $storage = \Drupal::entityTypeManager()->getStorage('assessment_organization');
      $assessment_organization_ids = $storage->getQuery()
        ->condition('uid', $account->id())
        ->accessCheck(FALSE)
        ->execute();
      foreach ($storage->loadMultiple($assessment_organization_ids) as $assessment_organization) {
        $assessment_organization->setOwnerId(0)->save();
      }

      // Anonymize public services.
      $storage = \Drupal::entityTypeManager()->getStorage('assessment_service');
      $assessment_service_ids = $storage->getQuery()
        ->condition('uid', $account->id())
        ->accessCheck(FALSE)
        ->execute();
      foreach ($storage->loadMultiple($assessment_service_ids) as $assessment_service) {
        $assessment_service->setOwnerId(0)->save();
      }

      // Anonymize legal expressions.
      $storage = \Drupal::entityTypeManager()->getStorage('assessment_expression');
      $assessment_expression_ids = $storage->getQuery()
        ->condition('uid', $account->id())
        ->accessCheck(FALSE)
        ->execute();
      foreach ($storage->loadMultiple($assessment_expression_ids) as $assessment_expression) {
        $assessment_expression->setOwnerId(0)->save();
      }

      // Anonymize statements.
      $storage = \Drupal::entityTypeManager()->getStorage('assessment_statement');
      $assessment_statement_ids = $storage->getQuery()
        ->condition('uid', $account->id())
        ->accessCheck(FALSE)
        ->execute();
      foreach ($storage->loadMultiple($assessment_statement_ids) as $assessment_statement) {
        $assessment_statement->setOwnerId(0)->save();
      }

      // Anonymize binding requirements.
      $storage = \Drupal::entityTypeManager()->getStorage('assessment_requirement');
      $assessment_requirement_ids = $storage->getQuery()
        ->condition('uid', $account->id())
        ->accessCheck(FALSE)
        ->execute();
      foreach ($storage->loadMultiple($assessment_requirement_ids) as $assessment_requirement) {
        $assessment_requirement->setOwnerId(0)->save();
      }

      // Anonymize assessments.
      $storage = \Drupal::entityTypeManager()->getStorage('assessment');
      $assessment_ids = $storage->getQuery()
        ->condition('uid', $account->id())
        ->accessCheck(FALSE)
        ->execute();
      foreach ($storage->loadMultiple($assessment_ids) as $assessment) {
        $assessment->setOwnerId(0)->save();
      }
      break;

    case 'user_cancel_block_unpublish':
      // Unpublish assets.
      $storage = \Drupal::entityTypeManager()->getStorage('assessments_asset');
      $assessments_asset_ids = $storage->getQuery()
        ->condition('uid', $account->id())
        ->condition('status', 1)
        ->accessCheck(FALSE)
        ->execute();
      foreach ($storage->loadMultiple($assessments_asset_ids) as $assessments_asset) {
        $assessments_asset->set('status', FALSE)->save();
      }

      // Unpublish publicorganizations.
      $storage = \Drupal::entityTypeManager()->getStorage('assessment_organization');
      $assessment_organization_ids = $storage->getQuery()
        ->condition('uid', $account->id())
        ->condition('status', 1)
        ->accessCheck(FALSE)
        ->execute();
      foreach ($storage->loadMultiple($assessment_organization_ids) as $assessment_organization) {
        $assessment_organization->set('status', FALSE)->save();
      }

      // Unpublish public services.
      $storage = \Drupal::entityTypeManager()->getStorage('assessment_service');
      $assessment_service_ids = $storage->getQuery()
        ->condition('uid', $account->id())
        ->condition('status', 1)
        ->accessCheck(FALSE)
        ->execute();
      foreach ($storage->loadMultiple($assessment_service_ids) as $assessment_service) {
        $assessment_service->set('status', FALSE)->save();
      }

      // Unpublish legal expressions.
      $storage = \Drupal::entityTypeManager()->getStorage('assessment_expression');
      $assessment_expression_ids = $storage->getQuery()
        ->condition('uid', $account->id())
        ->condition('status', 1)
        ->accessCheck(FALSE)
        ->execute();
      foreach ($storage->loadMultiple($assessment_expression_ids) as $assessment_expression) {
        $assessment_expression->set('status', FALSE)->save();
      }

      // Unpublish statements.
      $storage = \Drupal::entityTypeManager()->getStorage('assessment_statement');
      $assessment_statement_ids = $storage->getQuery()
        ->condition('uid', $account->id())
        ->condition('status', 1)
        ->accessCheck(FALSE)
        ->execute();
      foreach ($storage->loadMultiple($assessment_statement_ids) as $assessment_statement) {
        $assessment_statement->set('status', FALSE)->save();
      }

      // Unpublish binding requirements.
      $storage = \Drupal::entityTypeManager()->getStorage('assessment_requirement');
      $assessment_requirement_ids = $storage->getQuery()
        ->condition('uid', $account->id())
        ->condition('status', 1)
        ->accessCheck(FALSE)
        ->execute();
      foreach ($storage->loadMultiple($assessment_requirement_ids) as $assessment_requirement) {
        $assessment_requirement->set('status', FALSE)->save();
      }

      // Unpublish assessments.
      $storage = \Drupal::entityTypeManager()->getStorage('assessment');
      $assessment_ids = $storage->getQuery()
        ->condition('uid', $account->id())
        ->condition('status', 1)
        ->accessCheck(FALSE)
        ->execute();
      foreach ($storage->loadMultiple($assessment_ids) as $assessment) {
        $assessment->set('status', FALSE)->save();
      }
      break;

      // Delete assessments that belong to this account.
      $storage = \Drupal::entityTypeManager()->getStorage('assessment');
      $assessment_ids = $storage->getQuery()
        ->condition('uid', $account->id())
        ->accessCheck(FALSE)
        ->execute();
      $storage->delete(
        $storage->loadMultiple($assessment_ids)
      );
      // Delete old revisions.
      $assessment_ids = $storage->getQuery()
        ->allRevisions()
        ->condition('uid', $account->id())
        ->accessCheck(FALSE)
        ->execute();
      foreach (array_keys($assessment_ids) as $revision_id) {
        $storage->deleteRevision($revision_id);
      }
  }
}

/**
 * Implements hook_ENTITY_TYPE_predelete() for user entities.
 */
function assessments_user_predelete(UserInterface $account): void {
  // Delete agents that belong to this account.
  $storage = \Drupal::entityTypeManager()->getStorage('assessments_agent');
  $assessments_agent_ids = $storage->getQuery()
    ->condition('uid', $account->id())
    ->accessCheck(FALSE)
    ->execute();
  $storage->delete(
    $storage->loadMultiple($assessments_agent_ids)
  );

  // Delete participations that belong to this account.
  $storage = \Drupal::entityTypeManager()->getStorage('assessments_participation');
  $assessments_participation_ids = $storage->getQuery()
    ->condition('uid', $account->id())
    ->accessCheck(FALSE)
    ->execute();
  $storage->delete(
    $storage->loadMultiple($assessments_participation_ids)
  );

  // Delete assets that belong to this account.
  $storage = \Drupal::entityTypeManager()->getStorage('assessments_asset');
  $assessments_asset_ids = $storage->getQuery()
    ->condition('uid', $account->id())
    ->accessCheck(FALSE)
    ->execute();
  $storage->delete(
    $storage->loadMultiple($assessments_asset_ids)
  );

  // Delete publicorganizations that belong to this account.
  $storage = \Drupal::entityTypeManager()->getStorage('assessment_organization');
  $assessment_organization_ids = $storage->getQuery()
    ->condition('uid', $account->id())
    ->accessCheck(FALSE)
    ->execute();
  $storage->delete(
    $storage->loadMultiple($assessment_organization_ids)
  );

  // Delete public services that belong to this account.
  $storage = \Drupal::entityTypeManager()->getStorage('assessment_service');
  $assessment_service_ids = $storage->getQuery()
    ->condition('uid', $account->id())
    ->accessCheck(FALSE)
    ->execute();
  $storage->delete(
    $storage->loadMultiple($assessment_service_ids)
  );

  // Delete legal expressions that belong to this account.
  $storage = \Drupal::entityTypeManager()->getStorage('assessment_expression');
  $assessment_expression_ids = $storage->getQuery()
    ->condition('uid', $account->id())
    ->accessCheck(FALSE)
    ->execute();
  $storage->delete(
    $storage->loadMultiple($assessment_expression_ids)
  );

  // Delete statements that belong to this account.
  $storage = \Drupal::entityTypeManager()->getStorage('assessment_statement');
  $assessment_statement_ids = $storage->getQuery()
    ->condition('uid', $account->id())
    ->accessCheck(FALSE)
    ->execute();
  $storage->delete(
    $storage->loadMultiple($assessment_statement_ids)
  );

  // Delete binding requirements that belong to this account.
  $storage = \Drupal::entityTypeManager()->getStorage('assessment_requirement');
  $assessment_requirement_ids = $storage->getQuery()
    ->condition('uid', $account->id())
    ->accessCheck(FALSE)
    ->execute();
  $storage->delete(
    $storage->loadMultiple($assessment_requirement_ids)
  );
}
