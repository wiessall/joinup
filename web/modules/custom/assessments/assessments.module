<?php

/**
 * @file
 * Assessments module hooks and functions.
 */

declare(strict_types=1);

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;
use Drupal\assessments\Entity\AssessmentReport;
use Drupal\assessments\Entity\PublicOrganisation;
use Drupal\taxonomy\Entity\Term;
use Drupal\user\UserInterface;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_theme().
 */
function assessments_theme(): array {
  return [
    'assessment' => ['render element' => 'elements'],
    'assessment_statement' => ['render element' => 'elements'],
  ];
}

/**
 * Implements hook_entity_extra_field_info().
 */
function assessments_entity_extra_field_info(): array {
  return [
    'assessment' => [
      'report' => [
        'form' => [
          'cross_border' => [
            'label' => t('Cross border type'),
            'description' => t('Identified effects on cross-border interoperability'),
            'weight' => 0,
          ],
        ],
      ],
    ],
  ];
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function assessments_form_alter(array &$form, FormStateInterface $formState, string $formId): void {
  if (!in_array($formId, ['assessment_report_add_form', 'assessment_report_edit_form'], TRUE)) {
    return;
  }

  $form['cross_border'] = [
    '#type' => 'html_tag',
    '#tag' => 'h3',
    '#value' => t('Identified effects on cross-border interoperability'),
  ];
  $form['#attached']['library'][] = 'assessments/radios_inline';
  $form['state']['#attributes']['class'][] = 'radios-inline';
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function assessments_form_layout_paragraphs_component_form_alter(array &$form, FormStateInterface $formState): void {
  $paragraph = $formState->getFormObject()->getEntity();
  if ($paragraph->bundle() === 'binding_requirement') {
    // We use layout paragraphs, but we use everytime the 1 column layout.
    $form['layout_paragraphs']['#access'] = FALSE;
    $form['asset']['widget']['#title_display'] = 'invisible';
  }
}

/**
 * Implements hook_preprocess_HOOK().
 */
function assessments_preprocess_layout_paragraphs_insert_component_btn(&$variables): void {
  $url = $variables['url'];
  $layoutParagraphsLayout = \Drupal::service('layout_paragraphs.tempstore_repository')
    ->getWithStorageKey($url->getRouteParameters()['layout_paragraphs_layout']);

  $entity = $layoutParagraphsLayout?->getEntity();
  if ($entity instanceof AssessmentReport) {
    $fieldName = $layoutParagraphsLayout?->getFieldName();
    if ($fieldName === 'binding_requirement') {
      $variables['title'] = t('New binding requirement');

      $routeParams = $url->getRouteParameters();
      $queryParams = $url->getOption('query') ?: [];
      // Hide component selection buttons inside layout regions for
      // binding_requirement field. Only hide if this is inside a region
      // (has parent_uuid AND region parameters). Keep the root-level
      // "Add section" buttons visible.
      if (
          isset($routeParams['layout_paragraphs_layout']) &&
          $url->getRouteName() === 'layout_paragraphs.builder.choose_component' &&
          isset($queryParams['parent_uuid']) &&
          isset($queryParams['region'])
      ) {
        $variables['attributes']['class'][] = 'visually-hidden';
      }
    }
  }
}

/**
 * Prepares variables for assessment templates.
 *
 * Default template: assessment.html.twig.
 *
 * @param array $variables
 *   An associative array containing:
 *   - elements: An associative array containing the assessment
 *     information and any fields attached to the entity.
 *   - attributes: HTML attributes for the containing element.
 */
function template_preprocess_assessment(array &$variables): void {
  $variables['view_mode'] = $variables['elements']['#view_mode'];
  foreach (Element::children($variables['elements']) as $key) {
    $variables['content'][$key] = $variables['elements'][$key];
  }
}

/**
 * Prepares variables for assessment_statement templates.
 *
 * Default template: assessment_statement.html.twig.
 *
 * @param array $variables
 *   An associative array containing:
 *   - elements: An associative array containing the assessment
 *     information and any fields attached to the entity.
 *   - attributes: HTML attributes for the containing element.
 */
function template_preprocess_assessment_statement(array &$variables): void {
  $variables['view_mode'] = $variables['elements']['#view_mode'];
  foreach (Element::children($variables['elements']) as $key) {
    $variables['content'][$key] = $variables['elements'][$key];
  }
}

/**
 * Implements hook_theme_suggestions_HOOK().
 */
function assessments_theme_suggestions_assessment(array $variables): array {
  $suggestions = [];
  $assessment = $variables['elements']['#assessment'];
  $sanitized_view_mode = strtr($variables['elements']['#view_mode'], '.', '_');

  $suggestions[] = 'assessment__' . $sanitized_view_mode;
  $suggestions[] = 'assessment__' . $assessment->bundle();
  $suggestions[] = 'assessment__' . $assessment->bundle() . '__' . $sanitized_view_mode;

  return $suggestions;
}

/**
 * Implements hook_user_cancel().
 */
function assessments_user_cancel($edit, UserInterface $account, $method): void {
  switch ($method) {
    case 'user_cancel_block_unpublish':
      // Unpublish assessments.
      $storage = \Drupal::entityTypeManager()->getStorage('assessment');
      $assessment_ids = $storage->getQuery()
        ->condition('uid', $account->id())
        ->condition('status', 1)
        ->accessCheck(FALSE)
        ->execute();
      foreach ($storage->loadMultiple($assessment_ids) as $assessment) {
        $assessment->set('status', FALSE)->save();
      }
      break;

    case 'user_cancel_reassign':
      // Anonymize assessments.
      $storage = \Drupal::entityTypeManager()->getStorage('assessment');
      $assessment_ids = $storage->getQuery()
        ->condition('uid', $account->id())
        ->accessCheck(FALSE)
        ->execute();
      foreach ($storage->loadMultiple($assessment_ids) as $assessment) {
        $assessment->setOwnerId(0)->save();
      }
      break;
  }
}

/**
 * Implements hook_ENTITY_TYPE_predelete() for user entities.
 */
function assessments_user_predelete(UserInterface $account): void {
  // Delete assessments that belong to this account.
  $storage = \Drupal::entityTypeManager()->getStorage('assessment');
  $assessment_ids = $storage->getQuery()
    ->condition('uid', $account->id())
    ->accessCheck(FALSE)
    ->execute();
  $storage->delete(
    $storage->loadMultiple($assessment_ids)
  );
}

/**
 * Implements hook_entity_bundle_info().
