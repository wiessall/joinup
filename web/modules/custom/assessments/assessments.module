/**
 * Implements hook_theme().
 */
function assessments_theme(): array {
  return [
    'assessment' => ['render element' => 'elements'],
    'assessment_statement' => ['render element' => 'elements'],
  ];
}

/**
 * Implements hook_entity_extra_field_info().
 */
function assessments_entity_extra_field_info(): array {
  return [
    'assessment' => [
      'report' => [
        'form' => [
          'cross_border' => [
            'label' => t('Cross border type'),
            'description' => t('Identified effects on cross-border interoperability'),
            'weight' => 0,
          ],
        ],
      ],
    ],
  ];
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function assessments_form_alter(array &$form, FormStateInterface $formState, string $formId): void {
  if (!in_array($formId, ['assessment_report_add_form', 'assessment_report_edit_form'], TRUE)) {
    return;
  }

  $form['cross_border'] = [
    '#type' => 'html_tag',
    '#tag' => 'h3',
    '#value' => t('Identified effects on cross-border interoperability'),
  ];
  $form['#attached']['library'][] = 'assessments/radios_inline';
  $form['state']['#attributes']['class'][] = 'radios-inline';

  // Register submit handler to create organizations after validation.
  $handler = [
    'Drupal\assessments\Plugin\Field\FieldWidget\ProvidedByWidget',
    'submitCreateOrganisations',
  ];
  $existingHandlers = $form['actions']['submit']['#submit'] ?? [];
  if (!in_array($handler, $existingHandlers, TRUE)) {
    // Execute before entity builder to set org IDs before entity save.
    array_unshift($form['actions']['submit']['#submit'], $handler);
  }
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function assessments_form_layout_paragraphs_component_form_alter(array &$form, FormStateInterface $formState): void {
  $paragraph = $formState->getFormObject()->getEntity();
  if ($paragraph->bundle() === 'binding_requirement') {
    // We use layout paragraphs, but we use everytime the 1 column layout.
    $form['layout_paragraphs']['#access'] = FALSE;
    $form['asset']['widget']['#title_display'] = 'invisible';
  }
}

/**
 * Implements hook_preprocess_HOOK().
 */
function assessments_preprocess_layout_paragraphs_insert_component_btn(&$variables): void {
  $url = $variables['url'];
  $layoutParagraphsLayout = \Drupal::service('layout_paragraphs.tempstore_repository')
    ->getWithStorageKey($url->getRouteParameters()['layout_paragraphs_layout']);

  $entity = $layoutParagraphsLayout?->getEntity();
  if ($entity instanceof AssessmentReport) {
    $fieldName = $layoutParagraphsLayout?->getFieldName();
    if ($fieldName === 'binding_requirement') {
      $variables['title'] = t('New binding requirement');

      $routeParams = $url->getRouteParameters();
      $queryParams = $url->getOption('query') ?: [];
      // Hide component selection buttons inside layout regions for
      // binding_requirement field. Only hide if this is inside a region
      // (has parent_uuid AND region parameters). Keep the root-level
      // "Add section" buttons visible.
      if (
          isset($routeParams['layout_paragraphs_layout']) &&
          $url->getRouteName() === 'layout_paragraphs.builder.choose_component' &&
          isset($queryParams['parent_uuid']) &&
          isset($queryParams['region'])
      ) {
        $variables['attributes']['class'][] = 'visually-hidden';
      }
    }
  }
}

/**
 * Prepares variables for assessment templates.
 *
 * Default template: assessment.html.twig.
 *
 * @param array $variables
 *   An associative array containing:
 *   - elements: An associative array containing the assessment
 *     information and any fields attached to the entity.
 *   - attributes: HTML attributes for the containing element.
 */
function template_preprocess_assessment(array &$variables): void {
  $variables['view_mode'] = $variables['elements']['#view_mode'];
  foreach (Element::children($variables['elements']) as $key) {
    $variables['content'][$key] = $variables['elements'][$key];
  }
}

/**
 * Prepares variables for assessment_statement templates.
 *
 * Default template: assessment_statement.html.twig.
 *
 * @param array $variables
 *   An associative array containing:
 *   - elements: An associative array containing the assessment
 *     information and any fields attached to the entity.
 *   - attributes: HTML attributes for the containing element.
 */
function template_preprocess_assessment_statement(array &$variables): void {
  $variables['view_mode'] = $variables['elements']['#view_mode'];
  foreach (Element::children($variables['elements']) as $key) {
    $variables['content'][$key] = $variables['elements'][$key];
  }
}

/**
 * Implements hook_theme_suggestions_HOOK().
 */
function assessments_theme_suggestions_assessment(array $variables): array {
  $suggestions = [];
  $assessment = $variables['elements']['#assessment'];
  $sanitized_view_mode = strtr($variables['elements']['#view_mode'], '.', '_');

  $suggestions[] = 'assessment__' . $sanitized_view_mode;
  $suggestions[] = 'assessment__' . $assessment->bundle();
  $suggestions[] = 'assessment__' . $assessment->bundle() . '__' . $sanitized_view_mode;

  return $suggestions;
}

/**
 * Implements hook_user_cancel().
 */
function assessments_user_cancel($edit, UserInterface $account, $method): void {
  switch ($method) {
    case 'user_cancel_block_unpublish':
      // Unpublish assessments.
      $storage = \Drupal::entityTypeManager()->getStorage('assessment');
      $assessment_ids = $storage->getQuery()
        ->condition('uid', $account->id())
        ->condition('status', 1)
        ->accessCheck(FALSE)
        ->execute();
      foreach ($storage->loadMultiple($assessment_ids) as $assessment) {
        $assessment->set('status', FALSE)->save();
      }
      break;

    case 'user_cancel_reassign':
      // Anonymize assessments.
      $storage = \Drupal::entityTypeManager()->getStorage('assessment');
      $assessment_ids = $storage->getQuery()
        ->condition('uid', $account->id())
        ->accessCheck(FALSE)
        ->execute();
      foreach ($storage->loadMultiple($assessment_ids) as $assessment) {
        $assessment->setOwnerId(0)->save();
      }
      break;
  }
}

/**
 * Implements hook_ENTITY_TYPE_predelete() for user entities.
 */
function assessments_user_predelete(UserInterface $account): void {
  // Delete assessments that belong to this account.
  $storage = \Drupal::entityTypeManager()->getStorage('assessment');
  $assessment_ids = $storage->getQuery()
    ->condition('uid', $account->id())
    ->accessCheck(FALSE)
    ->execute();
  $storage->delete(
    $storage->loadMultiple($assessment_ids)
  );
}

/**
 * Implements hook_entity_bundle_info().
 */
function assessments_entity_bundle_info(): array {
  return [
    'assessment_statement' => array_map(
      fn (TranslatableMarkup $label): array => ['label' => $label],
      [
        'legal' => t('Legal interoperability'),
        'organisational'  => t('Organisational interoperability'),
        'semantic' => t('Semantic interoperability'),
        'technical' => t('Technical interoperability'),
        'other' => t('Other interoperability'),
      ],
    ),
  ];
}

/**
 * Implements hook_entity_bundle_info_alter().
 */
function assessments_entity_bundle_info_alter(array &$bundles): void {
  if (isset($bundles['assessment']['report'])) {
    $bundles['assessment']['report']['class'] = AssessmentReport::class;
  }
  if (isset($bundles['assessment']['public_organisation'])) {
    $bundles['assessment']['public_organisation']['class'] = PublicOrganisation::class;
  }
  if (isset($bundles['assessment']['expression'])) {
    $bundles['assessment']['expression']['class'] = AssessmentSubEntity::class;
  }
  if (isset($bundles['assessment']['participation'])) {
    $bundles['assessment']['participation']['class'] = AssessmentSubEntity::class;
  }
  if (isset($bundles['assessment']['public_service'])) {
    $bundles['assessment']['public_service']['class'] = AssessmentSubEntity::class;
  }

  $rdfSync = [
    'type' => 'http://data.europa.eu/2sa/cav#Statement',
    'uri_plugin' => 'default',
    'fields' => [
      'interpretation' => [
        'target_id' => [
          'predicate' => 'http://data.europa.eu/2sa/cav#interpretation',
          'type' => 'resource',
        ],
      ],
      'judgement' => [
        'value' => [
          'predicate' => 'http://data.europa.eu/2sa/cav#judgement',
          'type' => NULL,
        ],
      ],
      'statement_type' => [
        'target_id' => [
          'predicate' => 'http://data.europa.eu/2sa/cav#type',
          'type' => 'resource',
        ],
      ],
    ],
  ];

  array_walk($bundles['assessment_statement'], function (array &$info) use ($rdfSync): void {
    $info['rdf_sync'] = $rdfSync;
  });
}

/**
 * Enable options_buttons widget for state.
 */
function assessments_field_widget_info_alter(array &$info): void {
  $info['options_buttons']['field_types'][] = 'state';
}

/**
 * Implements hook_views_data().
 */
function assessments_views_data(): array {
  $data['views']['assessments_reports_links'] = [
    'title' => t('Assessment reports links'),
    'area' => [
      'id' => 'assessments_reports_links',
    ],
  ];
  return $data;
}

/**
 * Implements hook_inline_entity_form_entity_form_alter().
 */
function assessments_inline_entity_form_entity_form_alter(array &$entity_form, FormStateInterface &$formState): void {
  $solution = $entity_form['#entity'];

  if ($entity_form['#ief_id'] === 'asset-form' && $solution instanceof SolutionInterface) {
    $collection = \Drupal::service('entity.repository')->loadEntityByUuid('node', AssessmentInterface::SOLUTION_COLLECTOR);
    assert($collection instanceof CollectionInterface);

    $solution
      // All solutions created via assessments form are belonging to a
      // 'collector' collection.
      ->setGroup($collection)
      // And are published by default.
      ->set('field_state', 'published');

    // In this context the landing page is mandatory.
    $entity_form['landing_page']['widget']['uri']['#required'] = TRUE;
  }
}

/**
 * Implements hook_inline_entity_form_table_fields_alter().
 */
function assessments_inline_entity_form_table_fields_alter(array &$fields, array $context): void {
  if (
    $context['parent_entity_type'] === 'paragraph' &&
    $context['parent_bundle'] === 'binding_requirement' &&
    $context['field_name'] === 'asset'
  ) {
    unset($fields['status']);

    $fields['landing_page'] = [
      'type' => 'field',
      'label' => t('Relevant website'),
      'weight' => 10,
    ];
  }
}

/**
 * Implements hook_module_implements_alter().
 */
function assessments_module_implements_alter(array &$implementations, $hook): void {
  if ($hook === 'node_create_access') {
    // The state_machine_permissions_node_create_access() implementation,
    // forbids access to a solution which is not in the context of a group. But
    // in the context of assessments, we allow a user to create solutions via
    // the assessment report form, and immediately, we set the group to a
    // collection acting as a collector for such solutions. We add our own
    // implementation that allows this exception.
    // @see state_machine_permissions_node_create_access()
    // @see assessments_node_create_access()
    unset($implementations['state_machine_permissions']);
  }
}

/**
 * Implements hook_ENTITY_TYPE_create_access().
 */
function assessments_node_create_access(AccountInterface $account, array $context, string $entity_bundle): AccessResultInterface {
  // Detect if the access is checked as part of the inline entity form widget,
  // specifically, the one that allow adding new solutions.
  $isAssetInlineEntityFormWidget = isset($context['parent_entity_type']) &&
    $context['parent_entity_type'] === 'paragraph' &&
    isset($context['parent_bundle']) &&
    $context['parent_bundle'] === 'binding_requirement' &&
    isset($context['field_name']) &&
    $context['field_name'] === 'asset';

  if ($isAssetInlineEntityFormWidget) {
    return AccessResult::allowed();
  }

  return state_machine_permissions_node_create_access($account, $context, $entity_bundle);
}

/**
 * Implements hook_ENTITY_TYPE_insert() for assessment entities.
 */
function assessments_assessment_insert(AssessmentInterface $entity): void {
  _assessments_handle_report_state_notification($entity);
}

/**
 * Implements hook_ENTITY_TYPE_update() for assessment entities.
 */
function assessments_assessment_update(AssessmentInterface $entity): void {
  _assessments_handle_report_state_notification($entity);
}

/**
 * Handles notification dispatching for assessment report state changes.
 *
 * @param \Drupal\assessments\AssessmentInterface $entity
 *   The assessment entity.
 */
function _assessments_handle_report_state_notification(AssessmentInterface $entity): void {
  if ($entity->bundle() !== 'report' || !$entity->hasField('state')) {
    return;
  }

  $original_state = $entity->original?->get('state')?->getString();
  $current_state = $entity->get('state')?->getString();

  if ($current_state === 'review' && $original_state !== 'review') {
    $event = new AssessmentReportEvent($entity);
    \Drupal::service('event_dispatcher')
      ->dispatch($event, NotificationEvents::ASSESSMENT_REPORT_SUBMITTED_FOR_REVIEW);
  }
}
