/**
 * Implements hook_user_cancel().
 */
function assessments_user_cancel($edit, UserInterface $account, $method): void {
  switch ($method) {
    case 'user_cancel_reassign':
      // Anonymize agents.
      $storage = \Drupal::entityTypeManager()->getStorage('assessments_agent');
      $assessments_agent_ids = $storage->getQuery()
        ->condition('uid', $account->id())
        ->accessCheck(FALSE)
        ->execute();
      foreach ($storage->loadMultiple($assessments_agent_ids) as $assessments_agent) {
        $assessments_agent->setOwnerId(0)->save();
      }

      // Anonymize participations.
      $storage = \Drupal::entityTypeManager()->getStorage('assessments_participation');
      $assessments_participation_ids = $storage->getQuery()
        ->condition('uid', $account->id())
        ->accessCheck(FALSE)
        ->execute();
      foreach ($storage->loadMultiple($assessments_participation_ids) as $assessments_participation) {
        $assessments_participation->setOwnerId(0)->save();
      }

      // Anonymize assets.
      $storage = \Drupal::entityTypeManager()->getStorage('assessments_asset');
      $assessments_asset_ids = $storage->getQuery()
        ->condition('uid', $account->id())
        ->accessCheck(FALSE)
        ->execute();
      foreach ($storage->loadMultiple($assessments_asset_ids) as $assessments_asset) {
        $assessments_asset->setOwnerId(0)->save();
      }

      // Anonymize publicorganizations.
      $storage = \Drupal::entityTypeManager()->getStorage('assessment_organization');
      $assessment_organization_ids = $storage->getQuery()
        ->condition('uid', $account->id())
        ->accessCheck(FALSE)
        ->execute();
      foreach ($storage->loadMultiple($assessment_organization_ids) as $assessment_organization) {
        $assessment_organization->setOwnerId(0)->save();
      }
      break;

    case 'user_cancel_block_unpublish':
      // Unpublish assets.
      $storage = \Drupal::entityTypeManager()->getStorage('assessments_asset');
      $assessments_asset_ids = $storage->getQuery()
        ->condition('uid', $account->id())
        ->condition('status', 1)
        ->accessCheck(FALSE)
        ->execute();
      foreach ($storage->loadMultiple($assessments_asset_ids) as $assessments_asset) {
        $assessments_asset->set('status', FALSE)->save();
      }

      // Unpublish publicorganizations.
      $storage = \Drupal::entityTypeManager()->getStorage('assessment_organization');
      $assessment_organization_ids = $storage->getQuery()
        ->condition('uid', $account->id())
        ->condition('status', 1)
        ->accessCheck(FALSE)
        ->execute();
      foreach ($storage->loadMultiple($assessment_organization_ids) as $assessment_organization) {
        $assessment_organization->set('status', FALSE)->save();
      }
      break;
  }
}

/**
 * Implements hook_ENTITY_TYPE_predelete() for user entities.
 */
function assessments_user_predelete(UserInterface $account): void {
  // Delete agents that belong to this account.
  $storage = \Drupal::entityTypeManager()->getStorage('assessments_agent');
  $assessments_agent_ids = $storage->getQuery()
    ->condition('uid', $account->id())
    ->accessCheck(FALSE)
    ->execute();
  $storage->delete(
    $storage->loadMultiple($assessments_agent_ids)
  );

  // Delete participations that belong to this account.
  $storage = \Drupal::entityTypeManager()->getStorage('assessments_participation');
  $assessments_participation_ids = $storage->getQuery()
    ->condition('uid', $account->id())
    ->accessCheck(FALSE)
    ->execute();
  $storage->delete(
    $storage->loadMultiple($assessments_participation_ids)
  );

  // Delete assets that belong to this account.
  $storage = \Drupal::entityTypeManager()->getStorage('assessments_asset');
  $assessments_asset_ids = $storage->getQuery()
    ->condition('uid', $account->id())
    ->accessCheck(FALSE)
    ->execute();
  $storage->delete(
    $storage->loadMultiple($assessments_asset_ids)
  );

  // Delete publicorganizations that belong to this account.
  $storage = \Drupal::entityTypeManager()->getStorage('assessment_organization');
  $assessment_organization_ids = $storage->getQuery()
    ->condition('uid', $account->id())
    ->accessCheck(FALSE)
    ->execute();
  $storage->delete(
    $storage->loadMultiple($assessment_organization_ids)
  );
}
