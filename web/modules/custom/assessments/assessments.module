/**
 * Implements hook_entity_bundle_info_alter().
 */
function assessments_entity_bundle_info_alter(array &$bundles): void {
  if (isset($bundles['assessment']['report'])) {
    $bundles['assessment']['report']['class'] = AssessmentReport::class;
  }
  if (isset($bundles['assessment']['public_organisation'])) {
    $bundles['assessment']['public_organisation']['class'] = PublicOrganisation::class;
  }
  if (isset($bundles['assessment']['expression'])) {
    $bundles['assessment']['expression']['class'] = AssessmentSubEntity::class;
  }
  if (isset($bundles['assessment']['participation'])) {
    $bundles['assessment']['participation']['class'] = AssessmentSubEntity::class;
  }
  if (isset($bundles['assessment']['public_service'])) {
    $bundles['assessment']['public_service']['class'] = AssessmentSubEntity::class;
  }

  $rdfSync = [
    'type' => 'http://data.europa.eu/2sa/cav#Statement',
    'uri_plugin' => 'joinup_po_namespace:s2k',
    'fields' => [
      'interpretation' => [
        'target_id' => [
          'predicate' => 'http://data.europa.eu/2sa/cav#interpretation',
          'type' => 'resource',
        ],
      ],
      'judgement' => [
        'value' => [
          'predicate' => 'http://data.europa.eu/2sa/cav#judgement',
          'type' => NULL,
        ],
      ],
      'statement_type' => [
        'target_id' => [
          'predicate' => 'http://data.europa.eu/2sa/cav#type',
          'type' => 'resource',
        ],
      ],
    ],
  ];

  array_walk($bundles['assessment_statement'], function (array &$info) use ($rdfSync): void {
    $info['rdf_sync'] = $rdfSync;
  });

  if (isset($bundles['paragraph']['binding_requirement'])) {
    $bundles['paragraph']['binding_requirement']['class'] = BindingRequirementParagraph::class;
  }
}

