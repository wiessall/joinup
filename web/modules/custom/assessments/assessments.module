function assessments_views_data(): array {
  $data['views']['assessments_reports_links'] = [
    'title' => t('Assessment reports links'),
    'area' => [
      'id' => 'assessments_reports_links',
    ],
  ];

  return $data;
}

/**
 * Checks if an account can moderate an assessment.
 *
 * @param \Drupal\Core\Entity\EntityInterface $entity
 *   The entity to check.
 * @param \Drupal\Core\Session\AccountInterface $account
 *   The user account to check access for.
 *
 * @return \Drupal\Core\Access\AccessResultInterface
 *   The access result with proper caching.
 */
function _assessments_can_moderate(EntityInterface $entity, AccountInterface $account): AccessResultInterface {
  if (!$entity instanceof AssessmentReport) {
    return AccessResult::forbidden('This assessment bundle does not support moderation.')
      ->addCacheableDependency($entity);
  }

  return AccessResult::allowedIf($entity->getWorkflowState() === 'review')
    ->andIf(AccessResult::allowedIfHasPermission($account, 'moderate assessment report'))
    ->addCacheableDependency($entity);
}

/**
 * Implements hook_entity_operation().
 */
function assessments_entity_operation(EntityInterface $entity): array {
  $operations = [];

  if (!$entity instanceof AssessmentReport) {
    return $operations;
  }

  $access = _assessments_can_moderate($entity, \Drupal::service('current_user')->getAccount());

  // Only add the operation if access is explicitly allowed.
  if (!$access->isAllowed()) {
    return $operations;
  }

  $operations['moderate'] = [
    'title' => t('Moderate'),
    'url' => Url::fromRoute('assessments.moderate', [
      'assessment_type' => $entity->bundle(),
      'assessment' => $entity->id(),
    ]),
    'weight' => 50,
  ];

  return $operations;
}

/**
 * Implements hook_inline_entity_form_entity_form_alter().
 */
function assessments_inline_entity_form_entity_form_alter(array &$entityForm, FormStateInterface $formState): void {
  $solution = $entityForm['#entity'];

  // @see config/sync/entity_browser.browser.assessment_solutions.yml
  if ($formState->get('entity_browser_current_widget') === 'a1b2c3d4-e5f6-7890-abcd-ef1234567890') {
    $collection = \Drupal::service('entity.repository')->loadEntityByUuid('node', AssessmentInterface::SOLUTION_COLLECTOR);
    assert($collection instanceof CollectionInterface);

    $solution
      // All solutions created via this form belong to a 'collector' collection.
      ->setGroup($collection)
      // And are published by default.
      ->set('field_state', 'published');

    // In this context the landing page is mandatory.
    $entityForm['landing_page']['widget']['uri']['#required'] = TRUE;
  }

  if ($solution->bundle() === 'participation') {
    $delta = $entityForm['#ief_row_delta'];
    $entityForm['stakeholder_country']['#states'] = [
      'visible' => [
        ':input[name="has_participation[' . $delta . '][inline_entity_form][eu_countries][value]"]' => ['checked' => FALSE],
      ],
    ];
  }

  if ($solution instanceof AssessmentStatementInterface) {
    $selector = ':input[name="' . $solution->bundle() . '[0][inline_entity_form][interpretation]"]';
    $entityForm['judgement']['#states'] = [
      'invisible' => [
        [$selector => ['value' => '_none']],
        [$selector => ['checked' => FALSE]],
      ],
    ];
  }
}

/**
 * Implements hook_inline_entity_form_table_fields_alter().
 */
function assessments_inline_entity_form_table_fields_alter(array &$fields, array $context): void {
  if (
    $context['parent_entity_type'] === 'paragraph' &&
    $context['parent_bundle'] === 'binding_requirement' &&
    $context['field_name'] === 'asset'
  ) {
    unset($fields['status']);

    $fields['landing_page'] = [
      'type' => 'field',
      'label' => t('Relevant website'),
      'weight' => 10,
    ];

    $fields['abstract'] = [
      'type' => 'field',
      'label' => t('Description'),
      'weight' => 11,
      'display_options' => [
        'type' => 'field_fallback_formatter',
        'settings' => [
          'main_field_formatter_id' => 'string',
          'main_field_formatter_settings' => ['link_to_entity' => FALSE],
          'fallback_field_id' => 'description',
          'fallback_field_formatter_id' => 'smart_trim',
          'fallback_field_formatter_settings' => [
            'trim_length' => 255,
            'trim_type' => 'chars',
            'trim_suffix' => '…',
            'wrap_output' => FALSE,
            'wrap_class' => 'trimmed',
            'more' => [
              'display_link' => FALSE,
              'target_blank' => FALSE,
              'link_trim_only' => FALSE,
              'class' => 'more-link',
              'text' => '',
              'aria_label' => '',
            ],
            'trim_options' => [
              'text' => TRUE,
              'trim_zero' => FALSE,
              'replace_tokens' => FALSE,
            ],
          ],
        ],
      ],
    ];
  }
}

/**
 * Implements hook_ENTITY_TYPE_presave() for assessment entities.
 */
function assessments_assessment_presave(AssessmentInterface $entity): void {
  // For expression entities, copy initiative_name to name field.
  if ($entity->bundle() === 'expression' && $entity->hasField('initiative_name')) {
    $initiativeName = $entity->get('initiative_name')->value;
    if (!empty($initiativeName)) {
      // Truncate to 255 characters if necessary.
      $name = mb_strlen($initiativeName) > 255 ? mb_substr($initiativeName, 0, 255) : $initiativeName;
      $entity->set('name', $name);
    }
  }
  elseif ($entity->bundle() === 'participation') {
    $euCountry = $entity->get('eu_countries')->value;
    $vocabHelper = \Drupal::service(AssessmentVocabularyHelper::class);
    if ($euCountry) {
      $termId = $vocabHelper->getTermIdFromIdentifier('spatial', 'EU', 'code');
      $entity->set('stakeholder_country', ['target_id' => $termId]);
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_insert() for assessment entities.
 */
function assessments_assessment_insert(AssessmentInterface $entity): void {
  _assessments_handle_report_state_notification($entity);
}

/**
 * Implements hook_ENTITY_TYPE_update() for assessment entities.
 */
function assessments_assessment_update(AssessmentInterface $entity): void {
  _assessments_handle_report_state_notification($entity);
}

/**
 * Handles notification dispatching for assessment report state changes.
 *
 * @param \Drupal\assessments\AssessmentInterface $entity
 *   The assessment entity.
 */
function _assessments_handle_report_state_notification(AssessmentInterface $entity): void {
  if (!$entity instanceof AssessmentReport) {
    return;
  }

  $originalState = $entity->original instanceof AssessmentReport ? $entity->original->getWorkflowState() : NULL;
  $currentState = $entity->getWorkflowState();

  if ($currentState === 'review' && $originalState !== 'review') {
    $event = new AssessmentReportEvent($entity);
    \Drupal::service('event_dispatcher')
      ->dispatch($event, NotificationEvents::ASSESSMENT_REPORT_SUBMITTED_FOR_REVIEW);
  }
}

/**
 * Implements hook_entity_browser_widget_info_alter().
 */
function assessments_entity_browser_widget_info_alter(array &$info): void {
  if (isset($info['entity_form'])) {
    // Default EntityForm limits access to OG members.
    // OgAwareEntityForm also allows users with entity browser permission.
    $info['entity_form']['class'] = OgAwareEntityForm::class;
  }
}

/**
 * Implements hook_views_data_alter().
 */
function assessments_views_data_alter(array &$data): void {
  // Duplicate data to provide custom argument handler for assessment country.
  $codeValue = $data['taxonomy_term__code']['code_value'];
  $codeValue['title'] = $codeValue['title short'] = new TranslatableMarkup('Assessment country code');
  $codeValue['argument']['id'] = 'assessment_country_code';
  $data['taxonomy_term__code']['assessment_country_code'] = $codeValue;
}

/**
 * Implements hook_form_FORM_ID_alter() for entity_browser_assessment_solutions_form.
 */
function assessments_form_entity_browser_assessment_solutions_form_alter(array &$form, FormStateInterface $formState): void {
  $form['#attached']['library'][] = 'assessments/entity_browser';
}

/**
 * Implements hook_inline_entity_form_reference_form_alter().
 */
function assessments_inline_entity_form_reference_form_alter(&$reference_form, FormStateInterface $form_state): void {
  $form_id = $form_state->getFormObject()->getFormId();
  if ($form_id === 'layout_paragraphs_component_form' && $reference_form['#ief_id'] === 'asset-form') {
    $reference_form["entity_id"]["#selection_handler"] = 'views';
    $reference_form["entity_id"]["#selection_settings"] = [
      "view" => [
        "view_name" => "solutions_reference",
        "display_name" => "entity_reference_1",
      ],
    ];
  }
}

/**
 * Implements hook_query_TAG_alter().
 */
function assessments_query_explore_block_solution_alter(AlterableInterface $query): void {
  /** @var \Drupal\Core\Entity\EntityRepositoryInterface $entity_repository */
  $entity_repository = \Drupal::service('entity.repository');
  $collector = $entity_repository->loadEntityByUuid('node', AssessmentInterface::SOLUTION_COLLECTOR);
  if ($collector) {
    $query->join('node__og_audience', 'oa', 'oa.entity_id = node_field_data.nid');
    $query->condition('og_audience_target_id', $collector->id(), '<>');
  }
}

/**
 * Implements hook_ajax_render_alter().
 */
function assessments_ajax_render_alter(array &$commands): void {
  foreach ($commands as &$command) {
    if ($command['command'] === 'openDialog' && !empty($command['dialogOptions']['modal']) && isset($command['dialogOptions']['classes']['ui-dialog']) && str_contains($command['dialogOptions']['classes']['ui-dialog'], 'entity-browser-modal')) {
      $command['dialogOptions']['draggable'] = FALSE;
    }
  }
}

/**
 * Implements hook_preprocess_page().
 */
function assessments_preprocess_page(array &$variables): void {
  $route_match = \Drupal::routeMatch();
  $assessment = $route_match->getParameter('assessment');
  if ($assessment && $assessment->bundle() === 'report') {
    $collection = \Drupal::service('entity.repository')
      ->loadEntityByUuid('node', AssessmentInterface::GROUP_UUID);
    assert($collection instanceof CollectionInterface);
    $variables['page']['header'] = \Drupal::service('plugin.manager.block')
      ->createInstance('group_header_block')
      ->setContextValue('og', $collection)
      ->build();
  }
}
