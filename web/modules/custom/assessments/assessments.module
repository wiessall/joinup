        'label' => t('Organisational interoperability'),
      ],
      'semantic' => [
        'label' => t('Semantic interoperability'),
      ],
      'technical' => [
        'label' => t('Technical interoperability'),
      ],
      'other' => [
        'label' => t('Other interoperability'),
      ],
    ],
  ];
}

/**
 * Implements hook_entity_bundle_info_alter().
 */
function assessments_entity_bundle_info_alter(array &$bundles): void {
  if (isset($bundles['assessment']['report'])) {
    $bundles['assessment']['report']['class'] = AssessmentReport::class;
  }
  if (isset($bundles['assessment']['public_organisation'])) {
    $bundles['assessment']['public_organisation']['class'] = PublicOrganisation::class;
  }
}

/**
 * Implements hook_views_pre_render().
 */
function assessments_views_pre_render(ViewExecutable $view): void {
  if ($view->id() == 'assessments_rest') {
    $results = $view->result;
    if ($view->current_display === 'public_organisation') {
      foreach ($results as $result) {
        // Instead of false we want to show an empty string.
        // @see \Drupal\views\Plugin\views\field\EntityField::getValue().
        if (empty($result->_entity->get('country')->getValue())) {
          $result->_entity->get('country')->setValue(['']);
        }
        // Instead of country term ID we want to send the two letters
        // of the country.
        else {
          $term_id = $result->_entity->get('country')->getValue()[0]['target_id'];
          $term = Term::load($term_id);
          $code = $term?->get('code')->value ?? '';
          $result->_entity->get('country')->setValue([$code]);
        }
      }
    }
    elseif ($view->current_display === 'asset') {
      foreach ($results as $result) {
        // Instead of false we want to show an empty string.
        // @see \Drupal\views\Plugin\views\field\EntityField::getValue().
        if (empty($result->_entity->get('landing_page')->getValue())) {
          $result->_entity->get('landing_page')->setValue(['']);
        }
      }
    }
  }
}

/**
 * Enable options_buttons widget for state.
 */
function assessments_field_widget_info_alter(array &$info): void {
  $info['options_buttons']['field_types'][] = 'state';
}

/**
 * Implements hook_views_data().
 */
function assessments_views_data(): array {
  $data['views']['assessments_reports_links'] = [
    'title' => t('Assessment reports links'),
    'area' => [
      'id' => 'assessments_reports_links',
    ],
  ];
  return $data;
}
