<?php

declare(strict_types=1);

/**
 * @file
 * Provides an agent entity type.
 */

use Drupal\assessments\Entity\PublicOrganisation;
use Drupal\assessments\Form\PublicOrganisationForm;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;
use Drupal\user\UserInterface;

/**
 * Implements hook_theme().
 */
function assessments_theme(): array {
  return [
    'assessment_content' => ['render element' => 'elements'],
  ];
}

/**
 * Prepares variables for assessment content templates.
 *
 * Default template: assessment-content.html.twig.
 *
 * @param array $variables
 *   An associative array containing:
 *   - elements: An associative array containing the assessment content information and any
 *     fields attached to the entity.
 *   - attributes: HTML attributes for the containing element.
 */
function template_preprocess_assessment_content(array &$variables): void {
  $variables['view_mode'] = $variables['elements']['#view_mode'];
  foreach (Element::children($variables['elements']) as $key) {
    $variables['content'][$key] = $variables['elements'][$key];
  }
}

/**
 * Implements hook_user_cancel().
 */
function assessments_user_cancel($edit, UserInterface $account, $method): void {
  switch ($method) {
    case 'user_cancel_block_unpublish':
      // Unpublish assessment contents.
      $storage = \Drupal::entityTypeManager()->getStorage('assessment_content');
      $assessment_content_ids = $storage->getQuery()
        ->condition('uid', $account->id())
        ->condition('status', 1)
        ->accessCheck(FALSE)
        ->execute();
      foreach ($storage->loadMultiple($assessment_content_ids) as $assessment_content) {
        $assessment_content->set('status', FALSE)->save();
      }
      break;

    case 'user_cancel_reassign':
      // Anonymize assessment contents.
      $storage = \Drupal::entityTypeManager()->getStorage('assessment_content');
      $assessment_content_ids = $storage->getQuery()
        ->condition('uid', $account->id())
        ->accessCheck(FALSE)
        ->execute();
      foreach ($storage->loadMultiple($assessment_content_ids) as $assessment_content) {
        $assessment_content->setOwnerId(0)->save();
      }
      break;
  }
}

/**
 * Implements hook_ENTITY_TYPE_predelete() for user entities.
 */
function assessments_user_predelete(UserInterface $account): void {
  // Delete assessment contents that belong to this account.
  $storage = \Drupal::entityTypeManager()->getStorage('assessment_content');
  $assessment_content_ids = $storage->getQuery()
    ->condition('uid', $account->id())
    ->accessCheck(FALSE)
    ->execute();
  $storage->delete(
    $storage->loadMultiple($assessment_content_ids)
  );
}

/**
 * Implements hook_entity_bundle_info_alter().
 */
function assessments_entity_bundle_info_alter(array &$bundles): void {
  // Change the label of the 'default' bundle of assessment_content entity type.
  if (isset($bundles['assessment_content']['public_organization'])) {
    $bundles['assessment_content']['public_organization']['class'] = PublicOrganisation::class;
  }
}

/**
 * Implements hook_form_alter().
 */
function assessments_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  $entity = $form_state->getFormObject()->getEntity();
  if ($entity instanceof PublicOrganisation) {
    PublicOrganisationForm::formAlter($form, $form_state);
  }
}

/**
 * Implements hook_inline_entity_form_entity_form_alter().
 */
function assessments_inline_entity_form_entity_form_alter(array &$entity_form, \Drupal\Core\Form\FormStateInterface &$form_state) {
  $entity = $entity_form['#entity'];
  if ($entity instanceof PublicOrganisation) {
    PublicOrganisationForm::formAlter($entity_form, $form_state);
  }
}

/**
 * Implements hook_form_BASE_FORM_ID_alter().
 */
function assessments_form_assessment_content_assessment_edit_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  $entity = $form_state->getFormObject()->getEntity();
  if ($entity instanceof PublicOrganisation) {
    PublicOrganisationForm::formAlter($form, $form_state);
  }
}
