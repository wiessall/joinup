<?php

/**
 * @file
 * Install, update, and uninstall functions for the Assessments module.
 */

declare(strict_types=1);

/**
 * Implements hook_schema().
 */
function assessments_schema(): array {
  $schema['assessments_migration_map'] = [
    'description' => 'Maps webform submission IDs to assessment report entity IDs.',
    'fields' => [
      'sid' => [
        'description' => 'The webform submission ID.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'report_id' => [
        'description' => 'The assessment report entity ID.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'migrated' => [
        'description' => 'Timestamp when the migration occurred.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['sid'],
    'indexes' => [
      'report_id' => ['report_id'],
    ],
  ];

  return $schema;
}

/**
 * Deletes assessment_report content.
 */
function assessments_update_201601(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('node');

  $nids = \Drupal::entityQuery('node')
    ->condition('type', 'assessment_report')
    ->accessCheck(FALSE)
    ->execute();

  if (empty($nids)) {
    $nodes = $storage->loadMultiple($nids);

    foreach ($nodes as $node) {
      $node->delete();
    }
  }
}
