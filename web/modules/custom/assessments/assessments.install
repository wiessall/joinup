<?php

/**
 * @file
 * Install, update, and uninstall functions for the Assessments module.
 */

declare(strict_types=1);

use Drupal\Core\Field\BaseFieldDefinition;

/**
 * Implements hook_schema().
 */
function assessments_schema(): array {
  $schema['assessments_migration_map'] = [
    'description' => 'Maps webform submission IDs to assessment report entity IDs.',
    'fields' => [
      'sid' => [
        'description' => 'The webform submission ID.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'report_id' => [
        'description' => 'The assessment report entity ID.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'migrated' => [
        'description' => 'Timestamp when the migration occurred.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['sid'],
    'indexes' => [
      'report_id' => ['report_id'],
    ],
  ];

  return $schema;
}

/**
 * Enable translation for Assessment Statement entities.
 */
function assessments_update_201300(array &$sandbox): void {
  $updateManager = \Drupal::entityDefinitionUpdateManager();
  $entityTypeId = 'assessment_statement';
  $entityType = $updateManager->getEntityType($entityTypeId);

  /** @var \Drupal\Core\Entity\EntityLastInstalledSchemaRepositoryInterface $last_installed_schema_repository */
  $last_installed_schema_repository = \Drupal::service('entity.last_installed_schema.repository');
  $fieldStorageDefinitions = $last_installed_schema_repository->getLastInstalledFieldStorageDefinitions('assessment_statement');

  $entityKeys = $entityType->getKeys();
  $entityKeys['langcode'] = 'langcode';
  $entityKeys['default_langcode'] = 'default_langcode';

  $entityType->set('entity_keys', $entityKeys);
  $entityType->set('data_table', 'assessment_statement_field_data');
  $entityType->set('translatable', TRUE);

  $fieldStorageDefinitions['langcode'] = BaseFieldDefinition::create('language')
    ->setLabel(t('Language'))
    ->setName('langcode')
    ->setTranslatable(TRUE)
    ->setTargetBundle(NULL)
    ->setTargetEntityTypeId($entityTypeId)
    ->setDisplayOptions('form', [
      'type' => 'language_select',
    ]);

  $fieldStorageDefinitions['default_langcode'] = BaseFieldDefinition::create('boolean')
    ->setLabel(t('Default translation'))
    ->setName('default_langcode')
    ->setDescription(t('A flag indicating whether this is the default translation.'))
    ->setRevisionable(TRUE)
    ->setTargetEntityTypeId($entityTypeId)
    ->setTargetBundle(NULL)
    ->setTranslatable(TRUE)
    ->setDefaultValue(TRUE);

  $updateManager->updateFieldableEntityType($entityType, $fieldStorageDefinitions, $sandbox);
}
