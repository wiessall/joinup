<?php

/**
 * @file
 * Install, update, and uninstall functions for the Assessments module.
 */

declare(strict_types=1);

/**
 * Implements hook_schema().
 */
function assessments_schema(): array {
  $schema['assessments_migration_map'] = [
    'description' => 'Maps webform submission IDs to assessment report entity IDs.',
    'fields' => [
      'sid' => [
        'description' => 'The webform submission ID.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'report_id' => [
        'description' => 'The assessment report entity ID.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'migrated' => [
        'description' => 'Timestamp when the migration occurred.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['sid'],
    'indexes' => [
      'report_id' => ['report_id'],
    ],
  ];

  return $schema;
}

/**
 * Update config for online_form_for_assessments.
 */
function assessments_update_201601(): void {
  $config = \Drupal::configFactory()
    ->getEditable('webform.webform.online_form_for_assessments');

  $dependencies = $config->get('dependencies');

  if (!empty($dependencies['module'])) {
    $dependencies['module'] = array_values(array_diff(
      $dependencies['module'],
      ['joinup_assessment']
    ));

    if (empty($dependencies['module'])) {
      unset($dependencies['module']);
    }

    $config
      ->set('dependencies', $dependencies)
      ->save(TRUE);
  }
}

/**
 * Remove joinup_assessment_routes from OG settings group resolvers.
 */
function assessments_update_201602(): void {
  $config = \Drupal::configFactory()
    ->getEditable('og.settings');

  $group_resolvers = $config->get('group_resolvers');

  if (!empty($group_resolvers)) {
    $group_resolvers = array_values(array_diff(
      $group_resolvers,
      ['joinup_assessment_routes']
    ));

    $config
      ->set('group_resolvers', $group_resolvers)
      ->save(TRUE);
  }
}
