<?php

/**
 * @file
 * Provides functionality for the contact information module.
 */

declare(strict_types = 1);

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Cache\Cache;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\Core\Field\FieldItemListInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\Core\StringTranslation\PluralTranslatableMarkup;
use Drupal\contact_information\ContactInformationEmailConfirmInterface;
use Drupal\contact_information\Entity\ContactInformation;
use Drupal\contact_information\Entity\ContactInformationInterface;
use Drupal\contact_information\ParentGroupFieldItemList;
use Drupal\email_confirmer\EmailConfirmationInterface;
use Drupal\joinup_group\JoinupGroupHelper;
use Drupal\rdf_entity\RdfInterface;

/**
 * Implements hook_entity_bundle_info_alter().
 */
function contact_information_entity_bundle_info_alter(&$bundles) {
  if (!empty($bundles['rdf_entity']['contact_information'])) {
    $bundles['rdf_entity']['contact_information']['class'] = ContactInformation::class;
  }
}

/**
 * Implements hook_entity_bundle_field_info_alter().
 */
function contact_information_entity_bundle_field_info_alter(array &$fields, EntityTypeInterface $entity_type, string $bundle): void {
  if ($entity_type->id() === 'rdf_entity' && $bundle === 'contact_information') {
    $fields['related_group'] = BaseFieldDefinition::create('entity_reference')
      ->setLabel(t('Related group'))
      ->setName('related_group')
      ->setDescription(t('The related group where this contact information entity is attached.'))
      ->setTargetEntityTypeId('rdf_entity')
      ->setTargetBundle('contact_information')
      ->setSetting('target_type', 'rdf_entity')
      ->setComputed(TRUE)
      ->setClass(ParentGroupFieldItemList::class);
  }
}

/**
 * Implements hook_ENTITY_TYPE_presave().
 */
function contact_information_rdf_entity_presave(EntityInterface $entity) {
  // Handle only contact information entities.
  if ($entity->bundle() != 'contact_information') {
    return;
  }

  contact_information_entity_auto_label($entity);

  // The initial state of a contact information entity is validated. The contact
  // is created as part of proposing a collection, and in the collection propose
  // form the workflow state is hidden from the user, so it would remain in the
  // "__new__" state after submission.
  // We can safely set the initial state to "validated" because a newly created
  // contact information entities don't need to be validated by a third party.
  if ($entity->field_ci_state->value === '__new__') {
    $entity->set('field_ci_state', 'validated');
  }
}

/**
 * Implements hook_inline_entity_form_table_fields_alter().
 *
 * Alters the name of the header of the entity column in the inline entity form
 * table in the create form. Header label was 'title' before.
 */
function contact_information_inline_entity_form_table_fields_alter(&$fields, $context) {
  // Replace the label in the contact information table.
  if (
    $context['entity_type'] == 'rdf_entity' &&
    $context['allowed_bundles'] === ['contact_information'] &&
    isset($fields['label'])
  ) {
    $fields['label']['label'] = t('Name');
  }
}

/**
 * Implements hook_inline_entity_form_entity_form_alter().
 */
function contact_information_inline_entity_form_entity_form_alter(array &$entity_form, FormStateInterface &$form_state): void {
  if ($entity_form['#entity_type'] !== 'rdf_entity' || $entity_form['#bundle'] !== 'contact_information') {
    return;
  }
  // Add an entity builder callback to fill the label field with the values of
  // the name field and collect new & updated email addresses.
  // @see contact_information_inline_entity_form_entity_builder()
  $entity_form['#entity_builders'][] = 'contact_information_inline_entity_form_entity_builder';
}

/**
 * Entity builder callback for the inline entity creation form.
 *
 * @param string $entity_type
 *   The type of the entity being created.
 * @param \Drupal\contact_information\Entity\ContactInformationInterface $contact_information
 *   The entity being built.
 */
function contact_information_inline_entity_form_entity_builder(string $entity_type, ContactInformationInterface $contact_information, array $form, FormStateInterface $form_state): void {
  // Fill the label field with the values of the name field. This is needed
  // because inline entity form doesn't save the entity until the parent entity
  // is saved. Due to this, the label column in the widget table would be empty.
  contact_information_entity_auto_label($contact_information);

  // Collect new and updated contact information emails and store them in the
  // form state storage to be used later, when the main form is submitted.
  // @see contact_information_confirm_emails()
  static $processed = [];
  $delta = $form['#ief_row_delta'];
  // The entity builder is called twice for the same contact information. Avoid
  // processing twice the same entity.
  if (empty($processed[$delta])) {
    /** @var \Drupal\joinup_group\Entity\GroupInterface $group */
    $group = $form_state->getFormObject()->getEntity();
    $field = $group->getContactInformationFieldName();

    if ($contact_information->isNew()) {
      $path = [$field, 'form', $delta, 'field_ci_email', 'value'];
      $initial_email = NULL;
    }
    else {
      $path = [
        $field,
        'form',
        'inline_entity_form',
        'entities',
        $delta,
        'form',
        'field_ci_email',
        'value',
      ];
      $initial_email = $group->get($field)->entity->get('field_ci_email')->value;
    }
    $email = $form_state->getValue($path);
    $emails = $form_state->get('contact_information_emails') ?? [];
    unset($emails[$delta]);
    if (!empty($email) && $email !== $initial_email) {
      $emails[$delta] = $email;
    }
    $form_state->set('contact_information_emails', $emails);
    $processed[$delta] = TRUE;
  }
}

/**
 * Generates the entity label from the name field for contact entities.
 *
 * This entity has support for multiple names according to ADMS scheme
 * and entity label does not support this. For this reason,
 * the label actually concatenates all values from field_ci_name field.
 *
 * @param \Drupal\Core\Entity\EntityInterface $entity
 *   The entity to process.
 */
function contact_information_entity_auto_label(EntityInterface $entity) {
  // Generate the label using the values of the name field.
  $names = array_map('trim', array_column($entity->get('field_ci_name')->getValue(), 'value'));
  $entity->set('label', implode(', ', $names));
}

/**
 * Revoke access to canonical route for anonymous users for contact information.
 *
 * Implements hook_ENTITY_TYPE_access().
 */
function contact_information_rdf_entity_access(EntityInterface $entity, $operation, AccountInterface $account) {
  if (!$entity instanceof ContactInformationInterface) {
    return AccessResult::neutral();
  }

  // Inline entity form module is using the 'update' but rdf_entity is still
  // using 'edit' for the edit operation. Rename the operation until it is
  // fixed in rdf_entity.
  // @see https://github.com/ec-europa/rdf_entity/issues/110
  if ($operation === 'update') {
    $operation = 'edit';
  }

  // For anonymous users, deny access to the canonical route.
  if ($account->isAnonymous()) {
    $route_name = \Drupal::routeMatch()->getRouteName();
    if ($route_name === 'entity.rdf_entity.canonical') {
      return AccessResult::forbidden('Anonymous users should not see contact information on the canonical route.');
    }
  }
  elseif ($operation == 'edit') {
    /** @var \Drupal\joinup_workflow\WorkflowHelperInterface $workflow_helper */
    $workflow_helper = \Drupal::service('joinup_workflow.workflow_helper');
    $available_target_states = $workflow_helper->getAvailableTargetStates($entity, $account);
    return empty($available_target_states) ? AccessResult::forbidden() : AccessResult::allowed();
  }
  // Use an elseif to avoid checking memberships for anonymous users.
  elseif ($operation === 'delete') {
    // The contact information is not a group content. It is tied to other
    // entities by a simple reference field.
    // To grant access to group owner/facilitators, we need to identify first
    // which group references the contact information.
    if ($group = $entity->getRelatedGroup()) {
      if ($group->hasGroupPermission((int) $account->id(), 'delete contact_information rdf entity')) {
        return AccessResult::allowed();
      }
    }
  }

  return AccessResult::neutral();
}

/**
 * Implements hook_entity_field_access().
 */
function contact_information_entity_field_access(string $operation, FieldDefinitionInterface $field_definition, AccountInterface $account, ?FieldItemListInterface $items = NULL): AccessResultInterface {
  if ($operation === 'view' && $field_definition->getName() === 'field_ci_email') {
    $confirmation = \Drupal::service('email_confirmer')->getConfirmation($items->value);
    $access = $confirmation && $confirmation->get('confirmed')->value == EmailConfirmationInterface::CONFIRMED ? AccessResult::allowed() : AccessResult::forbidden();
    /** @var \Drupal\contact_information\Entity\ContactInformationInterface $contact_info */
    $contact_info = $items->getEntity();
    return $access
      ->addCacheableDependency($contact_info)
      // Depend also on the group that attaches this contact information so that
      // this field access cache is invalidated together with the group cache.
      ->addCacheableDependency($contact_info->getRelatedGroup());
  }
  return AccessResult::neutral();
}

/**
 * Implements hook_ENTITY_TYPE_update().
 */
function contact_information_rdf_entity_update(RdfInterface $entity): void {
  if ($entity instanceof ContactInformationInterface) {
    /** @var \Drupal\contact_information\Entity\ContactInformationInterface|null $original */
    if ($original = $entity->original ?? NULL) {
      $original_email = $original->get('field_ci_email')->value;
      $email = $entity->get('field_ci_email')->value;
      if (!empty($original_email) && $original_email !== $email) {
        /** @var \Drupal\contact_information\ContactInformationEmailConfirmInterface $email_confirm */
        $email_confirm = \Drupal::service('contact_information.email_confirm');
        $email_confirm->deleteContactInfoConfirmation($original);
      }
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_delete().
 */
function contact_information_rdf_entity_delete(RdfInterface $contact_information) {
  if ($contact_information instanceof ContactInformationInterface) {
    /** @var \Drupal\contact_information\ContactInformationEmailConfirmInterface $email_confirm */
    $email_confirm = \Drupal::service('contact_information.email_confirm');
    $email_confirm->deleteContactInfoConfirmation($contact_information);
  }
}

/**
 * Implements hook_email_confirmer().
 */
function contact_information_email_confirmer(string $op, EmailConfirmationInterface $confirmation): void {
  if ($op === 'confirm' && $confirmation->getRealm() === ContactInformationEmailConfirmInterface::REALM) {
    /** @var \Drupal\contact_information\ContactInformationEmailConfirmInterface $email_confirm */
    $email_confirm = \Drupal::service('contact_information.email_confirm');
    if ($gids = $email_confirm->getGroupsUsingContactInfoWithEmail($confirmation->getEmail())) {
      if ($groups = \Drupal::entityTypeManager()->getStorage('rdf_entity')->loadMultiple($gids)) {
        // When an email is confirmed, invalidate the cache of groups where the
        // contact information entities with this email so that each group about
        // page will refresh from backend and will show the contact form link.
        foreach ($groups as $group) {
          Cache::invalidateTags($group->getCacheTagsToInvalidate());
        }
      }
    }
  }
}

/**
 * Implements hook_form_BASE_FORM_ID_alter().
 */
function contact_information_form_rdf_entity_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  /** @var \Drupal\Core\Entity\Display\EntityFormDisplayInterface $display */
  $display = $form_state->get('form_display');
  if (isset(JoinupGroupHelper::GROUP_BUNDLES[$display->getTargetBundle()]) && $display->getMode() === 'default') {
    $form['actions']['submit']['#submit'][] = 'contact_information_confirm_emails';
  }
}

/**
 * Confirms unconfirmed emails and shows a status message.
 *
 * @param array $form
 *   The form render array.
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 *   The form state object.
 */
function contact_information_confirm_emails(array &$form, FormStateInterface $form_state): void {
  /** @var \Drupal\contact_information\ContactInformationEmailConfirmInterface $email_confirm */
  $email_confirm = \Drupal::service('contact_information.email_confirm');

  // Send email confirmations only for those emails not confirmed yet. Finally,
  // $emails will contain only the addresses for which confirmations were sent.
  $emails = array_filter(
    $form_state->get('contact_information_emails') ?? [],
    function (string $email) use ($email_confirm): bool {
      return $email_confirm->confirmEmail($email);
    }
  );
  if ($emails) {
    // Make the list predictable.
    sort($emails);
    $message = new PluralTranslatableMarkup(
      count($emails),
      'A new confirmation message has been sent to @emails.',
      'New confirmation messages have been sent to @emails.',
      ['@emails' => implode(', ', $emails)]
    );
    \Drupal::messenger()->addStatus($message);
  }
}
