<?php

/**
 * @file
 * Hooks and custom functions of Joinup Slick module.
 */

declare(strict_types=1);

use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\Core\Field\FormatterInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\StringTranslation\TranslatableMarkup;
use Drupal\slick\Entity\SlickInterface;
use Drupal\slick\SlickManagerInterface;

/**
 * Implements hook_field_formatter_third_party_settings_form().
 */
function joinup_slick_field_formatter_third_party_settings_form(FormatterInterface $plugin, FieldDefinitionInterface $field_definition, string $view_mode, array $form, FormStateInterface $form_state) {
  $element = [];
  $field_definition->getFieldStorageDefinition()->getCardinality();
  $options = array_merge(
    ['' => 'Select'],
    array_map(
      fn (SlickInterface $slick): string|TranslatableMarkup => $slick->label(),
      \Drupal::entityTypeManager()->getStorage('slick')->loadMultiple()
    )
  );

  $element['preset'] = [
    '#type' => 'select',
    '#title' => t('Slick optionset'),
    '#options' => $options,
    '#default_value' => $plugin->getThirdPartySetting('joinup_slick', 'preset', ''),
  ];

  // @todo Add submit handler which keeps third party settings empty if no
  // optionset is selected.

  return $element;
}

/**
 * Implements hook_field_formatter_settings_summary_alter().
 */
function joinup_slick_field_formatter_settings_summary_alter(array &$summary) {
  if (!empty($variables['element']['#third_party_settings']['joinup_slick']['preset'])) {
    $optionsetId = $variables['element']['#third_party_settings']['joinup_slick']['preset'];
    $optionset = \Drupal::entityTypeManager()->getStorage('slick')->load($optionsetId);
    if ($optionset) {
      $summary[] = t('Slick carousel: %slick-optionset-label', [
        '%slick-optionset-label' => $optionset->label(),
      ]);
    }
  }
}

/**
 * Implements hook_preprocess_field().
 */
function joinup_slick_preprocess_field(array &$variables) {
  if (!empty($variables['element']['#third_party_settings']['joinup_slick']['preset'])) {
    $optionsetId = $variables['element']['#third_party_settings']['joinup_slick']['preset'];
    $slickManager = \Drupal::service('slick.manager');
    \assert($slickManager instanceof SlickManagerInterface);
    $optionset = \Drupal::entityTypeManager()->getStorage('slick')->load($optionsetId);

    if ($optionset) {
      $items = array_map(
        fn (array $item): array => ['slide' => $item['content']],
        $variables['items']
      );
      $build = $slickManager->build([
        'items' => $items,
        'optionset' => $optionset,
      ]);
      // @todo It seems it is possible to pass item attributes to slick__slide.
      $variables['items'] = [['content' => $build]];

      if (
        !empty($optionset->get('options')['settings']['variableWidth']) &&
        empty($optionset->get('options')['settings']['infinite'])
      ) {
        $variables['#attached']['library'][] = 'joinup_slick/slick-variable-width';
      }
    }
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for "slick".
 */
function joinup_slick_theme_suggestions_slick_alter(array &$suggestions, array $variables) {
  $optionset = $variables['element']['#optionset'];
  \assert($optionset instanceof SlickInterface);
  $suggestions[] = "slick__{$optionset->id()}";
}
