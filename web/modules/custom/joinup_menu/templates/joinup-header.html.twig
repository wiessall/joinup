{#
/**
 * @file
 * Renders the non-menu header navigation items.
 *
 * Emits the navbar <li> elements for the items that are not menus (search,
 * bookmarks and the anonymous sign in / get started / about us items). The
 * navbar and account menus are rendered by their own menu blocks; the wrapping
 * <header>/<ul> is provided by the header navigation region.
 *
 * Provided by \Drupal\joinup_menu\Plugin\Block\HeaderNavigationBlock.
 *
 * Available variables:
 * - items: The navbar items, in the BCL header format.
 * - search: The rendered search block, printed inside the search dropdown.
 */
#}
{% for item in items %}
  {% if item.breakpoint %}
    {% for link in item.links %}
      {% if not link.hide_on_desktop %}
        {% set desktop_li_classes = [
          'nav-item',
          item.breakpoint != 'all' ? 'd-none',
          item.breakpoint != 'all' ? 'd-' ~ item.breakpoint ~ '-inline-block' : 'd-inline-block',
          link.order ? 'order-' ~ link.order,
          link.in_active_trail ? 'is-active',
        ] %}
        <li{{ create_attribute().addClass(desktop_li_classes) }}>
          {% if link.link %}
            {% set attributes = create_attribute(link.attributes|default([])) %}
            {{ link(link.label, link.link, attributes.addClass(['nav-link', 'nav-link--underline', link.in_active_trail ? 'is-active'])) }}
          {% elseif link.popover %}
            <button
              id="{{ link.id }}"
              class="btn btn-light get-started__trigger"
              data-bs-toggle="dropdown"
              aria-expanded="false"
              type="button"
              data-bs-auto-close="outside"
            >
              {{ link.label }}
            </button>
            <div
              class="dropdown-menu get-started__menu pt-2 pb-3 px-3"
              aria-labelledby="{{ link.id }}"
              data-popper-placement="right"
            >
              <p class="mb-1"><a class="get-started__cta fw-bold" href="{{ link.popover.cta.link }}" {{ link.popover.cta.attributes }}>
                {{ link.popover.cta.text }}
                <svg class="bi icon--s ms-2">
                  <use xlink:href="{{ bcl_icon_path }}#arrow-right"></use>
                </svg>
              </a></p>
              <p class="get-started__description mb-0 fs-sm">{{ link.popover.description }}</p>
            </div>
          {% endif %}
        </li>
      {% endif %}
    {% endfor %}
  {% endif %}
  {% set list_item_attributes = create_attribute() %}
  {% set _list_item_classes = item.classes|default([])|merge(['nav-item', 'dropdown']) %}
  {% if item.breakpoint %}
    {% set _list_item_classes = _list_item_classes|merge(['d-' ~ item.breakpoint ~ '-none']) %}
  {% endif %}
  {% set list_item_attributes = list_item_attributes.addClass(_list_item_classes) %}
  {% if item.type == 'mmenu' %}
    <li {{ list_item_attributes.addClass('mmenu-nav') }}>
      <button
        id="{{ item.id }}"
        class="nav-link mmenu-nav__toggle"
        type="button"
        aria-label="{{ item.label }}"
      >
        <span class="visually-hidden">{{ item.label }}</span>
        {% if item.icon is not empty %}
          <svg class="bi icon--s">
            <use xlink:href="{{ bcl_icon_path }}#{{ item.icon.name }}"></use>
          </svg>
        {% endif %}
      </button>
      <div class="mmenu-nav__menu p-0 d-none" aria-labelledby="{{ item.id }}">
        <ul>
          {% for link in item.links %}
            {% if link.link %}
              <li {{ create_attribute({class: link.in_active_trail ? 'Selected'}) }}>
                {% set attributes = create_attribute(link.attributes|default([])) %}
                <a href="{{ link.link }}" {{ attributes.addClass(link.in_active_trail ? 'is-active') }}>
                  {{ link.label }}
                </a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    </li>
  {% elseif item.type == 'search' %}
    <li {{ list_item_attributes }}>
      <button
        id="{{ item.id }}"
        class="dropdown-toggle nav-link"
        data-bs-toggle="dropdown"
        aria-expanded="false"
        type="button"
        data-bs-auto-close="outside"
        aria-label="{{ item.label }}"
      >
        <span class="visually-hidden">{{ item.label }}</span>
        {% if item.icon is not empty %}
          <svg class="bi icon--s">
            <use xlink:href="{{ bcl_icon_path }}#{{ item.icon.name }}"></use>
          </svg>
        {% endif %}
      </button>
      <div id="dropdown-menu--search"
        class="dropdown-menu p-0"
        aria-labelledby="{{ item.id }}"
        data-popper-placement="right"
      >
        <div class="navbar-search p-2">
          {{ search }}
        </div>
      </div>
    </li>
  {% endif %}
{% endfor %}
