<?php

/**
 * @file
 * Install, update, and uninstall functions for the Publication date module.
 */

declare(strict_types=1);

use Drupal\Core\Field\BaseFieldDefinition;

/**
 * Implements hook_update_N().
 *
 * Add Publication date field to RDF entities.
 */
function joinup_publication_date_update_111001(&$sandbox): void {
  $field_storage_definition = BaseFieldDefinition::create('published_at')
    ->setName('published_at')
    ->setLabel(t('Published on'))
    ->setDescription(t('Keep the publication timestamp for each entity.'))
    ->setRevisionable(FALSE)
    ->setTranslatable(TRUE)
    ->setDisplayOptions('view', [
      'region' => 'hidden',
    ])
    ->setDisplayConfigurable('view', TRUE)
    ->setDisplayOptions('form', [
      'type' => 'publication_date_timestamp',
      'weight' => 10,
    ])
    ->setDisplayConfigurable('form', TRUE)
    ->setTargetEntityTypeId('rdf_entity');

  \Drupal::entityDefinitionUpdateManager()
    ->installFieldStorageDefinition('published_at', 'rdf_entity', 'published_date', $field_storage_definition);
}
