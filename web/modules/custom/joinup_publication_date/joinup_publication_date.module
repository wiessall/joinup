<?php

/**
 * @file
 * Hook implementations for the Joinup Publication Date module.
 */

declare(strict_types=1);

use Drupal\joinup_publication_date\Entity\EntityPublicationTimeInterface;
use Drupal\joinup_publication_date\Plugin\Field\FieldType\PublicationDateFieldItemList;
use Drupal\joinup_publication_date\Plugin\Field\FieldType\PublicationDateItem;

/**
 * Implements hook_preprocess_HOOK() for node templates.
 *
 * Exposes the publication date in various formats in node templates.
 */
function joinup_publication_date_preprocess_node(&$variables): void {
  $node = $variables['node'] ?? NULL;
  if ($node instanceof EntityPublicationTimeInterface) {
    $publication_time = $node->getPublicationTime();
    if ($publication_time) {
      foreach (['Y', 'M', 'j'] as $format) {
        $variables['publication_date'][$format] = date($format, $publication_time);
      }
    }
  }
}

/**
 * Implements hook_field_info_alter().
 */
function joinup_publication_date_field_info_alter(array &$info): void {
  if (isset($info['published_at'])) {
    $info['published_at']['class'] = PublicationDateItem::class;
    $info['published_at']['list_class'] = PublicationDateFieldItemList::class;
  }
}

/**
 * Implements hook_preprocess_page_title().
 */
function joinup_publication_date_preprocess_page_title(array &$variables): void {
  $entity = $variables['entity'] ?? NULL;

  if ($entity instanceof EntityPublicationTimeInterface) {
    joinup_publication_date_add_content_dates($entity, $variables);
  }
}

/**
 * Adds content dates.
 *
 * @param \Drupal\joinup_publication_date\Entity\EntityPublicationTimeInterface $entity
 *   Entity.
 * @param array $variables
 *   Render variables.
 */
function joinup_publication_date_add_content_dates(EntityPublicationTimeInterface $entity, array &$variables): void {
  $publicationTime = $entity->published_at?->published_at_or_created ?: $entity->getPublicationTime() ?: $entity->getChangedTime();

  /** @var \Drupal\Core\Datetime\DateFormatterInterface $date_formatter */
  $dateFormatter = \Drupal::service('date.formatter');
  $variables['additional_content']['published'] = $dateFormatter->format($publicationTime, 'date_only');
  $variables['additional_content']['updated'] = $dateFormatter->format($entity->getChangedTime(), 'date_only');
}
