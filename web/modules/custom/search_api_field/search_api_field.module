<?php

/**
 * @file
 * The entity hooks needed to display facets in pseudo-fields.
 */

declare(strict_types=1);

use Drupal\Component\Utility\Html;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\FieldableEntityInterface;
use Drupal\custom_page\Entity\CustomPageInterface;
use Drupal\field\Entity\FieldConfig;
use Drupal\joinup_group\Entity\GroupInterface;
use Drupal\paragraphs\ParagraphInterface;

/**
 * Implements hook_entity_extra_field_info().
 *
 * Create a pseudo field for each facet region.
 */
function search_api_field_entity_extra_field_info() {
  $map = \Drupal::service('entity_field.manager')->getFieldMapByFieldType('search_api_field');
  $extra = [];
  $ids = [];
  foreach ($map as $type => $info) {
    foreach ($info as $name => $data) {
      foreach ($data['bundles'] as $bundle_name) {
        $ids[] = "$type.$bundle_name.$name";
      }
    }
  }

  $fs = FieldConfig::loadMultiple($ids);
  /** @var \Drupal\field\Entity\FieldStorageConfig $field_config */
  foreach ($fs as $id => $field_config) {
    $facet_regions = $field_config->getSetting('facet_regions');
    if (!$facet_regions) {
      continue;
    }
    foreach ($facet_regions as $region_id => $region_label) {
      $name = str_replace('.', '_', "$id.$region_id");
      $extra[$field_config->getTargetEntityTypeId()][$field_config->get('bundle')]['display'][$name] = [
        'label' => t('Facet region: @region', ['@region' => $region_label]),
        'weight' => 0,
        'visible' => FALSE,
      ];
    }
  }

  return $extra;
}

/**
 * Implements hook_entity_view().
 *
 * Render the facets for each pseudo field enabled.
 */
function search_api_field_entity_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode) {
  if (!$entity instanceof FieldableEntityInterface) {
    return;
  }

  $facet_manager = \Drupal::getContainer()->get('facets.manager');
  /** @var \Drupal\Core\Entity\EntityStorageInterface $facet_storage */
  $facet_storage = \Drupal::getContainer()->get('entity_type.manager')->getStorage('facets_facet');
  foreach ($entity->getFieldDefinitions() as $field_name => $definition) {
    /** @var Drupal\field\FieldConfigInterface $definition */
    if ($definition->getType() != 'search_api_field') {
      continue;
    }

    // Load all the facets associated to this field that is acting as facet
    // source.
    $facets = $facet_storage->loadByProperties([
      'facet_source_id' => 'search_api_field:' . $definition->id(),
    ]);

    // At the moment we support only single-value fields.
    $settings_item = $entity->get($field_name)->first();
    if (empty($settings_item)) {
      continue;
    }
    $settings = $settings_item->value;

    // Do not render facets if the field is disabled.
    if (empty($settings['enabled'])) {
      continue;
    }

    if ($entity instanceof ParagraphInterface && _search_api_field_calculate_paragraphs_with_facets($entity) > 1) {
      // Do not render facets if the more than one paragraphs are shown with
      // facets.
      continue;
    }

    // Check number of archived items.
    if (isset($build['_layout_builder']) && count($build['_layout_builder']) > 1) {
      $archived_items = _search_api_field_find_archived($build['_layout_builder'], $field_name) ?? 0;
    }
    else {
      $archived_items = $build[$field_name]['#archived_items'] ?? 0;
    }

    // The facets available for the facet source offered by this field have been
    // organized into pseudo fields. Loop over the configuration to render them
    // in the correct place.
    $pseudo_fields = [];
    // @todo Fix this in ISAICP-7301
    if (isset($settings['fields'])) {
      foreach ($settings['fields'] as $facet_name => $facet_data) {
        // If the facet is not found between the ones provided by the facet
        // source, skip it.
        if (!isset($facets[$facet_name])) {
          continue;
        }
        $name = str_replace('.', '_', $definition->id() . '.' . $facet_data['region']);
        // Render the facet only if the pseudo field is enabled for this view
        // mode.
        if ($display->getComponent($name)) {
          if (
            !in_array($facet_name, [
              'field_collection_content_status',
              'field_is_content_status',
            ])
            || (
              !($entity instanceof GroupInterface && $entity->isArchived())
              && $settings['show_archived'] === 'all'
              && $archived_items
              && $archived_items > 0
            )
          ) {
            // Let the facet_manager build the facets.
            $build[$name][] = $facet_manager->build($facets[$facet_name]);
            // Keep track of created pseudo-fields so we can add wrappers later
            // on.
            $pseudo_fields[$name] = $facet_data['region'];
          }
        }
      }
    }

    foreach ($pseudo_fields as $name => $region_name) {
      // Wrap the facet region in a container.
      $build[$name] += [
        '#theme_wrappers' => [
          'container__facet_region__' . $region_name => [
            '#attributes' => [
              'class' => [
                'facet-region',
                'facet-region--' . Html::getClass($region_name),
              ],
            ],
            // Pass some information about the parent entity and field.
            '#entity' => $entity,
            '#field_name' => $field_name,
          ],
        ],
      ];
    }
  }
}

/**
 * Get number of archived items.
 *
 * @param array $data
 *   Build data.
 * @param string $field
 *   Machine name of the Search API field.
 *
 * @return int|null
 *   Number of archived items.
 */
function _search_api_field_find_archived(array $data, $field): ?int {
  foreach ($data as $key => $item) {
    if (!is_array($item)) {
      continue;
    }
    if (str_starts_with((string) $key, '#')) {
      continue;
    }

    if (isset($item['#archived_items']) && $item['#field_name'] === $field) {
      return (int) $item['#archived_items'];
    }

    $archivedItem = _search_api_field_find_archived($item, $field);
    if ($archivedItem) {
      return $archivedItem;
    }
  }

  return NULL;
}

/**
 * Calculates the number of paragraphs with facets of the parent of a paragraph.
 *
 * @param \Drupal\paragraphs\ParagraphInterface $entity
 *   The paragraph in question.
 *
 * @return int
 *   The number of paragraphs with facets.
 */
function _search_api_field_calculate_paragraphs_with_facets(ParagraphInterface $entity): int {
  while ($entity instanceof ParagraphInterface) {
    $entity = $entity->getParentEntity();
  }

  if (!$entity instanceof CustomPageInterface) {
    return 0;
  }

  $number_of_paragraphs_with_facets = 0;
  $custom_page_paragraphs = $entity->get('field_paragraphs_body')->referencedEntities();
  foreach ($custom_page_paragraphs as $custom_page_paragraph) {
    if ($custom_page_paragraph->bundle() !== 'content_listing') {
      continue;
    }
    $settings = $custom_page_paragraph->content_listing->value;
    if (!$settings['enabled']) {
      continue;
    }

    $number_of_paragraphs_with_facets++;
  }

  return $number_of_paragraphs_with_facets;
}

/**
 * Implements hook_theme().
 */
function search_api_field_theme() {
  $result_item_variables = [
    'variables' => [
      'value' => '',
      'show_count' => FALSE,
      'count' => NULL,
      'type' => NULL,
    ],
  ];

  return [
    'facets_type_wrapper' => [
      'variables' => [
        'items' => [],
        'attributes' => [],
      ],
    ],
    'facets_type_result_item' => $result_item_variables,
    'facets_type_result_item_active' => $result_item_variables,
    'search_api_field' => [
      'variables' => [
        'form' => NULL,
        'search_title' => NULL,
        'no_of_results' => NULL,
        'no_results_found' => NULL,
        'search_help' => NULL,
        'results' => NULL,
        'pager' => NULL,
        'entity_type' => NULL,
        'bundle' => NULL,
        'field_name' => NULL,
        'entity' => NULL,
        'view_mode' => NULL,
        'archived_items' => NULL,
      ],
    ],
    'search_api_field_result' => [
      'variables' => [
        'item' => NULL,
        'entity' => NULL,
      ],
    ],
  ];
}

/**
 * Implements hook_theme_suggestions_HOOK().
 *
 * Adds suggestions to the search_api_field theme hook.
 * Loosely based on the field theme suggestions.
 *
 * @see system_theme_suggestions_field()
 */
function search_api_field_theme_suggestions_search_api_field(array $variables) {
  $suggestions = [];

  $suggestions[] = 'search_api_field__' . $variables['field_name'];
  $suggestions[] = 'search_api_field__' . $variables['entity_type'] . '__' . $variables['field_name'];
  $suggestions[] = 'search_api_field__' . $variables['entity_type'] . '__' . $variables['field_name'] . '__' . $variables['bundle'];

  return $suggestions;
}
