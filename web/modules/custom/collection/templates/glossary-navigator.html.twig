{#
/**
 * @file
 * Default theme implementation to display a glossay navigator.
 *
 * Available variables:
 * - url: The glossary base URL.
 * - letters: An array of upercased letters, ordered alphabetically, repesenting
 *   the grouped list of all glossary terms first letter.
 * - current: The currently selected letter.
 */
#}

{% if letters|length > 1 %}
  <nav class="glossary-navigator">
    {% for letter in letters %}
      <a class="glossary-navigator-item{{ (letter|upper == current|upper) ? ' current' }}" href="{{ url }}/{{ letter|lower }}">{{ letter|upper }}</a>
    {% endfor %}
    {% if current != null %}
      <a class="glossary-navigator-item glossary-navigator-item-all" href="{{ url }}">{{ 'all'|trans }}</a>
    {% endif %}
  </nav>
{% endif %}
