{#
/**
 * @file
 * Default implementation of displaying a grid of lists.
 *
 * Available variables:
 * - items: A nested list of items. Each item contains:
 * -- title: The title of the parent.
 * -- class: The explicit parent class to pass to the list
 * -- children: A nested list of items. Each item contains:
 * --- data-joinup-licence-category: The licence category to pass to the data attribute data-joinup-licence-category.
 * --- title: The title of the child.
 * --- description: The description of the field to pass to the data attribute.
 */
#}
{% set button_attributes = create_attribute()
  .addClass(['licence-filter__button']) %}

<div class="listing listing-grid listing-grid--licence">
  {% for parent_item in items %}
    <div class="licence-filter {{ parent_item.class }}">
      <div class="licence-filter__header">
        {{ parent_item.title }}
      </div>
      <div class="licence-filter__content">
        <ul class="licence-filter__list">
          {% for child in parent_item.items %}
            <li class="licence-filter__item">
              <button{{ button_attributes.setAttribute('data-joinup-licence-category', child.licence_category)
                .setAttribute('title', child.description|striptags)
                .setAttribute('type', 'button') }}>
                {{ child.title }}
              </button>
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  {% endfor %}
</div>
