<?php

/**
 * @file
 * Main functions and hook implementations of the Licence module.
 */

declare(strict_types=1);

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Link;
use Drupal\Core\Session\AccountInterface;
use Drupal\Core\Url;
use Drupal\joinup_licence\Entity\Licence;
use Drupal\joinup_licence\Entity\LicenceInterface;
use Drupal\joinup_licence\Entity\LicenceLegalType;
use Drupal\joinup_licence\Entity\SpdxLicence;
use Drupal\joinup_taxonomy\Entity\MappedTerm;
use Drupal\node\NodeInterface;

/**
 * Implements hook_entity_bundle_field_info_alter().
 */
function joinup_licence_entity_bundle_field_info_alter(array &$fields, EntityTypeInterface $entity_type, string $bundle): void {
  if ($entity_type->id() !== 'node' || $bundle !== 'licence') {
    return;
  }

  // Licence labels and references to SPDX licences are unique.
  if (!empty($fields['title'])) {
    $fields['title']->addConstraint('UniqueFieldInBundle', ['bundles' => ['licence']]);
  }
  if (!empty($fields['spdx_licence'])) {
    $fields['spdx_licence']->addConstraint('UniqueFieldInBundle', ['bundles' => ['licence']]);
  }
}

/**
 * Implements hook_entity_bundle_info_alter().
 */
function joinup_licence_entity_bundle_info_alter(array &$bundles): void {
  $class_mapping = [
    'node' => [
      'licence' => Licence::class,
    ],
    'taxonomy_term' => [
      'legal_type' => LicenceLegalType::class,
      'licence_type' => MappedTerm::class,
      'spdx_licence' => SpdxLicence::class,
    ],
  ];
  foreach ($class_mapping as $entity_type_id => $bundle_mapping) {
    foreach ($bundle_mapping as $bundle => $class) {
      if (!empty($bundles[$entity_type_id][$bundle])) {
        $bundles[$entity_type_id][$bundle]['class'] = $class;
      }
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_access().
 */
function joinup_licence_taxonomy_term_access(EntityInterface $entity, string $operation, AccountInterface $account): AccessResultInterface {
  if ($entity instanceof MappedTerm && $entity->bundle() === 'spdx_licence' && $operation === 'view') {
    // Only deny access to the canonical route.
    $route_match = \Drupal::routeMatch();
    return AccessResult::forbiddenIf($route_match->getRouteName() === 'entity.taxonomy_term.canonical' && $route_match->getParameter('taxonomy_term')->bundle() === 'spdx_licence');
  }
  return AccessResult::neutral();
}

/**
 * Implements hook_entity_extra_field_info().
 *
 * @see joinup_licence_node_view()
 */
function joinup_licence_entity_extra_field_info(): array {
  $fields = [];

  $display = &$fields['node']['licence']['display'];
  $display['spdx_licence_label'] = [
    'label' => t('SPDX licence label'),
    'description' => t('The label of the licence in the SPDX licence list.'),
    'visible' => FALSE,
  ];
  $display['spdx_licence_id'] = [
    'label' => t('SPDX licence ID'),
    'description' => t('The ID of the licence in the SPDX licence list.'),
    'visible' => FALSE,
  ];
  $display['spdx_licence_text'] = [
    'label' => t('Licence text'),
    'visible' => FALSE,
  ];
  $display['spdx_licence_external_url'] = [
    'label' => t('Licence external URL'),
    'visible' => FALSE,
  ];
  $display['spdx_see_also'] = [
    'label' => t('See also'),
    'description' => t('Links to related licences according to SPDX.'),
    'visible' => FALSE,
  ];

  return $fields;
}

/**
 * Implements hook_ENTITY_TYPE_view().
 */
function joinup_licence_node_view(array &$build, NodeInterface $entity, EntityViewDisplayInterface $display, string $view_mode): void {
  if (!$entity instanceof LicenceInterface) {
    return;
  }

  // Exposes a number of fields from the SPDX Licence term on Licence node.
  if ($spdx_licence = $entity->getSpdxLicenceEntity()) {
    if ($display->getComponent('spdx_licence_label')) {
      $field_item_list = $spdx_licence->get('name');
      $build['spdx_licence_label'] = $field_item_list->view();
    }
    if ($display->getComponent('spdx_licence_external_url')) {
      $url = preg_replace('/(.*)\.html$/', '\1', $spdx_licence->getUri()) . '.html';
      $spdx_url = Url::fromUri($url, ['fragment' => 'licenseText']);
      $spdx_link = Link::fromTextAndUrl('Licence Text', $spdx_url);
      $build['spdx_licence_external_url'] = $spdx_link->toRenderable();
    }
    $fields = [
      'spdx_licence_id' => 'spdx_id',
      'spdx_licence_text' => 'description',
      'spdx_see_also' => 'see_also',
    ];
    foreach ($fields as $pseudo_field => $field) {
      if ($display->getComponent($pseudo_field)) {
        /** @var \Drupal\Core\Field\FieldItemListInterface $field_item_list */
        $field_item_list = $spdx_licence->get($field);
        if (!$field_item_list->isEmpty()) {
          $build[$pseudo_field] = $field_item_list->view();
        }
      }
    }
  }
}

/**
 * Implements hook_options_list_alter().
 */
function joinup_licence_options_list_alter(array &$options, array $context): void {
  /** @var \Drupal\field\FieldConfigInterface $field_definition */
  $field_definition = $context['fieldDefinition'];
  if (empty($options) || $field_definition->getName() !== 'field_licence') {
    return;
  }

  $default_value = (int) $context['entity']->licence->target_id;
  $licence_ids = array_keys($options);
  $licences = \Drupal::entityTypeManager()->getStorage('node')->loadMultiple($licence_ids);
  foreach ($licences as $licence_id => $licence) {
    $deprecated = (bool) $licence->get('deprecated')->value;
    if ($deprecated) {
      if ($licence_id === $default_value) {
        \Drupal::messenger()->addWarning(t('The referenced licence %licence_label is deprecated. You are advised to chose a different licence.', [
          '%licence_label' => $licence->label(),
        ]));
      }
      else {
        unset($options[$licence_id]);
      }
    }
  }
}

/**
 * Implements hook_theme().
 */
function joinup_licence_theme($existing, $type, $theme, $path) {
  return [
    'licence_filter_list' => [
      'variables' => ['items' => NULL],
      'path' => $path . '/templates/parts',
    ],
    'licence_filter_search_input' => [
      'variables' => [],
      'path' => $path . '/templates/parts',
    ],
    'licence_comparer_header_content' => [
      'variables' => [
        'spdx_id' => NULL,
        'title' => NULL,
        'description' => NULL,
        'url' => NULL,
        'first_header' => TRUE,
      ],
    ],
    'licence_comparer_cell_content' => [
      'variables' => [
        'spdx_id' => NULL,
        'legal_category' => NULL,
        'legal_type' => NULL,
        'checked' => FALSE,
      ],
    ],
  ];
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function joinup_licence_form_taxonomy_term_legal_type_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {

  $term = $form_state->getFormObject()->getEntity();
  if ($term instanceof LicenceLegalType) {
    if (!$term->isNew()) {
      $parent = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadParents($term->id());
      $parent = reset($parent);
      if (!$parent) {
        $form['name']['#disabled'] = TRUE;
      }
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_view_alter().
 */
function joinup_licence_node_view_alter(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display): void {
  if ($entity instanceof NodeInterface && $display->getMode() === 'compatibility_check') {
    // Hide contextual links for licence compatibility overview.
    unset($build['#contextual_links']);
  }
}
