<?php

/**
 * @file
 */

declare(strict_types=1);

/**
 * @file
 */

use Drupal\joinup_badge\Entity\CertificateInterface;

/**
 * Implements hook_preprocess_HOOK().
 */
function joinup_badge_preprocess_node__view_mode_tile(array &$variables): void {
  if (($certificate = $variables['elements']['#node']) instanceof CertificateInterface) {
    $url_generator = \Drupal::service('file_url_generator');
    $file = $url_generator->generateAbsoluteString($certificate->get('certificate')->entity?->getFileUri());
    $logo = $url_generator->generateAbsoluteString($certificate->get('course')->entity?->get('logo')->entity?->getFileUri());
    $variables['extra_data']['certificate']['file'] = $file;
    $variables['extra_data']['certificate']['logo'] = $logo;
  }
}
