<?php

function import_ird_jsons_node_view(array &$build, $node, $display, $view_mode) {
  if ($node->bundle() !== 'solution' || $view_mode !== 'full') {
    return;
  }

  $annotations = \Drupal::entityTypeManager()->getStorage('node')
    ->loadByProperties(['field_innovation' => $node->id()]);

  if (empty($annotations)) {
    return;
  }

  $skip = ['field_innovation', 'og_audience'];
  $rows = [];

  foreach ($annotations as $annotation) {
    $collection = $annotation->get('og_audience')->entity?->label()
               ?? $annotation->bundle();
    foreach ($annotation->getFields() as $name => $field) {
      if (!($field->getFieldDefinition() instanceof \Drupal\field\FieldConfigInterface)) {
        continue;
      }
      if (in_array($name, $skip, TRUE) || $field->isEmpty()) {
        continue;
      }
      $type = $field->getFieldDefinition()->getType();
      $values = [];
      foreach ($field as $item) {
        $values[] = match ($type) {
          'entity_reference' => $item->entity?->label() ?? '',
          'link'             => $item->uri ?? '',
          'boolean'          => $item->value ? 'Yes' : 'No',
          default            => (string) ($item->value ?? ''),
        };
      }
      $rows[] = [
        $collection,
        $field->getFieldDefinition()->getLabel(),
        implode(', ', array_filter($values)),
      ];
    }
  }

  if ($rows) {
    $build['ird_annotations'] = [
      '#theme'      => 'table',
      '#header'     => ['Collection', 'Annotation', 'Value'],
      '#rows'       => $rows,
      '#attributes' => ['class' => ['ird-annotation-table']],
      '#weight'     => 100,
    ];
  }
}
/**
 * Implements hook_views_data_alter().
 *
 * Patches two gaps that cause HandlerBase::getEntityType() to crash with
 * "Undefined array key 'relationship'" (line 829) → "Trying to access array
 * offset on null" → InvalidArgumentException: A valid cache entry key required.
 *
 * Crash chain in getEntityType():
 *   1. Checks $views_data->get('node_field_data')['table']['entity type'].
 *      On RDF-enhanced platforms (joinup_rdf / sti_rdf) this key can be absent
 *      because the node ViewsData is altered or replaced.
 *   2. Falls through to the relationship branch (~line 829):
 *        $base = $data[$relationship_field]['relationship']['base'];
 *      For programmatically-created fields (field_innovation is created by
 *      ird:annotate, not via UI), views_field_default_views_data() sometimes
 *      omits the 'relationship' sub-key from the target_id column entry.
 *      Accessing ['relationship'] on the missing key gives the PHP Warning;
 *      accessing ['base'] on the resulting null gives the second Warning; and
 *      finally $views_data->get(null) throws the InvalidArgumentException.
 *
 * Both fixes are strictly additive (only fill in missing data).
 */
function import_ird_jsons_views_data_alter(array &$data): void {

  // ---- Fix 1: node_field_data entity type ---------------------------------
  // Standard Drupal always sets this, but joinup_rdf / sti_rdf may remove it
  // when altering node storage to use a triple store for RDF export.
  // EntityField::getEntityType() must find 'node' here to return early and
  // never reach the relationship-traversal code below.
  if (isset($data['node_field_data']['table'])
    && empty($data['node_field_data']['table']['entity type'])
  ) {
    $data['node_field_data']['table']['entity type'] = 'node';
    $data['node_field_data']['table']['entity revision'] = FALSE;
  }

  // ---- Fix 2: field_innovation relationship entry --------------------------
  // Ensures the Views data for node__field_innovation.field_innovation_target_id
  // contains the 'relationship' key that getEntityType() traverses when it
  // cannot find the entity type from the base table (Fix 1 fallback).
  // views_field_default_views_data() should generate this automatically for
  // FieldStorageConfig entities, but for programmatically-provisioned fields
  // it is occasionally absent, especially on platforms with custom Views hooks.
  if (isset($data['node__field_innovation']['field_innovation_target_id'])
    && empty($data['node__field_innovation']['field_innovation_target_id']['relationship'])
  ) {
    $data['node__field_innovation']['field_innovation_target_id']['relationship'] = [
      'title'      => t('Solution node referenced by field_innovation'),
      'base'       => 'node_field_data',
      'base field' => 'nid',
      'id'         => 'standard',
      'label'      => t('Solution'),
    ];
  }
}

/*
* Implements entity_presave hook
* If no field_claimed_by is set, this will automatically look up the collection
* of the selected taxonomy
*/
function import_ird_jsons_entity_presave(\Drupal\Core\Entity\EntityInterface $entity): void {
  if ($entity->getEntityTypeId() !== 'paragraph' || $entity->bundle() !== 'claims') {
    return;
  }
  // Only auto-fill if not already set (allows explicit override).
  if (!$entity->get('field_claimed_by')->isEmpty()) {
    return;
  }
  $property_term = $entity->get('field_claim_property')->entity;
  if (!$property_term) {
    return;
  }
  // Traverse to the namespace parent term.
  $parents = \Drupal::entityTypeManager()
    ->getStorage('taxonomy_term')
    ->loadParents($property_term->id());
  $namespace_term = $parents ? reset($parents) : $property_term;

  if (!$namespace_term->get('field_collection')->isEmpty()) {
    $entity->set('field_claimed_by', $namespace_term->get('field_collection')->target_id);
  }
}


/**
 * Implements hook_theme().
 */
function import_ird_jsons_theme(): array {
  return [
    'hero_banner_block' => [
      'variables' => [
        'video_url' => NULL,
        'category' => NULL,
        'title' => NULL,
        'link_url' => NULL,
        'body' => NULL,
        'autoplay' => TRUE,
        'loop' => TRUE,
        'muted' => TRUE,
      ],
    ],
    'claim_facets_grouped' => [
      'variables' => [
        'sections' => [],
        'facet_id' => NULL,
        'active_count' => 0,
      ],
    ],
  ];
}