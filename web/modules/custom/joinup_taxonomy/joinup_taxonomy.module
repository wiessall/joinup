<?php

/**
 * @file
 * Hook implementations for Joinup taxonomy module.
 */

declare(strict_types=1);

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\joinup_taxonomy\Entity\MappedTerm;
use Drupal\joinup_workflow\EntityWorkflowStateInterface;
use Drupal\node\NodeInterface;
use Drupal\taxonomy\TermInterface;

/**
 * Implements hook_ENTITY_TYPE_access().
 */
function joinup_taxonomy_taxonomy_term_access(TermInterface $term, string $operation, AccountInterface $account): AccessResultInterface {
  if ($operation === 'view') {
    return AccessResult::neutral();
  }

  /** @var \Drupal\taxonomy\VocabularyInterface $vocabulary */
  $vocabulary = $term->get('vid')->entity;
  $locked = $vocabulary->getThirdPartySetting('joinup_taxonomy', 'locked', FALSE);
  return AccessResult::forbiddenIf($locked)->addCacheTags($vocabulary->getCacheTagsToInvalidate());
}

/**
 * Implements hook_ENTITY_TYPE_create_access().
 */
function joinup_taxonomy_taxonomy_term_create_access(AccountInterface $account, array $context, string $entity_bundle): AccessResultInterface {
  /** @var \Drupal\taxonomy\VocabularyInterface $vocabulary */
  $vocabulary = \Drupal::entityTypeManager()->getStorage('taxonomy_vocabulary')->load($entity_bundle);
  $locked = $vocabulary->getThirdPartySetting('joinup_taxonomy', 'locked', FALSE);
  return AccessResult::forbiddenIf($locked)->addCacheTags($vocabulary->getCacheTagsToInvalidate());
}

/**
 * Implements hook_entity_bundle_info_alter().
 */
function joinup_taxonomy_entity_bundle_info_alter(array &$bundles): void {
  if (!empty($bundles['taxonomy_term']['spatial'])) {
    $bundles['taxonomy_term']['spatial']['class'] = MappedTerm::class;
  }
}

/**
 * Implements hook_ENTITY_TYPE_presave().
 *
 * This hook will unpublish any keyword that is being created in a new
 * unpublished entity. It will also publish any keyword attached to an entity
 * that is being approved (published) for the first time.
 */
function joinup_taxonomy_node_presave(NodeInterface $entity): void {
  if (!$entity instanceof EntityWorkflowStateInterface || !$entity->hasField('keywords')) {
    return;
  }

  // Because this will run before the generic \joinup_workflow_entity_presave
  // hook, we need to get the publication status from the target state instead.
  $workflow_helper = \Drupal::service('joinup_workflow.workflow_helper');
  $workflow = $entity->getWorkflow();
  $state_id = $entity->getWorkflowState();
  $is_published = $workflow_helper->isWorkflowStatePublished($state_id, $workflow);

  if ($entity->isNew() && !$is_published) {
    $keywords = $entity->get('keywords')->referencedEntities();
    foreach ($keywords as $keyword) {
      // @todo If the keyword is already published by another entity, we should
      //   not unpublish it here. How to check this? Maybe clean up the
      //   keywords on entity delete when there are no other references?
      if ($keyword instanceof TermInterface && $keyword->isPublished()) {
        $keyword->setUnpublished();
        $keyword->save();
      }
    }
  }
  elseif ($is_published && $entity->original->get('published_at')->isEmpty()) {
    // If the entity is being approved for the first time, publish the keywords.
    $keywords = $entity->get('keywords')->referencedEntities();
    foreach ($keywords as $keyword) {
      // Check if the keyword is already published in order to avoid an extra
      // save operation.
      if ($keyword instanceof TermInterface && !$keyword->isPublished()) {
        $keyword->setPublished();
        $keyword->save();
      }
    }
  }
}
