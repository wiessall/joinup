<?php

/**
 * @file
 * Install, update, install functionality for Joinup API module.
 */

declare(strict_types=1);

use Drupal\Core\File\FileSystemInterface;

/**
 * Implements hook_install().
 */
function joinup_api_install(): void {
  $fileSystem = \Drupal::service('file_system');
  $directory = 'private://simple_oauth';
  $fileSystem->prepareDirectory($directory, FileSystemInterface::CREATE_DIRECTORY | FileSystemInterface::MODIFY_PERMISSIONS);
  $keygen = \Drupal::service('simple_oauth.key.generator');
  $keygen->generateKeys($fileSystem->realpath($directory));
}

/**
 * Cleanup comment REST demo.
 */
function joinup_api_update_200800(): void {
  // The webform_update_8648 updates roles with a given permission. The
  // developer role, being an admin, has all permissions so it tries to grant
  // them a new permission. This triggers a series of events that collects all
  // permissions according to all providers, one of which is the rest module.
  // The removed discussion_comment REST resource is still registered there
  // during the update process, causing a plugin not found exception, as the
  // class does not exist yet. To avoid this, we delete the configuration here
  // before  the rest module collects permissions.
  \Drupal::configFactory()->getEditable('rest.resource.discussion_comment')->delete();

  // Delete testing OAuth2 client requests and clients.
  $storage = \Drupal::entityTypeManager()->getStorage('oauth_client_request');
  $ids = $storage->getQuery()->accessCheck(FALSE)->execute();
  if ($ids) {
    $storage->delete($storage->loadMultiple($ids));
  }
}

/**
 * Implements hook_update_dependencies().
 */
function joinup_api_update_dependencies(): array {
  return [
    'webform' => [
      8648 => ['joinup_api' => 200800],
    ],
  ];
}

/**
 * Implements hook_requirements().
 */
function joinup_api_requirements($phase): array {
  $requirements = [];

  if ($phase !== 'runtime') {
    return $requirements;
  }

  $config = \Drupal::config('simple_oauth.settings');
  $privateKey = $config->get('private_key');
  $publicKey = $config->get('public_key');

  $requirements['simple_oauth_keys'] = [
    'title' => t('Simple OAuth keys'),
    'value' => t('OK'),
    'description' => t('Both private and public keys are present.'),
    'severity' => REQUIREMENT_OK,
  ];

  if (empty($privateKey)) {
    $requirements['simple_oauth_keys'] = [
      'title' => t('Simple OAuth private key'),
      'value' => t('Not configured'),
      'description' => t('The private key path is not configured.'),
      'severity' => REQUIREMENT_ERROR,
    ];
    return $requirements;
  }

  if (empty($publicKey)) {
    $requirements['simple_oauth_keys'] = [
      'title' => t('Simple OAuth public key'),
      'value' => t('Not configured'),
      'description' => t('The public key path is not configured.'),
      'severity' => REQUIREMENT_ERROR,
    ];
    return $requirements;
  }

  $fileSystem = \Drupal::service('file_system');
  $privateKeyPath = $fileSystem->realpath($privateKey);
  $publicKeyPath = $fileSystem->realpath($publicKey);

  if (!$privateKeyPath) {
    $requirements['simple_oauth_keys'] = [
      'title' => t('Simple OAuth private key'),
      'value' => t('Missing'),
      'description' => t('The private key does not exist at @path.', ['@path' => $privateKey]),
      'severity' => REQUIREMENT_ERROR,
    ];
    return $requirements;
  }

  if (!$publicKeyPath) {
    $requirements['simple_oauth_keys'] = [
      'title' => t('Simple OAuth public key'),
      'value' => t('Missing'),
      'description' => t('The public key does not exist at @path.', ['@path' => $publicKey]),
      'severity' => REQUIREMENT_ERROR,
    ];
    return $requirements;
  }

  return $requirements;
}
