<?php

/**
 * @file
 * Hook implementations for the Joinup API module.
 */

declare(strict_types=1);

use Drupal\joinup_notification\MailContentTypeHeader;
use Drupal\oauth_client\Entity\NotificationType;

/**
 * Implements hook_local_tasks_alter().
 */
function joinup_api_local_tasks_alter(array &$local_tasks): void {
  // We remove following local tasks to avoid 2 active links at the same time.
  unset($local_tasks['oauth_client.user.oauth']);
  unset($local_tasks['oauth_client.user.oauth_client_request']);
}

/**
 * Implements hook_mail_alter().
 */
function joinup_api_mail_alter(array &$message): void {
  if ($message['module'] !== 'oauth_client') {
    return;
  }

  if (!NotificationType::tryFrom($message['key'])) {
    return;
  }

  // Convert body to HTML paragraphs and set HTML content type.
  if (!empty($message['body'])) {
    $message['body'] = array_map('_filter_autop', $message['body']);
  }
  $message['headers']['Content-Type'] = MailContentTypeHeader::TextHtml->value;
}
