<?php

/**
 * @file
 * Install, update, uninstall hooks for joinup_test_content module.
 */

declare(strict_types=1);

use Drupal\joinup_test_content\DefaultContentManager;
use Drupal\paragraphs\Entity\Paragraph;

/**
 * Implements hook_install().
 */
function joinup_test_content_install(): void {
  // Add paragraphs to the eGov topic meta entity, mirroring the production
  // topic page structure (layout + configurable listings).
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $terms = $term_storage->loadByProperties([
    'uuid' => 'ee3076fa-ee59-41b8-997e-b8e0fab5559f',
  ]);
  if (!$term = reset($terms)) {
    return;
  }
  $storage = \Drupal::entityTypeManager()->getStorage('meta_entity');
  $entities = $storage->loadByProperties([
    'type' => 'topic',
    'target' => $term->id(),
  ]);
  if (!$entity = reset($entities)) {
    return;
  }

  $topic_name = $term->label();
  $field = $entity->get('topics_paragraph');

  // Layout 1 (one-column): Featured Content grid.
  $layout1 = Paragraph::create(['type' => 'layout', 'status' => TRUE]);
  $layout1->setBehaviorSettings('layout_paragraphs', ['layout' => 'layout_onecol', 'config' => ['label' => '']]);
  $layout1->save();
  $field->appendItem($layout1);

  $featured = Paragraph::create([
    'type' => 'configurable_listing',
    'status' => TRUE,
    'paragraph_heading' => 'Featured Content',
    'list_style' => 'grid',
    'content_listing' => [
      'value' => [
        'enabled' => 1,
        'query_presets' => '',
        'limit' => 6,
        'global_search' => FALSE,
        'show_shared' => FALSE,
      ],
    ],
  ]);
  $featured->setBehaviorSettings('layout_paragraphs', ['parent_uuid' => $layout1->uuid(), 'region' => 'content']);
  $featured->save();
  $field->appendItem($featured);

  // Layout 2 (two-column): In the spotlight + Latest News.
  $layout2 = Paragraph::create(['type' => 'layout', 'status' => TRUE]);
  $layout2->setBehaviorSettings('layout_paragraphs', ['layout' => 'layout_twocol_section', 'config' => ['label' => '']]);
  $layout2->save();
  $field->appendItem($layout2);

  $spotlight = Paragraph::create([
    'type' => 'configurable_listing',
    'status' => TRUE,
    'paragraph_heading' => 'In the spotlight',
    'list_style' => 'list',
    'content_listing' => [
      'value' => [
        'enabled' => 1,
        'query_presets' => '',
        'limit' => 3,
        'global_search' => FALSE,
        'show_shared' => FALSE,
      ],
    ],
  ]);
  $spotlight->setBehaviorSettings('layout_paragraphs', ['parent_uuid' => $layout2->uuid(), 'region' => 'first']);
  $spotlight->save();
  $field->appendItem($spotlight);

  $news = Paragraph::create([
    'type' => 'configurable_listing',
    'status' => TRUE,
    'paragraph_heading' => 'Latest News',
    'list_style' => 'list',
    'content_listing' => [
      'value' => [
        'enabled' => 1,
        'query_presets' => "entity_bundle|news|IN\ntopic|$topic_name|IN",
        'limit' => 3,
        'global_search' => FALSE,
        'show_shared' => FALSE,
      ],
    ],
  ]);
  $news->setBehaviorSettings('layout_paragraphs', ['parent_uuid' => $layout2->uuid(), 'region' => 'second']);
  $news->save();
  $field->appendItem($news);

  $entity->save();
}

/**
 * Implements hook_uninstall().
 */
function joinup_test_content_uninstall(): void {
  // Remove the configurable listing paragraph from the eGov topic meta entity.
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $terms = $term_storage->loadByProperties([
    'uuid' => 'ee3076fa-ee59-41b8-997e-b8e0fab5559f',
  ]);
  if ($term = reset($terms)) {
    $storage = \Drupal::entityTypeManager()->getStorage('meta_entity');
    $entities = $storage->loadByProperties([
      'type' => 'topic',
      'target' => $term->id(),
    ]);
  }
  if (!empty($entities) && $entity = reset($entities)) {
    $paragraphs = $entity->get('topics_paragraph');
    $to_remove = [];
    foreach ($paragraphs as $delta => $item) {
      if ($item->entity && in_array($item->entity->bundle(), ['configurable_listing', 'layout'], TRUE)) {
        $to_remove[] = $delta;
      }
    }
    // Remove in reverse order to preserve deltas.
    foreach (array_reverse($to_remove) as $delta) {
      $paragraphs->get($delta)->entity->delete();
      $paragraphs->removeItem($delta);
    }
    $entity->save();
  }

  /** @var \Drupal\joinup_test_content\DefaultContentManager $service */
  $service = \Drupal::service(DefaultContentManager::class);
  $service->deleteDefaultContent('joinup_test_content');
}
