<?php

/**
 * @file
 * Hook implementations for Joinup Test module.
 */

declare(strict_types=1);

use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Entity\EntityInterface;
use Drupal\collection\Entity\CollectionInterface;
use Drupal\joinup_collection\JoinupCollectionHelper;
use Joinup\EnvironmentDetector;
use Joinup\TestMode;
use Joinup\TestModeManager;

/**
 * Implements hook_page_attachments().
 */
function joinup_test_page_attachments(array &$attachments): void {
  // Add cache metadata for test_mode.
  $settings = \Drupal::config(TestModeManager::CONFIG_NAME);
  CacheableMetadata::createFromRenderArray($attachments)
    ->addCacheableDependency($settings)
    ->applyTo($attachments);

  if (TestModeManager::current() === TestMode::Behat) {
    // Attach JS errors collector and disable CSS animations.
    $attachments['#attached']['library'][] = 'joinup_test/testing.js_errors_log';
    $attachments['#attached']['library'][] = 'joinup_test/testing.css_disable_transitions';
  }
}

/**
 * Implements hook_preprocess_HOOK() for image.
 */
function joinup_test_preprocess_image(&$variables): void {
  // Force eager loading of images during tests to avoid flaky behavior.
  if (TestModeManager::isActive()) {
    $variables['attributes']['loading'] = 'eager';
  }
}

/**
 * Implements hook_js_settings_alter().
 */
function joinup_test_js_settings_alter(&$settings): void {
  // Output JS deprecation warnings.
  $settings['suppressDeprecationErrors'] = FALSE;
}

/**
 * Implements hook_honeypot_form_protections_alter().
 */
function joinup_test_honeypot_form_protections_alter(array &$options, array $form): void {
  // Disable Honeypot entirely if form_settings is empty, used in behat.
  /* @see \Drupal\joinup\Traits\AntispamTrait::disableAntispamBeforeScenarioStarts */
  $honeypot_settings = \Drupal::config('honeypot.settings');
  if (!$honeypot_settings->get('form_settings')) {
    $options = [];
  }
}

/**
 * Implements hook_ENTITY_TYPE_presave().
 */
function joinup_test_node_presave(EntityInterface $entity): void {
  if (!$entity instanceof CollectionInterface) {
    return;
  }

  if ($entity->isNew() || $entity->getUri() !== JoinupCollectionHelper::JOINUP_COLLECTION_URI) {
    return;
  }

  // Ensure the changed date does not change. This mainly reverts the change
  // done by `\collection_node_delete()` for the Joinup test collection so that
  // tests can be predictable.
  // @see \collection_node_delete().
  if ($changedTime = $entity->getOriginal()?->getChangedTime()) {
    $entity->setChangedTime($changedTime);
  }
}

/**
 * Implements hook_autologout_prevent().
 */
function joinup_test_autologout_prevent(): bool {
  // Joinup test is only enabled on local environments. Prevent autologout from
  // logging out users on local environments by blocking the JS refresh from
  // being attached.
  return EnvironmentDetector::isLocal();
}
