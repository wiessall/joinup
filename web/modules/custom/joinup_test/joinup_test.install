<?php

/**
 * @file
 * Install, update and uninstall hooks for Joinup Test module.
 */

declare(strict_types=1);

use Drupal\Component\Serialization\Yaml;
use Drupal\Core\Field\Plugin\Field\FieldType\EntityReferenceItemInterface;
use Drupal\taxonomy\TermInterface;
use Drupal\text\Plugin\Field\FieldType\TextItemBase;

/**
 * Implements hook_install().
 */
function joinup_test_install($is_syncing): void {
  $rdfSync = \Drupal::getContainer()->get('rdf_sync.synchronizer');
  $fieldManager = \Drupal::getContainer()->get('entity_field.manager');
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');

  // Creates a term given term data from YAML file.
  $createTerm = function (string $vid, int $weight, array $data, array $definitions, int $parentTermId = 0) use ($storage): TermInterface {
    $values = ['vid' => $vid, 'weight' => $weight, 'parent' => $parentTermId];
    foreach ($data as $fieldName => $fieldValue) {
      if (isset($definitions[$fieldName])) {
        if (is_a($definitions[$fieldName]->getItemDefinition()->getClass(), EntityReferenceItemInterface::class, TRUE)) {
          // Reference to other entity should be always represented as URI.
          assert((bool) filter_var($fieldValue, FILTER_VALIDATE_URL));
          $values[$fieldName] = \Drupal::getContainer()->get('rdf_sync.mapper')->getEntityByUri($fieldValue);
        }
        else {
          if (is_a($definitions[$fieldName]->getItemDefinition()->getClass(), TextItemBase::class, TRUE)) {
            $fieldValue = ['value' => $fieldValue, 'format' => 'content_editor'];
          }
          $values[$fieldName] = $fieldValue;
        }
      }
    }
    /** @var \Drupal\taxonomy\TermInterface $term */
    $term = $storage->create($values);
    $term->save();

    return $term;
  };

  // Create the testing taxonomy terms. Limitation: It creates terms with
  // maximum 2 level hierarchy.
  $hierarchy = Yaml::decode(file_get_contents(__DIR__ . '/fixtures/testing_terms.yml'));

  $termIds = [];
  foreach ($hierarchy as $vid => $terms) {
    $hasTerms = (bool) $storage->getQuery()->accessCheck(FALSE)
      ->condition('vid', $vid)
      ->count()
      ->execute();
    if ($hasTerms) {
      // On rebuild terms are already populated from the database dump.
      continue;
    }

    foreach ($terms as $parentWeight => $data) {
      $definitions = $fieldManager->getFieldDefinitions('taxonomy_term', $vid);
      $term = $createTerm($vid, $parentWeight, $data, $definitions);
      $parentTermId = (int) $term->id();
      $termIds[] = $parentTermId;
      foreach ($data['children'] ?? [] as $childWeight => $child) {
        $term = $createTerm($vid, $childWeight, $child, $definitions, $parentTermId);
        $termIds[] = (int) $term->id();
      }
      $rdfSync->destruct();
    }
  }

  // Keep track of created terms.
  \Drupal::state()->set('joinup_test.testing_terms', $termIds);
}

/**
 * Implements hook_uninstall().
 */
function joinup_test_uninstall($is_syncing): void {
  $state = \Drupal::state();
  // Remove testing terms.
  if ($tids = $state->get('joinup_test.testing_terms', [])) {
    $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
    $storage->delete($storage->loadMultiple($tids));
  }
  $state->delete('joinup_test.testing_terms');
  \Drupal::getContainer()->get('rdf_sync.synchronizer')->destruct();
}
