<?php

/**
 * @file
 * Install, update and uninstall hooks for Joinup Test module.
 */

declare(strict_types=1);

use Drupal\Component\Serialization\Yaml;
use Drupal\Core\Field\Plugin\Field\FieldType\EntityReferenceItemInterface;
use Drupal\joinup_collection\JoinupCollectionHelper;
use Drupal\taxonomy\TermInterface;
use Drupal\text\Plugin\Field\FieldType\TextItemBase;

/**
 * Implements hook_install().
 */
function joinup_test_install($is_syncing): void {
  $rdfSync = \Drupal::getContainer()->get('rdf_sync.synchronizer');
  $fieldManager = \Drupal::getContainer()->get('entity_field.manager');
  $entityTypeManager = \Drupal::entityTypeManager();
  $termStorage = $entityTypeManager->getStorage('taxonomy_term');

  // Creates a term given term data from YAML file.
  $createTerm = function (string $vid, int $weight, array $data, array $definitions, int $parentTermId = 0) use ($termStorage): TermInterface {
    $values = ['vid' => $vid, 'weight' => $weight, 'parent' => $parentTermId];
    foreach ($data as $fieldName => $fieldValue) {
      if (isset($definitions[$fieldName])) {
        if (is_a($definitions[$fieldName]->getItemDefinition()->getClass(), EntityReferenceItemInterface::class, TRUE)) {
          // Reference to other entity should be always represented as URI.
          assert((bool) filter_var($fieldValue, FILTER_VALIDATE_URL));
          $values[$fieldName] = \Drupal::getContainer()->get('rdf_sync.mapper')->getEntityByUri($fieldValue);
        }
        else {
          if (is_a($definitions[$fieldName]->getItemDefinition()->getClass(), TextItemBase::class, TRUE)) {
            $fieldValue = ['value' => $fieldValue, 'format' => 'content_editor'];
          }
          $values[$fieldName] = $fieldValue;
        }
      }
    }
    /** @var \Drupal\taxonomy\TermInterface $term */
    $term = $termStorage->create($values);
    $term->save();

    return $term;
  };

  // Create the testing taxonomy terms. Limitation: It creates terms with
  // maximum 2 level hierarchy.
  $hierarchy = Yaml::decode(file_get_contents(__DIR__ . '/fixtures/testing_terms.yml'));

  $termIds = [];
  foreach ($hierarchy as $vid => $terms) {
    $hasTerms = (bool) $termStorage->getQuery()->accessCheck(FALSE)
      ->condition('vid', $vid)
      ->count()
      ->execute();
    if ($hasTerms) {
      // On rebuild terms are already populated from the database dump.
      continue;
    }

    foreach ($terms as $parentWeight => $data) {
      $definitions = $fieldManager->getFieldDefinitions('taxonomy_term', $vid);
      $term = $createTerm($vid, $parentWeight, $data, $definitions);
      $parentTermId = (int) $term->id();
      $termIds[] = $parentTermId;
      foreach ($data['children'] ?? [] as $childWeight => $child) {
        $term = $createTerm($vid, $childWeight, $child, $definitions, $parentTermId);
        $termIds[] = (int) $term->id();
      }
      $rdfSync->destruct();
    }
  }

  // Keep track of created terms.
  \Drupal::state()->set('joinup_test.testing_terms', $termIds);

  // Create the Joinup collection on clean installation.
  $nodeStorage = $entityTypeManager->getStorage('node');
  $mapper = \Drupal::getContainer()->get('rdf_sync.mapper');
  if (!$mapper->getEntityByUri(JoinupCollectionHelper::JOINUP_COLLECTION_URI)) {
    $collection = $nodeStorage->create([
      'type' => 'collection',
      'uri' => JoinupCollectionHelper::JOINUP_COLLECTION_URI,
      'title' => 'Joinup',
      'field_state' => 'published',
      'field_topic' => $mapper->getEntityByUri('http://joinup.eu/ontology/topic#demography'),
      'created' => strtotime('2015-01-01 08:00'),
      'changed' => strtotime('2015-01-01 08:00'),
      'description' => [
        'value' => 'Joinup is a collaborative platform created by the European Commission and funded by the European Union via the ISA² Programme. It offers several services that aim to help e-Government professionals share their experience with each other. The platform is also a repository of e-Government solutions, case studies, reusable software and components, and best practices. Joinup is a key initiative of the European Commission’s ISA² Programme, which is part of the EU’s policy to create a Digital Single Market.',
        'format' => 'content_editor',
      ],
      'owner' => $nodeStorage->create([
        'type' => 'contact_information',
        'title' => 'Contact name',
        'email' => 'contact.email@example.com',
      ]),
      'contact' => $nodeStorage->create([
        'type' => 'owner',
        'title' => 'ISA²',
      ]),

    ]);
    $collection->save();
    \Drupal::state()->set('joinup_test.joinup_collection.created', TRUE);

    // Index the collection.
    \Drupal::moduleHandler()->loadInclude('search_api', 'module', 'search_api.module');
    search_api_entity_update($collection);
  }
}

/**
 * Implements hook_uninstall().
 */
function joinup_test_uninstall($is_syncing): void {
  $state = \Drupal::state();

  // Remove testing terms.
  if ($tids = $state->get('joinup_test.testing_terms', [])) {
    $termStorage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
    $termStorage->delete($termStorage->loadMultiple($tids));
  }
  $state->delete('joinup_test.testing_terms');

  // Delete the Joinup collection only if it has been created on clean.
  if ($state->get('joinup_test.joinup_collection.created', FALSE)) {
    $mapper = \Drupal::getContainer()->get('rdf_sync.mapper');
    if ($joinupCollection = $mapper->getEntityByUri(JoinupCollectionHelper::JOINUP_COLLECTION_URI)) {
      $joinupCollection->get('contact')->entity->delete();
      $joinupCollection->get('owner')->entity->delete();
      $joinupCollection->delete();
    }
  }
  $state->delete('joinup_test.joinup_collection.created');

  \Drupal::getContainer()->get('rdf_sync.synchronizer')->destruct();
}
