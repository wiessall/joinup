<?php

/**
 * @file
 * Install, update and uninstall hooks for Joinup Test module.
 */

declare(strict_types=1);

use Drupal\Component\Serialization\Yaml;

/**
 * Implements hook_install().
 */
function joinup_test_install($is_syncing): void {
  $rdfSync = \Drupal::getContainer()->get('rdf_sync.synchronizer');

  // Create the testing taxonomy terms. Limitation: It creates terms with
  // maximum 2 level hierarchy.
  $hierarchy = Yaml::decode(file_get_contents(__DIR__ . '/fixtures/testing_terms.yml'));
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');

  $termIds = [];
  foreach ($hierarchy as $vid => $terms) {
    $hasTerms = (bool) $storage->getQuery()->accessCheck(FALSE)
      ->condition('vid', $vid)
      ->count()
      ->execute();
    if ($hasTerms) {
      // On rebuild terms are already populated from the database dump.
      continue;
    }

    foreach ($terms as $parentWeight => $data) {
      $term = $storage->create([
        'vid' => $vid,
        'name' => $data['name'],
        'weight' => $parentWeight,
      ]);
      foreach (['uri', 'description', 'mime_type'] as $key) {
        if (isset($data[$key])) {
          $term->set($key, $data[$key]);
        }
      }

      if (isset($data['eif_related_term'])) {
        $related_term = \Drupal::getContainer()->get('rdf_sync.mapper')->getEntityByUri($data['eif_related_term']);
        $term->set('field_eif_related_term', $related_term->id());
      }
      $term->save();
      $parentTermId = $term->id();
      $termIds[] = $parentTermId;
      foreach ($data['children'] ?? [] as $childWeight => $child) {
        $term = $storage->create([
          'vid' => $vid,
          'name' => $child['name'],
          'parent' => $parentTermId,
          'weight' => $childWeight,
          'description' => $child['description'] ?? '',
        ]);
        if (isset($child['uri'])) {
          $term->set('uri', $child['uri']);
        }
        $term->save();
        $termIds[] = $term->id();
        $rdfSync->destruct();
      }
    }
  }

  // Keep track of created terms.
  \Drupal::state()->set('joinup_test.testing_terms', $termIds);
}

/**
 * Implements hook_uninstall().
 */
function joinup_test_uninstall($is_syncing): void {
  $state = \Drupal::state();
  // Remove testing terms.
  if ($tids = $state->get('joinup_test.testing_terms', [])) {
    $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
    $storage->delete($storage->loadMultiple($tids));
  }
  $state->delete('joinup_test.testing_terms');
}
