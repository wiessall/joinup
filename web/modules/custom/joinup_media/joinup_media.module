<?php

/**
 * @file
 * Hook implementations for Joinup Media module.
 */

declare(strict_types=1);

use Drupal\Core\Form\FormStateInterface;
use Drupal\joinup_media\JoinupMediaLibrary;
use Drupal\og\OgGroupAudienceHelperInterface;

/**
 * Implements hook_field_widget_info_alter().
 */
function joinup_media_field_widget_info_alter(array &$info): void {
  if (isset($info['og_autocomplete'])) {
    // Use a simple 'OG autocomplete' for setting the group in the group-aware
    // media standard edit form.
    $info['og_autocomplete']['field_types'][] = 'og_standard_reference';
  }
}

/**
 * Implements hook_form_BASE_FORM_ID_alter().
 */
function joinup_media_form_media_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  // Hide revision information.
  unset($form['revision_log_message']);
  unset($form['revision_information']);
  unset($form['revision']);
}

/**
 * Implements hook_ckeditor5_plugin_info_alter().
 */
function joinup_media_ckeditor5_plugin_info_alter(array &$definitions): void {
  if (isset($definitions['media_library_mediaLibrary'])) {
    /** @var \Drupal\ckeditor5\Plugin\CKEditor5PluginDefinition[] $definitions */
    $definitions['media_library_mediaLibrary']->setClass(JoinupMediaLibrary::class);
  }
}

/**
 * Implements hook_form_BASE_FORM_ID_alter().
 */
function joinup_media_form_media_library_add_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  // Prepend an additional submit callback to act before ::submitForm().
  array_unshift($form['#submit'], 'joinup_media_set_media_group');
}

/**
 * Adds the OG group ID to media entities.
 *
 * @param array $form
 *   The form render array.
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 *   The form state object.
 */
function joinup_media_set_media_group(array $form, FormStateInterface $form_state): void {
  $media_items = $form_state->get('media') ?: [];
  /** @var \Drupal\media_library\MediaLibraryState $media_library_state */
  $media_library_state = $form_state->get('media_library_state');
  $group_id = $media_library_state->getOpenerParameters()['group_id'] ?? NULL;
  if ($group_id) {
    /** @var \Drupal\media\MediaInterface $media */
    foreach ($media_items as $media) {
      if ($media->hasField(OgGroupAudienceHelperInterface::DEFAULT_FIELD)) {
        $media->set(OgGroupAudienceHelperInterface::DEFAULT_FIELD, $group_id);
      }
    }
  }
}
