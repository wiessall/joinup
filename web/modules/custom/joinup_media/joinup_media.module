<?php

/**
 * @file
 * Hook implementations for Joinup Media module.
 */

declare(strict_types = 1);

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_field_widget_info_alter().
 */
function joinup_media_field_widget_info_alter(array &$info): void {
  if (isset($info['og_autocomplete'])) {
    // Use a simple 'OG autocomplete' for setting the group in the group-aware
    // media standard edit form.
    $info['og_autocomplete']['field_types'][] = 'og_standard_reference';
  }
}

/**
 * Implements hook_form_BASE_FORM_ID_alter().
 */
function joinup_media_form_media_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  // Hide revision information.
  unset($form['revision_log_message']);
  unset($form['revision_information']);
  unset($form['revision']);
}
