<?php

/**
 * @file
 * Hook implementations for Joinup Media module.
 */

declare(strict_types = 1);

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Session\AccountInterface;

/**
 * Implements hook_ENTITY_TYPE_create_access().
 */
function joinup_media_media_create_access(AccountInterface $account, array $context, string $entity_bundle): AccessResultInterface {
  // Don't allow moderators to add group-aware media.
  $permission = "add media $entity_bundle";
  $access = AccessResult::allowedIfHasPermission($account, $permission);
  if ($access->isAllowed()) {
    return $access;
  }
  return AccessResult::forbidden("The '$permission' permission is required.")->addCacheContexts(['user.permissions']);
}

/**
 * Implements hook_form_BASE_FORM_ID_alter().
 */
function joinup_media_form_media_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  // Hide revision information.
  unset($form['revision_log_message']);
  unset($form['revision_information']);
  unset($form['revision']);
}
