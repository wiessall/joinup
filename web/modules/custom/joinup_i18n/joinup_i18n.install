<?php

/**
 * @file
 * Install, update, uninstall hook implementations for Joinup i18n module.
 */

declare(strict_types=1);

use Drupal\Core\StringTranslation\PluralTranslatableMarkup;
use Drupal\babel\Model\Source;

/**
 * Implements hook_requirements().
 *
 * @todo Remove in ISAICP-10740.
 */
function joinup_i18n_requirements(string $phase): array {
  if ($phase !== 'runtime') {
    return [];
  }

  $sql = <<<SQL
    SELECT GROUP_CONCAT(lid ORDER BY lid SEPARATOR ', '), source
    FROM locales_source
    GROUP BY source, context
    HAVING COUNT(source) > 1
    ORDER BY COUNT(source) DESC
    SQL;

  if (!$rows = \Drupal::database()->query($sql)->fetchAll(\PDO::FETCH_NUM)) {
    return [];
  }

  $items = [];
  foreach ($rows as [$lids, $source]) {
    $items[] = "$lids: $source";
  }

  $count = count($rows);
  return [
    'joinup_i18n_source_duplicate' => [
      // This is an error, but we collect more info w/o failing the build.
      'severity' => REQUIREMENT_INFO,
      'title' => t('Locale source strings'),
      'value' => new PluralTranslatableMarkup($count, '@count Locale string with duplicates:', '@count Locale strings with duplicates:'),
      'description' => [
        '#theme' => 'item_list',
        '#items' => $items,
      ],
    ],
  ];
}

/**
 * Store non-EU languages whose names already exist in Babel and are disabled.
 */
function joinup_i18n_update_201200(): void {
  $euLanguages = [
    'Bulgarian',
    'Czech',
    'Danish',
    'German',
    'Greek',
    'English',
    'Spanish',
    'Estonian',
    'Finnish',
    'French',
    'Irish',
    'Croatian',
    'Hungarian',
    'Italian',
    'Lithuanian',
    'Latvian',
    'Maltese',
    'Dutch',
    'Polish',
    'Portuguese',
    'Romanian',
    'Slovak',
    'Slovenian',
    'Swedish',
  ];

  $names = \Drupal::entityQueryAggregate('taxonomy_term')->accessCheck(FALSE)
    ->condition('vid', 'language')
    ->condition('name', $euLanguages, 'NOT IN')
    ->groupBy('langcode')
    ->groupBy('name')
    ->execute();
  if (!$names) {
    return;
  }

  // Get hashes out of names.
  $hashes = array_map(
    fn(string $name): string => (new Source($name, ''))->getHash(),
    array_column($names, 'name'),
  );

  $enabled = \Drupal::database()->select('babel_source')
    ->fields('babel_source', ['hash'])
    ->condition('hash', $hashes, 'IN')
    ->condition('status', 1)
    ->execute()
    ->fetchCol();
  \Drupal::state()->set('joinup_i18n.update_2012', array_diff($hashes, $enabled));
}
