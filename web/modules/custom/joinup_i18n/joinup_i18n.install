<?php

/**
 * @file
 * Install, update, and uninstall functions for the Joinup i18n module.
 */

declare(strict_types=1);

use Drupal\Core\Batch\BatchBuilder;
use Drupal\babel\BabelBatchProcessor;
use Drupal\babel\BabelConfigTranslatables;

/**
 * Rescan the config strings for translation.
 */
function joinup_i18n_update_200700(): void {
  $batch = new BatchBuilder();

  $batch->addOperation([
    BabelBatchProcessor::class,
    'importExistingLocaleStrings',
  ]);

  $names = \Drupal::configFactory()->listAll();
  BabelConfigTranslatables::excludeWebformConfigurations($names);

  $total = count($names);
  foreach (array_chunk($names, 50) as $chunk) {
    $batch->addOperation([
      BabelBatchProcessor::class,
      'processConfigurationStrings',
    ], [$chunk, $total]);
  }
  batch_set($batch->toArray());
}
