<?php

/**
 * @file
 * Contains hooks and functions for the Joinup I18n module.
 */

declare(strict_types=1);

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Entity\ContentEntityInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\Core\Url;
use Drupal\search_api\Query\ConditionGroup;
use Drupal\search_api\Query\QueryInterface;

/**
 * Implements hook_module_implements_alter().
 */
function joinup_i18n_module_implements_alter(array &$implementations, string $hook): void {
  if (in_array($hook, ['requirements', 'runtime_requirements'], TRUE) && isset($implementations['locale'])) {
    // Remove the locale module from the requirements list.
    unset($implementations['locale']);
  }
}

/**
 * Implements hook_entity_access().
 *
 * Restricts viewing of the non-default (translated) versions of content
 * entities to users holding the "view content translations" permission. The
 * default (original) translation - typically English - stays publicly
 * accessible.
 *
 * As a side effect this keeps translated content from being advertised to
 * anonymous users and crawlers: content_translation only renders an alternate
 * hreflang <link> tag for translations the current user is allowed to view, so
 * forbidding the translations here removes their hreflang links from the page
 * head without having to strip them after the fact.
 *
 * @see \Drupal\content_translation\Hook\ContentTranslationHooks::pageAttachments()
 */
function joinup_i18n_entity_access(EntityInterface $entity, string $operation, AccountInterface $account): AccessResultInterface {
  if ($operation !== 'view' || !$entity instanceof ContentEntityInterface || $entity->isDefaultTranslation()) {
    return AccessResult::neutral();
  }

  return AccessResult::forbiddenIf(!$account->hasPermission('view content translations'))
    ->cachePerPermissions()
    ->addCacheableDependency($entity);
}

/**
 * Implements hook_language_switch_links_alter().
 */
function joinup_i18n_language_switch_links_alter(array &$links, string $type, Url $url): void {
  // Use native language representations.
  $native_languages = \Drupal::languageManager()->getNativeLanguages();
  foreach ($links as $code => &$link) {
    if (isset($native_languages[$code])) {
      $link['title'] = $native_languages[$code]->getName();
    }
  }

  // Sort by langcode.
  ksort($links);
}

/**
 * Implements hook_babel_translation_type_info_alter().
 */
function joinup_i18n_babel_translation_type_info_alter(array &$definitions): void {
  // By default, disable all Babel plugins. They can be enabled on a
  // case-by-case basis.
  $allowedPlugins = ['content_entity:taxonomy_term', 'content_entity:meta_entity'];
  foreach ($definitions as $pluginId => $definition) {
    if (in_array($pluginId, $allowedPlugins, TRUE)) {
      // Keep these plugins as declared so they are enabled if set.
      continue;
    }
    $definitions[$pluginId]['status'] = FALSE;
  }
}

/**
 * Implements hook_search_api_query_alter().
 *
 * During re-indexing the language_with_fallback field will have no values thus
 * we need to add a condition which covers this scenario.
 *
 * @see https://citnet.tech.ec.europa.eu/CITnet/jira/browse/ISAICP-11121
 */
function joinup_i18n_search_api_query_alter(QueryInterface $query): void {
  if (!in_array($query->getIndex()->id(), ['published', 'oss_catalogue'])) {
    return;
  }

  $group = $query->getConditionGroup();
  $groupConditions = $group->getConditions();

  foreach ($groupConditions as &$item) {
    if (!$item instanceof ConditionGroup) {
      continue;
    }

    $conditions = &$item->getConditions();

    foreach ($conditions as $key => $condition) {
      if ($condition->getField() !== 'language_with_fallback') {
        continue;
      }

      $or_group = $query->createConditionGroup('OR');
      $or_group->addCondition('language_with_fallback', $condition->getValue(), $condition->getOperator());
      $or_group->addCondition('language_with_fallback', NULL);
      $conditions[$key] = $or_group;
    }
  }
}
