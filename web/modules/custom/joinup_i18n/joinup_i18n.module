<?php

/**
 * @file
 * Contains hooks and functions for the Joinup I18n module.
 */

declare(strict_types=1);

use Drupal\Core\Template\Attribute;

/**
 * Implements hook_module_implements_alter().
 */
function joinup_i18n_module_implements_alter(array &$implementations, string $hook): void {
  if ($hook === 'requirements' && isset($implementations['locale'])) {
    // Remove the locale module from the requirements list.
    unset($implementations['locale']);
  }
}

/**
 * Implements hook_theme().
 */
function joinup_i18n_theme(): array {
  return [
    'language_picker' => [
      'variables' => [
        'current_language' => NULL,
        'languages' => [],
      ],
      'template' => 'language-picker',
    ],
  ];
}

/**
 * Implements hook_preprocess_language_picker().
 */
function template_preprocess_language_picker(array &$variables): void {
  foreach ($variables['languages'] as &$language) {
    $language['attributes'] = new Attribute(['class' => ['language-picker__link']]);
    if ($language['is_current']) {
      $language['attributes']->addClass('language-picker__link--active');
    }
  }
}
