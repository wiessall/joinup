{#
/**
 * @file
 * Simple language picker template.
 *
 * Available variables:
 * - current_language: The current language object.
 * - languages: Array of language objects with 'code', 'name', and 'url'.
 */
#}
<div class="language-picker">
  <div class="language-picker__current">
    <span class="language-picker__current-label">{{ 'Current language'|t }}:</span>
    <span class="language-picker__current-code">{{ current_language.code|upper }}</span>
    <span class="language-picker__current-name">{{ current_language.name }}</span>
  </div>

  {% if languages %}
    <div class="language-picker__list">
      <h3 class="language-picker__title">{{ 'Available languages'|t }}</h3>
      <ul class="language-picker__links">
        {% for language in languages %}
          <li class="language-picker__item">
            <a href="{{ language.url }}"{{ language.attributes }}>
              <span class="language-picker__code">{{ language.code|upper }}</span>
              <span class="language-picker__name">{{ language.name }}</span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}
</div>
