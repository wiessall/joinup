<?php

/**
 * @file
 * Main functions and hook implementations of the custom page module.
 */

declare(strict_types=1);

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Field\FieldDefinitionInterface;
use Drupal\Core\Field\FieldItemListInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\custom_page\Entity\CustomPage;
use Drupal\custom_page\Entity\CustomPageInterface;
use Drupal\menu_link_content\MenuLinkContentInterface;
use Drupal\node\NodeInterface;
use Drupal\solution\Entity\SolutionInterface;

/**
 * Implements hook_entity_type_alter().
 */
function custom_page_entity_type_alter(array &$entity_types): void {
  /** @var \Drupal\Core\Entity\ContentEntityTypeInterface[] $entity_types */
  // Add a link template allow adding custom pages.
  $entity_types['rdf_entity']->setLinkTemplate('add-custom-page', '/rdf_entity/{rdf_entity}/{node_type}/add');

  // Replaces the standard OG Menu Instance form with a customized one that is
  // suitable for use in the front end.
  $entity_types['ogmenu_instance']->setFormClass('edit', 'Drupal\custom_page\Form\OgMenuInstanceForm');
}

/**
 * Implements hook_field_info_alter().
 */
function custom_page_field_info_alter(&$info): void {
  if (isset($info['path'])) {
    $info['path']['constraints']['LandingPagePathFieldConstraint'] = [];
  }
}

/**
 * Implements hook_entity_bundle_info_alter().
 */
function custom_page_entity_bundle_info_alter(array &$bundles): void {
  if (!empty($bundles['node']['custom_page'])) {
    $bundles['node']['custom_page']['class'] = CustomPage::class;
  }
}

/**
 * Implements hook_entity_bundle_field_info_alter().
 */
function custom_page_entity_bundle_field_info_alter(&$fields, EntityTypeInterface $entity_type, $bundle): void {
  if ($entity_type->id() == 'node' && $bundle == 'custom_page') {
    if (!empty($fields['title'])) {
      $fields['title']->addConstraint('UniqueFieldValueInGroupAndBundle', [
        'groupAudienceField' => 'og_audience',
      ]);
    }
    if (!empty($fields['status'])) {
      $fields['status']->addConstraint('CustomPageUnpublishedConstraint');
    }
  }
}

/**
 * Implements hook_preprocess_HOOK().
 */
function custom_page_preprocess_page_title__node__custom_page(&$variables): void {
  /** @var \Drupal\custom_page\Entity\CustomPageInterface $customPage */
  $customPage = $variables['entity'];
  $variables['additional_content']['hide_title'] =
    $customPage->get('field_hide_title')->getString() === '1';
}

/**
 * Implements hook_ENTITY_TYPE_insert().
 *
 * - Creates a menu link whenever a new custom page is created.
 * - Reindexes the parent collection/solution so that they are searchable using
 *   the content of the new custom page.
 */
function custom_page_node_insert(EntityInterface $entity): void {
  if (!$entity instanceof CustomPageInterface) {
    return;
  }

  \Drupal::getContainer()->get('custom_page.og_menu_links_manager')->addLink($entity, 'navigation');
  \Drupal::getContainer()->get('custom_page.og_menu_links_manager')->addLink($entity, 'quick_links', [
    'enabled' => FALSE,
  ]);

  // The content of custom pages is included in the search index of their
  // collections and solutions, so that the parent group can be found when
  // searching for keywords contained in their custom pages. Make sure to
  // reindex the parent group so that the new custom page is included.
  // @see \Drupal\custom_page\Plugin\search_api\processor\IncludeCustomPageContent
  // @todo This is mistakenly acting on all content, not just on custom pages.
  // @see https://citnet.tech.ec.europa.eu/CITnet/jira/browse/ISAICP-7129
  $parent = $entity->og_audience->entity;
  if (!empty($parent)) {
    /** @var \Drupal\search_api\Plugin\search_api\datasource\ContentEntityTrackingManager $content_tracking_manager */
    $content_tracking_manager = \Drupal::service('search_api.entity_datasource.tracking_manager');
    $content_tracking_manager->trackEntityChange($entity->og_audience->entity);
  }
}

/**
 * Implements hook_ENTITY_TYPE_update().
 *
 * - Updates links to this custom page if the title has changed or if the page
 *   becomes (un)published.
 * - When a custom page moves to a new group, move the link to the menu of the
 *   new group.
 * - Reindexes the parent collection/solution so that they are searchable using
 *   the content of the new custom page.
 */
function custom_page_node_update(NodeInterface $entity): void {
  if (!$entity instanceof CustomPageInterface) {
    return;
  }

  /** @var \Drupal\custom_page\Entity\CustomPageInterface $original */
  $original = $entity->original;

  // Update all links that point to this custom page if the title has changed,
  // or if the entity becomes (un)published.
  if ($entity->isPublished() !== $original->isPublished() || $entity->getTitle() !== $original->getTitle()) {
    /** @var \Drupal\Core\Menu\MenuLinkManagerInterface $menu_link_manager */
    $menu_link_manager = \Drupal::service('plugin.manager.menu.link');
    $result = $menu_link_manager->loadLinksByRoute('entity.node.canonical', ['node' => $entity->id()]);

    if (!empty($result)) {
      foreach ($result as $instance) {
        $menu_link_manager->updateDefinition($instance->getPluginId(), ['title' => $entity->getTitle()], TRUE);
      }
    }
  }

  // Update the OG menu link only if the group has changed.
  if ($entity->og_audience->target_id !== $original->og_audience->target_id) {
    \Drupal::service('custom_page.og_menu_links_manager')
      ->moveLinks($original, $entity->og_audience->target_id);
  }

  // The content of custom pages is included in the search index of their
  // collections and solutions, so that the parent group can be found when
  // searching for keywords contained in their custom pages. Make sure to
  // reindex the parent group so that the changed content is included.
  // @see \Drupal\custom_page\Plugin\search_api\processor\IncludeCustomPageContent
  $parent = $entity->og_audience->entity;
  if (!empty($parent)) {
    /** @var \Drupal\search_api\Plugin\search_api\datasource\ContentEntityTrackingManager $content_tracking_manager */
    $content_tracking_manager = \Drupal::service('search_api.entity_datasource.tracking_manager');
    $content_tracking_manager->trackEntityChange($entity->og_audience->entity);
  }
}

/**
 * Implements hook_ENTITY_TYPE_delete().
 *
 * - Reindexes the parent collection/solution so that the content of the deleted
 *   custom page no longer shows up in the search results for the parent group.
 */
function custom_page_node_delete(NodeInterface $entity): void {
  if (!$entity instanceof CustomPageInterface) {
    return;
  }

  // The content of custom pages is included in the search index of their
  // collections and solutions, so that the parent group can be found when
  // searching for keywords contained in their custom pages. Make sure to
  // reindex the parent group so that the deleted content is no longer included.
  // @see \Drupal\custom_page\Plugin\search_api\processor\IncludeCustomPageContent
  if ($entity->hasGroup()) {
    /** @var \Drupal\search_api\Plugin\search_api\datasource\ContentEntityTrackingManager $content_tracking_manager */
    $content_tracking_manager = \Drupal::service('search_api.entity_datasource.tracking_manager');
    $content_tracking_manager->trackEntityChange($entity->getGroup());
  }
}

/**
 * Implements hook_ENTITY_TYPE_update().
 *
 * Whenever a custom page that is linked in the navigation menu of a collection
 * or solution becomes enabled or disabled we need to reindex the group, since
 * the content of the custom menu should now be included or excluded.
 */
function custom_page_menu_link_content_update(MenuLinkContentInterface $menu_link): void {
  // Do a quick check to see if the menu link entity's ableness has changed.
  if ($menu_link->isEnabled() === $menu_link->original->isEnabled()) {
    return;
  }

  // Ignore external links.
  $url_object = $menu_link->getUrlObject();
  if ($url_object->isExternal()) {
    return;
  }

  $route_parameters = $menu_link->getUrlObject()->getRouteParameters();
  if (isset($route_parameters['node'])) {
    $custom_page = \Drupal::entityTypeManager()->getStorage('node')->load($route_parameters['node']);
    if ($custom_page instanceof CustomPageInterface) {
      if ($custom_page->hasGroup()) {
        /** @var \Drupal\search_api\Plugin\search_api\datasource\ContentEntityTrackingManager $content_tracking_manager */
        $content_tracking_manager = \Drupal::service('search_api.entity_datasource.tracking_manager');
        $content_tracking_manager->trackEntityChange($custom_page->getGroup());
      }
    }
  }
}

/**
 * Implements hook_menu_local_actions_alter().
 */
function custom_page_menu_local_actions_alter(&$local_actions): void {
  // Remove the 'Add link' local action from the custom page navigation menu
  // edit form. In default Drupal this is intended for webmasters, but we expose
  // this form to end users which do not interact directly with menu links.
  // Instead of this our users have an 'Add page' local action which leads to a
  // node add form. The menu link itself is created behind the scenes.
  foreach ($local_actions as &$local_action) {
    if ($local_action['route_name'] === 'entity.ogmenu_instance.add_link') {
      if (($key = array_search('entity.ogmenu_instance.edit_form', $local_action['appears_on'])) !== FALSE) {
        unset($local_action['appears_on'][$key]);
      }
      break;
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_access() for "node".
 */
function custom_page_node_access(NodeInterface $node, $op, AccountInterface $account): AccessResultInterface {
  if (!$node instanceof CustomPageInterface || !$node->hasGroup()) {
    return AccessResult::neutral();
  }

  $parent = $node->getGroup();

  // Deny edit access if the parent is an archived solution and the operation
  // is not "view".
  if ($op !== 'view') {
    return AccessResult::forbiddenIf(
        $parent instanceof SolutionInterface &&
        $parent->isArchived()
      )
      ->addCacheableDependency($parent);
  }

  // Let parentless nodes be handled by the core access.
  if (!$parent->access('view', $account)) {
    // Anonymous users do not have access to content of non published groups.
    return AccessResult::forbiddenIf($account->isAnonymous() || $node->getOwnerId() !== $account->id());
  }
  $membership = $parent->getMembership((int) $account->id());
  if (empty($membership)) {
    return AccessResult::neutral();
  }
  if (!$node->isPublished() && $membership->hasPermission("view any unpublished content")) {
    return AccessResult::allowed();
  }
  return AccessResult::neutral();
}

/**
 * Implements hook_entity_field_access().
 */
function custom_page_entity_field_access($operation, FieldDefinitionInterface $field_definition, AccountInterface $account, ?FieldItemListInterface $items = NULL): AccessResultInterface {
  switch ($field_definition->getName()) {
    case 'status':
      return AccessResult::allowedIf(
        $operation === 'edit'
        && $field_definition->getTargetEntityTypeId() === 'node'
        && $field_definition->getTargetBundle() === 'custom_page');

    case 'path';
      $accessPermission = AccessResult::allowedIfHasPermissions($account, [
        'manage custom landing pages',
        'administer url aliases',
      ], 'OR')->cachePerPermissions();

      // Check if we are in group context.
      $group = \Drupal::service('og.context')->getGroup();

      return AccessResult::allowedIf(
        $operation === 'edit'
        && $field_definition->getTargetEntityTypeId() === 'node'
        && !$group)
        ->andIf($accessPermission)
        ->addCacheContexts(['route']);

    default:
      return AccessResult::neutral();
  }
}

/**
 * Implements hook_entity_presave().
 */
function custom_page_node_presave(NodeInterface $entity): void {
  if (!$entity instanceof CustomPageInterface) {
    return;
  }
  if (!$entity->isPublished() && $entity->isGroupLandingPage()) {
    throw new Exception("This page acts as landing page for the {$entity->getGroup()->get('rid')->entity->getSingularLabel()}. In order to unpublished it should be first unset as landing page.");
  }
}

/**
 * Implements hook_entity_predelete().
 */
function custom_page_node_predelete(NodeInterface $entity): void {
  if (!$entity instanceof CustomPageInterface) {
    return;
  }
  if ($entity->isGroupLandingPage()) {
    throw new Exception("This page acts as landing page for the {$entity->getGroup()->get('rid')->entity->getSingularLabel()}. In order to delete it should be first unset as landing page.");
  }
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function custom_page_form_node_custom_page_delete_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $entity = $form_state->getFormObject()->getEntity();
  if ($entity->isGroupLandingPage()) {
    $form['#title'] = t('You can not delete this landing page!');
    $form['description'] = [
      '#markup' => t('This page acts as landing page for the @group. In order to delete it should be first unset as landing page.', ['@group' => $entity->getGroup()->get('rid')->entity->getSingularLabel()]),
    ];
    $form['actions']['submit']['#access'] = FALSE;
  }
}

/**
 * Implements hook_entity_extra_field_info().
 */
function custom_page_entity_extra_field_info(): array {
  $fields = [];

  $fields['node']['custom_page']['display']['share_link'] = [
    'label' => t('Share'),
    'description' => t('A link to share the content'),
    'visible' => FALSE,
  ];

  return $fields;
}

/**
 * Implements hook_pathauto_alias_alter().
 *
 * Aliases are generated automatic, but some words are prohibited.
 */
function custom_page_pathauto_alias_alter(&$alias, array $context): void {
  if ($context['module'] !== 'node' || $context['bundle'] !== 'custom_page') {
    return;
  }

  $node = $context['data']['node'] ?? NULL;
  if (!$node instanceof CustomPageInterface || !$node->hasGroup()) {
    return;
  }

  $prohibited_suffixes = [
    '/distribution',
    '/news',
    '/discussion',
    '/document',
    '/event',
    '/solution',
    '/release',
  ];
  foreach ($prohibited_suffixes as $prohibited) {
    if (str_ends_with($alias, $prohibited)) {
      // Append an incrementing numeric suffix, treat it as already taken.
      $alias = $alias . '-0';
      return;
    }
  }
}
