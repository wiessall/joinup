{% if content %}
  <div {{ attributes.addClass('l-oss-heading') }}>
    <div class="l-oss-heading__content">
      {% if content.top_left or content.top_right %}
        <div class="l-oss-heading__row">
          {% if content.top_left %}
            <div {{ region_attributes.top_left.addClass('l-oss-heading__top-left') }}>
              {{ content.top_left }}
            </div>
          {% endif %}

          {% if content.top_right %}
            <div {{ region_attributes.top_right.addClass('l-oss-heading__top-right') }}>
              {{ content.top_right }}
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% if content.first_left or content.first_right %}
        <div class="l-oss-heading__row">
          {% if content.first_left %}
            <div {{ region_attributes.first_left.addClass('l-oss-heading__first-left') }}>
              {{ content.first_left }}
            </div>
          {% endif %}

          {% if content.first_right %}
            <div {{ region_attributes.first_right.addClass('l-oss-heading__first-right') }}>
              {{ content.first_right }}
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% if content.second %}
        <div class="l-oss-heading__row">
          <div {{ region_attributes.second.addClass('l-oss-heading__second') }}>
            {{ content.second }}
          </div>
        </div>
      {% endif %}

      {% if content.third_left or content.third_right %}
        <div class="l-oss-heading__row">
          {% if content.third_left %}
            <div {{ region_attributes.third_left.addClass('l-oss-heading__third-left') }}>
              {{ content.third_left }}
            </div>
          {% endif %}

          {% if content.third_right %}
            <div {{ region_attributes.third_right.addClass('l-oss-heading--third-right') }}>
              {{ content.third_right }}
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>

    {% if content.aside %}
      <div {{ region_attributes.aside.addClass('l-oss-heading__aside') }}>
        {{ content.aside }}
      </div>
    {% endif %}
  </div>
{% endif %}
