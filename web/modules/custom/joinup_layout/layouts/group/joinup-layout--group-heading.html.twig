{% if content %}
  <div {{ attributes.addClass('layout', 'l-group-heading', 'row') }}>
    <div class="l-group-heading__content col-12 col-md-7 col-lg-6 py-5">
      {% if content.main %}
        <div class="row mb-4">
          <div {{ region_attributes.second.addClass('l-group-heading__main') }}>
            {{ content.main }}
          </div>
        </div>
      {% endif %}

      {% if content.left or content.right %}
        <div class="row d-flex flex-wrap">
          {% if content.left %}
            <div {{ region_attributes.left.addClass('l-group-heading__left', 'col-12', 'col-md-6', 'mb-2') }}>
              {{ content.left }}
            </div>
          {% endif %}

          {% if content.right %}
            <div {{ region_attributes.right.addClass('l-group-heading--right', 'col-12 col-md-6', 'mb-2') }}>
              {{ content.right }}
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>

    {% if content.aside %}
      <div {{ region_attributes.aside.addClass('l-group-heading__aside', 'bg-light', 'col-12', 'col-md-5', 'col-lg-4', 'offset-lg-2', 'rounded-3', 'p-4', 'p-lg-5', 'mb-5') }}>
        {{ content.aside }}
      </div>
    {% endif %}
  </div>
{% endif %}
