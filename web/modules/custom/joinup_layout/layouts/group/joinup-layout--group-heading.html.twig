{% if content %}
  <div {{ attributes.addClass('l-group-heading row mb-5') }}>
    <div class="l-group-heading__content col-12 col-md-7 mb-4 mb-md-0">
      {% if content.main %}
        <div class="row mb-4">
          <div {{ region_attributes.second.addClass('l-group-heading__main') }}>
            {{ content.main }}
          </div>
        </div>
      {% endif %}

      {% if content.left or content.right %}
        <div class="row d-flex flex-wrap">
          {% if content.left %}
            <div {{ region_attributes.left.addClass('l-group-heading__left col-12 col-md-6') }}>
              {{ content.left }}
            </div>
          {% endif %}

          {% if content.right %}
            <div {{ region_attributes.right.addClass('l-group-heading--right col-12 col-md-6') }}>
              {{ content.right }}
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>

    {% if content.aside %}
      <div {{ region_attributes.aside.addClass('l-group-heading__aside col-12 offset-md-1 col-md-4 p-4 p-lg-5 bg-light rounded-3') }}>
        {{ content.aside }}
      </div>
    {% endif %}
  </div>
{% endif %}
