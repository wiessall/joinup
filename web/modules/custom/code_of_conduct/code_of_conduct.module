<?php

/**
 * @file
 * Primary module hooks for Code of Conduct module.
 */

declare(strict_types=1);

use Drupal\Core\Entity\EntityInterface;
use Drupal\collection\Entity\CollectionInterface;
use Drupal\collection\Entity\GroupMembership;
use Drupal\custom_page\Entity\CustomPageInterface;
use Drupal\meta_entity\Entity\MetaEntity;

/**
 * Implements hook_ENTITY_TYPE_update().
 */
function code_of_conduct_node_update(EntityInterface $entity): void {
  if ($entity instanceof CollectionInterface) {
    \Drupal::service('code_of_conduct.crud_handler')->onGroupUpdate($entity);
  }
  elseif ($entity instanceof CustomPageInterface) {
    \Drupal::service('code_of_conduct.crud_handler')->onCodeOfConductUpdate($entity);
  }
}

/**
 * Implements hook_ENTITY_TYPE_insert().
 */
function code_of_conduct_node_insert(EntityInterface $entity): void {
  if (!$entity instanceof CollectionInterface) {
    return;
  }
  $meta_entity = MetaEntity::loadOrCreate('collection_settings', $entity);
  \Drupal::service('code_of_conduct.crud_handler')->onGroupSettingsInsertOrUpdate($meta_entity, TRUE);
}

/**
 * Implements hook_ENTITY_TYPE_update().
 */
function code_of_conduct_meta_entity_update(EntityInterface $entity): void {
  // For now, we only handle collection settings.
  if ($entity->bundle() !== 'collection_settings') {
    return;
  }
  \Drupal::service('code_of_conduct.crud_handler')->onGroupSettingsInsertOrUpdate($entity);
}

/**
 * Implements hook_ENTITY_TYPE_delete().
 */
function code_of_conduct_meta_entity_delete(EntityInterface $entity): void {
  if ($entity->bundle() !== 'collection_settings') {
    return;
  }
  \Drupal::service('code_of_conduct.crud_handler')->onGroupSettingsDelete($entity);
}

/**
 * Implements hook_entity_display_build_alter().
 */
function code_of_conduct_entity_display_build_alter(array &$build, array $context): void {
  // Views use the \Drupal\views\Entity\Render\EntityFieldRenderer::buildFields
  // in order to build the labels of a reference field. It does this by
  // building a custom entity view component and dynamically generating a
  // rendered view of the entity with the component and extracting the values
  // from it. With the code below, we are stripping the full member role from
  // the roles field in the group membership view and any other place in the
  // website as it mainly is the same role with the default `member`.
  $group_membership = $context['entity'];
  /** @var \Drupal\collection\Entity\GroupMembership $group_membership */
  if (!$group_membership instanceof GroupMembership) {
    return;
  }

  if (empty($build['roles']['#items']) || $build['roles']['#items']->isEmpty()) {
    return;
  }

  $full_member_role_id = \Drupal::service('code_of_conduct.membership_handler')->getFullMemberRoleId($group_membership->getGroup());
  /** @var \Drupal\Core\Field\EntityReferenceFieldItemList $items */
  $items = $build['roles']['#items'];
  foreach ($items->getValue() as $delta => $item) {
    if ($item['target_id'] === $full_member_role_id) {
      // We only unset the role from the build, not from the $item object, as
      // that would affect the entity on save - the build is used to determine
      // the values on bulk operations for example.
      unset($build['roles'][$delta]);
    }
  }
}
