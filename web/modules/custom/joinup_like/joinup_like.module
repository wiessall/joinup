<?php

/**
 * @file
 * Main functions and hook implementations of the joinup_like module.
 */

declare(strict_types = 1);

/**
 * Implements hook_theme().
 */
function joinup_like_theme(): array {
  return [
    'flag_count_archived' => [
      'variables' => [
        'flag' => NULL,
        'flaggable' => NULL,
      ],
    ],
  ];
}
