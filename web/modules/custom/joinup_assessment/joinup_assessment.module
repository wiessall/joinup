<?php

/**
 * @file
 * Hook implementations for the Joinup assessment module.
 */

declare(strict_types=1);

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\joinup_assessment\AssessmentInterface;
use Drupal\webform\WebformSubmissionInterface;

/**
 * Implements hook_entity_access().
 */
function joinup_assessment_entity_access(EntityInterface $entity, string $operation): AccessResultInterface {
  if ($entity instanceof WebformSubmissionInterface &&
    $operation === 'view' &&
    str_starts_with(
      $entity->getWebform()->id(),
      AssessmentInterface::WEBFORM_ID
    ) &&
    $entity->isCompleted()) {
    return AccessResult::allowed();
  }

  return AccessResult::neutral();
}
