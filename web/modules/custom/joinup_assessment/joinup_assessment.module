<?php

/**
 * @file
 * Hook implementations for the Joinup assessment module.
 */

declare(strict_types=1);

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Url;
use Drupal\joinup_assessment\AssessmentInterface;
use Drupal\joinup_document\Entity\DocumentInterface;
use Drupal\webform\WebformSubmissionInterface;

/**
 * Implements hook_webform_submission_access().
 */
function joinup_assessment_webform_submission_access(WebformSubmissionInterface $submission, string $operation): AccessResultInterface {
  $cacheMetadata = (new CacheableMetadata())->addCacheContexts(['route']);

  if ($operation === 'view' && $submission->getWebform()->id() === AssessmentInterface::WEBFORM_ID) {
    $routeMatch = \Drupal::routeMatch();
    // Show a locked submission in the context of a document.
    if (
      $routeMatch->getRouteName() === 'entity.node.canonical' &&
      ($document = $routeMatch->getParameter('node')) &&
      $document instanceof DocumentInterface &&
      $document->get('field_type')->value === AssessmentInterface::DOCUMENT_TYPE_KEY &&
      $document->isPublished()
    ) {
      $cacheMetadata->addCacheableDependency($document);
      return AccessResult::allowed()->addCacheableDependency($cacheMetadata);
    }
  }

  return AccessResult::neutral()->addCacheableDependency($cacheMetadata);
}

/**
 * Implements hook_options_list_alter().
 */
function joinup_assessment_options_list_alter(array &$options, array $context): void {
  /** @var \Drupal\field\FieldConfigInterface $fieldDefinition */
  $fieldDefinition = $context['fieldDefinition'];
  $entity = $context['entity'];

  if (empty($options) || $fieldDefinition->getName() !== 'field_type' || !$entity instanceof DocumentInterface) {
    return;
  }

  if (isset($entity->assessment) && !$entity->get('assessment')->isEmpty()) {
    return;
  }

  if (isset($options[AssessmentInterface::DOCUMENT_TYPE_KEY])) {
    unset($options[AssessmentInterface::DOCUMENT_TYPE_KEY]);
  }
}

/**
 * Implements hook_preprocess_views_view().
 */
function joinup_assessment_preprocess_views_view(array &$variables): void {
  $view = $variables['view'];
  if ($view->id() === 'assessment_reports' && $view->current_display === 'list') {
    if (\Drupal::currentUser()->isAuthenticated()) {
      $button_link = [
        '#type' => 'link',
        '#title' => 'My assessments',
        '#url' => Url::fromUserInput('/assessments/questionnaire/submissions'),
        '#attributes' => [
          'class' => ['m-3'],
        ],
      ];
      $variables['header']['my_assessments'] = $button_link;
    }
  }
}
