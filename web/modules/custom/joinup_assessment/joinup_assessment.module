<?php

/**
 * @file
 * Hook implementations for the Joinup assessment module.
 */

declare(strict_types=1);

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Cache\CacheableMetadata;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Link;
use Drupal\Core\Url;
use Drupal\joinup_assessment\AssessmentInterface;
use Drupal\joinup_assessment\Entity\AssessmentReport;
use Drupal\joinup_assessment\Entity\AssessmentReportInterface;
use Drupal\joinup_subscription\JoinupSubscriptionsHelper;
use Drupal\og\Og;
use Drupal\webform\WebformSubmissionInterface;

/**
 * Implements hook_webform_submission_access().
 */
function joinup_assessment_webform_submission_access(WebformSubmissionInterface $submission, string $operation): AccessResultInterface {
  $metadata = (new CacheableMetadata())->addCacheContexts(['route']);

  if ($operation === 'view' && $submission->getWebform()->id() === AssessmentInterface::WEBFORM_ID) {
    $routeMatch = \Drupal::routeMatch();
    // Show a locked submission in the context of the assessment report.
    if (
      $routeMatch->getRouteName() === 'entity.node.canonical' &&
      ($report = $routeMatch->getParameter('node')) &&
      $report instanceof AssessmentReportInterface &&
      $report->isPublished()
    ) {
      $metadata->addCacheableDependency($report);
      return AccessResult::allowed()->addCacheableDependency($metadata);
    }
  }

  return AccessResult::neutral()->addCacheableDependency($metadata);
}

/**
 * Implements hook_preprocess_views_view().
 */
function joinup_assessment_preprocess_views_view(array &$variables): void {
  $view = $variables['view'];
  if ($view->id() === 'assessment_reports' && $view->current_display === 'list') {
    $variables['header']['my_submissions'] = [
      '#type' => 'link',
      '#title' => t('My assessments'),
      '#url' => Url::fromUserInput('/collection/assessments/assessment-reports/questionnaire/submissions'),
      '#attributes' => [
        'class' => ['m-3'],
      ],
      '#access' => \Drupal::currentUser()->isAuthenticated(),
    ];
    // Add bottom padding.
    $variables['header']['#prefix'] = '<div class="pb-3">';
    $variables['header']['#suffix'] = '</div>';
  }
}

/**
 * Implements hook_webform_element_ELEMENT_TYPE_alter().
 */
function joinup_assessment_webform_element_webform_actions_alter(array &$element): void {
  if ($element['#webform'] !== 'assessment') {
    return;
  }

  $webform_id = $element['#webform_submission'];
  if (empty($webform_id)) {
    return;
  }

  $element['print'] = [
    '#type' => 'link',
    '#title' => t('Download PDF'),
    '#url' => Url::fromRoute('entity_print.view', [
      'export_type' => 'pdf',
      'entity_type' => 'webform_submission',
      'entity_id' => $webform_id,
    ]),
    '#weight' => 100,
  ];
}

/**
 * Implements hook_webform_element_alter().
 */
function joinup_assessment_webform_element_alter(array &$element, FormStateInterface $form_state, array $context): void {
  if ($element['#webform'] === 'assessment' && isset($element['#webform_key']) && $element['#webform_key'] === 'portal_solutions') {

    $search_url = Url::fromRoute('view.search.page_1', [], [
      'query' => ['f[0]' => 'type:solution'],
    ]);
    $link = Link::fromTextAndUrl(t('Search'), $search_url);
    $link_options = $link->getUrl()->getOptions();
    $link_options['attributes'] = [
      'target' => '_blank',
      'rel' => 'noopener noreferrer',
    ];
    $link->getUrl()->setOptions($link_options);
    $search_link = $link->toString();
    $element['#title'] = t('Internal Solutions in the Portal (@search_link in the Interoperable Europe Portal)', [
      '@search_link' => $search_link,
    ]);
    $element['#title_display'] = 'before';
    $element['#allowed_tags'] = ['a', 'span', 'strong', 'em', 'br'];
  }
}

/**
 * Implements hook_entity_bundle_info_alter().
 */
function joinup_assessment_entity_bundle_info_alter(array &$bundles): void {
  if (!empty($bundles['node']['assessment_report'])) {
    $bundles['node']['assessment_report']['class'] = AssessmentReport::class;
  }
}

/**
 * Implements hook_ENTITY_TYPE_delete().
 */
function joinup_assessment_webform_submission_delete(WebformSubmissionInterface $submission): void {
  if ($submission->getWebform()->id() === AssessmentInterface::WEBFORM_ID) {
    // If a webform assessment submission is deleted, remove also the report.
    $storage = \Drupal::entityTypeManager()->getStorage('node');
    $nids = $storage->getQuery()->accessCheck(FALSE)
      ->condition('type', 'assessment_report')
      ->condition('submission', $submission->id())
      ->execute();
    if ($nids) {
      $storage->delete($storage->loadMultiple($nids));
    }
  }
}

/**
 * Implements hook_preprocess_page_title().
 */
function joinup_assessment_preprocess_page_title(array &$variables): void {
  $report = $variables['entity'] ?? NULL;
  if ($report instanceof AssessmentReportInterface) {
    $dateFormatter = \Drupal::getContainer()->get('date.formatter');
    $variables['additional_content']['organization'] = $report->get('organization')->value;
    $variables['additional_content']['publication_date'] = $dateFormatter->format($report->getCreatedTime(), 'date_only');
    $variables['bundle_label'] = $report->get('type')->entity->label();
  }
}

/**
 * Implements hook_form_alter().
 *
 * @throws \Drupal\Core\Entity\EntityStorageException
 */
function joinup_assessment_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  if ($form_id === 'joinup_subscription_my_subscriptions') {
    foreach ($form['groups'] as $key => &$group) {
      if (is_int($key) && $group['#uuid'] !== AssessmentInterface::GROUP_UUID && isset($group['options']['node|assessment_report'])) {
        unset($group['options']['node|assessment_report']);
        $subscriptions = $group['options']['submit']['#attributes']['data-joinup-subscriptions'];
        // Replace only the first occurrence of "false".
        $subscriptions = preg_replace('/\bfalse,\b/', '', $subscriptions, 1);
        $group['options']['submit']['#attributes']['data-joinup-subscriptions'] = $subscriptions;
      }
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_insert().
 *
 * Override collection_node_insert.
 */
function joinup_assessment_node_insert(EntityInterface $entity): void {
  if ($entity->bundle() !== 'collection') {
    return;
  }

  // When a new collection is proposed, give the user the 'group owner' role.
  // This will not occur if the user is the anonymous, i.e. the entity was
  // created by some batch process or some importing.
  if (!empty($entity->getOwner()) && !$entity->getOwner()->isAnonymous()) {
    $subscription_bundles = JoinupSubscriptionsHelper::provideDataForField('collection');
    // Remove the 'assessment_report' subscription for all collections,
    // except the assessment collection.
    if ($entity->uuid() !== AssessmentInterface::GROUP_UUID) {
      $subscription_bundles = array_values(array_filter($subscription_bundles, function ($bundle) {
        return $bundle['bundle'] !== 'assessment_report';
      }));
    }
    Og::getMembership($entity, $entity->getOwner())
      ->set('subscription_bundles', $subscription_bundles)
      ->save();
  }
}

/**
 * Implements hook_module_implements_alter().
 */
function joinup_assessment_module_implements_alter(array &$implementations, string $hook): void {
  if ($hook === 'node_insert') {
    // Make sure joinup_assessment_entity_insert() runs after
    // og_entity_insert(). The latter creates an OgMembership
    // entry for the collection owner when a new collection is
    // proposed, and joinup_assessment_entity_insert() needs to
    // modify this membership to add the required OG roles to it.
    $assessment = $implementations['joinup_assessment'];
    unset($implementations['joinup_assessment']);
    $implementations['joinup_assessment'] = $assessment;
  }
}
