parameters:
  grumphp.tasks.php_extensions: [ 'php', 'module', 'inc', 'theme', 'install', 'profile', 'engine' ]

grumphp:
  # Extend timeout, PHPStan is rather slow to scan everything.
  process_timeout: 240
  git_hook_variables:
    EXEC_GRUMPHP_COMMAND: ddev exec php
  ascii:
    failed: ~
    succeeded: ~

  tasks:
    # https://github.com/phpro/grumphp/blob/v2.x/doc/tasks/composer.md
    composer: { }

    # https://github.com/phpro/grumphp/blob/v2.x/doc/tasks/phpcs.md
    phpcs:
      standard: [ './phpcs.xml' ]
      triggered_by: '%grumphp.tasks.php_extensions%'

    # https://github.com/phpro/grumphp/blob/v2.x/doc/tasks/phpmd.md
    phpmd:
      ruleset: [ './phpmd.xml' ]
      triggered_by: '%grumphp.tasks.php_extensions%'
      metadata:
        enabled: false

    # https://github.com/phpro/grumphp/blob/v2.x/doc/tasks/phpstan.md
    phpstan:
      triggered_by: '%grumphp.tasks.php_extensions%'

    # https://github.com/phpro/grumphp/blob/v2.x/doc/tasks/stylelint.md
    lint-css:
      bin: node_modules/.bin/stylelint
      config: .stylelintrc.json
      metadata:
        task: stylelint

    # https://github.com/phpro/grumphp/blob/v2.x/doc/tasks/shell.md
    lint-gherkin:
      scripts:
        - ["-c", "./vendor/bin/gherkinlint lint tests/features"]
      triggered_by: [ feature ]
      metadata:
        task: shell

    # https://github.com/phpro/grumphp/blob/v2.x/doc/tasks/eslint.md
    lint-js:
      bin: node_modules/.bin/eslint
      config: .eslintrc.json
      no_eslintrc: true
      metadata:
        task: eslint

    # https://github.com/phpro/grumphp/blob/v2.x/doc/tasks/phplint.md
    lint-php:
      triggered_by: '%grumphp.tasks.php_extensions%'
      metadata:
        task: phplint

    # https://github.com/phpro/grumphp/blob/v2.x/doc/tasks/twigcsfixer.md
    lint-twig:
      metadata:
        task: twigcsfixer

    # https://github.com/phpro/grumphp/blob/v2.x/doc/tasks/yamllint.md
    lint-yaml:
      metadata:
        task: yamllint

  testsuites:
    # On git pre-push, often initiating a full scan, omit phpstan which is slow.
    # See scripts/git/pre_push.
    git_pre_push:
      tasks: [ composer, phpcs, phpmd, lint-css, lint-gherkin, lint-js, lint-php, lint-twig, lint-yaml ]
