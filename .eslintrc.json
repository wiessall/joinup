{
  "extends": "./web/core/.eslintrc.json",
  "overrides": [
    {
      "files": ["tests/playwright/**/*.ts"],
      "parser": "@typescript-eslint/parser",
      "parserOptions": {
        "project": "./tests/playwright/tsconfig.json"
      },
      "plugins": ["playwright", "@typescript-eslint"],
      "extends": [
        "plugin:@typescript-eslint/recommended",
        "plugin:playwright/recommended"
      ],
      "rules": {
        "import/extensions": [
          "error",
          "ignorePackages",
          {
            "ts": "never",
            "tsx": "never",
            "js": "never"
          }
        ],
        "import/no-unresolved": "off",
        "no-console": "warn"  // Optional: Warn but don't error on console logs
      }
    },
    // Empty mappings are allowed in the docker-compose file. This indicates
    // options that will inherit their value from the environment variables.
    {
      "files": ["docker-compose.yml"],
      "rules": {
        "yml/no-empty-mapping-value": "off"
      }
    },
    // Only require the @file tag for Javascript files.
    {
      "files": ["*.yml"],
      "rules": {
        "jsdoc/require-file-overview": "off"
      }
    }
  ],
  "globals": {
    "CKEDITOR": true,
    "Chart": true,
    "L": true
  },
  "plugins": [
    "jsdoc"
  ],
  "ignorePatterns": [
    "**/contact_information/js/build/*.js"
  ],
  "rules": {
    "jsdoc/require-file-overview": "error",
    "import/no-extraneous-dependencies": "off"
  },
  "settings": {
    "import/resolver": {
      "typescript": {
        "alwaysTryTypes": true
      }
    }
  }
}
