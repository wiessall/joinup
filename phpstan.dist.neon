parameters:
    level: 1
    treatPhpDocTypesAsCertain: false
    bootstrapFiles:
        - vendor/squizlabs/php_codesniffer/autoload.php
    drupal:
        entityMapping:
            og_membership:
                class: Drupal\og\Entity\OgMembership
                storage: Drupal\Core\Entity\Sql\SqlContentEntityStorage
    ignoreErrors:
        # As an exception, we allow extending these classes.
        - '#Class Drupal\\joinup_group\\Form\\UserCancelForm extends @internal class Drupal\\user\\Form\\UserCancelForm.#'
        - '#Class Drupal\\joinup_group\\Form\\UserMultipleCancelConfirm extends @internal class Drupal\\user\\Form\\UserMultipleCancelConfirm.#'
        - '#Class Drupal\\joinup_media\\JoinupMediaLibrary extends @internal class Drupal\\ckeditor5\\Plugin\\CKEditor5Plugin\\MediaLibrary.#'
        # new static() is a best practice in Drupal, so we cannot fix that.
        - '#^Unsafe usage of new static#'
        # Behat contexts are instantiated by Behat, not Drupal's container, so DI does not apply.
        - identifier: globalDrupalDependencyInjection.useDependencyInjection
          path: tests/src/Context/*
    excludePaths:
        - web/modules/custom/joinup_stats/src/Event/Subscriber/RefreshCachedFieldsEventSubscriber.php
