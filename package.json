{
  "name": "joinup",
  "author": "European Commission",
  "license": "EUPL-1.2",
  "devDependencies": {
    "@openeuropa/bcl-bootstrap": "1.2.0",
    "@openeuropa/bcl-builder": "1.2.0",
    "@openeuropa/bcl-theme-default": "1.2.0",
    "@openeuropa/bcl-theme-joinup": "1.2.0",
    "axe-core": "^4.8.2",
    "cross-env": "7.0.3",
    "del-cli": "^4.0.1",
    "eslint-config-airbnb": "^18.2.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.24.2",
    "eslint-plugin-jsdoc": "^46.8.2",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "^7.25.1",
    "eslint-plugin-yml": "^0.10.1",
    "glob": "7.1.7",
    "npm-run-all": "4.1.5",
    "npm-watch": "^0.11.0",
    "patch-package": "^6.5.0",
    "prettier": "^2.8.8",
    "react": "^17.0.2",
    "slim-select": "^1.27.1",
    "stylelint": "^15.11.0",
    "stylelint-checkstyle-formatter": "^0.1.2",
    "stylelint-config-standard": "^34.0.0",
    "stylelint-config-standard-scss": "^11.1.0",
    "stylelint-formatter-gitlab": "^1.0.2",
    "stylelint-order": "^6.0.4"
  },
  "dependencies": {
    "@glidejs/glide": "^3.6.0",
    "dompurify": "^3.0.9",
    "jquery-colorbox": "^1.6.4",
    "jquery-jsonview": "^1.2.3",
    "priority-plus": "^1.5.1",
    "slick-carousel": ">1.8.1 || <1.8.1"
  },
  "scripts": {
    "watch": "npm-watch",
    "clean:assets": "del-cli web/themes/ventuno/assets/* web/themes/iop/assets/*",
    "clean:scripts": "del-cli web/themes/ventuno/assets/js web/themes/iop/assets/js",
    "clean:styles": "del-cli web/themes/ventuno/assets/css web/themes/iop/assets/css",
    "build": "npm-run-all clean:scripts clean:styles build:scripts build:styles build:copy build:sprite",
    "build:scripts": "cross-env bcl-builder scripts",
    "build:styles": "cross-env bcl-builder styles",
    "build:copy": "cross-env bcl-builder copy",
    "build:sprite": "cross-env bcl-builder sprite",
    "postinstall": "patch-package --patch-dir=resources/patch/node && ./scripts/node/copy-libraries"
  },
  "watch": {
    "build:styles": {
      "patterns": [
        "web/themes/ventuno/src/scss/**/*.scss",
        "web/themes/iop/src/scss/**/*.scss"
      ],
      "extensions": "scss",
      "quiet": false
    },
    "build:scripts": {
      "patterns": [
        "web/themes/ventuno/src/js/**/*.js",
        "web/themes/iop/src/js/**/*.js"
      ],
      "extensions": "js",
      "quiet": false
    }
  }
}
