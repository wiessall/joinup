{
  "name": "joinup",
  "author": "European Commission",
  "license": "EUPL-1.2",
  "devDependencies": {
    "@openeuropa/bcl-bootstrap": "1.10.11",
    "@openeuropa/bcl-builder": "^1.10.0",
    "@openeuropa/bcl-theme-default": "^1.10.0",
    "@openeuropa/bcl-theme-joinup": "^1.10.0",
    "@playwright/test": "^1.53.1",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "axe-core": "^4.10.2",
    "cross-env": "^7.0.3",
    "del-cli": "^6.0.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^50.6.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.2.0",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-yml": "^1.16.0",
    "glob": "^11.0.1",
    "npm-run-all": "^4.1.5",
    "npm-watch": "^0.13.0",
    "patch-package": "^8.0.0",
    "prettier": "^3.4.2",
    "slim-select": "^1.27.1",
    "stylelint": "^16.13.2",
    "stylelint-checkstyle-formatter": "^0.1.2",
    "stylelint-config-standard": "^37.0.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-formatter-gitlab": "^1.0.2",
    "stylelint-order": "^6.0.4",
    "stylelint-prettier": "^5.0.2"
  },
  "dependencies": {
    "@glidejs/glide": "^3.7.1",
    "@yaireo/tagify": "^4.35.4",
    "chart.js": "^4.5",
    "dompurify": "^3.0.9",
    "jquery-colorbox": "github:turbojettechnologies/colorbox#1.7.0",
    "jquery-jsonview": "^1.2",
    "js-cookie": "^3.0.5",
    "mmenu-light": "^3.2.2",
    "priority-plus": "^1.5.1",
    "slick-carousel": ">1.6.0 <1.8.1"
  },
  "scripts": {
    "watch": "npm-watch",
    "clean:assets": "del-cli web/themes/ventuno/assets/* web/themes/iop/assets/*",
    "clean:scripts": "del-cli web/themes/ventuno/assets/js web/themes/iop/assets/js",
    "clean:styles": "del-cli web/themes/ventuno/assets/css web/themes/iop/assets/css",
    "build": "npm-run-all clean:scripts clean:styles build:scripts build:styles build:copy build:sprite clean:js",
    "build:scripts": "cross-env bcl-builder scripts && npm run clean:js",
    "build:styles": "cross-env bcl-builder styles",
    "build:copy": "cross-env bcl-builder copy",
    "build:sprite": "cross-env bcl-builder sprite",
    "build:third-party-libraries": "cross-env bcl-builder copy --config bcl-builder.third-party-libraries.config.js",
    "postinstall": "patch-package --patch-dir=resources/patch/node && npm run build:third-party-libraries",
    "clean:js": "find web/themes/ventuno/assets/js -type f -name '*.js' ! -name '*.min.js' -delete && find web/themes/iop/assets/js -type f -name '*.js' ! -name '*.min.js' -delete"
  },
  "watch": {
    "build:styles": {
      "patterns": [
        "web/themes/ventuno/src/scss/**/*.scss",
        "web/themes/iop/src/scss/**/*.scss"
      ],
      "extensions": "scss",
      "quiet": false
    },
    "build:scripts": {
      "patterns": [
        "web/themes/ventuno/src/js/**/*.js",
        "web/themes/iop/src/js/**/*.js"
      ],
      "extensions": "js",
      "quiet": false
    }
  }
}
