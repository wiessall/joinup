#!/bin/bash

set -e

source scripts/composer/download_licences

# Build the codebase.
test ! -f vendor/bin/run || vendor/bin/run toolkit:build-dev

# Install node dependencies only if not bypassed.
if [ ! -f .env ] || [ "$(grep 'COMPOSER_DISABLE_NODE_DEPENDENCIES=1' .env)" = "" ]
then
  pnpm install --frozen-lockfile
  # See scripts/composer/post_install: lifecycle scripts do not run on the
  # corporate pipelines, so the library copy is invoked explicitly.
  pnpm run build:third-party-libraries
fi
