#!/usr/bin/env bash

set -e

# Install node dependencies only if not bypassed or when building the distribution.
if [ "$BUILD_DISTRO" = "1" ] || [ ! -f .env ] || [ "$(grep 'COMPOSER_DISABLE_NODE_DEPENDENCIES=1' .env)" = "" ]
then
  pnpm install --frozen-lockfile
  # pnpm applies the node patches itself during install, so only the library
  # copy is left to invoke. It is called explicitly because the corporate
  # pipelines set NPM_CONFIG_IGNORE_SCRIPTS=true.
  pnpm run build:third-party-libraries
fi

source scripts/composer/download_licences

# Done, if we're building the distribution.
if [ "$BUILD_DISTRO" = "1" ]
then
  exit 0;
fi

# Parse and save the Interoperable Europe Portal version.
test \"`git rev-parse --is-shallow-repository`\" = \"false\" || git fetch --unshallow
git describe --tags 2>/dev/null | tr -d '\\n' > web/VERSION.txt

# Build the codebase.
test ! -f vendor/bin/run || vendor/bin/run toolkit:build-dev
