#!/usr/bin/env bash

set -e

# Check that composer.lock hash is in sync.
composer validate --no-check-all --no-check-publish

# Only run in pipeline.
if [ -n "$CI_RUNNER_ID" ] && [ -n "$CI_RUNNER_DESCRIPTION" ]; then
  echo "Running in GitLab Runner environment"
  echo "Runner ID: $CI_RUNNER_ID"
  echo "Runner Description: $CI_RUNNER_DESCRIPTION"
  apt-get update && apt-get install jq -y
else
  echo "Not running in GitLab Runner environment"
fi
jq –-version

# Check that patches are local.
for COMPOSER_PATCH in $(cat composer.json | jq --raw-output '.extra.patches[] | values[]')
do
  if [[ $COMPOSER_PATCH =~ ^https?:\/\/.*$ ]]; then
    echo "$(tput setaf 1)Patch $COMPOSER_PATCH should be local$(tput sgr0)"
    exit 1;
  fi
done

# Run NPM install only if it's not bypassed or when building the distribution.
if [ "$BUILD_DISTRO" = "1" ] || [ ! -f .env ] || [ "$(grep 'COMPOSER_DISABLE_NODE_DEPENDENCIES=1' .env)" = "" ]
then
  npm ci --no-progress
fi

# Done, if we're building the distribution.
if [ "$BUILD_DISTRO" = "1" ]
then
  exit 0;
fi

# Parse and save the Joinup version.
test \"`git rev-parse --is-shallow-repository`\" = \"false\" || git fetch --unshallow
git describe --tags 2>/dev/null | tr -d '\\n' > web/VERSION.txt

# Task Runner has been moved in Toolkit. However, the Toolkit's runner is
# simplified and not ready to be used by Joinup because of DQA-5962. Ensure that
# the standalone Task Runner is used.
# @see https://citnet.tech.ec.europa.eu/CITnet/jira/browse/DQA-5962
perl -i -pe 's/\/ec\-europa\/toolkit\/run/\/openeuropa\/task\-runner\/bin\/run/g' vendor/bin/run

# Build the codebase.
test ! -f vendor/bin/run || vendor/bin/run toolkit:build-dev
