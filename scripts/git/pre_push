#!/usr/bin/env bash

#
# Git pre-push hook that runs code quality tools against the changed code.
#

# The SHA1 ID of an empty branch.
SHA1_EMPTY="0000000000000000000000000000000000000000"
FULL_CHECK="0"

# Get all changed files, loop over the commits.
CHANGED_FILES=""
while IFS= read -r LINE; do
  PARTS=($LINE)
  LOCAL_REF=${PARTS[0]}
  LOCAL_SHA=${PARTS[1]}
  REMOTE_SHA=${PARTS[3]}

  # Skip if we are deleting a branch or if there is no local branch.
  if [ "${LOCAL_REF}" = "(delete)" ] || [ "${LOCAL_SHA}" = "${SHA1_EMPTY}" ]
  then
    break
  fi

  # Do a full check if this is a new branch.
  if [ "${REMOTE_SHA}" = "${SHA1_EMPTY}" ]
  then
    FULL_CHECK="1"
    break
  fi

  CHANGED_FILES="${CHANGED_FILES} $(git diff-tree --no-commit-id --name-only -r "${LOCAL_SHA}" "${REMOTE_SHA}")"
done

# Keep only existing files.
CHANGED_FILES=$(echo "$CHANGED_FILES" | xargs ls -d 2>/dev/null)

# Run GrumPHP.
if [[ "$FULL_CHECK" == "1" ]]; then
  ddev exec ./vendor/bin/grumphp run --no-interaction --testsuite=git_pre_push
  EXIT_CODE=$?
elif [[ -n "$CHANGED_FILES" ]]; then
  echo "$CHANGED_FILES" | ddev exec ./vendor/bin/grumphp run --no-interaction --testsuite=git_pre_push
  EXIT_CODE=$?
else
  EXIT_CODE=0
fi

exit $EXIT_CODE
