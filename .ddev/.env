# Overrides when running DDEV containers.
# See https://ddev.readthedocs.io/en/latest/users/extend/customization-extendibility/#extending-and-customizing-environments

# These environment variables are documented in .env.dist.

DRUPAL_TRUSTED_HOST_PATTERNS=.*

DRUPAL_FILE_TEMP_PATH=/var/www/html/tmp

DRUPAL_DATABASE_HOST=db
DRUPAL_DATABASE_USERNAME=db
DRUPAL_DATABASE_PASSWORD=db
DRUPAL_DATABASE_NAME=db

DRUPAL_SPARQL_HOSTNAME=virtuoso
DRUPAL_SPARQL_USER_READONLY=SPARQL_RO
DRUPAL_SPARQL_PASSWORD_READONLY=readonly

SEARCH_API_SERVER_SS_SOLR_HOST=solr-standalone

SYMFONY_DEPRECATIONS_HELPER=max[total]=0&ignoreFile=web/core/.deprecation-ignore.txt
WEBDRIVER_URL=http://selenium-chrome:4444/wd/hub

DTT_API_URL=http://selenium-chrome:4444/wd/hub

ARTIFACTS_DIR=/var/www/html/tmp

# Set the following to "on" to enable HTTPS in the DDEV web container. The
# superglobal variable base_url is constructed by checking the HTTPS server
# variable, and \Drupal\Core\File\FileUrlGenerator::generateAbsoluteString()
# uses this superglobal variable to generate URLs. If HTTPS is not enabled in
# the web container, the base_url will be constructed with "http" instead of
# "https", and the URLs generated by \Drupal\Core\File\FileUrlGenerator will
# be "http" instead of "https".
# @see \Drupal\Core\DrupalKernel::initializeRequestGlobals()
# @see \Symfony\Component\HttpFoundation\Request::isSecure()
# @see \Drupal\Core\File\FileUrlGenerator::generateAbsoluteString()
HTTPS=on

# Always allow xdebug with drush, since ddev works by enabling/disabling the
# PHP extension already.
DRUSH_ALLOW_XDEBUG=1
