# Overrides when running DDEV containers.
# See https://ddev.readthedocs.io/en/latest/users/extend/customization-extendibility/#extending-and-customizing-environments

# These environment variables are documented in .env.dist.

DRUPAL_TRUSTED_HOST_PATTERNS=.*

DRUPAL_BASE_URL=https://joinup.ddev.site
DRUPAL_FILE_TEMP_PATH=/var/www/html/tmp

DRUPAL_DATABASE_HOST=db
DRUPAL_DATABASE_USERNAME=db
DRUPAL_DATABASE_PASSWORD=db
DRUPAL_DATABASE_NAME=db

DRUPAL_SPARQL_HOSTNAME=virtuoso

SEARCH_API_SERVER_SS_SOLR_HOST=solr-standalone

SIMPLETEST_SPARQL_DB=sparql://virtuoso:8890?module=sparql_entity_storage
SYMFONY_DEPRECATIONS_HELPER=max[total]=0&ignoreFile=core/.deprecation-ignore.txt
WEBDRIVER_URL=http://selenium-chrome:4444/wd/hub

DTT_BASE_URL=http://joinup.ddev.site
DTT_API_URL=http://selenium-chrome:4444/wd/hub
DTT_MINK_DRIVER_ARGS='["chrome", {"browserName":"chrome","chromeOptions":{"w3c":false,"args":["--disable-gpu","--headless", "--no-sandbox", "--disable-dev-shm-usage"]}}, "http://selenium-chrome:4444/wd/hub"]'

ARTIFACTS_DIR=/var/www/html/tmp

SPARQL_PUBLIC_ENDPOINT=http://virtuoso:8890/sparql
