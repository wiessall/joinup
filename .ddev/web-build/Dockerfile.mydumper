# Use the same version as the backup tool.
# See https://git.fpfis.tech.ec.europa.eu/fpfis/httpd-php/-/blob/master/install-scripts/full.sh
ENV MYDUMPER_RELEASE="v0.15.1-3"

COPY ./importdb.sh /scripts/importdb.sh
RUN . /etc/os-release \
    && wget --no-verbose https://github.com/mydumper/mydumper/releases/download/${MYDUMPER_RELEASE}/mydumper_${MYDUMPER_RELEASE:1}.${VERSION_CODENAME}_amd64.deb \
    && dpkg -i mydumper_${MYDUMPER_RELEASE:1}.${VERSION_CODENAME}_amd64.deb \
    && rm mydumper_${MYDUMPER_RELEASE:1}.${VERSION_CODENAME}_amd64.deb \
