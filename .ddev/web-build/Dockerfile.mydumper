# Install mydumper.
# This is adapted from https://gitlab.dhs.tech.ec.europa.eu/digit/devsecops/httpd-php/-/blob/master/install-scripts/full.sh
ARG MYDUMPER_RELEASE="v0.19.3-3"
COPY ./importdb.sh /scripts/importdb.sh
RUN apt-get update -y -qq \
    && apt-get install -y -qq libatomic1 zstd libmysqlclient21 libpcre2-dev \
    && . /etc/os-release \
    && ARCH=$(dpkg --print-architecture) \
    && DEB_FILE="mydumper_${MYDUMPER_RELEASE:1}.${VERSION_CODENAME}_${ARCH}.deb" \
    && wget --no-verbose https://github.com/mydumper/mydumper/releases/download/${MYDUMPER_RELEASE}/$DEB_FILE \
    && dpkg -i $DEB_FILE \
    && rm $DEB_FILE
