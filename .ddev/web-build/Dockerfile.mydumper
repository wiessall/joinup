# Use the same version as the backup tool.
# See https://git.fpfis.tech.ec.europa.eu/fpfis/httpd-php/-/blob/master/install-scripts/full.sh
ENV MYDUMPER_RELEASE="v0.15.1-3"

COPY ./importdb.sh /scripts/importdb.sh
RUN sudo apt install cmake g++ git -y \
    && sudo apt install libglib2.0-dev zlib1g-dev libpcre3-dev libssl-dev libzstd-dev -y \
    && sudo apt install default-libmysqlclient-dev -y \
    && git clone --branch ${MYDUMPER_RELEASE} https://github.com/mydumper/mydumper.git \
    && cd mydumper \
    && cmake . \
    && make \
    && sudo make install \
    && sudo mv /usr/local/bin/myloader /usr/bin/
