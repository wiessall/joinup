# Remove this file after DDEV v1.25.2 is out
# and then add `ddev_version_constraint: '>= v1.25.2'` to .ddev/config.yaml
ARG extension=memcached
RUN <<ENDMEMCACHED
    set -eu -o pipefail
    if [ ! -f /usr/lib/php/20250925/memcached.so ]; then
        phpdismod ${extension} || true
        apt-get update || true
        DEBIAN_FRONTEND=noninteractive apt-get install -y -o Dpkg::Options::="--force-confnew" --no-install-recommends --no-install-suggests build-essential php-pear php${DDEV_PHP_VERSION}-dev libmemcached-dev zlib1g-dev
        pecl -d php_suffix=${DDEV_PHP_VERSION} install -f ${extension}
        cp /etc/php/8.4/mods-available/${extension}.ini /etc/php/${DDEV_PHP_VERSION}/mods-available/${extension}.ini
        phpenmod -v ${DDEV_PHP_VERSION} ${extension}
    fi
ENDMEMCACHED
