#!/bin/bash

# Just a shorthand for `ddev run dev:download-databases`

## Description: Downloads MySQL dump, Solr and Virtuoso snapshots
## Usage: download-databases
## Example: ddev download-databases

# MySQL
ddev run toolkit:download-dump --yes
ddev run mysql:unpack-dump

# Virtuoso
rm -rf .ddev/virtuoso/snapshot/VIRTUOSO_DUMP_*
tar xvf tmp/virtuoso.gz --directory=tmp
SOURCE=$(find tmp -type d -name digit-joinup-reference_*)
cp $SOURCE/VIRTUOSO_DUMP_* .ddev/virtuoso/snapshot/
rm -rf tmp/digit-joinup-reference_*

# Solr
ddev run solr:download-snapshot
