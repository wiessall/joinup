#!/bin/bash

## Description: Downloads MySQL dump, Solr and Virtuoso snapshots
## Usage: download-databases
## Example: ddev download-databases

# MySQL
ddev run toolkit:download-dump --yes
ddev run mysql:unpack-dump

# Virtuoso
rm -rf .ddev/virtuoso/snapshot/VIRTUOSO_DUMP_*
tar xvf tmp/virtuoso.gz --directory=.ddev/virtuoso/snapshot --strip-components=1

# Solr
rm -rf .ddev/solr-standalone/snapshot/snapshot.digit-joinup/*
tar xvf tmp/solr.gz --directory=.ddev/solr-standalone/snapshot/snapshot.digit-joinup --strip-components=1
