#!/usr/bin/env bash

## Description: Rebuilds the environment from database dumps
## Usage: rebuild
## Example: ddev rebuild

ddev solr:restore
ddev run toolkit:install-clone
ddev virtuoso:clear-data
ddev run dev:install-modules

# UID1 is a regular user but for local development we keep its powers.
ddev drush user:unblock --uid=1
ddev drush user:role:add developer --uid=1
