# Suites defaults.
.paths: &paths
  - '%paths.base%/tests/features'
.contexts: &contexts
  - Drupal\joinup\Context\BootstrapDrupalContext
  - Drupal\DrupalExtension\Context\ConfigContext
  - Drupal\DrupalExtension\Context\DrushContext
  - Drupal\DrupalExtension\Context\MarkupContext
  - Drupal\DrupalExtension\Context\MessageContext
  - Drupal\joinup\Context\AccessibilityContext:
      # See https://github.com/dequelabs/axe-core/blob/HEAD/doc/API.md#axe-core-tags
      # Todo The list of tags should be expanded in ISAICP-8256.
      # See https://citnet.tech.ec.europa.eu/CITnet/jira/browse/ISAICP-8256
      standardTags:
        wcag2a: WCAG 2.0 A
        wcag2aa: WCAG 2.0 AA
        wcag21a: WCAG 2.1 A
        wcag21aa: WCAG 2.1 AA
        wcag141: Criterion 1.4.1
        wcag143: Criterion 1.4.3
        wcag411: Criterion 4.1.1
        EN-301-549: Rule required under EN 301 549
        best-practice: Common accessibility best practices
      # Exclude specific rules globally
      excludeRules:
        - heading-order
      excludeElements:
        # Drupal toolbal.
        - '.toolbar'
        # Third-party code injected in page with Javascript.
        - '.wt-globan--container'
  - Drupal\joinup\Context\AssessmentContext
  - Drupal\joinup\Context\BootstrapContext
  - Drupal\joinup\Context\PrivateMessageContext
  - Drupal\joinup\Context\CalendarContext
  - Drupal\joinup\Context\CollectionContext
  - Drupal\joinup\Context\ContactFormContext
  - Drupal\joinup\Context\ContactInformationContext
  - Drupal\joinup\Context\CustomPageContext
  - Drupal\joinup\Context\DebugContext
  - Drupal\joinup\Context\DigitQaPipelineContext
  - Drupal\joinup\Context\DistributionContext
  - Drupal\joinup\Context\DrupalContext
  - Drupal\joinup\Context\EifContext
  - Drupal\joinup\Context\EntityQueueContext
  - Drupal\joinup\Context\EuplContext
  - Drupal\joinup\Context\FaviconContext
  - Drupal\joinup\Context\FileFieldContext
  - Drupal\joinup\Context\FooterContext
  - Drupal\joinup\Context\GitHubContext
  - Drupal\joinup\Context\HeaderContext
  - Drupal\joinup\Context\HomepageContext
  - Drupal\joinup\Context\InputFilterContext
  - Drupal\joinup\Context\Isa2AnalyticsContext
  - Drupal\joinup\Context\JavascriptContext
  - Drupal\joinup\Context\JoinupCommunityContentContext
  - Drupal\joinup\Context\JoinupContext
  - Drupal\joinup\Context\JoinupCoreContext
  - Drupal\joinup\Context\JoinupDiscussionContext
  - Drupal\joinup\Context\JoinupDocumentContext
  - Drupal\joinup\Context\JoinupEtransContext
  - Drupal\joinup\Context\JoinupEventContext
  - Drupal\joinup\Context\JoinupFeaturedContext
  - Drupal\joinup\Context\JoinupGroupContext
  - Drupal\joinup\Context\JoinupInviteContext
  - Drupal\joinup\Context\JoinupLayoutParagraphsContext
  - Drupal\joinup\Context\JoinupLegalContext
  - Drupal\joinup\Context\JoinupLicenceContext
  - Drupal\joinup\Context\JoinupLogContext
  - Drupal\joinup\Context\JoinupMessageContext
  - Drupal\joinup\Context\JoinupMultilingualContentContext
  - Drupal\joinup\Context\JoinupNewsContext
  - Drupal\joinup\Context\JoinupNewsletterContext
  - Drupal\joinup\Context\JoinupNotificationContext
  - Drupal\joinup\Context\JoinupOSSSolutionContext
  - Drupal\joinup\Context\JoinupParagraphsContext
  - Drupal\joinup\Context\JoinupSearchContext
  - Drupal\joinup\Context\JoinupSeoContext
  - Drupal\joinup\Context\JoinupSubscriptionContext
  - Drupal\joinup\Context\JoinupUserContext
  - Drupal\joinup\Context\JsErrorsContext
  - Drupal\joinup\Context\LinkContext
  - Drupal\joinup\Context\LogRecordsContext
  - Drupal\joinup\Context\MediaContext
  - Drupal\joinup\Context\MetaEntityContext
  - Drupal\joinup\Context\MinkContext
  - Drupal\joinup\Context\ModerationContext
  - Drupal\joinup\Context\OeNewsroomNewsletterContext
  - Drupal\joinup\Context\OwnerContext
  - Drupal\joinup\Context\PollContext
  - Drupal\joinup\Context\PopoverContext
  - Drupal\joinup\Context\RdfContext
  - Drupal\joinup\Context\ReleaseContext
  - Drupal\joinup\Context\RssContext
  - Drupal\joinup\Context\ScreenshotContext:
      localDir: ${behat.screenshots.local.dir}
  - Drupal\joinup\Context\SolutionContext
  - Drupal\joinup\Context\SpdxContext
  - Drupal\joinup\Context\TagifyContext
  - Drupal\joinup\Context\UpdateContext
  - Drupal\joinup\Context\WebformContext
  - Drupal\joinup\Context\WysiwygContext
  - Drupal\Tests\cas_mock_server\Context\CasMockServerContext:
      attributes_map:
        firstName: First name
        lastName: Last name
  - Drupal\Tests\message_digest\Behat\MessageDigestContext
  - Drupal\Tests\oe_webtools\Behat\WebtoolsETransContext
  - Drupal\Tests\oe_webtools\Behat\WebtoolsMapsContext
  - Drupal\joinup\Context\FeatureContext
  - LoversOfBehat\TableExtension\Context\TableContext

default:
  # Suites to run with the site installed with content.
  suites:
    default:
      contexts: *contexts
      paths: *paths
      filters:
        tags: '~@wip&&@group-clone'
  extensions:
    Drupal\MinkExtension:
      base_url: ${env.DRUPAL_BASE_URL}
      ajax_timeout: 10
      files_path: ${joinup.dir}/tests/fixtures/files
      browserkit_http:
        guzzle_request_options:
          verify: false
      javascript_session: selenium2
      browser_name: ${behat.browser_name}
      selenium2:
        wd_host: ${behat.selenium.webdriver_url}
        capabilities:
          browser: chrome
          nativeEvents: true
          marionette: true
          browserName: chrome
          version: '*'
          extra_capabilities:
            loggingPrefs:
              performance: ALL
              browser: ALL
            "goog:chromeOptions":
              w3c: true
              args:
                # Window size (sync with docker selenium).
                - '--window-size=1600,1200'
                # Additional test-related params.
                - '--no-sandbox'
                - '--disable-setuid-sandbox'
                - '--disable-web-security'
                - '--disable-dev-shm-usage'
                - '--disable-gpu'
                - '--disable-background-timer-throttling'
                - '--disable-backgrounding-occluded-windows'
                - '--disable-renderer-backgrounding'
                - '--disable-software-rasterizer'
                - '--DNS-prefetch-disable'
                - '--disable-extensions'
                - '--disable-infobars'
                - '--disable-translate'
                - '--incognito'
                - '--no-first-run'
                - '--disable-popup-blocking'
                - '--test-type'
    LoversOfBehat\TableExtension:
      table_map:
        'actions log report': 'table'
        'EU OSS Catalogue administration': '[data-drupal-selector="views-form-eu-oss-catalogue-admin-admin"] table.vbo-table'
        'announcement list': '.announcement-list table'
        'group menu edit table': '#menu-overview'
        'eif recommendations': '.eif-recommendations table'
        'form table': '.form-table'
        'member administration': '.og-members-overview table'
        'member permissions': '#joinup-group-membership-permissions-info table[data-drupal-selector="edit-permissions"]'
        'licence comparer': 'table[data-drupal-selector="licence-comparer"]'
        'subscribers report': 'table'
        'media admin': 'form[data-drupal-selector="views-form-media-media-page-list"] table'
        'manage solutions': '.view-id-manage_collection_solutions.view-display-id-manage_solutions table'
        'Ventuno media library': '.view-id-media_library.view-display-id-widget form table'
        'OSS catalogue list': '.oss-catalogue-list table'
        'Owner IEF': '.field--name-owner .ief-entity-table'
        'Users': 'table'
    Drupal\DrupalExtension:
      api_driver: 'drupal'
      blackbox: ~
      region_map:
        Administration toolbar: '#toolbar-administration'
        Bookmark block: '#block-ventuno-bookmark'
        Comment: 'section.comments'
        Contact information inline form: '#edit-contact-wrapper'
        Content buttons: '.node-form .form-actions'
        Content listing field filter form: '.field--name-content-listing'
        Content: 'main .layout-content'
        Cookie consent banner: '#cookie-consent-banner'
        Choose component: '.lp-builder lpb-btn--add'
        Entity actions: '.block-joinup-local-tasks-block,#block-ventuno-three-dots-menu'
        Explore block: '.block-joinup-front-page-explore-block'
        Featured: '.region-featured'
        Footer: 'footer.page__footer'
        Mobile menu: '.joinup-navbar ul.navbar-nav .mmenu-nav__menu'
        Header: '.region-header'
        Homepage topics: '.view-homepage-topics'
        In the spotlight: '.block-views-blockin-the-spotlight-block'
        IOPE Menu: '#block-iope-navigation'
        Upcoming event: '.block-views-blockupcoming-event-block'
        Layout paragraphs dialog buttons: '.ui-dialog-buttonpane'
        Layout paragraphs widget: '.field--type-entity-reference-revisions .fieldset-wrapper .js-lpb-component'
        Left sidebar: 'aside.layout-sidebar'
        Like block: '#block-ventuno-like'
        Members admin form actions: '#edit-action'
        Members admin form header: '#edit-header'
        Modal buttons: '.ui-dialog-buttonpane'
        Modal content: '.ui-dialog-content'
        Modal title: '.ui-dialog-titlebar'
        Most recent solutions: '#block-views-block-oss-solutions-listing-most-recent'
        Most active solutions : '#block-views-block-oss-solutions-listing-most-active'
        My unpublished content area: '.block-user-unpublished'
        Navigation bar: '.joinup-navbar'
        Navigation menu: '#block-ventuno-navigation'
        Page title: '#block-ventuno-pagetitle'
        Pager: 'nav.pager'
        Plus button menu: '#block-ventuno-joinup-add-content'
        Primary menu: '.region-primary-menu'
        Private message autocomplete results: '#private-message-create-form-wrapper+.ui-autocomplete'
        Quick links: '.block-group-menu-blockquick-links'
        Related solutions: '.field--name-related-solutions'
        Search filters: '.joinup-search-filters'
        Statistics: '#block-ventuno-statistics'
        Table of contents: '#block-ventuno-table-of-contents'
        Table of contents outline: '#block-ventuno-toc-outline'
        Top Bar: '.region-top-bar'
        Draft unpublished block: '#block-ventuno-unpublished-draft'
        Proposed unpublished block: '#block-ventuno-unpublished-proposed'
        Popover: '#block-ventuno-languagepicker'
        Other unpublished block: '#block-ventuno-unpublished-other'
        Visually hidden title: '#block-ventuno-pagetitle .visually-hidden'
        Private messages inbox: '#block-ventuno-privatemessage-inbox .private-message-thread--full-container'
        Private messages conversation: '#private-message-page .private-message-thread-messages'
      drupal:
        drupal_root: ${joinup.site_dir}
      drush:
        root: ${joinup.site_dir}
      selectors:
        message_selector: '.alert, .messages'
        error_message_selector: '.alert.alert--error, .messages.messages--error, .alert.alert-danger'
        success_message_selector: '.alert.alert--status, .messages.messages--status, .alert.alert-success'
        warning_message_selector: '.alert.alert--warning, .messages.messages--warning, .alert.alert-warning'
        login_form_selector: '#user-login-form'
      subcontexts:
        autoload: false
        paths: []
      text:
        log_in: 'Sign in'
        log_out: 'Sign out'
        username_field: 'Email or username'
    FriendsOfBehat\ServiceContainerExtension:
      imports:
        - ${joinup.dir}/vendor/drupaltest/behat-one-time-login/behat.services.yml
        - ${joinup.dir}/tests/behat.services.yml
  formatters:
    ${behat.formatter.name}: ~

# Dedicated profile to detect unused steps, see testing:unused-behat.
unused:
  extensions:
    NicWortel\BehatUnusedStepDefinitionsExtension\Extension:
      ignorePatternAliases: true
      filters:
        include:
          - '/Drupal\\joinup\\Context/'
        exclude:
          - '/Drupal\\joinup\\Context\\DebugContext/'
          - '/Drupal\\joinup\\Context\\ScreenshotContext/'
          - '/Drupal\\joinup\\Context\\MinkContext::clickLink/'
  suites:
    default:
      filters: ~

# Suites to run with the site installed without content.
clean:
  suites:
    group_a:
      contexts: *contexts
      paths: *paths
      filters:
        tags: '~@wip&&@group-a'
    group_b:
      contexts: *contexts
      paths: *paths
      filters:
        tags: '~@wip&&@group-b'
    group_c:
      contexts: *contexts
      paths: *paths
      filters:
        tags: '~@wip&&@group-c'
    group_d:
      contexts: *contexts
      paths: *paths
      filters:
        tags: '~@wip&&@group-d'
    group_e:
      contexts: *contexts
      paths: *paths
      filters:
        tags: '~@wip&&@group-e'
    group_f:
      contexts: *contexts
      paths: *paths
      filters:
        tags: '~@wip&&@group-f'
    group_g:
      contexts: *contexts
      paths: *paths
      filters:
        tags: '~@wip&&@group-g'
    group_h:
      contexts: *contexts
      paths: *paths
      filters:
        tags: '~@wip&&@group-h'
    group_i:
      contexts: *contexts
      paths: *paths
      filters:
        tags: '~@wip&&@group-i'
    group_other:
      contexts: *contexts
      paths: *paths
      filters:
        tags: '~@wip&&~@group-a&&~@group-b&&~@group-c&&~@group-d&&~@group-e&&~@group-f&&~@group-g&&~@group-h&&~@group-i&&~@group-clone'
