# Default environment variables for Joinup.
#
# Declaring sensitive data in environment variables is an industry standard, as
# it's a very friendly mechanism for configuring the applications on different
# environments and in continuous integration flows, as well. Depending on the
# development environment or developer practices, the system environment
# variables can be assigned in different ways, most simple is declaring them in
# the `~/.bashrc` or `~/.zshrc` files on Bash respectively Z shells. But some
# prefer to keep them inside the project's directory tree, as they are project
# specific variables. In order to do so, just copy the `.env.example` file as
# `.env` and fill in the sensitive values (secrets). Note that the `.env` file
# is not under VCS control and should not be committed.

# The defaults used in this file are designed to work out of the box with our
# CI pipeline. For local developement some environment variables are overridden
# by DDEV in `.ddev/.env` file.

# Drupal settings.

DRUPAL_BASE_URL=http://web:8080/web
# Always relative to Drupal webroot.
# Always relative to Drupal webroot.
DRUPAL_PRIVATE_FILE_SYSTEM=../private
# Absolute or relative to project root.
DRUPAL_FILE_TEMP_PATH=../tmp
DRUPAL_SYSTEM_LOG_ERROR_LEVEL=verbose
DRUPAL_SITE_PROFILE=joinup
DRUPAL_SITE_NAME=Joinup
DRUPAL_SITE_MAIL=joinup@example.com
DRUPAL_ACCOUNT_NAME=admin
DRUPAL_ACCOUNT_PASSWORD=admin
# Used in `$settings['trusted_host_patterns']`, if configured.
DRUPAL_TRUSTED_HOST_PATTERNS='^(web|localhost|joinup.test)$'

# Drupal MySQL connection.
DRUPAL_DATABASE_HOST=mysql
DRUPAL_DATABASE_PORT=3306
DRUPAL_DATABASE_USERNAME=root
DRUPAL_DATABASE_PASSWORD=
DRUPAL_DATABASE_NAME=joinup

# SPARQL connection.
DRUPAL_SPARQL_HOSTNAME=sparql
DRUPAL_SPARQL_PORT=8890
DRUPAL_SPARQL_USER=dba
DRUPAL_SPARQL_PASSWORD=dba

# Mail transport.
DRUPAL_MAIL_SENDMAIL_PATH=/scripts/sendmail.pl
DRUPAL_MAIL_SENDMAIL_MODE=bs

# Coma delimited list of Drupal requirement keys to be ignore when running the
# check_status_report.sh script as part of deployment. If the variable is
# omitted, it defaults to 'update status,joinup_core_root_user_blocked,
# search_api_solr_schema_joinup_modifications'.
# See scripts/check_status_report.sh, .opts.yml
# Default production ignores.
DRUPAL_STATUS_REPORT_IGNORE="update status,joinup_core_root_user_blocked,metatag_maintenance_mode,search_api_solr_schema_joinup_modifications,webform_libraries,output_buffering"
# Specific testing pipeline ignores. Note, that all these ignored requirements
# will be investigated in ISAICP-7232.
# See https://citnet.tech.ec.europa.eu/CITnet/jira/browse/ISAICP-7232
DRUPAL_STATUS_REPORT_IGNORE="${DRUPAL_STATUS_REPORT_IGNORE},configuration_files,cron,dropsolid_purge_configuration,maxage,temporary:///.htaccess,file system"

# Apache Solr endpoint. Naming of variables is related to the infrastructure.
# Do NOT change.
SEARCH_API_SERVER_SS_SOLR_SCHEME=http
SEARCH_API_SERVER_SS_SOLR_HOST=solr
SEARCH_API_SERVER_SS_SOLR_PATH="/solr"
SEARCH_API_SERVER_SS_SOLR_CORE=digit-joinup
SEARCH_API_SERVER_SS_SOLR_PORT="8983"

# Memcache: A comma separated list of Memcache hosts. The port is mandatory.
DRUPAL_MEMCACHE_HOSTS=memcached:11211

# Drush.
DRUSH_VERBOSE=no

# OpenEuropa Webtools Analytics.
OE_WEBTOOLS_ANALYTICS_SITE_ID=1
OE_WEBTOOLS_ANALYTICS_SITE_PATH=joinup.uat.fpfis.tech.ec.europa.eu
OE_WEBTOOLS_ANALYTICS_SITE_INSTANCE=testing

# Newsroom private keys. This is a JSON array with the universe ID as the key and the key as
# the value e.g. "{'joinup': 'some-key-here'}"
OE_NEWSROOM_UNIVERSE_KEYS='{}'

# Artifacts dir, used to store test artifacts. Either absolute or relative to
# the webroot directory. Configure it in .env file. E.g.:
ARTIFACTS_DIR="${DRUPAL_FILE_TEMP_PATH:-../tmp}/artifacts"

# Monolog logs file paths. This is ONLY used in production and acceptance. Items
# are separated by semi-colon. The Monolog handler ID is separated by its path
# by a colon.
# DRUPAL_MONOLOG_PATHS=default_handler:/var/log/drupal/default.log;php_handler:/var/log/drupal/php.log

# Testing webdriver.
WEBDRIVER_URL=http://selenium:4444/wd/hub

# PHPUnit configuration. These environment variables are documented in the
# configuration file (./phpunit.xml).
SIMPLETEST_BASE_URL=http://web:8080/web
SIMPLETEST_DB=mysql://root@mysql:3306/drupal
SIMPLETEST_SPARQL_DB=sparql://sparql:8890?module=sparql_entity_storage
BROWSERTEST_OUTPUT_DIRECTORY=./web/sites/simpletest/browser_output
BROWSERTEST_OUTPUT_BASE_URL=http://web:8080/web
SYMFONY_DEPRECATIONS_HELPER=max[total]=0&ignoreFile=core/.deprecation-ignore.txt
MINK_DRIVER_CLASS=
MINK_DRIVER_ARGS=
MINK_DRIVER_ARGS_PHANTOMJS=
MINK_DRIVER_ARGS_WEBDRIVER="[\"chrome\", { \"chromeOptions\": { \"w3c\": false } }, \"http://selenium:4444/wd/hub\"]"
DTT_BASE_URL=http://web:8080/web
DTT_API_URL=http://selenium:4444/wd/hub
DTT_MINK_DRIVER_ARGS="['chrome', null, 'http://selenium:4444/wd/hub']"

# Used only in DIGIT production & acceptance.
# See https://github.com/openeuropa/oe_dashboard_agent/blob/master/README.md
# DASHBOARD_TOKEN=
# DASHBOARD_ALLOWED_IPS=

# COMPOSER_DISABLE_NODE_DEPENDENCIES variable should be used only in .env file.
# Set 1 to prevent Composer to install or update the Node dependencies:
# COMPOSER_DISABLE_NODE_DEPENDENCIES=1
# This is useful for backend development as NPM takes too much to run and, in
# the most of the cases, is not needed.

# Sets up a variable to identify that the site is in a dev container. Note that
# there is already the IS_DDEV_PROJECT=true variable which covers almost the
# same use case, however, since we are fighting to adopt ddev in the bot, we
# need to have a separate variable to identify that the site is in a local dev
# environment.
DEV_WARNING_BLOCK_DISABLE=1
