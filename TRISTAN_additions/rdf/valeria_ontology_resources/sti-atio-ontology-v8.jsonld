  {
    "@id": "https://sti-portal.fao.org/ontology/sti-atio#Innovation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A specific real-world agrifood technology, practice, process,\n    policy instrument, or institutional arrangement that constitutes an innovation.\n    Represents one implementation -- not an abstract type (see sti_atio:InnovationFamily).\n    The central knowledge unit of the ATIO KB."
      },
      {
        "@language": "en",
        "@value": "Subclass of schema:Product (v0.6, replaces owl:equivalentClass\n    schema:SoftwareApplication). Every ATIO innovation is a product in the\n    broad schema.org sense. More specific alignments apply to subtypes."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://sti-portal.fao.org/ontology/sti-atio"
