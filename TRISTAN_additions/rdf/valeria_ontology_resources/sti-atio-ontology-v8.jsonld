  {
    "@id": "https://sti-portal.fao.org/ontology/sti-atio#AIExtractedInnovation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The intermediate bridge entity produced by the AI enrichment pipeline.\n    Holds all fields from the source record(s) plus AI-generated values for\n    fields absent or incomplete in the source. May be linked to multiple source\n    records (in multi-source merging scenarios). Acts as the buffer between\n    raw ingestion and curated publication -- allowing enrichment experiments\n    without affecting the published record.\n    Implements prov:Entity derived from sti_atio:SourceRecord."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://sti-portal.fao.org/ontology/sti-atio"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "AI-Extracted Innovation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/prov#Entity"
      }
    ]
  },
