      {
        "@id": "https://sti-portal.fao.org/ontology/sti-atio#InnovationType"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://schema.org/category"
      }
    ],
    "https://sti-portal.fao.org/ontology/sti-atio#claimEligibilityRationale": [
      {
        "@language": "en",
        "@value": "Source databases use heterogeneous\n    innovation type taxonomies. Alignment to ATIO types is approximate;\n    original source classifications are preserved via FieldClaim."
      }
    ],
    "https://sti-portal.fao.org/ontology/sti-atio#claimEligible": [
