  {
    "@id": "https://sti-portal.fao.org/ontology/sti-atio#InnovationRecord",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The information object (data record) describing a\n    sti_atio:Innovation. Carries all data-management concerns:\n    provenance, versioning, curation, access control, field claims, QA.\n\n    sti_atio:Innovation is the real-world entity — pure semantic content.\n    sti_atio:InnovationRecord is the information artifact — prov:Entity,\n    foaf:Document. They are linked via sti_atio:isDescribedBy\n    (subPropertyOf foaf:isPrimaryTopicOf).\n\n    In Drupal/JoinUp this is the node--innovation entity.\n    One innovation may be described by multiple records (one per source\n    before curator merge; one published record after)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://sti-portal.fao.org/ontology/sti-atio"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Innovation Record"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/prov#Entity"
      },
      {
        "@id": "http://xmlns.com/foaf/0.1/Document"
      }
    ]
  },
  {
    "@id": "https://sti-portal.fao.org/ontology/sti-atio#originCountry",
