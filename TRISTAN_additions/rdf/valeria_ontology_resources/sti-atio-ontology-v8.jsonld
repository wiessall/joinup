  {
    "@id": "https://sti-portal.fao.org/ontology/sti-atio#rule/InferClaimScheme",
    "@type": [
      "https://sti-portal.fao.org/ontology/sti-atio#SPARQLRule"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "SPARQL CONSTRUCT rule. Run against the provenance named graph.\n    For each FieldClaim, find the DataSource it ultimately came from\n    (via SourceRecord), look up that source's FieldSchemeUsage for the\n    claimed property, and assert sti_atio:inferredScheme on the claim."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://sti-portal.fao.org/ontology/sti-atio"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Infer FieldClaim scheme from DataSource usage declaration"
      }
    ],
    "https://sti-portal.fao.org/ontology/sti-atio#sparqlConstruct": [
      {
        "@value": "\nPREFIX sti_atio:  <https://sti-portal.fao.org/ontology/sti-atio#>\n\nCONSTRUCT {\n    ?claim sti_atio:inferredScheme ?scheme .\n}\nWHERE {\n    # The claim and its property\n    ?claim a sti_atio:FieldClaim ;\n           sti_atio:claimProperty  ?prop ;\n           sti_atio:claimedBy      ?sourceRecord .\n\n    # Trace back to the DataSource\n    ?sourceRecord sti_atio:harvestedFrom ?dataSource .\n\n    # Look up the scheme the DataSource declared for this property\n    ?dataSource sti_atio:usesSchemeForField ?usage .\n    ?usage sti_atio:forProperty ?prop ;\n           sti_atio:usesScheme   ?scheme .\n}\n"
      }
    ]
  },
