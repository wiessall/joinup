  {
    "@id": "https://sti-portal.fao.org/ontology/sti-atio#allowAIUpdate",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Flag indicating whether the AI enrichment pipeline may overwrite\n    fields in this record on future ingestion runs. When false, curated fields\n    are protected ('do not overwrite by AI')."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://sti-portal.fao.org/ontology/sti-atio#Innovation"
