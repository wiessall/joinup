  {
    "@id": "https://sti-portal.fao.org/ontology/sti-atio#IDIAScalingLevel",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A concept in the IDIA 6-stage scaling continuum\n    (<https://sti-portal.fao.org/ontology/sti-atio#scheme/idia-stages>). Suited to social, institutional, and\n    policy innovations. Managed in VocBench."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://sti-portal.fao.org/ontology/sti-atio"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "IDIA Scaling Stage"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/2004/02/skos/core#Concept"
      },
      {
        "@id": "https://sti-portal.fao.org/ontology/sti-atio#MaturityLevel"
      }
    ]
  },
  {
    "@id": "https://sti-portal.fao.org/ontology/sti-atio#MaturityLevel",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Union range for sti_atio:readinessLevel. Any SKOS concept that is\n    a member of a recognised readiness or scaling framework qualifies.\n    Currently two constituent classes (one per supported scheme):\n      sti_atio:ReadinessLevel   -- concepts in <https://sti-portal.fao.org/ontology/sti-atio#scheme/cgiar-trl>\n      sti_atio:IDIAScalingLevel -- concepts in <https://sti-portal.fao.org/ontology/sti-atio#scheme/idia-stages>\n    The union is declared via owl:unionOf to allow OWL reasoners to\n    validate that a referenced concept belongs to at least one scheme."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://sti-portal.fao.org/ontology/sti-atio"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Maturity / Readiness Level"
      }
    ],
    "http://www.w3.org/2002/07/owl#unionOf": [
      {
        "@list": [
          {
            "@id": "https://sti-portal.fao.org/ontology/sti-atio#ReadinessLevel"
          },
          {
            "@id": "https://sti-portal.fao.org/ontology/sti-atio#IDIAScalingLevel"
          }
        ]
      }
    ]
  },
  {
    "@id": "https://sti-portal.fao.org/ontology/sti-atio#sourceTaxonomyURI",
