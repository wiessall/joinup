  {
    "@id": "https://sti-portal.fao.org/ontology/sti-atio#claimSubject",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The real-world sti_atio:Innovation that this FieldClaim\n    is about. Explicitly separates the semantic subject (Innovation) from\n    the record that carries the claim (InnovationRecord).\n\n    Both of the following hold simultaneously and serve different purposes:\n\n      sti_atio:InnovationRecord --hasFieldClaim--> sti_atio:FieldClaim\n        (grouping/container: which record is associated with this claim)\n\n      sti_atio:FieldClaim --claimSubject--> sti_atio:Innovation\n        (semantic: which real-world thing this claim is about)\n\n    FieldClaims are reified property assertions: they sit in the data/\n    provenance layer but their subject is a real-world entity. After\n    curator resolution the canonical value is asserted directly on\n    sti_atio:Innovation. The FieldClaim provides the evidence trail."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://sti-portal.fao.org/ontology/sti-atio#FieldClaim"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://sti-portal.fao.org/ontology/sti-atio"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "claim subject"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://sti-portal.fao.org/ontology/sti-atio#Innovation"
      }
    ]
  },
