  {
    "@id": "https://sti-portal.fao.org/ontology/sti-atio#FieldSchemeUsage",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A declaration that a specific data source uses a specific\n    vocabulary scheme for values of a specific RDF property.\n    Declared once at onboarding on the sti_atio:DataSource node.\n    Enables scheme inference on all sti_atio:FieldClaim nodes produced from\n    that source for that property, without repeating scheme information\n    at the individual claim level.\n\n    Example: CGIAR Catalog uses cgiar-catalog/vocab/scaling-readiness\n    for the sti_atio:readinessLevel property. Once declared, every FieldClaim\n    originating from CGIAR Catalog records for readinessLevel automatically\n    has its scheme resolved by inference."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://sti-portal.fao.org/ontology/sti-atio"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Field Scheme Usage"
      }
    ]
  },
