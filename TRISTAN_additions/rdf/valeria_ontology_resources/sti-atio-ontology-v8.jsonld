      {
        "@language": "en",
        "@value": "AI Enrichment Activity"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/prov#Activity"
      }
    ]
  },
  {
    "@id": "https://sti-portal.fao.org/ontology/sti-atio#BundleRelation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A reified typed relation between two or more innovations that are\n    complementary, interdependent, sequentially deployed, or frequently co-cited.\n    Reification is semantically appropriate here: the bundle type and evidence are\n    properties of the relation itself, not of either participating innovation."
      },
      {
        "@language": "en",
        "@value": "Loose alignment to schema:ProductCollection. Declarative\n    only; sti_atio:BundleRelation retains its typed properties."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://sti-portal.fao.org/ontology/sti-atio"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Innovation Bundle Relation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://schema.org/ProductCollection"
      }
    ]
  },
