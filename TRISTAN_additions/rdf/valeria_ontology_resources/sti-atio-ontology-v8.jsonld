  {
    "@id": "https://sti-portal.fao.org/ontology/sti-atio#rule/InferClaimSchemeFromString",
    "@type": [
      "https://sti-portal.fao.org/ontology/sti-atio#SPARQLRule"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Fallback SPARQL CONSTRUCT rule for FieldClaim nodes that carry\n    sti_atio:claimField (string) instead of sti_atio:claimProperty (URI).\n    Requires sti_atio:fieldNameString on each property to bridge string to URI.\n    Less efficient than the URI-based rule; migrate to claimProperty when possible."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://sti-portal.fao.org/ontology/sti-atio"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Infer FieldClaim scheme (string field name fallback)"
      }
    ],
    "https://sti-portal.fao.org/ontology/sti-atio#sparqlConstruct": [
      {
        "@value": "\nPREFIX sti_atio:  <https://sti-portal.fao.org/ontology/sti-atio#>\nPREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>\n\nCONSTRUCT {\n    ?claim sti_atio:inferredScheme ?scheme .\n}\nWHERE {\n    ?claim a sti_atio:FieldClaim ;\n           sti_atio:claimField     ?fieldName ;\n           sti_atio:claimedBy      ?sourceRecord .\n    ?sourceRecord sti_atio:harvestedFrom ?dataSource .\n    ?dataSource sti_atio:usesSchemeForField ?usage .\n    ?usage sti_atio:forProperty ?prop ;\n           sti_atio:usesScheme   ?scheme .\n    # Bridge string field name to property URI via declared label\n    ?prop sti_atio:fieldNameString ?fieldName .\n}\n"
      }
    ]
  },
  {
    "@id": "https://sti-portal.fao.org/ontology/sti-atio#HarvestingMethod",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "API | file-import | scraping | crowdsourcing | manual-entry"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://sti-portal.fao.org/ontology/sti-atio"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Harvesting Method"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/2004/02/skos/core#Concept"
      }
    ]
  },
  {
    "@id": "https://sti-portal.fao.org/ontology/sti-atio#FieldClaim",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A claim about the value of a specific field of an innovation,\n    attributed to a specific source record. Allows multiple, potentially divergent\n    claims on the same field of the same innovation from different source records\n    to coexist. The canonical (published) value on sti_atio:Innovation is the\n    curator-selected synthesis; sti_atio:FieldClaim preserves the full divergence\n    for auditability, research, and re-ingestion.\n    Semantically: a reified statement (cf. RDF reification / named graph pattern)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://sti-portal.fao.org/ontology/sti-atio"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Field Claim"
      }
    ]
  },
  {
    "@id": "https://sti-portal.fao.org/ontology/sti-atio#SPARQLRule",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A SPARQL CONSTRUCT rule to be executed by the triplestore inference engine."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://sti-portal.fao.org/ontology/sti-atio"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "SPARQL Rule"
      }
    ]
  },
  {
    "@id": "https://sti-portal.fao.org/ontology/sti-atio#TaxonomyMapping",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Records how a classification term in a source system's original\n    vocabulary maps to the corresponding ATIO taxonomy concept. Preserves the\n    original classification even when it does not have a precise ATIO equivalent.\n    Enables multi-system taxonomy alignment (CGIAR, IDIA, GARDIAN, partner-specific)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://sti-portal.fao.org/ontology/sti-atio"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Source Taxonomy Mapping"
      }
    ]
  },
  {
    "@id": "https://sti-portal.fao.org/ontology/sti-atio#ThematicAreaScheme",
