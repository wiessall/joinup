  {
    "@id": "https://sti-portal.fao.org/ontology/sti-atio#AIEnrichmentActivity",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A specific run of the AI enrichment pipeline processing one or more\n    source records. Implements prov:Activity. The combination of agent (AI model),\n    prompt version, and execution timestamp makes each enrichment activity\n    deterministic and auditable."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://sti-portal.fao.org/ontology/sti-atio"
      }
    ],
