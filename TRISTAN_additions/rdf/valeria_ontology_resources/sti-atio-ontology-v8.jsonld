  {
    "@id": "https://sti-portal.fao.org/ontology/sti-atio#shapes/InnovationShape",
    "@type": [
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "_:n3198136beea34c28953f73fc60edf9f0b7"
      },
      {
        "@id": "_:n3198136beea34c28953f73fc60edf9f0b9"
      }
    ],
    "http://www.w3.org/ns/shacl#targetClass": [
      {
        "@id": "https://sti-portal.fao.org/ontology/sti-atio#Innovation"
      }
    ]
  },
  {
    "@id": "_:n3198136beea34c28953f73fc60edf9f0b7",
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "http://www.w3.org/2004/02/skos/core#Concept"
      }
    ],
    "http://www.w3.org/ns/shacl#description": [
      {
        "@language": "en",
        "@value": "Value must be a skos:Concept whose skos:inScheme\n        is typed as sti_atio:MaturityScheme. To use a new framework, declare\n        its ConceptScheme as sti_atio:MaturityScheme -- no shape edit needed."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "readiness level"
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://sti-portal.fao.org/ontology/sti-atio#readinessLevel"
      }
    ],
    "http://www.w3.org/ns/shacl#sparql": [
      {
        "@id": "_:n3198136beea34c28953f73fc60edf9f0b8"
      }
    ]
  },
  {
    "@id": "_:n3198136beea34c28953f73fc60edf9f0b8",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLConstraint"
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "readinessLevel value {$value} does not belong to any\n            registered sti_atio:MaturityScheme (checked via skos:inScheme and\n            sti_atio:inferredScheme). Declare its ConceptScheme as sti_atio:MaturityScheme,\n            or add a FieldSchemeUsage declaration to the DataSource."
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n                PREFIX sti_atio: <https://sti-portal.fao.org/ontology/sti-atio#>\n                PREFIX skos: <http://www.w3.org/2004/02/skos/core#>\n                SELECT $this ?value WHERE {\n                    $this sti_atio:readinessLevel ?value .\n                    FILTER NOT EXISTS {\n                        # Path 1: concept carries explicit skos:inScheme\n                        ?value skos:inScheme ?scheme1 .\n                        ?scheme1 a sti_atio:MaturityScheme .\n                    }\n                    FILTER NOT EXISTS {\n                        # Path 2: scheme inferred from DataSource FieldSchemeUsage\n                        ?claim a sti_atio:FieldClaim ;\n                               sti_atio:claimProperty sti_atio:readinessLevel ;\n                               sti_atio:claimRefValue ?value ;\n                               sti_atio:inferredScheme ?scheme2 .\n                        ?scheme2 a sti_atio:MaturityScheme .\n                    }\n                }\n            "
      }
    ]
  },
  {
    "@id": "_:n3198136beea34c28953f73fc60edf9f0b9",
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "http://www.w3.org/2004/02/skos/core#Concept"
      }
    ],
    "http://www.w3.org/ns/shacl#description": [
      {
        "@language": "en",
        "@value": "Value must be a skos:Concept whose skos:inScheme\n        is typed as sti_atio:AdoptionScheme."
      }
    ],
    "http://www.w3.org/ns/shacl#name": [
      {
        "@language": "en",
        "@value": "adoption level"
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://sti-portal.fao.org/ontology/sti-atio#adoptionLevel"
      }
    ],
    "http://www.w3.org/ns/shacl#sparql": [
      {
        "@id": "_:n3198136beea34c28953f73fc60edf9f0b10"
      }
    ]
  },
  {
    "@id": "_:n3198136beea34c28953f73fc60edf9f0b10",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLConstraint"
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "adoptionLevel value {$value} does not belong to any\n            registered sti_atio:AdoptionScheme."
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "\n                SELECT $this ?value WHERE {\n                    $this sti_atio:adoptionLevel ?value .\n                    FILTER NOT EXISTS {\n                        ?value skos:inScheme ?scheme .\n                        ?scheme a sti_atio:AdoptionScheme .\n                    }\n                }\n            "
      }
    ]
  },
