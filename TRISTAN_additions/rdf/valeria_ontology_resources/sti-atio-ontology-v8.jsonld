  {
    "@id": "https://sti-portal.fao.org/ontology/sti-atio#InnovationSnapshot",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A time-stamped representation of the known real-world\n    state of a sti_atio:Innovation at a specific point in time.\n    Captures values of key real-world properties as they were known or\n    assessed at a specific date: readiness level, adoption level,\n    adoption countries, estimated user base.\n\n    DISTINCT from InnovationVersion (record versioning).\n    InnovationSnapshot tracks real-world evolution;\n    InnovationVersion tracks data record changes.\n\n    Example: Innovation X was TRL-5 in 2022, TRL-7 in 2024, TRL-9 in 2026.\n    Each assessment is an InnovationSnapshot.\n    The corresponding InnovationVersions record who edited the database\n    record when and which data fields were changed."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://sti-portal.fao.org/ontology/sti-atio"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Innovation Snapshot"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/prov#Entity"
      }
    ]
  },
