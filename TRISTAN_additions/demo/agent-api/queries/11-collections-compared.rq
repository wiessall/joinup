# How do the properties of two collections relate?
#
#   direct:          property A <--skos--> property B
#   via ATIO field:  property A --skos--> atio field <--skos-- property B
#
# __COLLECTION_A__ and __COLLECTION_B__ are collection URIs. A property
# belongs to a collection if that collection makes at least one claim with it.
# A route through an ATIO field weighs the product of its two steps.
PREFIX sti:  <https://sti-portal.fao.org/sti#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?propertyA ?labelA ?route ?relation ?via ?viaLabel ?relation2 ?weight ?propertyB ?labelB
WHERE {
  {
    VALUES (?relation ?weight) {
      (skos:exactMatch 1.0) (skos:closeMatch 0.8) (skos:broadMatch 0.6)
      (skos:narrowMatch 0.6) (skos:relatedMatch 0.4)
    }
    { ?propertyA ?relation ?propertyB } UNION { ?propertyB ?relation ?propertyA }
    BIND("direct" AS ?route)
  }
  UNION
  {
    VALUES (?relation ?w1) {
      (skos:exactMatch 1.0) (skos:closeMatch 0.8) (skos:broadMatch 0.6)
      (skos:narrowMatch 0.6) (skos:relatedMatch 0.4)
    }
    VALUES (?relation2 ?w2) {
      (skos:exactMatch 1.0) (skos:closeMatch 0.8) (skos:broadMatch 0.6)
      (skos:narrowMatch 0.6) (skos:relatedMatch 0.4)
    }
    ?propertyA ?relation ?via .
    ?propertyB ?relation2 ?via .
    FILTER(STRSTARTS(STR(?via), "https://sti-portal.fao.org/atio#"))
    OPTIONAL { ?via rdfs:label ?viaLabel }
    BIND(?w1 * ?w2 AS ?weight)
    BIND("via ATIO field" AS ?route)
  }
  FILTER(?propertyA != ?propertyB)
  FILTER EXISTS { ?claimA sti:claimProperty ?propertyA ; sti:claimedBy <__COLLECTION_A__> }
  FILTER EXISTS { ?claimB sti:claimProperty ?propertyB ; sti:claimedBy <__COLLECTION_B__> }
  OPTIONAL { ?propertyA skos:prefLabel|rdfs:label ?labelA }
  OPTIONAL { ?propertyB skos:prefLabel|rdfs:label ?labelB }
}
ORDER BY DESC(?weight) ?labelA
