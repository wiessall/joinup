# The semantic map itself: every SKOS mapping between collection properties,
# and from collection properties to ATIO fields, with labels and weights.
# No parameters. Reads only the mappings graph plus labels, so it is fast.
#
# Weights are a convention: exactMatch 1.0, closeMatch 0.8,
# broadMatch/narrowMatch 0.6, relatedMatch 0.4.
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?from ?fromLabel ?relation ?weight ?to ?toLabel ?kind
WHERE {
  VALUES (?relation ?weight) {
    (skos:exactMatch 1.0) (skos:closeMatch 0.8) (skos:broadMatch 0.6)
    (skos:narrowMatch 0.6) (skos:relatedMatch 0.4)
  }
  GRAPH <https://sti-portal.fao.org/graph/mappings> { ?from ?relation ?to }
  OPTIONAL { ?from skos:prefLabel|rdfs:label ?fromLabel }
  OPTIONAL { ?to skos:prefLabel|rdfs:label ?toLabel }
  BIND(IF(STRSTARTS(STR(?to), "https://sti-portal.fao.org/atio#"),
          "property to ATIO field", "property to property") AS ?kind)
}
ORDER BY ?kind ?fromLabel DESC(?weight)
