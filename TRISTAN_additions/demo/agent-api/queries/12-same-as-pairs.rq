# Every pair of source records marked as the same innovation, once per pair,
# with the collection each record belongs to. No parameters.
#
# "Same" is a claim on a source record whose value is another source record.
# Both records carry one; the FILTER keeps one row per pair.
PREFIX sti:     <https://sti-portal.fao.org/sti#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?recordA ?titleA ?collectionA ?recordB ?titleB ?collectionB
WHERE {
  ?recordA sti:hasFieldClaim ?sameAs ;
           sti:inCollection ?collectionA .
  ?sameAs sti:claimRefValue ?recordB .
  ?recordB sti:inCollection ?collectionB .
  FILTER(STR(?recordA) < STR(?recordB))
  OPTIONAL { ?recordA dcterms:title ?titleA }
  OPTIONAL { ?recordB dcterms:title ?titleB }
}
ORDER BY ?collectionA ?titleA
