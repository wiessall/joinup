# Step 3. Which solutions are marked as the same innovation as this one?
# "Same" is a sameInnovationAs claim on the solution whose object is another
# solution; the claim says which collection holds the statement.
PREFIX sti:     <https://sti-portal.fao.org/sti#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?duplicate ?title ?duplicateCollection ?statedBy
WHERE {
  VALUES ?solution { <__SOLUTION__> }
  ?solution sti:hasFieldClaim ?sameAs .
  ?sameAs sti:claimRefValue ?duplicate .
  ?duplicate sti:inCollection ?duplicateCollection .
  OPTIONAL { ?sameAs sti:claimedBy ?statedBy }
  OPTIONAL { ?duplicate dcterms:title ?title }
}
