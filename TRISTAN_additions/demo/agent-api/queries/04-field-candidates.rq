# Step 5. The map: for each ATIO field, every claim that could fill it, from
# this solution and from its duplicates, direct or via another collection's
# property, ranked by weight. This is what the generation step consumes.
#
# Weights: exactMatch 1.0, closeMatch 0.8, broadMatch/narrowMatch 0.6,
# relatedMatch 0.4; an indirect route weighs the product of its two steps.
# claimedAt is import time, not which source is semantically newer.
PREFIX sti:  <https://sti-portal.fao.org/sti#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?atioField ?atioLabel ?weight ?route ?role ?source ?collection
       ?property ?propertyLabel ?relation ?via ?viaLabel ?relation2 ?value ?claimedAt
WHERE {
  VALUES ?solution { <__SOLUTION__> }
  {
    # Anchored on a triple: a group is evaluated before the outer VALUES
    # binds ?solution, so a bare BIND here would match every solution.
    ?solution sti:inCollection ?selfCollection .
    BIND(?solution AS ?source)
    BIND("self" AS ?role)
  }
  UNION
  {
    ?solution sti:hasFieldClaim ?sameAs .
    ?sameAs sti:claimRefValue ?source .
    ?source sti:inCollection ?anyCollection .
    BIND("duplicate" AS ?role)
  }
  ?source sti:hasFieldClaim ?claim .
  OPTIONAL { ?source sti:inCollection ?collection }
  ?claim sti:claimProperty ?property .
  FILTER NOT EXISTS { ?claim sti:claimRefValue ?o . ?o sti:inCollection ?c }
  OPTIONAL { ?claim sti:claimedAt ?claimedAt }
  OPTIONAL { ?property skos:prefLabel|rdfs:label ?propertyLabel }
  OPTIONAL { ?claim sti:claimLiteralValue ?literal }
  OPTIONAL { ?claim sti:claimRefValue ?ref . OPTIONAL { ?ref skos:prefLabel ?refLabel } }
  BIND(COALESCE(?literal, ?refLabel, STR(?ref)) AS ?value)

  {
    VALUES (?relation ?weight) {
      (skos:exactMatch 1.0) (skos:closeMatch 0.8) (skos:broadMatch 0.6)
      (skos:narrowMatch 0.6) (skos:relatedMatch 0.4)
    }
    ?property ?relation ?atioField .
    BIND("direct" AS ?route)
  }
  UNION
  {
    VALUES (?relation ?w1) {
      (skos:exactMatch 1.0) (skos:closeMatch 0.8) (skos:broadMatch 0.6)
      (skos:narrowMatch 0.6) (skos:relatedMatch 0.4)
    }
    VALUES (?relation2 ?w2) {
      (skos:exactMatch 1.0) (skos:closeMatch 0.8) (skos:broadMatch 0.6)
      (skos:narrowMatch 0.6) (skos:relatedMatch 0.4)
    }
    { ?property ?relation ?via } UNION { ?via ?relation ?property }
    FILTER(!STRSTARTS(STR(?via), "https://sti-portal.fao.org/atio#"))
    ?via ?relation2 ?atioField .
    OPTIONAL { ?via skos:prefLabel|rdfs:label ?viaLabel }
    BIND(?w1 * ?w2 AS ?weight)
    BIND("indirect" AS ?route)
  }
  FILTER(STRSTARTS(STR(?atioField), "https://sti-portal.fao.org/atio#"))
  OPTIONAL { ?atioField rdfs:label ?atioLabel }
}
ORDER BY ?atioField DESC(?weight) ?role
