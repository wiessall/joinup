# =================================================================
# GRAPH 1 - TBox: classes & properties
# =================================================================
GRAPH <urn:fao:graph:schema> {

    sti:Innovation a owl:Class, rdfs:Class ; rdfs:label "Innovation"@en ;
        rdfs:comment "An agricultural or digital innovation catalogued in IRD."@en .
    foaf:Agent a owl:Class, rdfs:Class ; rdfs:label "Organization"@en ;
        rdfs:comment "An organization that publishes or is associated with innovations."@en .
    dcat:Catalog a owl:Class, rdfs:Class ; rdfs:label "Collection"@en ;
        rdfs:comment "A grouping of content originating from a single source partner."@en .

    :status a owl:ObjectProperty ; rdfs:domain sti:Innovation .
}

# =================================================================
# CONTENT - the single graph of THINGS THAT EXIST.
# =================================================================
GRAPH <urn:fao:graph:content> {

    # ── Collections ──────────────────────────────────────────────────
    :seeding_the_future a dcat:Catalog ;
        dct:identifier "COL-STF" ;
        dct:title "STF Collection"@en .

    :agritech_observatory a dcat:Catalog ;
        dct:identifier "COL-ECA" ;
        dct:title "ECA Collection"@en .

    # ── Organizations ─────────────────────────────────────────────────
    :org_a          a foaf:Agent ; dct:identifier "ORG-0001" .
    :org_b          a foaf:Agent ; dct:identifier "ORG-0004" .
    :stf_foundation a foaf:Agent ; dct:identifier "ORG-0002" .
    :fao            a foaf:Agent ; dct:identifier "ORG-0003" .

    # ── Innovations ───────────────────────────────────────────────────
    :innovation_a a sti:Innovation ;
        dct:identifier   "IRD-0001" ;
        dct:title        "innovation_a"@en ;
        dct:publisher    :org_a ;
        sti:inCollection :seeding_the_future .

    :innovation_b a sti:Innovation ;
        dct:identifier   "IRD-0002" ;
        dct:title        "innovation_b"@en ;
        dct:publisher    :org_b ;
        sti:inCollection :agritech_observatory .
}

