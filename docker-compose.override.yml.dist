# Copy this file in the project root directory, as docker-compose.override.yml,
# in order to override configurations provided in docker-compose.yml.
version: '3.8'
services:
  web:
    image: joinup/web:latest
    build:
      context: ./resources/docker/web
      # Default UID for Mac users is 501. If you are on Mac, uncomment the
      # following lines.
#      args:
#        USER_ID: 501
      # Default GID for Mac users is 20 and the group already exists in the
      # container. If you are on Mac, uncomment the following lines.
#    environment:
#      DAEMON_GROUP: dialout
    volumes:
      - ~/.composer:/var/www/.composer
      - ~/.ssh:/var/www/.ssh
      - ~/.npm:/var/www/.npm
    ports:
      - '8080:8080'
  mysql:
    ports:
      - '3306:3306'

  sparql:
    ports:
      - '8890:8890'

  solr:
    ports:
      - '8983:8983'

  redis:
    ports:
      - '6379:6379'

  mail:
    ports:
      - '1025:1025'
      - '8025:8025'

  selenium:
    ports:
      - '5900:5900'
