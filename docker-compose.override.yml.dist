# Copy this file in the project root directory, as docker-compose.override.yml,
# in order to override configurations provided in docker-compose.yml.
version: '3.8'
services:
  web:
    image: joinup/web:latest
    build:
      context: ./resources/docker/web
      args:
        # Change these to your personal UID and GID. You can use the following
        # command to find out your UID and GID:
        # $ whoami && id -u && id -g
        USER_ID: ${USER_ID:-1000}
        GROUP_ID: ${GROUP_ID:-1000}
    volumes:
      # macOS users should override this value by uncommenting the following:
      #      - nfsmount:/var/www/html
      # The following volumes are because the current image does not run as the host
      # user by default and all the files created by the container are owned by root.
      # Ensure you have these directories locally and that they are writable by the
      # host user.
      - ~/.composer:/var/www/.composer
      - ~/.ssh:/var/www/.ssh
      - ~/.npm:/var/www/.npm
    ports:
      - '8080:8080'

  mysql:
    # macOS users should override this value by uncommenting the following
    # 'volumes:' block.
    #    volumes:
    #      - ./resources/docker/mysql/config:/etc/mysql/conf.d:cached
    #      - ./db/mysql/dump/mysql.sql:/db/mysql/dump/mysql.sql:delegated
    #      - ./scripts/docker/mysql:/docker-entrypoint-initdb.d:cached
    ports:
      - '3306:3306'

  sparql:
    # macOS users should override this value by uncommenting the following
    # 'volumes:' block.
    #    volumes:
    #      - ./db/virtuoso/snapshot:/data/backups:delegated
    ports:
      - '8890:8890'

  solr:
    # macOS users should override this value by uncommenting the following
    # 'volumes:' block.
    #    volumes:
    #      - ./db/solr:/solr/snapshot:delegated
    #      - ./resources/solr/conf:/solr/conf:cached
    #      - ./scripts/solr/restore_solr.sh:/opt/solr/bin/restore_solr.sh:cached
    ports:
      - '8983:8983'

  mail:
    ports:
      - '1025:1025'
      - '8025:8025'

  selenium:
    ports:
      - '5900:5900'

# macOS users should uncomment the following block:
# volumes:
#  nfsmount:
#    driver: local
#    driver_opts:
#      type: nfs
#      o: addr=host.docker.internal,rw,nolock,hard,nointr,nfsvers=3
#      device: ":${PWD}/"
